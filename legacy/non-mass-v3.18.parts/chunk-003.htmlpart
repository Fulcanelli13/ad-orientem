    }
    return out;
}
function refsIn(text, prefix = "constants.") {
    const escaped = prefix.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    const regex = new RegExp(`${escaped}([A-Z][A-Z0-9_]*)`, "g");
    const out = [];
    let match;
    while ((match = regex.exec(text)))
        out.push(match[1]);
    return out;
}
function parseNestedRows(source, name, constants) {
    const body = extractParenAssignment(source, name);
    const rows = [];
    for (const raw of body.split(/\r?\n/)) {
        const line = stripPythonComment(raw).trim();
        if (!line.startsWith("("))
            continue;
        rows.push(refsIn(line).map(key => constants[key]).filter(Boolean));
    }
    return rows;
}
function parseFlatBlock(source, name, constants) {
    return refsIn(extractParenAssignment(source, name)).map(key => constants[key]).filter(Boolean);
}
function parseTupleTokens(source, name) {
    const body = extractParenAssignment(source, name);
    const tokens = [];
    for (const raw of body.split(/\r?\n/)) {
        const line = stripPythonComment(raw).trim();
        if (!line)
            continue;
        const match = line.match(/^([A-Z][A-Z0-9_]*)\s*,?/);
        if (match)
            tokens.push(match[1]);
        else if (/^['"]\.\*['"]/.test(line))
            tokens.push("WILDCARD");
    }
    return tokens;
}
function pyUnescape(value) {
    return value.replace(/\\'/g, "'").replace(/\\"/g, '"').replace(/\\n/g, "\n").replace(/\\\\/g, "\\");
}
function parseTitles(source, constants) {
    const out = new Map();
    for (const raw of source.split(/\r?\n/)) {
        const line = stripPythonComment(raw).trim();
        const match = line.match(/^constants\.([A-Z][A-Z0-9_]*)\s*:\s*(['"])(.*)\2\s*,?$/);
        if (match && constants[match[1]])
            out.set(constants[match[1]], pyUnescape(match[3]));
    }
    return out;
}
const PATTERN_TOKENS = {
