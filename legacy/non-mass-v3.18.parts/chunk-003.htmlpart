    const match = new RegExp(`(?:^|\\n)\\s*${name}\\s*=\\s*\\(`, "m").exec(source);
    if (!match)
        throw new Error(`Calendar source missing ${name}`);
    const start = source.indexOf("(", match.index);
    let depth = 0, quote = null, escaped = false, comment = false;
    for (let i = start; i < source.length; i += 1) {
        const char = source[i];
        if (comment) {
            if (char === "\n")
                comment = false;
            continue;
        }
        if (escaped) {
            escaped = false;
            continue;
        }
        if (quote) {
            if (char === "\\")
                escaped = true;
            else if (char === quote)
                quote = null;
            continue;
        }
        if (char === "#") {
            comment = true;
            continue;
        }
        if (char === '"' || char === "'") {
            quote = char;
            continue;
        }
        if (char === "(")
            depth += 1;
        else if (char === ")" && --depth === 0)
            return source.slice(start + 1, i);
    }
    throw new Error(`Unclosed calendar source tuple ${name}`);
}
function parseStringConstants(source) {
    const out = {};
    for (const raw of source.split(/\r?\n/)) {
        const line = stripPythonComment(raw).trim();
        const match = line.match(/^([A-Z][A-Z0-9_]*)\s*=\s*(['"])([^'"\n]*)\2\s*$/);
        if (match)
