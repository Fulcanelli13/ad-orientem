    PATTERN_ADVENT: /^tempora:Adv\d/,
    PATTERN_ADVENT_SUNDAY: /^tempora:Adv\d-0/,
    PATTERN_LENT: /^tempora:Quad(p3-[3-6]|\d)/,
    PATTERN_LENT_SUNDAY: /^tempora:Quad\d-0.*/,
    PATTERN_EASTER: /^tempora:Pasc\d/,
    PATTERN_TEMPORA_SUNDAY: /^tempora:.*-0r*:\d:\w{1,2}$/,