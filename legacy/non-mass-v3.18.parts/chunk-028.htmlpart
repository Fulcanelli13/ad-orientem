5.799 22.810 L 55.054 24.301 L 55.054 25.419 L 54.681 25.792 L 54.681 26.538 L 54.308 26.910 L 54.308 27.656 L 53.935 28.029 L 53.935 28.774 L 53.190 30.265 L 53.190 31.384 L 52.817 31.756 L 52.817 32.502 L 52.072 33.993 L 52.072 35.111 L 51.326 36.229 L 51.326 37.348 L 50.953 37.720 L 50.953 38.466 L 50.581 38.839 L 50.581 39.584 L 50.208 39.957 L 50.208 40.703 L 49.835 41.075 L 49.835 41.821 L 49.462 42.194 L 49.462 42.939 L 49.090 43.312 L 49.090 44.057 L 48.717 44.430 L 48.344 46.294 L 47.226 48.530 L 47.226 51.140 L 46.853 51.513 L 46.853 53.749 L 46.480 54.122 L 46.480 56.358 L 46.108 56.731 L 46.108 59.341 L 45.735 59.713 L 45.735 61.577 L 45.362 61.950 L 45.362 63.441 L 44.989 63.814 L 44.989 66.050 L 44.616 66.423 L 44.616 68.287 L 44.244 68.659 L 44.244 70.151 L 43.871 70.523 L 43.871 71.642 L 43.498 72.387 L 33.806 81.706 L 33.434 81.706 L 27.842 87.297 L 27.470 87.297 L 21.878 92.889 L 21.505 92.889 L 16.287 98.108 L 25.606 107.799 L 25.606 108.172 L 30.824 113.391 L 30.824 113.763 L 31.943 114.509 L 31.943 114.882 L 32.688 115.627 L 33.434 115.627 L 33.434 115.254 L 35.670 113.018 L 35.670 112.645 L 38.280 110.036 L 38.280 109.663 L 40.143 107.799 L 40.143 107.427 L 42.007 105.563 L 42.007 105.190 L 44.244 102.953 L 44.244 102.581 L 48.344 98.108 L 48.344 97.735 L 50.208 95.871 L 50.208 95.498 L 52.072 93.634 L 52.072 93.262 L 54.308 91.025 L 54.308 90.652 L 56.172 88.789 L 56.172 88.416 L 58.036 86.552 L 58.036 86.179 L 60.272 83.943 L 60.272 83.570 L 61.018 82.824 L 61.763 81.333 L 61.763 79.842 L 62.136 79.470 L 62.136 60.832 L 62.509 60.459 L 62.136 59.713 L 62.136 58.222 L 62.509 57.849 L 62.509 32.502 L 61.391 31.384 L 59.900 31.384 L 58.781 32.502 L 58.409 33.247 L 58.409 34.738 L 58.036 35.111 L 58.036 36.229 L 57.663 36.602 L 57.663 37.720 L 57.290 38.093 L 57.290 39.584 L 56.918 39.957 L 56.918 41.075 L 56.545 41.448 L 56.545 42.566 L 56.172 42.939 L 56.172 44.430 L 55.799 44.803 L 55.799 45.921 L 55.427 46.294 L 55.427 47.412 L 55.054 47.785 L 55.054 49.276 L 54.681 49.649 L 54.681 50.767 L 53.935 51.513 L 53.190 51.513 L 52.444 50.767 L 52.444 50.394 L 53.190 48.903 L 53.563 45.548 L 53.935 45.176 L 53.935 44.057 L 54.308 43.685 L 54.308 42.566 L 54.681 42.194 L 54.681 40.703 L 55.054 40.330 L 55.054 39.584 L 55.427 39.211 L 55.427 38.093 L 55.799 37.720 L 55.799 36.229 L 56.172 35.857 L 56.545 33.247 L 57.290 31.756 L 59.527 29.520 L 61.391 29.520 L 62.509 30.265 L 62.509 22.437 L 62.882 22.065 L 62.882 18.337 L 62.136 17.219 L 60.272 17.219 L 59.154 18.337 L 59.154 19.082 L 58.781 19.455 L 58.781 20.201 L 58.409 20.573 L 58.409 21.319 L 58.036 21.692 L 58.036 22.437 L 57.663 22.810 L 57.663 23.556 L 57.290 23.928 L 57.290 24.674 L 56.918 25.047 L 56.918 25.792 L 56.545 26.165 L 56.545 26.910 L 55.799 28.401 L 55.799 29.520 L 55.054 30.638 L 55.054 31.756 L 54.681 32.129 L 54.681 32.875 L 54.308 33.247 L 54.308 33.993 L 53.935 34.366 L 53.935 35.111 L 53.563 35.484 L 53.190 37.348 L 52.444 38.466 L 52.072 38.093 L 52.072 36.602 L 52.444 36.229 L 52.444 35.484 L 53.190 33.993 L 53.190 32.875 L 53.563 32.502 L 53.563 31.756 L 53.935 31.384 L 53.935 30.638 L 54.681 29.147 L 55.054 26.538 L 55.427 26.165 L 55.427 25.419 L 56.172 23.928 L 56.172 22.810 L 56.545 22.437 L 56.545 21.692 L 57.290 20.201 L 57.290 19.082 L 57.663 18.710 L 57.663 17.964 L 58.036 17.219 L 59.900 15.355 L 61.763 15.355 L 62.509 16.100 L 62.509 13.118 Z M 52.072 38.093 L 52.444 38.466 L 52.444 39.584 L 52.072 39.957 L 51.699 39.584 L 51.699 38.466 Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"/>
</svg></span>`;
 return `<span class="aoV37DomainIcon aoV37DomainIconLearn"><svg viewBox="0 0 64 64" aria-hidden="true" focusable="false"><path d="M15 7h34a5 5 0 0 1 5 5v39a6 6 0 0 1-6 6H15a5 5 0 0 1-5-5V12a5 5 0 0 1 5-5Z" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linejoin="round"/><path d="M17 9v46M18 52.5h31" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><path d="M29 17h6v8h7v6h-7v14h-6V31h-7v-6h7z" fill="currentColor"/><path d="M45 54v7l-4-2.8-4 2.8v-7" fill="currentColor"/></svg></span>`;
}
function dock(active='today'){
 return `<nav class="aoV37DomainDock" aria-label="${esc(L('Main sections','Sections principales'))}">
  ${['today','mass','pray','learn'].map(id=>`<button type="button" class="${active===id?'active':''}" data-v37-domain="${id}" aria-current="${active===id?'page':'false'}" aria-label="${esc(domainLabel(id))}">${domainIcon(id)}<b>${esc(domainLabel(id))}</b></button>`).join('')}
 </nav>`
}
function currentContext(){
 const s=appState();
 const title=s?.resolution?.day?.main?.title||s?.resolution?.main?.title||'';
 const rawDate=s?.selectedDate||'';
 const date=rawDate?(globalThis.AO_DISPLAY_DATE?.(rawDate)||rawDate):'';
 return [date,title].filter(Boolean).join(' · ')
}
function cardMarkup(item){
 const c=copy(item.id),d=MOD.get(item.id)||{}, isProg=/^programme\./.test(item.id)||d.type==='programme';
 const methods=item.methods?.length?`<div class="aoV37CardMethods">${item.methods.map(([en,frs,method])=>`<button type="button" data-v37-open="${esc(item.id)}"${method?` data-v37-method="${esc(method)}"`:''}>${esc(fr()?frs:en)}</button>`).join('')}</div>`:'';
 const nativeIcon=globalThis.AO_ICON_REGISTRY_V4333?.iconForRoute?.(item.id,'aoV4333NativeIcon')||'';
 const iconClass=nativeIcon?' aoV4333NativeIconized':'';
 return `<article class="aoV37Card ${item.featured?'featured':''} ${isProg?'aoV37Programme':''}">
   <button class="aoV37CardMain${iconClass}" type="button" data-v37-open="${esc(item.id)}">
    ${nativeIcon}<span class="type">${esc(isProg?L('Guided','Guidé'):d.type==='reference'?L('Reference','Référence'):L('Module','Module'))}</span>
    <strong>${esc(c.title)}</strong>
    <p>${esc(c.desc||'')}</p>
   </button>${methods}
 </article>`
}
function root(){
 let r=document.getElementById('ao-v37-root');
 if(r)return r;
 r=document.createElement('div');r.id='ao-v37-root';r.className='aoV37Root';r.hidden=true;document.body.appendChild(r);return r
}
function close(){
 state.open=false;state.error='';const r=root();r.hidden=true;r.innerHTML='';document.body.classList.remove('aoV37ShellOpen');syncHome()
}
function render(){
 if(!state.open)return;
 const cfg=LAYOUT[state.domain]||LAYOUT.mass,r=root();r.hidden=false;
 const settings=`<button type="button" data-v37-open="utility.settings" aria-label="${esc(L('Settings','Réglages'))}">⚙</button>`;
 r.innerHTML=`<header class="aoV37Top"><button type="button" data-v37-domain="today" aria-label="${esc(L('Back to Today','Retour à Aujourd’hui'))}">←</button><div class="aoV37TopTitle"><small>AD ORIENTEM</small><strong>${esc(fr()?cfg.title[1]:cfg.title[0])}</strong></div>${settings}</header>
 <main class="aoV37Wrap">
  <section class="aoV37Hero"><div class="kicker">${esc(fr()?cfg.kicker[1]:cfg.kicker[0])}</div><h1>${esc(fr()?cfg.title[1]:cfg.title[0])}</h1><p>${esc(fr()?cfg.intro[1]:cfg.intro[0])}</p><div class="aoV37Context">${esc(currentContext())}</div></section>
  ${state.error?`<div class="aoV37Error">${esc(state.error)}</div>`:''}
  ${cfg.sections.map(sec=>`<section class="aoV37Section"><div class="aoV37SectionHead"><h2>${esc(sectionTitle(sec))}</h2>${sec.hint?`<span>${esc(fr()?sec.hint[1]:sec.hint[0])}</span>`:''}</div><div class="aoV37Grid">${sec.items.map(cardMarkup).join('')}</div></section>`).join('')}
  <div class="aoV37UtilityRail"><button type="button" data-v37-open="utility.sources">${esc(L('Sources','Sources'))}</button><button type="button" data-v37-open="utility.settings">${esc(L('Settings','Réglages'))}</button></div>
 </main>
 <div class="aoV37Bottom">${dock(state.domain)}</div>`;
}
function openDomain(domain){
 if(domain==='today'){close();return true}
 if(!LAYOUT[domain])return false;
 state.open=true;state.domain=domain;state.error='';document.body.classList.add('aoV37ShellOpen');render();return true
}
function prayerLibraryMode(){
 const pb=document.getElementById('aoPrayerBookRoot');if(!pb)return;
 pb.classList.add('aoV37CorpusOnly');
 const hero=pb.querySelector('.pbHero h2');if(hero)hero.textContent=L('Prayer Library','Livre de prières');
 const p=pb.querySelector('.pbHero p');if(p)p.textContent=L('Search and open traditional prayer texts. Devotional modules and guided programmes are organised under Pray.','Recherchez et ouvrez les textes de prière traditionnels. Les modules dévotionnels et les parcours guidés sont organisés sous Prier.');
 const h=pb.querySelector('.lab-view-head h1');if(h)h.textContent=L('Prayer Library','Livre de prières');
}
async function openModule(id,method=null){
 const domain=state.domain,wasOpen=state.open;
 // v43.20: utilities opened from Home must return to Home, not to the shell's
 // default Mass domain. Preserve domain return only when the shell was open.
 const returnContext=wasOpen?{surface:'domain',domain}:{surface:'home'};
 close();
 if(id==='pray.library')prayerLibraryMode();
 const result=await MOD.open(id,{...(method?{method}:{}),returnContext});
 if(id==='pray.library'){setTimeout(prayerLibraryMode,60);setTimeout(prayerLibraryMode,180)}
 if(!result?.ok){
   state.open=true;state.domain=domain;state.error=L('This module could not be opened.','Ce module n’a pas pu être ouvert.');document.body.classList.add('aoV37ShellOpen');render()
 }
 return result
}
function ensureHomeNav(){
 const home=document.querySelector('.homeScreen');if(!home)return false;
 home.querySelectorAll('.aoV37HomeNav').forEach(n=>n.remove());
 prayerLibraryMode();
 return true
}
function syncHome(){
 if(queued)return;queued=true;queueMicrotask(()=>{queued=false;ensureHomeNav()})
}
function install(){
 if(subscribed)return;
 const s=rt()?.store;
 if(!s?.subscribe)return;
 subscribed=true;s.subscribe(()=>{syncHome();if(state.open)render()});
 syncHome();
}
document.addEventListener('click',e=>{
 const d=e.target.closest?.('[data-v37-domain]');if(d){e.preventDefault();e.stopPropagation();openDomain(d.dataset.v37Domain);return}
 const b=e.target.closest?.('[data-v37-open]');if(b){e.preventDefault();e.stopPropagation();openModule(b.dataset.v37Open,b.dataset.v37Method||null);return}
},true);
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&state.open){e.preventDefault();close()}},true);

install();
globalThis.AO_V37_SHELL={
 version:VERSION,
 openDomain,close,openModule,
 layout:LAYOUT,
 qa(){
  const ids=[];for(const cfg of Object.values(LAYOUT))for(const sec of cfg.sections)for(const item of sec.items)ids.push(item.id);
  const missing=[...new Set(ids)].filter(id=>!MOD.get(id));
  const duplicatePlacements=ids.reduce((m,id)=>(m[id]=(m[id]||0)+1,m),{});
  return {
   version:VERSION,
   domains:Object.keys(LAYOUT),
   visibleTopLevel:['today','mass','pray','learn'],
   referencedCanonicalIds:[...new Set(ids)],
   missingCanonicalIds:missing,
   duplicatePlacements:Object.entries(duplicatePlacements).filter(([,n])=>n>1).map(([id,count])=>({id,count})),
   oldHomeExploreHidden:true,
   standaloneUnderstandMassHomeCardHidden:true,
   standaloneFullCatechismHomeCardHidden:true,
   dailyCatechismHomeCardPreserved:true,
   prayerLibraryCorpusOnly:true,
   newMutationObserverAdded:false,
   pass:missing.length===0
  }
 }
};
})();

</script>

<script id="ao-v37-meta">
window.AO_V37_META={
 version:'37',
 baseline:'Ad-Orientem-2.0-v36.2-OWNERSHIP-VERIFICATION.html',
 visibleArchitecture:['TODAY','MASS','PRAY','LEARN'],
 registryAuthority:'AO_MODULES',
 homeRole:'TODAY',
 legacyHubsExposedAsTopLevel:false,
 prayerBookRole:'underlying corpus / Prayer Library',
 traditionalExercisesRole:'source methods / retained renderers',
 eucharisticProgrammesRole:'programme renderers behind PRAY',
 massEngineChanged:false,
 calendarEngineChanged:false,
 prayerCorpusChanged:false,
 progressStorageChanged:false,
 saintArtChanged:false,
 newMutationObserverAdded:false
};
</script>

<style id="ao-v371-devotional-liturgical-harmonization-css">
/* v37.1 — outside-Mass modules inherit the exact same liturgical accent token as Mass. */
#aoPrayerBookRoot{
  --gold:var(--liturgical);
  --line:var(--liturgical-border);
}
#aoPrayerBookRoot .lab-view-head .eyebrow,
#aoPrayerBookRoot .lab-lang,
#aoPrayerBookRoot .lab-library-head .eyebrow,
#aoPrayerBookRoot .lab-rosary-hero small,
#aoPrayerBookRoot .lab-mystery-card small,
#aoPrayerBookRoot .pbKicker,
#aoPrayerBookRoot .rc2Sheet header small,
#aoPrayerBookRoot .rc2GuideSection h3,
#aoPrayerBookRoot .rc2ModePill,
#aoPrayerBookRoot .aoPrayerRole{color:var(--liturgical)!important}
#aoPrayerBookRoot .lab-library-grid button.featured,
#aoPrayerBookRoot .lab-mystery-card.recommended,
#aoPrayerBookRoot .lab-recitation-mode button.active,
#aoPrayerBookRoot .rc2Segments button.active,
#aoPrayerBookRoot .rc2ModuleTools button,
#aoPrayerBookRoot .lab-option-bar button.active,
#aoPrayerBookRoot .lab-option-bar label:has(input:checked){border-color:var(--liturgical-border)!important}
#aoPrayerBookRoot .lab-progress i,
#aoPrayerBookRoot .pbProgress span{background:var(--liturgical)!important}
#aoPrayerBookRoot .lab-actions .accent,
#aoPrayerBookRoot .lab-player-controls .primary,
#aoPrayerBookRoot .pbPrimary{background:var(--liturgical)!important;border-color:var(--liturgical-border)!important}
#aoPrayerBookRoot .lab-reader-meta span{color:var(--liturgical);border-color:var(--liturgical-border);background:var(--liturgical-soft)}
#aoPrayerBookRoot .lab-prayer-flip:focus-visible,
#aoPrayerBookRoot .rc2Sheet button:focus-visible{outline:2px solid var(--liturgical);outline-offset:3px}
#aoPrayerBookRoot .aoPrayerDialogueLine{display:grid;grid-template-columns:2.15rem minmax(0,1fr);gap:.35rem;align-items:start;margin:.22rem 0}
#aoPrayerBookRoot .aoPrayerRole{font-family:var(--display);font-weight:700;letter-spacing:.02em}
#aoPrayerBookRoot .aoLitanyLine{display:grid;grid-template-columns:minmax(0,1fr);gap:.28rem;margin:.34rem 0 .55rem}
#aoPrayerBookRoot .aoLitanyCall,#aoPrayerBookRoot .aoLitanyResponse{display:grid;grid-template-columns:2.15rem minmax(0,1fr);gap:.35rem;align-items:start}
#aoPrayerBookRoot .aoLitanyResponse{padding-left:.7rem;color:color-mix(in srgb,var(--ink) 82%,var(--liturgical))}
/* Mass-adjacent Roman preparation/thanksgiving use the same structural marker token. */
.prayerFlip .aoPrayerRole,.romanCorpus .aoPrayerRole{color:var(--liturgical);font-family:var(--font-display);font-weight:700}
/* Preserve rubric semantics: .rubric remains its own rubric colour and is not remapped here. */
</style>

<style id="ao-v372-group-response-search-css">
/* v37.2: Mass-follower grammar for Group prayer responses only. */
#aoPrayerBookRoot .aoPrayerRole{color:var(--liturgical)}
#aoPrayerBookRoot .aoPrayerDialogueBody{min-width:0}
