 color:var(--text)
}
#aoPrayerBookRoot .aoLitanyLine.aoGroupLitany .aoLitanyResponse .aoPrayerRole{color:var(--liturgical)}
/* Roman before/after-Mass prayer text: emitted only when the shared recitation mode is Group. */
.prayerFlip .aoRomanDialogueLine{
 display:grid;
 grid-template-columns:2.05rem minmax(0,1fr);
 gap:.36rem;
 align-items:start;
 margin:.22rem 0
}
.prayerFlip .aoRomanDialogueLine.aoGroupResponse{
 padding:.38rem .5rem;
 border-left:2px solid var(--liturgical-border);
 border-top:1px solid color-mix(in srgb,var(--liturgical-border) 48%,transparent);
 border-bottom:1px solid color-mix(in srgb,var(--liturgical-border) 48%,transparent);
 border-radius:8px;
 background:var(--liturgical-soft);
 color:var(--text)
}
.prayerFlip .aoRomanDialogueLine.aoGroupResponse .aoPrayerRole{color:var(--liturgical)}
/* Ranked multilingual search result hierarchy. */
#aoPrayerBookRoot .pbSearchResults{margin-top:4px}
#aoPrayerBookRoot .pbSearchResultGroup{margin-top:16px}
