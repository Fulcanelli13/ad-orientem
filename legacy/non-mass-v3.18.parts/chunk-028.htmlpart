 margin:.34rem 0;
 padding:.42rem .55rem;
 border-left:2px solid var(--liturgical-border);
 border-top:1px solid color-mix(in srgb,var(--liturgical-border) 52%,transparent);
 border-bottom:1px solid color-mix(in srgb,var(--liturgical-border) 52%,transparent);
 border-radius:8px;
 background:var(--liturgical-soft);
 color:var(--text)
}
#aoPrayerBookRoot .aoPrayerDialogueLine.aoGroupResponse .aoPrayerRole{color:var(--liturgical)}
#aoPrayerBookRoot .aoPrayerDialogueLine.aoGroupResponse .aoPrayerWords{color:var(--text)}
#aoPrayerBookRoot .aoGroupResponseKicker{
 display:block;
 margin:0 0 .18rem;
 color:var(--liturgical);
 font:650 .55rem/1.1 var(--font-display);
 letter-spacing:.11em;
 text-transform:uppercase;
 opacity:.9
}
/* Litanies intentionally use a shallower band to avoid visual fatigue over many responses. */
#aoPrayerBookRoot .aoLitanyLine.aoGroupLitany .aoLitanyResponse{
 padding:.24rem .38rem .24rem .48rem;
 border-left:2px solid var(--liturgical-border);
