<style id="ao-v4318-refined-icons-css">
.aoV4318RefinedIcon{
 width:38px;height:38px;display:block;flex:0 0 auto;overflow:visible;
 color:var(--liturgical,var(--gold,currentColor));
 --ao-refined-ground:var(--surface-1);
}
.aoV37CardMain.aoV4318Iconized{position:relative;padding-left:65px!important}
.aoV37CardMain.aoV4318Iconized>.aoV4318RefinedIcon{position:absolute;left:12px;top:13px;width:40px;height:40px}
.aoV37UtilityRail button.aoV4318Iconized{position:relative;padding-left:48px!important}
.aoV37UtilityRail button.aoV4318Iconized>.aoV4318RefinedIcon{position:absolute;left:10px;top:8px;width:28px;height:28px}
@media(max-width:430px){.aoV37CardMain.aoV4318Iconized{padding-left:59px!important}.aoV37CardMain.aoV4318Iconized>.aoV4318RefinedIcon{left:10px;width:36px;height:36px}}
</style>
<script id="ao-v4318-refined-icons-js">
(()=>{'use strict';
 const R=globalThis.AO_ICON_REGISTRY_V4333;
 const MAP=Object.freeze({'today.saint':'ao-refined-saint-of-day','today.calendar':'ao-refined-calendar-upcoming','today.gospel':'ao-refined-scripture','learn.catechism':'ao-refined-study','learn.catechism.daily':'ao-refined-study'});
 const noop=()=>({nativeOwnership:true});
 globalThis.AO_REFINED_EXTENSION_V4318=Object.freeze({version:'43.18-compat-native-owned',map:MAP,donorPack:'embedded',decorate:noop,qa(){const missing=[...new Set(Object.values(MAP))].filter(id=>!document.getElementById(id));return{version:'43.18-compat-native-owned',missingSymbols:missing,mappings:Object.keys(MAP).length,mutationObserversAdded:0,nativeOwnership:true,pass:missing.length===0}}});
})();
</script>
<script id="ao-v4318-refined-icons-meta">
window.AO_V4318_REFINED_ICON_META=Object.freeze({
 version:'43.18',
 base:'v43.17 Rich Icons + Eucharistic Merge',
 donor:'Lab-ora Refined V4 · 23 High-Fidelity SVG Icons',
 embeddedExactDonors:['saint-of-day','calendar-upcoming','scripture','study'],
 mappedRoutes:['today.saint','today.calendar','today.gospel','learn.catechism','learn.catechism.daily'],
 dormantDonorsPackaged:true,
 excludedFromAdoption:['mass','general-settings','sources'],
 reason:'Mass domain and Tier-A Settings/Sources already have canonical Ad Orientem identities',
 massEngineChanged:false,prayerTextChanged:false,calendarEngineChanged:false,eucharisticMergeChanged:false,mutationObserverAdded:false
});
</script>
<style id="ao-v4318-home-hierarchy-css">
/* v43.18 — Home hierarchy cleanup. Presentation/navigation only. */
.homeScreen .celebrationBlock > .eyebrow{display:none!important}
.homeScreen .moreCard{display:none!important}
.homeScreen .aoCelebrationControl[hidden],
.homeScreen .aoCelebrationControl[data-ao-contextual="false"]{display:none!important}

/* When the Saint of the Day is already the principal celebration, retain the
   saint surface as a compact identity/art row rather than a second hero. */
.homeScreen .aoSaintArtCard.aoHomeSaintCompact{
  display:grid!important;
  grid-template-columns:76px minmax(0,1fr)!important;
  gap:12px!important;
  align-items:center!important;
  min-height:0!important;
  padding:10px 12px!important;
}
.homeScreen .aoSaintArtCard.aoHomeSaintCompact .aoSaintArtMedia{
  width:76px!important;height:76px!important;min-height:76px!important;
  border-radius:11px!important;overflow:hidden!important;
}
.homeScreen .aoSaintArtCard.aoHomeSaintCompact .aoSaintArtMedia img{
  width:100%!important;height:100%!important;object-fit:cover!important;
}
.homeScreen .aoSaintArtCard.aoHomeSaintCompact .aoSaintArtBody{min-width:0!important;padding:0!important}
.homeScreen .aoSaintArtCard.aoHomeSaintCompact .aoSaintArtKicker{margin:0 0 3px!important}
.homeScreen .aoSaintArtCard.aoHomeSaintCompact .aoSaintArtTitle{
  margin:0!important;font-size:1rem!important;line-height:1.2!important;overflow-wrap:anywhere!important;
}
.homeScreen .aoSaintArtCard.aoHomeSaintCompact .aoSaintArtMeta,
.homeScreen .aoSaintArtCard.aoHomeSaintCompact .aoSaintArtActions{display:none!important}
.homeScreen .aoSaintArtCard.aoHomeSaintCompact .aoSaintArtSourceDot{
  width:28px!important;height:28px!important;right:5px!important;bottom:5px!important
}

/* Deliberate Home rhythm after removing the duplicate surfaces. */
.homeScreen .celebrationBlock{margin-bottom:12px}
.homeScreen .aroundMass{margin-top:14px}
.homeScreen .massCard + .aoRuleHomeV412,
.homeScreen .massCard + #aoRuleCard{margin-top:12px!important}

@media(max-width:480px){
  .homeScreen .aoSaintArtCard.aoHomeSaintCompact{grid-template-columns:64px minmax(0,1fr)!important;gap:10px!important;padding:9px 10px!important}
  .homeScreen .aoSaintArtCard.aoHomeSaintCompact .aoSaintArtMedia{width:64px!important;height:64px!important;min-height:64px!important}
  .homeScreen .aoSaintArtCard.aoHomeSaintCompact .aoSaintArtTitle{font-size:.94rem!important}
}
</style>
<script id="ao-v4318-home-hierarchy-js">
(()=>{'use strict';
const VERSION='43.18';
let installed=false,queued=false,timers=[];
const rt=()=>globalThis.AO_RUNTIME_V8||null;
const state=()=>rt()?.store?.getState?.()||null;
const home=()=>document.querySelector('.homeScreen');
const normalize=s=>String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/\bsaints?\b|\bsts?\b/g,' ').replace(/[^a-z0-9]+/g,' ').replace(/\s+/g,' ').trim();
const STOP=new Set(['saint','st','sts','the','of','and','et','de','du','des','la','le','les','apostle','apotre','martyr','martyrs','bishop','eveque','virgin','vierge','confessor','confesseur','pope','pape','king','roi','queen','reine','evangelist','evangeliste']);
const tokens=s=>normalize(s).split(' ').filter(x=>x.length>=4&&!STOP.has(x));
function after(anchor,node){if(anchor&&node&&anchor!==node){anchor.insertAdjacentElement('afterend',node);return node}return anchor}
function contextualMassControl(root){
 const ctl=root.querySelector('.aoCelebrationControl');if(!ctl)return null;
 let requested='mass_of_day';try{requested=globalThis.AO_CELEBRATION_API?.getResolvedMass?.()?.requestedCelebrationId||'mass_of_day'}catch{}
 const contextual=requested!=='mass_of_day';ctl.dataset.aoContextual=String(contextual);ctl.hidden=!contextual;
 return contextual?ctl:null;
}
function principalSaint(root,card){
 if(!card||card.querySelector('.aoSaintArtComponents'))return false;
 const celebration=root.querySelector('.celebrationBlock h1')?.textContent||'';
 const saint=card.querySelector('.aoSaintArtTitle')?.textContent||'';
 if(!celebration||!saint)return false;
 const a=normalize(celebration),b=normalize(saint);
 if(a===b||a.includes(b)||b.includes(a))return true;
 const st=tokens(saint),ct=new Set(tokens(celebration));
 if(!st.length)return false;
 const hits=st.filter(x=>ct.has(x)).length;
 return st.length===1 ? (hits===1&&st[0].length>=5) : (hits>=2||hits/st.length>=.67);
}
function adaptSaint(root){
 const card=root.querySelector('.aoSaintArtCard');if(!card)return null;
 card.classList.toggle('aoHomeSaintCompact',principalSaint(root,card));
 return card;
}
function ensureDateBlock(root){
 const header=root.querySelector('.homeHeader'),dateNav=root.querySelector('.dateNavigator'),dateRail=root.querySelector('.dateRail');
 if(!header||!dateNav||!dateRail)return null;
 let block=root.querySelector(':scope > .aoHomeDateBlock');
 if(!block){block=document.createElement('section');block.className='aoHomeDateBlock';block.setAttribute('aria-label',root.dataset.homeLanguage==='fr'?'Navigation de date':'Date navigation')}
 block.append(dateNav,dateRail);
 return block;
}
function ensureLiturgicalKicker(root,celebration){
 let kicker=celebration.querySelector(':scope > .aoLiturgicalDayKicker');
 if(!kicker){kicker=document.createElement('div');kicker.className='aoLiturgicalDayKicker';celebration.insertBefore(kicker,celebration.firstChild)}
 kicker.textContent=root.dataset.homeLanguage==='fr'?'JOUR LITURGIQUE':'LITURGICAL DAY';
 return kicker;
}
function cleanAndOrder(){
 const root=home();if(!root)return false;
 root.querySelectorAll('.moreCard').forEach(x=>x.remove());
 root.querySelectorAll('.celebrationBlock > .eyebrow').forEach(x=>x.remove());
 const header=root.querySelector('.homeHeader');
 const celebration=root.querySelector('.celebrationBlock');if(!celebration)return false;
 ensureLiturgicalKicker(root,celebration);
 if(header)after(header,celebration);
 let anchor=celebration;
 const saint=adaptSaint(root);if(saint)anchor=after(anchor,saint);
 const massCtl=contextualMassControl(root);if(massCtl)anchor=after(anchor,massCtl);
 root.querySelectorAll(':scope > .statusCard').forEach(x=>{anchor=after(anchor,x)});
 const resume=root.querySelector(':scope > .resumeCard');if(resume)anchor=after(anchor,resume);
 const around=root.querySelector('.aroundMass');if(around)anchor=after(anchor,around);
 const ff=root.querySelector('.ao354Today');if(ff)anchor=after(anchor,ff);
 const contextual=root.querySelector('.ao384Today');if(contextual)anchor=after(anchor,contextual);
 const gospel=root.querySelector('.gospelCard');if(gospel)anchor=after(anchor,gospel);
 root.querySelectorAll('.massCard,.moreCard,#aoRuleCard,.aoRuleHomeV412,#aoComingUpCardV4320,.aoComingUpV4319,.aoHomeDateBlock').forEach(x=>x.remove());
 const coming=root.querySelector('#aoComingUpCardV4323');if(coming)anchor=after(anchor,coming);
 const cate=root.querySelector('.aoDailyCateHome');if(cate)anchor=after(anchor,cate);
 const nav=root.querySelector('.aoV37HomeNav');if(nav)anchor=after(anchor,nav);
 const spacer=root.querySelector('.homeSpacer');if(spacer&&nav)nav.insertAdjacentElement('afterend',spacer);
 root.dataset.aoHomeHierarchy='43.25';
 return true;
}
function queue(){
 if(!queued){queued=true;queueMicrotask(()=>{queued=false;cleanAndOrder()})}
 timers.forEach(clearTimeout);timers=[];
}
function wrapSaintSync(){
 const api=globalThis.AO_SAINT_ART;if(!api?.syncHome||api.__ao4318Wrapped)return;
 const original=api.syncHome.bind(api);api.syncHome=async(...args)=>{const r=await original(...args);queue();return r};api.__ao4318Wrapped=true;
}
function setTitle(){if(!globalThis.AO_RELEASE_AUTHORITY_V4359)document.title='Ad Orientem 2.0 · v43.18 Home Hierarchy Cleanup';if(!globalThis.AO_RELEASE_AUTHORITY_V4359)document.documentElement.dataset.aoRelease='43.18'}
function inspect(){
 const root=home(),mass=root?.querySelector('.massCard'),rule=root?.querySelector('#aoRuleCard,.aoRuleHomeV412'),cate=root?.querySelector('.aoDailyCateHome'),nav=root?.querySelector('.aoV37HomeNav');
 let requested='mass_of_day';try{requested=globalThis.AO_CELEBRATION_API?.getResolvedMass?.()?.requestedCelebrationId||'mass_of_day'}catch{}
 const ctl=root?.querySelector('.aoCelebrationControl');
 const checks={
  homePresent:!!root,
  duplicateWeekdayAbsent:!root?.querySelector('.celebrationBlock > .eyebrow'),
  obsoleteMoreAbsent:!root?.querySelector('.moreCard'),
  defaultMassSelectorSuppressed:requested!=='mass_of_day'||!ctl||ctl.hidden||ctl.dataset.aoContextual==='false',
  contextualSelectorRetained:requested==='mass_of_day'||!!(ctl&&!ctl.hidden),
  ruleAfterMass:!mass||!rule||!!(mass.compareDocumentPosition(rule)&Node.DOCUMENT_POSITION_FOLLOWING),
  catechismAfterRule:!rule||!cate||!!(rule.compareDocumentPosition(cate)&Node.DOCUMENT_POSITION_FOLLOWING),
  exploreAfterFormation:!nav||(!cate&&!rule)||!!((cate||rule).compareDocumentPosition(nav)&Node.DOCUMENT_POSITION_FOLLOWING),
  observerFree:true
 };
 return{version:VERSION,pass:Object.values(checks).every(Boolean),checks,requestedCelebrationId:requested,saintCompact:!!root?.querySelector('.aoSaintArtCard.aoHomeSaintCompact')};
}
function install(){
 if(installed)return;const store=rt()?.store;if(!store?.subscribe)return;
 installed=true;wrapSaintSync();store.subscribe(()=>queue());document.addEventListener('click',()=>queue(),true);window.addEventListener('pageshow',()=>{setTitle();queue()});
 setTitle();queue();
}
globalThis.AO_HOME_HIERARCHY_V4318=Object.freeze({version:VERSION,apply:cleanAndOrder,inspect});
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',install,{once:true});else install();
})();
</script>
<script id="ao-v4318-release-meta">
(()=>{'use strict';const meta=Object.freeze({version:'43.18',title:'Ad Orientem 2.0 · v43.18 Home Hierarchy Cleanup',base:'v43.17',lane:'home-hierarchy-cleanup',changes:['remove duplicate celebration weekday eyebrow','suppress ordinary calendar Mass-selection panel','retain Mass-selection panel for non-calendar/requested celebrations','remove obsolete More card','move Traditional Rule below Mass Details','keep Daily Catechism after Rule','keep Explore navigation after formation','compact Saint of the Day when it duplicates the principal feast'],massEngineChanged:false,sacredArtRegistryChanged:false,cueEngineChanged:false,observerAdded:false,inspect:()=>globalThis.AO_HOME_HIERARCHY_V4318?.inspect?.()});globalThis.AO_V4318_META=meta;})();
</script>


<script id="ao-v4319-haptics-js">

(()=>{'use strict';
const VERSION='43.19';
const STORE_KEY='ao-haptics-enabled';
const EXPLICIT_SELECTOR='[data-v401-rosary-jump],[data-v401-art],[data-lab-rosary-next],[data-lab-rosary-prev]';
const INTERACTIVE='button,a[href],summary,input:not([type="hidden"]),select,textarea,[role="button"],[role="tab"],[role="switch"],[role="radio"],[role="checkbox"],[data-action],[data-nav],[data-v37-open],[data-ao-open],[data-ao354-open],[data-v38-open],[data-v381-open],[data-v383-open],[data-v384-route]';
const patterns=Object.freeze({tap:6,soft:4,select:8,confirm:[10,18,10],strong:[14,24,14],warning:[18,32,18]});
let lastAt=0,lastSource='',enabled=false,installed=false;
try{const v=localStorage.getItem(STORE_KEY);if(v==='0')enabled=false}catch{}
function now(){return (globalThis.performance?.now?.()||Date.now())}
function capacitor(kind){
 const h=globalThis.Capacitor?.Plugins?.Haptics;if(!h)return false;
 try{
  if(kind==='select'&&typeof h.selectionChanged==='function'){Promise.resolve(h.selectionChanged()).catch(()=>{});return true}
  if(typeof h.impact==='function'){
   const style=(kind==='strong'||kind==='warning'||kind==='confirm')?'MEDIUM':'LIGHT';
   Promise.resolve(h.impact({style})).catch(()=>{});return true
  }
 }catch{}return false
}
function webkit(kind){
 const mh=globalThis.webkit?.messageHandlers?.haptics||globalThis.webkit?.messageHandlers?.haptic;
 if(!mh?.postMessage)return false;
 try{mh.postMessage({kind,source:'ad-orientem',version:VERSION});return true}catch{}return false
}
function android(kind){
 const a=globalThis.Android;
 try{if(typeof a?.hapticFeedback==='function'){a.hapticFeedback(kind);return true}}catch{}return false
}
function webVibrate(kind){
 if(typeof navigator?.vibrate!=='function')return false;
 try{return navigator.vibrate(patterns[kind]??patterns.tap)!==false}catch{return false}
}
function capability(){
 return {capacitor:!!globalThis.Capacitor?.Plugins?.Haptics,webkitBridge:!!(globalThis.webkit?.messageHandlers?.haptics||globalThis.webkit?.messageHandlers?.haptic),androidBridge:typeof globalThis.Android?.hapticFeedback==='function',vibrationApi:typeof navigator?.vibrate==='function'}
}
function fire(kind='tap',source='api',{force=false}={}){
 if(!enabled&&!force)return false;
 const t=now();if(!force&&t-lastAt<60)return false;
 lastAt=t;lastSource=source;
 const ok=capacitor(kind)||webkit(kind)||android(kind)||webVibrate(kind);
 document.documentElement.dataset.aoHaptics=ok?'active':'unsupported';
 return ok
}
function dataString(el){
 if(!el)return'';const d=el.dataset||{};
 return [el.id,el.className,el.getAttribute?.('aria-label'),el.getAttribute?.('role'),...Object.entries(d).flat()].filter(x=>typeof x==='string').join(' ').toLowerCase()
}
function classify(el){
 if(el?.matches?.('select,input[type="checkbox"],input[type="radio"],input[type="range"]'))return'select';
 const s=dataString(el);
 if(/delete|remove|reset|clear|discard|cancel mass|warning|danger/.test(s))return'warning';
 if(/finish|complete|completed|confirm|save|done|start mass|follow mass|communion|submit/.test(s))return'confirm';
 if(/select|setting|toggle|segment|tab|language|formulary|recitation|mode|radio|checkbox|switch|option/.test(s))return'select';
 if(/close|dismiss|back|previous|prev|next|nav|open|more|calendar|settings|sources/.test(s))return'soft';
 return'tap'
}
function eligible(target){
 const el=target?.closest?.(INTERACTIVE);if(!el)return null;
 if(el.matches?.(':disabled')||el.getAttribute?.('aria-disabled')==='true')return null;
 if(el.closest?.('[inert]'))return null;
 return el
}
function onPointerDown(e){
 if(!e.isTrusted)return;
 if(e.button!=null&&e.button!==0)return;
 const el=eligible(e.target);if(!el)return;
 if(el.closest?.(EXPLICIT_SELECTOR)&&typeof navigator?.vibrate==='function')return; // v40.1 Rosary owns these on Vibration-API runtimes; delegated fallback covers native bridges elsewhere.
 // v43.20: pointerdown precedes legacy click routers that intentionally call
 // stopImmediatePropagation, so their controls still receive physical feedback.
 fire(classify(el),'delegated-pointer')
}
function onChange(e){
 if(!e.isTrusted)return;
 const el=e.target;
 if(!(el instanceof Element)||!el.matches('select,input[type="checkbox"],input[type="radio"],input[type="range"]'))return;
 fire('select','delegated-change')
}