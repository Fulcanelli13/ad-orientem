  margin-bottom:11px
}
.aoRuleHeaderCopy{min-width:0}
.aoRuleHeaderCopy b{
  display:block;margin-top:4px;
  font-family:var(--font-display);font-size:1.06rem;letter-spacing:.035em
}
.aoRuleCardHeader .roundAction{
  width:42px!important;height:42px!important;border-color:var(--liturgical-border)!important;
  color:var(--liturgical)!important;background:var(--liturgical-soft)!important
}
.aoRuleModuleGrid{
  display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px
}
.aoRuleModule{
  position:relative;min-width:0;
  border:1px solid var(--border);border-radius:15px;
  background:var(--surface-1);overflow:hidden
}
.aoRuleModule.now{
  border-color:var(--liturgical-border);
  background:linear-gradient(180deg,var(--liturgical-soft),var(--surface-1))
}
.aoRuleModule.wide{grid-column:1/-1}
.aoRuleModuleLaunch{
  width:100%;height:100%;min-height:150px;padding:0;
  display:grid;grid-template-rows:84px minmax(66px,auto);
  border:0;background:transparent;color:var(--text);text-align:left
}
.aoRuleModule.wide .aoRuleModuleLaunch{
  min-height:116px;
  grid-template-columns:42% minmax(0,1fr);
  grid-template-rows:116px
}
.aoRuleModuleHero{
  position:relative;display:block;min-width:0;overflow:hidden;background:var(--surface-2)
}
.aoRuleModuleHero img{
  width:100%;height:100%;display:block;object-fit:cover;
  filter:saturate(.88) contrast(1.04)
}
.aoRuleHeroShade{
  position:absolute;inset:0;
  background:linear-gradient(180deg,rgba(2,5,9,.04),rgba(2,5,9,.24))
}
.aoRuleModuleHeroFallback{
  display:flex;align-items:center;justify-content:center;
  background:linear-gradient(145deg,var(--liturgical-soft),var(--surface-2))
}
.aoRuleHeroMonogram{font-size:1.65rem;color:var(--liturgical);opacity:.85}
.aoRuleModuleCopy{
  min-width:0;padding:10px 11px 11px;display:flex;flex-direction:column;align-items:flex-start
}
.aoRuleModule.wide .aoRuleModuleCopy{
  justify-content:center;padding:14px 15px
}
.aoRuleModuleCopy small{
  color:var(--liturgical);
  font:650 .57rem/1.1 var(--font-display);letter-spacing:.1em;text-transform:uppercase
}
.aoRuleModuleCopy strong{
  display:block;margin-top:5px;
  font:600 .95rem/1.18 var(--font-display);
  overflow-wrap:anywhere
}
.aoRuleModule.wide .aoRuleModuleCopy strong{font-size:1.1rem}
.aoRuleModuleCopy>span:last-child{
  margin-top:auto;padding-top:8px;color:var(--liturgical);
  font:650 .62rem/1 var(--font-display);letter-spacing:.05em;text-transform:uppercase
}
.aoRuleModuleCheck{
  position:absolute;z-index:3;right:8px;top:8px;
  width:30px;height:30px;border:1px solid rgba(255,255,255,.32);border-radius:50%;
  background:rgba(5,9,14,.72);backdrop-filter:blur(8px);
  color:#f1eee6;font-size:.82rem;padding:0
}
.aoRuleModule.done .aoRuleModuleCheck{
  border-color:var(--liturgical);background:color-mix(in srgb,var(--liturgical) 75%,#10151d);color:#080b0e
}
.aoRuleModule.done .aoRuleModuleHero img{opacity:.68}
.aoRuleModule.done .aoRuleModuleCopy strong{color:color-mix(in srgb,var(--text) 74%,var(--muted))}
.aoRuleCardFoot{display:none!important}
@media(max-width:430px){
 .aoRuleHomeV412{padding:13px 14px!important}
 .aoRuleModuleGrid{gap:8px}
 .aoRuleModuleLaunch{min-height:144px;grid-template-rows:80px minmax(64px,auto)}
 .aoRuleModule.wide .aoRuleModuleLaunch{
   min-height:112px;grid-template-columns:40% minmax(0,1fr);grid-template-rows:112px
 }
 .aoRuleModuleCopy{padding:9px 9px 10px}
 .aoRuleModule.wide .aoRuleModuleCopy{padding:12px 13px}
 .aoRuleModuleCopy strong{font-size:.9rem}
 .aoRuleModule.wide .aoRuleModuleCopy strong{font-size:1.04rem}
 .aoRuleCardFoot{font-size:.63rem}
}
</style>


<style id="ao-v413-scripture-language-css">
.v38ScripturePair,.v383ScripturePair{display:grid;grid-template-columns:minmax(0,1fr);gap:12px}
.v38ScripturePair>section,.v383ScripturePair>section{min-width:0;border-top:1px solid rgba(255,255,255,.10);padding-top:10px}
.v38ScriptureLang,.v383ScriptureLang,.ao-r-context-lang{font:600 .67rem/1.25 var(--display,serif);letter-spacing:.09em;text-transform:uppercase;color:var(--gold,#c7ae6d);margin:0 0 8px}
.v38RiteText{margin:12px 0 18px}.v38RiteText>h3{margin:0 0 10px}.v38RiteBody{white-space:pre-line;line-height:1.62}
.v383Historical{margin-top:14px}.v383Historical>summary{cursor:pointer;font-weight:700}.v383ScriptureRef{font-weight:700;margin:0 0 8px}
.ao-r-context-lang{margin-top:14px}.ao-r-context-lang:first-child{margin-top:0}
@media(min-width:720px){.v38ScripturePair,.v383ScripturePair{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>

<style id="ao-v4311-stations-sacred-art-css">
/* v43.11 — Stations sacred-art integration. Native Ad Orientem tokens only. */
#aoPrayerBookRoot .aoV4311StationsArt{
  margin:0 0 14px;border:1px solid var(--liturgical-border);border-radius:var(--radius-m);
  overflow:hidden;background:var(--surface-1);box-shadow:0 14px 34px rgba(0,0,0,.18)
}
#aoPrayerBookRoot .aoV4311StationsArt img{
  display:block;width:100%;height:auto;max-height:min(58vh,590px);object-fit:contain;background:#05080c
}
#aoPrayerBookRoot .aoV4311StationsArt figcaption{
  display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 12px;
  border-top:1px solid var(--border);background:var(--surface-1);color:var(--text);
  font:600 .76rem/1.35 var(--font-display)
}
#aoPrayerBookRoot .aoV4311StationsArt figcaption span:last-child{
  color:var(--muted);font-size:.66rem;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap
}
#aoPrayerBookRoot .aoV4311StationsArt.is-subtle img{filter:saturate(.78) brightness(.72);opacity:.86}
#aoPrayerBookRoot .aoV4311StationsLandingArt{margin:0 0 16px}
#aoPrayerBookRoot .lab-stations-hero .aoV4311StationsLandingArt img{max-height:min(46vh,470px)}
#aoPrayerBookRoot .lab-stations-hero .aoV4311StationsLandingArt figcaption{background:rgba(7,18,29,.86)}
#aoPrayerBookRoot .lab-stations-hero .aoV4311StationsLandingArt figcaption span:first-child{color:var(--paper)}
#aoPrayerBookRoot .lab-stations-hero .aoV4311StationsLandingArt figcaption span:last-child{color:var(--muted)}
#rc2-module-sheet .aoV4311StationsArtPref .rc2Segments{grid-template-columns:repeat(3,minmax(0,1fr))!important}
@media(max-width:560px){
 #aoPrayerBookRoot .aoV4311StationsArt img{max-height:50vh}
 #aoPrayerBookRoot .aoV4311StationsArt figcaption{align-items:flex-start;flex-direction:column;gap:4px}
 #aoPrayerBookRoot .aoV4311StationsArt figcaption span:last-child{white-space:normal}
}
</style>
<style id="ao-v4312-cinematic-loading-css">
/* v43.12 — observer-free presentation-only cinematic/loading layer. No liturgical/data/navigation ownership. */
#ao-cinema-boot,#ao-cinema-transition,#ao-cinema-loader{font-family:var(--font-liturgical);color:var(--text);-webkit-font-smoothing:antialiased}
#ao-cinema-boot{position:fixed;z-index:2147483000;inset:0;display:grid;place-items:center;overflow:hidden;background:radial-gradient(circle at 50% 34%,color-mix(in srgb,var(--liturgical) 16%,transparent),transparent 26rem),linear-gradient(180deg,#0c1118 0%,#070a0f 72%,#05070a 100%);opacity:1;visibility:visible;transition:opacity .62s cubic-bezier(.2,.75,.2,1),visibility 0s linear .62s}
#ao-cinema-boot.aoCinemaBootDone{opacity:0;visibility:hidden;pointer-events:none}
.aoCinemaBootAtmosphere{position:absolute;inset:-12%;pointer-events:none;background:radial-gradient(ellipse at 50% 22%,color-mix(in srgb,var(--liturgical) 12%,transparent),transparent 36%),linear-gradient(90deg,transparent 0 47%,color-mix(in srgb,var(--liturgical) 4%,transparent) 50%,transparent 53%);filter:blur(10px);animation:aoCinemaBreathe 4.6s ease-in-out infinite alternate}
.aoCinemaBootInner{position:relative;width:min(84vw,390px);padding:26px 22px;text-align:center}
.aoCinemaBootCross{display:grid;place-items:center;width:60px;height:60px;margin:0 auto 20px;border:1px solid color-mix(in srgb,var(--liturgical) 48%,rgba(255,255,255,.16));border-radius:50%;background:color-mix(in srgb,var(--liturgical) 7%,transparent);box-shadow:0 0 0 8px color-mix(in srgb,var(--liturgical) 2%,transparent),0 0 44px color-mix(in srgb,var(--liturgical) 15%,transparent);color:color-mix(in srgb,var(--liturgical) 76%,#efe9dd);font:500 1.65rem/1 var(--font-display);animation:aoCinemaCross 2.7s ease-in-out infinite}
.aoCinemaBootKicker{color:var(--liturgical);font:600 .61rem/1 var(--font-display);letter-spacing:.24em;text-transform:uppercase}
.aoCinemaBootTitle{margin:10px 0 5px;font:600 clamp(1.6rem,7vw,2.15rem)/1.08 var(--font-display);letter-spacing:.085em;text-transform:uppercase;text-wrap:balance}
.aoCinemaBootSub{color:var(--muted);font-size:.86rem;letter-spacing:.035em}
.aoCinemaBootRule{position:relative;width:min(250px,70vw);height:1px;margin:24px auto 14px;background:rgba(255,255,255,.07);overflow:hidden}
.aoCinemaBootRule i{position:absolute;inset:0 auto 0 -45%;width:45%;background:linear-gradient(90deg,transparent,var(--liturgical),transparent);box-shadow:0 0 16px var(--liturgical);animation:aoCinemaSweep 1.65s ease-in-out infinite}
.aoCinemaBootStatus{min-height:1.3em;color:var(--muted-2);font-size:.75rem;letter-spacing:.035em;transition:opacity .2s ease}
.aoCinemaBootStatus.ready{color:color-mix(in srgb,var(--liturgical) 74%,var(--text))}
@keyframes aoCinemaSweep{0%{transform:translateX(0);opacity:.15}45%{opacity:1}100%{transform:translateX(320%);opacity:.15}}
@keyframes aoCinemaBreathe{to{transform:scale(1.045);opacity:.76}}
@keyframes aoCinemaCross{0%,100%{transform:translateY(0);box-shadow:0 0 0 8px color-mix(in srgb,var(--liturgical) 2%,transparent),0 0 34px color-mix(in srgb,var(--liturgical) 10%,transparent)}50%{transform:translateY(-2px);box-shadow:0 0 0 8px color-mix(in srgb,var(--liturgical) 3%,transparent),0 0 52px color-mix(in srgb,var(--liturgical) 18%,transparent)}}

#ao-cinema-transition{position:fixed;z-index:2147482900;inset:0;display:grid;place-items:center;pointer-events:none;opacity:0;visibility:hidden;background:radial-gradient(circle at 50% 48%,color-mix(in srgb,var(--liturgical) 13%,transparent),transparent 24rem),rgba(5,8,12,.94);backdrop-filter:blur(13px);transition:opacity .18s ease,visibility 0s linear .2s}
#ao-cinema-transition.aoCinemaTransitionOn{opacity:1;visibility:visible;transition:opacity .11s ease}
#ao-cinema-transition.aoCinemaTransitionOut{opacity:0;visibility:visible;transition:opacity .48s cubic-bezier(.2,.75,.2,1)}
.aoCinemaTransitionInner{text-align:center;padding:28px 24px;transform:translateY(5px);opacity:.76;transition:transform .46s cubic-bezier(.18,.8,.2,1),opacity .42s ease}
.aoCinemaTransitionOn .aoCinemaTransitionInner{transform:translateY(0);opacity:1}
.aoCinemaTransitionGlyph{display:block;margin-bottom:13px;color:var(--liturgical);font:500 1.1rem/1 var(--font-display);text-shadow:0 0 22px color-mix(in srgb,var(--liturgical) 42%,transparent)}
.aoCinemaTransitionKicker{display:block;color:var(--liturgical);font:600 .56rem/1 var(--font-display);letter-spacing:.19em;text-transform:uppercase}
.aoCinemaTransitionTitle{display:block;margin-top:9px;font:600 clamp(1.1rem,5vw,1.45rem)/1.15 var(--font-display);letter-spacing:.04em;text-wrap:balance}
.aoCinemaTransitionLine{display:block;width:96px;height:1px;margin:17px auto 0;background:linear-gradient(90deg,transparent,var(--liturgical),transparent);transform:scaleX(.15);opacity:.3;transition:transform .48s .02s ease,opacity .3s ease}
.aoCinemaTransitionOn .aoCinemaTransitionLine{transform:scaleX(1);opacity:.8}

#ao-cinema-loader{position:fixed;z-index:2147482800;inset:0;display:grid;place-items:center;padding:22px;pointer-events:none;opacity:0;visibility:hidden;background:rgba(5,8,12,.64);backdrop-filter:blur(8px);transition:opacity .24s ease,visibility 0s linear .25s}
#ao-cinema-loader.aoCinemaLoaderOn{opacity:1;visibility:visible;transition:opacity .18s ease}
.aoCinemaLoaderCard{width:min(88vw,360px);padding:20px 19px 18px;border:1px solid var(--liturgical-border);border-radius:18px;background:linear-gradient(180deg,color-mix(in srgb,var(--surface-2) 94%,transparent),rgba(9,13,19,.96));box-shadow:0 24px 70px rgba(0,0,0,.34)}
.aoCinemaLoaderHead{display:flex;align-items:center;gap:11px;margin-bottom:16px}.aoCinemaLoaderMark{width:30px;height:30px;display:grid;place-items:center;border:1px solid var(--liturgical-border);border-radius:50%;color:var(--liturgical);font-size:.82rem}.aoCinemaLoaderText{min-width:0;display:flex;flex-direction:column;gap:3px}.aoCinemaLoaderText b{font:600 .8rem/1.2 var(--font-display);letter-spacing:.025em}.aoCinemaLoaderText small{color:var(--muted-2);font-size:.7rem}
.aoCinemaSkeleton{display:grid;gap:9px}.aoCinemaSkeleton i{display:block;height:8px;border-radius:999px;background:linear-gradient(90deg,rgba(255,255,255,.045) 0%,rgba(255,255,255,.1) 45%,color-mix(in srgb,var(--liturgical) 17%,rgba(255,255,255,.07)) 52%,rgba(255,255,255,.045) 100%);background-size:240% 100%;animation:aoCinemaSkeleton 1.35s linear infinite}.aoCinemaSkeleton i:nth-child(1){width:76%}.aoCinemaSkeleton i:nth-child(2){width:94%}.aoCinemaSkeleton i:nth-child(3){width:62%}
@keyframes aoCinemaSkeleton{to{background-position:-140% 0}}

#app.aoCinemaSceneEnter>.homeScreen,#app.aoCinemaSceneEnter>.liveScreen,#app.aoCinemaSceneEnter>.flowScreen,#app.aoCinemaSceneEnter>.scriptureScreen{animation:aoCinemaSceneIn .52s cubic-bezier(.18,.8,.2,1) both}
@keyframes aoCinemaSceneIn{from{opacity:.25;transform:translateY(8px) scale(.996);filter:blur(2px)}to{opacity:1;transform:none;filter:none}}
.aoCinemaSurfaceIn{animation:aoCinemaSurfaceIn .42s cubic-bezier(.18,.8,.2,1) both}
@keyframes aoCinemaSurfaceIn{from{opacity:0;transform:translateY(12px) scale(.992)}to{opacity:1;transform:none}}

.aoCinemaArt{background:linear-gradient(110deg,rgba(255,255,255,.035),rgba(255,255,255,.075),rgba(255,255,255,.035));background-size:220% 100%;animation:aoCinemaArtShimmer 1.5s linear infinite;overflow:hidden}
.aoCinemaArt img{will-change:filter,opacity,transform;transition:filter .72s cubic-bezier(.18,.8,.2,1),opacity .58s ease,transform 1.05s cubic-bezier(.18,.8,.2,1)}
.aoCinemaArt img.aoCinemaImagePending{filter:blur(15px);opacity:.28;transform:scale(1.028)}
.aoCinemaArt img.aoCinemaImageReady{filter:none;opacity:1;transform:none}
.aoCinemaArt img.aoCinemaImageError{filter:none;opacity:.18;transform:none}
@keyframes aoCinemaArtShimmer{to{background-position:-120% 0}}

@media(prefers-reduced-motion:reduce){
 #ao-cinema-boot,#ao-cinema-transition,#ao-cinema-loader,.aoCinemaTransitionInner,.aoCinemaTransitionLine,#app.aoCinemaSceneEnter>.homeScreen,#app.aoCinemaSceneEnter>.liveScreen,#app.aoCinemaSceneEnter>.flowScreen,#app.aoCinemaSceneEnter>.scriptureScreen,.aoCinemaSurfaceIn,.aoCinemaArt img{animation:none!important;transition:none!important;transform:none!important;filter:none!important}
 .aoCinemaBootAtmosphere,.aoCinemaBootCross,.aoCinemaBootRule i,.aoCinemaSkeleton i{animation:none!important}
}
html[data-reduced-motion="true"] #ao-cinema-transition,html[data-reduced-motion="true"] #ao-cinema-loader{backdrop-filter:none}
</style>

<style id="ao-v43-16-logo-integration">
/* v43.16 — Ad Orientem identity mark integration. Presentation only. */
.brandRow {
  grid-template-columns: 48px minmax(0,1fr) auto;
  gap: 10px;
}
.brandMark.aoBrandEmblem {
  width: 46px;
  height: 46px;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--liturgical);
  display: grid;
  place-items: center;
  overflow: visible;
  box-shadow: none;
}
.brandMark.aoBrandEmblem::before {
  content: "";
  display: block;
  width: 44px;
  height: 44px;
  background: currentColor;
  -webkit-mask-image: url("data:image/png;base64,");
  mask-image: url("data:image/png;base64,");
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: contain;
  mask-size: contain;
}
@media (max-width: 350px) {
  .brandRow { grid-template-columns: 44px minmax(0,1fr) auto; gap: 8px; }
  .brandMark.aoBrandEmblem { width: 42px; height: 42px; }
  .brandMark.aoBrandEmblem::before { width: 40px; height: 40px; }
}
@media (prefers-contrast: more) {
  .brandMark.aoBrandEmblem::before {
    filter: drop-shadow(0 0 0.35px currentColor);
  }
}
</style>

<style id="ao-v43-17-brand-presence">
/* v43.17 — brand presence in home, cinematics and install surfaces. Presentation only. */
.brandRow{grid-template-columns:60px minmax(0,1fr) auto;gap:11px;min-height:62px}
.brandMark.aoBrandEmblem{width:58px;height:58px}
.brandMark.aoBrandEmblem::before{width:56px;height:56px}

/* Cinematic boot: the app emblem replaces the generic cross glyph. */
.aoCinemaBootCross.brandMark.aoBrandEmblem{
  width:112px;height:112px;margin:0 auto 18px;border:0;border-radius:0;background:transparent;
  color:color-mix(in srgb,var(--liturgical) 78%,#efe9dd);
  box-shadow:none;overflow:visible;
}
.aoCinemaBootCross.brandMark.aoBrandEmblem::before{
  width:106px;height:106px;filter:drop-shadow(0 0 24px color-mix(in srgb,var(--liturgical) 24%,transparent));
}

/* Route-change cinematic: compact branded emblem. */
.aoCinemaTransitionGlyph.brandMark.aoBrandEmblem{
  width:48px;height:48px;margin:0 auto 13px;border:0;border-radius:0;background:transparent;color:var(--liturgical);box-shadow:none;
}
.aoCinemaTransitionGlyph.brandMark.aoBrandEmblem::before{width:46px;height:46px}

/* Async-content loader: smaller but still recognisably the same mark. */
.aoCinemaLoaderMark.brandMark.aoBrandEmblem{
  width:32px;height:32px;border:0;border-radius:0;background:transparent;color:var(--liturgical);box-shadow:none;flex:0 0 32px;
}
.aoCinemaLoaderMark.brandMark.aoBrandEmblem::before{width:30px;height:30px}

@media(max-width:520px){
  .brandRow{grid-template-columns:56px minmax(0,1fr) auto;gap:9px;min-height:58px}
  .brandMark.aoBrandEmblem{width:54px;height:54px}
  .brandMark.aoBrandEmblem::before{width:52px;height:52px}
  .aoCinemaBootCross.brandMark.aoBrandEmblem{width:100px;height:100px}
  .aoCinemaBootCross.brandMark.aoBrandEmblem::before{width:94px;height:94px}
  .aoCinemaTransitionGlyph.brandMark.aoBrandEmblem{width:44px;height:44px}
  .aoCinemaTransitionGlyph.brandMark.aoBrandEmblem::before{width:42px;height:42px}
  .aoCinemaLoaderMark.brandMark.aoBrandEmblem{width:30px;height:30px;flex-basis:30px}
  .aoCinemaLoaderMark.brandMark.aoBrandEmblem::before{width:28px;height:28px}
}
@media(max-width:350px){
  .brandRow{grid-template-columns:52px minmax(0,1fr) auto;gap:8px;min-height:54px}
  .brandMark.aoBrandEmblem{width:50px;height:50px}
  .brandMark.aoBrandEmblem::before{width:48px;height:48px}
  .aoCinemaBootCross.brandMark.aoBrandEmblem{width:88px;height:88px}
  .aoCinemaBootCross.brandMark.aoBrandEmblem::before{width:84px;height:84px}
}
</style>
<script id="ao-v43-22-date-policy">
(()=>{'use strict';
 const pad=n=>String(n).padStart(2,'0');
 function format(value){
   if(value==null||value==='')return '';
   if(value instanceof Date&&!Number.isNaN(value.getTime()))return `${pad(value.getDate())}/${pad(value.getMonth()+1)}/${value.getFullYear()}`;
   const raw=String(value).trim();
   const iso=raw.match(/^(\d{4})-(\d{2})-(\d{2})(?:$|T)/);
   if(iso)return `${iso[3]}/${iso[2]}/${iso[1]}`;
   const d=new Date(value);
   if(!Number.isNaN(d.getTime()))return `${pad(d.getDate())}/${pad(d.getMonth()+1)}/${d.getFullYear()}`;
   return raw;
 }
 globalThis.AO_DISPLAY_DATE=format;
})();
</script>

<style id="ao-v4354-contemplative-lens-css">
.aoLensDock{display:flex;justify-content:center;padding:8px 14px 0}.aoLensButton{max-width:100%;min-height:36px;padding:6px 12px;border:1px solid color-mix(in srgb,var(--liturgical-border) 72%,rgba(255,255,255,.08));border-radius:999px;background:color-mix(in srgb,var(--surface-2) 86%,transparent);color:var(--muted);font:600 .61rem/1.15 var(--font-display);letter-spacing:.08em;text-transform:uppercase;cursor:pointer}.aoLensButton[data-active="1"]{color:var(--liturgical);background:color-mix(in srgb,var(--liturgical-soft) 74%,var(--surface-2))}.aoLensCard{margin:16px 0 20px;padding:14px 15px 13px;border:1px solid color-mix(in srgb,var(--liturgical-border) 68%,rgba(255,255,255,.06));border-left:2px solid var(--liturgical);border-radius:13px;background:linear-gradient(135deg,color-mix(in srgb,var(--liturgical-soft) 52%,var(--surface-2)),var(--surface-2) 72%)}.aoLensKicker{display:flex;align-items:center;justify-content:space-between;gap:10px;color:var(--liturgical);font:600 .54rem/1.25 var(--font-display);letter-spacing:.12em;text-transform:uppercase}.aoLensItems{display:grid;gap:11px;margin-top:10px}.aoLensItem+.aoLensItem{padding-top:10px;border-top:1px solid color-mix(in srgb,var(--liturgical-border) 34%,transparent)}.aoLensTitle{margin:0;color:var(--text);font-family:var(--font-liturgical);font-size:1.18rem;line-height:1.28}.aoLensScripture{margin:5px 0 0;color:var(--muted);font-size:.78rem;line-height:1.4}.aoLensGuard{margin:10px 0 0;color:var(--muted);font-size:.67rem;line-height:1.4;font-style:italic}.aoLensChooser{position:fixed;inset:0;z-index:9800;display:grid;align-items:end;background:rgba(0,0,0,.62);backdrop-filter:blur(5px)}.aoLensSheet{width:min(100%,520px);margin:0 auto;padding:18px 16px calc(18px + env(safe-area-inset-bottom));border:1px solid var(--border);border-bottom:0;border-radius:22px 22px 0 0;background:var(--surface);box-shadow:0 -20px 60px rgba(0,0,0,.35)}.aoLensSheet h2{margin:2px 0 4px;font-family:var(--font-display);font-size:1rem;letter-spacing:.05em}.aoLensSheet>p{margin:0 0 14px;color:var(--muted);font-size:.78rem;line-height:1.45}.aoLensChoice{width:100%;display:grid;grid-template-columns:1fr auto;gap:8px;align-items:center;margin:8px 0;padding:12px 13px;border:1px solid var(--border);border-radius:12px;background:var(--surface-2);color:var(--text);text-align:left;cursor:pointer}.aoLensChoice b{font:600 .78rem/1.3 var(--font-display);letter-spacing:.04em}.aoLensChoice small{grid-column:1;color:var(--muted);font-size:.7rem;line-height:1.35}.aoLensChoice[aria-checked="true"]{border-color:var(--liturgical-border);background:var(--liturgical-soft)}.aoLensClose{width:100%;min-height:42px;margin-top:11px;border:0;border-radius:11px;background:transparent;color:var(--muted);font:600 .7rem var(--font-display);cursor:pointer}@media(max-width:360px){.aoLensDock{padding-left:10px;padding-right:10px}.aoLensCard{margin-left:-2px;margin-right:-2px;padding:12px}.aoLensTitle{font-size:1.08rem}}
</style>
<style id="ao-v435929-formation-ultra-compact-css">
/* Formation is a compact Home row, not a large hero. */
.homeScreen .aoDailyCateHome{
 position:relative!important;min-height:108px!important;max-height:108px!important;
 padding:9px 78px 9px 11px!important;grid-template-columns:minmax(0,1fr)!important;
 align-items:center!important;overflow:hidden!important
}
.homeScreen .aoDailyCateHome .aoPiusHeroMedia{
 position:absolute!important;inset:6px 7px 6px auto!important;width:62px!important;height:96px!important;
 min-height:0!important;padding:2px!important;border:1px solid var(--border)!important;border-radius:10px!important;
 background:rgba(17,22,27,.88)!important
}
.homeScreen .aoDailyCateHome .aoPiusHeroMedia img{width:100%!important;height:100%!important;object-fit:contain!important;object-position:center top!important}
.homeScreen .aoDailyCateHome .cateCardCopy{max-width:100%!important;padding:0 0 23px!important}
.homeScreen .aoDailyCateHome .cardKicker{font-size:.54rem!important;line-height:1!important}
.homeScreen .aoDailyCateHome .cateCardCopy>b{display:block!important;margin-top:3px!important;font-size:.96rem!important;line-height:1.02!important}
.homeScreen .aoDailyCateHome .aoPiusXByline{margin-top:3px!important;font-size:.52rem!important;line-height:1!important}
.homeScreen .aoDailyCateHome .cateCardCopy p,.homeScreen .aoDailyCateHome .aoDailyCateMeta{display:none!important}
.homeScreen .aoDailyCateHome .aoCateBadge{margin-top:5px!important;min-height:17px!important;padding:2px 6px!important;font-size:.49rem!important;line-height:1!important}
.homeScreen .aoDailyCateHome .roundAction{left:11px!important;bottom:7px!important;width:24px!important;height:24px!important;min-width:24px!important}
.homeScreen .aoDailyCateHome::after{background:linear-gradient(90deg,rgba(5,9,13,.99) 0%,rgba(5,9,13,.98) 58%,rgba(5,9,13,.58) 80%,rgba(5,9,13,.05) 100%)!important}
@media(max-width:560px){
 .homeScreen .aoDailyCateHome{min-height:96px!important;max-height:96px!important;padding:8px 68px 8px 9px!important}
 .homeScreen .aoDailyCateHome .aoPiusHeroMedia{width:54px!important;height:84px!important;inset:6px 6px 6px auto!important}
 .homeScreen .aoDailyCateHome .cateCardCopy{padding-bottom:21px!important}
 .homeScreen .aoDailyCateHome .cateCardCopy>b{font-size:.9rem!important}
 .homeScreen .aoDailyCateHome .aoCateBadge{font-size:.47rem!important}
 .homeScreen .aoDailyCateHome .roundAction{left:9px!important;bottom:6px!important;width:23px!important;height:23px!important;min-width:23px!important}
}
</style>
<style id="ao-v435929-mystery-study-only-css">
/* Study-only: old contemplation/silence presentation is retired. */
.aoStudyShell .aoMysteryModes,.aoStudyShell .aoMysterySilenceInvite,.aoStudyShell .aoMysterySilence{display:none!important}
.aoStudyShell .aoMysteryStudySection>.aoStudySection:first-child{margin-top:0}
</style>

<style id="ao-v435930-mystery-source-integrity-css">
.aoMysteryIntroSource{border-left:3px solid var(--liturgical)!important}
.aoMysteryComparison{margin:12px 0;padding:15px;border:1px solid var(--border);border-radius:15px;background:var(--surface-1)}
.aoMysteryComparisonHead{display:flex;gap:10px;align-items:center;justify-content:space-between;margin-bottom:11px}
.aoMysteryComparisonHead h2{margin:0;font:650 .92rem/1.2 var(--font-display)}
.aoMysteryStatus,.aoMysteryMiniStatus{display:inline-flex;align-items:center;border:1px solid var(--border);border-radius:999px;font:750 .55rem/1 var(--font-display);letter-spacing:.07em;text-transform:uppercase;white-space:nowrap}
.aoMysteryStatus{padding:6px 8px}.aoMysteryMiniStatus{padding:4px 6px;justify-self:end}
.aoMysteryStatus.exact,.aoMysteryMiniStatus.exact{border-color:color-mix(in srgb,var(--liturgical) 50%,var(--border))}
.aoMysteryStatus.approximate,.aoMysteryMiniStatus.approximate{border-style:dashed}
.aoMysteryStatus.rite_specific,.aoMysteryMiniStatus.rite_specific{border-width:2px}
.aoMysteryCompareGrid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px}
.aoMysteryCompareGrid>div{padding:11px;border-radius:11px;background:var(--surface-2)}
.aoMysteryCompareGrid small{display:block;margin-bottom:5px;color:var(--muted);font:700 .57rem/1.15 var(--font-display);letter-spacing:.08em;text-transform:uppercase}
.aoMysteryCompareGrid b{display:block;font:620 .78rem/1.35 var(--font-display)}
.aoMysteryComparison>p{margin:.4rem 0 0;color:var(--muted);font-size:.78rem;line-height:1.5}
.aoMysteryFormNote{display:grid;gap:3px;margin-top:10px;padding:9px 10px;border-left:3px solid var(--liturgical);background:var(--surface-2);font-size:.72rem;line-height:1.4}
.aoMysteryRomanDetails{margin:10px 0 12px;border:1px solid var(--border);border-radius:13px;background:var(--surface-1);overflow:hidden}
.aoMysteryRomanDetails>summary{cursor:pointer;padding:12px 14px;font:700 .7rem/1.25 var(--font-display);list-style:none}
.aoMysteryRomanDetails>summary::-webkit-details-marker{display:none}
.aoMysteryRomanDetails>summary::after{content:'+';float:right;color:var(--liturgical)}
.aoMysteryRomanDetails[open]>summary::after{content:'−'}
.aoMysteryRomanDetails>.aoStudyExactBlock,.aoMysteryRomanDetails>.aoStudyContextBlock{padding:0 12px 12px}
.aoMysteryBrowse button{grid-template-columns:34px minmax(0,1fr) auto!important}
@media(max-width:640px){.aoMysteryCompareGrid{grid-template-columns:1fr}.aoMysteryMiniStatus{font-size:.49rem;padding:3px 5px}.aoMysteryBrowse button{grid-template-columns:30px minmax(0,1fr)!important}.aoMysteryBrowse .aoMysteryMiniStatus{grid-column:2;justify-self:start;margin-top:3px}}
</style>

<style id="ao-global-vr-normalization-css">
/* Ad Orientem · global V/R normalization
   V = dynamic readable liturgical colour already owned by the app theme.
   R = fixed muted slate/Marian blue across every liturgical colour. */
:root{
  --vr-response:#7080A3;
  --vr-response-border:color-mix(in srgb,var(--vr-response) 78%,transparent);
  --vr-response-soft:color-mix(in srgb,var(--vr-response) 13%,transparent);
  --vr-response-soft-2:color-mix(in srgb,var(--vr-response) 5%,transparent);
  --vr-response-glow:color-mix(in srgb,var(--vr-response) 20%,transparent);
}

/* Canonical marker emitted by the global text normalizer. */
.aoVrMark{
  display:inline-block;min-width:1.08em;margin-right:.12em;
  font-family:var(--font-liturgical,Georgia,serif);font-weight:700;font-style:normal;
  line-height:inherit;letter-spacing:0;text-indent:0;
}
.aoVrMark[data-vr="v"]{color:var(--liturgical,#4f8f66)!important}
.aoVrMark[data-vr="r"]{color:var(--vr-response)!important}
[data-vr-role="v"]{color:var(--liturgical,#4f8f66)!important}
[data-vr-role="r"]{color:var(--vr-response)!important}

/* Existing Mass / live-reader role marks. */
.rolePassage.roleVersicle .roleLabel,
.dialoguePair.versiclePair .dialogueRoleMark,
.versicleLine .liturgicalDialogueMark{color:var(--liturgical,#4f8f66)!important}
.rolePassage.roleResponse .roleLabel,
.dialoguePair.responsePair .dialogueRoleMark,
.responseLine .liturgicalDialogueMark{color:var(--vr-response)!important}

/* Shared Prayer Book / Rosary / litanies / Around Mass. */
#aoPrayerBookRoot .aoPrayerDialogueLine.aoVersicle .aoPrayerRole,
#aoPrayerBookRoot .aoLitanyCall .aoPrayerRole,
#aoPrayerBookRoot .aoCustomaryLeader>.aoPrayerRole,
.prayerFlip .aoRomanDialogueLine:not(.aoGroupResponse) .aoPrayerRole,
.romanCorpus .aoRomanDialogueLine:not(.aoGroupResponse) .aoPrayerRole{color:var(--liturgical,#4f8f66)!important}
#aoPrayerBookRoot .aoPrayerDialogueLine.aoResponse .aoPrayerRole,
#aoPrayerBookRoot .aoLitanyResponse .aoPrayerRole,
#aoPrayerBookRoot .aoCustomaryResponse>.aoPrayerRole,
.prayerFlip .aoRomanDialogueLine.aoGroupResponse .aoPrayerRole,
.romanCorpus .aoRomanDialogueLine.aoGroupResponse .aoPrayerRole{color:var(--vr-response)!important}

/* New unified PRAY owner. */
#aoPray435930 .aoP435930PrayerDialogue:not(.aoResponse) .aoP435930PrayerRole,
#aoPray435930 .aoP435930LitanyCall .aoP435930PrayerRole,
#aoPray435930 .aoP435930CommonLeader>.aoP435930PrayerRole{color:var(--liturgical,#4f8f66)!important}
#aoPray435930 .aoP435930PrayerDialogue.aoResponse .aoP435930PrayerRole,
#aoPray435930 .aoP435930LitanyResponse .aoP435930PrayerRole,
#aoPray435930 .aoP435930CommonResponse>.aoP435930PrayerRole{color:var(--vr-response)!important}

/* The faithful side owns one fixed visual grammar: blue marker + rule + restrained wash. */
.dialoguePair.congregationResponse{
  border-left-color:var(--vr-response-border)!important;
  background:linear-gradient(90deg,var(--vr-response-soft),var(--vr-response-soft-2) 72%,transparent)!important;
  box-shadow:inset 0 1px 0 color-mix(in srgb,var(--vr-response) 17%,transparent),inset 0 -1px 0 color-mix(in srgb,var(--vr-response) 10%,transparent)!important
}
.dialoguePair.congregationResponse .dialogueRoleMark{color:var(--vr-response)!important}
.dialoguePair.congregationResponse .dialogueVernacular{border-left-color:color-mix(in srgb,var(--vr-response) 34%,transparent)!important}
.congregationLabel{color:var(--vr-response)!important}

.liveScreen[data-participation="group"] .massReading:not(.choirReading) .responseLine{
  border-left-color:var(--vr-response-border)!important;
  background:linear-gradient(90deg,var(--vr-response-soft),transparent 86%)!important
}
.liveScreen[data-participation="group"] .congregationParallel{
  border-left-color:var(--vr-response-border)!important;
  background:linear-gradient(90deg,var(--vr-response-soft),var(--vr-response-soft-2) 74%,transparent)!important
}

html.aoRecitationGroup #aoPrayerBookRoot .aoCustomaryResponse,
#aoPrayerBookRoot.aoRecitationGroup .aoCustomaryResponse,
html.aoRecitationGroup #aoPrayerBookRoot .aoPrayerDialogueLine.aoResponse,
#aoPrayerBookRoot.aoRecitationGroup .aoPrayerDialogueLine.aoResponse,
html.aoRecitationGroup #aoPrayerBookRoot .aoLitanyResponse,
#aoPrayerBookRoot.aoRecitationGroup .aoLitanyResponse,
#aoPrayerBookRoot .aoPrayerDialogueLine.aoGroupResponse,
#aoPrayerBookRoot .aoLitanyLine.aoGroupLitany .aoLitanyResponse{
  border-left-color:var(--vr-response-border)!important;
  background:linear-gradient(90deg,var(--vr-response-soft),var(--vr-response-soft-2) 72%,transparent)!important;
  box-shadow:none!important
}
#aoPrayerBookRoot .aoGroupResponseKicker{color:var(--vr-response)!important}

.prayerFlip .aoRomanDialogueLine.aoGroupResponse,
.romanCorpus .aoRomanDialogueLine.aoGroupResponse{
  border-left-color:var(--vr-response-border)!important;
  border-top-color:color-mix(in srgb,var(--vr-response) 22%,transparent)!important;
  border-bottom-color:color-mix(in srgb,var(--vr-response) 22%,transparent)!important;
  background:var(--vr-response-soft)!important
}

html.aoRecitationGroup #aoPray435930 .aoP435930CommonResponse,
html.aoRecitationGroup #aoPray435930 .aoP435930PrayerDialogue.aoResponse,
html.aoRecitationGroup #aoPray435930 .aoP435930LitanyResponse{
  border-left-color:var(--vr-response-border)!important;
  background:linear-gradient(90deg,var(--vr-response-soft),var(--vr-response-soft-2) 72%,transparent)!important;
  box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--vr-response) 7%,transparent)!important;
  color:var(--text,#eee9e2)!important
}

/* Do not recolour the words of responses. Role identity belongs to the mark/rule/wash. */
.responseLine>span:last-child,
.dialoguePair.responsePair .dialogueUnit,
.dialoguePair.congregationResponse .dialogueUnit,
#aoPrayerBookRoot .aoPrayerDialogueLine.aoResponse .aoPrayerDialogueBody,
#aoPrayerBookRoot .aoLitanyResponse>*:not(.aoPrayerRole),
#aoPray435930 .aoP435930PrayerDialogue.aoResponse .aoP435930PrayerWords,
#aoPray435930 .aoP435930LitanyResponse>*:not(.aoP435930PrayerRole){color:var(--text,#eee9df)!important}

@media (prefers-contrast:more){
  :root{--vr-response:#8796B6;--vr-response-border:color-mix(in srgb,var(--vr-response) 90%,transparent)}
  .aoVrMark{font-weight:800}
}
</style>
</head><body>
<div id="ao-cinema-boot" role="status" aria-live="polite" aria-label="Ad Orientem is loading">
  <div class="aoCinemaBootAtmosphere" aria-hidden="true"></div>
  <div class="aoCinemaBootInner">
    <div class="aoCinemaBootCross brandMark aoBrandEmblem aoCinemaBootLogo" aria-hidden="true"></div>
    <div class="aoCinemaBootKicker">Missale Romanum · 1962</div>
    <div class="aoCinemaBootTitle">Ad Orientem</div>
    <div class="aoCinemaBootSub">A traditional Roman Rite companion</div>
    <div class="aoCinemaBootRule" aria-hidden="true"><i></i></div>
    <div class="aoCinemaBootStatus" data-ao-cinema-boot-status>Preparing today’s Mass…</div>
  </div>
</div>
<div id="ao-cinema-transition" aria-hidden="true"><div class="aoCinemaTransitionInner"><span class="aoCinemaTransitionGlyph brandMark aoBrandEmblem aoCinemaTransitionLogo" aria-hidden="true"></span><span class="aoCinemaTransitionKicker" data-ao-cinema-transition-kicker>AD ORIENTEM</span><span class="aoCinemaTransitionTitle" data-ao-cinema-transition-title></span><span class="aoCinemaTransitionLine"></span></div></div>
<div id="ao-cinema-loader" role="status" aria-live="polite" aria-hidden="true"><div class="aoCinemaLoaderCard"><div class="aoCinemaLoaderHead"><span class="aoCinemaLoaderMark brandMark aoBrandEmblem aoCinemaLoaderLogo" aria-hidden="true"></span><span class="aoCinemaLoaderText"><b data-ao-cinema-loader-title>Loading…</b><small data-ao-cinema-loader-sub>Preparing the requested content</small></span></div><div class="aoCinemaSkeleton" aria-hidden="true"><i></i><i></i><i></i></div></div></div>
<div id="app"><div class="aoBootFallback" role="status">Loading Ad Orientem…</div></div>
<style id="ao-phase1-proper-art-v1-css">
