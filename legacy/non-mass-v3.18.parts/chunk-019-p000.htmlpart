 if(cls===4)conditions.push(L('A just cause (necessity, benefit or devotion) is required.','Une juste cause (nécessité, utilité ou dévotion) est requise.'));
 if(['grave_public','special_occasion'].includes(basis?.id))conditions.push(L('The required order or permission of the competent Ordinary must actually exist.','L’ordre ou la permission requis de l’Ordinaire compétent doit réellement exister.'));
 if(basis?.id==='sanctuary')conditions.push(L('The sanctuary/pilgrimage conditions of RG 373–377 must actually be met.','Les conditions de sanctuaire/pèlerinage des RG 373–377 doivent réellement être remplies.'));
 if(same&&(f.rank===3||f.rank===4))additions.push(L('The Office of the day is not commemorated in this votive Mass.','L’Office du jour n’est pas commémoré dans cette Messe votive.'));
 return resultBase('permitted','votive-permitted',L('Permitted today','Permise aujourd’hui'),L(`The selected rubrical basis makes this a votive Mass ${['','I','II','III','IV'][cls]} class, and today’s ${f.day.rank||''} day admits that class.`,`La base rubricale choisie en fait une Messe votive de ${['','Ie','IIe','IIIe','IVe'][cls]} classe, et le jour d’aujourd’hui (${f.day.rank||''}) admet cette classe.`),{votiveClass:cls,basis:basis?.id,gloria,credo,tone,conditions,additions,sources:rubricalSources(basis?.source,'RG 317–324',cls===1?'RG 328–330':cls===2?'RG 341–343':cls===3?'RG 384–386':'RG 387–389')});
}
function resolveVotive(def,f=dayFacts()){
 const block=genericVotiveBlock(f);if(block)return block;
 const basis=currentVotiveBasis(def,f);if(!basis)return resultBase('prohibited','no-votive-basis',L('No rubrical basis is available','Aucune base rubricale n’est disponible'),L('This formulary is not exposed without a defined 1960-rubric basis.'),{sources:[]});
 return applyVotiveClass(def,basis,f);
}
function resolveNuptial(def,f=dayFacts()){
 const c=ARCH.rubricContext;
 if(c.mixedMarriage)return resultBase('prohibited','nuptial-mixed-marriage',L('Nuptial Mass and blessing prohibited by the 1960 rubric','Messe et bénédiction nuptiales interdites par la rubrique de 1960'),L('The 1960 General Rubrics list a mixed marriage among the circumstances in which the special Nuptial Mass and Nuptial Blessing are absolutely forbidden. This is a historical liturgical rule, not a statement of present marriage law.'),{votiveClass:2,transferable:false,sources:rubricalSources('RG 381')});
 if(!c.couplePresent)return resultBase('prohibited','nuptial-couple-absent',L('Nuptial blessing cannot be given','La bénédiction nuptiale ne peut être donnée'),L('The Nuptial Blessing is omitted when the bridal couple are not present; the special Nuptial Mass cannot be celebrated when the blessing cannot be given.'),{votiveClass:2,transferable:true,sources:rubricalSources('RG 379–381c')});
 if(c.bridePreviouslyBlessed)return resultBase('prohibited','nuptial-bride-prior-blessing',L('Nuptial blessing not repeated','La bénédiction nuptiale n’est pas répétée'),L('Under the 1960 rubric the Nuptial Blessing is omitted if the bride has already received it; consequently the special Nuptial Mass cannot be celebrated.'),{votiveClass:2,sources:rubricalSources('RG 379, 381c')});
 if(c.groomPreviouslyBlessed&&!c.groomOnlyCustomAllowsBlessing)return resultBase('permittedWithChanges','nuptial-groom-prior-custom-check',L('Local custom must be verified','La coutume locale doit être vérifiée'),L('The rubric preserves a custom, where it exists, of imparting the Nuptial Blessing when only the man has previously received it. Until that local custom is confirmed, Ad Orientem does not assume the blessing may be repeated.'),{votiveClass:2,conditions:[L('Confirm whether the local custom mentioned in RG 381c applies.','Vérifiez si la coutume locale mentionnée au RG 381c s’applique.')],sources:rubricalSources('RG 381c')});
 if(isAllSouls(f)||isTriduum(f))return resultBase('prohibited','nuptial-absolute-prohibition',L('Nuptial Mass and blessing prohibited','Messe et bénédiction nuptiales interdites'),L('On All Souls’ Day and the last three days of Holy Week, the Nuptial Mass, its commemoration in the Mass of the day, and the Nuptial Blessing are all forbidden.'),{votiveClass:2,transferable:true,sources:rubricalSources('RG 381d')});
 if(isTempusClausum(f)&&!c.closedTimePermission)return resultBase('prohibited','nuptial-closed-time',L('Nuptial Mass and blessing require permission in the closed season','La Messe et la bénédiction nuptiales exigent une permission pendant le temps clos'),L('From the first Sunday of Advent through Christmas Day, and from Ash Wednesday through Easter Sunday, the Nuptial Mass and solemn blessing require permission of the local Ordinary for a just cause; the last three days of Holy Week remain absolutely excluded.'),{votiveClass:2,transferable:true,sources:rubricalSources('RG 378–381')});
 if(f.isSunday||f.rank===1)return resultBase('permittedWithChanges','nuptial-mass-of-day',L('Mass of the Day + Nuptial rites','Messe du jour + rites nuptiaux'),L('The special Nuptial votive Mass is impeded, but the Nuptial Blessing is not. The Mass of the Office is celebrated; the Nuptial collect is added under one conclusion and the blessing is given during Mass.'),{votiveClass:2,resultingCelebration:'mass_of_day',properSourceOverride:calendarPath(),additions:[L('Nuptial collect under one conclusion with the Collect of the day','Collecte nuptiale sous une seule conclusion avec la Collecte du jour'),L('Nuptial Blessing during Mass in the places prescribed by the Missal','Bénédiction nuptiale pendant la Messe aux endroits prescrits par le Missel')],sources:rubricalSources('RG 341, 378–381')});
 if(f.rank!=null&&f.rank>=2)return resultBase('permitted','nuptial-permitted',L('Nuptial Mass permitted','Messe nuptiale permise'),L('The Mass “For Bride and Bridegroom” is a votive Mass II class and is permitted today; the Nuptial Blessing is given within the Mass.'),{votiveClass:2,resultingCelebration:'nuptial',gloria:true,credo:isChristmasOctave(f),additions:[L('Nuptial Blessing within Mass','Bénédiction nuptiale dans la Messe')],conditions:c.groomPreviouslyBlessed?[L('The preserved local custom allowing the blessing when only the groom has previously received it has been affirmed.','La coutume locale conservée permettant la bénédiction lorsque seul l’époux l’a déjà reçue a été confirmée.')]:[],sources:rubricalSources('RG 341, 378–381')});
 return resultBase('permittedWithChanges','nuptial-rank-unresolved',L('Calendar class must be verified','La classe du jour doit être vérifiée'),L('The Nuptial rules are known, but the day’s I–IV class could not be read reliably.'),{votiveClass:2,sources:rubricalSources('RG 341, 378–381')});
}
function generalRequiemBlock(f=dayFacts()){
 const c=ARCH.rubricContext;
 if(c.exposition&&!isAllSouls(f))return resultBase('prohibited','requiem-exposition',L('Requiem prohibited during exposition','Requiem interdit pendant l’exposition'),L('Any Mass of the Dead is forbidden in a church or oratory for the whole time the Blessed Sacrament is exposed, except the Masses of All Souls.’'),{sources:rubricalSources('RG 393a')});
 if(c.conventualConflict)return resultBase('prohibited','requiem-conventual-conflict',L('Requiem prohibited at this Mass','Requiem interdit à cette Messe'),L('In a church having only one Mass, a Mass of the Dead is forbidden when a binding conventual Mass cannot be fulfilled by another priest, unless that conventual Mass itself may or must be for the Dead.'),{sources:rubricalSources('RG 393b')});
 if(c.onlyMassWithCandleBlessing&&isCandlemas(f))return resultBase('prohibited','requiem-candlemas-only-mass',L('Requiem prohibited at the only Mass','Requiem interdit à la Messe unique'),L('On 2 February, if this is the church’s only Mass and the blessing of candles takes place, a Mass of the Dead is forbidden.'),{sources:rubricalSources('RG 393c')});
 if(c.onlyMassWithAshes&&isAshWednesday(f))return resultBase('prohibited','requiem-ashes-only-mass',L('Requiem prohibited at the only Mass','Requiem interdit à la Messe unique'),L('On Ash Wednesday, if this is the church’s only Mass and the blessing/imposition of ashes takes place, a Mass of the Dead is forbidden.'),{sources:rubricalSources('RG 393c')});
 if(c.rogationMassRequired)return resultBase('prohibited','requiem-rogation-required',L('Rogation Mass takes precedence','La Messe des Rogations a préséance'),L('Where the Rogation Mass must be said with the Greater or Lesser Litanies in a church having only one Mass, a Mass of the Dead is forbidden.'),{sources:rubricalSources('RG 393c')});
 return null;
}
function resolveRequiem(def,f=dayFacts()){
 const block=generalRequiemBlock(f);if(block)return block;
 const c=ARCH.requiemCircumstance||ARCH.actualCelebration.circumstance||'ordinary';
 if(isAllSouls(f)&&c==='funeral')return resultBase('permittedWithChanges','funeral-all-souls',L('Funeral Mass permitted using the All Souls formulary','Messe de funérailles permise avec le formulaire de la Commémoration des fidèles défunts'),L('On All Souls’ Day a Funeral Mass uses the first Mass of the day with the appropriate prayers for the deceased; if the first Mass is already used for the Office, the second, or as a last resort the third, is used.'),{requiemClass:1,resultingCelebration:'mass_of_day',properSourceOverride:calendarPath(),sequenceDiesIrae:'required',additions:[L('Appropriate Funeral-Mass prayers for the deceased','Oraisons propres de la Messe de funérailles pour le défunt'),L('Absolution over the body or catafalque after Mass','Absoute sur le corps ou le catafalque après la Messe')],sources:rubricalSources('RG 402–409')});
 if(isAllSouls(f))return resultBase('permittedWithChanges','requiem-all-souls-calendar',L('Use the calendar Mass of All Souls','Utilisez la Messe du calendrier de la Commémoration des fidèles défunts'),L('All Souls is itself a I-class liturgical day with its own three Mass formularies. Generic Requiem selection is replaced by the Mass of the Day.'),{requiemClass:1,resultingCelebration:'mass_of_day',properSourceOverride:calendarPath(),sources:rubricalSources('RG 402–404')});
 if(c==='funeral'){
  const universal=funeralUniversalBlock(f);if(universal)return resultBase('impeded','funeral-universal-impediment',L('Funeral Mass impeded today','Messe de funérailles empêchée aujourd’hui'),L('The day belongs to one of the universal categories on which the 1960 rubrics prohibit the Funeral Mass. It may be transferred to the nearest unimpeded day.'),{requiemClass:1,transferable:true,sources:rubricalSources('RG 405–409',universal)});
  if(ARCH.rubricContext.holyDayOfObligation||ARCH.rubricContext.localFuneralImpediment)return resultBase('impeded','funeral-local-impediment',L('Funeral Mass impeded by a local/particular rule','Messe de funérailles empêchée par une règle locale/particulière'),L('The Funeral Mass is also forbidden on the specified holydays of obligation and on certain local dedication, titular, patronal, founder or religious-order feasts.'),{requiemClass:1,transferable:true,sources:rubricalSources('RG 406b–e')});
  const conditions=[];if(f.rank===1)conditions.push(L('Because this is a I-class day not automatically covered by the universal blockers, confirm that it is not a local holy day of obligation or one of the particular feasts listed in RG 406.','Comme il s’agit d’un jour de Ie classe non couvert automatiquement par les empêchements universels, vérifiez qu’il ne s’agit pas d’un jour de précepte local ni d’une des fêtes particulières énumérées au RG 406.'));
  return resultBase(conditions.length?'permittedWithChanges':'permitted','funeral-permitted',conditions.length?L('Generally permitted · local check required','Généralement permise · vérification locale requise'):L('Funeral Mass permitted','Messe de funérailles permise'),L('The Funeral Mass is a Mass of the Dead I class directly connected with the obsequies; no universal impediment has been detected for this day.'),{requiemClass:1,conditions,sequenceDiesIrae:'required',additions:[L('Absolution over the body or catafalque after Mass','Absoute sur le corps ou le catafalque après la Messe')],sources:rubricalSources('RG 399–401, 402, 405–409')});
 }
 if(['death','news','burial'].includes(c)){
  if(f.isSunday||f.rank===1)return resultBase('impeded','requiem-ii-impeded',L('II-class Requiem impeded today','Requiem de IIe classe empêché aujourd’hui'),L('A Mass on the day of death, after news of death, or for final interment is a Mass of the Dead II class and is not allowed on any Sunday or a liturgical day I class.'),{requiemClass:2,transferable:c==='news',sources:rubricalSources('RG 410–414')});
  return resultBase('permitted','requiem-ii-permitted',L('II-class Requiem permitted','Requiem de IIe classe permis'),L('The selected circumstance is a Mass of the Dead II class and today is neither a Sunday nor a I-class liturgical day.'),{requiemClass:2,sequenceDiesIrae:'optional',conditions:[L('The Mass must be applied for the deceased person.','La Messe doit être appliquée pour la personne défunte.')],sources:rubricalSources('RG 410–414')});
 }
 if(['days','anniversary','cemetery','all_souls_octave'].includes(c)){
  if(c==='all_souls_octave'){const md=f.month*100+f.dom;if(!(md>=1102&&md<=1109))return resultBase('impeded','requiem-all-souls-octave-date',L('This privilege belongs only to the eight-day period beginning on All Souls','Ce privilège n’appartient qu’aux huit jours commençant à la Commémoration des fidèles défunts'),L('The special III-class permission applies only within the eight days from All Souls’ Day inclusive.'),{requiemClass:3,sources:rubricalSources('RG 422')});}

  if(f.rank!=null&&f.rank<=2)return resultBase('impeded','requiem-iii-impeded',L('III-class Requiem impeded today','Requiem de IIIe classe empêché aujourd’hui'),L('The selected Requiem belongs to the III-class group and is forbidden on liturgical days I and II class.'),{requiemClass:3,transferable:['days','anniversary'].includes(c),sources:rubricalSources('RG 415–422')});
  if(f.rank==null)return resultBase('permittedWithChanges','requiem-iii-rank-unresolved',L('Calendar class must be verified','La classe du jour doit être vérifiée'),L('The III-class Requiem rule is known, but the calendar class could not be read reliably.'),{requiemClass:3,sources:rubricalSources('RG 415–419')});
  return resultBase('permitted','requiem-iii-permitted',L('III-class Requiem permitted','Requiem de IIIe classe permis'),L('The selected Requiem is III class, and today is a III- or IV-class liturgical day.'),{requiemClass:3,sequenceDiesIrae:'optional',conditions:c==='cemetery'?[L('The church or chapel must meet the cemetery-place definition of RG 420 and the Mass must be applied for the dead.','L’église ou chapelle doit répondre à la définition du lieu de cimetière du RG 420 et la Messe doit être appliquée pour les défunts.')]:[],sources:rubricalSources('RG 415–422')});
 }
 if(c==='ordinary'){
  if(isFeriaIV(f)&&!isChristmasSeason(f))return resultBase('permitted','requiem-iv-permitted',L('Daily Requiem permitted','Requiem quotidien permis'),L('A IV-class “Daily” Mass of the Dead may replace the Mass of the Office only on a feria IV class outside the Christmas season, and it should in fact be applied for the dead.'),{requiemClass:4,sequenceDiesIrae:'optional',conditions:[L('The Mass should actually be applied for the dead.','La Messe doit réellement être appliquée aux défunts.')],sources:rubricalSources('RG 423')});
  return resultBase('impeded','requiem-iv-impeded',L('Daily Requiem not permitted today','Requiem quotidien non permis aujourd’hui'),L('A IV-class “Daily” Requiem is limited to ferias IV class outside the Christmas season.'),{requiemClass:4,sources:rubricalSources('RG 423')});
 }
 return resultBase('prohibited','requiem-circumstance-missing',L('Requiem circumstance required','Circonstance du Requiem requise'),L('Choose the actual occasion so the app can determine the correct Requiem class.'),{sources:rubricalSources('RG 390–423')});
}
function rubricResolve(){
 const def=actualDef(),f=dayFacts();let out;
 if(!def){out=resultBase('permitted','calendar-mass',L('Mass of the Day','Messe du jour'),L('This is the celebration resolved by the 1962 calendar.'),{resultingCelebration:'mass_of_day',properSourceOverride:calendarPath(),sources:rubricalSources('1960 General Rubrics · calendar order')});}
 else if(!actualPath()){out=resultBase('prohibited','no-source',L('No usable formulary source','Aucune source de formulaire utilisable'),L('This celebration is not exposed without a defined source resolver.'),{sources:[]});}
 else if(def.type==='votive')out=resolveVotive(def,f);
 else if(def.type==='nuptial')out=resolveNuptial(def,f);
 else if(def.type==='requiem')out=resolveRequiem(def,f);
 else out=resultBase('prohibited','unsupported-celebration-type',L('Unsupported celebration type','Type de célébration non pris en charge'),L('No rubrical resolver has been defined for this celebration type.'),{sources:[]});
 if(def?.type==='requiem'&&ARCH.requiemCircumstance)out.circumstance=ARCH.requiemCircumstance;
 ARCH.rubric=out;return out;
}
function diag(){return{requestedFiles:[],cacheHits:[],referencesResolved:[],languageGaps:[],structuralInheritances:[],legacyCommonRecoveries:[],votiveRecoveries:[],warnings:[],errors:[]}}
async function resolveReadiness(){
 const token=++ARCH.lastResolveToken;ARCH.readiness={loading:true};ARCH.resolvedProper=null;paintOpenSheet();
 try{
  const s=core();let p=null;
  if(ARCH.actualCelebration.id==='mass_of_day'){p=s?.resolution?.proper?.status==='ready'?s.resolution.proper.data:null;if(!p)throw new Error('Calendar Proper is not ready.');}
  else {const def=actualDef(),pr=rt()?.resolver?.properResolver;if(!pr)throw new Error('Proper resolver is not ready.');const meta={name:def.title.en,nameFr:def.title.fr,rank:'supplementary',color:def.colour||'White',properId:`celebration:${ARCH.actualCelebration.id}`,path:actualPath(),profile:def.type==='requiem'?'requiem_mass_1962':'ordinary_mass_1962',gloria:false,credo:false,inherited:false};p=await pr.resolveProper(meta,diag());}
  if(token!==ARCH.lastResolveToken)return;ARCH.resolvedProper=p;const en=p?.languageCoverage?.en||null,fr=p?.languageCoverage?.fr||null;ARCH.readiness={loading:false,la:{complete:true,expected:'Latin source',available:'ready',missing:[]},en:en||{complete:false,expected:0,available:0,missing:['not audited']},fr:fr||{complete:false,expected:0,available:0,missing:['not audited']},sourcePath:p?.sourcePath||actualPath()};
 }catch(e){if(token!==ARCH.lastResolveToken)return;ARCH.readiness={loading:false,error:e instanceof Error?e.message:String(e),la:{complete:!!actualPath()},en:{complete:false,expected:0,available:0,missing:['unavailable']},fr:{complete:false,expected:0,available:0,missing:['unavailable']},sourcePath:actualPath()};}
 paintOpenSheet();augmentHome();
}
function syncFromCore(){
 const s=core();if(!s)return;const changed=ARCH.date!==s.selectedDate;ARCH.liturgicalDay=liturgicalDayObject(s);if(changed){ARCH.date=s.selectedDate;ARCH.actualCelebration={id:'mass_of_day',type:'calendar'};ARCH.requiemCircumstance=null;ARCH.votiveBasis='ordinary';ARCH.rubricContext.closedTimePermission=false;ARCH.rubricContext.mixedMarriage=false;ARCH.rubricContext.bridePreviouslyBlessed=false;ARCH.rubricContext.groomPreviouslyBlessed=false;ARCH.rubricContext.groomOnlyCustomAllowsBlessing=false;ARCH.readiness=null;ARCH.resolvedProper=null;ARCH.rubric=null;}if(!ARCH.celebrationForm)ARCH.celebrationForm=s.settings?.massForm||'sung';if(!ARCH.followMode)ARCH.followMode=s.settings?.followMode||'vox';
}
function statusClass(r){return r.status==='permitted'?'ok':r.status==='impeded'||r.status==='prohibited'?'bad':'warn'}
function readinessCell(code,obj){if(ARCH.readiness?.loading)return `<div class="aoReadyCell"><b>${code}</b><span>${L('checking…','vérification…')}</span></div>`;if(ARCH.readiness?.error&&!obj?.complete)return `<div class="aoReadyCell bad"><b>${code}</b><span>${L('unavailable','indisponible')}</span></div>`;if(!obj)return `<div class="aoReadyCell bad"><b>${code}</b><span>${L('unavailable','indisponible')}</span></div>`;const complete=!!obj.complete,avail=obj.available;const text=complete?L('available','disponible'):(avail?L('partial','partiel'):L('unavailable','indisponible'));return `<div class="aoReadyCell ${complete?'good':avail?'partial':'bad'}"><b>${code}</b><span>${esc(text)}</span></div>`}
function top(title,kicker,back=true){return `<div class="aoMassFlowTop"><button ${back?'data-ao-back':''} aria-label="Back">${back?'‹':'×'}</button><div class="title"><small>${esc(kicker)}</small><b>${esc(title)}</b></div><button data-ao-close aria-label="Close">×</button></div>`}
function shell(body,title=L('Change Mass','Changer de Messe'),kicker='Ad Orientem'){return `<div class="aoMassFlowBackdrop" data-ao-backdrop><section class="aoMassFlow" role="dialog" aria-modal="true">${top(title,kicker,ARCH.history.length>0)}<div class="aoMassFlowBody">${body}</div></section></div>`}
function currentCalendarSummary(){return `<div class="aoCalendarContext"><b>${esc(L('Calendar day','Jour liturgique'))}:</b> ${esc(ARCH.liturgicalDay?.title||'')} · ${esc(String(ARCH.liturgicalDay?.rank||''))}${ARCH.liturgicalDay?.colour?` · ${esc(ARCH.liturgicalDay.colour)}`:''}</div>`}
function mainChooser(){return shell(`<p class="aoFlowLead">${L('The calendar remains the default. Choose another celebration only when it is actually being celebrated.','Le calendrier reste le choix par défaut. Choisissez une autre célébration seulement si elle est réellement célébrée.')}</p><div class="aoFlowOptions"><button class="aoFlowOption" data-ao-select-day><div><b>${L('Mass of the Day','Messe du jour')}</b><span>${esc(ARCH.liturgicalDay?.title||'')}</span></div><i>→</i></button><button class="aoFlowOption" data-ao-open="votive"><div><b>${L('Votive Mass','Messe votive')}</b><span>${L('Choose the celebration; seasonal variants are automatic.','Choisissez la célébration; les variantes saisonnières sont automatiques.')}</span></div><i>→</i></button><button class="aoFlowOption" data-ao-open="nuptial"><div><b>${L('Marriage / Nuptial Mass','Mariage / Messe nuptiale')}</b><span>Missa pro Sponso et Sponsa</span></div><i>→</i></button><button class="aoFlowOption" data-ao-open="requiem"><div><b>${L('Mass for the Dead','Messe des défunts')}</b><span>${L('Choose the occasion.','Choisissez la circonstance.')}</span></div><i>→</i></button><button class="aoFlowOption" data-ao-open="other"><div><b>${L('Other special celebration','Autre célébration spéciale')}</b><span>${L('Choose from the available special celebrations.','Choisissez parmi les célébrations spéciales disponibles.')}</span></div><i>→</i></button></div>${currentCalendarSummary()}`,L('What Mass is being celebrated?','Quelle Messe est célébrée ?'))}
function votiveChooser(){const q=(ARCH.search||'').trim().toLowerCase();let html=`<p class="aoFlowLead">${L('Choose the celebration. Seasonal variants are selected automatically.','Choisissez la célébration. Les variantes saisonnières sont sélectionnées automatiquement.')}</p><input class="aoFlowSearch" data-ao-search placeholder="${L('Search votive Masses','Rechercher une Messe votive')}" value="${esc(ARCH.search)}"><div class="aoVotiveGroups">`;for(const [g,labels] of Object.entries(GROUPS)){const items=Object.entries(CATALOGUE).filter(([,d])=>d.type==='votive'&&d.group===g&&(!q||(d.title.en+' '+d.title.fr).toLowerCase().includes(q)));if(!items.length)continue;html+=`<section class="aoVotiveGroup"><h3>${esc(labels[lang()])}</h3>${items.map(([id,d])=>`<button class="aoVotiveItem" data-ao-celebration="${esc(id)}"><div><b>${esc(d.title[lang()]||d.title.en)}</b></div><i>→</i></button>`).join('')}</section>`}html+='</div>';return shell(html,L('Votive Masses','Messes votives'))}
function nuptialChooser(){return shell(`<div class="aoPreflightHero"><small>${L('Marriage','Mariage')}</small><h2>Missa pro Sponso et Sponsa</h2><p>${L('The Nuptial Mass texts are available. The app will check whether this celebration is permitted today and show any relevant nuptial rites.','Les textes de la Messe nuptiale sont disponibles. L’application vérifiera si cette célébration est permise aujourd’hui et indiquera les rites nuptiaux pertinents.')}</p></div>${currentCalendarSummary()}<div class="aoFlowActions"><button class="primary" data-ao-celebration="nuptial">${L("Check today's celebration","Vérifier la célébration du jour")}</button></div>`,L('Marriage / Nuptial Mass','Mariage / Messe nuptiale'))}
function requiemChooser(){return shell(`<p class="aoFlowLead">${L('What is the occasion? Choose the circumstance that applies.','Quelle est la circonstance ? Choisissez celle qui s’applique.')}</p><div class="aoFlowOptions">${Object.entries(REQUIEM_CIRCUMSTANCES).map(([id,x])=>`<button class="aoCircumstance" data-ao-requiem="${id}"><div><b>${esc(x[lang()])}</b><span>${id==='ordinary'?L('General Mass for the Dead','Messe générale pour les défunts'):L('The app will check the applicable rubrics for this occasion.','L’application vérifiera les rubriques applicables à cette circonstance.')}</span></div><i>→</i></button>`).join('')}</div><p class="aoPrototypeNote">${L('On 2 November, the Masses of All Souls are selected through the calendar.','Le 2 novembre, les Messes de la Commémoration des fidèles défunts sont sélectionnées par le calendrier.')}</p>`,L('Mass for the Dead','Messe des défunts'))}
function otherChooser(){return shell(`<p class="aoFlowLead">${L('Only celebrations that are fully supported are available here.','Seules les célébrations entièrement prises en charge sont disponibles ici.')}</p><div class="aoFlowOptions"><button class="aoFlowOption disabled"><div><b>${L('External Solemnity','Solennité extérieure')}</b><span>${L('Not available yet','Pas encore disponible')}</span></div><i>—</i></button><button class="aoFlowOption disabled"><div><b>${L('Special public occasion','Occasion publique spéciale')}</b><span>${L('Not available yet','Pas encore disponible')}</span></div><i>—</i></button></div>`,L('Other special celebration','Autre célébration spéciale'))}
function preflight(){const ms=core()?.settings||{},def=actualDef(),r=rubricResolve(),circ=ARCH.requiemCircumstance?REQUIEM_CIRCUMSTANCES[ARCH.requiemCircumstance]?.[lang()]:null;const typeLabel=def?.type==='votive'?L('Votive Mass','Messe votive'):def?.type==='nuptial'?L('Nuptial Mass','Messe nuptiale'):def?.type==='requiem'?L('Requiem','Requiem'):L('Mass of the Day','Messe du jour');const reasonDetails=`<b>${L('Today','Aujourd’hui')}:</b> ${esc(ARCH.liturgicalDay?.title||'')} · ${esc(String(ARCH.liturgicalDay?.rank||''))}<br><b>${L('Requested','Demandée')}:</b> ${esc(actualTitle())}${circ?` · ${esc(circ)}`:''}<br><b>${L('Decision','Décision')}:</b> ${esc(r.reason)}`;return shell(`<div class="aoPreflightHero"><small>${esc(typeLabel)}</small><h2>${esc(actualTitle())}</h2>${circ?`<p>${esc(circ)}</p>`:''}</div>${ARCH.actualCelebration.id!=='mass_of_day'?currentCalendarSummary():''}${votiveBasisUI()}${nuptialContextUI()}${requiemContextUI()}<div class="aoRubricStatus ${statusClass(r)}"><div>${r.status==='permitted'?'✓':r.status==='impeded'||r.status==='prohibited'?'!':'◐'}</div><div><strong>${esc(r.summary)}</strong><p>${esc(r.reason)}</p></div></div>${rubricEffectsUI(r)}<details class="aoWhyRubric"><summary>${L('Why?','Pourquoi ?')}</summary><div>${reasonDetails}</div></details><div class="aoFlowSection">${L('How is Mass celebrated?','Comment la Messe est-elle célébrée ?')}</div><div class="aoChoiceGrid"><button data-ao-form="sung" class="${ARCH.celebrationForm==='sung'?'active':''}"><b>${L('Sung Mass','Messe chantée')}</b><small>${L('Use the sung form for this Mass.','Utiliser la forme chantée pour cette Messe.')}</small></button><button data-ao-form="low" class="${ARCH.celebrationForm==='low'?'active':''}"><b>${L('Low Mass','Messe basse')}</b><small>${L('Use the Low Mass form for this Mass.','Utiliser la forme basse pour cette Messe.')}</small></button></div>${ARCH.celebrationForm==='sung'?`<div class="aoFlowSection">${L('Sung Mass options','Options de la Messe chantée')}</div><div class="aoChoiceGrid"><button data-ao-epistle-minister="celebrant" class="${ms.epistleMinister==='lector'?'':'active'}"><b>${L('Celebrant','Célébrant')}</b><small>${L('The celebrant reads or sings the Epistle himself.','Le célébrant lit ou chante lui-même l’Épître.')}</small></button><button data-ao-epistle-minister="lector" class="${ms.epistleMinister==='lector'?'active':''}"><b>${L('Lector','Lecteur')}</b><small>${L('A lector sings the Epistle; the celebrant does not duplicate it.','Un lecteur chante l’Épître ; le célébrant ne la répète pas.')}</small></button></div><div class="aoChoiceGrid aoV4338InterlectionChoice"><button data-ao-interlection="altar" class="${ms.longInterlectionSeating?'':'active'}"><b>${L('Remain at altar','Rester à l’autel')}</b><small>${L('No optional sedilia interval is assumed.','Aucun intervalle facultatif au siège n’est supposé.')}</small></button><button data-ao-interlection="sedilia" class="${ms.longInterlectionSeating?'active':''}"><b>${L('Sit for a long chant','S’asseoir pour un chant long')}</b><small>${L('Where the local ceremonial uses it, the celebrant may sit after his private reading while the schola continues.','Lorsque le cérémonial local le prévoit, le célébrant peut s’asseoir après sa lecture privée tandis que la schola poursuit le chant.')}</small></button></div>`:''}<div class="aoFlowSection">${L('How do you want to follow?','Comment voulez-vous suivre ?')}</div><div class="aoChoiceGrid"><button data-ao-follow="vox" class="${ARCH.followMode==='vox'?'active':''}"><b>VOX</b><small>${L('Follow what is heard','Suivre ce qui est entendu')}</small></button><button data-ao-follow="missal" class="${ARCH.followMode==='missal'?'active':''}"><b>${L('Missal','Missel')}</b><small>${L('Follow the complete liturgical action','Suivre l’action liturgique complète')}</small></button></div><div class="aoFlowSection">${L('Texts','Textes')}</div>${ARCH.readiness?.loading?`<div class="aoFlowLoading">${L('Preparing the selected Mass…','Préparation de la Messe sélectionnée…')}</div>`:`<div class="aoReadiness">${readinessCell('LA',ARCH.readiness?.la)}${readinessCell('EN',ARCH.readiness?.en)}${readinessCell('FR',ARCH.readiness?.fr)}</div>`}${ARCH.readiness?.error?`<p class="aoPrototypeNote">${L('Some texts could not be loaded. You can still review the selection and try again.','Certains textes n’ont pas pu être chargés. Vous pouvez tout de même vérifier la sélection et réessayer.')}</p>`:''}<div class="aoFlowActions"><button data-ao-save-defaults>${L('Save these choices as defaults','Enregistrer ces choix par défaut')}</button><button data-ao-details>${L('Mass Details','Détails de la Messe')}</button></div>`,L('Prepare this Mass','Préparer cette Messe'))}
function localized(v){if(!v)return '';if(typeof v==='string')return v;return (lang()==='fr'?v.fr:v.en)||v.lat||''}
function effectiveCelebrationView(){
 const r=rubricResolve();
 const requested=ARCH.actualCelebration.id!=='mass_of_day';
 const fallsBack=requested&&r?.resultingCelebration==='mass_of_day';
 const blocked=requested&&['impeded','prohibited'].includes(r?.status);
 const calendar=ARCH.actualCelebration.id==='mass_of_day'||fallsBack||blocked;
 return {
  decision:r,
  calendar,
  title:calendar?calendarTitle():actualTitle(),
  path:calendar?calendarPath():actualPath(),
  type:calendar?'calendar':actualType(),
  requestedTitle:requested?actualTitle():null,
  requestedPath:requested?actualPath():null,
  requested,
  fallsBack,
  blocked
 };
}
function details(){
 const v=effectiveCelebrationView(),r=v.decision;
 const cal=core()?.resolution?.proper?.status==='ready'?core().resolution.proper.data:null;
 const p=v.calendar?cal:ARCH.resolvedProper;
 const fields=[[L('Introit','Introït'),p?.introit],[L('Collect','Collecte'),p?.collects?.[0]],[L('Epistle / Lesson','Épître / Leçon'),p?.epistle],[L('Gospel','Évangile'),p?.gospel],[L('Offertory','Offertoire'),p?.offertory],[L('Communion','Communion'),p?.communion]];
 const requestedNote=v.requested&&v.calendar?`<div class="aoCalendarContext"><b>${L('Requested celebration','Célébration demandée')}:</b> ${esc(v.requestedTitle||'')}<br><b>${L('Result','Résultat')}:</b> ${esc(r?.summary||L('Mass of the Day','Messe du jour'))}</div>`:'';
 const additions=(r?.additions||[]).length?`<div class="aoEffectList"><b>${L('Inserted / retained rites','Rites insérés / conservés')}</b><ul>${r.additions.map(x=>`<li>${esc(x)}</li>`).join('')}</ul></div>`:'';
 return shell(`<div class="aoPreflightHero"><small>${L('Mass Details','Détails de la Messe')}</small><h2>${esc(v.title)}</h2></div>${requestedNote}${additions}<div class="aoFlowSection">${L('Texts for this Mass','Textes de cette Messe')}</div>${!p?`<div class="aoFlowLoading">${L('The texts for this Mass are not available yet.','Les textes de cette Messe ne sont pas encore disponibles.')}</div>`:`<div class="aoDetailsGrid">${fields.map(([label,val])=>`<article><b>${esc(label)}</b><p>${esc(localized(val)||L('Unavailable in the current language.','Indisponible dans la langue actuelle.'))}</p></article>`).join('')}</div>`}<div class="aoFlowActions"><button data-ao-preflight>${L('Back','Retour')}</button>${v.requested&&!v.calendar?`<button data-ao-calendar-mass>${L('Calendar Mass','Messe du calendrier')} · ${esc(ARCH.liturgicalDay?.title||'')}</button>`:''}</div>`,L('Mass Details','Détails de la Messe'))
}
function closeSheet(){
 const host=document.getElementById('ao-mass-flow-v1');if(host)host.remove();ARCH.stage=null;ARCH.history=[];
}
function stageMarkup(){
 switch(ARCH.stage){
  case 'main':return mainChooser();
  case 'votive':return votiveChooser();
  case 'nuptial':return nuptialChooser();
  case 'requiem':return requiemChooser();
  case 'other':return otherChooser();
  case 'preflight':return preflight();
  case 'details':return details();
  default:return '';
 }
}
function paintOpenSheet(){
 if(!ARCH.stage){document.getElementById('ao-mass-flow-v1')?.remove();return}
 let host=document.getElementById('ao-mass-flow-v1');
 if(!host){host=document.createElement('div');host.id='ao-mass-flow-v1';document.body.appendChild(host)}
 const html=stageMarkup();if(host.innerHTML!==html)host.innerHTML=html;
 queueMicrotask(()=>window.AO_SEQUENCE_BRIDGE_V23?.decorate?.());
}
function openStage(stage){
 if(!['main','votive','nuptial','requiem','other','preflight','details'].includes(stage))return;
 if(ARCH.stage)ARCH.history.push(ARCH.stage);ARCH.stage=stage;paintOpenSheet();
}
function goBack(){
 const prev=ARCH.history.pop();if(prev){ARCH.stage=prev;paintOpenSheet()}else closeSheet();
}
function resetSelectionState(){
 ARCH.readiness=null;ARCH.resolvedProper=null;ARCH.rubric=null;ARCH.lastResolveToken++;
}
function selectMassOfDay(){
 syncFromCore();ARCH.actualCelebration={id:'mass_of_day',type:'calendar'};ARCH.requiemCircumstance=null;ARCH.votiveBasis='ordinary';resetSelectionState();ARCH.history=[];ARCH.stage='preflight';rubricResolve();paintOpenSheet();void resolveReadiness();augmentHome();
}
function selectCelebration(id,options={}){
 const def=CATALOGUE[id];if(!def)return;
 syncFromCore();ARCH.actualCelebration={id,type:def.type};ARCH.requiemCircumstance=def.type==='requiem'?(options.circumstance||ARCH.requiemCircumstance||'ordinary'):null;ARCH.votiveBasis='ordinary';resetSelectionState();ARCH.history=[];ARCH.stage='preflight';rubricResolve();paintOpenSheet();void resolveReadiness();augmentHome();
}
function openMassDetails(){syncFromCore();ARCH.stage='details';ARCH.history=[];if(!ARCH.readiness)resolveReadiness();paintOpenSheet()}
function augmentHome(){
 syncFromCore();const s=core(),home=document.querySelector('.homeScreen');if(!home||s?.route!=='home')return;
 const v=effectiveCelebrationView(),r=v.decision;
 let ctl=home.querySelector('.aoCelebrationControl');if(!ctl){ctl=document.createElement('section');ctl.className='aoCelebrationControl';const block=home.querySelector('.celebrationBlock');block?.insertAdjacentElement('afterend',ctl)}
 if(ctl){
  let kicker=L('Mass selection','Choix de la Messe'),body=L('The calendar Mass is selected by default.','La Messe du calendrier est sélectionnée par défaut.'),extra='';
  if(v.requested&&!v.calendar){kicker=L('Actual celebration','Célébration actuelle');body=L('Alternative celebration selected','Célébration alternative sélectionnée');extra=`<p class="aoAltCalendar"><b>${L('Calendar day','Jour liturgique')}:</b> ${esc(ARCH.liturgicalDay?.title||'')}</p>`}
  else if(v.requested&&v.fallsBack){kicker=L('Resolved celebration','Célébration résolue');body=esc(r?.summary||L('Mass of the Day','Messe du jour'));extra=`<p class="aoAltCalendar"><b>${L('Requested','Demandée')}:</b> ${esc(v.requestedTitle||'')}<br><b>${L('Result','Résultat')}:</b> ${esc(v.title)}</p>`}
  else if(v.requested&&v.blocked){kicker=L('Requested Mass unavailable','Messe demandée indisponible');body=esc(r?.summary||L('Mass of the Day remains in force.','La Messe du jour demeure en vigueur.'));extra=`<p class="aoAltCalendar"><b>${L('Calendar Mass','Messe du calendrier')}:</b> ${esc(v.title)}</p>`}
  ctl.innerHTML=`<div class="copy"><small>${kicker}</small><b>${esc(v.title)}</b><p>${body}</p>${extra}</div><button data-ao-change-mass>${L('Change Mass','Changer de Messe')}</button>`
 }
 const card=home.querySelector('.massCard');if(card){const k=card.querySelector('.cardKicker'),p=card.querySelector('p');if(k)k.textContent=L('Mass Details','Détails de la Messe');if(p)p.textContent=`${v.title} · ${L('Propers, readings, liturgical information','Propres, lectures, informations liturgiques')}`}
}
function install(){const r=rt();if(!r?.store){setTimeout(install,80);return}syncFromCore();ARCH.celebrationForm=r.store.getState().settings?.massForm||'sung';ARCH.followMode=r.store.getState().settings?.followMode||'vox';r.store.subscribe(()=>{syncFromCore();queueMicrotask(augmentHome)});augmentHome();window.addEventListener('pageshow',()=>queueMicrotask(augmentHome),{passive:true});}
document.addEventListener('click',e=>{const t=e.target?.closest?.('button');if(!t)return;if(t.dataset.aoChangeMass!==undefined){e.preventDefault();e.stopImmediatePropagation();syncFromCore();ARCH.stage='main';ARCH.history=[];paintOpenSheet();return}if(t.closest?.('.massCard')&&t.dataset.action==='today-mass'){e.preventDefault();e.stopImmediatePropagation();openMassDetails();return}if(t.dataset.action==='follow'&&t.closest?.('.phaseActions')){e.preventDefault();e.stopImmediatePropagation();syncFromCore();ARCH.stage='preflight';ARCH.history=[];if(!ARCH.readiness)resolveReadiness();paintOpenSheet();return}if(t.dataset.aoClose!==undefined){closeSheet();return}if(t.dataset.aoBack!==undefined){goBack();return}if(t.dataset.aoOpen){openStage(t.dataset.aoOpen);return}if(t.dataset.aoSelectDay!==undefined){selectMassOfDay();return}if(t.dataset.aoCelebration){selectCelebration(t.dataset.aoCelebration);return}if(t.dataset.aoRequiem){ARCH.requiemCircumstance=t.dataset.aoRequiem;selectCelebration('requiem',{circumstance:t.dataset.aoRequiem});return}if(t.dataset.aoBasis){ARCH.votiveBasis=t.dataset.aoBasis;ARCH.rubric=null;paintOpenSheet();return}if(t.dataset.aoCondition){const k=t.dataset.aoCondition;if(Object.prototype.hasOwnProperty.call(ARCH.rubricContext,k)){ARCH.rubricContext[k]=!ARCH.rubricContext[k];ARCH.rubric=null;paintOpenSheet()}return}if(t.dataset.aoForm){ARCH.celebrationForm=t.dataset.aoForm;paintOpenSheet();return}if(t.dataset.aoEpistleMinister){rt()?.store?.dispatch({type:'set-epistle-minister',value:t.dataset.aoEpistleMinister});paintOpenSheet();return}if(t.dataset.aoInterlection){rt()?.store?.dispatch({type:'set-long-interlection-seating',value:t.dataset.aoInterlection==='sedilia'});paintOpenSheet();return}if(t.dataset.aoFollow){ARCH.followMode=t.dataset.aoFollow;paintOpenSheet();return}if(t.dataset.aoSaveDefaults!==undefined){const st=rt()?.store;if(st){st.dispatch({type:'live-form',form:ARCH.celebrationForm});st.dispatch({type:'live-follow-mode',mode:ARCH.followMode})}paintOpenSheet();return}if(t.dataset.aoDetails!==undefined){ARCH.history.push(ARCH.stage);ARCH.stage='details';paintOpenSheet();return}if(t.dataset.aoPreflight!==undefined){ARCH.history.push(ARCH.stage);ARCH.stage='preflight';paintOpenSheet();return}if(t.dataset.aoCalendarMass!==undefined){selectMassOfDay();return}},true);
document.addEventListener('click',e=>{if(e.target?.matches?.('[data-ao-backdrop]'))closeSheet()},true);
document.addEventListener('input',e=>{if(e.target?.matches?.('[data-ao-search]')){ARCH.search=e.target.value;const n=e.target.selectionStart;paintOpenSheet();const i=document.querySelector('[data-ao-search]');if(i){i.focus();try{i.setSelectionRange(n,n)}catch{}}}},true);
window.AO_CELEBRATION_API={openChangeMass(){syncFromCore();ARCH.stage='main';ARCH.history=[];paintOpenSheet()},openPreflight(){syncFromCore();ARCH.stage='preflight';ARCH.history=[];resolveReadiness();paintOpenSheet()},select:id=>selectCelebration(id),reset:selectMassOfDay,resolveRubrics:rubricResolve,resolveReadiness,setVotiveBasis(id){ARCH.votiveBasis=id;ARCH.rubric=null;return rubricResolve()},setCondition(key,value){if(Object.prototype.hasOwnProperty.call(ARCH.rubricContext,key)){ARCH.rubricContext[key]=!!value;ARCH.rubric=null}return rubricResolve()},getRubricState(){return {basis:ARCH.votiveBasis,context:{...ARCH.rubricContext},decision:rubricResolve()}},getResolvedMass(){const r=rubricResolve();const permitted=['permitted','permittedWithChanges'].includes(r.status);const resultId=r.resultingCelebration||ARCH.actualCelebration.id;const source=r.properSourceOverride||(resultId==='mass_of_day'?calendarPath():actualPath());return{date:isoDate(),calendarDay:ARCH.liturgicalDay,requestedCelebrationId:ARCH.actualCelebration.id,celebrationId:resultId,celebrationType:resultId==='mass_of_day'?'calendar':actualType(),properSource:source,calendarRank:ARCH.liturgicalDay?.rank||null,votiveClass:r.votiveClass||null,requiemClass:r.requiemClass||null,colour:resultId==='mass_of_day'?ARCH.liturgicalDay?.colour||null:actualDef()?.colour||null,gloria:typeof r.gloria==='boolean'?r.gloria:null,credo:typeof r.credo==='boolean'?r.credo:null,preface:null,commemorations:ARCH.liturgicalDay?.raw?.commemorations||[],seasonalMode:isPaschal()?'paschal':null,exceptionalProfile:resultId==='mass_of_day'?(typeof riteProfileFor==='function'?riteProfileFor(calendarPath(),core()?.resolution?.proper?.status==='ready'?core().resolution.proper.data:null):null):null,insertedRites:r.additions||[],conditions:r.conditions||[],rubricSources:r.sources||[],canStart:permitted,languageCoverage:ARCH.readiness,sourceDiagnostics:{architectureVersion:VERSION,rubricStatus:r.status,rubricCode:r.code,votiveBasis:ARCH.votiveBasis}}}};
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',install,{once:true});else install();
})();

</script>

<style id="ao-sequence-bridge-v21-style">
.aoBridgeNote{margin-top:10px;padding:10px 12px;border:1px solid rgba(255,255,255,.10);border-radius:12px;background:rgba(255,255,255,.025);font-size:.78rem;line-height:1.4;color:var(--muted)}
.aoBridgeNote.ok{border-color:var(--liturgical-border);color:var(--text)}
</style>
<script id="ao-sequence-bridge-v23-js">
(function(){
'use strict';
const VERSION='23-live-sequence-certification';
const KEY='ao-active-resolved-mass-v23';
const OLD_KEYS=['ao-active-resolved-mass-v22','ao-active-resolved-mass-v21'];
function rt(){return window.AO_RUNTIME_V8||null}
function api(){return window.AO_CELEBRATION_API||null}
function arch(){return window.AO_CELEBRATION_ARCH_V1||null}
function state(){return rt()?.store?.getState?.()||null}
function fr(){return state()?.language==='fr'}
function L(en,frText){return fr()?frText:en}
function clone(v){return v==null?v:JSON.parse(JSON.stringify(v))}
function clearActive(){
  window.AO_ACTIVE_MASS_SESSION=null;
  try{localStorage.removeItem(KEY);OLD_KEYS.forEach(k=>localStorage.removeItem(k))}catch{}
}
function saveActive(session){
  window.AO_ACTIVE_MASS_SESSION=session;
  try{localStorage.setItem(KEY,JSON.stringify(session));OLD_KEYS.forEach(k=>localStorage.removeItem(k))}catch{}
}
function restoreActive(){
  try{
    let raw=localStorage.getItem(KEY);
    if(!raw){for(const k of OLD_KEYS){raw=localStorage.getItem(k);if(raw)break}}
    if(!raw)return;
    const session=JSON.parse(raw),s=state();
    if(!session?.date||!session?.resolvedMass||!session?.proper)return clearActive();
    if(s?.selectedDate&&session.date!==s.selectedDate)return clearActive();
    window.AO_ACTIVE_MASS_SESSION=session;
  }catch{clearActive()}
}
function overrideProperFlags(proper,resolved){
  const out=clone(proper);
  if(typeof resolved.gloria==='boolean')out.hasGloria=out.showGloria=resolved.gloria;
  if(typeof resolved.credo==='boolean')out.hasCredo=out.showCredo=resolved.credo;
  if(resolved.celebrationType==='requiem'){
    out.isRequiem=true;
    out.riteProfile='requiem_1962';
  }
  return out;
}
function calendarProper(){const s=state();return s?.resolution?.proper?.status==='ready'?s.resolution.proper.data:null}
function firstCollect(proper){return (proper?.collects||[])[0]||proper?.collect||null}
function hasNuptialBlessings(proper){
  const ids=new Set((proper?.specialSections||[]).map(x=>x.id));
  return ['Benedictio Nuptialis 1','Benedictio Nuptialis 2','Benedictio Finalis'].every(id=>ids.has(id));
}
function assemblyPlanFor(decision,resolved,a){
  const code=String(decision?.code||'');
  if(/^votive-[12]-collect-retained$/.test(code))return {kind:'votive-collect-retained',retainedCollect:true,nuptialBlessings:false};
  if(code==='nuptial-mass-of-day')return {kind:'nuptial-mass-of-day',retainedCollect:true,nuptialBlessings:true};
  if(code==='requiem-all-souls-calendar')return {kind:'calendar-fallback',retainedCollect:false,nuptialBlessings:false};
  return null;
}
function assemblyStatus(){
  const a=arch(),A=api(),s=state();
  if(!a||!A||!s)return {ok:false,reason:L('Architecture is still starting.','L’architecture est encore en cours de démarrage.')};
  const decision=A.getRubricState?.().decision||A.resolveRubrics?.();
  const resolved=A.getResolvedMass?.();
  if(!decision||!resolved)return {ok:false,reason:L('Resolve the celebration first.','Résolvez d’abord la célébration.')};
  if(['impeded','prohibited'].includes(decision.status))return {ok:false,reason:decision.summary||L('This Mass cannot be started under the selected conditions.','Cette Messe ne peut pas être commencée dans les conditions sélectionnées.')};
  if(a.readiness?.loading)return {ok:false,reason:L('Resolving the formulary…','Résolution du formulaire…')};
  const cal=calendarProper();
  if(decision.status==='permitted'){
    if(resolved.celebrationId==='mass_of_day')return cal?{ok:true,resolved,proper:cal,calendar:true,assemblyPlan:null}:{ok:false,reason:L('The calendar Proper is not ready.','Le Propre du calendrier n’est pas prêt.')};
    if(!a.resolvedProper)return {ok:false,reason:L('Resolve the selected formulary before starting.','Résolvez le formulaire sélectionné avant de commencer.')};
    if(resolved.requestedCelebrationId==='nuptial'&&!hasNuptialBlessings(a.resolvedProper))return {ok:false,reason:L('The Nuptial formulary is missing one or more blessing sections.','Il manque une ou plusieurs sections de bénédiction dans le formulaire nuptial.')};
    return {ok:true,resolved,proper:a.resolvedProper,requestedProper:a.resolvedProper,calendar:false,assemblyPlan:null};
  }
  if(decision.status==='permittedWithChanges'){
    const plan=assemblyPlanFor(decision,resolved,a);
    if(!plan)return {ok:false,reason:L('This result still requires a local verification or an addition that is not sequence-certified.','Ce résultat exige encore une vérification locale ou un ajout qui n’est pas certifié dans la séquence.')};
    if(!cal)return {ok:false,reason:L('The calendar Proper is not ready.','Le Propre du calendrier n’est pas prêt.')};
    if(plan.kind==='calendar-fallback')return {ok:true,resolved,proper:cal,calendar:true,assemblyPlan:plan};
    const requested=a.resolvedProper;
    if(!requested)return {ok:false,reason:L('Resolve the requested formulary before assembling the Mass of the Day.','Résolvez le formulaire demandé avant d’assembler la Messe du jour.')};
    if(plan.retainedCollect&&!firstCollect(requested))return {ok:false,reason:L('The requested formulary does not contain the Collect required for this rubrical fallback.','Le formulaire demandé ne contient pas la Collecte requise pour ce cas rubrical.')};
    if(plan.nuptialBlessings&&!hasNuptialBlessings(requested))return {ok:false,reason:L('The Nuptial formulary is missing one or more blessing sections.','Il manque une ou plusieurs sections de bénédiction dans le formulaire nuptial.')};
    return {ok:true,resolved,proper:cal,requestedProper:requested,calendar:true,assemblyPlan:plan};
  }
  return {ok:false,reason:L('The rubrical result is not startable.','Le résultat rubrical ne permet pas de commencer la Messe.')};
}
async function startLive(){
  const a=arch(),A=api(),r=rt();
  if(!a||!A||!r?.store)return;
  if(a.actualCelebration?.id!=='mass_of_day'&&!a.resolvedProper&&!a.readiness?.loading){try{await A.resolveReadiness?.()}catch{}}
  const status=assemblyStatus();
  if(!status.ok){decorate();return}
  const resolved=clone(status.resolved);
  resolved.sourceDiagnostics={...(resolved.sourceDiagnostics||{}),sequenceCertification:'v23-matrix-16-of-16',sequenceContract:'ResolvedMass input only'};
  if(resolved.celebrationType==='requiem')resolved.exceptionalProfile='requiem-1962';
  const plan=status.assemblyPlan||null;
  const needsSession=!status.calendar||!!(plan&&(plan.retainedCollect||plan.nuptialBlessings));
  if(!needsSession){
    clearActive();
  }else{
    const proper=overrideProperFlags(status.proper,resolved);
    const session={
      version:VERSION,
      date:safeDate(),
      startedAt:new Date().toISOString(),
      requestedType:a.actualCelebration?.type||resolved.celebrationType,
      requestedTitle:(a.actualCelebration?.id&&window.AO_CELEBRATION_CATALOGUE?.[a.actualCelebration.id]?.title)||null,
      resolvedMass:resolved,
      proper,
      requestedProper:clone(status.requestedProper||a.resolvedProper),
      assemblyPlan:clone(plan),
      themePlan:{primary:resolved.colour||proper.color||'Green',massColor:resolved.colour||proper.color||'Green'}
    };
    saveActive(session);
  }
  r.store.dispatch({type:'live-form-session',form:a.celebrationForm||'sung'});
  r.store.dispatch({type:'live-follow-mode-session',mode:a.followMode||'vox'});
  a.stage=null;a.history=[];
  document.getElementById('ao-mass-flow-v1')?.remove();
  r.store.dispatch({type:'enter-live'});
}
function safeDate(){return state()?.selectedDate||new Date().toISOString().slice(0,10)}
function setTextIfChanged(el,value){if(!el)return false;const next=String(value??'');if(el.textContent===next)return false;el.textContent=next;return true}
function decorate(){
  const wrap=document.getElementById('ao-mass-flow-v1');if(!wrap)return;
  const buttons=[...wrap.querySelectorAll('.aoFlowActions .primary')];
  const target=buttons.find(b=>/Live sequence wiring|Raccordement à la séquence|Start Mass|Commencer la Messe/i.test(b.textContent||'')||b.dataset.aoStartLive!==undefined);
  if(!target)return;
  const st=assemblyStatus();
  setTextIfChanged(target,st.ok?L('Start Mass →','Commencer la Messe →'):st.reason);
  target.disabled=!st.ok;
  if(st.ok)target.dataset.aoStartLive='';else delete target.dataset.aoStartLive;
  let note=target.parentElement?.nextElementSibling;
  if(!note||!note.classList?.contains('aoBridgeNote')){note=document.createElement('div');note.className='aoBridgeNote';target.parentElement?.insertAdjacentElement('afterend',note)}
  note.classList.toggle('ok',!!st.ok);
  let noteText=st.reason;
  if(st.ok){
    const kind=st.assemblyPlan?.kind;
    noteText=kind==='nuptial-mass-of-day'
      ? L('Mass of the Day assembled with the Nuptial Collect and the Nuptial Blessing in their prescribed places.','Messe du jour assemblée avec la Collecte nuptiale et la Bénédiction nuptiale à leurs places prescrites.')
      : kind==='votive-collect-retained'
      ? L('Mass of the Day assembled with the retained Collect of the impeded votive Mass under one conclusion.','Messe du jour assemblée avec la Collecte conservée de la Messe votive empêchée sous une seule conclusion.')
      : kind==='calendar-fallback'
      ? L('The rubrical result resolves to the calendar Mass; the normal live sequence will be used.','Le résultat rubrical renvoie à la Messe du calendrier ; la séquence normale sera utilisée.')
      : L('ResolvedMass is ready. The live engine will render this already-resolved celebration; it will not recalculate rubrical permission.','ResolvedMass est prêt. Le moteur en direct rendra cette célébration déjà résolue ; il ne recalculera pas la permission rubricale.');
  }
  setTextIfChanged(note,noteText);
}
function install(){
  restoreActive();
  const r=rt();if(!r?.store){setTimeout(install,80);return}
  let lastDate=r.store.getState().selectedDate;
  r.store.subscribe(s=>{if(s.selectedDate!==lastDate){lastDate=s.selectedDate;clearActive()}queueMicrotask(decorate)});
  decorate();
}
document.addEventListener('click',e=>{
  const prepareNext=e.target?.closest?.('[data-prepare-next]');
  if(prepareNext&&state()?.route==='prepare'){
    const label=(prepareNext.textContent||'').replace(/\s+/g,' ').trim();
    if(/Follow Mass|Follow Liturgy|Suivre la Messe|Suivre la liturgie/i.test(label)&&api()?.openPreflight){e.preventDefault();e.stopImmediatePropagation();rt()?.store?.dispatch?.({type:'leave-prepare'});queueMicrotask(()=>api()?.openPreflight?.());return}
  }
  const b=e.target?.closest?.('[data-ao-start-live]');if(!b)return;
  e.preventDefault();e.stopImmediatePropagation();void startLive();
},true);
window.AO_SEQUENCE_BRIDGE_V23={version:VERSION,startLive,getAssemblyStatus:assemblyStatus,clearActive,decorate,getActive:()=>window.AO_ACTIVE_MASS_SESSION||null};window.AO_SEQUENCE_BRIDGE_V22=window.AO_SEQUENCE_BRIDGE_V23;
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',install,{once:true});else install();
})();
</script>
<script>window.AO_COMPLETION_V20={version:"20-rubrical-resolver",celebrationArchitecture:true,rubricalResolver1960:true,liveAlternativeMassWiring:true,note:"Votive, Nuptial and Requiem permission classes are resolved before the live sequence; local permissions and church-specific facts remain explicit inputs."};</script>
<script>window.AO_COMPLETION_V21={version:"21-resolved-mass-sequence-bridge",resolvedMassBridge:true,sessionOnlyMassForm:true,sessionOnlyFollowMode:true,votiveLive:true,requiemLive:true,nuptialLive:true,permittedWithChangesLive:false,note:"Directly permitted Mass of Day, votive, Requiem and Nuptial celebrations feed an already-resolved Proper into the existing live sequence. Preparation routes through Mass preflight."};</script>
<script>window.AO_COMPLETION_V22={version:"22-permitted-with-changes-assembly",permittedWithChangesLive:true,certifiedCases:["votive-I/II impeded with retained Collect","Nuptial Mass impeded but Nuptial Collect and Blessing retained","generic Requiem selection on All Souls resolves to calendar Mass"],blockedUntilVerified:["rank-unresolved cases","groom-only local-custom check","Funeral Mass on All Souls with circumstance-specific prayers/absolution","local Funeral impediment checks"],core117Untouched:true,note:"Only deterministic permitted-with-changes cases are assembled. Conditional or source-incomplete cases remain fail-closed."};</script>
<script id="ao-v23-sequence-certification-meta">
window.AO_SEQUENCE_CERTIFICATION_V23={
 version:'23-live-sequence-certification',
 matrix:{celebrations:['mass_of_day','votive','nuptial','requiem'],forms:['sung','low'],followModes:['vox','missal'],cases:16,passed:16},
 verifiedInvariants:[
  'resolved Proper selected before live sequence',
  'Sung/Low session choice preserved without changing global default',
  'VOX/Missal session choice preserved',
  'VOX suppresses private altar text while retaining concurrent audible choir content',
  'Missal retains complete liturgical action',
  'direct Nuptial Mass inserts both post-Pater prayers and final blessing',
  'Requiem profile omits Judica, Gloria and Credo as applicable',
  'permitted-with-changes votive fallback uses calendar Proper plus retained Collect',
  'permitted-with-changes Nuptial fallback uses calendar Proper plus Nuptial Collect and blessings',
  'theme colour follows the resolved celebration rather than the requested-but-impeded formulary',
  'Mass Details follows the resolved celebration while preserving the requested celebration as context'
 ],
 networkNote:'Synthetic sequence certification validates assembly/projection invariants. Live network source availability remains governed by the existing content-readiness and supplementary audit gates.'
};
window.AO_COMPLETION_V23={version:'23',liveSequenceMatrix:'16/16',massDay:true,votive:true,nuptial:true,requiem:true,forms:['sung','low'],followModes:['vox','missal'],resolvedPresentationSync:true,core117Untouched:true,note:'ResolvedMass is now sequence-certified across the 4×2×2 matrix. Network-backed source completeness remains a separate audit dimension.'};
</script>


<!-- v24 unified devotional/prayer layer -->
<script id="ao-traditional-prayerbook-js">
(()=>{'use strict';
const D={"prayers":{"foundations_sign_of_cross":{"id":"foundations_sign_of_cross","title":"Sign of the Cross","titleFr":"Signe de la Croix","en":"In the name of the Father, and of the Son, and of the Holy Spirit. Amen.","la":"In nomine Patris, et Filii, et Spiritus Sancti. Amen.","fr":"Au nom du Père, et du Fils, et du Saint-Esprit. Amen.","source":"","sourceUrl":"","note":"","category":"essentials","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":false,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Sign of the Cross","witness":"Compendium of the Catechism of the Catholic Church · Appendix A","url":"https://www.vatican.va/archive/compendium_ccc/documents/archive_2005_compendium-ccc_en.html","quality":"VERIFIED_PRIMARY","visibility":0,"adaptation":"VERBATIM","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_PRIMARY"},"note":"Common prayer; provenance retained internally and not shown by default."},"sourceAuditVersion":"35.7"},"foundations_our_father":{"id":"foundations_our_father","title":"Our Father","titleFr":"Notre Père","en":"Our Father, Who art in heaven, hallowed be Thy name; Thy kingdom come; Thy will be done on earth as it is in heaven. Give us this day our daily bread; and forgive us our trespasses, as we forgive those who trespass against us; and lead us not into temptation, but deliver us from evil. Amen.","la":"Pater noster, qui es in cælis, sanctificetur nomen tuum; adveniat regnum tuum; fiat voluntas tua, sicut in cælo et in terra. Panem nostrum quotidianum da nobis hodie; et dimitte nobis debita nostra, sicut et nos dimittimus debitoribus nostris; et ne nos inducas in tentationem, sed libera nos a malo. Amen.","fr":"Notre Père, qui êtes aux cieux, que votre nom soit sanctifié; que votre règne arrive; que votre volonté soit faite sur la terre comme au ciel. Donnez-nous aujourd’hui notre pain de chaque jour; pardonnez-nous nos offenses, comme nous pardonnons à ceux qui nous ont offensés; et ne nous laissez pas succomber à la tentation, mais délivrez-nous du mal. Amen.","source":"","sourceUrl":"","note":"","category":"essentials","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":false,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Our Father","witness":"Compendium of the Catechism of the Catholic Church · Appendix A","url":"https://www.vatican.va/archive/compendium_ccc/documents/archive_2005_compendium-ccc_en.html","quality":"VERIFIED_PRIMARY","visibility":0,"adaptation":"VERBATIM","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_PRIMARY"},"note":"Common prayer; provenance retained internally and not shown by default."},"sourceAuditVersion":"35.7"},"foundations_hail_mary":{"id":"foundations_hail_mary","title":"Hail Mary","titleFr":"Je vous salue Marie","en":"Hail Mary, full of grace, the Lord is with thee; blessed art thou among women, and blessed is the fruit of thy womb, Jesus. Holy Mary, Mother of God, pray for us sinners, now and at the hour of our death. Amen.","la":"Ave Maria, gratia plena, Dominus tecum; benedicta tu in mulieribus, et benedictus fructus ventris tui, Iesus. Sancta Maria, Mater Dei, ora pro nobis peccatoribus, nunc et in hora mortis nostræ. Amen.","fr":"Je vous salue, Marie, pleine de grâce, le Seigneur est avec vous; vous êtes bénie entre toutes les femmes, et Jésus, le fruit de vos entrailles, est béni. Sainte Marie, Mère de Dieu, priez pour nous, pauvres pécheurs, maintenant et à l’heure de notre mort. Amen.","source":"","sourceUrl":"","note":"","category":"essentials","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":false,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Hail Mary","witness":"Compendium of the Catechism of the Catholic Church · Appendix A","url":"https://www.vatican.va/archive/compendium_ccc/documents/archive_2005_compendium-ccc_en.html","quality":"VERIFIED_PRIMARY","visibility":0,"adaptation":"VERBATIM","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_PRIMARY"},"note":"Common prayer; provenance retained internally and not shown by default."},"sourceAuditVersion":"35.7"},"foundations_glory_be":{"id":"foundations_glory_be","title":"Glory Be","titleFr":"Gloire au Père","en":"Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen.","la":"Gloria Patri, et Filio, et Spiritui Sancto. Sicut erat in principio, et nunc, et semper, et in sæcula sæculorum. Amen.","fr":"Gloire au Père, au Fils et au Saint-Esprit, comme il était au commencement, maintenant et toujours, et dans les siècles des siècles. Amen.","source":"","sourceUrl":"","note":"","category":"essentials","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":false,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Glory Be","witness":"Compendium of the Catechism of the Catholic Church · Appendix A","url":"https://www.vatican.va/archive/compendium_ccc/documents/archive_2005_compendium-ccc_en.html","quality":"VERIFIED_PRIMARY","visibility":0,"adaptation":"VERBATIM","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_PRIMARY"},"note":"Common prayer; provenance retained internally and not shown by default."},"sourceAuditVersion":"35.7"},"foundations_apostles_creed":{"id":"foundations_apostles_creed","title":"Apostles’ Creed","titleFr":"Symbole des Apôtres","en":"I believe in God, the Father almighty, Creator of heaven and earth; and in Jesus Christ, His only Son, our Lord, Who was conceived by the Holy Spirit, born of the Virgin Mary, suffered under Pontius Pilate, was crucified, died and was buried; He descended into hell; on the third day He rose again from the dead; He ascended into heaven, and is seated at the right hand of God the Father almighty; from there He shall come to judge the living and the dead. I believe in the Holy Spirit, the holy Catholic Church, the communion of saints, the forgiveness of sins, the resurrection of the body, and life everlasting. Amen.","la":"Credo in Deum Patrem omnipotentem, Creatorem cæli et terræ. Et in Iesum Christum, Filium eius unicum, Dominum nostrum: qui conceptus est de Spiritu Sancto, natus ex Maria Virgine, passus sub Pontio Pilato, crucifixus, mortuus, et sepultus; descendit ad inferos; tertia die resurrexit a mortuis; ascendit ad cælos; sedet ad dexteram Dei Patris omnipotentis; inde venturus est iudicare vivos et mortuos. Credo in Spiritum Sanctum, sanctam Ecclesiam catholicam, Sanctorum communionem, remissionem peccatorum, carnis resurrectionem, vitam æternam. Amen.","fr":"Je crois en Dieu, le Père tout-puissant, Créateur du ciel et de la terre; et en Jésus-Christ, son Fils unique, notre Seigneur, qui a été conçu du Saint-Esprit, est né de la Vierge Marie, a souffert sous Ponce Pilate, a été crucifié, est mort et a été enseveli, est descendu aux enfers; le troisième jour est ressuscité des morts, est monté aux cieux, est assis à la droite de Dieu le Père tout-puissant, d’où il viendra juger les vivants et les morts. Je crois au Saint-Esprit, à la sainte Église catholique, à la communion des saints, à la rémission des péchés, à la résurrection de la chair et à la vie éternelle. Ainsi soit-il.","source":"","sourceUrl":"","note":"","category":"essentials","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":false,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Apostles’ Creed","witness":"Compendium of the Catechism of the Catholic Church · Appendix A","url":"https://www.vatican.va/archive/compendium_ccc/documents/archive_2005_compendium-ccc_en.html","quality":"VERIFIED_PRIMARY","visibility":0,"adaptation":"VERBATIM","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_PRIMARY"},"note":"Common prayer; provenance retained internally and not shown by default."},"sourceAuditVersion":"35.7"},"sacrament_act_of_contrition":{"id":"sacrament_act_of_contrition","title":"Act of Contrition","titleFr":"Acte de contrition","en":"O my God, I am heartily sorry for having offended Thee, and I detest all my sins because of Thy just punishments, but most of all because they offend Thee, my God, who art all good and deserving of all my love. I firmly resolve with the help of Thy grace to sin no more and to avoid the near occasion of sin. Amen.","la":"Deus meus, ex toto corde pænitet me ómnium meórum peccatórum, eáque detéstor, quia peccándo, non solum pœnas a te iuste statútas proméritus sum, sed præsértim quia offéndi te, summum bonum, ac dignum qui super ómnia diligáris. Ídeo fírmiter propóno, adiuvánte grátia tua, de cétero me non peccatúrum peccandíque occasiónes próximas fugitúrum. Amen.","fr":"Mon Dieu, j’ai un très grand regret de vous avoir offensé parce que vous êtes infiniment bon et que le péché vous déplaît. Je prends la ferme résolution, avec le secours de votre sainte grâce, de ne plus vous offenser et de faire pénitence. Amen.","source":"","sourceUrl":"","note":"","category":"essentials","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":false,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Act of Contrition","witness":"Compendium of the Catechism of the Catholic Church · Appendix A","url":"https://www.vatican.va/archive/compendium_ccc/documents/archive_2005_compendium-ccc_en.html","quality":"VERIFIED_PRIMARY","visibility":0,"adaptation":"VERBATIM","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_PRIMARY"},"note":"Common prayer; provenance retained internally and not shown by default."},"sourceAuditVersion":"35.7"},"foundations_act_of_faith":{"id":"foundations_act_of_faith","title":"Act of Faith","titleFr":"Acte de foi","en":"O my God, I firmly believe that you are one God in three divine Persons, Father, Son, and Holy Spirit. I believe that your divine Son became man and died for our sins and that he will come to judge the living and the dead. I believe these and all the truths which the Holy Catholic Church teaches because you have revealed them who are eternal truth and wisdom, who can neither deceive nor be deceived. In this faith I intend to live and die. Amen.","la":"Dómine Deus, firma fide credo et confíteor ómnia et síngula quæ sancta Ecclésia Cathólica propónit, quia tu, Deus, ea ómnia revelásti, qui es ætérna véritas et sapiéntia quæ nec fállere nec falli potest. In hac fide vívere et mori státuo. Amen.","fr":"Mon Dieu, je crois fermement toutes les vérités que vous m’avez révélées et que vous nous enseignez par votre sainte Église, parce que vous ne pouvez ni vous tromper, ni nous tromper. Dans cette foi, puis-je vivre et mourir. Amen.","source":"","sourceUrl":"","note":"","category":"essentials","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":false,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Act of Faith","witness":"Compendium of the Catechism of the Catholic Church · Appendix A","url":"https://www.vatican.va/archive/compendium_ccc/documents/archive_2005_compendium-ccc_en.html","quality":"VERIFIED_PRIMARY","visibility":0,"adaptation":"VERBATIM","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_PRIMARY"},"note":"Replaced prior paraphrased wording with the official formulas."},"sourceAuditVersion":"35.7"},"foundations_act_of_hope":{"id":"foundations_act_of_hope","title":"Act of Hope","titleFr":"Acte d'espérance","en":"O Lord God, I hope by your grace for the pardon of all my sins and after life here to gain eternal happiness because you have promised it who are infinitely powerful, faithful, kind, and merciful. In this hope I intend to live and die. Amen.","la":"Dómine Deus, spero per grátiam tuam remissiónem ómnium peccatórum, et post hanc vitam ætérnam felicitátem me esse consecutúrum: quia tu promisísti, qui es infiníte potens, fidélis, benígnus, et miséricors. In hac spe vívere et mori státuo. Amen.","fr":"Mon Dieu, j’espère avec une ferme confiance que vous me donnerez, par les mérites de Jésus-Christ, votre grâce en ce monde et le bonheur éternel dans l’autre, parce que vous l’avez promis et que vous tenez toujours vos promesses. Dans cette foi, puis-je vivre et mourir. Amen.","source":"","sourceUrl":"","note":"","category":"essentials","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":false,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Act of Hope","witness":"Compendium of the Catechism of the Catholic Church · Appendix A","url":"https://www.vatican.va/archive/compendium_ccc/documents/archive_2005_compendium-ccc_en.html","quality":"VERIFIED_PRIMARY","visibility":0,"adaptation":"VERBATIM","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_PRIMARY"},"note":"Replaced prior paraphrased wording with the official formulas."},"sourceAuditVersion":"35.7"},"foundations_act_of_love":{"id":"foundations_act_of_love","title":"Act of Love","titleFr":"Acte de charité","en":"O Lord God, I love you above all things and I love my neighbor for your sake because you are the highest, infinite and perfect good, worthy of all my love. In this love I intend to live and die. Amen.","la":"Dómine Deus, amo te super ómnia et próximum meum propter te, quia tu es summum, infinítum, et perfectíssimum bonum, omni dilectióne dignum. In hac caritáte vívere et mori státuo. Amen.","fr":"Mon Dieu, je vous aime de tout mon coeur et plus que tout, parce que vous êtes infiniment bon, et j’aime mon prochain comme moi-même pour l’amour de vous.","source":"","sourceUrl":"","note":"","category":"essentials","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":false,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Act of Love","witness":"Compendium of the Catechism of the Catholic Church · Appendix A","url":"https://www.vatican.va/archive/compendium_ccc/documents/archive_2005_compendium-ccc_en.html","quality":"VERIFIED_PRIMARY","visibility":0,"adaptation":"VERBATIM","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_PRIMARY"},"note":"Replaced prior paraphrased wording with the official formulas."},"sourceAuditVersion":"35.7"},"foundations_guardian_angel":{"id":"foundations_guardian_angel","title":"Guardian Angel Prayer","titleFr":"Prière à l’Ange gardien","en":"Angel of God, my guardian dear, to whom God’s love commits me here, ever this day be at my side, to light and guard, to rule and guide. Amen.","la":"Ángele Dei, qui custos es mei, me, tibi commíssum pietáte supérna, illúmina, custódi, rege et gubérna. Amen.","fr":"Ange de Dieu, qui es mon gardien, et à qui j’ai été confié par la Bonté divine, éclaire-moi, défends-moi, conduis-moi et dirige-moi. Amen.","source":"","sourceUrl":"","note":"","category":"essentials","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":false,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Angel of God / Angele Dei","witness":"Compendium of the Catechism of the Catholic Church · Appendix A","url":"https://www.vatican.va/archive/compendium_ccc/documents/archive_2005_compendium-ccc_en.html","quality":"VERIFIED_PRIMARY","visibility":0,"adaptation":"VERBATIM","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_PRIMARY"},"note":"Latin corrected to the official Angele Dei text."},"sourceAuditVersion":"35.7"},"foundations_grace_before_meals":{"id":"foundations_grace_before_meals","title":"Grace Before Meals","titleFr":"Bénédicité","en":"Bless us, O Lord, and these thy gifts, which we are about to receive from thy bounty, through Christ our Lord. Amen.","la":"Benedíc, Dómine, nos et haec tua dona, quae de tua largitáte sumus sumptúri, per Christum Dóminum nostrum. Amen.","fr":"Bénissez-nous, Seigneur, ainsi que les dons que nous allons recevoir de votre bonté, par le Christ notre Seigneur. Amen.","source":"","sourceUrl":"","note":"","category":"essentials","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":false,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Grace Before Meals","witness":"Baltimore Manual · 1888","url":"https://en.wikisource.org/wiki/A_Manual_of_Prayers_for_the_Use_of_the_Catholic_Laity/Morning_Prayers","quality":"VERIFIED_PRIMARY","visibility":0,"adaptation":"VERBATIM","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_SECONDARY"},"note":"The after-meal form in the app is a compact traditional form."},"sourceAuditVersion":"35.7"},"foundations_grace_after_meals":{"id":"foundations_grace_after_meals","title":"Grace After Meals","titleFr":"Grâces après le repas","en":"We give thee thanks, almighty God, for all thy benefits, who livest and reignest forever and ever. Amen. May the souls of the faithful departed, through the mercy of God, rest in peace. Amen.","la":"Agimus tibi gratias, omnipotens Deus, pro universis beneficiis tuis, qui vivis et regnas in saecula saeculorum. Amen. Et fidelium animae, per misericordiam Dei, requiescant in pace. Amen.","fr":"Nous te rendons grâce, Dieu tout-puissant, pour tous tes bienfaits. Toi qui vis et règnes pour les siècles des siècles. Amen. Et que les âmes de tous les fidèles défunts, par la miséricorde de Dieu, reposent en paix. Amen.","source":"","sourceUrl":"","note":"","category":"essentials","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":false,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Grace After Meals","witness":"Baltimore Manual · 1888","url":"https://en.wikisource.org/wiki/A_Manual_of_Prayers_for_the_Use_of_the_Catholic_Laity/Morning_Prayers","quality":"VERIFIED_PRIMARY","visibility":0,"adaptation":"ABRIDGED","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_SECONDARY"},"note":"The after-meal form in the app is a compact traditional form."},"sourceAuditVersion":"35.7"},"foundations_morning_offering":{"id":"foundations_morning_offering","title":"Morning Offering","titleFr":"Offrande du matin","en":"O Jesus, through the Immaculate Heart of Mary, I offer you my prayers, works, joys, and sufferings of this day for all the intentions of your Sacred Heart, in union with the Holy Sacrifice of the Mass throughout the world, for the salvation of souls, the reparation of sins, the reunion of all Christians, and in particular for the intentions of the Holy Father. Amen.","la":"Divínum Cor Iesu, per Immaculátum Cor Maríae, tibi óffero preces, ópera, gáudia et passiónes huius diéi, pro ómnibus intentiónibus sanctíssimi Cordis tui, in unióne cum sancto Missae Sacrifício per totum orbem terrárum celebráto, pro animárum salúte, peccatórum expiatíone, christiánorum reconciliatióne, et speciátim pro intentióne Summi Pontíficis. Amen.","fr":"Ô Jésus, par le Cœur Immaculé de Marie, je t’offre mes prières, œuvres, joies et souffrances de ce jour, en union avec le Saint Sacrifice de la Messe offert dans le monde entier, pour le salut des âmes, la réparation des péchés, l’union de tous les chrétiens, et en particulier pour les intentions du Saint-Père. Amen.","source":"Fr François-Xavier Gautrelet · 1844","sourceUrl":"https://www.usccb.org/prayers/morning-offering","note":"The Latin witness now matches the same traditional Apostleship-of-Prayer form as the English record; the Latin witness is secondary rather than an invented translation.","category":"essentials","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":true,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Morning Offering","witness":"USCCB · Catholic Household Blessings and Prayers, p. 48","url":"https://www.usccb.org/prayers/morning-offering","quality":"VERIFIED_PRIMARY","visibility":1,"adaptation":"VERBATIM","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_SECONDARY","fr":"VERIFIED_SECONDARY"},"note":"English is the USCCB form; French has a Catholic educational witness; Latin is an exact published devotional witness of the same traditional form.","latinWitness":"Glory Be Prayer · Oblatio Matutina (CBCP-attributed common-prayer witness)","latinUrl":"https://www.glorybeprayer.com/fil/prayers/morning-offering/"},"sourceAuditVersion":"41.4"},"foundations_prayer_of_adoration":{"id":"foundations_prayer_of_adoration","title":"My Lord and My God","titleFr":"Acte d’adoration","en":"My Lord and my God!","la":"Dominus meus et Deus meus!","fr":"Mon Seigneur et mon Dieu !","source":"","sourceUrl":"","note":"","category":"essentials","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":false,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"My Lord and my God","witness":"John 20:28","url":"https://bible.usccb.org/bible/john/20","quality":"VERIFIED_PRIMARY","visibility":0,"adaptation":"SCRIPTURE_QUOTATION","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_PRIMARY"},"note":"Short biblical acclamation; no visible source needed in ordinary use."},"sourceAuditVersion":"35.7"},"mass_confiteor":{"id":"mass_confiteor","title":"Confiteor","titleFr":"Confiteor","en":"I confess to Almighty God, to blessed Mary ever Virgin, to blessed Michael the Archangel, to blessed John the Baptist, to the holy Apostles Peter and Paul, to all the Saints, and to you Father, that I have sinned exceedingly, in thought, word and deed: through my fault, through my fault, through my most grievous fault. Therefore I beseech blessed Mary ever Virgin, blessed Michael the Archangel, blessed John the Baptist, the holy Apostles Peter and Paul, all the Saints, and thee Father, to pray to the Lord our God for me.","la":"Confíteor Deo omnipoténti, beátæ Maríæ semper Vírgini, beáto Michaéli Archángelo, beáto Ioánni Baptístæ, sanctis Apóstolis Petro et Paulo, ómnibus Sanctis, et tibi, pater: quia peccávi nimis cogitatióne, verbo et opere: mea culpa, mea culpa, mea máxima culpa. Ideo precor beátam Maríam semper Vírginem, beátum Michaélem Archángelum, beátum Ioánnem Baptístam, sanctos Apóstolos Petrum et Paulum, omnes Sanctos, et te, pater, orare pro me ad Dóminum, Deum nostrum.","fr":"Je confesse à Dieu tout-puissant, à la bienheureuse Marie toujours Vierge, à saint Michel Archange, à saint Jean-Baptiste, aux saints Apôtres Pierre et Paul, à tous les saints, et à vous, mon Père, que j’ai beaucoup péché par pensée, par parole et par action : c’est ma faute, c’est ma faute, c’est ma très grande faute. C’est pourquoi je supplie la bienheureuse Marie toujours Vierge, saint Michel Archange, saint Jean-Baptiste, les saints Apôtres Pierre et Paul, tous les saints, et vous, mon Père, de prier pour moi le Seigneur notre Dieu.","source":"Missale Romanum 1962 · Prayers at the Foot of the Altar","sourceUrl":"","note":"Traditional Roman Confiteor used in the 1962 Order of Mass; this is not the shortened postconciliar Confiteor.","category":"essentials"},"marian_hail_holy_queen":{"id":"marian_hail_holy_queen","title":"Hail Holy Queen (Salve Regina)","titleFr":"Salve Regina","en":"Hail, holy Queen, Mother of mercy, our life, our sweetness, and our hope. To thee do we cry, poor banished children of Eve; to thee do we send up our sighs, mourning and weeping in this valley of tears. Turn then, most gracious advocate, thine eyes of mercy toward us; and after this our exile, show unto us the blessed fruit of thy womb, Jesus. O clement, O loving, O sweet Virgin Mary.\n\n℣ Pray for us, O holy Mother of God.\n℟ That we may be made worthy of the promises of Christ. Amen.","la":"Salve, Regina, Mater misericordiae; vita, dulcedo, et spes nostra, salve. Ad te clamamus, exsules filii Evae; ad te suspiramus gementes et flentes in hac lacrimarum valle. Eia ergo, advocata nostra, illos tuos misericordes oculos ad nos converte; et Iesum, benedictum fructum ventris tui, nobis post hoc exsilium ostende. O clemens, o pia, o dulcis Virgo Maria.\n\n℣. Ora pro nobis, sancta Dei Genetrix.\n℟. Ut digni efficiamur promissionibus Christi.","fr":"Salut, Reine, mère de miséricorde, notre vie, notre douceur et notre espérance, salut! Vers vous nous crions, pauvres enfants d’Ève exilés; vers vous nous soupirons, gémissant et pleurant dans cette vallée de larmes. Ô vous, notre avocate, tournez vers nous vos regards miséricordieux; et après cet exil, montrez-nous Jésus, le fruit béni de vos entrailles, ô clémente, ô pieuse, ô douce Vierge Marie.\n\n℣. Priez pour nous, sainte Mère de Dieu.\n℟. Afin que nous devenions dignes des promesses du Christ.","source":"","sourceUrl":"","note":"","category":"marian","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":false,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Hail Holy Queen","witness":"Compendium of the Catechism of the Catholic Church · Appendix A","url":"https://www.vatican.va/archive/compendium_ccc/documents/archive_2005_compendium-ccc_en.html","quality":"VERIFIED_PRIMARY","visibility":0,"adaptation":"VERBATIM","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_PRIMARY"},"note":"Common prayer; provenance retained internally and not shown by default."},"sourceAuditVersion":"35.7"},"marian_memorare":{"id":"marian_memorare","title":"Memorare (to Mary)","titleFr":"Souvenez-vous","en":"Remember, O most gracious Virgin Mary, that never was it known that anyone who fled to thy protection, implored thy help, or sought thy intercession was left unaided. Inspired by this confidence, I fly unto thee, O Virgin of virgins, my Mother; to thee do I come, before thee I stand, sinful and sorrowful. O Mother of the Word Incarnate, despise not my petitions, but in thy mercy hear and answer me. Amen.","la":"Memorare, o piissima Virgo Maria, non esse auditum a saeculo quemquam ad tua currentem praesidia, tua implorantem auxilia, tua petentem suffragia, esse derelictum. Ego, tali animatus confidentia, ad te, Virgo virginum, Mater, curro; ad te venio; coram te gemens peccator assisto. Noli, Mater Verbi, verba mea despicere; sed audi propitia et exaudi. Amen.","fr":"Souvenez-vous, ô très miséricordieuse Vierge Marie, qu’on n’a jamais entendu dire qu’aucun de ceux qui ont eu recours à votre protection, imploré votre secours, réclamé votre intercession, ait été abandonné. Animé d’une pareille confiance, ô Vierge des vierges, ô ma Mère, je cours vers vous, je viens à vous, et, gémissant sous le poids de mes péchés, je me prosterne à vos pieds. Ô Mère du Verbe incarné, ne méprisez pas mes prières, mais écoutez-les favorablement et daignez les exaucer. Amen.","source":"","sourceUrl":"","note":"","category":"marian","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":false,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Memorare","witness":"Compendium of the Catechism of the Catholic Church · Appendix A","url":"https://www.vatican.va/archive/compendium_ccc/documents/archive_2005_compendium-ccc_en.html","quality":"VERIFIED_PRIMARY","visibility":0,"adaptation":"VERBATIM","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_PRIMARY"},"note":"Common prayer; provenance retained internally and not shown by default."},"sourceAuditVersion":"35.7"},"weekday_magnificat":{"id":"weekday_magnificat","title":"Magnificat (Mary)","titleFr":"Magnificat","en":"My soul proclaims the greatness of the Lord, my spirit rejoices in God my Savior for he has looked with favor on his lowly servant. From this day all generations will call me blessed: the Almighty has done great things for me, and holy is his Name.\n\nHe has mercy on those who fear him in every generation. He has shown the strength of his arm, he has scattered the proud in their conceit. He has cast down the mighty from their thrones, and has lifted up the lowly. He has filled the hungry with good things, and the rich he has sent away empty.\n\nHe has come to the help of his servant Israel for he has remembered his promise of mercy, the promise he made to our fathers, to Abraham and his children forever.\n\nGlory to the Father, and to the Son, and to the Holy Spirit: as it was in the beginning, is now, and will be forever. Amen.","la":"Magnificat anima mea Dominum, et exsultavit spiritus meus in Deo salutari meo; quia respexit humilitatem ancillae suae. Ecce enim ex hoc beatam me dicent omnes generationes, quia fecit mihi magna qui potens est, et sanctum nomen eius, et misericordia eius a progenie in progenies timentibus eum. Fecit potentiam in brachio suo, dispersit superbos mente cordis sui; deposuit potentes de sede, et exaltavit humiles; esurientes implevit bonis, et divites dimisit inanes. Suscepit Israel puerum suum, recordatus misericordiae, sicut locutus est ad patres nostros, Abraham et semini eius in saecula.","fr":"Mon âme exalte le Seigneur, exulte mon esprit en Dieu, mon Sauveur! Il s’est penché sur son humble servante; désormais tous les âges me diront bienheureuse. Le Puissant fit pour moi des merveilles; saint est son nom! Sa miséricorde s’étend d’âge en âge sur ceux qui le craignent. Déployant la force de son bras, il disperse les superbes. Il renverse les puissants de leurs trônes, il élève les humbles. Il comble de biens les affamés, renvoie les riches les mains vides. Il relève Israël, son serviteur, il se souvient de son amour, de la promesse faite à nos pères, en faveur d’Abraham et de sa descendance, à jamais.","source":"","sourceUrl":"","note":"","category":"marian","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":false,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Magnificat","witness":"Compendium of the Catechism of the Catholic Church · Appendix A","url":"https://www.vatican.va/archive/compendium_ccc/documents/archive_2005_compendium-ccc_en.html","quality":"VERIFIED_PRIMARY","visibility":0,"adaptation":"VERBATIM","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_PRIMARY"},"note":"Common prayer; provenance retained internally and not shown by default."},"sourceAuditVersion":"35.7"},"marian_consecration_immaculate_heart":{"id":"marian_consecration_immaculate_heart","title":"Consecration to Immaculate Heart","titleFr":"Consécration au Cœur Immaculé","en":"O Immaculate Heart of Mary, Queen of Heaven and Earth, and tender Mother of men, in accordance with Thy ardent wish made known at Fatima, I consecrate to Thy Immaculate Heart myself, my brethren, my country, and the whole human race.\n\nReign over us, Most Holy Mother of God, and teach us how to make the Heart of Thy Son, Our Lord Jesus Christ reign and triumph in us even as It has reigned and triumphed in Thee.\n\nReign over us, Most Blessed Virgin, that we may be Thine in prosperity and in adversity, in joy and in sorrow, in health and in sickness, in life and in death.\n\nO most compassionate Heart of Mary, Queen of Heaven, watch over our minds and hearts and preserve them from the impurity which Thou didst lament so sorrowfully at Fatima. Assist us in imitating Thee in all things, especially purity. Help us to call down upon our country and upon the whole world the peace of God in justice and charity.\n\nTherefore, Most Gracious Virgin and Mother, I hereby promise to imitate Thy virtues by the practice of a true Christian life without regard to human respect.\n\nI resolve to receive Holy Communion regularly and to offer to Thee five decades of the Rosary each day, together with my sacrifices, in the spirit of reparation and penance. Amen.","la":"","fr":"","source":"Traditional Fatima consecration","sourceUrl":"https://fatima.org/act-of-cosnecration-to-the-immaculate-heart-of-mary/","note":"The exact historical English Fatima devotional form is retained. Latin and French remain deliberately withheld until exact witnesses of this same formula—not a different consecration text—are verified.","category":"marian","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":true,"sourceStatus":"VERIFIED_SECONDARY","provenance":{"work":"Act of Consecration to the Immaculate Heart of Mary","witness":"Historical Fatima devotional witness","url":"https://fatima.org/act-of-cosnecration-to-the-immaculate-heart-of-mary/","quality":"VERIFIED_SECONDARY","visibility":1,"adaptation":"VERBATIM","languages":{"en":"VERIFIED_SECONDARY","la":"SOURCE_PENDING","fr":"SOURCE_PENDING"},"note":"English exact witness retained. Latin and French remain deliberately pending because readily available Pius-XII/Fatima consecrations are different texts and must not be substituted merely to complete the language matrix."},"sourceAuditVersion":"41.4"},"adoration_anima_christi":{"id":"adoration_anima_christi","title":"Anima Christi","titleFr":"Anima Christi","en":"Soul of Christ, sanctify me. Body of Christ, save me. Blood of Christ, inebriate me. Water from the side of Christ, wash me. Passion of Christ, strengthen me. O good Jesus, hear me. Within your wounds hide me. Permit me not to be separated from you. From the wicked foe defend me. At the hour of my death call me and bid me come to you, that with your saints I may praise you forever and ever. Amen.","la":"Anima Christi, sanctifica me. Corpus Christi, salva me. Sanguis Christi, inebria me. Aqua lateris Christi, lava me. Passio Christi, conforta me. O bone Iesu, exaudi me. Intra tua vulnera absconde me. Ne permittas me separari a te. Ab hoste maligno defende me. In hora mortis meae voca me, et iube me venire ad te, ut cum Sanctis tuis laudem te in saecula saeculorum. Amen.","fr":"Âme du Christ, sanctifie-moi. Corps du Christ, sauve-moi. Sang du Christ, enivre-moi. Eau du côté du Christ, lave-moi. Passion du Christ, fortifie-moi. Ô bon Jésus, exauce-moi. Dans tes plaies, cache-moi. Ne permets pas que je sois séparé de toi. De l’ennemi perfide, défends-moi. À l’heure de ma mort, appelle-moi; ordonne-moi de venir à toi, pour qu’avec tes saints je te loue dans les siècles des siècles. Amen.","source":"","sourceUrl":"","note":"","category":"eucharistic","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":false,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Anima Christi","witness":"Vatican Compendium (Latin); traditional English/French witnesses","url":"https://www.vatican.va/archive/compendium_ccc/documents/archive_2005_compendium-ccc_en.html","quality":"VERIFIED_PRIMARY","visibility":0,"adaptation":"TRADITIONAL_TRANSLATION","languages":{"en":"VERIFIED_SECONDARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_SECONDARY"},"note":"The common prayer is traceable internally; no visible source line is needed."},"sourceAuditVersion":"35.7"},"adoration_spiritual_communion":{"id":"adoration_spiritual_communion","title":"Spiritual Communion","titleFr":"Communion spirituelle","en":"My Jesus, I believe that You are present in the Most Blessed Sacrament. I love You above all things, and I desire to receive You into my soul. Since I cannot now receive You sacramentally, come at least spiritually into my heart. I embrace You as if You were already there, and I unite myself wholly to You. Never permit me to be separated from You.","la":"Iesu mi, credo te in Sanctissimo Sacramento praesente; te amo super omnia et desidero te in animam meam recipere. Quoniam nunc non possum te sacramentaliter recipere, veni saltem spiritualiter in cor meum. Te amplexus sum, ac me totum tibi unio; ne permittas me umquam separari a te. Amen.","fr":"Mon Jésus, je crois que tu es réellement présent dans le Très Saint Sacrement. Je t’aime par-dessus tout et je désire te recevoir dans mon âme. Comme je ne peux pas maintenant te recevoir sacramentellement, viens au moins spirituellement dans mon cœur. Comme si tu y étais déjà venu, je t’adore et je m’unis entièrement à toi. Ne permets pas que je sois jamais séparé de toi. Amen.","source":"St Alphonsus Liguori","sourceUrl":"https://www.vaticannews.va/en/prayers/the-spiritual-communion.html","note":"","category":"eucharistic","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":true,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Act of Spiritual Communion","witness":"Vatican News · attributed to St Alphonsus Liguori","url":"https://www.vaticannews.va/en/prayers/the-spiritual-communion.html","quality":"VERIFIED_PRIMARY","visibility":1,"adaptation":"VERBATIM","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_SECONDARY","fr":"VERIFIED_SECONDARY"},"note":""},"sourceAuditVersion":"35.7"},"benediction_o_salutaris":{"id":"benediction_o_salutaris","title":"O Salutaris Hostia","titleFr":"O Salutaris Hostia","en":"O saving Victim, open wide the gate of heaven to us below; our foes press on from every side, your aid supply, your strength bestow.\n\nTo your great name be endless praise, immortal Godhead, One in Three; O grant us endless length of days, in our true native land with thee. Amen.","la":"O salutaris Hostia,\nQuae caeli pandis ostium:\nBella premunt hostilia,\nDa robur, fer auxilium.\nUni trinoque Domino\nSit sempiterna gloria,\nQui vitam sine termino\nNobis donet in patria. Amen.","fr":"Ô Victime sainte, qui ouvrez\nLa porte du ciel à nous ici-bas,\nLes ennemis nous pressent de tous côtés,\nDonnez force, apportez secours.\nAu Seigneur unique et trinitaire\nSoit la gloire éternelle,\nQu’Il nous donne la vie sans fin\nDans notre patrie véritable. Amen.","source":"St Thomas Aquinas","sourceUrl":"https://en.wikisource.org/wiki/With_God/Benediction_of_the_Blessed_Sacrament","note":"","category":"eucharistic","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":true,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"O Salutaris Hostia","witness":"Lasance · With God · Benediction of the Blessed Sacrament","url":"https://en.wikisource.org/wiki/With_God/Benediction_of_the_Blessed_Sacrament","quality":"VERIFIED_PRIMARY","visibility":1,"adaptation":"TRADITIONAL_TRANSLATION","languages":{"en":"VERIFIED_SECONDARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_SECONDARY"},"note":"Latin hymn text is traditional; translations are tracked separately."},"sourceAuditVersion":"35.7"},"benediction_tantum_ergo":{"id":"benediction_tantum_ergo","title":"Tantum Ergo","titleFr":"Tantum Ergo","en":"Down in adoration falling, Lo! the sacred Host we hail; Lo! o’er ancient forms departing, newer rites of grace prevail; faith for all defects supplying, where the feeble senses fail.\n\nTo the everlasting Father, and the Son who reigns on high, with the Holy Spirit proceeding forth from each eternally, be salvation, honor, blessing, might and endless majesty. Amen.","la":"Tantum ergo Sacramentum\nVeneremur cernui:\nEt antiquum documentum\nNovo cedat ritui:\nPraestet fides supplementum\nSensuum defectui.\n\nGenitori, Genitoque\nLaus et jubilatio,\nSalus, honor, virtus quoque\nSit et benedictio:\nProcedenti ab utroque\nCompar sit laudatio. Amen.","fr":"Devant un si grand Sacrement,\nProsternons-nous en adoration;\nQue l’ancien rite cède la place\nAu nouveau rite de grâce;\nQue la foi supplée à la faiblesse\nDe nos sens défaillants.\n\nAu Père et au Fils,\nLouange et jubilation,\nSalut, honneur, puissance aussi\nEt bénédiction;\nÀ Celui qui procède des deux\nSoit semblable louange. Amen.","source":"St Thomas Aquinas","sourceUrl":"https://en.wikisource.org/wiki/With_God/Benediction_of_the_Blessed_Sacrament","note":"","category":"eucharistic","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":true,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Tantum Ergo","witness":"Lasance · With God · Benediction of the Blessed Sacrament","url":"https://en.wikisource.org/wiki/With_God/Benediction_of_the_Blessed_Sacrament","quality":"VERIFIED_PRIMARY","visibility":1,"adaptation":"TRADITIONAL_TRANSLATION","languages":{"en":"VERIFIED_SECONDARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_SECONDARY"},"note":"Latin hymn text is traditional; translations are tracked separately."},"sourceAuditVersion":"35.7"},"benediction_divine_praises":{"id":"benediction_divine_praises","title":"Divine Praises","titleFr":"Louanges divines","en":"Blessed be God.\nBlessed be His Holy Name.\nBlessed be Jesus Christ, true God and true man.\nBlessed be the Name of Jesus.\nBlessed be His most Sacred Heart.\nBlessed be His most Precious Blood.\nBlessed be Jesus in the most Holy Sacrament of the Altar.\nBlessed be the Holy Spirit, the Paraclete.\nBlessed be the great Mother of God, Mary most holy.\nBlessed be her holy and Immaculate Conception.\nBlessed be her glorious Assumption.\nBlessed be the name of Mary, Virgin and Mother.\nBlessed be Saint Joseph, her most chaste spouse.\nBlessed be God in His Angels and in His Saints.","la":"Benedictus Deus.\nBenedictum Nomen Sanctum eius.\nBenedictus Iesus Christus, verus Deus et verus homo.\nBenedictum Nomen Iesu.\nBenedictum Cor eius sacratissimum.\nBenedictus Sanguis eius pretiosissimus.\nBenedictus Iesus in sanctissimo altaris Sacramento.\nBenedictus Spiritus Sanctus, Paraclitus.\nBenedicta magna Mater Dei, Maria sanctissima.\nBenedicta sancta eius et immaculata Conceptio.\nBenedicta gloriosa eius Assumptio.\nBenedictum nomen Mariae, Virginis et Matris.\nBenedictus sanctus Ioseph, eius castissimus Sponsus.\nBenedictus Deus in angelis suis et in sanctis suis.","fr":"Béni soit Dieu.\nBéni soit son saint Nom.\nBéni soit Jésus-Christ, vrai Dieu et vrai homme.\nBéni soit le Nom de Jésus.\nBéni soit son Sacré-Cœur.\nBéni soit son Précieux Sang.\nBéni soit Jésus dans le très saint Sacrement de l’autel.\nBéni soit l’Esprit Saint, le Paraclet.\nBénie soit la grande Mère de Dieu, Marie très sainte.\nBénie soit sa sainte et immaculée Conception.\nBénie soit sa glorieuse Assomption.\nBéni soit le nom de Marie, Vierge et Mère.\nBéni soit saint Joseph, son très chaste époux.\nBéni soit Dieu dans ses anges et dans ses saints.","source":"Eucharistic Worship outside Mass · no. 99","sourceUrl":"https://www.usccb.org/prayers/divine-praises","note":"","category":"eucharistic","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":true,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"The Divine Praises","witness":"Holy Communion and Worship of the Eucharistic Mystery outside Mass · no. 99","url":"https://www.usccb.org/prayers/divine-praises","quality":"VERIFIED_PRIMARY","visibility":1,"adaptation":"VERBATIM","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_SECONDARY","fr":"VERIFIED_SECONDARY"},"note":""},"sourceAuditVersion":"35.7"},"adoration_litany_blessed_sacrament":{"id":"adoration_litany_blessed_sacrament","title":"Litany of the Most Blessed Sacrament","titleFr":"Litanies du Très Saint Sacrement","en":"Lord, have mercy on us. Christ, have mercy on us. Lord, have mercy on us.\nChrist, hear us. Christ, graciously hear us.\nGod the Father of heaven, have mercy on us.\nGod the Son, Redeemer of the world, have mercy on us.\nGod the Holy Spirit, have mercy on us.\nHoly Trinity, one God, have mercy on us.\n\nLiving Bread which came down from heaven, have mercy on us.\nHidden God and Saviour, have mercy on us.\nWheat of the elect, have mercy on us.\nWine springing forth virgins, have mercy on us.\nBread of delight for kings, have mercy on us.\nPerpetual sacrifice, have mercy on us.\nPure oblation, have mercy on us.\nLamb without spot, have mercy on us.\nTable of holiness, have mercy on us.\nFood of Angels, have mercy on us.\nManna of inward strength, have mercy on us.\nMemorial of the wonders of God, have mercy on us.\nWord made flesh, dwelling among us, have mercy on us.\nSacred and adorable Host, have mercy on us.\nChalice of blessing, have mercy on us.\nMystery of faith, have mercy on us.\nMost high and venerable Sacrament, have mercy on us.\nMost holy sacrifice, have mercy on us.\nSacrifice of propitiation for the living and the dead, have mercy on us.\nHeavenly remedy against sin, have mercy on us.\nMemorial of the Passion of the Lord, have mercy on us.\nMost precious gift, have mercy on us.\nTenderest pledge of divine love, have mercy on us.\nPledge of our future glory, have mercy on us.\nSacrament of love, have mercy on us.\nBond of charity, have mercy on us.\nRefreshment of holy souls, have mercy on us.\nViaticum of those who die in the Lord, have mercy on us.\n\nFrom receiving your adorable Body and Blood unworthily, deliver us, O Lord.\nFrom the concupiscence of the flesh, deliver us, O Lord.\nFrom the concupiscence of the eyes, deliver us, O Lord.\nFrom the pride of life, deliver us, O Lord.\nFrom every occasion of sin, deliver us, O Lord.\n\nWe sinners, beseech you, hear us.\nThat you would increase and preserve in us faith, reverence and devotion toward this admirable Sacrament, we beseech you, hear us.\nThat through humble and sincere confession you would lead us to frequent reception of the Holy Eucharist, we beseech you, hear us.\nThat you would preserve us from heresy, unbelief and blindness of heart, we beseech you, hear us.\nThat you would grant us the heavenly fruits of this most holy Sacrament, we beseech you, hear us.\nThat at the hour of death you would strengthen us with this heavenly Viaticum, we beseech you, hear us.\n\nLamb of God, who takes away the sins of the world, spare us, O Lord.\nLamb of God, who takes away the sins of the world, graciously hear us, O Lord.\nLamb of God, who takes away the sins of the world, have mercy on us.\n\n℣. You gave them Bread from heaven.\n℟. Containing in itself all delight.\n\nLet us pray. O God, who in this wonderful Sacrament have left us a memorial of your Passion, grant us, we beseech you, so to venerate the sacred mysteries of your Body and Blood that we may ever experience within us the fruit of your redemption. Who live and reign forever and ever. Amen.","la":"Kyrie, eleison. Christe, eleison. Kyrie, eleison.\nChriste, audi nos. Christe, exaudi nos.\nPater de cælis, Deus, miserere nobis.\nFili, Redemptor mundi, Deus, miserere nobis.\nSpiritus Sancte, Deus, miserere nobis.\nSancta Trinitas, unus Deus, miserere nobis.\n\nPanis vivus, qui de cælo descendisti, miserere nobis.\nDeus absconditus et Salvator, miserere nobis.\nFrumentum electorum, miserere nobis.\nVinum germinans virgines, miserere nobis.\nPanis pinguis et deliciæ regum, miserere nobis.\nIuge sacrificium, miserere nobis.\nOblatio munda, miserere nobis.\nAgnus absque macula, miserere nobis.\nMensa purissima, miserere nobis.\nCibus Angelorum, miserere nobis.\nManna absconditum, miserere nobis.\nMemoriale mirabilium Dei, miserere nobis.\nVerbum caro factum, habitans in nobis, miserere nobis.\nHostia sancta et adoranda, miserere nobis.\nCalix benedictionis, miserere nobis.\nMysterium fidei, miserere nobis.\nPræcelsum et venerabile Sacramentum, miserere nobis.\nSacrificium sanctissimum, miserere nobis.\nSacrificium propitiatorium pro vivis et defunctis, miserere nobis.\nCæleste antidotum contra peccata, miserere nobis.\nMemoriale Passionis Dominicæ, miserere nobis.\nDonum super omnia dona, miserere nobis.\nPignus caritatis divinæ, miserere nobis.\nPignus futuræ gloriæ, miserere nobis.\nSacramentum dilectionis, miserere nobis.\nVinculum caritatis, miserere nobis.\nRefectio animarum sanctarum, miserere nobis.\nViaticum in Domino morientium, miserere nobis.\n\nA sumptione Corporis et Sanguinis tui indigna, libera nos, Domine.\nA concupiscentia carnis, libera nos, Domine.\nA concupiscentia oculorum, libera nos, Domine.\nA superbia vitæ, libera nos, Domine.\nAb omni occasione peccandi, libera nos, Domine.\n\nPeccatores, te rogamus, audi nos.\nUt fidem, reverentiam et devotionem erga hoc admirabile Sacramentum augere et conservare digneris, te rogamus, audi nos.\nUt ad frequentem sanctæ Eucharistiæ susceptionem per humilem et sinceram confessionem nos perducere digneris, te rogamus, audi nos.\nUt nos ab omni hæresi, infidelitate et cordis cæcitate liberare digneris, te rogamus, audi nos.\nUt fructus pretiosos huius sanctissimi Sacramenti nobis impertiri digneris, te rogamus, audi nos.\nUt in hora mortis cælesti hoc Viatico nos confortare digneris, te rogamus, audi nos.\n\nAgnus Dei, qui tollis peccata mundi, parce nobis, Domine.\nAgnus Dei, qui tollis peccata mundi, exaudi nos, Domine.\nAgnus Dei, qui tollis peccata mundi, miserere nobis.\n\n℣. Panem de cælo præstitisti eis.\n℟. Omne delectamentum in se habentem.\n\nOremus. Deus, qui nobis sub Sacramento mirabili Passionis tuæ memoriam reliquisti: tribue, quæsumus, ita nos Corporis et Sanguinis tui sacra mysteria venerari, ut redemptionis tuæ fructum in nobis iugiter sentiamus. Qui vivis et regnas in sæcula sæculorum. Amen.","fr":"Seigneur, ayez pitié de nous. Jésus-Christ, ayez pitié de nous. Seigneur, ayez pitié de nous.\nJésus-Christ, écoutez-nous. Jésus-Christ, exaucez-nous.\nPère céleste, qui êtes Dieu, ayez pitié de nous.\nFils, Rédempteur du monde, qui êtes Dieu, ayez pitié de nous.\nEsprit-Saint, qui êtes Dieu, ayez pitié de nous.\nTrinité Sainte, qui êtes un seul Dieu, ayez pitié de nous.\n\nPain vivant descendu du ciel, ayez pitié de nous.\nDieu caché et Sauveur, ayez pitié de nous.\nFroment des élus, ayez pitié de nous.\nVin qui faites germer les vierges, ayez pitié de nous.\nPain délicieux des rois, ayez pitié de nous.\nSacrifice perpétuel, ayez pitié de nous.\nOblation pure, ayez pitié de nous.\nAgneau sans tache, ayez pitié de nous.\nTable de sainteté, ayez pitié de nous.\nNourriture des Anges, ayez pitié de nous.\nManne cachée, ayez pitié de nous.\nMémorial des merveilles de Dieu, ayez pitié de nous.\nVerbe fait chair, habitant parmi nous, ayez pitié de nous.\nHostie sainte et adorable, ayez pitié de nous.\nCalice de bénédiction, ayez pitié de nous.\nMystère de foi, ayez pitié de nous.\nSacrement très haut et très vénérable, ayez pitié de nous.\nSacrifice très saint, ayez pitié de nous.\nSacrifice de propitiation pour les vivants et les morts, ayez pitié de nous.\nRemède céleste contre le péché, ayez pitié de nous.\nMémorial de la Passion du Seigneur, ayez pitié de nous.\nDon très précieux, ayez pitié de nous.\nGage très tendre de l’amour divin, ayez pitié de nous.\nGage de notre gloire future, ayez pitié de nous.\nSacrement d’amour, ayez pitié de nous.\nLien de charité, ayez pitié de nous.\nRafraîchissement des âmes saintes, ayez pitié de nous.\nViatique de ceux qui meurent dans le Seigneur, ayez pitié de nous.\n\nDe la réception indigne de votre Corps et de votre Sang adorables, délivrez-nous, Seigneur.\nDe la concupiscence de la chair, délivrez-nous, Seigneur.\nDe la concupiscence des yeux, délivrez-nous, Seigneur.\nDe l’orgueil de la vie, délivrez-nous, Seigneur.\nDe toute occasion de péché, délivrez-nous, Seigneur.\n\nPécheurs que nous sommes, nous vous en prions, écoutez-nous.\nDaignez accroître et conserver en nous la foi, le respect et la dévotion envers cet admirable Sacrement, nous vous en prions, écoutez-nous.\nDaignez nous conduire, par une confession humble et sincère, à la réception fréquente de la sainte Eucharistie, nous vous en prions, écoutez-nous.\nDaignez nous préserver de l’hérésie, de l’incrédulité et de l’aveuglement du cœur, nous vous en prions, écoutez-nous.\nDaignez nous accorder les fruits célestes de ce très saint Sacrement, nous vous en prions, écoutez-nous.\nÀ l’heure de notre mort, daignez nous fortifier par ce céleste Viatique, nous vous en prions, écoutez-nous.\n\nAgneau de Dieu, qui effacez les péchés du monde, pardonnez-nous, Seigneur.\nAgneau de Dieu, qui effacez les péchés du monde, exaucez-nous, Seigneur.\nAgneau de Dieu, qui effacez les péchés du monde, ayez pitié de nous.\n\n℣. Vous leur avez donné un pain venu du ciel.\n℟. Qui renferme en lui toutes les délices.\n\nPrions. Ô Dieu, qui nous avez laissé dans cet admirable Sacrement le mémorial de votre Passion, accordez-nous, nous vous en supplions, de vénérer les saints mystères de votre Corps et de votre Sang de telle sorte que nous ressentions toujours en nous le fruit de votre rédemption. Vous qui vivez et régnez dans les siècles des siècles. Ainsi soit-il.","source":"Lasance · With God · 1911","sourceUrl":"https://en.wikisource.org/wiki/With_God/Litanies","note":"","category":"eucharistic","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":true,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Litany of the Blessed Sacrament","witness":"F. X. Lasance · With God · 1911 · p. 496","url":"https://en.wikisource.org/wiki/With_God/Litanies","quality":"VERIFIED_PRIMARY","visibility":1,"adaptation":"TYPOGRAPHY_NORMALIZED","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_SECONDARY","fr":"VERIFIED_SECONDARY"},"note":"Historical indulgence notices are not presented as current grants."},"sourceAuditVersion":"35.7"},"benediction_versicles":{"id":"benediction_versicles","title":"Versicle & Prayer (English)","titleFr":"Versets et oraison de la bénédiction","en":"℣. You have given them Bread from Heaven.\n℟. Having within it all sweetness.\n\nLet us pray:\nO God, who in this wonderful Sacrament left us a memorial of your Passion:\ngrant us, we beseech you, so to venerate the sacred mysteries of your Body and Blood,\nthat we may ever feel within us the fruit of your redemption.\nWho live and reign forever and ever. Amen.","la":"V. Panem de caelo praestitisti eis.\nR. Omne delectamentum in se habentem.\n\nOremus:\nDeus, qui nobis sub sacramento mirabili passionis tuae memoriam reliquisti:\ntribue, quaesumus, ita nos Corporis et Sanguinis tui sacra mysteria venerari,\nut redemptionis tuae fructum in nobis iugiter sentiamus.\nQui vivis et regnas in saecula saeculorum. Amen.","fr":"V. Vous leur avez donné le Pain du ciel.\nR. Qui contient en lui toutes délices.\n\nPrions :\nÔ Dieu, qui dans ce merveilleux Sacrement nous avez laissé le mémorial de votre Passion :\naccordez-nous de vénérer les saints mystères de votre Corps et de votre Sang,\nafin que nous ressentions toujours en nous le fruit de la rédemption.\nPar le Christ notre Seigneur. Amen.","source":"Traditional Benediction","sourceUrl":"https://en.wikisource.org/wiki/With_God/Benediction_of_the_Blessed_Sacrament","note":"","category":"eucharistic","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":true,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Panem de caelo / Deus qui nobis","witness":"Lasance · With God · Benediction of the Blessed Sacrament","url":"https://en.wikisource.org/wiki/With_God/Benediction_of_the_Blessed_Sacrament","quality":"VERIFIED_PRIMARY","visibility":1,"adaptation":"TRADITIONAL_TRANSLATION","languages":{"en":"VERIFIED_SECONDARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_SECONDARY"},"note":""},"sourceAuditVersion":"35.7"},"adoration_lord_i_am_not_worthy":{"id":"adoration_lord_i_am_not_worthy","title":"Lord, I Am Not Worthy","titleFr":"Domine, non sum dignus","en":"Lord, I am not worthy that Thou shouldst enter under my roof; but only say the word and my soul shall be healed.","la":"Domine, non sum dignus ut intres sub tectum meum; sed tantum dic verbo, et sanabitur anima mea.","fr":"Seigneur, je ne suis pas digne que vous entriez sous mon toit ; mais dites seulement une parole et mon âme sera guérie.","source":"Missale Romanum 1962 · Communion formula","sourceUrl":"","note":"Traditional English/French rendering of the Latin formula.","category":"massdev"},"mass_devotion_leonine":{"id":"mass_devotion_leonine","title":"Leonine Prayers After Low Mass","titleFr":"Prières léonines après la Messe basse","en":"Hail Mary, full of grace, the Lord is with thee; blessed art thou among women, and blessed is the fruit of thy womb, Jesus. Holy Mary, Mother of God, pray for us sinners, now and at the hour of our death. Amen. (three times)\n----\nHail, holy Queen, Mother of mercy, our life, our sweetness and our hope. To thee do we cry, poor banished children of Eve; to thee do we send up our sighs, mourning and weeping in this vale of tears. Turn then, most gracious advocate, thine eyes of mercy toward us; and after this our exile show unto us the blessed fruit of thy womb, Jesus. O clement, O loving, O sweet Virgin Mary.\n\n℣. Pray for us, O holy Mother of God.\n℟. That we may be made worthy of the promises of Christ.\n----\nLet us pray. O God, our refuge and our strength, look down in mercy on your people who cry to you; and by the intercession of the glorious and immaculate Virgin Mary, Mother of God, of Saint Joseph her spouse, of your blessed Apostles Peter and Paul, and of all the Saints, mercifully and graciously hear the prayers which we pour forth for the conversion of sinners and for the freedom and exaltation of Holy Mother Church. Through the same Christ our Lord. Amen.\n----\nSaint Michael the Archangel, defend us in battle; be our protection against the wickedness and snares of the devil. May God rebuke him, we humbly pray; and do thou, O Prince of the heavenly host, by the power of God, cast into hell Satan and all the evil spirits who prowl throughout the world seeking the ruin of souls. Amen.\n----\nMost Sacred Heart of Jesus, have mercy on us. (three times)","la":"Ave Maria, gratia plena, Dominus tecum; benedicta tu in mulieribus, et benedictus fructus ventris tui, Iesus. Sancta Maria, Mater Dei, ora pro nobis peccatoribus, nunc et in hora mortis nostræ. Amen. (ter)\n----\nSalve, Regina, Mater misericordiæ; vita, dulcedo et spes nostra, salve. Ad te clamamus, exsules filii Hevæ. Ad te suspiramus, gementes et flentes in hac lacrimarum valle. Eia ergo, advocata nostra, illos tuos misericordes oculos ad nos converte. Et Iesum, benedictum fructum ventris tui, nobis post hoc exsilium ostende. O clemens, o pia, o dulcis Virgo Maria.\n\n℣. Ora pro nobis, sancta Dei Genetrix.\n℟. Ut digni efficiamur promissionibus Christi.\n----\nOremus. Deus, refugium nostrum et virtus, populum ad te clamantem propitius respice; et intercedente gloriosa et immaculata Virgine Dei Genetrice Maria, cum beato Ioseph, eius Sponso, ac beatis Apostolis tuis Petro et Paulo, et omnibus Sanctis, quas pro conversione peccatorum, pro libertate et exaltatione sanctæ Matris Ecclesiæ, preces effundimus, misericors et benignus exaudi. Per eundem Christum Dominum nostrum. Amen.\n----\nSancte Michael Archangele, defende nos in prœlio; contra nequitiam et insidias diaboli esto præsidium. Imperet illi Deus, supplices deprecamur: tuque, Princeps militiæ cælestis, Satanam aliosque spiritus malignos, qui ad perditionem animarum pervagantur in mundo, divina virtute in infernum detrude. Amen.\n----\nCor Iesu sacratissimum, miserere nobis. (ter)","fr":"Je vous salue, Marie, pleine de grâce; le Seigneur est avec vous; vous êtes bénie entre toutes les femmes, et Jésus, le fruit de vos entrailles, est béni. Sainte Marie, Mère de Dieu, priez pour nous, pauvres pécheurs, maintenant et à l’heure de notre mort. Ainsi soit-il. (trois fois)\n----\nSalut, ô Reine, Mère de miséricorde, notre vie, notre douceur et notre espérance, salut. Enfants d’Ève exilés, nous crions vers vous. Vers vous nous soupirons, gémissant et pleurant dans cette vallée de larmes. Ô vous, notre avocate, tournez vers nous vos regards miséricordieux. Et après cet exil, montrez-nous Jésus, le fruit béni de vos entrailles. Ô clémente, ô charitable, ô douce Vierge Marie.\n\n℣. Priez pour nous, Sainte Mère de Dieu.\n℟. Afin que nous devenions dignes des promesses de Jésus-Christ.\n----\nPrions. Ô Dieu, notre refuge et notre force, regardez favorablement le peuple qui crie vers vous; et par l’intercession de la glorieuse et immaculée Vierge Marie, Mère de Dieu, de saint Joseph son époux, de vos bienheureux Apôtres Pierre et Paul et de tous les saints, écoutez avec miséricorde et bonté les prières que nous répandons pour la conversion des pécheurs, pour la liberté et l’exaltation de notre sainte Mère l’Église. Par le même Jésus-Christ Notre-Seigneur. Ainsi soit-il.\n----\nSaint Michel Archange, défendez-nous dans le combat; soyez notre secours contre la malice et les embûches du démon. Que Dieu lui commande, nous vous en supplions; et vous, Prince de la milice céleste, par la puissance divine, repoussez en enfer Satan et les autres esprits mauvais qui rôdent dans le monde pour la perte des âmes. Ainsi soit-il.\n----\nCœur Sacré de Jésus, ayez pitié de nous. (trois fois)","source":"Prayers after Low Mass · historical Leonine form","sourceUrl":"https://en.wikisource.org/wiki/The_Catholic%27s_pocket_prayer-book/Prayers_after_Low-Mass","note":"Historically prescribed after Low Mass; retained here as a traditional post-Mass devotion.","category":"massdev","sourceStatus":"VERIFIED_SECONDARY","provenance":{"work":"Prayers after Low Mass (Leonine Prayers)","witness":"The Catholic's Pocket Prayer-Book · Prayers after Low-Mass","url":"https://en.wikisource.org/wiki/The_Catholic%27s_pocket_prayer-book/Prayers_after_Low-Mass","quality":"VERIFIED_SECONDARY","visibility":1,"adaptation":"TYPOGRAPHY_NORMALIZED","languages":{"en":"VERIFIED_SECONDARY","la":"VERIFIED_SECONDARY","fr":"VERIFIED_SECONDARY"},"note":"The historical prayer-book witness supplies the sequence; no claim is made that this devotion forms part of the Mass itself."}},"sacrament_come_holy_spirit":{"id":"sacrament_come_holy_spirit","title":"Come, Holy Spirit","titleFr":"Venez, Esprit-Saint","en":"Come, Holy Spirit, fill the hearts of your faithful and kindle in them the fire of your love. ℣. Send forth your Spirit and they shall be created.\n℟. And you shall renew the face of the earth.\n\nLet us pray. O God, who by the light of the Holy Spirit did instruct the hearts of the faithful, grant that by the same Holy Spirit we may be truly wise and ever enjoy his consolations. Through Christ our Lord. Amen.","la":"Veni, Sancte Spiritus, reple tuorum corda fidelium, et tui amoris in eis ignem accende. ℣. Emitte Spiritum tuum, et creabuntur.\n℟. Et renovabis faciem terrae. Oremus. Deus, qui corda fidelium Sancti Spiritus illustratione docuisti, da nobis in eodem Spiritu recta sapere, et de eius semper consolatione gaudere. Per Christum Dominum nostrum. Amen.","fr":"Viens, Esprit Saint, remplis le cœur de tes fidèles et allume en eux le feu de ton amour. ℣. Envoie ton Esprit, et tout sera créé.\n℟. Et tu renouvelleras la face de la terre. Prions. Dieu, qui as instruit le cœur de tes fidèles par la lumière du Saint-Esprit, donne-nous, par ce même Esprit, de goûter ce qui est bien et de jouir toujours de ses consolations. Par le Christ, notre Seigneur. Amen.","source":"","sourceUrl":"","note":"","category":"holyghost","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":false,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Prayer to the Holy Spirit","witness":"USCCB prayer witness","url":"https://www.usccb.org/prayers/prayer-holy-spirit","quality":"VERIFIED_PRIMARY","visibility":0,"adaptation":"TRADITIONAL_TRANSLATION","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_SECONDARY"},"note":""},"sourceAuditVersion":"35.7"},"weekday_benedictus":{"id":"weekday_benedictus","title":"Benedictus (Zechariah)","titleFr":"Benedictus","en":"Blessed be the Lord, the God of Israel; he has come to his people and set them free. He has raised up for us a mighty savior, born of the house of his servant David.\n\nThrough his holy prophets he promised of old that he would save us from our enemies, from the hands of all who hate us. He promised to show mercy to our fathers and to remember his holy covenant.\n\nThis was the oath he swore to our father Abraham: to set us free from the hands of our enemies, free to worship him without fear, holy and righteous in his sight all the days of our life.\n\nYou, my child, shall be called the prophet of the Most High; for you will go before the Lord to prepare his way, to give his people knowledge of salvation by the forgiveness of their sins.\n\nIn the tender compassion of our God the dawn from on high shall break upon us, to shine on those who dwell in darkness and the shadow of death, and to guide our feet into the way of peace.\n\nGlory to the Father, and to the Son, and to the Holy Spirit: as it was in the beginning, is now, and will be forever. Amen.","la":"Benedictus Dominus Deus Israel, quia visitavit et fecit redemptionem plebis suae, et erexit cornu salutis nobis in domo David pueri sui, sicut locutus est per os sanctorum, qui a saeculo sunt, prophetarum eius, salutem ex inimicis nostris, et de manu omnium qui oderunt nos; ad faciendam misericordiam cum patribus nostris et memorari testamenti sui sancti; iusjurandum quod iuravit ad Abraham patrem nostrum daturum se nobis, ut sine timore, de manu inimicorum nostrorum liberati, serviamus illi in sanctitate et iustitia coram ipso omnibus diebus nostris. Et tu, puer, propheta Altissimi vocaberis; praeibis enim ante faciem Domini parare vias eius, ad dandam scientiam salutis plebi eius in remissionem peccatorum eorum, per viscera misericordiae Dei nostri, in quibus visitavit nos Oriens ex alto; illuminare his qui in tenebris et in umbra mortis sedent, ad dirigendos pedes nostros in viam pacis.","fr":"Béni soit le Seigneur, le Dieu d’Israël, qui visite et rachète son peuple. Il a fait surgir la force qui nous sauve dans la maison de David, son serviteur, comme il l’avait dit par la bouche des saints, par ses prophètes, depuis les temps anciens: salut qui nous arrache à l’ennemi, à la main de tous nos oppresseurs, amour qu’il montre envers nos pères, mémoire de son alliance sainte, serment juré à notre père Abraham de nous rendre sans crainte, afin que, délivrés de la main des ennemis, nous le servions dans la justice et la sainteté, en sa présence, tout au long de nos jours. Et toi, petit enfant, tu seras appelé prophète du Très-Haut; tu marcheras devant, à la face du Seigneur, et tu prépareras ses chemins pour donner à son peuple de connaître le salut par la rémission de ses péchés, grâce à la tendresse, à l’amour de notre Dieu, quand nous visite l’Astre d’en haut, pour illuminer ceux qui habitent les ténèbres et l’ombre de la mort, pour conduire nos pas au chemin de la paix.","source":"","sourceUrl":"","note":"","category":"canticles","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":false,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Benedictus","witness":"Compendium of the Catechism of the Catholic Church · Appendix A","url":"https://www.vatican.va/archive/compendium_ccc/documents/archive_2005_compendium-ccc_en.html","quality":"VERIFIED_PRIMARY","visibility":0,"adaptation":"VERBATIM","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_PRIMARY"},"note":"Common prayer; provenance retained internally and not shown by default."},"sourceAuditVersion":"35.7"},"devotion_prayer_st_michael":{"id":"devotion_prayer_st_michael","title":"Prayer to St. Michael","titleFr":"Prière à saint Michel","en":"St. Michael the Archangel, defend us in battle. Be our protection against the wickedness and snares of the devil. May God rebuke him, we humbly pray; and do thou, O Prince of the heavenly host, by the power of God, thrust into hell Satan and all the evil spirits who prowl about the world seeking the ruin of souls. Amen.","la":"Sancte Michael Archangele, defende nos in proelio; contra nequitiam et insidias diaboli esto praesidium. Imperet illi Deus, supplices deprecamur: tuque, Princeps militiae caelestis, Satanam aliosque spiritus malignos, qui ad perditionem animarum pervagantur in mundo, divina virtute in infernum detrude. Amen.","fr":"Saint Michel Archange, défendez-nous dans le combat; soyez notre secours contre la malice et les embûches du démon. Que Dieu lui commande, nous vous en supplions; et vous, Prince de la milice céleste, par la puissance divine, repoussez en enfer Satan et les autres esprits mauvais qui rôdent dans le monde pour la perte des âmes. Amen.","source":"Leo XIII","sourceUrl":"https://press.vatican.va/content/salastampa/en/bollettino/pubblico/2018/09/29/180929d.html","note":"","category":"saints","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":true,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Prayer to Saint Michael the Archangel","witness":"Holy See Press Office · prayer written by Leo XIII","url":"https://press.vatican.va/content/salastampa/en/bollettino/pubblico/2018/09/29/180929d.html","quality":"VERIFIED_PRIMARY","visibility":1,"adaptation":"TRADITIONAL_TRANSLATION","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_SECONDARY"},"note":""},"sourceAuditVersion":"35.7"},"devotion_memorare_st_joseph":{"id":"devotion_memorare_st_joseph","title":"Memorare to St. Joseph","titleFr":"Souvenez-vous à saint Joseph","en":"Remember, O most pure spouse of the Virgin Mary, my sweet protector St. Joseph, that no one ever had recourse to your protection or implored your aid without obtaining relief. Confiding therefore in your goodness, I come before you. Do not turn down my petitions, foster-father of the Redeemer, but graciously receive them. Amen.","la":"Memorare, o castissime Ioseph, quod numquam auditum sit quemquam ad tuam confugisse protectionem, tuum auxilium implorasse, tua patrocinia petiisse, et non esse exauditum. Confidens hac spe, ad te venio, o custos Redemptoris dulcissime; suscipe preces meas et benignus exaudi. Amen.","fr":"Souvenez-vous, ô très chaste époux de la Vierge Marie, ô bon protecteur, saint Joseph, qu’on n’a jamais entendu dire que personne ait eu recours à votre protection, imploré votre secours ou réclamé votre assistance sans en avoir été consolé. Plein de cette confiance, je me présente devant vous et je me recommande à vous. Ne rejetez pas ma prière, mais accueillez-la avec bonté et daignez l’exaucer. Amen.","source":"","sourceUrl":"","note":"","category":"saints","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":false,"sourceStatus":"VERIFIED_SECONDARY","provenance":{"work":"Memorare to Saint Joseph","witness":"Diocese of Sacramento traditional prayer witness","url":"https://www.scd.org/stjoseph/prayers","quality":"VERIFIED_SECONDARY","visibility":0,"adaptation":"TRADITIONAL_TRANSLATION","languages":{"en":"VERIFIED_SECONDARY","la":"VERIFIED_SECONDARY","fr":"VERIFIED_SECONDARY"},"note":"Common devotional prayer; visible attribution suppressed."},"sourceAuditVersion":"35.7"},"devotion_consecration_christ_king":{"id":"devotion_consecration_christ_king","title":"Consecration to Christ the King","titleFr":"Consécration au Christ-Roi","en":"O Jesus Christ, I acknowledge Thee as universal King. All that has been made, has been created for Thee. Exercise all Thy rights over me. I renew my baptismal vows, I renounce Satan, his pomps and his works: and I promise to live as a good Christian. And in particular do I pledge myself to labor, to the best of my ability, for the triumph of the rights of God and of Thy Church. Divine Heart of Jesus, to Thee do I offer my poor services, laboring that all hearts may acknowledge Thy Sacred kingship, and thus the reign of Thy peace may be established throughout the universe. Amen.","la":"Dómine Iesu Christe, te confíteor Regem universálem. Omnia, quæ facta sunt, pro te sunt creáta. Omnia iura tua exérce in me. Rénovo vota Baptísmi abrenúntians sátanæ eiúsque pompis et opéribus et promítto me victúrum ut bonum Christiánum. Ac potíssimum me óbligo operári quantum in me est, ut triúmphent Dei iura tuæque Ecclésiæ. Divínum Cor Iesu, óffero tibi actiónes meas ténues ad obtinéndum, ut corda ómnia agnóscant tuam sacram Regalitátem et ita tuæ pacis regnum stabiliátur in toto terrárum orbe. Amen.","fr":"Ô Christ Jésus, je Vous reconnais pour Roi Universel. Tout ce qui a été fait a été créé pour Vous. Exercez sur moi tous Vos droits. Je renouvelle mes promesses du Baptême en renonçant à Satan, à ses pompes et à ses œuvres, et je promets de vivre en bon Chrétien. Et tout particulièrement je m’engage à faire triompher selon mes moyens les droits de Dieu et de votre Église. Divin Cœur de Jésus, je Vous offre mes pauvres actions pour obtenir que tous les cœurs reconnaissent votre Royauté Sacrée et qu’ainsi le règne de votre Paix s’établisse dans l’univers entier. Ainsi soit-il.","source":"Prayer to Christ the Universal King · Pius XI era · 1923","sourceUrl":"https://app.itheca.org/biblioteca/Oraciones/DeumUnuTri.html","note":"The former 1903 attribution was removed. The Latin text is witnessed as Oratio ad Iesum Christum Regem; the French traditional witness is printed in the 2025 Notre-Dame de Chrétienté pilgrim book as a 1923 prayer of Pope Pius XI.","category":"saints","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":true,"sourceStatus":"VERIFIED_SECONDARY","provenance":{"work":"Oratio ad D. N. Iesum Christum Regem","witness":"Traditional Pius-XI-era Christ-the-King prayer · 1923","url":"https://app.itheca.org/biblioteca/Oraciones/DeumUnuTri.html","quality":"VERIFIED_SECONDARY","visibility":1,"adaptation":"VERBATIM","languages":{"en":"VERIFIED_SECONDARY","la":"VERIFIED_SECONDARY","fr":"VERIFIED_SECONDARY"},"note":"Latin witness: ITheca prayer library. French witness: Notre-Dame de Chrétienté, Livret des pèlerins 2025, which identifies it as a 1923 prayer of Pope Pius XI.","frenchWitnessUrl":"https://www.nd-chretiente.com/wordpress/wp-content/uploads/2025/05/Livret-du-pelerin-2025.pdf"},"sourceAuditVersion":"41.4"},"church_prayer_for_pope":{"id":"church_prayer_for_pope","title":"Prayer for the Pope","titleFr":"Prière pour le Pape","en":"℣. Let us pray for our Sovereign Pontiff N.\n℟. May the Lord preserve him and give him life, and make him blessed upon the earth, and deliver him not up to the will of his enemies.\n\n℣. Thou art Peter.\n℟. And upon this rock I will build my Church.\n\nLet us pray. O God, shepherd and ruler of all the faithful, look mercifully upon your servant N., whom you have willed to appoint shepherd over your Church. Grant him, we beseech you, that by word and example he may profit those over whom he has charge, so that, together with the flock committed to him, he may attain everlasting life. Through Christ our Lord. Amen.","la":"℣. Oremus pro Pontifice nostro N.\n℟. Dominus conservet eum, et vivificet eum, et beatum faciat eum in terra, et non tradat eum in animam inimicorum eius.\n\n℣. Tu es Petrus.\n℟. Et super hanc petram ædificabo Ecclesiam meam.\n\nOremus. Deus, omnium fidelium pastor et rector, famulum tuum N., quem pastorem Ecclesiæ tuæ præesse voluisti, propitius respice: da ei, quæsumus, verbo et exemplo, quibus præest, proficere; ut ad vitam, una cum grege sibi credito, perveniat sempiternam. Per Christum Dominum nostrum. Amen.","fr":"℣. Prions pour notre Souverain Pontife N.\n℟. Que le Seigneur le garde, qu’il lui conserve la vie, qu’il le rende heureux sur la terre et ne le livre pas à la volonté de ses ennemis.\n\n℣. Vous êtes Pierre.\n℟. Et sur cette pierre je bâtirai mon Église.\n\nPrions. Ô Dieu, pasteur et guide de tous les fidèles, regardez avec bienveillance votre serviteur N., que vous avez placé comme pasteur à la tête de votre Église. Accordez-lui, nous vous en prions, de faire progresser, par sa parole et son exemple, ceux qu’il gouverne, afin qu’il parvienne à la vie éternelle avec le troupeau qui lui a été confié. Par Jésus-Christ Notre-Seigneur. Ainsi soit-il.","source":"Roman Rite prayer for the Supreme Pontiff","sourceUrl":"https://www.vaticannews.va/en/prayers/prayer-for-the-pope.html","note":"","category":"saints","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":true,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Prayer for the Pope","witness":"Vatican News / Roman Missal prayer","url":"https://www.vaticannews.va/en/prayers/prayer-for-the-pope.html","quality":"VERIFIED_PRIMARY","visibility":1,"adaptation":"TRADITIONAL_LITURGICAL_FORM","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_SECONDARY"},"note":"The app retains the traditional Tu es Petrus versicle alongside the collect."},"sourceAuditVersion":"35.7"},"devotion_st_anthony_lost_items":{"id":"devotion_st_anthony_lost_items","title":"Si quæris miracula — St Anthony for Lost Things","titleFr":"Si quæris miracula — saint Antoine et les objets perdus","en":"℟. If, then, thou seekest miracles,\nDeath, error, all calamities,\nThe leprosy and demons flee,\nThe sick, by him made whole, arise.\n* The sea withdraws and fetters break,\nAnd withered limbs he doth restore,\nWhile treasures lost are found again,\nWhen young or old his help implore.\n\n℣. All dangers vanish from our path,\nOur direst needs do quickly flee:\nLet those who know repeat the theme:\nLet Paduans praise St. Anthony.\n* The sea withdraws and fetters break,\nAnd withered limbs he doth restore,\nWhile treasures lost are found again,\nWhen young or old his help implore.\n\nTo the Father, Son let glory be,\nAnd Holy Ghost eternally.\n* The sea withdraws and fetters break,\nAnd withered limbs he doth restore,\nWhile treasures lost are found again,\nWhen young or old his help implore.\n\n℣. Pray for us, O blessed Anthony.\n℟. That we may be made worthy of the promises of Christ.\n\nLet us pray.\nLet Thy Church, O God, be gladdened by the solemn commemoration of blessed Anthony Thy Confessor: that she may be evermore defended by Thy spiritual assistance and merit to possess everlasting joy. Through Christ our Lord. Amen.","la":"℟. Si quæris miracula,\nMors, error, calamitas,\nDæmon, lepra fugiunt,\nÆgri surgunt sani.\n* Cedunt mare, vincula;\nMembra resque perditas\nPetunt et accipiunt\nIuvenes et cani.\n\n℣. Pereunt pericula,\nCessat et necessitas:\nNarrent hi qui sentiunt,\nDicant Paduani.\n* Cedunt mare, vincula;\nMembra resque perditas\nPetunt et accipiunt\nIuvenes et cani.\n\nGloria Patri et Filio et Spiritui Sancto.\n* Cedunt mare, vincula;\nMembra resque perditas\nPetunt et accipiunt\nIuvenes et cani.\n\n℣. Ora pro nobis, beate Antoni.\n℟. Ut digni efficiamur promissionibus Christi.\n\nOremus.\nEcclesiam tuam, Deus, beati Antonii Confessoris tui commemoratio votiva lætificet: ut spiritualibus semper muniatur auxiliis et gaudiis perfrui mereatur æternis. Per Christum Dominum nostrum. Amen.","fr":"℟. Si vous cherchez des miracles,\nla mort, l’erreur, le malheur,\nle démon, la lèpre, s’enfuient ;\nles malades se lèvent guéris.\n* On voit céder la mer, et les chaînes se briser,\njeunes et vieux\nretrouver par la prière\nl’usage de leurs membres et les objets perdus.\n\n℣. Les dangers s’évanouissent,\nle besoin cesse :\nà ceux qui l’éprouvent de le raconter,\naux Padouans de le dire.\n* On voit céder la mer, et les chaînes se briser,\njeunes et vieux\nretrouver par la prière\nl’usage de leurs membres et les objets perdus.\n\nGloire au Père et au Fils et au Saint-Esprit.\n* On voit céder la mer, et les chaînes se briser,\njeunes et vieux\nretrouver par la prière\nl’usage de leurs membres et les objets perdus.\n\n℣. Priez pour nous, saint Antoine.\n℟. Afin que nous soyons rendus dignes des promesses de Jésus-Christ.\n\nPrions.\nQue la mémoire faite par nous du bienheureux Antoine votre confesseur soit pour votre Église, ô Dieu, une cause de joie ; qu’elle y trouve l’appui constant de vos grâces, et l’assurance du bonheur éternel. Par Jésus-Christ notre Seigneur. Ainsi soit-il.","source":"Si quæris miracula · Franciscan Office tradition · Raccolta no. 531","sourceUrl":"https://www.preces-latinae.org/thesaurus/Sancti/SAntoniusDePadova/SiQuaeris.html","note":"The inherited later prayer has been replaced by the historic miraculous responsory. Its text itself invokes the recovery of resque perditas / lost things; the Latin-English witness is Raccolta-attested, and the French witness follows the traditional parallel text.","category":"saints","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":true,"sourceStatus":"VERIFIED_SECONDARY","provenance":{"work":"Si quæris miracula","witness":"Historic miraculous responsory of St Anthony · Raccolta no. 531","url":"https://www.preces-latinae.org/thesaurus/Sancti/SAntoniusDePadova/SiQuaeris.html","quality":"VERIFIED_SECONDARY","visibility":1,"adaptation":"VERBATIM","languages":{"en":"VERIFIED_SECONDARY","la":"VERIFIED_SECONDARY","fr":"VERIFIED_SECONDARY"},"note":"Latin and English follow the historic responsory witness; French follows the traditional parallel text published by Introibo.","frenchWitnessUrl":"https://introibo.fr/13-06-St-Antoine-de-Padoue"},"sourceAuditVersion":"41.4"},"sacred_heart_short_prayer":{"id":"sacred_heart_short_prayer","title":"Act of Reparation to the Sacred Heart of Jesus","titleFr":"Acte de réparation au Sacré-Cœur de Jésus","en":"Most Sweet Jesus, whose overflowing charity for men is requited by so much forgetfulness, negligence and contempt, behold us prostrate before Thee, eager to repair by a special act of homage the cruel indifference and injuries to which Thy loving Heart is everywhere subjected.\n\nMindful, alas, that we ourselves have had a share in such great indignities, which we now deplore from the depths of our hearts, we humbly ask Thy pardon and declare our readiness to atone by voluntary expiation, not only for our own personal offenses, but also for the sins of those who, straying far from the path of salvation, refuse in their obstinate infidelity to follow Thee, their Shepherd and Leader, or, renouncing the promises of their baptism, have cast off the sweet yoke of Thy Law.\n\nWe are now resolved to expiate each and every deplorable outrage committed against Thee; we are now determined to make amends for the manifold offenses against Christian modesty in unbecoming dress and behavior, for all the foul seductions laid to ensnare the feet of the innocent, for the frequent violations of Sundays and holydays, and the shocking blasphemies uttered against Thee and Thy Saints. We wish also to make amends for the insults to which Thy Vicar on earth and Thy priests are subjected, for the profanation, by conscious neglect or terrible acts of sacrilege, of the very Sacrament of Thy Divine Love, and lastly for the public crimes of nations who resist the rights and teaching authority of the Church which Thou hast founded.\n\nWould that we were able to wash away such abominations with our blood.\n\nWe now offer, in reparation for these violations of Thy Divine Honor, the satisfaction Thou once made to Thy Eternal Father on the Cross and which Thou continuest to renew daily on our altars; we offer it in union with the acts of atonement of Thy Virgin Mother and all the Saints and of the pious faithful on earth; and we sincerely promise to make recompense, as far as we can with the help of Thy grace, for all neglect of Thy great love and for the sins we and others have committed in the past. Henceforth, we will live a life of unswerving faith, of purity of conduct, of perfect observance of the precepts of the Gospel and especially that of charity. We promise to the best of our power to prevent others from offending Thee and to bring as many as possible to follow Thee.\n\nO loving Jesus, through the intercession of the Blessed Virgin Mother, our model in reparation, deign to receive the voluntary offering we make of this act of expiation; and by the crowning gift of perseverance keep us faithful unto death in our duty and the allegiance we owe to Thee, so that we may all one day come to that happy home, where with the Father and the Holy Spirit Thou livest and reignest, God, forever and ever. Amen.","la":"Iesu dulcissime, cuius effusa in homines caritas, tanta oblivione, neglegentia, contemptione, ingratissime rependitur, en nos, ante conspectum tuum provoluti, tam nefariam hominum socordiam iniuriasque, quibus undique amantissimum Cor tuum afficitur, peculiari honore resarcire contendimus.\n\nAttamen, memores tantae nos quoque indignitatis non expertes aliquando fuisse, indeque vehementissimo dolore commoti, tuam in primis misericordiam nobis imploramus, parati, voluntaria expiatione compensare flagitia non modo quae ipsi patravimus, sed etiam illorum, qui, longe a salutis via aberrantes vel te pastorem ducemque sectari detrectant, in sua infidelitate obstinati, vel, baptismatis promissa conculcantes, suavissimum tuae legis iugum excusserunt.\n\nQuae deploranda crimina, cum universa expiare contendimus, tum nobis singula resarcienda proponimus: vitae cultusque immodestiam atque turpitudines, tot corruptelae pedicas innocentium animis instructas, dies festos violatos, exsecranda in te tuosque Sanctos iactata maledicta atque in tuum Vicarium ordinemque sacerdotalem convicia irrogata, ipsum denique amoris divini Sacramentum vel neglectum vel horrendis sacrilegiis profanatum, publica postremo nationum delicta, quae Ecclesiae a te institutae iuribus magisterioque reluctantur.\n\nQuae utinam crimina sanguine ipsi nostro eluere possemus! Interea ad violatum divinum honorem resarciendum, quam Tu olim Patri in Cruce satisfactionem obtulisti quamque cotidie in altaribus renovare pergis, hanc eamdem nos tibi praestamus, cum Virginis Matris, omnium Sanctorum, piorum quoque fidelium expiationibus coniunctam, ex animo spondentes, cum praeterita nostra aliorumque peccata ac tanti amoris incuriam firma fide, candidis vitae moribus, perfecta legis evangelicae, caritatis potissimum, observantia, quantum in nobis erit, gratia tua favente, nos esse compensaturos, tum iniurias tibi inferendas pro viribus prohibituros, et quam plurimos potuerimus ad tui sequelam convocaturos.\n\nExcipias, quaesumus, benignissime Iesu, beata Virgine Maria Reparatrice intercedente, voluntarium huius expiationis obsequium nosque in officio tuique servitio fidissimos ad mortem usque velis, magno illo perseverantiae munere, continere, ut ad illam tandem patriam perveniamus omnes, ubi Tu cum Patre et Spiritu Sancto vivis et regnas in saecula saeculorum. Amen.","fr":"Très doux Jésus, dont l’immense amour pour les hommes a été avec tant d’ingratitude payé par l’oubli, la négligence, le mépris, voici que, prosternés devant vos autels, nous voulons réparer par des témoignages particuliers d’honneur une froideur si indigne et les injures qui blessent de toutes parts votre Cœur très aimant.\n\nNous souvenant toutefois que nous n’avons pas toujours été, nous non plus, exempts de cette indignité et en ressentant une très profonde douleur, nous implorons tout d’abord sur nous votre miséricorde, disposés à réparer par une expiation volontaire non seulement les péchés que nous avons commis nous-mêmes, mais encore les fautes de ceux qui, égarés loin de la voie du salut, refusent de vous suivre comme leur pasteur et leur guide, s’obstinant dans leur infidélité, ou qui, reniant les promesses de leur baptême, ont secoué le joug très suave de votre loi.\n\nCes crimes déplorables que nous voulons expier tous, nous nous proposons aussi de les réparer chacun en particulier : l’immodestie et les hontes de la conduite et des vêtements ; les embûches tendues par la corruption aux âmes innocentes, la violation des fêtes, les outrages odieux lancés contre vous et vos saints, ainsi que les insultes adressées à votre Vicaire et à l’ordre sacerdotal, la négligence à l’égard du Sacrement du divin amour ou sa profanation par d’horribles sacrilèges, enfin les crimes publics des nations qui combattent les droits et le magistère de l’Église que vous avez instituée.\n\nQue ne nous est-il donné de pouvoir laver ces crimes de notre sang ! Pour réparer l’honneur divin outragé, nous vous présentons, unie aux expiations de la Vierge Marie, de tous les saints et des fidèles pieux, l’expiation que vous avez un jour offerte au Père sur la croix et que vous continuez de renouveler chaque jour sur les autels ; nous vous promettons de tout notre Cœur de réparer pour autant qu’il sera en nous et avec le secours de votre grâce nos fautes passées comme celles des autres et une si grande négligence de votre amour par une foi inébranlable, par une vie pure, par l’observation parfaite de la loi évangélique, en particulier de la charité, d’empêcher selon nos forces les offenses qui s’adresseraient à vous et d’amener le plus d’hommes possible à votre suite.\n\nTrès bon Jésus, recevez, nous vous en prions, par l’intercession de la bienheureuse Vierge Marie Réparatrice, l’hommage volontaire de notre expiation et daignez, par le don précieux de la persévérance, nous garder fidèles jusqu’à la mort dans votre obéissance et votre service, afin que nous parvenions enfin tous à cette patrie où vous vivez et régnez, vrai Dieu, avec le Père et l’Esprit-Saint, dans les siècles des siècles. Ainsi soit-il.","source":"Pius XI · Miserentissimus Redemptor · Act of Reparation · 1928","sourceUrl":"https://www.vatican.va/roman_curia/tribunals/apost_penit/documents/rc_trib_appen_doc_20020826_enchiridion-indulgentiarum_lt.html","note":"The inherited short prayer and doubtful Raccolta numbering have been replaced by the officially promulgated Iesu dulcissime Act of Reparation. Latin follows the Vatican Enchiridion; English and French use established Catholic translations.","category":"hearts","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":true,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Iesu dulcissime · Actus reparationis","witness":"Apostolic Penitentiary · Enchiridion Indulgentiarum; prayer prescribed by Pius XI","url":"https://www.vatican.va/roman_curia/tribunals/apost_penit/documents/rc_trib_appen_doc_20020826_enchiridion-indulgentiarum_lt.html","quality":"VERIFIED_PRIMARY","visibility":1,"adaptation":"VERBATIM","languages":{"en":"VERIFIED_SECONDARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_SECONDARY"},"note":"Latin is the official Vatican text. English follows an established traditional Catholic translation; French follows the ICRSP text associated with Pius XI’s Miserentissimus Redemptor.","englishWitnessUrl":"https://www.carmelitesofrochester.org/act-of-reparation-to-the-sacred-heart","frenchWitnessUrl":"https://www.icrsp.org/Pages/magistere.php?groupe=Pie+XI&nom=miserentissimus-deus"},"sourceAuditVersion":"41.4"},"sacred_heart_aspiration_trust":{"id":"sacred_heart_aspiration_trust","title":"Sacred Heart Aspiration","titleFr":"Aspiration au Sacré-Cœur","en":"Most Sacred Heart of Jesus, I place all my trust in you.","la":"Cor Iesu sacratissimum, in te confido.","fr":"Cœur Sacré de Jésus, j’ai confiance en toi.","source":"","sourceUrl":"","note":"","category":"hearts","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":false,"sourceStatus":"VERIFIED_SECONDARY","provenance":{"work":"Sacred Heart aspiration","witness":"Widely attested devotional aspiration; USCCB Sacred Heart novena witness","url":"https://www.usccb.org/novena-sacred-heart-jesus","quality":"VERIFIED_SECONDARY","visibility":0,"adaptation":"TRADITIONAL_VARIANT","languages":{"en":"VERIFIED_SECONDARY","la":"VERIFIED_SECONDARY","fr":"VERIFIED_SECONDARY"},"note":"Short aspiration; visible source suppressed."},"sourceAuditVersion":"35.7"},"foundations_eternal_rest":{"id":"foundations_eternal_rest","title":"Eternal Rest (Requiem)","titleFr":"Repos éternel","en":"Eternal rest grant unto them, O Lord, and let perpetual light shine upon them. May they rest in peace. Amen.","la":"Requiem aeternam dona eis, Domine, et lux perpetua luceat eis. Requiescant in pace. Amen.","fr":"Donne-leur, Seigneur, le repos éternel, et que la lumière éternelle brille sur eux. Qu’ils reposent en paix. Amen.","source":"","sourceUrl":"","note":"","category":"dead","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":false,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Eternal Rest","witness":"Compendium of the Catechism of the Catholic Church · Appendix A","url":"https://www.vatican.va/archive/compendium_ccc/documents/archive_2005_compendium-ccc_en.html","quality":"VERIFIED_PRIMARY","visibility":0,"adaptation":"VERBATIM","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_PRIMARY"},"note":"Common prayer; provenance retained internally and not shown by default."},"sourceAuditVersion":"35.7"},"dead_de_profundis":{"id":"dead_de_profundis","title":"De Profundis — Psalm 129","titleFr":"De profundis · Psaume 129","en":"Out of the depths I have cried to thee, O Lord: Lord, hear my voice. Let thine ears be attentive to the voice of my supplication. If thou, O Lord, wilt mark iniquities: Lord, who shall stand it? For with thee there is merciful forgiveness; and by reason of thy law I have waited for thee, O Lord. My soul hath relied on his word; my soul hath hoped in the Lord. From the morning watch even until night, let Israel hope in the Lord. Because with the Lord there is mercy, and with him plentiful redemption. And he shall redeem Israel from all his iniquities.\n\n℣. Eternal rest grant unto them, O Lord.\n℟. And let perpetual light shine upon them.\n\n℣. May they rest in peace.\n℟. Amen.","la":"De profundis clamavi ad te, Domine; Domine, exaudi vocem meam. Fiant aures tuæ intendentes in vocem deprecationis meæ. Si iniquitates observaveris, Domine, Domine, quis sustinebit? Quia apud te propitiatio est; et propter legem tuam sustinui te, Domine. Sustinuit anima mea in verbo eius; speravit anima mea in Domino. A custodia matutina usque ad noctem, speret Israel in Domino. Quia apud Dominum misericordia, et copiosa apud eum redemptio. Et ipse redimet Israel ex omnibus iniquitatibus eius.\n\n℣. Requiem æternam dona eis, Domine.\n℟. Et lux perpetua luceat eis.\n\n℣. Requiescant in pace.\n℟. Amen.","fr":"Des profondeurs, je crie vers vous, Seigneur; Seigneur, écoutez ma voix. Que vos oreilles soient attentives à la voix de ma supplication. Si vous retenez les iniquités, Seigneur, Seigneur, qui pourra subsister? Mais auprès de vous se trouve le pardon; à cause de votre loi, je vous ai attendu, Seigneur. Mon âme s’est appuyée sur sa parole; mon âme a espéré dans le Seigneur. Depuis la veille du matin jusqu’à la nuit, qu’Israël espère dans le Seigneur. Car auprès du Seigneur est la miséricorde, et auprès de lui une abondante rédemption. C’est lui qui rachètera Israël de toutes ses iniquités.\n\n℣. Donnez-leur, Seigneur, le repos éternel.\n℟. Et que la lumière perpétuelle luise sur eux.\n\n℣. Qu’ils reposent en paix.\n℟. Ainsi soit-il.","source":"","sourceUrl":"","note":"","category":"dead","implementationOrigin":"Lab-ora RC50.1 · inherited traditional prayer corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":false,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"De Profundis · Psalm 129 (Vulgate)","witness":"F. X. Lasance · With God · Evening Prayers","url":"https://en.wikisource.org/wiki/With_God/Evening_Prayers","quality":"VERIFIED_PRIMARY","visibility":0,"adaptation":"TYPOGRAPHY_NORMALIZED","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_SECONDARY"},"note":"Psalm and traditional prayers for the faithful departed."},"sourceAuditVersion":"35.7"},"devotion_litany_st_joseph":{"id":"devotion_litany_st_joseph","title":"Litany of Saint Joseph","titleFr":"Litanies de saint Joseph","en":"Lord, have mercy.\nChrist, have mercy.\nLord, have mercy.\n\nChrist, hear us.\nChrist, graciously hear us.\n\nGod the Father in heaven, have mercy on us.\nGod the Son, Redeemer of the world, have mercy on us.\nGod the Holy Spirit, have mercy on us.\nHoly Trinity, one God, have mercy on us.\n\nHoly Mary, pray for us.\nSaint Joseph, pray for us.\nIllustrious son of David, pray for us.\nLight of Patriarchs, pray for us.\nSpouse of the Mother of God, pray for us.\nGuardian of the Redeemer, pray for us.\nPure Guardian of the Virgin, pray for us.\nProvider for the Son of God, pray for us.\nZealous defender of Christ, pray for us.\nServant of Christ, pray for us.\nMinister of salvation, pray for us.\nHead of the Holy Family, pray for us.\nJoseph, most just, pray for us.\nJoseph, most chaste, pray for us.\nJoseph, most prudent, pray for us.\nJoseph, most brave, pray for us.\nJoseph, most obedient, pray for us.\nJoseph, most loyal, pray for us.\nMirror of patience, pray for us.\nLover of poverty, pray for us.\nModel for workers, pray for us.\nGlory of family life, pray for us.\nGuardian of virgins, pray for us.\nCornerstone of families, pray for us.\nSupport in difficulties, pray for us.\nComfort of the sorrowing, pray for us.\nHope of the sick, pray for us.\nPatron of exiles, pray for us.\nPatron of the afflicted, pray for us.\nPatron of the poor, pray for us.\nPatron of the dying, pray for us.\nTerror of demons, pray for us.\nProtector of the Holy Church, pray for us.\n\nLamb of God, you take away the sins of the world, spare us, O Lord.\nLamb of God, you take away the sins of the world, hear us, O Lord.\nLamb of God, you take away the sins of the world, have mercy on us.\n\n℣. He made him master of his house.\n℟. And ruler of all his possessions.\n\nLet us pray.\nO God, who in your inexpressible providence were pleased to choose Saint Joseph as spouse of your most holy Mother, grant, we pray, that we, who revere him as our protector on earth, may be worthy of his heavenly intercession. Who live and reign for ever and ever.\n℟. Amen.","la":"Kyrie, eleison.\nChriste, eleison.\nKyrie, eleison.\nChriste, audi nos.\nChriste, exaudi nos.\n\nPater de cælis, Deus, miserere nobis.\nFili, Redemptor mundi, Deus, miserere nobis.\nSpiritus Sancte, Deus, miserere nobis.\nSancta Trinitas, unus Deus, miserere nobis.\n\nSancta Maria, ora pro nobis.\nSancte Ioseph, ora pro nobis.\nProles David inclita, ora pro nobis.\nLumen Patriarcharum, ora pro nobis.\nDei Genetricis Sponse, ora pro nobis.\nCustos Redemptoris, ora pro nobis.\nCustos pudice Virginis, ora pro nobis.\nFilii Dei nutricie, ora pro nobis.\nChristi defensor sedule, ora pro nobis.\nServe Christi, ora pro nobis.\nMinister salutis, ora pro nobis.\nAlmæ Familiæ præses, ora pro nobis.\nIoseph iustissime, ora pro nobis.\nIoseph castissime, ora pro nobis.\nIoseph prudentissime, ora pro nobis.\nIoseph fortissime, ora pro nobis.\nIoseph obœdientissime, ora pro nobis.\nIoseph fidelissime, ora pro nobis.\nSpeculum patientiæ, ora pro nobis.\nAmator paupertatis, ora pro nobis.\nExemplar opificum, ora pro nobis.\nDecus vitæ domesticæ, ora pro nobis.\nCustos virginum, ora pro nobis.\nFamiliarum columen, ora pro nobis.\nFulcimen in difficultatibus, ora pro nobis.\nSolatium miserorum, ora pro nobis.\nSpes ægrotantium, ora pro nobis.\nPatrone exsulum, ora pro nobis.\nPatrone afflictorum, ora pro nobis.\nPatrone pauperum, ora pro nobis.\nPatrone morientium, ora pro nobis.\nTerror dæmonum, ora pro nobis.\nProtector sanctæ Ecclesiæ, ora pro nobis.\n\nAgnus Dei, qui tollis peccata mundi, parce nobis, Domine.\nAgnus Dei, qui tollis peccata mundi, exaudi nos, Domine.\nAgnus Dei, qui tollis peccata mundi, miserere nobis.\n\n℣. Constituit eum dominum domus suæ.\n℟. Et principem omnis possessionis suæ.\n\nOremus. Deus, qui ineffabili providentia beatum Ioseph sanctissimæ Genetricis tuæ Sponsum eligere dignatus es: præsta, quæsumus; ut quem protectorem veneramur in terris, intercessorem habere mereamur in cælis. Qui vivis et regnas in sæcula sæculorum. Amen.","fr":"Seigneur, ayez pitié de nous.\nJésus-Christ, ayez pitié de nous.\nSeigneur, ayez pitié de nous.\nJésus-Christ, écoutez-nous.\nJésus-Christ, exaucez-nous.\n\nPère céleste, qui êtes Dieu, ayez pitié de nous.\nFils, Rédempteur du monde, qui êtes Dieu, ayez pitié de nous.\nEsprit-Saint, qui êtes Dieu, ayez pitié de nous.\nTrinité Sainte, qui êtes un seul Dieu, ayez pitié de nous.\n\nSainte Marie, priez pour nous.\nSaint Joseph, priez pour nous.\nIllustre descendant de David, priez pour nous.\nLumière des Patriarches, priez pour nous.\nÉpoux de la Mère de Dieu, priez pour nous.\nGardien du Rédempteur, priez pour nous.\nChaste gardien de la Vierge, priez pour nous.\nNourricier du Fils de Dieu, priez pour nous.\nZélé défenseur de Jésus, priez pour nous.\nServiteur du Christ, priez pour nous.\nMinistre du Salut, priez pour nous.\nChef de la Sainte Famille, priez pour nous.\nJoseph très juste, priez pour nous.\nJoseph très chaste, priez pour nous.\nJoseph très prudent, priez pour nous.\nJoseph très courageux, priez pour nous.\nJoseph très obéissant, priez pour nous.\nJoseph très fidèle, priez pour nous.\nMiroir de patience, priez pour nous.\nAmi de la pauvreté, priez pour nous.\nModèle des travailleurs, priez pour nous.\nGloire de la vie de famille, priez pour nous.\nGardien des vierges, priez pour nous.\nSoutien des familles, priez pour nous.\nSoutien dans les difficultés, priez pour nous.\nConsolation des malheureux, priez pour nous.\nEspérance des malades, priez pour nous.\nPatron des exilés, priez pour nous.\nPatron des affligés, priez pour nous.\nPatron des pauvres, priez pour nous.\nPatron des mourants, priez pour nous.\nTerreur des démons, priez pour nous.\nProtecteur de la sainte Église, priez pour nous.\n\nAgneau de Dieu, qui effacez les péchés du monde, pardonnez-nous, Seigneur.\nAgneau de Dieu, qui effacez les péchés du monde, exaucez-nous, Seigneur.\nAgneau de Dieu, qui effacez les péchés du monde, ayez pitié de nous.\n\n℣. Il l'a établi le chef de sa maison.\n℟. Et l'intendant de tous ses biens.\n\nPrions. Ô Dieu, qui, par une providence ineffable, avez daigné choisir le bienheureux Joseph pour être l'époux de votre sainte Mère, faites, nous vous en prions, que, l'honorant ici-bas comme protecteur, nous méritions de l'avoir pour intercesseur dans le ciel. Vous qui vivez et régnez dans les siècles des siècles. Ainsi soit-il.","category":"saints","source":"Current 2021 invocation set. English: AELF Committee on Divine Worship approved translation, freely publishable. Latin: Holy See current text. French: retained as a traditional vernacular rendering with the seven 2021 titles; not represented as an episcopal-conference official recension pending exact source lock.","sourceUrl":"https://www.usccb.org/prayers/litany-saint-joseph","note":""},"devotion_ad_te_beate_ioseph":{"id":"devotion_ad_te_beate_ioseph","title":"To Thee, O Blessed Joseph","titleFr":"À vous, bienheureux Joseph","en":"To thee, O blessed Joseph, we have recourse in our affliction, and having implored the help of thy thrice holy Spouse, we now, with hearts filled with confidence, earnestly beg thee also to take us under thy protection.\n\nBy that charity wherewith thou wert united to the Immaculate Virgin Mother of God, and by that fatherly love with which thou didst cherish the Child Jesus, we beseech thee and we humbly pray that thou wilt look down with gracious eye upon that inheritance which Jesus Christ purchased by His blood, and wilt succor us in our need by thy power and strength.\n\nDefend, O most watchful guardian of the Holy Family, the chosen offspring of Jesus Christ. Keep from us, O most loving Father, all blight of error and corruption. Aid us from on high, most valiant defender, in this conflict with the powers of darkness. And even as of old thou didst rescue the Child Jesus from the peril of His life, so now defend God's Holy Church from the snares of the enemy and from all adversity.\n\nShield us ever under thy patronage, that, following thine example and strengthened by thy help, we may live a holy life, die a happy death, and attain to everlasting bliss in Heaven. Amen.","la":"Ad te, beate Ioseph, in tribulatione nostra confugimus, atque, implorato Sponsæ tuæ sanctissimæ auxilio, patrocinium quoque tuum fidenter exposcimus.\n\nPer eam, quæsumus, quæ te cum immaculata Virgine Dei Genetrice coniunxit, caritatem, perque paternum, quo Puerum Iesum amplexus es, amorem, supplices deprecamur, ut ad hereditatem, quam Iesus Christus acquisivit Sanguine suo, benignus respicias, ac necessitatibus nostris tua virtute et ope succurras.\n\nTuere, o Custos providentissime divinæ Familiæ, Iesu Christi sobolem electam; prohibe a nobis, amantissime Pater, omnem errorum ac corruptelarum luem; propitius nobis, sospitator noster fortissime, in hoc cum potestate tenebrarum certamine e cælo adesto; et sicut olim Puerum Iesum e summo eripuisti vitæ discrimine, ita nunc Ecclesiam sanctam Dei ab hostilibus insidiis atque ab omni adversitate defende: nosque singulos perpetuo tege patrocinio, ut ad tui exemplar et ope tua suffulti, sancte vivere, pie emori, sempiternamque in cælis beatitudinem assequi possimus. Amen.","fr":"Nous recourons à vous dans notre tribulation, ô bienheureux Joseph : et, après avoir imploré le secours de votre sainte Épouse, nous sollicitons aussi avec confiance votre patronage.\n\nPar l’affection qui vous a uni à la Vierge Immaculée, Mère de Dieu ; par l’amour paternel dont vous avez entouré l’Enfant-Jésus, nous vous supplions de regarder avec bonté l’héritage que Jésus-Christ a conquis au prix de son sang, et de nous assister de votre puissance et de votre secours dans nos besoins.\n\nProtégez, ô très sage gardien de la divine Famille, la race élue de Jésus-Christ. Préservez-nous, ô Père très aimant, de toute souillure d’erreur et de corruption ; soyez-nous favorable, ô notre très puissant libérateur. Du haut du ciel, assistez-nous dans le combat que nous livrons à la puissance des ténèbres ; et de même que vous avez arraché autrefois l’Enfant-Jésus au péril de la mort, défendez aujourd’hui la sainte Église de Dieu des embûches de l’ennemi et de toute adversité.\n\nCouvrez chacun de nous de votre perpétuelle protection, afin que, à votre exemple et soutenus par votre secours, nous puissions vivre saintement, pieusement mourir, et obtenir la béatitude éternelle. Ainsi soit-il.","category":"saints","source":"Prayer attached by Leo XIII to Quamquam pluries (1889). Latin is retained as the canonical traditional text; English follows the historical Holy See translation; French follows a historical Catholic translation.","sourceUrl":"https://www.vatican.va/content/leo-xiii/en/encyclicals/documents/hf_l-xiii_enc_15081889_quamquam-pluries.html","note":""},"traditional_veni_sancte_sequence":{"id":"traditional_veni_sancte_sequence","title":"Veni Sancte Spiritus · Pentecost Sequence","titleFr":"Veni Sancte Spiritus","en":"Holy Spirit! Lord of light!\nFrom Thy clear celestial height,\nThy pure beaming radiance give.\n\nCome, Thou Father of the poor!\nCome, with treasures which endure!\nCome, Thou Light of all that live!\n\nThou, of all consolers best,\nVisiting the troubled breast,\nDost refreshing peace bestow.\n\nThou in toil art comfort sweet;\nPleasant coolness in the heat;\nSolace in the midst of woe.\n\nLight immortal! Light Divine!\nVisit Thou these hearts of Thine,\nAnd our inmost being fill.\n\nIf Thou take Thy grace away,\nNothing pure in man will stay;\nAll his good is turned to ill.\n\nHeal our wounds—our strength renew;\nOn our dryness pour Thy dew;\nWash the stains of guilt away.\n\nBend the stubborn heart and will;\nMelt the frozen, warm the chill;\nGuide the steps that go astray.\n\nThou, on those who evermore\nThee confess and Thee adore,\nIn Thy sevenfold gifts, descend.\n\nGive them comfort when they die;\nGive them life with Thee on high;\nGive them joys which never end. Amen.","la":"Veni, Sancte Spiritus,\net emitte cælitus\nlucis tuæ radium.\n\nVeni, Pater pauperum,\nveni, dator munerum,\nveni, lumen cordium.\n\nConsolator optime,\ndulcis hospes animæ,\ndulce refrigerium.\n\nIn labore requies,\nin æstu temperies,\nin fletu solatium.\n\nO lux beatissima,\nreple cordis intima\ntuorum fidelium.\n\nSine tuo numine\nnihil est in homine,\nnihil est innoxium.\n\nLava quod est sordidum,\nriga quod est aridum,\nsana quod est saucium.\n\nFlecte quod est rigidum,\nfove quod est frigidum,\nrege quod est devium.\n\nDa tuis fidelibus\nin te confidentibus\nsacrum septenarium.\n\nDa virtutis meritum,\nda salutis exitum,\nda perenne gaudium. Amen.","fr":"Viens, Esprit-Saint,\net lance du ciel\nun rayon de tes feux.\n\nViens, Père des pauvres,\nviens, distributeur des trésors,\nviens, lumière des cœurs.\n\nConsolateur par excellence,\nhôte aimable des âmes,\ndoux rafraîchissement.\n\nRepos dans le travail,\nzéphyr dans la chaleur,\nsoulagement dans les pleurs.\n\nÔ lumière bienheureuse,\nremplis de tes douceurs\nles cœurs de tes fidèles.\n\nSans ton secours\nil n’y a rien dans l’homme,\nrien qui soit innocent.\n\nLave ce qui est sali,\narrose ce qui est aride,\nguéris ce qui est malade.\n\nRends souple ce qui est inflexible,\nréchauffe ce qui est glacé,\nredresse ce qui est dévié.\n\nDonne à tes fidèles\nqui se confient à toi\nles sept dons sacrés.\n\nDonne-nous le mérite de la vertu,\ndonne-nous la mort du juste,\ndonne-nous le bonheur éternel. Ainsi soit-il.","category":"holyghost","source":"Traditional Pentecost Sequence, also used devotionally to invoke the Holy Spirit. Latin is the received sequence; English is the public-domain Caswall translation printed in the 1857 Raccolta; French is a historical public-domain translation (Douniol, 1858).","sourceUrl":"https://en.wikisource.org/wiki/The_Raccolta_%281857%29/The_Hymn%2C_%22Veni_Creator_Spiritus%22%2C_and_the_Sequence%2C_%22Veni_Sancte_piritus%22","note":""},"dead_fidelium_deus":{"id":"dead_fidelium_deus","title":"Prayer for All the Faithful Departed","titleFr":"Prière pour tous les fidèles défunts","en":"O God, the Creator and Redeemer of all the faithful, grant to the souls of thy servants departed the remission of all their sins; that, through pious supplications, they may obtain the pardon which they have always desired: who livest and reignest, world without end. Amen.","la":"Fidelium Deus omnium, Conditor et Redemptor, animabus famulorum famularumque tuarum remissionem cunctorum tribue peccatorum: ut indulgentiam, quam semper optaverunt, piis supplicationibus consequantur. Qui vivis et regnas in sæcula sæculorum. Amen.","fr":"Ô Dieu, Créateur et Rédempteur de tous les fidèles, accordez aux âmes de vos serviteurs et de vos servantes la rémission de tous leurs péchés, afin que, par de pieuses supplications, elles obtiennent le pardon qu’elles ont toujours désiré. Vous qui vivez et régnez dans les siècles des siècles. Ainsi soit-il.","category":"dead","source":"Traditional Roman collect for all the faithful departed. English and French are historical Catholic translations; Latin is the received traditional text.","sourceUrl":"https://en.wikisource.org/wiki/The_Catholic_Prayer_Book_and_Manual_of_Meditations/Prayers_for_the_Dead","note":""},"dead_eternal_rest_singular":{"id":"dead_eternal_rest_singular","title":"Eternal Rest · for one deceased person","titleFr":"Repos éternel · pour un défunt","en":"Eternal rest grant unto him or her, O Lord, and let perpetual light shine upon him or her. May he or she rest in peace. Amen.","la":"Requiem æternam dona ei, Domine, et lux perpetua luceat ei. Requiescat in pace. Amen.","fr":"Donnez-lui, Seigneur, le repos éternel, et que la lumière perpétuelle l’illumine. Qu’il ou elle repose en paix. Ainsi soit-il.","category":"dead","source":"Traditional singular form of Requiem aeternam for one deceased person.","sourceUrl":"https://www.ctsbooks.org/prayers-for-the-dead/","note":""},"sub_tuum":{"id":"sub_tuum","title":"Sub Tuum Praesidium","titleFr":"Sous l’abri de votre miséricorde","category":"marian","source":"","sourceUrl":"","note":"","en":"We fly to your patronage, O holy Mother of God. Despise not our prayers in our necessities, but deliver us from all dangers, O ever glorious and Blessed Virgin.","la":"Sub tuum præsidium confugimus, sancta Dei Genetrix; nostras deprecationes ne despicias in necessitatibus nostris, sed a periculis cunctis libera nos semper, Virgo gloriosa et benedicta.","fr":"Sous l’abri de votre miséricorde, nous nous réfugions, sainte Mère de Dieu. Ne méprisez pas nos prières quand nous sommes dans l’épreuve, mais de tous les dangers délivrez-nous toujours, Vierge glorieuse et bénie.","implementationOrigin":"Ancient Marian antiphon · Lab-ora Rosary corpus","implementationOriginUrl":"https://fulcanelli13.github.io/lab-ora/","sourceVisible":false,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Sub tuum praesidium","witness":"Holy See Press Office · ancient Marian invocation","url":"https://press.vatican.va/content/salastampa/en/bollettino/pubblico/2018/09/29/180929d.html","quality":"VERIFIED_PRIMARY","visibility":0,"adaptation":"TRADITIONAL_TRANSLATION","languages":{"en":"VERIFIED_PRIMARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_SECONDARY"},"note":"Ancient Marian antiphon; no visible source needed in ordinary use."},"sourceAuditVersion":"35.7"},"benediction_adoremus_ps116":{"id":"benediction_adoremus_ps116","title":"Adoremus in aeternum · Psalm 116/117","titleFr":"Adorons à jamais · Psaume 116/117","category":"eucharistic","source":"Traditional Benediction","sourceUrl":"https://en.wikisource.org/wiki/Blessed_Sacrament_Book","note":"","en":"Let us adore for ever the Most Holy Sacrament.\n\nO praise the Lord, all ye nations: praise Him, all ye people.\nFor His mercy is confirmed upon us; and the truth of the Lord remaineth for ever.\n\nGlory be to the Father, and to the Son, and to the Holy Ghost.\nAs it was in the beginning, is now, and ever shall be. Amen.\n\nLet us adore for ever the Most Holy Sacrament.","la":"Adorémus in aetérnum sanctíssimum Sacraméntum.\n\nLaudáte Dóminum, omnes gentes: laudáte eum, omnes pópuli.\nQuóniam confirmáta est super nos misericórdia ejus: et véritas Dómini manet in aetérnum.\n\nGlória Patri, Fílio, et Spirítui Sancto.\nSicut erat in princípio, et nunc, et semper, et in sæcula sæculórum. Amen.\n\nAdorémus in aetérnum sanctíssimum Sacraméntum.","fr":"Adorons à jamais le Très Saint Sacrement.\n\nLouez le Seigneur tous les peuples, louez le Seigneur toutes les nations,\nsa miséricorde pour nous a été confirmée et la fidélité du Seigneur demeure à jamais.\n\nGloire au Père, et au Fils, et au Saint-Esprit.\nComme il était au commencement, maintenant et toujours, pour les siècles des siècles. Amen.\n\nAdorons à jamais le Très Saint Sacrement.","implementationOrigin":"Traditional Benediction/reposition corpus · imported from Lab-ora RC50.1","implementationOriginUrl":"https://laudatedominum.net/files/mis.pdf","sourceVisible":true,"sourceStatus":"VERIFIED_PRIMARY","provenance":{"work":"Adoremus in aeternum + Psalm 116","witness":"Lasance · Blessed Sacrament Book · 1913; traditional Benediction corpus","url":"https://en.wikisource.org/wiki/Blessed_Sacrament_Book","quality":"VERIFIED_PRIMARY","visibility":1,"adaptation":"TRADITIONAL_ASSEMBLY","languages":{"en":"VERIFIED_SECONDARY","la":"VERIFIED_PRIMARY","fr":"VERIFIED_SECONDARY"},"note":"The antiphon is directly witnessed by Lasance; Psalm 116/117 is the traditional accompanying psalm."},"sourceAuditVersion":"35.7"},"litany_loreto_1962":{"id":"litany_loreto_1962","title":"Litany of Loreto · 1962-era form","titleFr":"Litanies de Lorette · forme de 1962","category":"marian","source":"Holy See Litany of Loreto; 1962-era form omits later invocations","sourceUrl":"https://www.vatican.va/special/rosary/documents/litanie-lauretane_en.html","note":"Later invocations are shown separately so the older TLM-era form is not silently modernized.","en":"Lord, have mercy on us.\nChrist, have mercy on us.\nLord, have mercy on us.\nChrist, hear us.\nChrist, graciously hear us.\n\nGod the Father of Heaven, have mercy on us.\nGod the Son, Redeemer of the world, have mercy on us.\nGod the Holy Spirit, have mercy on us.\nHoly Trinity, one God, have mercy on us.\n\nHoly Mary — Pray for us.\nHoly Mother of God — Pray for us.\nHoly Virgin of virgins — Pray for us.\nMother of Christ — Pray for us.\nMother of divine grace — Pray for us.\nMother most pure — Pray for us.\nMother most chaste — Pray for us.\nMother inviolate — Pray for us.\nMother undefiled — Pray for us.\nMother most amiable — Pray for us.\nMother admirable — Pray for us.\nMother of good counsel — Pray for us.\nMother of our Creator — Pray for us.\nMother of our Saviour — Pray for us.\nVirgin most prudent — Pray for us.\nVirgin most venerable — Pray for us.\nVirgin most renowned — Pray for us.\nVirgin most powerful — Pray for us.\nVirgin most merciful — Pray for us.\nVirgin most faithful — Pray for us.\nMirror of justice — Pray for us.\nSeat of wisdom — Pray for us.\nCause of our joy — Pray for us.\nSpiritual vessel — Pray for us.\nVessel of honour — Pray for us.\nSingular vessel of devotion — Pray for us.\nMystical rose — Pray for us.\nTower of David — Pray for us.\nTower of ivory — Pray for us.\nHouse of gold — Pray for us.\nArk of the covenant — Pray for us.\nGate of heaven — Pray for us.\nMorning star — Pray for us.\nHealth of the sick — Pray for us.\nRefuge of sinners — Pray for us.\nComfort of the afflicted — Pray for us.\nHelp of Christians — Pray for us.\nQueen of Angels — Pray for us.\nQueen of Patriarchs — Pray for us.\nQueen of Prophets — Pray for us.\nQueen of Apostles — Pray for us.\nQueen of Martyrs — Pray for us.\nQueen of Confessors — Pray for us.\nQueen of Virgins — Pray for us.\nQueen of all Saints — Pray for us.\nQueen conceived without original sin — Pray for us.\nQueen assumed into heaven — Pray for us.\nQueen of the most holy Rosary — Pray for us.\nQueen of peace — Pray for us.\n\nLamb of God, who takest away the sins of the world, spare us, O Lord.\nLamb of God, who takest away the sins of the world, graciously hear us, O Lord.\nLamb of God, who takest away the sins of the world, have mercy on us.\n\n℣. Pray for us, O holy Mother of God.\n℟. That we may be made worthy of the promises of Christ.\n\nLet us pray. Grant, we beseech Thee, O Lord God, that we Thy servants may enjoy perpetual health of mind and body; and by the glorious intercession of blessed Mary, ever Virgin, may be delivered from present sorrow and enjoy eternal gladness. Through Christ our Lord. Amen.","la":"Kyrie, eleison.\nChriste, eleison.\nKyrie, eleison.\nChriste, audi nos.\nChriste, exaudi nos.\n\nPater de cælis, Deus, miserere nobis.\nFili, Redemptor mundi, Deus, miserere nobis.\nSpiritus Sancte, Deus, miserere nobis.\nSancta Trinitas, unus Deus, miserere nobis.\n\nSancta Maria — Ora pro nobis.\nSancta Dei Genetrix — Ora pro nobis.\nSancta Virgo virginum — Ora pro nobis.\nMater Christi — Ora pro nobis.\nMater divinæ gratiæ — Ora pro nobis.\nMater purissima — Ora pro nobis.\nMater castissima — Ora pro nobis.\nMater inviolata — Ora pro nobis.\nMater intemerata — Ora pro nobis.\nMater amabilis — Ora pro nobis.\nMater admirabilis — Ora pro nobis.\nMater boni consilii — Ora pro nobis.\nMater Creatoris — Ora pro nobis.\nMater Salvatoris — Ora pro nobis.\nVirgo prudentissima — Ora pro nobis.\nVirgo veneranda — Ora pro nobis.\nVirgo prædicanda — Ora pro nobis.\nVirgo potens — Ora pro nobis.\nVirgo clemens — Ora pro nobis.\nVirgo fidelis — Ora pro nobis.\nSpeculum iustitiæ — Ora pro nobis.\nSedes sapientiæ — Ora pro nobis.\nCausa nostræ lætitiæ — Ora pro nobis.\nVas spirituale — Ora pro nobis.\nVas honorabile — Ora pro nobis.\nVas insigne devotionis — Ora pro nobis.\nRosa mystica — Ora pro nobis.\nTurris Davidica — Ora pro nobis.\nTurris eburnea — Ora pro nobis.\nDomus aurea — Ora pro nobis.\nFœderis arca — Ora pro nobis.\nIanua cæli — Ora pro nobis.\nStella matutina — Ora pro nobis.\nSalus infirmorum — Ora pro nobis.\nRefugium peccatorum — Ora pro nobis.\nConsolatrix afflictorum — Ora pro nobis.\nAuxilium Christianorum — Ora pro nobis.\nRegina Angelorum — Ora pro nobis.\nRegina Patriarcharum — Ora pro nobis.\nRegina Prophetarum — Ora pro nobis.\nRegina Apostolorum — Ora pro nobis.\nRegina Martyrum — Ora pro nobis.\nRegina Confessorum — Ora pro nobis.\nRegina Virginum — Ora pro nobis.\nRegina Sanctorum omnium — Ora pro nobis.\nRegina sine labe originali concepta — Ora pro nobis.\nRegina in cælum assumpta — Ora pro nobis.\nRegina sacratissimi Rosarii — Ora pro nobis.\nRegina pacis — Ora pro nobis.\n\nAgnus Dei, qui tollis peccata mundi, parce nobis, Domine.\nAgnus Dei, qui tollis peccata mundi, exaudi nos, Domine.\nAgnus Dei, qui tollis peccata mundi, miserere nobis.\n\n℣. Ora pro nobis, sancta Dei Genetrix.\n℟. Ut digni efficiamur promissionibus Christi.\n\nOremus. Concede nos famulos tuos, quæsumus, Domine Deus, perpetua mentis et corporis sanitate gaudere: et gloriosa beatæ Mariæ semper Virginis intercessione, a præsenti liberari tristitia, et æterna perfrui lætitia. Per Christum Dominum nostrum. Amen.","fr":"Seigneur, ayez pitié de nous.\nJésus-Christ, ayez pitié de nous.\nSeigneur, ayez pitié de nous.\nJésus-Christ, écoutez-nous.\nJésus-Christ, exaucez-nous.\n\nPère céleste, qui êtes Dieu, ayez pitié de nous.\nFils, Rédempteur du monde, qui êtes Dieu, ayez pitié de nous.\nEsprit-Saint, qui êtes Dieu, ayez pitié de nous.\nTrinité Sainte, qui êtes un seul Dieu, ayez pitié de nous.\n\nSainte Marie — Priez pour nous.\nSainte Mère de Dieu — Priez pour nous.\nSainte Vierge des vierges — Priez pour nous.\nMère du Christ — Priez pour nous.\nMère de la divine grâce — Priez pour nous.\nMère très pure — Priez pour nous.\nMère très chaste — Priez pour nous.\nMère toujours vierge — Priez pour nous.\nMère sans tache — Priez pour nous.\nMère très aimable — Priez pour nous.\nMère admirable — Priez pour nous.\nMère du bon conseil — Priez pour nous.\nMère du Créateur — Priez pour nous.\nMère du Sauveur — Priez pour nous.\nVierge très prudente — Priez pour nous.\nVierge vénérable — Priez pour nous.\nVierge digne de louange — Priez pour nous.\nVierge puissante — Priez pour nous.\nVierge clémente — Priez pour nous.\nVierge fidèle — Priez pour nous.\nMiroir de justice — Priez pour nous.\nSiège de la sagesse — Priez pour nous.\nCause de notre joie — Priez pour nous.\nVase spirituel — Priez pour nous.\nVase d’honneur — Priez pour nous.\nVase insigne de dévotion — Priez pour nous.\nRose mystique — Priez pour nous.\nTour de David — Priez pour nous.\nTour d’ivoire — Priez pour nous.\nMaison d’or — Priez pour nous.\nArche d’alliance — Priez pour nous.\nPorte du ciel — Priez pour nous.\nÉtoile du matin — Priez pour nous.\nSalut des infirmes — Priez pour nous.\nRefuge des pécheurs — Priez pour nous.\nConsolatrice des affligés — Priez pour nous.\nSecours des chrétiens — Priez pour nous.\nReine des anges — Priez pour nous.\nReine des patriarches — Priez pour nous.\nReine des prophètes — Priez pour nous.\nReine des apôtres — Priez pour nous.\nReine des martyrs — Priez pour nous.\nReine des confesseurs — Priez pour nous.\nReine des vierges — Priez pour nous.\nReine de tous les saints — Priez pour nous.\nReine conçue sans le péché originel — Priez pour nous.\nReine élevée au ciel — Priez pour nous.\nReine du très saint Rosaire — Priez pour nous.\nReine de la paix — Priez pour nous.\n\nAgneau de Dieu, qui effacez les péchés du monde, pardonnez-nous, Seigneur.\nAgneau de Dieu, qui effacez les péchés du monde, exaucez-nous, Seigneur.\nAgneau de Dieu, qui effacez les péchés du monde, ayez pitié de nous.\n\n℣. Priez pour nous, sainte Mère de Dieu.\n℟. Afin que nous devenions dignes des promesses du Christ.\n\nPrions. Accordez à vos serviteurs, nous vous en prions, Seigneur notre Dieu, de jouir toujours de la santé de l’âme et du corps; et, par la glorieuse intercession de la bienheureuse Marie toujours Vierge, d’être délivrés de la tristesse présente et de jouir de la joie éternelle. Par Jésus-Christ Notre-Seigneur. Ainsi soit-il."},"litany_loreto_current":{"id":"litany_loreto_current","title":"Litany of Loreto · current invocations","titleFr":"Litanies de Lorette · invocations actuelles","category":"marian","source":"Holy See · current Litany of Loreto","sourceUrl":"https://www.vatican.va/special/rosary/documents/litanie-lauretane_en.html","note":"Later invocations are shown separately so the older TLM-era form is not silently modernized.","en":"Lord, have mercy on us.\nChrist, have mercy on us.\nLord, have mercy on us.\nChrist, hear us.\nChrist, graciously hear us.\n\nGod the Father of Heaven, have mercy on us.\nGod the Son, Redeemer of the world, have mercy on us.\nGod the Holy Spirit, have mercy on us.\nHoly Trinity, one God, have mercy on us.\n\nHoly Mary — Pray for us.\nHoly Mother of God — Pray for us.\nHoly Virgin of virgins — Pray for us.\nMother of Christ — Pray for us.\nMother of the Church — Pray for us.\nMother of mercy — Pray for us.\nMother of divine grace — Pray for us.\nMother of hope — Pray for us.\nMother most pure — Pray for us.\nMother most chaste — Pray for us.\nMother inviolate — Pray for us.\nMother undefiled — Pray for us.\nMother most amiable — Pray for us.\nMother admirable — Pray for us.\nMother of good counsel — Pray for us.\nMother of our Creator — Pray for us.\nMother of our Saviour — Pray for us.\nVirgin most prudent — Pray for us.\nVirgin most venerable — Pray for us.\nVirgin most renowned — Pray for us.\nVirgin most powerful — Pray for us.\nVirgin most merciful — Pray for us.\nVirgin most faithful — Pray for us.\nMirror of justice — Pray for us.\nSeat of wisdom — Pray for us.\nCause of our joy — Pray for us.\nSpiritual vessel — Pray for us.\nVessel of honour — Pray for us.\nSingular vessel of devotion — Pray for us.\nMystical rose — Pray for us.\nTower of David — Pray for us.\nTower of ivory — Pray for us.\nHouse of gold — Pray for us.\nArk of the covenant — Pray for us.\nGate of heaven — Pray for us.\nMorning star — Pray for us.\nHealth of the sick — Pray for us.\nRefuge of sinners — Pray for us.\nSolace of migrants — Pray for us.\nComfort of the afflicted — Pray for us.\nHelp of Christians — Pray for us.\nQueen of Angels — Pray for us.\nQueen of Patriarchs — Pray for us.\nQueen of Prophets — Pray for us.\nQueen of Apostles — Pray for us.\nQueen of Martyrs — Pray for us.\nQueen of Confessors — Pray for us.\nQueen of Virgins — Pray for us.\nQueen of all Saints — Pray for us.\nQueen conceived without original sin — Pray for us.\nQueen assumed into heaven — Pray for us.\nQueen of the most holy Rosary — Pray for us.\nQueen of families — Pray for us.\nQueen of peace — Pray for us.\n\nLamb of God, who takest away the sins of the world, spare us, O Lord.\nLamb of God, who takest away the sins of the world, graciously hear us, O Lord.\nLamb of God, who takest away the sins of the world, have mercy on us.\n\n℣. Pray for us, O holy Mother of God.\n℟. That we may be made worthy of the promises of Christ.\n\nLet us pray. Grant, we beseech Thee, O Lord God, that we Thy servants may enjoy perpetual health of mind and body; and by the glorious intercession of blessed Mary, ever Virgin, may be delivered from present sorrow and enjoy eternal gladness. Through Christ our Lord. Amen.","la":"Kyrie, eleison.\nChriste, eleison.\nKyrie, eleison.\nChriste, audi nos.\nChriste, exaudi nos.\n\nPater de cælis, Deus, miserere nobis.\nFili, Redemptor mundi, Deus, miserere nobis.\nSpiritus Sancte, Deus, miserere nobis.\nSancta Trinitas, unus Deus, miserere nobis.\n\nSancta Maria — Ora pro nobis.\nSancta Dei Genetrix — Ora pro nobis.\nSancta Virgo virginum — Ora pro nobis.\nMater Christi — Ora pro nobis.\nMater Ecclesiæ — Ora pro nobis.\nMater misericordiæ — Ora pro nobis.\nMater divinæ gratiæ — Ora pro nobis.\nMater spei — Ora pro nobis.\nMater purissima — Ora pro nobis.\nMater castissima — Ora pro nobis.\nMater inviolata — Ora pro nobis.\nMater intemerata — Ora pro nobis.\nMater amabilis — Ora pro nobis.\nMater admirabilis — Ora pro nobis.\nMater boni consilii — Ora pro nobis.\nMater Creatoris — Ora pro nobis.\nMater Salvatoris — Ora pro nobis.\nVirgo prudentissima — Ora pro nobis.\nVirgo veneranda — Ora pro nobis.\nVirgo prædicanda — Ora pro nobis.\nVirgo potens — Ora pro nobis.\nVirgo clemens — Ora pro nobis.\nVirgo fidelis — Ora pro nobis.\nSpeculum iustitiæ — Ora pro nobis.\nSedes sapientiæ — Ora pro nobis.\nCausa nostræ lætitiæ — Ora pro nobis.\nVas spirituale — Ora pro nobis.\nVas honorabile — Ora pro nobis.\nVas insigne devotionis — Ora pro nobis.\nRosa mystica — Ora pro nobis.\nTurris Davidica — Ora pro nobis.\nTurris eburnea — Ora pro nobis.\nDomus aurea — Ora pro nobis.\nFœderis arca — Ora pro nobis.\nIanua cæli — Ora pro nobis.\nStella matutina — Ora pro nobis.\nSalus infirmorum — Ora pro nobis.\nRefugium peccatorum — Ora pro nobis.\nSolacium migrantium — Ora pro nobis.\nConsolatrix afflictorum — Ora pro nobis.\nAuxilium Christianorum — Ora pro nobis.\nRegina Angelorum — Ora pro nobis.\nRegina Patriarcharum — Ora pro nobis.\nRegina Prophetarum — Ora pro nobis.\nRegina Apostolorum — Ora pro nobis.\nRegina Martyrum — Ora pro nobis.\nRegina Confessorum — Ora pro nobis.\nRegina Virginum — Ora pro nobis.\nRegina Sanctorum omnium — Ora pro nobis.\nRegina sine labe originali concepta — Ora pro nobis.\nRegina in cælum assumpta — Ora pro nobis.\nRegina sacratissimi Rosarii — Ora pro nobis.\nRegina familiæ — Ora pro nobis.\nRegina pacis — Ora pro nobis.\n\nAgnus Dei, qui tollis peccata mundi, parce nobis, Domine.\nAgnus Dei, qui tollis peccata mundi, exaudi nos, Domine.\nAgnus Dei, qui tollis peccata mundi, miserere nobis.\n\n℣. Ora pro nobis, sancta Dei Genetrix.\n℟. Ut digni efficiamur promissionibus Christi.\n\nOremus. Concede nos famulos tuos, quæsumus, Domine Deus, perpetua mentis et corporis sanitate gaudere: et gloriosa beatæ Mariæ semper Virginis intercessione, a præsenti liberari tristitia, et æterna perfrui lætitia. Per Christum Dominum nostrum. Amen.","fr":"Seigneur, ayez pitié de nous.\nJésus-Christ, ayez pitié de nous.\nSeigneur, ayez pitié de nous.\nJésus-Christ, écoutez-nous.\nJésus-Christ, exaucez-nous.\n\nPère céleste, qui êtes Dieu, ayez pitié de nous.\nFils, Rédempteur du monde, qui êtes Dieu, ayez pitié de nous.\nEsprit-Saint, qui êtes Dieu, ayez pitié de nous.\nTrinité Sainte, qui êtes un seul Dieu, ayez pitié de nous.\n\nSainte Marie — Priez pour nous.\nSainte Mère de Dieu — Priez pour nous.\nSainte Vierge des vierges — Priez pour nous.\nMère du Christ — Priez pour nous.\nMère de l’Église — Priez pour nous.\nMère de miséricorde — Priez pour nous.\nMère de la divine grâce — Priez pour nous.\nMère de l’espérance — Priez pour nous.\nMère très pure — Priez pour nous.\nMère très chaste — Priez pour nous.\nMère toujours vierge — Priez pour nous.\nMère sans tache — Priez pour nous.\nMère très aimable — Priez pour nous.\nMère admirable — Priez pour nous.\nMère du bon conseil — Priez pour nous.\nMère du Créateur — Priez pour nous.\nMère du Sauveur — Priez pour nous.\nVierge très prudente — Priez pour nous.\nVierge vénérable — Priez pour nous.\nVierge digne de louange — Priez pour nous.\nVierge puissante — Priez pour nous.\nVierge clémente — Priez pour nous.\nVierge fidèle — Priez pour nous.\nMiroir de justice — Priez pour nous.\nSiège de la sagesse — Priez pour nous.\nCause de notre joie — Priez pour nous.\nVase spirituel — Priez pour nous.\nVase d’honneur — Priez pour nous.\nVase insigne de dévotion — Priez pour nous.\nRose mystique — Priez pour nous.\nTour de David — Priez pour nous.\nTour d’ivoire — Priez pour nous.\nMaison d’or — Priez pour nous.\nArche d’alliance — Priez pour nous.\nPorte du ciel — Priez pour nous.\nÉtoile du matin — Priez pour nous.\nSalut des infirmes — Priez pour nous.\nRefuge des pécheurs — Priez pour nous.\nRéconfort des migrants — Priez pour nous.\nConsolatrice des affligés — Priez pour nous.\nSecours des chrétiens — Priez pour nous.\nReine des anges — Priez pour nous.\nReine des patriarches — Priez pour nous.\nReine des prophètes — Priez pour nous.\nReine des apôtres — Priez pour nous.\nReine des martyrs — Priez pour nous.\nReine des confesseurs — Priez pour nous.\nReine des vierges — Priez pour nous.\nReine de tous les saints — Priez pour nous.\nReine conçue sans le péché originel — Priez pour nous.\nReine élevée au ciel — Priez pour nous.\nReine du très saint Rosaire — Priez pour nous.\nReine des familles — Priez pour nous.\nReine de la paix — Priez pour nous.\n\nAgneau de Dieu, qui effacez les péchés du monde, pardonnez-nous, Seigneur.\nAgneau de Dieu, qui effacez les péchés du monde, exaucez-nous, Seigneur.\nAgneau de Dieu, qui effacez les péchés du monde, ayez pitié de nous.\n\n℣. Priez pour nous, sainte Mère de Dieu.\n℟. Afin que nous devenions dignes des promesses du Christ.\n\nPrions. Accordez à vos serviteurs, nous vous en prions, Seigneur notre Dieu, de jouir toujours de la santé de l’âme et du corps; et, par la glorieuse intercession de la bienheureuse Marie toujours Vierge, d’être délivrés de la tristesse présente et de jouir de la joie éternelle. Par Jésus-Christ Notre-Seigneur. Ainsi soit-il."}},"categories":{"essentials":{"en":"Essential prayers","fr":"Prières essentielles"},"massdev":{"en":"Traditional Mass devotions","fr":"Dévotions traditionnelles autour de la Messe"},"marian":{"en":"Our Lady","fr":"Notre-Dame"},"eucharistic":{"en":"Eucharistic devotion","fr":"Dévotion eucharistique"},"saints":{"en":"Saints, Church & protection","fr":"Saints, Église et protection"},"holyghost":{"en":"Holy Ghost","fr":"Saint-Esprit"},"hearts":{"en":"Sacred Heart & reparation","fr":"Sacré-Cœur et réparation"},"canticles":{"en":"Biblical canticles","fr":"Cantiques bibliques"},"dead":{"en":"Holy Souls & the dead","fr":"Âmes du purgatoire et défunts"}},"mysteries":{"joyful":["The Annunciation","The Visitation","The Nativity","The Presentation","The Finding in the Temple"],"luminous":["The Baptism of the Lord","The Wedding at Cana","The Proclamation of the Kingdom","The Transfiguration","The Institution of the Eucharist"],"sorrowful":["The Agony in the Garden","The Scourging at the Pillar","The Crowning with Thorns","The Carrying of the Cross","The Crucifixion"],"glorious":["The Resurrection","The Ascension","The Descent of the Holy Ghost","The Assumption","The Coronation of Our Lady"]},"rosaryPrayers":{"en":{"sign":["Sign of the Cross","In the name of the Father, and of the Son, and of the Holy Spirit. Amen."],"credo":["Apostles’ Creed","I believe in God, the Father almighty, Creator of heaven and earth; and in Jesus Christ, His only Son, our Lord, Who was conceived by the Holy Spirit, born of the Virgin Mary, suffered under Pontius Pilate, was crucified, died and was buried; He descended into hell; on the third day He rose again from the dead; He ascended into heaven, and is seated at the right hand of God the Father almighty; from there He shall come to judge the living and the dead. I believe in the Holy Spirit, the holy Catholic Church, the communion of saints, the forgiveness of sins, the resurrection of the body, and life everlasting. Amen."],"pater":["Our Father","Our Father, Who art in heaven, hallowed be Thy name; Thy kingdom come; Thy will be done on earth as it is in heaven. Give us this day our daily bread; and forgive us our trespasses, as we forgive those who trespass against us; and lead us not into temptation, but deliver us from evil. Amen."],"ave":["Hail Mary","Hail Mary, full of grace, the Lord is with thee; blessed art thou among women, and blessed is the fruit of thy womb, Jesus. Holy Mary, Mother of God, pray for us sinners, now and at the hour of our death. Amen."],"gloria":["Glory Be","Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen."],"fatima":["Fatima Prayer","O my Jesus, forgive us our sins, save us from the fires of hell; lead all souls to Heaven, especially those most in need of Thy mercy."]},"la":{"sign":["Signum Crucis","In nomine Patris, et Filii, et Spiritus Sancti. Amen."],"credo":["Symbolum Apostolorum","Credo in Deum Patrem omnipotentem, Creatorem cæli et terræ. Et in Iesum Christum, Filium eius unicum, Dominum nostrum: qui conceptus est de Spiritu Sancto, natus ex Maria Virgine, passus sub Pontio Pilato, crucifixus, mortuus, et sepultus; descendit ad inferos; tertia die resurrexit a mortuis; ascendit ad cælos; sedet ad dexteram Dei Patris omnipotentis; inde venturus est iudicare vivos et mortuos. Credo in Spiritum Sanctum, sanctam Ecclesiam catholicam, Sanctorum communionem, remissionem peccatorum, carnis resurrectionem, vitam æternam. Amen."],"pater":["Pater Noster","Pater noster, qui es in cælis, sanctificetur nomen tuum; adveniat regnum tuum; fiat voluntas tua, sicut in cælo et in terra. Panem nostrum quotidianum da nobis hodie; et dimitte nobis debita nostra, sicut et nos dimittimus debitoribus nostris; et ne nos inducas in tentationem, sed libera nos a malo. Amen."],"ave":["Ave Maria","Ave Maria, gratia plena, Dominus tecum; benedicta tu in mulieribus, et benedictus fructus ventris tui, Iesus. Sancta Maria, Mater Dei, ora pro nobis peccatoribus, nunc et in hora mortis nostræ. Amen."],"gloria":["Gloria Patri","Gloria Patri, et Filio, et Spiritui Sancto. Sicut erat in principio, et nunc, et semper, et in sæcula sæculorum. Amen."],"fatima":["Oratio Fatimæ","O mi Iesu, dimitte nobis debita nostra, libera nos ab igne inferni, conduc in cælum omnes animas, præsertim eas quæ misericordiæ tuæ maxime indigent."]},"fr":{"sign":["Signe de la Croix","Au nom du Père, et du Fils, et du Saint-Esprit. Amen."],"credo":["Symbole des Apôtres","Je crois en Dieu, le Père tout-puissant, Créateur du ciel et de la terre; et en Jésus-Christ, son Fils unique, notre Seigneur, qui a été conçu du Saint-Esprit, est né de la Vierge Marie, a souffert sous Ponce Pilate, a été crucifié, est mort et a été enseveli, est descendu aux enfers; le troisième jour est ressuscité des morts, est monté aux cieux, est assis à la droite de Dieu le Père tout-puissant, d’où il viendra juger les vivants et les morts. Je crois au Saint-Esprit, à la sainte Église catholique, à la communion des saints, à la rémission des péchés, à la résurrection de la chair et à la vie éternelle. Ainsi soit-il."],"pater":["Notre Père","Notre Père, qui êtes aux cieux, que votre nom soit sanctifié; que votre règne arrive; que votre volonté soit faite sur la terre comme au ciel. Donnez-nous aujourd’hui notre pain de chaque jour; pardonnez-nous nos offenses, comme nous pardonnons à ceux qui nous ont offensés; et ne nous laissez pas succomber à la tentation, mais délivrez-nous du mal. Amen."],"ave":["Je vous salue Marie","Je vous salue, Marie, pleine de grâce, le Seigneur est avec vous; vous êtes bénie entre toutes les femmes, et Jésus, le fruit de vos entrailles, est béni. Sainte Marie, Mère de Dieu, priez pour nous, pauvres pécheurs, maintenant et à l’heure de notre mort. Amen."],"gloria":["Gloire au Père","Gloire au Père, au Fils et au Saint-Esprit, comme il était au commencement, maintenant et toujours, et dans les siècles des siècles. Amen."],"fatima":["Prière de Fatima","Ô mon Jésus, pardonnez-nous nos péchés, préservez-nous du feu de l’enfer, conduisez au ciel toutes les âmes, surtout celles qui ont le plus besoin de votre miséricorde."]}},"salve":{"en":"Hail, holy Queen, Mother of mercy, our life, our sweetness and our hope. To thee do we cry, poor banished children of Eve; to thee do we send up our sighs, mourning and weeping in this valley of tears. Turn then, most gracious Advocate, thine eyes of mercy toward us; and after this our exile show unto us the blessed fruit of thy womb, Jesus. O clement, O loving, O sweet Virgin Mary.\n\nV. Pray for us, O holy Mother of God.\nR. That we may be made worthy of the promises of Christ.","la":"Salve, Regina, Mater misericordiæ; vita, dulcedo et spes nostra, salve. Ad te clamamus, exsules filii Hevæ. Ad te suspiramus, gementes et flentes in hac lacrimarum valle. Eia ergo, advocata nostra, illos tuos misericordes oculos ad nos converte. Et Iesum, benedictum fructum ventris tui, nobis post hoc exsilium ostende. O clemens, o pia, o dulcis Virgo Maria.\n\nV. Ora pro nobis, sancta Dei Genetrix.\nR. Ut digni efficiamur promissionibus Christi.","fr":"Salut, ô Reine, Mère de miséricorde, notre vie, notre douceur et notre espérance, salut. Enfants d’Ève exilés, nous crions vers vous. Vers vous nous soupirons, gémissant et pleurant dans cette vallée de larmes. Ô vous, notre avocate, tournez vers nous vos regards miséricordieux. Et après cet exil, montrez-nous Jésus, le fruit béni de vos entrailles. Ô clémente, ô charitable, ô douce Vierge Marie.\n\nV. Priez pour nous, sainte Mère de Dieu.\nR. Afin que nous devenions dignes des promesses du Christ."},"rosaryCollect":{"en":"Let us pray. O God, whose only-begotten Son, by His life, death and resurrection, has purchased for us the rewards of eternal life: grant, we beseech Thee, that meditating upon these mysteries of the most holy Rosary of the Blessed Virgin Mary, we may imitate what they contain and obtain what they promise. Through the same Christ our Lord. Amen.","la":"Oremus. Deus, cuius Unigenitus per vitam, mortem et resurrectionem suam nobis salutis æternæ præmia comparavit: concede, quæsumus; ut hæc mysteria sacratissimo beatæ Mariæ Virginis Rosario recolentes, et imitemur quod continent, et quod promittunt assequamur. Per eundem Christum Dominum nostrum. Amen.","fr":"Prions. Ô Dieu, dont le Fils unique nous a acquis, par sa vie, sa mort et sa résurrection, les récompenses de la vie éternelle, accordez-nous, nous vous en supplions, qu’en méditant ces mystères du très saint Rosaire de la bienheureuse Vierge Marie, nous imitions ce qu’ils contiennent et obtenions ce qu’ils promettent. Par le même Jésus-Christ Notre-Seigneur. Ainsi soit-il."},"angelus":{"en":"℣ The Angel of the Lord declared unto Mary.\n℟ And she conceived of the Holy Spirit.\nHail Mary, full of grace, the Lord is with thee; blessed art thou among women, and blessed is the fruit of thy womb, Jesus. Holy Mary, Mother of God, pray for us sinners, now and at the hour of our death. Amen.\n\n℣ Behold the handmaid of the Lord.\n℟ Be it done unto me according to thy word.\nHail Mary, full of grace, the Lord is with thee; blessed art thou among women, and blessed is the fruit of thy womb, Jesus. Holy Mary, Mother of God, pray for us sinners, now and at the hour of our death. Amen.\n\n℣ And the Word was made flesh.\n℟ And dwelt among us.\nHail Mary, full of grace, the Lord is with thee; blessed art thou among women, and blessed is the fruit of thy womb, Jesus. Holy Mary, Mother of God, pray for us sinners, now and at the hour of our death. Amen.\n\n℣ Pray for us, O holy Mother of God.\n℟ That we may be made worthy of the promises of Christ.\n\nLet us pray: Pour forth, we beseech thee, O Lord, thy grace into our hearts; that we, to whom the Incarnation of Christ, thy Son, was made known by the message of an angel, may by his Passion and Cross be brought to the glory of his Resurrection. Through the same Christ our Lord. Amen.","la":"V. Angelus Domini nuntiavit Mariae.\nR. Et concepit de Spiritu Sancto.\n\nAve Maria, gratia plena, Dominus tecum; benedicta tu in mulieribus, et benedictus fructus ventris tui, Iesus. Sancta Maria, Mater Dei, ora pro nobis peccatoribus, nunc et in hora mortis nostræ. Amen.\n\nV. Ecce ancilla Domini.\nR. Fiat mihi secundum verbum tuum.\n\nAve Maria, gratia plena, Dominus tecum; benedicta tu in mulieribus, et benedictus fructus ventris tui, Iesus. Sancta Maria, Mater Dei, ora pro nobis peccatoribus, nunc et in hora mortis nostræ. Amen.\n\nV. Et Verbum caro factum est.\nR. Et habitavit in nobis.\n\nAve Maria, gratia plena, Dominus tecum; benedicta tu in mulieribus, et benedictus fructus ventris tui, Iesus. Sancta Maria, Mater Dei, ora pro nobis peccatoribus, nunc et in hora mortis nostræ. Amen.\n\nV. Ora pro nobis, sancta Dei Genetrix.\nR. Ut digni efficiamur promissionibus Christi.\n\nOremus. Gratiam tuam, quaesumus, Domine, mentibus nostris infunde; ut qui, Angelo nuntiante, Christi Filii tui incarnationem cognovimus, per passionem eius et crucem ad resurrectionis gloriam perducamur. Per eundem Christum Dominum nostrum. Amen.","fr":"V. L’Ange du Seigneur annonça à Marie.\nR. Et elle conçut du Saint-Esprit.\n\nJe vous salue, Marie, pleine de grâce; le Seigneur est avec vous; vous êtes bénie entre toutes les femmes, et Jésus, le fruit de vos entrailles, est béni. Sainte Marie, Mère de Dieu, priez pour nous, pauvres pécheurs, maintenant et à l’heure de notre mort. Ainsi soit-il.\n\nV. Voici la servante du Seigneur.\nR. Qu’il me soit fait selon votre parole.\n\nJe vous salue, Marie, pleine de grâce; le Seigneur est avec vous; vous êtes bénie entre toutes les femmes, et Jésus, le fruit de vos entrailles, est béni. Sainte Marie, Mère de Dieu, priez pour nous, pauvres pécheurs, maintenant et à l’heure de notre mort. Ainsi soit-il.\n\nV. Et le Verbe s’est fait chair.\nR. Et il a habité parmi nous.\n\nJe vous salue, Marie, pleine de grâce; le Seigneur est avec vous; vous êtes bénie entre toutes les femmes, et Jésus, le fruit de vos entrailles, est béni. Sainte Marie, Mère de Dieu, priez pour nous, pauvres pécheurs, maintenant et à l’heure de notre mort. Ainsi soit-il.\n\nV. Priez pour nous, sainte Mère de Dieu.\nR. Afin que nous soyons rendus dignes des promesses du Christ.\n\nPrions. Que ta grâce, Seigneur, se répande en nos cœurs; par le message de l’ange, tu nous as fait connaître l’Incarnation de ton Fils bien-aimé; conduis-nous, par sa Passion et par sa Croix, jusqu’à la gloire de la Résurrection. Par le Christ, notre Seigneur. Amen."},"angelusAppendix":{"en":"Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen. (three times)\n\n℣. May the souls of the faithful departed, through the mercy of God, rest in peace.\n℟. Amen.\n\n℣. May the divine assistance remain always with us.\n℟. Amen.","la":"Gloria Patri, et Filio, et Spiritui Sancto. Sicut erat in principio, et nunc, et semper, et in sæcula sæculorum. Amen. (ter)\n\n℣. Fidelium animæ per misericordiam Dei requiescant in pace.\n℟. Amen.\n\n℣. Divinum auxilium maneat semper nobiscum.\n℟. Amen.","fr":"Gloire au Père, au Fils et au Saint-Esprit, comme il était au commencement, maintenant et toujours, et dans les siècles des siècles. Ainsi soit-il. (trois fois)\n\n℣. Que les âmes des fidèles défunts reposent en paix par la miséricorde de Dieu.\n℟. Ainsi soit-il.\n\n℣. Que le secours divin demeure toujours avec nous.\n℟. Ainsi soit-il."},"regina":{"en":"℣. Queen of heaven, rejoice, alleluia.\n℟. For He whom thou didst merit to bear, alleluia.\n℣. Has risen, as He said, alleluia.\n℟. Pray for us to God, alleluia.\n\n℣. Rejoice and be glad, O Virgin Mary, alleluia.\n℟. For the Lord is truly risen, alleluia.\n\nLet us pray. O God, who by the resurrection of Thy Son, our Lord Jesus Christ, hast vouchsafed to give joy to the whole world: grant, we beseech Thee, that through the intercession of the Virgin Mary, His Mother, we may obtain the joys of everlasting life. Through the same Christ our Lord. Amen.","la":"℣. Regina cæli, lætare, alleluia.\n℟. Quia quem meruisti portare, alleluia.\n℣. Resurrexit, sicut dixit, alleluia.\n℟. Ora pro nobis Deum, alleluia.\n\n℣. Gaude et lætare, Virgo Maria, alleluia.\n℟. Quia surrexit Dominus vere, alleluia.\n\nOremus. Deus, qui per resurrectionem Filii tui, Domini nostri Iesu Christi, mundum lætificare dignatus es: præsta, quæsumus, ut per eius Genetricem Virginem Mariam perpetuæ capiamus gaudia vitæ. Per eundem Christum Dominum nostrum. Amen.","fr":"℣. Reine du ciel, réjouissez-vous, alléluia.\n℟. Car celui que vous avez mérité de porter, alléluia.\n℣. Est ressuscité comme il l’avait dit, alléluia.\n℟. Priez Dieu pour nous, alléluia.\n\n℣. Réjouissez-vous et soyez dans l’allégresse, Vierge Marie, alléluia.\n℟. Parce que le Seigneur est vraiment ressuscité, alléluia.\n\nPrions. Ô Dieu, qui avez daigné réjouir le monde par la résurrection de votre Fils, Notre-Seigneur Jésus-Christ, faites, nous vous en supplions, que par sa Mère, la Vierge Marie, nous obtenions les joies de la vie éternelle. Par le même Jésus-Christ Notre-Seigneur. Ainsi soit-il."},"stationTitles":{"en":["Jesus Is Condemned to Death","Jesus Is Made to Bear His Cross","Jesus Falls the First Time","Jesus Meets His Blessed Mother","Simon of Cyrene Helps Jesus Carry His Cross","Veronica Wipes the Face of Jesus","Jesus Falls the Second Time","Jesus Consoles the Women of Jerusalem","Jesus Falls the Third Time","Jesus Is Stripped of His Garments","Jesus Is Nailed to the Cross","Jesus Dies on the Cross","Jesus Is Taken Down from the Cross","Jesus Is Laid in the Sepulchre"],"la":["Iesus condemnatur ad mortem","Iesus baiulat crucem","Iesus primum cadit sub cruce","Iesus occurrit Matri suae","Simon Cyrenaeus adiuvat Iesum crucem portare","Veronica faciem Iesu abstergit","Iesus iterum cadit sub cruce","Iesus alloquitur mulieres Ierusalem","Iesus tertium cadit sub cruce","Iesus vestibus exuitur","Iesus cruci affigitur","Iesus moritur in cruce","Iesus de cruce deponitur","Iesus in sepulcro ponitur"],"fr":["Jésus est condamné à mort","Jésus est chargé de sa croix","Jésus tombe pour la première fois","Jésus rencontre sa très sainte Mère","Simon de Cyrène aide Jésus à porter sa croix","Véronique essuie le visage de Jésus","Jésus tombe pour la deuxième fois","Jésus console les filles de Jérusalem","Jésus tombe pour la troisième fois","Jésus est dépouillé de ses vêtements","Jésus est cloué à la croix","Jésus meurt sur la croix","Jésus est descendu de la croix","Jésus est mis au tombeau"]},"stationVR":{"en":["℣. We adore Thee, O Christ, and we bless Thee.","℟. Because by Thy holy Cross Thou hast redeemed the world."],"la":["℣. Adoramus te, Christe, et benedicimus tibi.","℟. Quia per sanctam crucem tuam redemisti mundum."],"fr":["℣. Nous vous adorons, ô Christ, et nous vous bénissons.","℟. Parce que par votre sainte Croix vous avez racheté le monde."]},"stabat":["Stabat Mater dolorosa\niuxta Crucem lacrimosa,\ndum pendebat Filius.","Cuius animam gementem,\ncontristatam et dolentem,\npertransivit gladius.","O quam tristis et afflicta\nfuit illa benedicta,\nMater Unigeniti!","Quae maerebat et dolebat,\npia Mater, dum videbat\nnati poenas inclyti.","Quis est homo qui non fleret,\nMatrem Christi si videret\nin tanto supplicio?","Quis non posset contristari,\nChristi Matrem contemplari\ndolentem cum Filio?","Pro peccatis suae gentis\nvidit Iesum in tormentis,\net flagellis subditum.","Vidit suum dulcem Natum\nmoriendo desolatum,\ndum emisit spiritum.","Eia, Mater, fons amoris,\nme sentire vim doloris\nfac, ut tecum lugeam.","Fac ut ardeat cor meum\nin amando Christum Deum,\nut sibi complaceam.","Sancta Mater, istud agas,\nCrucifixi fige plagas\ncordi meo valide.","Tui Nati vulnerati,\ntam dignati pro me pati,\npoenas mecum divide.","Fac me tecum pie flere,\nCrucifixo condolere,\ndonec ego vixero."],"alphonsus":{"en":[{"consider":"Consider how Jesus, after having been scourged and crowned with thorns, was unjustly condemned by Pilate to die on the Cross.","prayer":"My adorable Jesus, it was not Pilate; no, it was my sins that condemned Thee to die. I beseech Thee, by the merits of this sorrowful journey, to assist my soul in its journey toward eternity. I love Thee, my beloved Jesus; I love Thee more than myself; I repent with my whole heart of having offended Thee. Never permit me to separate myself from Thee again. Grant that I may love Thee always, and then do with me what Thou wilt."},{"consider":"Consider how Jesus, in making this journey with the Cross on His shoulders, thought of us, and offered for us to His Father the death He was about to undergo.","prayer":"My most beloved Jesus, I embrace all the tribulations Thou hast destined for me until death. I beseech Thee, by the merits of the pain Thou didst suffer in carrying Thy Cross, to give me the necessary help to carry mine with perfect patience and resignation. I love Thee, Jesus my love; I love Thee more than myself; I repent of having offended Thee. Never permit me to separate myself from Thee again. Grant that I may love Thee always, and then do with me what Thou wilt."},{"consider":"Consider this first fall of Jesus under His Cross. His flesh was torn by the scourges, His head crowned with thorns, and He had lost a great quantity of blood. He was so weakened that He could scarcely walk, and yet He had to carry this great load upon His shoulders. The soldiers struck Him rudely, and thus He fell several times in His journey.","prayer":"My beloved Jesus, it is not the weight of the Cross, but my sins which have made Thee suffer so much pain. By the merits of this first fall, deliver me from the misfortune of falling into mortal sin. I love Thee, Jesus, with my whole heart; I repent of having offended Thee. Never permit me to offend Thee again. Grant that I may love Thee always, and then do with me what Thou wilt."},{"consider":"Consider the meeting of the Son and the Mother which took place on this journey. Jesus and Mary looked at each other, and their looks became as so many arrows to wound those hearts which loved each other so tenderly.","prayer":"My most loving Jesus, by the sorrow that Thou didst experience in this meeting, grant me the grace of a truly devoted love for Thy most holy Mother. And thou, my Queen, who wast overwhelmed with sorrow, obtain for me, by thy intercession, a continual and tender remembrance of the Passion of thy Son. I love Thee, Jesus my love; I repent of having offended Thee. Never permit me to offend Thee again. Grant that I may love Thee always, and then do with me what Thou wilt."},{"consider":"Consider how the Jews, seeing that at each step Jesus, from weakness, was on the point of expiring, and fearing that He would die on the way when they wished Him to die the shameful death of the Cross, constrained Simon the Cyrenian to carry the Cross behind our Lord.","prayer":"My most beloved Jesus, I will not refuse the Cross as the Cyrenian did; I accept it, I embrace it. I accept in particular the death Thou hast destined for me, with all the pains which may accompany it; I unite it to Thy death and offer it to Thee. Thou hast died for love of me. I will die for love of Thee, and to please Thee. Help me by Thy grace. I love Thee, Jesus my love; I repent of having offended Thee. Never permit me to offend Thee again. Grant that I may love Thee always, and then do with me what Thou wilt."},{"consider":"Consider how the holy woman named Veronica, seeing Jesus so afflicted and His face bathed in sweat and blood, presented Him with a towel, with which He wiped His adorable face, leaving on it the impression of His holy countenance.","prayer":"My most beloved Jesus, Thy face was beautiful before, but in this journey it has lost all its beauty, and wounds and blood have disfigured it. Alas! my soul also was once beautiful, when it received Thy grace in Baptism; but I have disfigured it since by my sins. Thou alone, my Redeemer, can restore it to its former beauty. Do this by Thy Passion. I love Thee, Jesus my love; I repent of having offended Thee. Never permit me to offend Thee again. Grant that I may love Thee always, and then do with me what Thou wilt."},{"consider":"Consider the second fall of Jesus under the Cross, a fall which renews the pain of all the wounds of the head and members of our afflicted Lord.","prayer":"My most gentle Jesus, how many times Thou hast pardoned me, and how many times have I fallen again and begun again to offend Thee! By the merits of this new fall, give me the necessary helps to persevere in Thy grace until death. Grant that in all temptations which assail me, I may always commend myself to Thee. I love Thee, Jesus my Love, with my whole heart; I repent of having offended Thee. Never permit me to offend Thee again. Grant that I may love Thee always, and then do with me what Thou wilt."},{"consider":"Consider how those women wept with compassion at seeing Jesus in such a pitiable state, streaming with Blood as He walked along. But Jesus said to them: “Weep not for Me, but for your children.”","prayer":"My Jesus, laden with sorrows, I weep for the offenses I have committed against Thee, because of the pains they have deserved, and still more because of the displeasure they have caused Thee, Who hast loved me so much. It is Thy love more than the fear of hell which causes me to weep for my sins. My Jesus, I love Thee more than myself. I repent of having offended Thee. Never permit me to offend Thee again. Grant that I may love Thee always, and then do with me what Thou wilt."},{"consider":"Consider the third fall of Jesus Christ. His weakness was extreme, and the cruelty of His executioners excessive, who tried to hasten His steps when He had scarcely strength to move.","prayer":"Ah, my outraged Jesus, by the merits of the weakness Thou didst suffer in going to Calvary, give me strength sufficient to conquer all human respect and all my wicked passions, which have led me to despise Thy friendship. I love Thee, Jesus my love, with my whole heart. I repent of having offended Thee. Never permit me to offend Thee again. Grant that I may love Thee always, and then do with me what Thou wilt."},{"consider":"Consider the violence with which the executioners stripped Jesus. His inner garments adhered to His torn flesh, and they dragged them off so roughly that the skin came with them. Compassionate thy Saviour thus cruelly treated.","prayer":"My innocent Jesus, by the merits of the torments Thou hast felt, help me to strip myself of all affection to things of earth, in order that I may place all my love in Thee, Who art so worthy of my love. I love Thee, O Jesus, with my whole heart. I repent of having offended Thee. Never permit me to offend Thee again. Grant that I may love Thee always, and then do with me what Thou wilt."},{"consider":"Consider how Jesus, after being thrown on the Cross, extended His hands and offered to His Eternal Father the sacrifice of His life for our salvation. They fastened Him with nails and then, raising the Cross, left Him to die in anguish.","prayer":"My Jesus, loaded with contempt, nail my heart to Thy feet, that it may ever remain there, to love Thee and never quit Thee again. I love Thee more than myself. I repent of having offended Thee. Never permit me to offend Thee again. Grant that I may love Thee always, and then do with me what Thou wilt."},{"consider":"Consider how thy Jesus, after three hours of agony on the Cross, consumed at length with anguish, abandons Himself to the weight of His Body, bows His Head, and dies.","prayer":"O my dying Jesus, I kiss devoutly the Cross on which Thou didst die for love of me. I have merited by my sins to die a miserable death, but Thy death is my hope. By the merits of Thy death, give me grace to die embracing Thy feet and burning with love for Thee. I yield my soul into Thy hands. I love Thee with my whole heart; I repent of having offended Thee. Never permit me to offend Thee again. Grant that I may love Thee always, and then do with me what Thou wilt."},{"consider":"Consider how, after the death of our Lord, two of His disciples, Joseph and Nicodemus, took Him down from the Cross and placed Him in the arms of His afflicted Mother, who received Him with unutterable tenderness and pressed Him to her bosom.","prayer":"O Mother of Sorrows, for the love of this Son, accept me for thy servant and pray to Him for me. And Thou, my Redeemer, since Thou hast died for me, permit me to love Thee; for I wish but Thee and nothing more. I love Thee, my Jesus, and I repent of having offended Thee. Never permit me to offend Thee again. Grant that I may love Thee always, and then do with me what Thou wilt."},{"consider":"Consider how the disciples carried the Body of Jesus to bury it, accompanied by His holy Mother, who arranged it in the sepulchre with her own hands. They then closed the tomb, and all withdrew.","prayer":"Ah, my buried Jesus, I kiss the stone that encloses Thee. But Thou didst rise again the third day. I beseech Thee by Thy resurrection, make me rise glorious with Thee at the last day, to be always united with Thee in Heaven, to praise Thee and love Thee forever. I love Thee, and I repent of having offended Thee. Never permit me to offend Thee again. Grant that I may love Thee always, and then do with me what Thou wilt."}],"la":[{"consider":"Considera quomodo Iesus Christus, iam flagellatus et spinis coronatus, iniuste tandem a Pilato ad mortem crucis condemnetur.","prayer":"O adorande Iesu, non Pilatus, sed iniqua mea vita te ad mortem condemnavit. Per meritum laboriosissimi huius itineris, quod ad Calvariae montem instituis, precor te, ut me semper in via, qua anima mea in aeternitatem tendit, benigne comiteris. Amo te, o Iesu, mi Amor, magis quam meipsum, et ex intimo corde paenitet me quod tibi displicui. Ne sinas me iterum a te separari. Da mihi perpetuum amorem tui, et dein fac de me quidquid tibi placuerit. Quod tibi placitum est, hoc idem mihi est acceptum."},{"consider":"Considera quomodo Iesus Christus, portans humeris crucem, fuerit inter eundum, memor tui, offerendo pro te aeterno Patri mortem, quam erat obiturus.","prayer":"Amabilissime Iesu, amplector omnes res adversas, quas mihi usque ad obitum tolerandas praefixisti, et, per durum illum, quem in portanda tua cruce pertulisti, laborem, precor te, ut vires mihi subministres, quibus ego quoque crucem meam, aequo ac patienti animo, portare valeam. Amo te, o Iesu, mi Amor, paenitet me quod tibi displicui. Ne sinas me iterum separari a te. Da mihi perpetuum amorem tui, et dein fac de me quidquid tibi placuerit."},{"consider":"Considera primum hunc Iesu Christi sub cruce lapsum. Habebat carnem ex saeva flagellatione multifarie sauciam, caput redimitum spinarum corona; profuderat insuper cruorem in tanta copia, ut vix pedem prae virium defectione movere posset. Et quoniam gravi crucis onere premebatur et immisericorditer a militibus propellebatur, accidit ut pluries inter eundum humi procumberet.","prayer":"O mi Iesu, non est onus crucis, sed peccatorum meorum pondus, quod tantis te afficit doloribus. Rogo te, per primum hunc tuum lapsum, ut ab omni in peccatum me lapsu tuearis. Amo te, o Iesu, ex toto corde meo; paenitet me quod tibi displicui. Ne sinas me iterum in peccatum prolabi. Da mihi perpetuum amorem tui, et dein fac de me quidquid tibi placuerit."},{"consider":"Considera qualis fuerit, in hac via, Filii et Matris occursus. Iesus et Maria se mutuo aspexerunt, mutuique eorum aspectus fuerunt totidem sagittae, quibus amantia eorum pectora transverberabantur.","prayer":"Amantissime Iesu, per acerbum dolorem, quem in hoc occursu expertus es, redde me, precor, sanctissimae Matri tuae vere devotum. Tu vero, perdolens mea Regina, intercede pro me, et obtine mihi talem cruciatum Filii tui memoriam, ut mens mea in pia illorum contemplatione perpetuo detineatur. Amo te, o Iesu, mi Amor; paenitet me quod tibi displicui. Ne sinas me iterum in te peccare. Da mihi perpetuum amorem tui, et dein fac de me quidquid tibi placuerit."},{"consider":"Considera quomodo Iudaei, videntes Iesum ad quemlibet passum animam propemodum prae lassitudine efflantem, et timentes ex altera parte ne, quem crucis supplicio affectum volebant, in via moreretur, compellant Simonem Cyrenaeum ad baiulandam crucem post Dominum.","prayer":"O dulcissime Iesu, nolo sicut Cyrenaeus repudiare crucem; libenter eam amplector in meque recipio, amplector speciatim quam mihi praefiniisti mortem cum omnibus, quos haec secum adductura est, doloribus. Coniungo eam cum morte tua, sicque coniunctam eam in sacrificium tibi offero. Tu amore mei mortuus es; volo ego quoque mori amore tui, ea mente ut rem tibi gratam faciam. Tu vero adiuva me tua gratia. Amo te, o Iesu, mi Amor; paenitet me quod tibi displicui. Ne sinas me iterum tibi displicere. Da mihi perpetuum amorem tui, et dein fac de me quidquid tibi placuerit."},{"consider":"Considera quomodo sancta illa femina Veronica, videns Iesum doloribus confectum eiusque vultum sudore ac sanguine madidum, porrigat ei linteolum in quo ipse, abstersa facie, sacram sui imaginem impressam relinquit.","prayer":"O mi Iesu, formosa erat antea facies tua; verum hac in via non amplius formosa apparet, sed est vulneribus et cruore omnino deformis. Hei mihi! quam formosa quoque erat anima mea, cum gratiam tuam per baptismum recepisset: peccando eam postea deformem reddidi. Tu solus, mi Redemptor, pristinam venustatem ei restituere vales; quod ut facias, per tuae Passionis meritum te precor. Amo te Iesu, mi Amor; paenitet me quod tibi displicui; ne sinas me iterum tibi displicere. Da mihi perpetuum amorem tui, et dein fac de me quidquid tibi placuerit."},{"consider":"Considera alterum Iesu Christi sub cruce lapsum, quo lapsu perdolenti Domino omnes venerandi capitis et totius corporis plagae recrudescunt, omnesque cruciatus renovantur.","prayer":"Mansuetissime Iesu, quam frequenter concessisti mihi veniam! Ego vero in eadem relapsus sum peccata, measque in te offensas renovavi. Per meritum novi huius tui lapsus adiuva me, ut in gratia tua usque ad obitum perseverem. Fac ut in omnibus, quae me invasurae sunt, tentationibus me tibi semper commendem. Amo te ex toto corde meo, o Iesu, mi Amor; paenitet me quod tibi displicui: ne sinas me iterum tibi displicere. Da mihi perpetuum amorem tui, et dein fac de me quidquid tibi placuerit."},{"consider":"Considera quomodo mulieres, videntes Iesum lassitudine exanimatum et cruore inter eundum diffluentem, commiseratione permoveantur, lacrimasque profundant. Ad flentes autem conversus: “Nolite, inquit, flere super me, sed super vos ipsas flete et super filios vestros.”","prayer":"O perdolens Iesu, defleo mea in te peccata ob poenas quidem quibus me dignum reddiderunt, sed maxime ob molestiam quam tibi intulerunt, tibi qui me tantopere amasti. Ad fletum minus infernus quam amor tui me excitat. O mi Iesu, amo te magis quam meipsum; paenitet me quod tibi displicui; ne sinas me iterum tibi displicere. Da mihi perpetuum amorem tui, et dein fac de me quidquid tibi placuerit."},{"consider":"Considera tertium Iesu Christi sub cruce lapsum. Procumbit quia nimia erat eius debilitas, et nimia saevitia carnificum, qui volebant ut gressum acceleraret, dum vix unum gradum facere posset.","prayer":"O inclementer habite Iesu, per meritum illius virium defectionis, qua in via ad Calvarium laborare voluisti, tanto, precor, me vigore conforta, ut nullum amplius ad humana iudicia respectum habeam, ac vitiosam meam naturam edomem: quod utrumque in causa fuit cur tuam olim amicitiam contempserim. Amo te, o Iesu, mi Amor, ex toto corde meo; paenitet me quod tibi displicui: ne sinas me iterum tibi displicere. Da mihi perpetuum amorem tui, et dein fac de me quidquid tibi placuerit."},{"consider":"Considera quam violenter Iesus vestimentis suis spolietur. Cum enim vestis interior arcte carni flagellis dilaniatae adhaereret, carnifices, avellendo vestem, cutem ei quoque avellunt. Subeat te commiseratio Domini tui, eumque sic alloquere.","prayer":"Innocentissime Iesu, per meritum doloris quem inter hanc spoliationem passus es, adiuva me, precor, ut omnem in res creatas affectum exuam, et tota voluntatis meae inclinatione ad te solum convertar, qui meo nimis dignus es amore. Amo te ex toto corde meo; paenitet me quod tibi displicui; ne sinas me iterum tibi displicere. Da mihi perpetuum amorem tui, et dein fac de me quidquid tibi placuerit."},{"consider":"Considera quomodo Iesus in crucem coniciatur, et extensis brachiis, vitam suam in sacrificium pro nostra salute aeterno Patri offerat. Carnifices clavis eum affigunt, dein erigunt crucem, et infami patibulo suffixum saevae morti permittunt.","prayer":"O contemptissime Iesu, affige pedibus tuis cor meum, ut amoris vinculo ligatum semper tecum remaneat, necque amplius a te avellatur. Amo te magis quam meipsum; paenitet me quod tibi displicui: ne permittas me iterum tibi displicere. Da mihi perpetuum amorem tui, et dein fac de me quidquid tibi placuerit."},{"consider":"Considera tuum cruci suffixum Iesum, qui post trium horarum cum morte luctam, doloribus tandem consumptus addicit corpus morti, et inclinato capite emittit spiritum.","prayer":"O mortue Iesu, exosculor, pietatis sensu intime commotus, hanc crucem in qua tu, mei causa, vitae tuae finem implevisti. Ob commissa peccata infelicem mihi mortem promerui; sed mors tua est spes mea. Per mortis tuae merita, concede mihi precor, ut in amplexu pedum tuorum extremum spiritum, tui amore flagrans, aliquando reddam. In manus tuas commendo spiritum meum. Amo te ex toto corde meo; paenitet me quod tibi displicui: ne sinas me iterum tibi displicere. Da mihi perpetuum amorem tui, et dein fac de me quidquid tibi placuerit."},{"consider":"Considera quomodo duo ex Iesu discipulis, Iosephus nempe et Nicodemus, eum exanimatum de cruce tollant et inter brachia perdolentis Matris reponant, quae mortuum Filium peramanter recipit et arcte complectitur.","prayer":"O moerens Mater, per amorem quo Filium tuum amas, accipe me in servum tuum et precare eum pro me. Tu vero, o mi Redemptor, quoniam pro me mortuus es, fac benigne ut amem te; te enim solum volo, nec extra te aliud quidpiam mihi opto. Amo te, o mi Iesu, paenitet me quod tibi displicui: ne sinas me iterum tibi displicere. Da mihi perpetuum amorem tui, et dein fac de me quidquid tibi placuerit."},{"consider":"Considera quomodo discipuli exanimem Redemptorem ad locum sepulturae deferant. Moerens Mater eos comitatur, et propriis manibus corpus Filii sepulturae accommodat. Sepulchrum dein occluditur, et omnes a loco recedunt.","prayer":"O sepulte Iesu, exosculor hunc, qui te recondit, lapidem; sed post triduum ex sepulcro resurges. Per tuam resurrectionem fac me, precor, extremo die gloriosum tecum resurgere, et venire in caelum, ubi tecum semper coniunctus, te laudabo et in aeternum amabo. Amo te, et doleo quod tibi displicui: ne sinas me iterum tibi displicere. Da mihi perpetuum amorem tui, et dein fac de me quidquid tibi placuerit."}],"fr":[{"consider":"Considérez comment Jésus, après avoir été flagellé et couronné d’épines, fut enfin injustement condamné par Pilate à mourir sur la Croix.","prayer":"Ô Jésus adorable, ce n’est pas Pilate, mais mes péchés qui Vous ont condamné à mort. Par les mérites de ce douloureux chemin que Vous entreprenez vers le Calvaire, je Vous supplie d’accompagner mon âme dans le chemin qui la conduit à l’éternité. Je Vous aime, ô Jésus, mon amour, plus que moi-même; je me repens de tout mon cœur de Vous avoir offensé. Ne permettez pas que je me sépare encore de Vous. Donnez-moi de Vous aimer toujours; et ensuite disposez de moi comme il Vous plaira."},{"consider":"Considérez comment Jésus-Christ, portant la Croix sur ses épaules, pensait à nous en chemin, et offrait pour nous à son Père éternel la mort qu’Il allait souffrir.","prayer":"Ô Jésus très aimable, j’embrasse toutes les adversités que Vous m’avez destinées jusqu’à la mort; et, par la douleur que Vous avez endurée en portant votre Croix, je Vous supplie de me donner les forces nécessaires pour porter la mienne avec une parfaite patience et résignation. Je Vous aime, Jésus mon amour; je me repens de Vous avoir offensé. Ne permettez pas que je me sépare encore de Vous. Donnez-moi de Vous aimer toujours; et ensuite disposez de moi comme il Vous plaira."},{"consider":"Considérez cette première chute de Jésus sous le poids de la Croix. Sa chair était déchirée par la flagellation, sa tête couronnée d’épines, et Il avait répandu tant de sang qu’Il pouvait à peine marcher. Cependant Il devait porter sur ses épaules ce pesant fardeau; les soldats Le poussaient sans pitié, et Il tomba ainsi plusieurs fois sur le chemin.","prayer":"Ô mon Jésus, ce n’est pas le poids de la Croix, mais celui de mes péchés qui Vous a causé tant de souffrances. Par les mérites de cette première chute, préservez-moi du malheur de tomber dans le péché mortel. Je Vous aime, ô Jésus, de tout mon cœur; je me repens de Vous avoir offensé. Ne permettez pas que je Vous offense encore. Donnez-moi de Vous aimer toujours; et ensuite disposez de moi comme il Vous plaira."},{"consider":"Considérez la rencontre du Fils et de la Mère sur ce chemin. Jésus et Marie se regardèrent, et leurs regards furent comme autant de flèches qui transpercèrent leurs Cœurs si tendrement unis.","prayer":"Ô Jésus très aimant, par la douleur que Vous avez éprouvée dans cette rencontre, accordez-moi la grâce d’un amour vraiment dévoué envers votre très sainte Mère. Et Vous, ô ma Reine, qui fûtes accablée de douleur, obtenez-moi par votre intercession un souvenir continuel et tendre de la Passion de votre Fils. Je Vous aime, Jésus mon amour; je me repens de Vous avoir offensé. Ne permettez pas que je Vous offense encore. Donnez-moi de Vous aimer toujours; et ensuite disposez de moi comme il Vous plaira."},{"consider":"Considérez comment les Juifs, voyant Jésus près d’expirer de faiblesse à chaque pas, craignirent qu’Il ne mourût en chemin, tandis qu’ils voulaient Le voir mourir de la mort ignominieuse de la Croix; ils contraignirent donc Simon de Cyrène à porter la Croix derrière Notre-Seigneur.","prayer":"Ô mon très doux Jésus, je ne veux pas refuser la Croix comme le Cyrénéen; je l’accepte, je l’embrasse. J’accepte en particulier la mort que Vous m’avez destinée, avec toutes les douleurs qui pourront l’accompagner; je l’unis à votre mort et je Vous l’offre. Vous êtes mort par amour pour moi; je veux mourir par amour pour Vous et pour Vous plaire. Aidez-moi de votre grâce. Je Vous aime, Jésus mon amour; je me repens de Vous avoir offensé. Ne permettez pas que je Vous offense encore. Donnez-moi de Vous aimer toujours; et ensuite disposez de moi comme il Vous plaira."},{"consider":"Considérez comment la sainte femme nommée Véronique, voyant Jésus si affligé et son visage baigné de sueur et de sang, Lui présenta un linge avec lequel Il essuya son adorable Face, y laissant empreinte son image sacrée.","prayer":"Ô mon Jésus très aimé, votre Face était belle auparavant; mais sur ce chemin les blessures et le sang l’ont entièrement défigurée. Hélas! mon âme aussi était belle lorsqu’elle reçut votre grâce au Baptême; mais je l’ai défigurée par mes péchés. Vous seul, ô mon Rédempteur, pouvez lui rendre sa première beauté. Faites-le par les mérites de votre Passion. Je Vous aime, Jésus mon amour; je me repens de Vous avoir offensé. Ne permettez pas que je Vous offense encore. Donnez-moi de Vous aimer toujours; et ensuite disposez de moi comme il Vous plaira."},{"consider":"Considérez la seconde chute de Jésus sous la Croix, chute qui renouvelle la douleur de toutes les plaies de la tête et des membres de Notre-Seigneur affligé.","prayer":"Ô mon très doux Jésus, combien de fois Vous m’avez pardonné, et combien de fois suis-je retombé dans les mêmes fautes et ai-je recommencé à Vous offenser! Par les mérites de cette nouvelle chute, donnez-moi les secours nécessaires pour persévérer dans votre grâce jusqu’à la mort. Accordez que, dans toutes les tentations qui m’assailliront, je me recommande toujours à Vous. Je Vous aime, Jésus mon amour, de tout mon cœur; je me repens de Vous avoir offensé. Ne permettez pas que je Vous offense encore. Donnez-moi de Vous aimer toujours; et ensuite disposez de moi comme il Vous plaira."},{"consider":"Considérez comment ces femmes, voyant Jésus épuisé et couvert de sang sur son chemin, pleuraient de compassion. Mais Jésus, se tournant vers elles, leur dit: « Ne pleurez pas sur Moi, mais pleurez sur vous-mêmes et sur vos enfants. »","prayer":"Ô Jésus chargé de douleurs, je pleure les offenses que j’ai commises contre Vous, à cause des peines qu’elles ont méritées, mais plus encore à cause du déplaisir qu’elles Vous ont causé, à Vous qui m’avez tant aimé. C’est votre amour, plus que la crainte de l’enfer, qui me fait pleurer mes péchés. Mon Jésus, je Vous aime plus que moi-même; je me repens de Vous avoir offensé. Ne permettez pas que je Vous offense encore. Donnez-moi de Vous aimer toujours; et ensuite disposez de moi comme il Vous plaira."},{"consider":"Considérez la troisième chute de Jésus-Christ. Sa faiblesse était extrême, et excessive la cruauté de ses bourreaux, qui voulaient hâter ses pas alors qu’Il avait à peine la force de se mouvoir.","prayer":"Ô Jésus si cruellement traité, par les mérites de cette faiblesse que Vous avez voulu souffrir sur le chemin du Calvaire, donnez-moi assez de force pour vaincre tout respect humain et toutes mes passions mauvaises, qui m’ont autrefois conduit à mépriser votre amitié. Je Vous aime, Jésus mon amour, de tout mon cœur; je me repens de Vous avoir offensé. Ne permettez pas que je Vous offense encore. Donnez-moi de Vous aimer toujours; et ensuite disposez de moi comme il Vous plaira."},{"consider":"Considérez avec quelle violence les bourreaux dépouillèrent Jésus de ses vêtements. Sa tunique intérieure adhérait à sa chair déchirée, et ils l’arrachèrent avec tant de rudesse qu’ils emportèrent avec elle la peau de ses plaies. Ayez compassion de votre Sauveur ainsi cruellement traité.","prayer":"Ô Jésus innocent, par les mérites de ce tourment, aidez-moi à me dépouiller de toute affection aux choses de la terre, afin que je place tout mon amour en Vous, qui êtes si digne d’être aimé. Je Vous aime, ô Jésus, de tout mon cœur; je me repens de Vous avoir offensé. Ne permettez pas que je Vous offense encore. Donnez-moi de Vous aimer toujours; et ensuite disposez de moi comme il Vous plaira."},{"consider":"Considérez comment Jésus, étendu sur la Croix, ouvre ses mains et offre à son Père éternel le sacrifice de sa vie pour notre salut. Ses bourreaux L’y attachent avec des clous; puis, ayant élevé la Croix, ils Le laissent mourir dans les angoisses sur ce gibet infâme.","prayer":"Ô mon Jésus accablé d’opprobres, attachez mon cœur à vos pieds, afin qu’il y demeure toujours pour Vous aimer et ne Vous quitte jamais. Je Vous aime plus que moi-même; je me repens de Vous avoir offensé. Ne permettez pas que je Vous offense encore. Donnez-moi de Vous aimer toujours; et ensuite disposez de moi comme il Vous plaira."},{"consider":"Considérez Jésus crucifié qui, après trois heures d’agonie sur la Croix, consumé enfin par les douleurs, abandonne son Corps à la mort, incline la tête et rend l’esprit.","prayer":"Ô mon Jésus mourant, je baise avec dévotion la Croix sur laquelle Vous êtes mort par amour pour moi. Par mes péchés, j’ai mérité une mort malheureuse; mais votre mort est mon espérance. Par les mérites de votre mort, accordez-moi la grâce de mourir en embrassant vos pieds et brûlant d’amour pour Vous. Je remets mon âme entre vos mains. Je Vous aime de tout mon cœur; je me repens de Vous avoir offensé. Ne permettez pas que je Vous offense encore. Donnez-moi de Vous aimer toujours; et ensuite disposez de moi comme il Vous plaira."},{"consider":"Considérez comment, après la mort de Notre-Seigneur, deux de ses disciples, Joseph et Nicodème, Le descendirent de la Croix et Le déposèrent dans les bras de sa Mère affligée, qui reçut son Fils mort avec une tendresse inexprimable et Le pressa contre son Cœur.","prayer":"Ô Mère des douleurs, par l’amour que Vous portez à votre Fils, recevez-moi pour votre serviteur et priez-Le pour moi. Et Vous, ô mon Rédempteur, puisque Vous êtes mort pour moi, permettez-moi de Vous aimer; car je ne veux que Vous et rien de plus. Je Vous aime, ô mon Jésus; je me repens de Vous avoir offensé. Ne permettez pas que je Vous offense encore. Donnez-moi de Vous aimer toujours; et ensuite disposez de moi comme il Vous plaira."},{"consider":"Considérez comment les disciples portèrent le Corps de Jésus au lieu de sa sépulture. Sa Mère affligée les accompagna et, de ses propres mains, disposa le Corps de son Fils dans le tombeau. Le sépulcre fut ensuite fermé, et tous se retirèrent.","prayer":"Ô Jésus enseveli, je baise la pierre qui Vous renferme. Mais Vous ressusciterez le troisième jour. Par votre Résurrection, faites, je Vous en supplie, que je ressuscite glorieux avec Vous au dernier jour et que j’aille au ciel, où, toujours uni à Vous, je Vous louerai et Vous aimerai éternellement. Je Vous aime et je me repens de Vous avoir offensé. Ne permettez pas que je Vous offense encore. Donnez-moi de Vous aimer toujours; et ensuite disposez de moi comme il Vous plaira."}]},"exam":{"title":"Ten Commandments","intro":"Review your freely chosen actions and omissions since your last Confession.","sections":[["1 · God first",["Have I neglected prayer or knowingly rejected the faith?","Have I placed superstition, divination, money or approval above trust in God?"]],["2 · Reverence",["Have I used God’s name contemptuously or sworn falsely?","Have I treated sacred things irreverently?"]],["3 · Worship and rest",["Have I deliberately missed Sunday Mass or a binding holy day without a serious reason?","Have I needlessly prevented others from worship or reasonable rest?"]],["4 · Family and authority",["Have I neglected care, respect or just responsibilities within my family?","Have I misused authority, manipulated another person or demanded unjust obedience?"]],["5 · Life and charity",["Have I deliberately harmed someone, encouraged violence or chosen revenge?","Have I neglected reasonable care for life and health, or help I was responsible for giving?"]],["6 · Chastity and fidelity",["Have I freely chosen sexual acts contrary to chastity, pornography or infidelity?","Have I treated another person as an object rather than respected their dignity?"]],["7 · Justice",["Have I stolen, cheated, withheld just payment or misused property entrusted to me?","Have I refused to repair financial harm when able?"]],["8 · Truth",["Have I lied, slandered, gossiped unjustly or betrayed a confidence?","Have I failed to correct a falsehood or restore a reputation I harmed?"]],["9 · Purity of heart",["Have I deliberately cultivated desires contrary to fidelity and chastity?","Distinguish an unwanted thought or temptation from a deliberate choice to entertain it."]],["10 · Detachment",["Have I allowed envy or greed to govern my choices?","Have I resented another person’s good or neglected generosity within my means?"]]]},"examFr":{"intro":"Repassez devant Dieu les actes et omissions librement choisis depuis votre dernière bonne confession.","sections":[["1 · Dieu d’abord",["Ai-je négligé la prière ou rejeté sciemment la foi ?","Ai-je placé la superstition, la divination, l’argent ou l’approbation humaine au-dessus de la confiance en Dieu ?"]],["2 · Révérence",["Ai-je employé le nom de Dieu avec mépris ou fait un faux serment ?","Ai-je traité les choses sacrées sans respect ?"]],["3 · Culte et repos",["Ai-je manqué délibérément la Messe du dimanche ou un jour d’obligation sans raison grave ?","Ai-je empêché sans nécessité d’autres personnes d’accomplir leur devoir religieux ou de prendre un repos raisonnable ?"]],["4 · Famille et autorité",["Ai-je négligé le soin, le respect ou les responsabilités justes dans ma famille ?","Ai-je abusé de mon autorité, manipulé quelqu’un ou exigé une obéissance injuste ?"]],["5 · Vie et charité",["Ai-je volontairement fait du tort à quelqu’un, encouragé la violence ou choisi la vengeance ?","Ai-je négligé le soin raisonnable de la vie et de la santé, ou l’aide que j’avais le devoir de donner ?"]],["6 · Chasteté et fidélité",["Ai-je librement choisi des actes contraires à la chasteté, la pornographie ou l’infidélité ?","Ai-je traité une personne comme un objet au lieu de respecter sa dignité ?"]],["7 · Justice",["Ai-je volé, trompé, retenu un juste salaire ou mal employé un bien qui m’était confié ?","Ai-je refusé de réparer un dommage matériel alors que je le pouvais ?"]],["8 · Vérité",["Ai-je menti, calomnié, médit injustement ou trahi une confidence ?","Ai-je omis de corriger une fausseté ou de réparer une réputation que j’avais lésée ?"]],["9 · Pureté du cœur",["Ai-je volontairement entretenu des désirs contraires à la fidélité et à la chasteté ?","Je distingue une pensée ou tentation non voulue du choix délibéré de l’entretenir."]],["10 · Détachement",["Ai-je laissé l’envie ou l’avidité gouverner mes choix ?","Ai-je regretté le bien d’autrui ou négligé la générosité selon mes moyens ?"]]]}};
window.AO_PRAY_CANONICAL_DATA_V435930=D;
const root=document.createElement('div');root.id='aoPrayerBookRoot';root.setAttribute('aria-hidden','true');document.body.appendChild(root);
const S={view:'hub',prayer:null,query:'',confStep:0,rosarySet:null,rosaryStep:0,rosaryForm:'standard',station:0,stationMode:'guided',benedictionStep:0,angelusOverride:null,angelusConclusion:false};
let externalReturn=null;
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function lang(){try{const x=JSON.parse(localStorage.getItem('ao2:settings:v1')||'{}');return x.language==='fr'?'fr':'en'}catch{return 'en'}}
const t=(en,fr)=>lang()==='fr'?fr:en;
function top(title,sub=t('Traditional prayer book','Livre de prières traditionnel')){return `<header class="pbTop aoHasModuleHome"><button data-pb-back aria-label="${t('Back','Retour')}">←</button><div><small>${esc(sub)}</small><h1>${esc(title)}</h1></div><button type="button" class="aoModuleHome" data-app-home aria-label="${t('Return to Home','Retour à l’accueil')}">⌂</button><span class="pbLangBadge">${lang().toUpperCase()}</span></header>`}
function source(p){const raw=String(p?.source||'').trim(),internal=/lab-ora/i.test(raw),label=internal?'':raw,note=String(p?.note||'').trim(),url=internal?'':String(p?.sourceUrl||'').trim();if(!label&&!note&&!url)return'';return `<details class="aoSourceDisclosure pbSourceCompact"><summary>${label?`${t('Source','Source')} · ${esc(label)}`:t('Source','Source')}</summary><div class="aoSourceDetail">${note?`<p>${esc(note)}</p>`:''}<div class="aoSourceActions">${url?`<a href="${esc(url)}" target="_blank" rel="noopener">${t('View source','Voir la source')} ↗</a>`:''}<button type="button" data-v25-destination="sources">${t('Sources & editions','Sources & éditions')}</button></div></div></details>`}
function flipText(la,vern,id='main',face=null){const v=vern||'';if(!la)return `<div class="pbPrayerText" style="cursor:default">${esc(v)}</div>`;return `<button class="pbPrayerText" data-pb-flip="${esc(id)}" data-face="latin"><span data-pb-latin>${esc(la)}</span><span data-pb-vern hidden>${esc(v)}</span></button><div class="pbFlipHint" data-pb-flip-hint>${t('Tap the text · show English','Touchez le texte · afficher le français')}</div>`}
function prayerTitle(p){return lang()==='fr'?(p.titleFr||p.title):p.title}
function open(opts={}){externalReturn=opts.returnContext||null;S.view='hub';S.prayer=null;render();root.classList.add('open');root.setAttribute('aria-hidden','false');document.body.style.overflow='hidden'}
function close(opts={}){root.classList.remove('open');root.setAttribute('aria-hidden','true');document.body.style.overflow='';S.view='hub';const ret=externalReturn;externalReturn=null;if(!opts.silent&&ret)queueMicrotask(()=>window.AO_NAV_V362?.restore?.(ret))}
function go(v){S.view=v;render();root.scrollTo(0,0)}
function back(){if(externalReturn)return close();if(S.view==='hub')return close();if(S.view==='prayer')return go('hub');if(['confession','rosary','angelus','stations','benediction'].includes(S.view))return go('hub');go('hub')}
function openModule(id,opts={}){open(opts);if(id==='confession')S.confStep=0;if(id==='rosary'){S.rosarySet=null;S.rosaryStep=0}if(id==='stations')S.station=0;if(id==='benediction')S.benedictionStep=0;if(['confession','rosary','angelus','stations','benediction'].includes(id)){go(id);return true}return false}
function openPrayer(id,opts={}){if(!D.prayers[id])return false;open(opts);S.prayer=id;go('prayer');return true}
function renderHub(){const q=S.query.trim().toLowerCase();const cats=Object.entries(D.categories).map(([id,n])=>{let ps=Object.values(D.prayers).filter(p=>p.category===id);if(q)ps=ps.filter(p=>[p.title,p.titleFr,p.en,p.fr,p.la].join(' ').toLowerCase().includes(q));if(!ps.length)return'';return `<section class="pbSection"><div class="pbSectionHead"><h2>${esc(n[lang()]||n.en)}</h2><small>${ps.length}</small></div><div class="pbPrayerGrid">${ps.map(p=>`<button class="pbPrayerCard" data-pb-prayer="${esc(p.id)}"><strong>${esc(prayerTitle(p))}</strong><span>${p.la?t('Latin first · tap for English','Latin d’abord · toucher pour le français'):t('Vernacular text','Texte vernaculaire')}</span></button>`).join('')}</div></section>`}).join('');
return `<div class="pbShell">${top(t('Prayer Book','Livre de prières'))}<section class="pbHero"><div class="eyebrow">AD ORIENTEM · TLM</div><h2>${t('Pray the tradition around the Mass','Prier dans la tradition autour de la Messe')}</h2><p>${t('Confession, Rosary, Angelus, the XIV Stations and a curated treasury of prayers commonly used in traditional Latin-Rite life. Latin prayer texts flip in place to the current vernacular when tapped.','Confession, Rosaire, Angélus, XIV Stations et trésor de prières couramment utilisées dans la vie traditionnelle du rite latin. Les textes latins se remplacent sur place par le français lorsque vous les touchez.')}</p></section>
<div class="pbModuleGrid"><button class="pbModule featured" data-pb-module="confession"><strong>${t('Confession','Confession')}</strong><span>${t('Examine · confess · receive absolution · amend','Examen · confession · absolution · amendement')}</span></button><button class="pbModule featured" data-pb-module="rosary"><strong>${t('Holy Rosary','Saint Rosaire')}</strong><span>${t('Traditional three-set cycle · guided decades','Cycle traditionnel à trois séries · dizaines guidées')}</span></button><button class="pbModule" data-pb-module="angelus"><strong>${t('Angelus / Regina Cæli','Angélus / Regina Cæli')}</strong><span>${t('Full traditional text · season-aware','Texte traditionnel complet · selon le temps liturgique')}</span></button><button class="pbModule" data-pb-module="stations"><strong>${t('Stations of the Cross','Chemin de Croix')}</strong><span>${t('St Alphonsus · traditional XIV Stations','Saint Alphonse · XIV Stations traditionnelles')}</span></button><button class="pbModule" data-pb-module="benediction"><strong>${t('Benediction prayers','Prières de la bénédiction')}</strong><span>O Salutaris · Tantum Ergo · ${t('Divine Praises','Louanges divines')}</span></button><button class="pbModule" data-pb-existing="prepare"><strong>${t('Before Mass','Avant la Messe')}</strong><span>${t('Open the existing sourced preparation module','Ouvrir le module sourcé de préparation')}</span></button><button class="pbModule" data-pb-existing="thanks"><strong>${t('After Mass','Après la Messe')}</strong><span>${t('Open the existing thanksgiving module','Ouvrir le module d’action de grâces')}</span></button><button class="pbModule v38TraditionsLauncher" data-v38-open="learn.traditions"><strong>${t('Traditions & Rites','Traditions & rites')}</strong><span>${t('Seasonal practice · old/current rites · pilgrimage · discipline','Pratique saisonnière · rites anciens/actuels · pèlerinage · discipline')}</span></button></div>
<input class="pbSearch" data-pb-search value="${esc(S.query)}" placeholder="${t('Search prayers…','Rechercher une prière…')}" aria-label="${t('Search prayers','Rechercher des prières')}">${cats||`<div class="pbNoResults">${t('No matching prayers.','Aucune prière correspondante.')}</div>`}<div class="pbSource">${t('Editorial rule: this library defaults to the traditional corpus. Later additions are included only when identified as such; for example, the Luminous Mysteries are marked as the optional 2002 addition, and the current Litany of Loreto is kept distinct from the 1962-era form.','Règle éditoriale : cette bibliothèque privilégie le corpus traditionnel. Les ajouts postérieurs ne sont inclus que lorsqu’ils sont clairement signalés ; par exemple, les Mystères lumineux sont indiqués comme ajout facultatif de 2002, et les Litanies de Lorette actuelles restent distinctes de la forme de l’époque de 1962.')}</div></div>`}
function renderPrayer(){const p=D.prayers[S.prayer];if(!p)return go('hub');return `<div class="pbShell"><div class="pbReader">${top(prayerTitle(p))}<div class="pbMeta"><span class="pbTag">${p.la?'LAT → '+lang().toUpperCase():lang().toUpperCase()}</span><span class="pbTag">${esc(D.categories[p.category]?.[lang()]||'')}</span></div>${flipText(p.la,p[lang()]||p.en)}${source(p)}</div></div>`}
function currentDate(){return new Date()}
function easter(y){const a=y%19,b=Math.floor(y/100),c=y%100,d=Math.floor(b/4),e=b%4,f=Math.floor((b+8)/25),g=Math.floor((b-f+1)/3),h=(19*a+b-d-g+15)%30,i=Math.floor(c/4),k=c%4,l=(32+2*e+2*i-h-k)%7,m=Math.floor((a+11*h+22*l)/451),month=Math.floor((h+l-7*m+114)/31)-1,day=(h+l-7*m+114)%31+1;return new Date(y,month,day)}
function paschal(){const d=currentDate(),e=easter(d.getFullYear()),p=new Date(e);p.setDate(p.getDate()+49);return d>=e&&d<=p}
function suggestedMystery(){const d=currentDate(),dow=d.getDay();if(dow===1||dow===4)return'joyful';if(dow===2||dow===5)return'sorrowful';if(dow===3||dow===6)return'glorious';const e=easter(d.getFullYear()),ash=new Date(e);ash.setDate(ash.getDate()-46);const adv=new Date(d.getFullYear(),11,25);while(adv.getDay()!==0)adv.setDate(adv.getDate()-1);adv.setDate(adv.getDate()-21);if(d>=ash&&d<e)return'sorrowful';if(d>=adv||d<new Date(d.getFullYear(),0,7))return'joyful';return'glorious'}
function renderAngelus(){const useRegina=S.angelusOverride?S.angelusOverride==='regina':paschal(),x=useRegina?D.regina:D.angelus;const appendix=!useRegina&&S.angelusConclusion?`<div class="pbMiniPrayer"><div class="pbKicker">${t('Optional traditional conclusion','Conclusion traditionnelle facultative')}</div>${flipText(D.angelusAppendix.la,D.angelusAppendix[lang()],'angelus-appendix',false)}</div>`:'';return `<div class="pbShell"><div class="pbReader">${top(useRegina?'Regina Cæli':'Angelus')}<div class="pbContextNotice">${useRegina?t('Paschaltide: Regina Cæli is shown in place of the Angelus. It is customarily prayed standing.','Temps pascal : le Regina Cæli est proposé à la place de l’Angélus. Il se prie traditionnellement debout.'):t('Traditional practice: morning, noon and evening. Older prayer books commonly direct kneeling, with Sunday and Paschal exceptions; legitimate local custom prevails.','Pratique traditionnelle : matin, midi et soir. Les anciens livres de prières indiquent souvent de s’agenouiller, avec des exceptions le dimanche et au temps pascal ; suivez l’usage local légitime.')}</div>${flipText(x.la,x[lang()],'angelus-main',false)}${!useRegina?`<label class="pbContextNotice" style="display:flex;gap:10px;align-items:center"><input type="checkbox" data-pb-angelus-conclusion ${S.angelusConclusion?'checked':''}> <span>${t('Add the traditional conclusion: three Gloria Patri, prayer for the faithful departed, and Divinum auxilium','Ajouter la conclusion traditionnelle : trois Gloria Patri, prière pour les fidèles défunts et Divinum auxilium')}</span></label>${appendix}`:''}<div class="pbFlowNav"><button data-pb-toggle-angelus>${useRegina?t('Show Angelus instead','Afficher plutôt l’Angélus'):t('Show Regina Cæli instead','Afficher plutôt le Regina Cæli')}</button></div><div class="pbSource"><strong>${t('Tradition / current clarification','Tradition / précision actuelle')}</strong><br>${t('The Angelus and Regina Cæli are devotions rather than parts of the Mass. Traditional sources document the posture customs; the three Gloria Patri are presented as an optional historical conclusion, not a condition of the prayer.','L’Angélus et le Regina Cæli sont des dévotions et non des parties de la Messe. Les sources traditionnelles documentent les usages de posture ; les trois Gloria Patri sont présentés comme une conclusion historique facultative, non comme une condition de la prière.')}</div></div></div>`}
function renderConfession(){const l=lang(),exam=l==='fr'?D.examFr:D.exam;const steps=l==='fr'?[['Réception','Suivez le prêtre. Faites le signe de la Croix selon l’usage.'],['Commencez simplement','« Mon Père, bénissez-moi parce que j’ai péché. Je ne me suis pas confessé depuis… » est une formule traditionnelle courante, non un script obligatoire.'],['Confessez vos péchés','Confessez d’abord les péchés mortels dont vous vous souvenez, selon leur espèce et leur nombre approximatif autant que possible ; puis les autres péchés que vous désirez accuser.'],['Conseil et pénitence','Écoutez le conseil du prêtre et acceptez la satisfaction ou pénitence.'],['Acte du pénitent','Exprimez votre contrition lorsque le prêtre vous y invite.'],['Absolution','Le prêtre seul donne l’absolution sacramentelle. Écoutez et répondez Amen.'],['Renvoi','Recevez le sacrement comme achevé ; ne recommencez pas immédiatement votre examen en sortant.'],['Après','Remerciez Dieu, accomplissez rapidement la pénitence et réparez le tort concret lorsque la justice l’exige.']]:[['Reception','Follow the priest. Make the Sign of the Cross as directed or customary.'],['Begin simply','“Bless me, Father, for I have sinned. My last Confession was … ago.” is a common traditional opening, not a mandatory script.'],['Confess your sins','Confess remembered mortal sins first, by kind and approximate number as best you can; then other sins you wish to bring.'],['Counsel and penance','Listen to the priest’s counsel and accept the satisfaction or penance given.'],['Prayer of the penitent','Express contrition when invited.'],['Absolution','The priest alone gives sacramental absolution. Listen attentively and answer Amen.'],['Dismissal','Receive the sacrament as complete; do not restart the examination as you leave.'],['Afterwards','Thank God, perform the assigned penance promptly, and make concrete repair where justice requires it.']];const st=steps[S.confStep];const act=D.prayers.sacrament_act_of_contrition;return `<div class="pbShell"><div class="pbFlow">${top(t('Confession','Confession'))}<section class="pbHero"><div class="eyebrow">${t('Prepare · confess · give thanks','Préparer · confesser · rendre grâce')}</div><h2>${t('A practical companion, not a substitute for the priest','Un compagnon pratique, non un substitut au prêtre')}</h2><p>${t('Current sacramental law and the traditional devotional manner are kept distinct. The app does not simulate absolution.','La discipline sacramentelle actuelle et la manière dévotionnelle traditionnelle restent distinctes. L’application ne simule jamais l’absolution.')}</p></section><details class="pbInfoDetails" open><summary>${t('Examination of conscience','Examen de conscience')}</summary><p class="pbLead">${esc(exam.intro)}</p><div class="pbExam">${exam.sections.map(s=>`<details><summary>${esc(s[0])}</summary><ul>${s[1].map(q=>`<li>${esc(q)}</li>`).join('')}</ul></details>`).join('')}</div></details><div class="pbProgress"><span style="width:${((S.confStep+1)/steps.length*100).toFixed(1)}%"></span></div><section class="pbFlowCard"><div class="pbKicker">${S.confStep+1} / ${steps.length}</div><h2>${esc(st[0])}</h2><p>${esc(st[1])}</p>${S.confStep===4?`<div class="pbMiniPrayer">${flipText(act.la,act[l]||act.en,'conf-act')}</div>`:''}</section><nav class="pbFlowNav"><button data-pb-conf-prev ${S.confStep===0?'disabled':''}>← ${t('Previous','Précédent')}</button><button data-pb-conf-next>${S.confStep===steps.length-1?t('Finish','Terminer'):t('Next','Suivant')} →</button></nav><div class="pbSource"><strong>${t('Current Church discipline','Discipline actuelle de l’Église')}</strong><br>${t('Catechism §§1450–1460; CIC canons 987–988. The traditional opening formula is customary rather than mandatory.','Catéchisme §§1450–1460 ; CIC canons 987–988. La formule traditionnelle d’ouverture relève de l’usage et n’est pas obligatoire.')}<br><a href="https://www.vatican.va/archive/cod-iuris-canonici/eng/documents/cic_lib4-cann959-997_en.html" target="_blank" rel="noopener">CIC ↗</a></div></div></div>`}
function rosaryNames(){return lang()==='fr'?{joyful:['L’Annonciation','La Visitation','La Nativité','La Présentation','Le Recouvrement de Jésus au Temple'],sorrowful:['L’Agonie au jardin','La Flagellation','Le Couronnement d’épines','Le Portement de la Croix','La Crucifixion'],glorious:['La Résurrection','L’Ascension','La Descente du Saint-Esprit','L’Assomption','Le Couronnement de Marie'],luminous:['Le Baptême du Seigneur','Les Noces de Cana','L’Annonce du Royaume','La Transfiguration','L’Institution de l’Eucharistie']}:{joyful:D.mysteries.joyful,sorrowful:D.mysteries.sorrowful,glorious:D.mysteries.glorious,luminous:D.mysteries.luminous}}
function prayerBundle(keys){const l=lang(),rp=D.rosaryPrayers,parts=keys.map(k=>({la:rp.la[k][1],v:rp[l][k][1],label:rp[l][k][0]}));return parts.map((p,i)=>`<div class="pbMiniPrayer"><div class="pbKicker">${esc(p.label)}</div>${flipText(p.la,p.v,'rb'+i,false)}</div>`).join('')}
function renderRosary(){if(!S.rosarySet){const sug=suggestedMystery();return `<div class="pbShell"><div class="pbFlow">${top(t('Holy Rosary','Saint Rosaire'))}<section class="pbHero"><div class="eyebrow">${t('Traditional cycle','Cycle traditionnel')}</div><h2>${t('Choose the mysteries','Choisissez les mystères')}</h2><p>${t('The three traditional sets are primary. The Luminous Mysteries are available separately as the optional 2002 addition proposed by St John Paul II.','Les trois séries traditionnelles sont prioritaires. Les Mystères lumineux restent disponibles séparément comme ajout facultatif proposé en 2002 par saint Jean-Paul II.')}</p></section><div class="pbModuleGrid">${['joyful','sorrowful','glorious'].map(k=>`<button class="pbModule ${k===sug?'featured':''}" data-pb-rosary-set="${k}"><strong>${esc({joyful:t('Joyful','Joyeux'),sorrowful:t('Sorrowful','Douloureux'),glorious:t('Glorious','Glorieux')}[k])}</strong><span>${k===sug?t('Suggested today · ','Suggérés aujourd’hui · '):''}${rosaryNames()[k].join(' · ')}</span></button>`).join('')}<button class="pbModule" data-pb-rosary-set="luminous"><strong>${t('Luminous · optional','Lumineux · facultatifs')}</strong><span>${t('Added to the traditional pattern in 2002','Ajout proposés au schéma traditionnel en 2002')}</span></button></div><div class="pbSource"><strong>${t('Traditional / modern distinction','Distinction tradition / développement moderne')}</strong><br>${t('Ad Orientem defaults to the pre-2002 three-set Rosary cycle. Luminous Mysteries are not removed; they are simply identified accurately as the later optional addition.','Ad Orientem privilégie le cycle du Rosaire à trois séries antérieur à 2002. Les Mystères lumineux ne sont pas supprimés ; ils sont simplement identifiés comme l’ajout facultatif ultérieur.')}<br><a href="https://www.vatican.va/content/john-paul-ii/en/apost_letters/2002/documents/hf_jp-ii_apl_20021016_rosarium-virginis-mariae.html" target="_blank" rel="noopener">Rosarium Virginis Mariae ↗</a></div></div></div>`}
const set=S.rosarySet,names=rosaryNames()[set],total=7,i=S.rosaryStep;let body='';if(i===0)body=`<div class="pbKicker">${t('Opening','Ouverture')}</div><h2>${t('Begin the Rosary','Commencez le Rosaire')}</h2>${prayerBundle(['sign','credo','pater'])}<div class="pbContextNotice">${t('Then: three Hail Marys and one Glory Be.','Puis : trois Ave Maria et un Gloria Patri.')}</div>${prayerBundle(['ave','gloria'])}`;else if(i<=5){const n=i-1;body=`<div class="pbKicker">${t('Mystery','Mystère')} ${i} / 5</div><div class="pbMysteryTitle">${esc(names[n])}</div><p>${t('Announce the mystery; pause briefly to contemplate it. Then pray the decade.','Annoncez le mystère ; faites une brève pause pour le contempler. Puis priez la dizaine.')}</p>${prayerBundle(['pater'])}<div class="pbCounter">${Array.from({length:10},()=>'<i></i>').join('')}</div>${prayerBundle(['ave','gloria','fatima'])}`;}else body=`<div class="pbKicker">${t('Conclusion','Conclusion')}</div><h2>${t('Conclude the Rosary','Concluez le Rosaire')}</h2><div class="pbMiniPrayer">${flipText(D.salve.la,D.salve[lang()],'salve',false)}</div><div class="pbMiniPrayer">${flipText(D.rosaryCollect.la,D.rosaryCollect[lang()],'collect',false)}</div>`;return `<div class="pbShell"><div class="pbFlow">${top(t('Holy Rosary','Saint Rosaire'))}<div class="pbProgress"><span style="width:${((i+1)/total*100).toFixed(1)}%"></span></div><section class="pbFlowCard">${body}</section><nav class="pbFlowNav"><button data-pb-rosary-prev ${i===0?'disabled':''}>← ${t('Previous','Précédent')}</button><button data-pb-rosary-next>${i===total-1?t('Finish','Terminer'):t('Next','Suivant')} →</button></nav><button class="pbSecondary" data-pb-rosary-change style="margin-top:10px">${t('Change mysteries','Changer de mystères')}</button></div></div>`}
function renderStations(){const i=S.station,l=lang(),titles=D.stationTitles[l]||D.stationTitles.en;if(i===0)return `<div class="pbShell"><div class="pbFlow">${top(t('Stations of the Cross','Chemin de Croix'))}<section class="pbHero"><div class="eyebrow">VIA CRUCIS · XIV</div><h2>${t('St Alphonsus Liguori','Saint Alphonse de Liguori')}</h2><p>${t('Pray the traditional fourteen Stations in the St Alphonsus form. Guided includes the meditation and devotional prayer; Simple keeps the station, versicle/response and ordinary station prayers.','Priez les quatorze Stations traditionnelles selon la forme de saint Alphonse. Le mode guidé ajoute la méditation et la prière dévotionnelle ; le mode simple conserve la station, le verset/répons et les prières ordinaires.')}</p></section><div class="pbModuleGrid"><button class="pbModule ${S.stationMode==='guided'?'featured':''}" data-pb-station-mode="guided"><strong>${t('Guided','Guidé')}</strong><span>${t('St Alphonsus meditation + prayer','Méditation + prière de saint Alphonse')}</span></button><button class="pbModule ${S.stationMode==='simple'?'featured':''}" data-pb-station-mode="simple"><strong>${t('Simple','Simple')}</strong><span>Pater · Ave · Gloria</span></button></div><button class="pbPrimary" data-pb-station-next>${t('Begin the XIV Stations','Commencer les XIV Stations')} →</button><div class="pbSource"><strong>${t('Sources','Sources')}</strong><br>St Alphonsus Maria de Liguori · <em>Way of the Cross</em> (1787). ${t('English devotional form based on the 1888 Baltimore Manual witness; the French rendering is retained as a separately source-audited traditional-register translation.','Forme dévotionnelle anglaise fondée sur le témoin du Manual de Baltimore de 1888 ; la version française est conservée comme traduction en registre traditionnel auditée séparément.')}</div></div></div>`;const n=i-1,a=D.alphonsus[l]||D.alphonsus.en,vr=D.stationVR,ala=D.alphonsus.la;const guided=S.stationMode==='guided'?`<h3>${t('Consider','Considérez')}</h3><p>${esc(a[n].consider)}</p><h3>${t('Prayer of St Alphonsus','Prière de saint Alphonse')}</h3>${flipText(ala[n].prayer,a[n].prayer,'station-alphonsus-'+n,false)}`:'';return `<div class="pbShell"><div class="pbFlow">${top(t('Stations of the Cross','Chemin de Croix'))}<div class="pbProgress"><span style="width:${(i/14*100).toFixed(1)}%"></span></div><section class="pbFlowCard"><div class="pbKicker">${['I','II','III','IV','V','VI','VII','VIII','IX','X','XI','XII','XIII','XIV'][n]} · XIV</div><h2>${esc(titles[n])}</h2><div class="pbMiniPrayer">${flipText(vr.la.join('\n'),vr[l].join('\n'),'station-vr-'+n,false)}</div>${guided}<div class="pbContextNotice">${t('Traditional station prayers: Pater noster · Ave Maria · Gloria Patri.','Prières traditionnelles de la station : Pater noster · Ave Maria · Gloria Patri.')}</div>${prayerBundle(['pater','ave','gloria'])}</section><nav class="pbFlowNav"><button data-pb-station-prev>← ${t('Previous','Précédent')}</button><button data-pb-station-next>${i===14?t('Finish','Terminer'):t('Next station','Station suivante')} →</button></nav></div></div>`}
function renderBenediction(){const seq=['benediction_o_salutaris','silence','benediction_tantum_ergo','benediction_versicles','benediction_divine_praises','benediction_adoremus_ps116'],i=S.benedictionStep,id=seq[i],p=D.prayers[id];let body='';if(id==='silence')body=`<div class="pbKicker">${t('Adoration','Adoration')}</div><h2>${t('Remain before the Blessed Sacrament','Demeurez devant le Saint-Sacrement')}</h2><p>${t('Do not fill the whole period with text. Scripture, prayer and sacred silence all belong to Eucharistic worship. Follow the actual public service being celebrated.','Ne remplissez pas tout le temps de textes. L’Écriture, la prière et le silence sacré ont leur place dans l’adoration eucharistique. Suivez le service public réellement célébré.')}</p>`;else body=`<div class="pbKicker">${esc(prayerTitle(p))}</div>${flipText(p.la,p[lang()]||p.en,'ben',false)}`;return `<div class="pbShell"><div class="pbFlow">${top(t('Benediction prayers','Prières de la bénédiction'))}<div class="pbProgress"><span style="width:${((i+1)/seq.length*100).toFixed(1)}%"></span></div><section class="pbFlowCard">${body}</section><nav class="pbFlowNav"><button data-pb-ben-prev ${i===0?'disabled':''}>← ${t('Previous','Précédent')}</button><button data-pb-ben-next>${i===seq.length-1?t('Finish','Terminer'):t('Next','Suivant')} →</button></nav><div class="pbSource">${t('This is a devotional companion to common traditional Benediction texts, not a replacement for the approved order actually being celebrated by the priest or deacon.','Ceci est un compagnon dévotionnel pour les textes traditionnels courants de la bénédiction, non un remplacement de l’ordre approuvé réellement célébré par le prêtre ou le diacre.')}</div></div></div>`}
function render(){let h='';if(S.view==='hub')h=renderHub();else if(S.view==='prayer')h=renderPrayer();else if(S.view==='confession')h=renderConfession();else if(S.view==='rosary')h=renderRosary();else if(S.view==='angelus')h=renderAngelus();else if(S.view==='stations')h=renderStations();else if(S.view==='benediction')h=renderBenediction();root.innerHTML=h;bind();queueMicrotask(()=>{globalThis.AO_SOURCE_DISCLOSURE_V357?.compact?.();globalThis.AO_ROSARY_ART_V38?.sync?.();globalThis.AO_PRAYER_FOCUS_V392?.process?.();globalThis.AO_DEVOTIONAL_GESTURES_V393?.process?.();globalThis.AO_V411_ROLE_GESTURE_HARMONIZATION?.sync?.()})}
function launchExisting(action){const ret=externalReturn||{surface:'prayerbook',view:'hub'};close({silent:true});if(window.AO_NAV_V362?.openCore?.(action,ret))return true;const store=window.AO_RUNTIME_V8?.store;if(action==='prepare'){store?.dispatch({type:'enter-prepare'});return true}if(action==='thanks'){store?.dispatch({type:'enter-thanksgiving'});return true}return false}
function bind(){root.querySelectorAll('[data-pb-back]').forEach(b=>b.onclick=back);root.querySelectorAll('[data-pb-prayer]').forEach(b=>b.onclick=()=>{S.prayer=b.dataset.pbPrayer;go('prayer')});root.querySelectorAll('[data-pb-module]').forEach(b=>b.onclick=()=>{const m=b.dataset.pbModule;if(m==='confession')S.confStep=0;if(m==='rosary'){S.rosarySet=null;S.rosaryStep=0}if(m==='stations')S.station=0;if(m==='benediction')S.benedictionStep=0;go(m)});root.querySelectorAll('[data-pb-existing]').forEach(b=>b.onclick=()=>launchExisting(b.dataset.pbExisting));const q=root.querySelector('[data-pb-search]');if(q)q.oninput=e=>{S.query=e.target.value;const pos=e.target.selectionStart;root.innerHTML=renderHub();bind();queueMicrotask(()=>globalThis.AO_SOURCE_DISCLOSURE_V357?.compact?.());const nq=root.querySelector('[data-pb-search]');nq.focus();nq.setSelectionRange(pos,pos)};root.querySelectorAll('[data-pb-flip]').forEach(b=>b.onclick=()=>{const lat=b.querySelector('[data-pb-latin]'),ver=b.querySelector('[data-pb-vern]');if(!lat||!ver)return;const was=b.dataset.face==='vernacular';b.dataset.face=was?'latin':'vernacular';lat.hidden=!was;ver.hidden=was;const h=b.nextElementSibling?.matches?.('[data-pb-flip-hint]')?b.nextElementSibling:null;if(h)h.textContent=was?t('Tap the text · show English','Touchez le texte · afficher le français'):t('Tap again · return to Latin','Touchez encore · retour au latin')});
const cp=root.querySelector('[data-pb-conf-prev]'),cn=root.querySelector('[data-pb-conf-next]');if(cp)cp.onclick=()=>{S.confStep=Math.max(0,S.confStep-1);render()};if(cn)cn.onclick=()=>{if(S.confStep>=7)return go('hub');S.confStep++;render()};root.querySelectorAll('[data-pb-rosary-set]').forEach(b=>b.onclick=()=>{S.rosarySet=b.dataset.pbRosarySet;S.rosaryStep=0;render()});const rp=root.querySelector('[data-pb-rosary-prev]'),rn=root.querySelector('[data-pb-rosary-next]');if(rp)rp.onclick=()=>{S.rosaryStep=Math.max(0,S.rosaryStep-1);render()};if(rn)rn.onclick=()=>{if(S.rosaryStep>=6){S.rosarySet=null;S.rosaryStep=0;return render()}S.rosaryStep++;render()};const rc=root.querySelector('[data-pb-rosary-change]');if(rc)rc.onclick=()=>{S.rosarySet=null;S.rosaryStep=0;render()};root.querySelectorAll('[data-pb-station-mode]').forEach(b=>b.onclick=()=>{S.stationMode=b.dataset.pbStationMode;render()});const sp=root.querySelector('[data-pb-station-prev]'),sn=root.querySelector('[data-pb-station-next]');if(sp)sp.onclick=()=>{S.station=Math.max(0,S.station-1);render()};if(sn)sn.onclick=()=>{if(S.station>=14)return go('hub');S.station++;render()};const bp=root.querySelector('[data-pb-ben-prev]'),bn=root.querySelector('[data-pb-ben-next]');if(bp)bp.onclick=()=>{S.benedictionStep=Math.max(0,S.benedictionStep-1);render()};if(bn)bn.onclick=()=>{if(S.benedictionStep>=5)return go('hub');S.benedictionStep++;render()};const ac=root.querySelector('[data-pb-angelus-conclusion]');if(ac)ac.onchange=()=>{S.angelusConclusion=ac.checked;render()};const ta=root.querySelector('[data-pb-toggle-angelus]');if(ta)ta.onclick=()=>{const shown=S.angelusOverride?S.angelusOverride==='regina':paschal();S.angelusOverride=shown?'angelus':'regina';render()}}
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&root.classList.contains('open'))close()});

/* --- Traditional practice & commentary pass --- */

/* Ad Orientem traditional-practice formation pass. Source hierarchy is explicit:
   historical/traditional practice is not silently promoted to current universal law. */
const AO_ROSARY_DEPTH={"joy1":{"id":"joy1","set":"joyful","title":"The Annunciation","description":"The Archangel Gabriel announces to the Blessed Virgin Mary that she is to conceive the Son of God, and Mary humbly gives her consent to the divine will.","fruit":"Humility","primary_passage":"Luke 1:26–38","scripture_mode":"narrative","cues":[{"bead":1,"reference":"Luke 1:26–27","excerpt":"And in the sixth month, the angel Gabriel was sent from God into a city of Galilee, called Nazareth, to a virgin espoused to a man whose name was Joseph, of the house of David: and the virgin's name was Mary."},{"bead":2,"reference":"Luke 1:28","excerpt":"Hail, full of grace, the Lord is with thee: blessed art thou among women."},{"bead":3,"reference":"Luke 1:29–30","excerpt":"Who having heard, was troubled at his saying and thought with herself what manner of salutation this should be. And the angel said to her: Fear not, Mary, for thou hast found grace with God."},{"bead":4,"reference":"Luke 1:31","excerpt":"Behold thou shalt conceive in thy womb and shalt bring forth a son: and thou shalt call his name Jesus."},{"bead":5,"reference":"Luke 1:32–33","excerpt":"He shall be great and shall be called the Son of the Most High … and he shall reign in the house of Jacob for ever. And of his kingdom there shall be no end."},{"bead":6,"reference":"Luke 1:34","excerpt":"And Mary said to the angel: How shall this be done, because I know not man?"},{"bead":7,"reference":"Luke 1:35","excerpt":"The Holy Ghost shall come upon thee and the power of the Most High shall overshadow thee."},{"bead":8,"reference":"Luke 1:36–37","excerpt":"And behold thy cousin Elizabeth, she also hath conceived a son in her old age … Because no word shall be impossible with God."},{"bead":9,"reference":"Luke 1:38a","excerpt":"Behold the handmaid of the Lord:"},{"bead":10,"reference":"Luke 1:38b","excerpt":"be it done to me according to thy word."}],"description_fr":"L’archange Gabriel annonce à la Vierge Marie qu’elle concevra le Fils de Dieu; Marie répond par son fiat humble et libre.","fruit_fr":"Humilité","commentary_en":"Leo XIII presents the Joyful Mysteries as the beginning of the saving work: the Son of God takes our nature with Mary’s assent. The decade therefore trains the soul in humble obedience to grace, not merely admiration of the scene.","commentary_fr":"Léon XIII présente les mystères joyeux comme le commencement de l’œuvre du salut : le Fils de Dieu prend notre nature avec le consentement de Marie. La dizaine forme donc à l’obéissance humble à la grâce, et non à la seule admiration de la scène.","source_label":"Leo XIII · Iucunda Semper (1894)","source_url":"https://www.vatican.va/content/leo-xiii/en/encyclicals/documents/hf_l-xiii_enc_08091894_iucunda-semper-expectatione.html","traditional_commentary_label":"Catena Aurea · Luke 1:26ff","traditional_commentary_url":"https://www.ecatholic2000.com/catena/untitled-62.shtml"},"joy2":{"id":"joy2","set":"joyful","title":"The Visitation","description":"Mary goes in haste to Elizabeth; the unborn John leaps for joy, Elizabeth blesses the Mother of the Lord, and Mary praises God in the Magnificat.","fruit":"Fraternal charity","primary_passage":"Luke 1:39–56","scripture_mode":"narrative","cues":[{"bead":1,"reference":"Luke 1:39–40","excerpt":"And Mary rising up in those days, went into the hill country with haste into a city of Juda. And she entered into the house of Zachary and saluted Elizabeth."},{"bead":2,"reference":"Luke 1:41","excerpt":"When Elizabeth heard the salutation of Mary, the infant leaped in her womb. And Elizabeth was filled with the Holy Ghost."},{"bead":3,"reference":"Luke 1:42","excerpt":"Blessed art thou among women and blessed is the fruit of thy womb."},{"bead":4,"reference":"Luke 1:43–44","excerpt":"And whence is this to me that the mother of my Lord should come to me? … the infant in my womb leaped for joy."},{"bead":5,"reference":"Luke 1:45","excerpt":"And blessed art thou that hast believed, because those things shall be accomplished that were spoken to thee by the Lord."},{"bead":6,"reference":"Luke 1:46–47","excerpt":"My soul doth magnify the Lord. And my spirit hath rejoiced in God my Saviour."},{"bead":7,"reference":"Luke 1:48–49","excerpt":"Because he hath regarded the humility of his handmaid: for behold from henceforth all generations shall call me blessed. Because he that is mighty hath done great things to me."},{"bead":8,"reference":"Luke 1:50–52","excerpt":"And his mercy is from generation unto generations, to them that fear him … He hath put down the mighty from their seat and hath exalted the humble."},{"bead":9,"reference":"Luke 1:53–55","excerpt":"He hath filled the hungry with good things … being mindful of his mercy … to Abraham and to his seed for ever."},{"bead":10,"reference":"Luke 1:56","excerpt":"And Mary abode with her about three months. And she returned to her own house."}],"description_fr":"Marie se rend en hâte auprès d’Élisabeth; Jean tressaille dans le sein de sa mère, Élisabeth bénit la Mère du Seigneur et Marie chante le Magnificat.","fruit_fr":"Charité fraternelle","commentary_en":"In Leo XIII’s treatment, Mary’s visit is already fruitful: John is sanctified and Elizabeth blesses the Mother of the Lord. Contemplation should pass into active charity — carrying Christ to another person.","commentary_fr":"Chez Léon XIII, la Visitation porte déjà du fruit : Jean est sanctifié et Élisabeth bénit la Mère du Seigneur. La contemplation doit passer à la charité active : porter le Christ à autrui.","source_label":"Leo XIII · Iucunda Semper (1894)","source_url":"https://www.vatican.va/content/leo-xiii/en/encyclicals/documents/hf_l-xiii_enc_08091894_iucunda-semper-expectatione.html","traditional_commentary_label":"Catena Aurea · Luke 1:39ff","traditional_commentary_url":"https://www.ecatholic2000.com/catena/untitled-62.shtml"},"joy3":{"id":"joy3","set":"joyful","title":"The Nativity","description":"At Bethlehem the Blessed Virgin gives birth to Jesus and lays Him in a manger; the angels announce the Saviour and the shepherds come to adore Him.","fruit":"Spirit of poverty","primary_passage":"Luke 2:4–20","scripture_mode":"narrative","cues":[{"bead":1,"reference":"Luke 2:4–5","excerpt":"And Joseph also went up from Galilee, out of the city of Nazareth, into Judea, to the city of David, which is called Bethlehem: because he was of the house and family of David. To be enrolled with Mary his espoused wife, who was with child."},{"bead":2,"reference":"Luke 2:6","excerpt":"And it came to pass that when they were there, her days were accomplished that she should be delivered."},{"bead":3,"reference":"Luke 2:7","excerpt":"And she brought forth her first born son and wrapped him up in swaddling clothes and laid him in a manger: because there was no room for them in the inn."},{"bead":4,"reference":"Luke 2:8–9","excerpt":"And there were in the same country shepherds watching and keeping the night watches over their flock. And behold an angel of the Lord stood by them and the brightness of God shone round about them."},{"bead":5,"reference":"Luke 2:10","excerpt":"Fear not; for, behold, I bring you good tidings of great joy that shall be to all the people:"},{"bead":6,"reference":"Luke 2:11–12","excerpt":"This day is born to you a Saviour, who is Christ the Lord, in the city of David. And this shall be a sign unto you. You shall find the infant wrapped in swaddling clothes and laid in a manger."},{"bead":7,"reference":"Luke 2:13–14","excerpt":"And suddenly there was with the angel a multitude of the heavenly army, praising God and saying: Glory to God in the highest: and on earth peace to men of good will."},{"bead":8,"reference":"Luke 2:15–16","excerpt":"Let us go over to Bethlehem and let us see this word that is come to pass, which the Lord hath shewed to us. And they came with haste: and they found Mary and Joseph, and the infant lying in the manger."},{"bead":9,"reference":"Luke 2:17–19","excerpt":"And seeing, they understood of the word that had been spoken to them concerning this child … But Mary kept all these words, pondering them in her heart."},{"bead":10,"reference":"Luke 2:20","excerpt":"And the shepherds returned, glorifying and praising God for all the things they had heard and seen, as it was told unto them."}],"description_fr":"Le Verbe incarné naît dans la pauvreté de Bethléem; les anges annoncent la paix et les bergers viennent adorer l’Enfant.","fruit_fr":"Esprit de pauvreté","commentary_en":"The Nativity joins divine majesty to poverty and hiddenness. Traditional Rosary meditation dwells on the real Incarnation: the eternal Son truly enters human weakness, inviting detachment and adoration.","commentary_fr":"La Nativité unit la majesté divine à la pauvreté et à la vie cachée. La méditation traditionnelle du Rosaire s’arrête sur la réalité de l’Incarnation : le Fils éternel entre réellement dans notre faiblesse et appelle au détachement et à l’adoration.","source_label":"Leo XIII · Iucunda Semper (1894)","source_url":"https://www.vatican.va/content/leo-xiii/en/encyclicals/documents/hf_l-xiii_enc_08091894_iucunda-semper-expectatione.html","traditional_commentary_label":"Catena Aurea · Luke 2","traditional_commentary_url":"https://www.ecatholic2000.com/catena/untitled-63.shtml"},"joy4":{"id":"joy4","set":"joyful","title":"The Presentation of the Child Jesus in the Temple","description":"Mary and Joseph present the Child Jesus in the Temple, where Simeon recognises the promised Saviour and foretells the sword that will pierce Mary's soul.","fruit":"Obedience and purity","primary_passage":"Luke 2:22–40","scripture_mode":"narrative","cues":[{"bead":1,"reference":"Luke 2:22–24","excerpt":"They carried him to Jerusalem, to present him to the Lord … And to offer a sacrifice, according as it is written in the law of the Lord, a pair of turtledoves or two young pigeons."},{"bead":2,"reference":"Luke 2:25","excerpt":"There was a man in Jerusalem named Simeon: and this man was just and devout, waiting for the consolation of Israel. And the Holy Ghost was in him."},{"bead":3,"reference":"Luke 2:26","excerpt":"And he had received an answer from the Holy Ghost, that he should not see death before he had seen the Christ of the Lord."},{"bead":4,"reference":"Luke 2:27–28","excerpt":"And he came by the Spirit into the temple … He also took him into his arms and blessed God and said"},{"bead":5,"reference":"Luke 2:29–30","excerpt":"Now thou dost dismiss thy servant, O Lord, according to thy word in peace: Because my eyes have seen thy salvation,"},{"bead":6,"reference":"Luke 2:31–32","excerpt":"Which thou hast prepared before the face of all peoples: A light to the revelation of the Gentiles and the glory of thy people Israel."},{"bead":7,"reference":"Luke 2:33–34","excerpt":"And his father and mother were wondering at those things which were spoken concerning him. And Simeon blessed them."},{"bead":8,"reference":"Luke 2:35","excerpt":"And thy own soul a sword shall pierce, that, out of many hearts thoughts may be revealed."},{"bead":9,"reference":"Luke 2:36–38","excerpt":"And there was one Anna, a prophetess … Now she, at the same hour, coming in, confessed to the Lord: and spoke of him to all that looked for the redemption of Israel."},{"bead":10,"reference":"Luke 2:39–40","excerpt":"They returned into Galilee, to their city Nazareth. And the child grew and waxed strong, full of wisdom: and the grace of God was in him."}],"description_fr":"Marie et Joseph présentent Jésus au Temple; Syméon reconnaît le Messie et annonce le glaive qui transpercera l’âme de Marie.","fruit_fr":"Obéissance et pureté","commentary_en":"The Presentation already points toward Calvary: the Child is offered to the Father and Simeon foretells contradiction and Mary’s sword of sorrow. Joy and sacrifice are therefore inseparable in this mystery.","commentary_fr":"La Présentation oriente déjà vers le Calvaire : l’Enfant est offert au Père et Syméon annonce la contradiction ainsi que le glaive de douleur de Marie. Joie et sacrifice sont donc inséparables dans ce mystère.","source_label":"Leo XIII · Iucunda Semper (1894)","source_url":"https://www.vatican.va/content/leo-xiii/en/encyclicals/documents/hf_l-xiii_enc_08091894_iucunda-semper-expectatione.html","traditional_commentary_label":"Catena Aurea · Luke 2:22ff","traditional_commentary_url":"https://www.ecatholic2000.com/catena/untitled-63.shtml"},"joy5":{"id":"joy5","set":"joyful","title":"The Finding of the Child Jesus in the Temple","description":"After three days of sorrowful searching, Mary and Joseph find the twelve-year-old Jesus among the doctors in the Temple, occupied with His Father's business.","fruit":"Seeking God in all things","primary_passage":"Luke 2:41–52","scripture_mode":"narrative","cues":[{"bead":1,"reference":"Luke 2:41–42","excerpt":"And his parents went every year to Jerusalem, at the solemn day of the pasch. And when he was twelve years old, they going up into Jerusalem, according to the custom of the feast,"},{"bead":2,"reference":"Luke 2:43–44","excerpt":"The child Jesus remained in Jerusalem. And his parents knew it not … and sought him among their kinsfolks and acquaintance."},{"bead":3,"reference":"Luke 2:45","excerpt":"And not finding him, they returned into Jerusalem, seeking him."},{"bead":4,"reference":"Luke 2:46","excerpt":"After three days, they found him in the temple, sitting in the midst of the doctors, hearing them and asking them questions."},{"bead":5,"reference":"Luke 2:47","excerpt":"And all that heard him were astonished at his wisdom and his answers."},{"bead":6,"reference":"Luke 2:48","excerpt":"Son, why hast thou done so to us? Behold thy father and I have sought thee sorrowing."},{"bead":7,"reference":"Luke 2:49","excerpt":"How is it that you sought me? Did you not know that I must be about my father's business?"},{"bead":8,"reference":"Luke 2:50","excerpt":"And they understood not the word that he spoke unto them."},{"bead":9,"reference":"Luke 2:51","excerpt":"And he went down with them and came to Nazareth and was subject to them. And his mother kept all these words in her heart."},{"bead":10,"reference":"Luke 2:52","excerpt":"And Jesus advanced in wisdom and age and grace with God and men."}],"description_fr":"Après trois jours de recherche, Marie et Joseph retrouvent Jésus au Temple, occupé aux affaires de son Père.","fruit_fr":"Chercher Dieu en toutes choses","commentary_en":"The Finding teaches both the primacy of the Father’s will and the persevering search for Christ. The mystery is traditionally fruitful when it leads to renewed fidelity in ordinary duties and prayer.","commentary_fr":"Le Recouvrement enseigne à la fois la primauté de la volonté du Père et la recherche persévérante du Christ. Le mystère porte traditionnellement du fruit lorsqu’il conduit à une fidélité renouvelée dans les devoirs ordinaires et la prière.","source_label":"Leo XIII · Iucunda Semper (1894)","source_url":"https://www.vatican.va/content/leo-xiii/en/encyclicals/documents/hf_l-xiii_enc_08091894_iucunda-semper-expectatione.html","traditional_commentary_label":"Catena Aurea · Luke 2:41ff","traditional_commentary_url":"https://www.ecatholic2000.com/catena/untitled-63.shtml"},"lum1":{"id":"lum1","set":"luminous","title":"The Baptism of the Lord in the Jordan","description":"Jesus receives baptism from John in the Jordan; the Holy Ghost descends upon Him and the Father's voice proclaims Him the beloved Son.","fruit":"Spirit of penance","primary_passage":"Matthew 3:13–17; Luke 3:21–22; John 1:29–34","scripture_mode":"narrative","cues":[{"bead":1,"reference":"John 1:29","excerpt":"Behold the Lamb of God. Behold him who taketh away the sin of the world."},{"bead":2,"reference":"Matthew 3:13","excerpt":"Then cometh Jesus from Galilee to the Jordan, unto John, to be baptized by him."},{"bead":3,"reference":"Matthew 3:14","excerpt":"I ought to be baptized by thee, and comest thou to me?"},{"bead":4,"reference":"Matthew 3:15","excerpt":"Suffer it to be so now. For so it becometh us to fulfil all justice."},{"bead":5,"reference":"Luke 3:21a","excerpt":"Jesus also being baptized"},{"bead":6,"reference":"Luke 3:21b","excerpt":"Jesus also being baptized and praying, heaven was opened."},{"bead":7,"reference":"Luke 3:22a","excerpt":"And the Holy Ghost descended in a bodily shape, as a dove, upon him."},{"bead":8,"reference":"Luke 3:22b","excerpt":"Thou art my beloved Son. In thee I am well pleased."},{"bead":9,"reference":"John 1:32","excerpt":"I saw the Spirit coming down, as a dove from heaven; and he remained upon him."},{"bead":10,"reference":"John 1:33–34","excerpt":"He upon whom thou shalt see the Spirit descending and remaining upon him, he it is that baptizeth with the Holy Ghost. And I saw: and I gave testimony that this is the Son of God."}],"description_fr":"Le Christ reçoit le baptême de Jean; la voix du Père le manifeste comme Fils bien-aimé et l’Esprit descend sur lui.","fruit_fr":"Esprit de pénitence","commentary_en":"John Paul II proposed the Luminous Mysteries in 2002 as an optional addition to the traditional pattern. The Baptism in the Jordan reveals Christ as the beloved Son and inaugurates the public ministry.","commentary_fr":"Jean-Paul II a proposé les mystères lumineux en 2002 comme ajout facultatif au schéma traditionnel. Le Baptême au Jourdain manifeste le Christ comme Fils bien-aimé et inaugure le ministère public.","source_label":"St John Paul II · Rosarium Virginis Mariae (2002)","source_url":"https://www.vatican.va/content/john-paul-ii/en/apost_letters/2002/documents/hf_jp-ii_apl_20021016_rosarium-virginis-mariae.html","traditional_commentary_label":"Catena Aurea · Matthew 3 / Luke 3","traditional_commentary_url":"https://www.ecatholic2000.com/catena/untitled-10.shtml"},"lum2":{"id":"lum2","set":"luminous","title":"The Wedding Feast at Cana","description":"At Mary's intercession, Jesus changes water into wine at Cana, working His first public sign and manifesting His glory.","fruit":"Confidence in prayer and Mary's intercession","primary_passage":"John 2:1–11","scripture_mode":"narrative","cues":[{"bead":1,"reference":"John 2:1","excerpt":"And the third day, there was a marriage in Cana of Galilee: and the mother of Jesus was there."},{"bead":2,"reference":"John 2:2","excerpt":"And Jesus also was invited, and his disciples, to the marriage."},{"bead":3,"reference":"John 2:3","excerpt":"And the wine failing, the mother of Jesus saith to him: They have no wine."},{"bead":4,"reference":"John 2:4","excerpt":"And Jesus saith to her: Woman, what is that to me and to thee? My hour is not yet come."},{"bead":5,"reference":"John 2:5","excerpt":"His mother saith to the waiters: Whatsoever he shall say to you, do ye."},{"bead":6,"reference":"John 2:6","excerpt":"Now there were set there six waterpots of stone, according to the manner of the purifying of the Jews, containing two or three measures apiece."},{"bead":7,"reference":"John 2:7","excerpt":"Jesus saith to them: Fill the waterpots with water. And they filled them up to the brim."},{"bead":8,"reference":"John 2:8","excerpt":"And Jesus saith to them: Draw out now and carry to the chief steward of the feast. And they carried it."},{"bead":9,"reference":"John 2:9–10","excerpt":"And when the chief steward had tasted the water made wine … But thou hast kept the good wine until now."},{"bead":10,"reference":"John 2:11","excerpt":"This beginning of miracles did Jesus in Cana of Galilee and manifested his glory. And his disciples believed in him."}],"description_fr":"À Cana, Marie présente le besoin des époux au Christ et invite les serviteurs à faire tout ce qu’il leur dira.","fruit_fr":"Confiance dans la prière et l’intercession de Marie","commentary_en":"At Cana Christ gives the first sign of His glory and Mary directs the servants toward obedient trust: “Do whatever he tells you.” The mystery is especially suited to confidence in Christ and filial recourse to Mary.","commentary_fr":"À Cana, le Christ donne le premier signe de sa gloire et Marie oriente les serviteurs vers la confiance obéissante : « Faites tout ce qu’il vous dira. » Le mystère convient particulièrement à la confiance dans le Christ et au recours filial à Marie.","source_label":"St John Paul II · Rosarium Virginis Mariae (2002)","source_url":"https://www.vatican.va/content/john-paul-ii/en/apost_letters/2002/documents/hf_jp-ii_apl_20021016_rosarium-virginis-mariae.html","traditional_commentary_label":"Catena Aurea · John 2","traditional_commentary_url":"https://www.ecatholic2000.com/catena/untitled-88.shtml"},"lum3":{"id":"lum3","set":"luminous","title":"The Proclamation of the Kingdom and the Call to Conversion","description":"Jesus announces that the Kingdom of God is at hand, calls sinners to repentance and faith, teaches the way of the Kingdom, and sends His disciples to proclaim it.","fruit":"Courage in commitment and perseverance","primary_passage":"Selected Gospel passages on the Kingdom, conversion, and discipleship","scripture_mode":"thematic","cues":[{"bead":1,"reference":"Mark 1:14","excerpt":"And after that John was delivered up, Jesus came in Galilee, preaching the gospel of the kingdom of God,"},{"bead":2,"reference":"Mark 1:15","excerpt":"The time is accomplished and the kingdom of God is at hand. Repent and believe the gospel:"},{"bead":3,"reference":"John 3:3","excerpt":"Amen, amen, I say to thee, unless a man be born again, he cannot see the kingdom of God."},{"bead":4,"reference":"John 3:5","excerpt":"Amen, amen, I say to thee, unless a man be born again of water and the Holy Ghost, he cannot enter into the kingdom of God."},{"bead":5,"reference":"Luke 4:18–19","excerpt":"The spirit of the Lord is upon me. Wherefore he hath anointed me to preach the gospel to the poor … to preach the acceptable year of the Lord and the day of reward."},{"bead":6,"reference":"Matthew 5:3","excerpt":"Blessed are the poor in spirit: for theirs is the kingdom of heaven."},{"bead":7,"reference":"Matthew 6:33","excerpt":"Seek ye therefore first the kingdom of God, and his justice, and all these things shall be added unto you."},{"bead":8,"reference":"Luke 15:7","excerpt":"I say to you that even so there shall be joy in heaven upon one sinner that doth penance, more than upon ninety-nine just who need not penance."},{"bead":9,"reference":"Matthew 10:7–8","excerpt":"And going, preach, saying: The kingdom of heaven is at hand. Heal the sick, raise the dead, cleanse the lepers, cast out devils: freely have you received, freely give."},{"bead":10,"reference":"John 18:36","excerpt":"My kingdom is not of this world. If my kingdom were of this world, my servants would certainly strive that I should not be delivered to the Jews: but now my kingdom is not from hence."}],"description_fr":"Le Christ proclame le Royaume, appelle à la conversion et invite ses disciples à une vie transformée par l’Évangile.","fruit_fr":"Courage dans l’engagement et persévérance","commentary_en":"The proclamation of the Kingdom gathers together Christ’s preaching of conversion, forgiveness and discipleship. It is not tied to a single episode but to the sustained call to receive the Gospel and change one’s life.","commentary_fr":"L’annonce du Royaume rassemble la prédication du Christ sur la conversion, le pardon et la condition de disciple. Elle n’est pas liée à un seul épisode mais à l’appel continu à recevoir l’Évangile et à changer de vie.","source_label":"St John Paul II · Rosarium Virginis Mariae (2002)","source_url":"https://www.vatican.va/content/john-paul-ii/en/apost_letters/2002/documents/hf_jp-ii_apl_20021016_rosarium-virginis-mariae.html","traditional_commentary_label":"Catena Aurea · Gospel of the Kingdom","traditional_commentary_url":"https://www.ecatholic2000.com/catena/untitled-41.shtml"},"lum4":{"id":"lum4","set":"luminous","title":"The Transfiguration","description":"Christ is transfigured before Peter, James and John; Moses and Elias appear with Him, and the Father commands the disciples to listen to His beloved Son.","fruit":"Spirit of prayer and the gift of wisdom","primary_passage":"Matthew 17:1–9; Luke 9:28–36","scripture_mode":"narrative","cues":[{"bead":1,"reference":"Matthew 17:1","excerpt":"And after six days Jesus taketh unto him Peter and James, and John his brother, and bringeth them up into a high mountain apart:"},{"bead":2,"reference":"Luke 9:28","excerpt":"And it came to pass, about eight days after these words, that he took Peter and James and John and went up into a mountain to pray."},{"bead":3,"reference":"Matthew 17:2","excerpt":"And he was transfigured before them. And his face did shine as the sun: and his garments became white as snow."},{"bead":4,"reference":"Matthew 17:3","excerpt":"And behold there appeared to them Moses and Elias talking with him."},{"bead":5,"reference":"Luke 9:31","excerpt":"Appearing in majesty. And they spoke of his decease that he should accomplish in Jerusalem."},{"bead":6,"reference":"Matthew 17:4","excerpt":"Lord, it is good for us to be here:"},{"bead":7,"reference":"Luke 9:34","excerpt":"And as he spoke these things, there came a cloud and overshadowed them. And they were afraid when they entered into the cloud."},{"bead":8,"reference":"Luke 9:35","excerpt":"And a voice came out of the cloud; saying: This is my beloved son. Hear him."},{"bead":9,"reference":"Matthew 17:6–8","excerpt":"And the disciples hearing fell upon their face, and were very much afraid … And they lifting up their eyes, saw no one, but only Jesus."},{"bead":10,"reference":"Matthew 17:9","excerpt":"Tell the vision to no man, till the Son of man be risen from the dead."}],"description_fr":"Sur la montagne, la gloire du Christ transparaît devant Pierre, Jacques et Jean; la voix du Père ordonne de l’écouter.","fruit_fr":"Esprit de prière et don de sagesse","commentary_en":"The Transfiguration reveals the glory hidden in Christ and points beyond the coming Passion. The Father’s command — to listen to His Son — gives the mystery its practical centre.","commentary_fr":"La Transfiguration révèle la gloire cachée du Christ et oriente au-delà de la Passion à venir. L’ordre du Père — écouter son Fils — donne au mystère son centre pratique.","source_label":"St John Paul II · Rosarium Virginis Mariae (2002)","source_url":"https://www.vatican.va/content/john-paul-ii/en/apost_letters/2002/documents/hf_jp-ii_apl_20021016_rosarium-virginis-mariae.html","traditional_commentary_label":"Catena Aurea · Matthew 17","traditional_commentary_url":"https://www.ecatholic2000.com/catena/untitled-24.shtml"},"lum5":{"id":"lum5","set":"luminous","title":"The Institution of the Holy Eucharist","description":"At the Last Supper Christ gives His Body and Blood under the appearances of bread and wine and commands the Apostles to do this in remembrance of Him.","fruit":"Eucharistic devotion","primary_passage":"Luke 22:14–20; Matthew 26:26–28; 1 Corinthians 11:26; John 6:51–59","scripture_mode":"narrative_and_doctrinal","cues":[{"bead":1,"reference":"Luke 22:14–15","excerpt":"And when the hour was come, he sat down: and the twelve apostles with him. And he said to them: With desire I have desired to eat this pasch with you, before I suffer."},{"bead":2,"reference":"Matthew 26:26","excerpt":"Take ye and eat. This is my body."},{"bead":3,"reference":"Matthew 26:27–28","excerpt":"Drink ye all of this. For this is my blood of the new testament, which shall be shed for many unto remission of sins."},{"bead":4,"reference":"1 Corinthians 11:26","excerpt":"For as often as you shall eat this bread and drink the chalice, you shall shew the death of the Lord, until he come."},{"bead":5,"reference":"John 6:35","excerpt":"I am the bread of life. He that cometh to me shall not hunger: and he that believeth in me shall never thirst."},{"bead":6,"reference":"John 6:48–52","excerpt":"I am the bread of life … I am the living bread which came down from heaven … the bread that I will give is my flesh, for the life of the world."},{"bead":7,"reference":"John 6:54","excerpt":"Amen, amen, I say unto you: except you eat the flesh of the Son of man and drink his blood, you shall not have life in you."},{"bead":8,"reference":"John 6:55–56","excerpt":"He that eateth my flesh and drinketh my blood hath everlasting life … For my flesh is meat indeed: and my blood is drink indeed."},{"bead":9,"reference":"John 6:57–58","excerpt":"He that eateth my flesh and drinketh my blood abideth in me: and I in him … so he that eateth me, the same also shall live by me."},{"bead":10,"reference":"John 6:59","excerpt":"He that eateth this bread shall live for ever."}],"description_fr":"À la dernière Cène, le Christ donne son Corps et son Sang et institue le sacrement de l’Eucharistie.","fruit_fr":"Dévotion eucharistique","commentary_en":"The Eucharistic mystery brings contemplation directly to the gift of Christ’s Body and Blood on the eve of His Passion. In a TLM companion this mystery naturally connects Rosary prayer with Eucharistic faith, Mass and adoration.","commentary_fr":"Le mystère eucharistique conduit directement à contempler le don du Corps et du Sang du Christ à la veille de sa Passion. Dans un compagnon de la Messe traditionnelle, ce mystère relie naturellement le Rosaire à la foi eucharistique, à la Messe et à l’adoration.","source_label":"St John Paul II · Rosarium Virginis Mariae (2002)","source_url":"https://www.vatican.va/content/john-paul-ii/en/apost_letters/2002/documents/hf_jp-ii_apl_20021016_rosarium-virginis-mariae.html","traditional_commentary_label":"Catena Aurea · Matthew 26","traditional_commentary_url":"https://www.ecatholic2000.com/catena/untitled-33.shtml"},"sor1":{"id":"sor1","set":"sorrowful","title":"The Agony in the Garden","description":"In Gethsemane Jesus enters into mortal sorrow, prays in agony, accepts the Father's will, and prepares to give Himself into the hands of His enemies.","fruit":"Contrition for our sins","primary_passage":"Matthew 26:36–46; Luke 22:39–46","scripture_mode":"narrative","cues":[{"bead":1,"reference":"Matthew 26:36–37","excerpt":"Then Jesus came with them into a country place which is called Gethsemani. … And taking with him Peter and the two sons of Zebedee, he began to grow sorrowful and to be sad."},{"bead":2,"reference":"Matthew 26:38","excerpt":"My soul is sorrowful even unto death. Stay you here and watch with me."},{"bead":3,"reference":"Matthew 26:39","excerpt":"My Father, if it be possible, let this chalice pass from me. Nevertheless, not as I will but as thou wilt."},{"bead":4,"reference":"Luke 22:41–42","excerpt":"And kneeling down, he prayed. Saying: Father, if thou wilt, remove this chalice from me: but yet not my will, but thine be done."},{"bead":5,"reference":"Luke 22:43","excerpt":"And there appeared to him an angel from heaven, strengthening him. And being in an agony, he prayed the longer."},{"bead":6,"reference":"Luke 22:44","excerpt":"And his sweat became as drops of blood, trickling down upon the ground."},{"bead":7,"reference":"Matthew 26:40","excerpt":"What? Could you not watch one hour with me?"},{"bead":8,"reference":"Matthew 26:41","excerpt":"Watch ye: and pray that ye enter not into temptation. The spirit indeed is willing, but the flesh weak."},{"bead":9,"reference":"Matthew 26:42","excerpt":"My Father, if this chalice may not pass away, but I must drink it, thy will be done."},{"bead":10,"reference":"Matthew 26:45–46","excerpt":"Behold the hour is at hand: and the Son of man shall be betrayed into the hands of sinners. Rise: let us go. Behold he is at hand that will betray me."}],"description_fr":"Au jardin des Oliviers, le Christ entre dans son agonie, prie avec intensité et conforme pleinement sa volonté à celle du Père.","fruit_fr":"Contrition de nos péchés","commentary_en":"The Sorrowful Mysteries, Leo XIII says, school Christians to face suffering in union with Christ. In Gethsemane the decisive lesson is prayerful conformity: real anguish is brought before the Father and answered with obedient love.","commentary_fr":"Selon Léon XIII, les mystères douloureux apprennent au chrétien à traverser la souffrance en union avec le Christ. À Gethsémani, la leçon décisive est la conformité dans la prière : l’angoisse réelle est portée devant le Père et assumée dans l’amour obéissant.","source_label":"Leo XIII · Laetitiae Sanctae (1893)","source_url":"https://www.vatican.va/content/leo-xiii/en/encyclicals/documents/hf_l-xiii_enc_08091893_laetitiae-sanctae.html","traditional_commentary_label":"Catena Aurea · Matthew 26","traditional_commentary_url":"https://www.ecatholic2000.com/catena/untitled-33.shtml"},"sor2":{"id":"sor2","set":"sorrowful","title":"The Scourging at the Pillar","description":"Though declared innocent, Jesus is handed over to be scourged, bearing in His sacred Body the wounds foretold by the prophet.","fruit":"Sorrow for sins of the senses","primary_passage":"John 18:38–19:1; Luke 23:14–16; Matthew 27:24–26; Isaiah 53:3–7","scripture_mode":"narrative_and_prophetic","cues":[{"bead":1,"reference":"John 18:38","excerpt":"I find no cause in him."},{"bead":2,"reference":"Luke 23:14–15","excerpt":"And behold I, having examined him before you, find no cause in this man, in those things wherein you accuse him. No, nor Herod neither."},{"bead":3,"reference":"Luke 23:16","excerpt":"I will chastise him therefore and release him."},{"bead":4,"reference":"Matthew 27:24","excerpt":"I am innocent of the blood of this just man. Look you to it."},{"bead":5,"reference":"Matthew 27:26","excerpt":"Then he released to them Barabbas: and having scourged Jesus, delivered him unto them to be crucified."},{"bead":6,"reference":"John 19:1","excerpt":"Then therefore Pilate took Jesus and scourged him."},{"bead":7,"reference":"Isaias 53:3","excerpt":"Despised, and the most abject of men, a man of sorrows, and acquainted with infirmity."},{"bead":8,"reference":"Isaias 53:4","excerpt":"Surely he hath borne our infirmities and carried our sorrows."},{"bead":9,"reference":"Isaias 53:5","excerpt":"But he was wounded for our iniquities, he was bruised for our sins: … and by his bruises we are healed."},{"bead":10,"reference":"Isaias 53:7","excerpt":"He was offered because it was his own will, and he opened not his mouth: he shall be led as a sheep to the slaughter."}],"description_fr":"Le Christ innocent est livré à la flagellation et porte dans sa chair la violence du péché.","fruit_fr":"Douleur des péchés des sens","commentary_en":"The Scourging places the consequences of sin before the imagination without encouraging morbid detail. Traditional meditation turns this suffering into contrition, custody of the senses and gratitude for Christ’s voluntary Passion.","commentary_fr":"La Flagellation place les conséquences du péché devant l’imagination sans rechercher le détail morbide. La méditation traditionnelle transforme cette souffrance en contrition, garde des sens et gratitude pour la Passion volontaire du Christ.","source_label":"Leo XIII · Laetitiae Sanctae (1893)","source_url":"https://www.vatican.va/content/leo-xiii/en/encyclicals/documents/hf_l-xiii_enc_08091893_laetitiae-sanctae.html","traditional_commentary_label":"Catena Aurea · Matthew 27","traditional_commentary_url":"https://www.ecatholic2000.com/catena/untitled-34.shtml"},"sor3":{"id":"sor3","set":"sorrowful","title":"The Crowning with Thorns","description":"The soldiers clothe Jesus in mock royalty, press a crown of thorns upon His head, strike Him, and deride the true King.","fruit":"Sorrow for sins of pride","primary_passage":"Matthew 27:27–31; John 19:2–5","scripture_mode":"narrative","cues":[{"bead":1,"reference":"Matthew 27:27","excerpt":"Then the soldiers of the governor, taking Jesus into the hall, gathered together unto him the whole band."},{"bead":2,"reference":"Matthew 27:28","excerpt":"And stripping him, they put a scarlet cloak about him."},{"bead":3,"reference":"Matthew 27:29a","excerpt":"And platting a crown of thorns, they put it upon his head, and a reed in his right hand."},{"bead":4,"reference":"Matthew 27:29b","excerpt":"And bowing the knee before him, they mocked him, saying: Hail, King of the Jews."},{"bead":5,"reference":"Matthew 27:30","excerpt":"And spitting upon him, they took the reed and struck his head."},{"bead":6,"reference":"John 19:2","excerpt":"And the soldiers platting a crown of thorns, put it upon his head: and they put on him a purple garment."},{"bead":7,"reference":"John 19:3","excerpt":"And they came to him and said: Hail, king of the Jews. And they gave him blows."},{"bead":8,"reference":"John 19:4","excerpt":"Behold, I bring him forth unto you, that you may know that I find no cause in him."},{"bead":9,"reference":"John 19:5","excerpt":"(Jesus therefore came forth, bearing the crown of thorns and the purple garment.) And he saith to them: Behold the Man."},{"bead":10,"reference":"Matthew 27:31","excerpt":"And after they had mocked him, they took off the cloak from him and put on him his own garments and led him away to crucify him."}],"description_fr":"Les soldats revêtent Jésus en roi de dérision et le couronnent d’épines; sa royauté se révèle dans l’humiliation.","fruit_fr":"Douleur des péchés d’orgueil","commentary_en":"Mocked as king, Christ answers pride with humility and silence. The mystery exposes the instability of human honour and directs the soul toward the kingship of Christ manifested through self-giving.","commentary_fr":"Raillé comme roi, le Christ répond à l’orgueil par l’humilité et le silence. Le mystère dévoile l’instabilité de l’honneur humain et tourne l’âme vers la royauté du Christ manifestée dans le don de soi.","source_label":"Leo XIII · Laetitiae Sanctae (1893)","source_url":"https://www.vatican.va/content/leo-xiii/en/encyclicals/documents/hf_l-xiii_enc_08091893_laetitiae-sanctae.html","traditional_commentary_label":"Catena Aurea · Matthew 27","traditional_commentary_url":"https://www.ecatholic2000.com/catena/untitled-34.shtml"},"sor4":{"id":"sor4","set":"sorrowful","title":"The Carrying of the Cross","description":"Jesus bears His Cross toward Calvary; Simon of Cyrene is compelled to help Him, while Christ calls His followers to take up the cross and follow.","fruit":"Courage in trials","primary_passage":"Matthew 16:24; John 19:16–17; Luke 23:26–33","scripture_mode":"narrative_with_teaching","cues":[{"bead":1,"reference":"Matthew 16:24","excerpt":"If any man will come after me, let him deny himself, and take up his cross, and follow me."},{"bead":2,"reference":"John 19:16–17","excerpt":"And they took Jesus and led him forth. And bearing his own cross, he went forth to the place which is called Calvary, but in Hebrew Golgotha."},{"bead":3,"reference":"Luke 23:26","excerpt":"And they laid the cross on him to carry after Jesus."},{"bead":4,"reference":"Luke 23:27","excerpt":"And there followed him a great multitude of people and of women, who bewailed and lamented him."},{"bead":5,"reference":"Luke 23:28","excerpt":"Daughters of Jerusalem, weep not over me; but weep for yourselves and for your children."},{"bead":6,"reference":"Luke 23:29","excerpt":"For behold, the days shall come, wherein they will say: Blessed are the barren and the wombs that have not borne and the paps that have not given suck."},{"bead":7,"reference":"Luke 23:30","excerpt":"Then shall they begin to say to the mountains: Fall upon us. And to the hills: Cover us."},{"bead":8,"reference":"Luke 23:31","excerpt":"For if in the green wood they do these things, what shall be done in the dry?"},{"bead":9,"reference":"Luke 23:32","excerpt":"And there were also two other malefactors led with him to be put to death."},{"bead":10,"reference":"Luke 23:33","excerpt":"And when they were come to the place which is called Calvary, they crucified him there."}],"description_fr":"Jésus porte la Croix vers le Calvaire; Simon de Cyrène est requis pour la porter derrière lui.","fruit_fr":"Courage dans les épreuves","commentary_en":"Christ carries the instrument of His sacrifice and calls disciples to take up their cross. This decade is not a cult of suffering for its own sake; it asks for courage to carry unavoidable trials faithfully with Him.","commentary_fr":"Le Christ porte l’instrument de son sacrifice et appelle ses disciples à prendre leur croix. Cette dizaine n’exalte pas la souffrance pour elle-même ; elle demande le courage de porter fidèlement avec lui les épreuves inévitables.","source_label":"Leo XIII · Laetitiae Sanctae (1893)","source_url":"https://www.vatican.va/content/leo-xiii/en/encyclicals/documents/hf_l-xiii_enc_08091893_laetitiae-sanctae.html","traditional_commentary_label":"Catena Aurea · Matthew 27","traditional_commentary_url":"https://www.ecatholic2000.com/catena/untitled-34.shtml"},"sor5":{"id":"sor5","set":"sorrowful","title":"The Crucifixion and Death of Our Lord","description":"Jesus is crucified on Calvary, forgives His enemies, gives Mary to the beloved disciple, promises Paradise to the repentant thief, and gives up His spirit.","fruit":"A greater love of God","primary_passage":"Luke 23:33–46; John 19:25–34","scripture_mode":"narrative","cues":[{"bead":1,"reference":"John 19:17–18","excerpt":"And bearing his own cross, he went forth to the place which is called Calvary, but in Hebrew Golgotha. Where they crucified him, and with him two others, one on each side, and Jesus in the midst."},{"bead":2,"reference":"Luke 23:34","excerpt":"Father, forgive them, for they know not what they do."},{"bead":3,"reference":"Luke 23:42–43","excerpt":"Lord, remember me when thou shalt come into thy kingdom. And Jesus said to him: Amen I say to thee: This day thou shalt be with me in paradise."},{"bead":4,"reference":"John 19:25","excerpt":"Now there stood by the cross of Jesus, his mother … and Mary Magdalen."},{"bead":5,"reference":"John 19:26–27","excerpt":"Woman, behold thy son. … Behold thy mother. And from that hour, the disciple took her to his own."},{"bead":6,"reference":"John 19:28","excerpt":"Afterwards, Jesus knowing that all things were now accomplished, that the scripture might be fulfilled, said: I thirst."},{"bead":7,"reference":"John 19:29","excerpt":"And they, putting a sponge full of vinegar about hyssop, put it to his mouth."},{"bead":8,"reference":"John 19:30","excerpt":"It is consummated. And bowing his head, he gave up the ghost."},{"bead":9,"reference":"Luke 23:46","excerpt":"Father, into thy hands I commend my spirit. And saying this, he gave up the ghost."},{"bead":10,"reference":"John 19:34–35","excerpt":"But one of the soldiers with a spear opened his side: and immediately there came out blood and water. And he that saw it hath given testimony."}],"description_fr":"Le Christ est crucifié et meurt sur le Calvaire; Marie demeure au pied de la Croix et le sacrifice rédempteur s’accomplit.","fruit_fr":"Plus grand amour de Dieu","commentary_en":"At Calvary the Rosary reaches the sacrificial centre of redemption. Traditional contemplation remains with Christ’s self-offering, Mary’s presence beneath the Cross, forgiveness, and the gift of His life for sinners.","commentary_fr":"Au Calvaire, le Rosaire atteint le centre sacrificiel de la Rédemption. La contemplation traditionnelle demeure auprès de l’offrande du Christ, de la présence de Marie au pied de la Croix, du pardon et du don de sa vie pour les pécheurs.","source_label":"Leo XIII · Laetitiae Sanctae (1893)","source_url":"https://www.vatican.va/content/leo-xiii/en/encyclicals/documents/hf_l-xiii_enc_08091893_laetitiae-sanctae.html","traditional_commentary_label":"Catena Aurea · Passion narratives","traditional_commentary_url":"https://www.ecatholic2000.com/catena/untitled-34.shtml"},"glo1":{"id":"glo1","set":"glorious","title":"The Resurrection","description":"On the third day Christ rises from the dead; the empty tomb is announced, He appears to His disciples, and their sorrow is changed into joy and faith.","fruit":"Faith","primary_passage":"John 20:1–31","scripture_mode":"narrative","cues":[{"bead":1,"reference":"John 20:1","excerpt":"Mary Magdalen cometh early, when it was yet dark, unto the sepulchre: and she saw the stone taken away from the sepulchre."},{"bead":2,"reference":"John 20:3–8","excerpt":"Peter therefore went out, and the other disciple: and they came to the sepulchre. … Then that other disciple also went in … and he saw and believed."},{"bead":3,"reference":"John 20:11–13","excerpt":"But Mary stood at the sepulchre without, weeping. … They say to her: Woman, why weepest thou?"},{"bead":4,"reference":"John 20:14–16","excerpt":"When she had thus said, she turned herself back and saw Jesus standing. … Jesus saith to her: Mary. She turning, saith to him: Rabboni (which is to say, Master)."},{"bead":5,"reference":"John 20:17–18","excerpt":"Go to my brethren and say to them: I ascend to my Father and to your Father, to my God and to your God. … I have seen the Lord."},{"bead":6,"reference":"John 20:19–20","excerpt":"Jesus came and stood in the midst and said to them: Peace be to you. … The disciples therefore were glad, when they saw the Lord."},{"bead":7,"reference":"John 20:21–23","excerpt":"As the Father hath sent me, I also send you. … Receive ye the Holy Ghost. Whose sins you shall forgive, they are forgiven them."},{"bead":8,"reference":"John 20:24–25","excerpt":"Now Thomas … was not with them when Jesus came. … Except I shall see in his hands the print of the nails … I will not believe."},{"bead":9,"reference":"John 20:26–28","excerpt":"Jesus cometh, the doors being shut, and stood in the midst and said: Peace be to you. … Thomas answered and said to him: My Lord and my God."},{"bead":10,"reference":"John 20:29","excerpt":"Because thou hast seen me, Thomas, thou hast believed: blessed are they that have not seen and have believed."}],"description_fr":"Le troisième jour, le Christ ressuscite d’entre les morts; le tombeau vide et les apparitions pascales appellent à la foi.","fruit_fr":"Foi","commentary_en":"The Glorious Mysteries begin with the objective victory of Christ over death. The Resurrection calls for theological faith and for living as though sin and death no longer possess the final word.","commentary_fr":"Les mystères glorieux commencent par la victoire objective du Christ sur la mort. La Résurrection appelle à la foi théologale et à vivre comme si le péché et la mort n’avaient plus le dernier mot.","source_label":"Leo XIII · Iucunda Semper (1894)","source_url":"https://www.vatican.va/content/leo-xiii/en/encyclicals/documents/hf_l-xiii_enc_08091894_iucunda-semper-expectatione.html","traditional_commentary_label":"Catena Aurea · Resurrection narratives","traditional_commentary_url":"https://www.ecatholic2000.com/catena/untitled-35.shtml"},"glo2":{"id":"glo2","set":"glorious","title":"The Ascension of Our Lord","description":"Forty days after His Resurrection, Christ blesses His disciples, commissions them to preach to all nations, and ascends bodily into Heaven.","fruit":"A greater desire for Heaven","primary_passage":"Acts 1:3–11; Matthew 28:18–20; Luke 24:50–53; Mark 16:19","scripture_mode":"narrative","cues":[{"bead":1,"reference":"Acts 1:3","excerpt":"To whom also he shewed himself alive after his passion, by many proofs, for forty days appearing to them, and speaking of the kingdom of God."},{"bead":2,"reference":"Acts 1:4–5","excerpt":"He commanded them, that they should not depart from Jerusalem, but should wait for the promise of the Father. … You shall be baptized with the Holy Ghost, not many days hence."},{"bead":3,"reference":"Acts 1:8","excerpt":"You shall receive the power of the Holy Ghost coming upon you, and you shall be witnesses unto me … even to the uttermost part of the earth."},{"bead":4,"reference":"Luke 24:50","excerpt":"And he led them out as far as Bethania: and lifting up his hands, he blessed them."},{"bead":5,"reference":"Acts 1:9","excerpt":"And when he had said these things, while they looked on, he was raised up: and a cloud received him out of their sight."},{"bead":6,"reference":"Acts 1:10","excerpt":"And while they were beholding him going up to heaven, behold two men stood by them in white garments."},{"bead":7,"reference":"Acts 1:11","excerpt":"This Jesus who is taken up from you into heaven, shall so come as you have seen him going into heaven."},{"bead":8,"reference":"Matthew 28:18","excerpt":"All power is given to me in heaven and in earth."},{"bead":9,"reference":"Matthew 28:19–20","excerpt":"Going therefore, teach ye all nations: baptizing them in the name of the Father and of the Son and of the Holy Ghost. … And behold I am with you all days, even to the consummation of the world."},{"bead":10,"reference":"Mark 16:19","excerpt":"And the Lord Jesus, after he had spoken to them, was taken up into heaven and sitteth on the right hand of God."}],"description_fr":"Le Seigneur ressuscité monte au ciel et confie à ses disciples la mission d’annoncer l’Évangile.","fruit_fr":"Désir du ciel","commentary_en":"The Ascension directs desire toward the heavenly homeland without withdrawing Christians from their mission. Christ reigns at the Father’s right hand while sending His disciples to bear witness.","commentary_fr":"L’Ascension oriente le désir vers la patrie céleste sans retirer le chrétien de sa mission. Le Christ règne à la droite du Père tout en envoyant ses disciples rendre témoignage.","source_label":"Leo XIII · Iucunda Semper (1894)","source_url":"https://www.vatican.va/content/leo-xiii/en/encyclicals/documents/hf_l-xiii_enc_08091894_iucunda-semper-expectatione.html","traditional_commentary_label":"Catena Aurea · Luke 24:50–53","traditional_commentary_url":"https://www.ecatholic2000.com/catena/untitled-85.shtml"},"glo3":{"id":"glo3","set":"glorious","title":"The Descent of the Holy Ghost at Pentecost","description":"With Mary and the disciples gathered in prayer, the Holy Ghost descends at Pentecost; the Apostles proclaim Christ boldly and many receive the faith.","fruit":"Zeal for souls","primary_passage":"Acts 1:14; Acts 2:1–41","scripture_mode":"narrative","cues":[{"bead":1,"reference":"Acts 1:14","excerpt":"All these were persevering with one mind in prayer with the women, and Mary the mother of Jesus, and with his brethren."},{"bead":2,"reference":"Acts 2:1","excerpt":"And when the days of the Pentecost were accomplished, they were all together in one place:"},{"bead":3,"reference":"Acts 2:2","excerpt":"And suddenly there came a sound from heaven, as of a mighty wind coming: and it filled the whole house where they were sitting."},{"bead":4,"reference":"Acts 2:3","excerpt":"And there appeared to them parted tongues, as it were of fire: and it sat upon every one of them."},{"bead":5,"reference":"Acts 2:4","excerpt":"And they were all filled with the Holy Ghost: and they began to speak with divers tongues, according as the Holy Ghost gave them to speak."},{"bead":6,"reference":"Acts 2:6","excerpt":"Every man heard them speak in his own tongue."},{"bead":7,"reference":"Acts 2:11","excerpt":"We have heard them speak in our own tongues the wonderful works of God."},{"bead":8,"reference":"Acts 2:14","excerpt":"But Peter standing up with the eleven, lifted up his voice, and spoke to them."},{"bead":9,"reference":"Acts 2:37–38","excerpt":"They had compunction in their heart. … But Peter said to them: Do penance: and be baptized every one of you … And you shall receive the gift of the Holy Ghost."},{"bead":10,"reference":"Acts 2:41","excerpt":"They therefore that received his word were baptized: and there were added in that day about three thousand souls."}],"description_fr":"Marie et les Apôtres persévèrent dans la prière; à la Pentecôte, l’Esprit Saint descend sur l’Église naissante.","fruit_fr":"Zèle pour les âmes","commentary_en":"Leo XIII dwells on Mary praying with the Apostles as the promised Spirit comes upon the Church. The mystery asks for docility to the Holy Ghost and apostolic zeal rather than private consolation alone.","commentary_fr":"Léon XIII insiste sur Marie en prière avec les Apôtres lorsque l’Esprit promis descend sur l’Église. Le mystère demande la docilité au Saint-Esprit et le zèle apostolique, et non la seule consolation privée.","source_label":"Leo XIII · Iucunda Semper (1894)","source_url":"https://www.vatican.va/content/leo-xiii/en/encyclicals/documents/hf_l-xiii_enc_08091894_iucunda-semper-expectatione.html","traditional_commentary_label":"Acts 1–2 · biblical basis","traditional_commentary_url":"https://www.vatican.va/archive/ENG0839/__PX5.HTM"},"glo4":{"id":"glo4","set":"glorious","title":"The Assumption of Our Lady","description":"At the end of her earthly life, the Immaculate Mother of God is taken body and soul into heavenly glory; Scripture is contemplated here through Marian types and figures.","fruit":"The grace of a good death","primary_passage":"Scriptural types and figures used for Marian contemplation; no direct biblical narrative of the Assumption","scripture_mode":"typological","cues":[{"bead":1,"reference":"Psalm 131:8","excerpt":"Arise, O Lord, into thy resting place: thou and the ark, which thou hast sanctified."},{"bead":2,"reference":"Canticles 2:10","excerpt":"Arise, make haste, my love, my dove, my beautiful one, and come."},{"bead":3,"reference":"Canticles 2:11","excerpt":"For winter is now past, the rain is over and gone."},{"bead":4,"reference":"Canticles 2:12–13","excerpt":"The flowers have appeared in our land … The fig tree hath put forth her green figs: the vines in flower yield their sweet smell. Arise, my love, my beautiful one, and come:"},{"bead":5,"reference":"Canticles 2:14","excerpt":"My dove in the clefts of the rock, in the hollow places of the wall, shew me thy face, let thy voice sound in my ears: for thy voice is sweet, and thy face comely."},{"bead":6,"reference":"Psalm 44:10","excerpt":"The queen stood on thy right hand, in gilded clothing; surrounded with variety."},{"bead":7,"reference":"Psalm 44:14–16","excerpt":"All the glory of the king's daughter is within in golden borders, clothed round about with varieties. … They shall be brought with gladness and rejoicing: they shall be brought into the temple of the king."},{"bead":8,"reference":"Apocalypse 11:19","excerpt":"And the temple of God was opened in heaven: and the ark of his testament was seen in his temple."},{"bead":9,"reference":"Apocalypse 12:1","excerpt":"And a great sign appeared in heaven: A woman clothed with the sun, and the moon under her feet, and on her head a crown of twelve stars."},{"bead":10,"reference":"Judith 13:23","excerpt":"Blessed art thou, O daughter, by the Lord the most high God, above all women upon the earth."}],"description_fr":"Au terme de sa vie terrestre, la Mère immaculée de Dieu est élevée corps et âme dans la gloire du ciel; l’Écriture est ici contemplée aussi par types et figures mariales.","fruit_fr":"Grâce d’une bonne mort","commentary_en":"Pius XII explicitly noted that the Assumption was already one of the Rosary’s mysteries before he defined the dogma in 1950. Because Scripture contains no direct narrative of the event, the biblical cues here are typological and must be read as such.","commentary_fr":"Pie XII rappelle explicitement que l’Assomption était déjà un mystère du Rosaire avant la définition dogmatique de 1950. Puisque l’Écriture ne contient pas de récit direct de l’événement, les repères bibliques proposés ici sont typologiques et doivent être lus comme tels.","source_label":"Pius XII · Munificentissimus Deus (1950)","source_url":"https://www.vatican.va/content/pius-xii/en/apost_constitutions/documents/hf_p-xii_apc_19501101_munificentissimus-deus.html","traditional_commentary_label":"St Alphonsus · The Glories of Mary, Assumption","traditional_commentary_url":"https://www.ecatholic2000.com/liguori/glories/glories37.shtml"},"glo5":{"id":"glo5","set":"glorious","title":"The Coronation of Our Lady in Heaven","description":"Mary, exalted by God above the angels and saints, is contemplated as Queen and Mother beneath the sign of the woman crowned with twelve stars.","fruit":"A greater devotion to Mary","primary_passage":"Scriptural types and figures used for Marian contemplation; no direct biblical narrative of the Coronation","scripture_mode":"typological","cues":[{"bead":1,"reference":"Apocalypse 12:1","excerpt":"A woman clothed with the sun, and the moon under her feet, and on her head a crown of twelve stars."},{"bead":2,"reference":"Psalm 44:10","excerpt":"The queen stood on thy right hand, in gilded clothing; surrounded with variety."},{"bead":3,"reference":"Psalm 44:11–12","excerpt":"Hearken, O daughter, and see, and incline thy ear: and forget thy people and thy father's house. And the king shall greatly desire thy beauty; for he is the Lord thy God."},{"bead":4,"reference":"Psalm 44:14–16","excerpt":"All the glory of the king's daughter is within in golden borders, clothed round about with varieties. … They shall be brought with gladness and rejoicing: they shall be brought into the temple of the king."},{"bead":5,"reference":"Canticles 6:8","excerpt":"One is my dove, my perfect one is but one … The daughters saw her, and declared her most blessed: the queens and concubines, and they praised her."},{"bead":6,"reference":"Canticles 6:9","excerpt":"Who is she that cometh forth as the morning rising, fair as the moon, bright as the sun, terrible as an army set in array?"},{"bead":7,"reference":"Judith 13:23","excerpt":"Blessed art thou, O daughter, by the Lord the most high God, above all women upon the earth."},{"bead":8,"reference":"Judith 13:25","excerpt":"Because he hath so magnified thy name this day, that thy praise shall not depart out of the mouth of men who shall be mindful of the power of the Lord for ever."},{"bead":9,"reference":"Judith 15:10","excerpt":"Thou art the glory of Jerusalem, thou art the joy of Israel, thou art the honour of our people:"},{"bead":10,"reference":"Luke 1:48","excerpt":"For behold from henceforth all generations shall call me blessed."}],"description_fr":"Marie, élevée au-dessus des anges et des saints, est contemplée comme Reine et Mère, sous le signe de la femme couronnée de douze étoiles.","fruit_fr":"Plus grande dévotion envers Marie","commentary_en":"Pius XII calls the fifth Glorious Mystery the mystical crown of the heavenly Queen. The traditional images of the queen at the King’s right hand and the woman crowned with stars are contemplated in the light of Mary’s divine maternity and participation in Christ’s victory.","commentary_fr":"Pie XII appelle le cinquième mystère glorieux la couronne mystique de la Reine du ciel. Les images traditionnelles de la reine à la droite du Roi et de la femme couronnée d’étoiles sont contemplées à la lumière de la maternité divine de Marie et de sa participation à la victoire du Christ.","source_label":"Pius XII · Ad Caeli Reginam (1954)","source_url":"https://www.vatican.va/content/pius-xii/en/encyclicals/documents/hf_p-xii_enc_11101954_ad-caeli-reginam.html","traditional_commentary_label":"St Lawrence of Brindisi · Marian commentary on Apoc 12:1","traditional_commentary_url":"https://www.catholicculture.org/culture/library/view.cfm?recnum=2977"}};
const AO_STABAT_EN=["At the Cross her station keeping, the sorrowful Mother stood weeping while her Son hung upon the Cross.", "Through her grieving and afflicted soul there passed a sword of sorrow.", "How sad and afflicted was that blessed Mother of the Only-begotten Son.", "She mourned and suffered, the loving Mother, while she beheld the pains of her glorious Son.", "Who would not weep to see the Mother of Christ in such great suffering?", "Who could fail to grieve, contemplating the Mother of Christ suffering with her Son?", "For the sins of his people she saw Jesus in torments and subjected to scourges.", "She saw her sweet Son desolate in death until he gave up his spirit.", "O Mother, fountain of love, make me feel the force of sorrow, that I may mourn with you.", "Make my heart burn with love of Christ my God, that I may be pleasing to him.", "Holy Mother, do this: fix the wounds of the Crucified firmly in my heart.", "Share with me the pains of your wounded Son, who deigned to suffer so much for me.", "Grant that I may devoutly weep with you and compassionate the Crucified as long as I live."];
const AO_STABAT_FR=["Au pied de la Croix, la Mère douloureuse demeurait en pleurs tandis que son Fils y était suspendu.", "À travers son âme gémissante, contristée et douloureuse passa un glaive de douleur.", "Qu’elle était triste et affligée, cette Mère bénie du Fils unique.", "Elle gémissait et souffrait, la Mère aimante, en contemplant les peines de son Fils glorieux.", "Quel homme ne pleurerait en voyant la Mère du Christ dans une si grande souffrance ?", "Qui pourrait ne pas s’attrister en contemplant la Mère du Christ souffrant avec son Fils ?", "Pour les péchés de son peuple, elle vit Jésus dans les tourments et soumis aux fouets.", "Elle vit son doux Fils abandonné dans la mort jusqu’à ce qu’il rendît l’esprit.", "Ô Mère, source d’amour, faites-moi sentir la force de la douleur afin que je pleure avec vous.", "Faites que mon cœur brûle d’amour pour le Christ mon Dieu, afin que je lui sois agréable.", "Sainte Mère, faites ceci : imprimez profondément dans mon cœur les plaies du Crucifié.", "Partagez avec moi les souffrances de votre Fils blessé, qui a daigné tant souffrir pour moi.", "Accordez-moi de pleurer pieusement avec vous et de compatir au Crucifié tant que je vivrai."];
if(typeof S!=='undefined'){
  S.angelusConclusion=true;
  if(S.rosaryFatima===undefined)S.rosaryFatima=true;
  if(S.stationStabat===undefined)S.stationStabat=false;
}
const AO_LINKS={
 angelusDir:'https://www.vatican.va/roman_curia/congregations/ccdds/documents/rc_con_ccdds_doc_20020513_vers-direttorio_en.html',
 angelusBow:'https://www.vatican.va/content/john-paul-ii/it/angelus/1980/documents/hf_jp-ii_ang_19800622.html',
 threeGlorias:'https://en.wikisource.org/wiki/The_Raccolta_(1857)/Three_Gloria_Patri_by_way_of_thanksgiving,_etc.',
 rosaryRVM:'https://www.vatican.va/content/john-paul-ii/en/apost_letters/2002/documents/hf_jp-ii_apl_20021016_rosarium-virginis-mariae.html',
 rosaryLeo:'https://www.vatican.va/content/leo-xiii/en/encyclicals/documents/hf_l-xiii_enc_08091894_iucunda-semper-expectatione.html',
 fatima:'https://www.fatima.pt/en/pages/narrative-of-the-apparitions-',
 stations:'https://www.vatican.va/roman_curia/congregations/ccdds/documents/rc_con_ccdds_doc_20020513_vers-direttorio_en.html',
 benediction:'https://press.vatican.va/roman_curia/congregations/ccdds/documents/rc_con_ccdds_doc_20041014_anno-eucaristia_en.html',
 confession:'https://www.vatican.va/archive/cod-iuris-canonici/eng/documents/cic_lib4-cann959-997_en.html',
 leonineSuppressed:'https://adoremus.org/1964/09/inter-oecumenici/',
 leonineText:'https://www.romanitaspress.com/the-prayers-after-low-mass'
};
function aoFormation(titleEn,titleFr,body){return `<details class="pbFormation"><summary>${t(titleEn,titleFr)}</summary><div class="pbFormationBody">${body}</div></details>`}
function aoMysteryId(set,n){return ({joyful:'joy',sorrowful:'sor',glorious:'glo',luminous:'lum'}[set]||'joy')+(n+1)}
function aoMysteryFormation(set,n){
 const id=aoMysteryId(set,n),d=AO_ROSARY_DEPTH[id]; if(!d)return'';
 const isfr=lang()==='fr';
 const desc=isfr?d.description_fr:d.description,fruit=isfr?d.fruit_fr:d.fruit,com=isfr?d.commentary_fr:d.commentary_en;
 const cues=d.cues.map(c=>`<div class="pbCue"><b>${c.bead} · ${esc(c.reference)}</b>${isfr?'':`<span>${esc(c.excerpt)}</span>`}</div>`).join('');
 return `<div class="pbRosaryFormation"><div class="pbKicker">${t('Contemplate before the decade','Contempler avant la dizaine')}</div><p><strong>${esc(d.primary_passage)}</strong></p><p>${esc(desc)}</p><span class="pbFruit">${t('Fruit / grace: ','Fruit / grâce : ')}${esc(fruit)}</span><h3>${t('Traditional commentary','Commentaire traditionnel')}</h3><p>${esc(com)}</p><div class="pbSourceRow"><a href="${esc(d.source_url)}" target="_blank" rel="noopener">${esc(d.source_label)} ↗</a><a href="${esc(d.traditional_commentary_url)}" target="_blank" rel="noopener">${esc(d.traditional_commentary_label)} ↗</a></div><details class="pbScriptureCues"><summary>${t('Scripture through the ten Hail Marys','Repères bibliques pour les dix Ave Maria')}</summary><div class="pbCueList">${cues}</div>${isfr?`<p class="pbTiny">${t('','Les références proviennent du jeu de 200 repères scripturaires vérifiés d’Ad Orientem. Les extraits bibliques anglais Douay-Rheims sont affichés en mode EN ; le mode FR n’invente pas ici une traduction biblique non sourcée.')}</p>`:''}</details></div>`;
}
function aoRosaryPracticeIntro(){return aoFormation('How the traditional Rosary is prayed','Comment prier le Rosaire traditionnel',`
<h3>${t('What is essential','Structure')}</h3><p>${t('Leo XIII describes the Rosary as two inseparable elements: meditation on the mysteries and vocal prayer. The traditional Dominican/Roman cycle has fifteen mysteries — Joyful, Sorrowful and Glorious — corresponding symbolically to the 150 Psalms.','Léon XIII décrit le Rosaire comme deux éléments inséparables : la méditation des mystères et la prière vocale. Le cycle dominicain/romain traditionnel comporte quinze mystères — joyeux, douloureux et glorieux — correspondant symboliquement aux 150 Psaumes.')}</p>
<h3>${t('Opening and closing','Ouverture et conclusion')}</h3><p>${t('The Creed, introductory Pater, three Aves and Gloria are a widespread traditional opening, but local prayer books have varied. Salve Regina and the Rosary collect are customary conclusions; the Litany of Loreto may be added but is not required to make five decades a Rosary.','Le Credo, le Pater d’introduction, les trois Ave et le Gloria constituent une ouverture traditionnelle très répandue, mais les livres de prières ont varié. Le Salve Regina et l’oraison du Rosaire sont des conclusions usuelles ; les Litanies de Lorette peuvent s’ajouter sans être nécessaires pour que les cinq dizaines constituent un chapelet.')}</p>
<h3>${t('Contemplation','Contemplation')}</h3><p>${t('The mystery is announced before each decade. John Paul II later recommended a biblical passage and a brief silence; this is a modern pastoral articulation of the Rosary’s older contemplative purpose, not a replacement of the traditional prayers.','Le mystère est annoncé avant chaque dizaine. Jean-Paul II a ensuite recommandé un passage biblique et un bref silence ; c’est une explicitation pastorale moderne de la finalité contemplative plus ancienne du Rosaire, non un remplacement des prières traditionnelles.')}</p>
<div class="pbSourceRow"><a href="${AO_LINKS.rosaryLeo}" target="_blank" rel="noopener">Leo XIII · Iucunda Semper ↗</a><a href="${AO_LINKS.rosaryRVM}" target="_blank" rel="noopener">Rosarium Virginis Mariae §§19, 29–31 ↗</a></div>`)}

const _aoRenderRosary=renderRosary;
renderRosary=function(){
 if(!S.rosarySet){
  const sug=suggestedMystery();
  return `<div class="pbShell"><div class="pbFlow">${top(t('Holy Rosary','Saint Rosaire'))}<section class="pbHero"><div class="eyebrow">${t('Traditional fifteen mysteries','Quinze mystères traditionnels')}</div><h2>${t('Choose the mysteries','Choisissez les mystères')}</h2><p>${t('Joyful, Sorrowful and Glorious remain the default traditional cycle. The Luminous Mysteries are retained as the optional 2002 addition proposed by St John Paul II.','Joyeux, Douloureux et Glorieux demeurent le cycle traditionnel par défaut. Les Mystères lumineux restent disponibles comme ajout facultatif proposé en 2002 par saint Jean-Paul II.')}</p></section><div class="pbModuleGrid">${['joyful','sorrowful','glorious'].map(k=>`<button class="pbModule ${k===sug?'featured':''}" data-pb-rosary-set="${k}"><strong>${esc({joyful:t('Joyful','Joyeux'),sorrowful:t('Sorrowful','Douloureux'),glorious:t('Glorious','Glorieux')}[k])}</strong><span>${k===sug?t('Suggested today · ','Suggérés aujourd’hui · '):''}${rosaryNames()[k].join(' · ')}</span></button>`).join('')}<button class="pbModule" data-pb-rosary-set="luminous"><strong>${t('Luminous · optional 2002','Lumineux · facultatifs 2002')}</strong><span>${t('A proposed addition to the traditional pattern','Ajout proposé au schéma traditionnel')}</span></button></div>${aoRosaryPracticeIntro()}<div class="pbSource"><strong>${t('Source-critical note','Note sur les sources')}</strong><br>${t('The 200 Scripture cues use Ad Orientem’s verified Douay-Rheims cue dataset. Gospel mysteries are linked to its Catena Aurea commentary map; the Assumption and Coronation are explicitly treated through typology and traditional Marian sources rather than presented as direct Gospel narratives.','Les 200 repères bibliques ci-dessous utilisent le jeu Douay-Rheims vérifié d’Ad Orientem. Les mystères évangéliques sont reliés à sa cartographie de la Catena Aurea ; l’Assomption et le Couronnement sont explicitement traités par typologie et par des sources mariales traditionnelles, et non présentés comme des récits évangéliques directs.')}</div></div></div>`;
 }
 const set=S.rosarySet,names=rosaryNames()[set],total=7,i=S.rosaryStep;let body='';
 if(i===0){body=`<div class="pbKicker">${t('Opening','Ouverture')}</div><h2>${t('Begin the Rosary','Commencez le Rosaire')}</h2>${prayerBundle(['sign','credo','pater'])}<div class="pbContextNotice">${t('Common traditional opening: three Hail Marys and one Glory Be.','Ouverture traditionnelle courante : trois Ave Maria et un Gloria Patri.')}</div>${prayerBundle(['ave','gloria'])}<label class="pbPracticeToggle"><input type="checkbox" data-pb-fatima ${S.rosaryFatima?'checked':''}><span><strong>${t('Fatima prayer after each decade','Prière de Fatima après chaque dizaine')}</strong><br><span class="pbTiny">${t('Common in twentieth-century traditional practice. Our Lady’s July 1917 request is documented by the Fatima Shrine; it is later than the classical fifteen-mystery structure.','Très courante dans la pratique traditionnelle du XXe siècle. La demande de juillet 1917 est documentée par le Sanctuaire de Fatima ; elle est postérieure à la structure classique des quinze mystères.')}</span></span></label><div class="pbSourceRow"><a href="${AO_LINKS.fatima}" target="_blank" rel="noopener">Fatima Shrine ↗</a></div>`;}
 else if(i<=5){const n=i-1;body=`<div class="pbKicker">${t('Mystery','Mystère')} ${i} / 5</div><div class="pbMysteryTitle">${esc(names[n])}</div><p>${t('Announce the mystery, read the short formation if useful, then pause before beginning the vocal prayers.','Annoncez le mystère, lisez la courte formation si elle est utile, puis faites une pause avant de commencer les prières vocales.')}</p>${aoMysteryFormation(set,n)}${prayerBundle(['pater'])}<div class="pbCounter">${Array.from({length:10},()=>'<i></i>').join('')}</div>${prayerBundle(['ave','gloria'])}${S.rosaryFatima?prayerBundle(['fatima']):''}`;}
 else body=`<div class="pbKicker">${t('Conclusion','Conclusion')}</div><h2>${t('Conclude the Rosary','Concluez le Rosaire')}</h2><div class="pbMiniPrayer">${flipText(D.salve.la,D.salve[lang()],'salve',false)}</div><div class="pbMiniPrayer">${flipText(D.rosaryCollect.la,D.rosaryCollect[lang()],'collect',false)}</div><div class="pbContextNotice">${t('The Litany of Loreto may be added as a further Marian devotion; it is not required for the five-decade Rosary.','Les Litanies de Lorette peuvent être ajoutées comme dévotion mariale supplémentaire ; elles ne sont pas requises pour le chapelet de cinq dizaines.')}</div>`;
 return `<div class="pbShell"><div class="pbFlow">${top(t('Holy Rosary','Saint Rosaire'))}<div class="pbProgress"><span style="width:${((i+1)/total*100).toFixed(1)}%"></span></div><section class="pbFlowCard">${body}</section><nav class="pbFlowNav"><button data-pb-rosary-prev ${i===0?'disabled':''}>← ${t('Previous','Précédent')}</button><button data-pb-rosary-next>${i===total-1?t('Finish','Terminer'):t('Next','Suivant')} →</button></nav><button class="pbSecondary" data-pb-rosary-change style="margin-top:10px">${t('Change mysteries','Changer de mystères')}</button></div></div>`;
};

renderAngelus=function(){
 const useRegina=S.angelusOverride?S.angelusOverride==='regina':paschal(),x=useRegina?D.regina:D.angelus;
 const appendix=!useRegina&&S.angelusConclusion?`<div class="pbMiniPrayer"><div class="pbKicker">${t('Traditional conclusion','Conclusion traditionnelle')}</div>${flipText(D.angelusAppendix.la,D.angelusAppendix[lang()],'angelus-appendix',false)}</div>`:'';
 const posture=useRegina?t('Stand · Paschaltide custom','Debout · usage du temps pascal'):t('Kneel ordinarily; stand on Sundays and in Paschaltide. Older prayer books often begin the Sunday standing exception from First Vespers on Saturday.','À genoux ordinairement ; debout le dimanche et au temps pascal. Les anciens livres de prières font souvent commencer l’exception dominicale aux premières vêpres du samedi.');
 return `<div class="pbShell"><div class="pbReader">${top(useRegina?'Regina Cæli':'Angelus')}<div class="pbContextNotice"><strong>${posture}</strong><br>${useRegina?t('Benedict XIV prescribed the Regina Cæli in place of the Angelus during Paschaltide in 1742; the current Directory on Popular Piety preserves this seasonal substitution.','Benoît XIV prescrivit en 1742 le Regina Cæli à la place de l’Angélus pendant le temps pascal ; le Directoire actuel sur la piété populaire conserve cette substitution saisonnière.'):t('Traditionally prayed morning, noon and evening. Posture belongs to devotional custom rather than to a universal liturgical rubric.','Traditionnellement prié le matin, à midi et le soir. La posture relève de l’usage dévotionnel et non d’une rubrique liturgique universelle.')}</div>${flipText(x.la,x[lang()],'angelus-main',false)}${!useRegina?`<div class="pbContextNotice"><strong>${t('At Et Verbum caro factum est','À Et Verbum caro factum est')}</strong><br>${t('A profound bow of the head is explicitly documented in papal Angelus practice; genuflection is also found in traditional devotional usage. Ad Orientem does not present either gesture as a universal Angelus rubric.','Une profonde inclination de la tête est explicitement attestée dans la pratique pontificale de l’Angélus ; la génuflexion se rencontre également dans l’usage dévotionnel traditionnel. Ad Orientem ne présente aucun des deux gestes comme rubrique universelle de l’Angélus.')}</div><label class="pbPracticeToggle"><input type="checkbox" data-pb-angelus-conclusion ${S.angelusConclusion?'checked':''}><span><strong>${t('Three Gloria Patri and the customary conclusion','Trois Gloria Patri et conclusion usuelle')}</strong><br><span class="pbTiny">${t('Enabled by default for the traditional prayer-book form. Pius VII’s 1815 grant concerned three Gloria Patri morning, noon and evening in thanksgiving for Marian privileges; later Catholic prayer books commonly attach them to the Angelus. They are a traditional appendix, not the essential core of the Angelus.','Activés par défaut dans la forme des anciens livres de prières. Le rescrit de Pie VII de 1815 concernait trois Gloria Patri matin, midi et soir en action de grâces pour les privilèges mariaux ; des livres catholiques ultérieurs les joignent couramment à l’Angélus. Ils constituent un appendice traditionnel, non le noyau essentiel de l’Angélus.')}</span></span></label>${appendix}`:''}<div class="pbFlowNav"><button data-pb-toggle-angelus>${useRegina?t('Show Angelus instead','Afficher plutôt l’Angélus'):t('Show Regina Cæli instead','Afficher plutôt le Regina Cæli')}</button></div>${aoFormation('Practice and sources','Pratique et sources',`<p>${t('The Angelus is a meditation on the Incarnation built from three versicles, each followed by the Ave Maria, and a final versicle and collect. The Regina Cæli is the Paschal substitute.','L’Angélus médite l’Incarnation au moyen de trois versets, chacun suivi de l’Ave Maria, puis d’un verset final et d’une oraison. Le Regina Cæli le remplace au temps pascal.')}</p><div class="pbSourceRow"><a href="${AO_LINKS.angelusDir}" target="_blank" rel="noopener">Directory §§195–196 ↗</a><a href="${AO_LINKS.threeGlorias}" target="_blank" rel="noopener">Raccolta · Pius VII 1815 ↗</a><a href="${AO_LINKS.angelusBow}" target="_blank" rel="noopener">John Paul II · Angelus 22 Jun 1980 ↗</a></div>`)}</div></div>`;
