g,.aoContentV37Badge.partial{border-color:#8b6d3f}.aoContentV37Badge.error,.aoContentV37Badge.unavailable{border-color:#8b4e56}.aoContentV37Section{margin:18px 0}.aoContentV37Section h3{font-family:var(--font-display,serif);margin:0 0 8px}.aoContentV37Actions{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.aoContentV37Actions button{min-height:42px;padding:0 12px;border:1px solid var(--border,#29333d);border-radius:11px;background:transparent;color:inherit}.aoContentV37Actions .primary{background:var(--liturgical,#8e1d2c);border-color:transparent}.aoContentV37Mono{font:11px ui-monospace,SFMono-Regular,Consolas,monospace;word-break:break-word;color:var(--muted,#9aa4ad)}.aoV37SourcesCard{margin:12px 0;padding:14px;border:1px solid var(--border);border-radius:14px;background:var(--surface-1)}.aoV37SourcesCard button{min-height:42px;border-radius:11px;border:1px solid var(--liturgical-border);background:var(--liturgical-soft);color:var(--text);padding:0 12px;font-weight:700}.aoV37TerminalError{padding:12px;border:1px solid color-mix(in srgb,#9a4d59 55%,var(--border));border-radius:12px;background:color-mix(in srgb,#9a4d59 9%,var(--surface-1));line-height:1.45}
</style>

