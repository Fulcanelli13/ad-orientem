}
function queueHome(){if(homeQueued)return;homeQueued=true;queueMicrotask(()=>{homeQueued=false;ensureHome()})}
function scheduleMidnight(){clearTimeout(midnightTimer);const now=new Date(),next=new Date(now.getFullYear(),now.getMonth(),now.getDate()+1,0,0,2);midnightTimer=setTimeout(()=>{queueHome();scheduleMidnight()},Math.max(1000,next-now))}
function install(){if(storeHooked)return;const r=rt();if(!r?.store)return;storeHooked=true;r.store.subscribe(()=>{queueHome();if(openState.open&&openState.language!==lang()){openState.language=lang();openState.revealed=false;render()}});queueHome();scheduleMidnight()}
document.addEventListener('click',e=>{const b=e.target.closest?.('button,[data-dc-open]');if(!b)return;if(b.matches('[data-dc-open]')||b.closest('.aoDailyCateHome')&&b.classList.contains('roundAction')){e.preventDefault();open();return}if(b.matches('[data-dc-back],[data-dc-close]')){close();return}if(b.matches('[data-dc-reveal]')){openState.revealed=true;render();return}if(b.dataset.dcOutcome){recordOutcome(Number(b.dataset.id),b.dataset.dcOutcome);return}if(b.dataset.dcStudy){const id=Number(b.dataset.dcStudy),ses=load().sessions?.[dateKey()],lg=ses?.contentLanguage||openState.contentLanguage||lang();close();api()?.open?.({lang:lg,question:id});return}if(b.matches('[data-dc-full]')){const lg=lang();close();api()?.open?.({lang:lg});return}},true)
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&openState.open)close()})
install();
window.AO_DAILY_CATECHISM={version:VERSION,open,close,ensureHome,hero:HOME_HERO,getState:()=>load(),resetToday(){const s=load();delete s.sessions[dateKey()];save(s);queueHome();return true},qa(){const s=load(),session=s.sessions?.[dateKey()];return {version:VERSION,date:dateKey(),sessionSize:session?.ids?.length||0,completed:!!session?.completedAt,encountered:stats(s).encountered,due:stats(s).due,month:stats(s).month,noDuplicateSessionIds:session?new Set(session.ids).size===session.ids.length:true,usesCanonicalCatechism:!!api()?.questions}}};
})();
</script>
