  languageWitnessPending:["foundations_morning_offering:la","marian_consecration_immaculate_heart:la","marian_consecration_immaculate_heart:fr","devotion_consecration_christ_king:la","devotion_consecration_christ_king:fr","devotion_st_anthony_lost_items:la","devotion_st_anthony_lost_items:fr","sacred_heart_short_prayer:la","sacred_heart_short_prayer:fr"],
