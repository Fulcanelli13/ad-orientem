<style id="ao-v4313-tier-a-icons-css">
.aoUiIcon{width:1.25em;height:1.25em;display:inline-block;flex:none;overflow:visible;color:currentColor;stroke:currentColor;vertical-align:-.2em}
.aoUiIconOnly{display:inline-grid!important;place-items:center!important}
.aoUiIconOnly>.aoUiIcon{width:22px;height:22px;vertical-align:0}
.aoUiIconLead,.aoUiIconTrail{display:inline-flex!important;align-items:center!important;gap:.42em!important}
.aoUiIconLead>.aoUiIcon,.aoUiIconTrail>.aoUiIcon{width:1.05em;height:1.05em}
.liveBackButton,.liveNextButton{display:flex!important;align-items:center!important;gap:6px!important}
.liveNextButton{justify-content:flex-end!important}
.liveBackButton>.aoUiIcon,.liveNextButton>.aoUiIcon{width:18px;height:18px}
.aoV37UtilityRail button.aoUiIconLead{display:inline-flex!important}
.aoUiExternal{display:inline-flex!important;align-items:center!important;gap:.3em!important}
.aoUiExternal>.aoUiIcon{width:.9em;height:.9em}
.aoUiDisclosure{display:flex!important;align-items:center!important;gap:.45em!important}
.aoUiDisclosure>.aoUiIcon{margin-left:auto;transition:transform .18s ease}
details[open]>.aoUiDisclosure>.aoUiIcon{transform:rotate(180deg)}
.aoUiSelected{display:inline-flex!important;align-items:center!important;gap:.32em!important}
.aoUiSelected>.aoUiIcon{width:.88em;height:.88em}
@media(prefers-reduced-motion:reduce){.aoUiDisclosure>.aoUiIcon{transition:none}}
</style>
<script id="ao-v4313-tier-a-icons-js">
(()=>{'use strict';
const VERSION='43.59.19-TIER-A-CANONICAL-CONTROLS';
const IDS=Object.freeze(['ao-ui-home','ao-ui-back','ao-ui-close','ao-ui-previous','ao-ui-next','ao-ui-search','ao-ui-settings','ao-ui-info','ao-ui-sources','ao-ui-external','ao-ui-check','ao-ui-expand']);
const NS='http://www.w3.org/2000/svg';let storeHooked=false,queued=false,timer=0;

function icon(id,extra=''){
 const svg=document.createElementNS(NS,'svg');
 svg.classList.add('aoUiIcon');
 if(extra)extra.split(/\s+/).filter(Boolean).forEach(c=>svg.classList.add(c));
 svg.setAttribute('aria-hidden','true');svg.setAttribute('focusable','false');
 const use=document.createElementNS(NS,'use');use.setAttribute('href','#'+id);svg.appendChild(use);return svg
}
function directText(el){return [...(el?.childNodes||[])].filter(n=>n.nodeType===Node.TEXT_NODE).map(n=>n.nodeValue||'').join(' ').replace(/\s+/g,' ').trim()}
function stripDirect(el,re){[...(el?.childNodes||[])].filter(n=>n.nodeType===Node.TEXT_NODE).forEach(n=>{n.nodeValue=(n.nodeValue||'').replace(re,' ')})}
function removeLegacyVisual(el){
 if(!el)return;
 el.querySelectorAll(':scope > img.navIcon,:scope > img.smallNavIcon,:scope > .aoUiIcon').forEach(n=>n.remove());
 [...el.childNodes].filter(n=>n.nodeType===Node.TEXT_NODE&&/^[\s×‹›←→⌂⚙▦✓↗•••]+$/.test(n.nodeValue||'')).forEach(n=>n.remove())
}
function iconOnly(el,id,label){
 if(!el)return;removeLegacyVisual(el);el.classList.add('aoUiIconOnly');el.dataset.aoTierAIcon=id;
 if(!el.getAttribute('aria-label'))el.setAttribute('aria-label',label||id);el.prepend(icon(id))
}
function lead(el,id){
 if(!el)return;el.querySelectorAll(':scope > .aoUiIcon,:scope > img.navIcon,:scope > img.smallNavIcon').forEach(n=>n.remove());
 el.classList.add('aoUiIconLead');el.dataset.aoTierAIcon=id;el.prepend(icon(id))
}
function trail(el,id){
 if(!el||el.querySelector(':scope > .aoUiIcon'))return;
 el.classList.add('aoUiIconTrail');el.dataset.aoTierAIcon=id;el.append(icon(id))
}
function prevNext(el,id,side){
 if(!el)return;
 el.querySelectorAll(':scope > .aoUiIcon').forEach(n=>n.remove());
 stripDirect(el,/[←→‹›]/g);
 el.classList.add(side==='lead'?'aoUiIconLead':'aoUiIconTrail');
 if(side==='lead')el.prepend(icon(id));else el.append(icon(id));
 el.dataset.aoTierAIcon=id
}
function normalizeButtonGlyphs(){
 document.querySelectorAll('button').forEach(el=>{
  const raw=directText(el),aria=(el.getAttribute('aria-label')||'').toLowerCase();
  if(!raw)return;
  if(/^[×]\s*$/.test(raw)){iconOnly(el,'ao-ui-close',aria||'Close');return}
  if(/^[⌂]\s*$/.test(raw)){iconOnly(el,'ao-ui-home',aria||'Home');return}
  if(/^[⚙]\s*$/.test(raw)){iconOnly(el,'ao-ui-settings',aria||'Settings');return}
  if(/^[▦]\s*$/.test(raw)){iconOnly(el,'ao-refined-calendar-upcoming',aria||'Open date picker');return}
  if(/^[‹←]/.test(raw)){
   if(/close|fermer/.test(aria)||el.matches('[data-prepare-close],[data-thanks-close]')){stripDirect(el,/^[\s‹←]+/);lead(el,'ao-ui-close');return}
   if(/back|retour/.test(aria)||el.matches('[data-pb-back],[data-v25-panel-back],[data-v38-back],[data-v26-back],[data-v261-back],[data-v352-home],[data-ao354-back],[data-v37-domain="today"],[data-v381-back],[data-v383-back],[data-life-close],[data-learn-back],[data-cate-back]')){stripDirect(el,/^[\s‹←]+/);lead(el,'ao-ui-back');return}
   stripDirect(el,/^[\s‹←]+/);lead(el,'ao-ui-previous');return
  }
  if(/[→›]\s*$/.test(raw)){
   stripDirect(el,/[→›]\s*$/);
   if(/return home|retour à l’accueil|retour a l'accueil/.test(raw.toLowerCase()))trail(el,'ao-ui-home');
   else trail(el,'ao-ui-next');
   return
  }
  if(/✓/.test(raw)&&el.matches('.aoMarkDone,[data-cate-learn],[data-ao354-complete],.aoRuleModuleCheck,[data-ao-rule-toggle-static]')){
   stripDirect(el,/✓/g);lead(el,'ao-ui-check')
  }
 })
}
function normalizeGlyphNodes(){
 document.querySelectorAll('.v38Arrow,.v383Arrow,.aoCU20Arrow,.aoCU23Arrow').forEach(el=>iconOnly(el,'ao-ui-next','Next'));
 document.querySelectorAll('.aoSetChevron').forEach(el=>{
  const t=(el.textContent||'').trim();
  iconOnly(el,t==='×'?'ao-ui-close':'ao-ui-next',t==='×'?'Close':'Next')
 });
 document.querySelectorAll('.aoLessonDone').forEach(el=>{
  const t=(el.textContent||'').trim();
  iconOnly(el,t==='✓'?'ao-ui-check':'ao-ui-next',t==='✓'?'Completed':'Open')
 });
 document.querySelectorAll('.aoCateMiniMark[title="Learned"],.aoDailyCateSummary .mark').forEach(el=>iconOnly(el,'ao-ui-check','Completed'))
}
function syncSelected(){
 document.querySelectorAll('.aoUiSelected').forEach(el=>{el.classList.remove('aoUiSelected');el.querySelectorAll(':scope > svg[data-ao-selected-icon]').forEach(n=>n.remove())});
 document.querySelectorAll('.homeSegments button.active,.segmented button.active').forEach(el=>{
  if(el.querySelector(':scope > .aoUiIcon'))return;
  const i=icon('ao-ui-check');i.dataset.aoSelectedIcon='1';el.prepend(i);el.classList.add('aoUiSelected')
 })
}
function externalLinks(){
 document.querySelectorAll('a[target="_blank"]').forEach(el=>{
  if(el.querySelector(':scope > .aoUiIcon'))return;
  stripDirect(el,/\s*↗\s*$/);
  el.classList.add('aoUiExternal');el.append(icon('ao-ui-external'));el.dataset.aoTierAIcon='ao-ui-external'
 })
}
function disclosures(){
 document.querySelectorAll('.whyDetail>summary,.sourceNote>summary,.provenance>summary,.readerWarnings>summary').forEach(el=>{
  if(el.querySelector(':scope > .aoUiIcon'))return;
  el.classList.add('aoUiDisclosure');el.append(icon('ao-ui-expand'));el.dataset.aoTierAIcon='ao-ui-expand'
 })
}
function scan(){
 iconOnly(document.querySelector('[data-live-home]'),'ao-ui-home','Home');
 iconOnly(document.querySelector('[data-live-sheet="settings"]'),'ao-ui-settings','Settings');

 document.querySelectorAll('button[data-scripture-close]').forEach(el=>iconOnly(el,'ao-ui-back',globalThis.AO_RUNTIME_V8?.store?.getState?.()?.language==='fr'?'Retour':'Back'));
 document.querySelectorAll('button[data-home-sheet-close],button[data-ao-close],button[data-auditclose],button[aria-label="Close"],button[aria-label="Fermer"]').forEach(el=>iconOnly(el,'ao-ui-close',globalThis.AO_RUNTIME_V8?.store?.getState?.()?.language==='fr'?'Fermer':'Close'));
 document.querySelectorAll('[data-live-prev],[data-pb-station-prev]').forEach(el=>prevNext(el,'ao-ui-previous','lead'));
 document.querySelectorAll('[data-live-next],[data-pb-station-next]').forEach(el=>prevNext(el,'ao-ui-next','trail'));
 document.querySelectorAll('button[data-v37-open="utility.sources"]').forEach(el=>lead(el,'ao-ui-sources'));
 document.querySelectorAll('button[data-v37-open="utility.settings"],button[data-home-open-settings]').forEach(el=>lead(el,'ao-ui-settings'));
 document.querySelectorAll('button[data-cate-view="search"]').forEach(el=>lead(el,'ao-ui-search'));
 document.querySelectorAll('button.whyButton,button[data-live-sheet="why"]').forEach(el=>lead(el,'ao-ui-info'));
 document.querySelectorAll('button[data-app-home],button[data-life-home]').forEach(el=>iconOnly(el,'ao-ui-home',el.getAttribute('aria-label')||'Home'));

 normalizeButtonGlyphs();normalizeGlyphNodes();externalLinks();disclosures();syncSelected();
 document.documentElement.dataset.aoTierAIcons='canonical-controls'
}
function queue(){if(!queued){queued=true;requestAnimationFrame(()=>{queued=false;scan()})}clearTimeout(timer);timer=setTimeout(scan,180)}
function installStore(){const store=globalThis.AO_RUNTIME_V8?.store;if(!store?.subscribe||storeHooked)return;storeHooked=true;store.subscribe(queue)}
function init(){
 scan();installStore();
 document.addEventListener('click',queue,true);document.addEventListener('change',queue,true);document.addEventListener('submit',queue,true);
 [80,240,700,1600,3400].forEach(ms=>setTimeout(()=>{installStore();scan()},ms));
 globalThis.AO_TIER_A_ICONS_V4313=Object.freeze({
  version:VERSION,ids:IDS,scan,
  inspect:()=>({version:VERSION,symbols:IDS.length,hydrated:document.querySelectorAll('[data-ao-tier-a-icon]').length,observerFree:![...document.scripts].some(s=>/new\s+MutationObserver\s*\(/.test(s.textContent||''))})
 })
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});else init();
})();
</script>
<script id="ao-v4314-mass-guidance-registry-js">
(()=>{
'use strict';
const DATA={"schema":"ao.mass-guidance.registry","version":"43.14","base":"43.13-harmonized-master","purpose":"Canonical lay-facing Mass guidance data layer for rubrics, gestures, posture profiles, guide sheets and audit.","principles":{"actor_authority_separate":true,"no_universal_lay_posture_claim":true,"private_priest_text_no_cue_spam":true,"exact_anchor_gestures":true,"full_cross_distinct_from_gospel_crosses":true,"source_types_distinct":["LAW","CEREMONY","CUSTOM","DEVOTION","HISTORY","THEOLOGY","SYMBOLISM"]},"authority":{"RUBRIC_1962":"RUBRIC_1962","GOVERNING_1958":"GOVERNING_1958","CHOIR_NORM":"CHOIR_NORM","CEREMONIAL_ANALOGY":"CEREMONIAL_ANALOGY","ESTABLISHED_LAY_CUSTOM":"ESTABLISHED_LAY_CUSTOM","LOCAL_CUSTOM":"LOCAL_CUSTOM","OPTIONAL_DEVOTION":"OPTIONAL_DEVOTION","OLDER_CUSTOM_NON_NORMATIVE_1962":"OLDER_CUSTOM_NON_NORMATIVE_1962","HISTORICAL":"HISTORICAL","SUPPRESSED":"SUPPRESSED"},"authority_labels":{"RUBRIC_1962":{"en":"1962 rubric","fr":"Rubrique de 1962"},"GOVERNING_1958":{"en":"Governing 1958 legislation","fr":"Législation normative de 1958"},"CHOIR_NORM":{"en":"Choir norm","fr":"Norme du chœur"},"CEREMONIAL_ANALOGY":{"en":"Traditional ceremonial analogy","fr":"Analogie cérémonielle traditionnelle"},"ESTABLISHED_LAY_CUSTOM":{"en":"Established traditional practice","fr":"Usage traditionnel établi"},"LOCAL_CUSTOM":{"en":"Local custom","fr":"Usage local"},"OPTIONAL_DEVOTION":{"en":"Optional devotion","fr":"Dévotion facultative"},"OLDER_CUSTOM_NON_NORMATIVE_1962":{"en":"Older custom — non-normative in the 1962 books","fr":"Usage ancien — non normatif dans les livres de 1962"},"HISTORICAL":{"en":"Historical note","fr":"Note historique"},"SUPPRESSED":{"en":"Suppressed in this context","fr":"Supprimé dans ce contexte"}},"source_registry":{"MR1962_RITUS":{"title":"Missale Romanum (1962) — Ritus servandus in celebratione Missae","type":"primary_rubric"},"MR1962_RG":{"title":"Missale Romanum (1962) — Rubricae generales Missalis Romani","type":"primary_rubric"},"DMS1958":{"title":"Sacra Congregatio Rituum — De musica sacra et sacra liturgia (1958)","type":"primary_legislation"},"OCONNELL":{"title":"J. B. O’Connell — The Celebration of Mass, revised for the 1960/62 books","type":"ceremonial_manual"},"FORTESCUE_OCONNELL1962":{"title":"Fortescue–O’Connell — The Ceremonies of the Roman Rite Described, 12th ed. (1962)","type":"ceremonial_manual"},"FORTESCUE_MASS":{"title":"Adrian Fortescue — The Mass: A Study of the Roman Liturgy","type":"historical"},"GUERANGER":{"title":"Dom Prosper Guéranger — Explanation of the Holy Mass","type":"traditional_spiritual_commentary"},"ALPHONSUS_GRIMM":{"title":"St Alphonsus / Grimm — The Holy Mass","type":"traditional_ascetical"},"GIHR":{"title":"Nikolaus Gihr — The Holy Sacrifice of the Mass","type":"traditional_theological"},"COCHEM":{"title":"Martin von Cochem — Explanation of the Holy Sacrifice of the Mass","type":"traditional_devotional"},"MULLER":{"title":"Michael Müller — The Holy Mass","type":"traditional_devotional"},"GAUME":{"title":"J.-J. Gaume — The Sign of the Cross","type":"traditional_devotional"},"WAPELHORST":{"title":"Wapelhorst — Compendium Sacrae Liturgiae","type":"traditional_ceremonial"},"HOLYWEEK1955_1962":{"title":"Restored Holy Week received by the 1962 Missal","type":"primary_rubric"}},"action_types":["SIGN_OF_CROSS","GOSPEL_CROSSES_3","BREAST_STRIKE_1","BREAST_STRIKE_3","HEAD_BOW","PROFOUND_BOW","GENUFLECT","KNEEL","RISE","STAND","SIT","ADORATION","RITUAL_ACTION"],"guide_library":{"SIGN_OF_CROSS":{"action_en":"Make the full Sign of the Cross with the right hand: forehead, breast, left shoulder, right shoulder.","action_fr":"Faire le grand signe de croix avec la main droite : front, poitrine, épaule gauche, épaule droite.","why_en":"This traditional lay gesture accompanies specific invocations or conclusions; it is not a cue to imitate every Sign of the Cross made by the priest.","why_fr":"Ce geste traditionnel accompagne certaines invocations ou conclusions ; il ne demande pas d’imiter chaque signe de croix du prêtre."},"GOSPEL_CROSSES_3":{"action_en":"With the right thumb, trace a small cross on the forehead, then the lips, then the breast.","action_fr":"Avec le pouce droit, tracer une petite croix sur le front, puis les lèvres, puis la poitrine.","why_en":"The three Gospel crosses are a distinct traditional gesture associated with receiving the Gospel in mind, speech and heart.","why_fr":"Les trois petites croix de l’Évangile sont un geste traditionnel distinct, associé à l’accueil de l’Évangile dans l’intelligence, la parole et le cœur."},"BREAST_STRIKE_1":{"action_en":"Strike the breast once at the indicated words.","action_fr":"Frapper la poitrine une fois aux paroles indiquées.","why_en":"A traditional penitential gesture of humility and acknowledged unworthiness.","why_fr":"Geste pénitentiel traditionnel d’humilité et d’indignité reconnue."},"BREAST_STRIKE_3":{"action_en":"Strike the breast three times with the repeated text.","action_fr":"Frapper la poitrine trois fois avec le texte répété.","why_en":"The repeated breast-striking accompanies the threefold penitential invocation or profession of unworthiness.","why_fr":"Les trois coups accompagnent la triple invocation pénitentielle ou profession d’indignité."},"HEAD_BOW":{"action_en":"Briefly incline the head at the indicated words.","action_fr":"Incliner brièvement la tête aux paroles indiquées.","why_en":"A restrained traditional act of reverence toward the sacred name or phrase.","why_fr":"Acte traditionnel et mesuré de révérence envers le nom ou la formule sacrée."},"PROFOUND_BOW":{"action_en":"Incline the upper body noticeably from the waist.","action_fr":"Incliner nettement le haut du corps à partir de la taille.","why_en":"A deeper bodily reverence, distinct from a simple head bow.","why_fr":"Révérence corporelle plus profonde, distincte d’une simple inclination de tête."},"GENUFLECT":{"action_en":"Place the right knee briefly on the ground, then rise unless the next cue says otherwise.","action_fr":"Poser brièvement le genou droit à terre, puis se relever sauf indication contraire.","why_en":"A concentrated bodily act of reverence or adoration.","why_fr":"Acte corporel concentré de révérence ou d’adoration."},"KNEEL":{"action_en":"Kneel and remain kneeling until the posture changes.","action_fr":"Se mettre à genoux et y rester jusqu’au changement de posture.","why_en":"Kneeling expresses adoration, humility, penitence or supplication according to context.","why_fr":"La posture à genoux exprime l’adoration, l’humilité, la pénitence ou la supplication selon le contexte."},"RISE":{"action_en":"Rise to a standing position.","action_fr":"Se relever et se tenir debout.","why_en":"This cue marks the end of the preceding kneeling or genuflection.","why_fr":"Cette indication marque la fin de la posture à genoux ou de la génuflexion précédente."},"STAND":{"action_en":"Stand attentively.","action_fr":"Se tenir debout avec attention.","why_en":"Standing is the traditional posture of attention, honour and readiness.","why_fr":"La station debout est la posture traditionnelle d’attention, d’honneur et de disponibilité."},"SIT":{"action_en":"Sit attentively.","action_fr":"S’asseoir avec attention.","why_en":"Sitting ordinarily accompanies listening or extended sung/textual sections.","why_fr":"La position assise accompagne ordinairement l’écoute ou les sections chantées ou textuelles prolongées."},"ADORATION":{"action_en":"Remain recollected in adoration.","action_fr":"Rester recueilli dans l’adoration.","why_en":"No additional invented bodily cue is required beyond the posture appropriate to the moment.","why_fr":"Aucun geste corporel inventé supplémentaire n’est requis au-delà de la posture propre au moment."},"RITUAL_ACTION":{"action_en":"Follow the indicated special-day ritual action.","action_fr":"Suivre l’action rituelle propre au jour indiquée.","why_en":"Special-day ceremonies use their own explicit sequence rather than the ordinary-Mass posture profile.","why_fr":"Les cérémonies propres à certains jours suivent leur séquence explicite plutôt que le profil ordinaire de la Messe."}},"posture_groups":{"entrance":{"default":"STAND","authority":"ESTABLISHED_LAY_CUSTOM"},"asperges":{"default":"STAND","authority":"ESTABLISHED_LAY_CUSTOM"},"foot-prayers":{"low":"KNEEL","sung":"KNEEL","authority":"ESTABLISHED_LAY_CUSTOM"},"introit-kyrie":{"low":"KNEEL","sung":"FOLLOW_LOCAL_CUSTOM","authority":"LOCAL_CUSTOM"},"gloria":{"low":"FOLLOW_LOCAL_CUSTOM","sung":"STAND","sung_long_setting":"FOLLOW_LOCAL_CUSTOM","authority":"LOCAL_CUSTOM"},"collect":{"low":"FOLLOW_LOCAL_CUSTOM","sung":"STAND","authority":"CHOIR_NORM"},"readings":{"low":"FOLLOW_LOCAL_CUSTOM","sung":"SIT","authority":"CEREMONIAL_ANALOGY"},"gospel":{"low":"STAND","sung":"STAND","authority":"ESTABLISHED_LAY_CUSTOM"},"homily":{"default":"SIT","authority":"ESTABLISHED_LAY_CUSTOM"},"credo":{"low":"FOLLOW_LOCAL_CUSTOM","sung":"STAND","authority":"LOCAL_CUSTOM"},"offertory":{"low":"FOLLOW_LOCAL_CUSTOM","sung":"SIT","authority":"CEREMONIAL_ANALOGY"},"preface":{"low":"FOLLOW_LOCAL_CUSTOM","sung":"STAND","authority":"LOCAL_CUSTOM"},"sanctus":{"default":"FOLLOW_LOCAL_CUSTOM","authority":"LOCAL_CUSTOM"},"canon":{"default":"KNEEL","authority":"ESTABLISHED_LAY_CUSTOM"},"pater":{"default":"FOLLOW_LOCAL_CUSTOM","authority":"LOCAL_CUSTOM"},"communion-prep":{"default":"FOLLOW_LOCAL_CUSTOM","common_traditional":"KNEEL","authority":"LOCAL_CUSTOM"},"communion-reception":{"default":"KNEEL","authority":"ESTABLISHED_LAY_CUSTOM"},"after-communion":{"default":"FOLLOW_LOCAL_CUSTOM","authority":"LOCAL_CUSTOM"},"postcommunion":{"low":"FOLLOW_LOCAL_CUSTOM","sung":"STAND","authority":"LOCAL_CUSTOM"},"dismissal":{"default":"STAND","authority":"ESTABLISHED_LAY_CUSTOM"},"blessing":{"default":"KNEEL","authority":"ESTABLISHED_LAY_CUSTOM"},"last-gospel":{"default":"STAND","authority":"ESTABLISHED_LAY_CUSTOM"},"recessional":{"default":"STAND","authority":"ESTABLISHED_LAY_CUSTOM"}},"ste