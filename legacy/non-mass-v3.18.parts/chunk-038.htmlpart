,"actor":"FAITHFUL","underlying_actor":null,"action":"SIGN_OF_CROSS","anchor_lat":"Benedíctus qui venit","anchor_en":"Blessed is He who comes","anchor_fr":"Béni soit celui qui vient","anchor_placement":"before","authority":"ESTABLISHED_LAY_CUSTOM","lay_status":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["OCONNELL","GUERANGER"],"conditions":{},"suppressions":[],"mass_forms":["LOW","SUNG","SOLEMN"],"season":"ANY","requiem":"CONTEXTUAL","special_day":"ANY","posture_before":null,"posture_after":null,"icon_semantic":"SIGN_OF_CROSS","printed_cross_icon_dedupe":true,"count":null,"prominence":"DETAIL","compatibility_only":false,"guide":{"action_en":"Make the full Sign of the Cross with the right hand: forehead, breast, left shoulder, right shoulder.","action_fr":"Faire le grand signe de croix avec la main droite : front, poitrine, épaule gauche, épaule droite.","why_en":"This traditional lay gesture accompanies specific invocations or conclusions; it is not a cue to imitate every Sign of the Cross made by the priest.","why_fr":"Ce geste traditionnel accompagne certaines invocations ou conclusions ; il ne demande pas d’imiter chaque signe de croix du prêtre.","status_en":"Established traditional practice","status_fr":"Usage traditionnel établi","sources":["OCONNELL","GUERANGER"]},"raw":{"kind":"cross","label":"Sign of the cross","authority":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["GUERANGER","COCHEM","MULLER"]}},{"id":"nobis-quoque:1:breast_strike_1","step":"nobis-quoque","actor":"FAITHFUL","underlying_actor":"celebrant","action":"BREAST_STRIKE_1","anchor_lat":"Nobis quoque peccatóribus","anchor_en":"To us also Thy sinful servants","anchor_fr":"À nous aussi, vos serviteurs pécheurs","anchor_placement":"before","authority":"ESTABLISHED_LAY_CUSTOM","lay_status":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["MR1962_RITUS","OCONNELL"],"conditions":{},"suppressions":[],"mass_forms":["LOW","SUNG","SOLEMN"],"season":"ANY","requiem":"CONTEXTUAL","special_day":"ANY","posture_before":null,"posture_after":null,"icon_semantic":"BREAST_STRIKE_1","printed_cross_icon_dedupe":false,"count":1,"prominence":"CORE","compatibility_only":false,"guide":{"action_en":"Strike the breast once at the indicated words.","action_fr":"Frapper la poitrine une fois aux paroles indiquées.","why_en":"A traditional penitential gesture of humility and acknowledged unworthiness.","why_fr":"Geste pénitentiel traditionnel d’humilité et d’indignité reconnue.","status_en":"Established traditional practice","status_fr":"Usage traditionnel établi","sources":["MR1962_RITUS","OCONNELL"]},"raw":{"kind":"action","label":"Strike breast","authority":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["GUERANGER"]}},{"id":"agnus:1:breast_strike_3","step":"agnus","actor":"FAITHFUL","underlying_actor":"celebrant","action":"BREAST_STRIKE_3","anchor_lat":"Agnus Dei","anchor_en":"Lamb of God","anchor_fr":"Agneau de Dieu","anchor_placement":"before","authority":"ESTABLISHED_LAY_CUSTOM","lay_status":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["OCONNELL"],"conditions":{},"suppressions":[{"when":{"requiem":true},"reason":"Requiem Agnus does not use the ordinary breast-strike cue."}],"mass_forms":["LOW","SUNG","SOLEMN"],"season":"ANY","requiem":"CONTEXTUAL","special_day":"ANY","posture_before":null,"posture_after":null,"icon_semantic":"BREAST_STRIKE_3","printed_cross_icon_dedupe":false,"count":3,"prominence":"CORE","compatibility_only":false,"guide":{"action_en":"Strike the breast three times with the repeated text.","action_fr":"Frapper la poitrine trois fois avec le texte répété.","why_en":"The repeated breast-striking accompanies the threefold penitential invocation or profession of unworthiness.","why_fr":"Les trois coups accompagnent la triple invocation pénitentielle ou profession d’indignité.","status_en":"Established traditional practice","status_fr":"Usage traditionnel établi","sources":["OCONNELL"]},"raw":{"kind":"action","label":"Strike breast ×3","authority":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["GUERANGER","COCHEM","MULLER"]}},{"id":"domine-non-sum-dignus:1:breast_strike_3","step":"domine-non-sum-dignus","actor":"FAITHFUL","underlying_actor":"celebrant","action":"BREAST_STRIKE_3","anchor_lat":"Dómine, non sum dignus","anchor_en":"Lord, I am not worthy","anchor_fr":"Seigneur, je ne suis pas digne","anchor_placement":"before","authority":"ESTABLISHED_LAY_CUSTOM","lay_status":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["OCONNELL"],"conditions":{},"suppressions":[],"mass_forms":["LOW","SUNG","SOLEMN"],"season":"ANY","requiem":"CONTEXTUAL","special_day":"ANY","posture_before":null,"posture_after":null,"icon_semantic":"BREAST_STRIKE_3","printed_cross_icon_dedupe":false,"count":3,"prominence":"CORE","compatibility_only":false,"guide":{"action_en":"Strike the breast three times with the repeated text.","action_fr":"Frapper la poitrine trois fois avec le texte répété.","why_en":"The repeated breast-striking accompanies the threefold penitential invocation or profession of unworthiness.","why_fr":"Les trois coups accompagnent la triple invocation pénitentielle ou profession d’indignité.","status_en":"Established traditional practice","status_fr":"Usage traditionnel établi","sources":["OCONNELL"]},"raw":{"kind":"action","label":"Strike breast","authority":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["GUERANGER","COCHEM","MULLER"]}},{"id":"blessing:1:sign_of_cross","step":"blessing","actor":"FAITHFUL","underlying_actor":null,"action":"SIGN_OF_CROSS","anchor_lat":"Benedícat vos","anchor_en":"May almighty God bless you","anchor_fr":"Que le Dieu tout-puissant vous bénisse","anchor_placement":"before","authority":"ESTABLISHED_LAY_CUSTOM","lay_status":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["OCONNELL","GUERANGER"],"conditions":{},"suppressions":[{"when":{"requiem":true},"reason":"The final blessing is omitted in a Requiem Mass."}],"mass_forms":["LOW","SUNG","SOLEMN"],"season":"ANY","requiem":"CONTEXTUAL","special_day":"ANY","posture_before":null,"posture_after":null,"icon_semantic":"SIGN_OF_CROSS","printed_cross_icon_dedupe":true,"count":null,"prominence":"CORE","compatibility_only":false,"guide":{"action_en":"Make the full Sign of the Cross with the right hand: forehead, breast, left shoulder, right shoulder.","action_fr":"Faire le grand signe de croix avec la main droite : front, poitrine, épaule gauche, épaule droite.","why_en":"This traditional lay gesture accompanies specific invocations or conclusions; it is not a cue to imitate every Sign of the Cross made by the priest.","why_fr":"Ce geste traditionnel accompagne certaines invocations ou conclusions ; il ne demande pas d’imiter chaque signe de croix du prêtre.","status_en":"Established traditional practice","status_fr":"Usage traditionnel établi","sources":["OCONNELL","GUERANGER"]},"raw":{"kind":"cross","label":"Sign of the cross","authority":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["GUERANGER","COCHEM","MULLER"]}},{"id":"last-gospel-announcement:1:gospel_crosses_3","step":"last-gospel-announcement","actor":"FAITHFUL","underlying_actor":null,"action":"GOSPEL_CROSSES_3","anchor_lat":"Initium ✠ sancti Evangélii","anchor_en":"The beginning ✠ of the holy Gospel","anchor_fr":"Commencement ✠ du saint Évangile","anchor_placement":"before","authority":"ESTABLISHED_LAY_CUSTOM","lay_status":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["OCONNELL"],"conditions":{},"suppressions":[],"mass_forms":["LOW","SUNG","SOLEMN"],"season":"ANY","requiem":"CONTEXTUAL","special_day":"ANY","posture_before":null,"posture_after":null,"icon_semantic":"GOSPEL_CROSSES_3","printed_cross_icon_dedupe":false,"count":null,"prominence":"CORE","compatibility_only":false,"guide":{"action_en":"With the right thumb, trace a small cross on the forehead, then the lips, then the breast.","action_fr":"Avec le pouce droit, tracer une petite croix sur le front, puis les lèvres, puis la poitrine.","why_en":"The three Gospel crosses are a distinct traditional gesture associated with receiving the Gospel in mind, speech and heart.","why_fr":"Les trois petites croix de l’Évangile sont un geste traditionnel distinct, associé à l’accueil de l’Évangile dans l’intelligence, la parole et le cœur.","status_en":"Established traditional practice","status_fr":"Usage traditionnel établi","sources":["OCONNELL"]},"raw":{"kind":"cross","label":"Forehead · lips · breast","authority":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["OCONNELL_1962","GUERANGER"],"gestureForm":"SIGN_CROSS_GOSPEL"}},{"id":"last-gospel:1:genuflect","step":"last-gospel","actor":"FAITHFUL","underlying_actor":null,"action":"GENUFLECT","anchor_lat":"ET VERBUM CARO FACTUM EST.","anchor_en":"AND THE WORD WAS MADE FLESH.","anchor_fr":"ET LE VERBE S’EST FAIT CHAIR.","anchor_placement":"before","authority":"ESTABLISHED_LAY_CUSTOM","lay_status":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["OCONNELL"],"conditions":{},"suppressions":[],"mass_forms":["LOW","SUNG","SOLEMN"],"season":"ANY","requiem":"CONTEXTUAL","special_day":"ANY","posture_before":null,"posture_after":null,"icon_semantic":"GENUFLECT","printed_cross_icon_dedupe":false,"count":null,"prominence":"CORE","compatibility_only":false,"guide":{"action_en":"Place the right knee briefly on the ground, then rise unless the next cue says otherwise.","action_fr":"Poser brièvement le genou droit à terre, puis se relever sauf indication contraire.","why_en":"A concentrated bodily act of reverence or adoration.","why_fr":"Acte corporel concentré de révérence ou d’adoration.","status_en":"Established traditional practice","status_fr":"Usage traditionnel établi","sources":["OCONNELL"]},"raw":{"kind":"genuflect","label":"Traditional/local genuflection","authority":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["OCONNELL_1962","GUERANGER"]}},{"id":"last-gospel:2:rise","step":"last-gospel","actor":"FAITHFUL","underlying_actor":null,"action":"RISE","anchor_lat":"Et habitávit in nobis","anchor_en":"And dwelt among us","anchor_fr":"Et il a habité parmi nous","anchor_placement":"before","authority":"ESTABLISHED_LAY_CUSTOM","lay_status":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["OCONNELL"],"conditions":{},"suppressions":[],"mass_forms":["LOW","SUNG","SOLEMN"],"season":"ANY","requiem":"CONTEXTUAL","special_day":"ANY","posture_before":null,"posture_after":null,"icon_semantic":"RISE","printed_cross_icon_dedupe":false,"count":null,"prominence":"CORE","compatibility_only":false,"guide":{"action_en":"Rise to a standing position.","action_fr":"Se relever et se tenir debout.","why_en":"This cue marks the end of the preceding kneeling or genuflection.","why_fr":"Cette indication marque la fin de la posture à genoux ou de la génuflexion précédente.","status_en":"Established traditional practice","status_fr":"Usage traditionnel établi","sources":["OCONNELL"]},"raw":{"kind":"rise","label":"Rise","authority":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["OCONNELL_1962","GUERANGER"]}},{"id":"palms-gospel:1:gospel_crosses_3","step":"palms-gospel","actor":"FAITHFUL","underlying_actor":null,"action":"GOSPEL_CROSSES_3","anchor_lat":"Sequéntia ✠ sancti","anchor_en":"Continuation ✠ of the holy Gospel","anchor_fr":"Suite ✠ du saint Évangile","anchor_placement":"before","authority":"ESTABLISHED_LAY_CUSTOM","lay_status":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["OCONNELL"],"conditions":{},"suppressions":[],"mass_forms":["LOW","SUNG","SOLEMN"],"season":"ANY","requiem":"CONTEXTUAL","special_day":"ANY","posture_before":null,"posture_after":null,"icon_semantic":"GOSPEL_CROSSES_3","printed_cross_icon_dedupe":false,"count":null,"prominence":"CORE","compatibility_only":false,"guide":{"action_en":"With the right thumb, trace a small cross on the forehead, then the lips, then the breast.","action_fr":"Avec le pouce droit, tracer une petite croix sur le front, puis les lèvres, puis la poitrine.","why_en":"The three Gospel crosses are a distinct traditional gesture associated with receiving the Gospel in mind, speech and heart.","why_fr":"Les trois petites croix de l’Évangile sont un geste traditionnel distinct, associé à l’accueil de l’Évangile dans l’intelligence, la parole et le cœur.","status_en":"Established traditional practice","status_fr":"Usage traditionnel établi","sources":["OCONNELL"]},"raw":{"kind":"cross","label":"Forehead · lips · breast","authority":"PERIOD_1962_GUIDE","sourceRefs":["OCONNELL_1962","GUERANGER"],"gestureForm":"SIGN_CROSS_GOSPEL"}},{"id":"gf-between-lessons:1:kneel","step":"gf-between-lessons","actor":"FAITHFUL","underlying_actor":null,"action":"KNEEL","anchor_lat":"Flectámus génua","anchor_en":"Let us kneel","anchor_fr":"Fléchissons les genoux","anchor_placement":"before","authority":"RUBRIC_1962","lay_status":"RUBRIC_1962","sourceRefs":["HOLYWEEK1955_1962"],"conditions":{},"suppressions":[],"mass_forms":["LOW","SUNG","SOLEMN"],"season":"ANY","requiem":"CONTEXTUAL","special_day":"ANY","posture_before":null,"posture_after":null,"icon_semantic":"KNEEL","printed_cross_icon_dedupe":false,"count":null,"prominence":"CORE","compatibility_only":false,"guide":{"action_en":"Kneel and remain kneeling until the posture changes.","action_fr":"Se mettre à genoux et y rester jusqu’au changement de posture.","why_en":"Kneeling expresses adoration, humility, penitence or supplication according to context.","why_fr":"La posture à genoux exprime l’adoration, l’humilité, la pénitence ou la supplication selon le contexte.","status_en":"1962 rubric","status_fr":"Rubrique de 1962","sources":["HOLYWEEK1955_1962"]},"raw":{"kind":"kneel","label":"Kneel","authority":"RUBRIC_1962","sourceRefs":["MR_1962"]}},{"id":"gf-between-lessons:2:rise","step":"gf-between-lessons","actor":"FAITHFUL","underlying_actor":null,"action":"RISE","anchor_lat":"Leváte","anchor_en":"Arise","anchor_fr":"Levez-vous","anchor_placement":"before","authority":"RUBRIC_1962","lay_status":"RUBRIC_1962","sourceRefs":["HOLYWEEK1955_1962"],"conditions":{},"suppressions":[],"mass_forms":["LOW","SUNG","SOLEMN"],"season":"ANY","requiem":"CONTEXTUAL","special_day":"ANY","posture_before":null,"posture_after":null,"icon_semantic":"RISE","printed_cross_icon_dedup