<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#080c12"><meta name="application-name" content="Ad Orientem"><meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"><link rel="manifest" href="Ad-Orientem-v43.19.webmanifest"><title>Ad Orientem 2.0 · v43.57 Low Mass MC Binding</title><link rel="icon" type="image/png" sizes="192x192" href="data:image/png;base64,"><link rel="apple-touch-icon" sizes="180x180" href="data:image/png;base64,"><meta name="apple-mobile-web-app-title" content="Ad Orientem"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet"><style>@property --liturgical {
  syntax: '<color>';
  inherits: true;
  initial-value: #4f8f66;
}
:root {
  --bg: #080c12;
  --surface-1: rgba(16, 22, 31, .78);
  --surface-2: rgba(22, 29, 39, .84);
  --border: rgba(255,255,255,.105);
  --text: #eee9df;
  --muted: rgba(238,233,223,.68);
  --muted-2: rgba(238,233,223,.46);
  --rubric: #b85b58;
  --liturgical: #4f8f66;
  --liturgical-soft: color-mix(in srgb, var(--liturgical) 17%, transparent);
  --liturgical-border: color-mix(in srgb, var(--liturgical) 45%, rgba(255,255,255,.11));
  --liturgical-glow: color-mix(in srgb, var(--liturgical) 25%, transparent);
  --font-liturgical: 'EB Garamond', Georgia, 'Times New Roman', serif;
  --font-display: 'Cinzel', Georgia, 'Times New Roman', serif;
  --safe-top: env(safe-area-inset-top, 0px);
  --safe-bottom: env(safe-area-inset-bottom, 0px);
  --radius-s: 10px;
  --radius-m: 16px;
  --radius-l: 22px;
  --shadow: 0 18px 50px rgba(0,0,0,.28);
}


* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html, body { margin: 0; min-height: 100%; background: var(--bg); }
body {
  color: var(--text);
  font-family: var(--font-liturgical);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
button { font: inherit; }
button:focus-visible { outline: 2px solid var(--liturgical); outline-offset: 2px; }
#app { min-height: 100vh; min-height: 100dvh; }
.flowScreen{width:min(100%,680px);min-height:100vh;min-height:100dvh;margin:0 auto;padding:0 14px calc(84px + var(--safe-bottom))}.flowTop{position:sticky;top:0;z-index:15;margin:0 -14px;padding:calc(9px + var(--safe-top)) 12px 9px;display:grid;grid-template-columns:60px 1fr 80px;align-items:center;gap:6px;background:linear-gradient(180deg,rgba(8,12,18,.98),rgba(8,12,18,.9) 80%,transparent);backdrop-filter:blur(18px)}.flowTop>button{min-height:44px;border:0;background:transparent;color:var(--muted)}.flowTop>button:first-child{text-align:left;font-size:1.4rem}.flowTop>button:last-child{text-align:right;color:var(--liturgical);font-size:.68rem}.flowTop>div{text-align:center;display:flex;flex-direction:column;gap:2px}.flowTop span{color:var(--liturgical);font:600 .57rem/1 var(--font-display);text-transform:uppercase;letter-spacing:.08em}.flowTop b{font-size:.82rem}.flowProgress{display:flex;gap:5px;overflow-x:auto;padding:10px 0 4px;scrollbar-width:none}.flowProgress::-webkit-scrollbar{display:none}.flowProgress button{flex:0 0 auto;min-height:34px;padding:5px 9px;border:1px solid var(--border);border-radius:999px;background:rgba(255,255,255,.02);color:var(--muted-2);font-size:.67rem}.flowProgress button.active{border-color:var(--liturgical-border);background:var(--liturgical-soft);color:var(--text)}.flowProgress button.done{color:var(--liturgical)}.flowBody{padding:20px 1px 28px}.flowStepNo{color:var(--liturgical);font:600 .62rem/1 var(--font-display);text-transform:uppercase;letter-spacing:.09em}.flowBody h1{margin:8px 0 7px;font-family:var(--font-display);font-size:clamp(1.45rem,7vw,2.05rem);line-height:1.14;font-weight:600}.flowLead{margin:0 0 18px;color:var(--muted);font-size:.96rem;line-height:1.45}.flowPanel{margin:12px 0;padding:16px;border:1px solid var(--border);border-radius:16px;background:var(--surface-1)}.flowPanel.accent{border-color:var(--liturgical-border);background:linear-gradient(180deg,var(--liturgical-soft),rgba(255,255,255,.025))}.flowPanel h2{margin:6px 0;font-family:var(--font-display);font-size:1.18rem}.flowPanel p{color:var(--muted);line-height:1.45}.flowKicker{color:var(--liturgical);font:600 .62rem/1 var(--font-display);text-transform:uppercase;letter-spacing:.09em}.properGrid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.properGrid article{padding:12px;border:1px solid var(--border);border-radius:13px;background:rgba(255,255,255,.025)}.properGrid article b{color:var(--liturgical);font-size:.73rem}.properGrid article p{margin:6px 0 0;color:var(--muted);font-size:.86rem;line-height:1.35}.thread p+ p{padding-top:12px;border-top:1px solid var(--border)}.gospelExcerpt,.prayerText{font-family:var(--font-liturgical);font-size:1.08rem;line-height:1.52;color:var(--text)}.flowAction{min-height:44px;border:0;background:transparent;color:var(--liturgical);font-weight:600}.checkList{margin:0;padding-left:1.2rem;color:var(--muted);line-height:1.5}.checkList li+li{margin-top:8px}.flowPanel textarea{width:100%;min-height:110px;margin-top:12px;padding:12px;border:1px solid var(--border);border-radius:12px;background:rgba(0,0,0,.18);color:var(--text);font:1rem/1.4 var(--font-liturgical);resize:vertical}.flowPanel details{margin-top:12px}.flowPanel summary{color:var(--liturgical);cursor:pointer}.prayerTabs{display:flex;gap:6px;overflow-x:auto;margin:0 0 10px;scrollbar-width:none}.prayerTabs button{flex:0 0 auto;min-height:38px;padding:7px 10px;border:1px solid var(--border);border-radius:999px;background:rgba(255,255,255,.025);color:var(--muted)}.prayerTabs button.active{background:var(--liturgical-soft);border-color:var(--liturgical-border);color:var(--text)}.choiceRow{display:flex;gap:6px;flex-wrap:wrap;margin-top:12px}.choiceRow button{min-height:38px;padding:7px 10px;border:1px solid var(--border);border-radius:999px;background:rgba(255,255,255,.025);color:var(--text)}.silenceMarker{margin-top:12px;color:var(--liturgical);font-size:.8rem}.flowNav{position:fixed;z-index:20;left:50%;bottom:0;transform:translateX(-50%);width:min(100%,680px);height:calc(70px + var(--safe-bottom));padding:8px 14px calc(8px + var(--safe-bottom));display:grid;grid-template-columns:1fr 1fr;gap:8px;background:rgba(7,10,15,.96);border-top:1px solid var(--border);backdrop-filter:blur(18px)}.flowNav button{min-height:48px;border:0;background:transparent;color:var(--text);font-weight:600}.flowNav button:first-child{text-align:left}.flowNav button:last-child{text-align:right;color:var(--liturgical)}.flowNav button:disabled{opacity:.28}.whySheet{scroll-padding-bottom:24px;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}.primaryWhy{padding-top:10px;border-top:0}.primaryWhy p{color:var(--text);font-size:1.02rem;line-height:1.58;overflow-wrap:anywhere}.whyDetail{margin-top:10px;padding:0 12px;border:1px solid var(--border);border-radius:13px;background:rgba(255,255,255,.018);overflow:hidden;transition:border-color .18s ease,background .18s ease}.whyDetail[open]{border-color:var(--liturgical-border);background:rgba(255,255,255,.028)}.whyDetail.meaningDetail[open]{background:var(--liturgical-soft)}.whyDetail>summary{list-style:none;cursor:pointer;min-height:54px;display:grid;grid-template-columns:minmax(0,1fr) auto 20px;gap:10px;align-items:center;color:var(--liturgical);font:600 .72rem/1.2 var(--font-display);letter-spacing:.07em;text-transform:uppercase;user-select:none}.whyDetail>summary::-webkit-details-marker{display:none}.whyDetail>summary:after{content:'›';display:grid;place-items:center;width:20px;height:20px;font:400 1.45rem/1 system-ui,sans-serif;color:var(--muted);transform:rotate(0deg);transition:transform .16s ease,color .16s ease}.whyDetail[open]>summary:after{transform:rotate(90deg);color:var(--liturgical)}.whySummaryLabel{min-width:0}.whySummaryMeta{justify-self:end;padding:4px 7px;border:1px solid var(--border);border-radius:999px;color:var(--muted-2);font:600 .57rem/1 system-ui,sans-serif;letter-spacing:.035em;text-transform:none;white-space:nowrap;background:rgba(255,255,255,.025)}.whyDetail[open] .whySummaryMeta{border-color:var(--liturgical-border);color:var(--text)}.whyDetailBody{padding:1px 0 15px}.whyDetailBody>p{margin:0;color:var(--muted);font-size:.98rem;line-height:1.55}.whyDetail.meaningDetail .whyDetailBody>p{color:var(--text)}.whySources{list-style:none;padding:0;margin:0;display:grid;gap:10px}.whySources li{padding:11px 12px;border:1px solid var(--border);border-radius:12px;background:rgba(255,255,255,.025)}.whySources b{display:block;margin-top:4px;color:var(--text);font:600 .9rem/1.35 var(--font-display);overflow-wrap:anywhere}.whySources a{color:var(--text);text-decoration:none}.whySources a:focus-visible,.whyDetail>summary:focus-visible{outline:2px solid var(--liturgical);outline-offset:3px}.sourceLocator{display:block;margin-top:5px;color:var(--text);font-size:.78rem;line-height:1.42}.whySources p{margin:5px 0 0;color:var(--muted-2);font-size:.78rem;line-height:1.42}.sourceType{color:var(--liturgical);font:600 .56rem/1 var(--font-display);letter-spacing:.09em;text-transform:uppercase}.authorityNote{margin-top:12px!important;padding:10px 12px;border-left:2px solid var(--liturgical-border);background:var(--liturgical-soft);font-size:.8rem!important}.whyLanguageNote{margin:0 0 8px;padding:9px 11px;border:1px solid var(--border);border-radius:10px;color:var(--muted-2);font-size:.76rem;line-height:1.4}
@media(max-width:360px){.flowScreen{padding-left:10px;padding-right:10px}.flowTop{margin-left:-10px;margin-right:-10px}.properGrid{grid-template-columns:1fr}.flowTop{grid-template-columns:50px 1fr 70px}}


body {
  background:
    radial-gradient(circle at 50% 18%, color-mix(in srgb, var(--liturgical) 10%, transparent), transparent 34rem),
    linear-gradient(180deg, #0d121a 0%, #080b10 68%, #06080c 100%);
  transition: --liturgical .85s ease;
}
.homeScreen {
  width: min(100%, 680px);
  min-height: 100vh;
  min-height: 100dvh;
  margin: 0 auto;
  padding: calc(14px + var(--safe-top)) 16px calc(28px + var(--safe-bottom));
}
.homeHeader { position: relative; }
.brandRow { min-height: 48px; display: grid; grid-template-columns: 44px 1fr auto; align-items: center; gap: 10px; }
.brandMark { width: 42px; height: 42px; display:grid; place-items:center; border:1px solid var(--liturgical-border); border-radius:14px; background:var(--liturgical-soft); color:var(--liturgical); font:700 .72rem/1 var(--font-display); letter-spacing:.08em; }
.brandName { color: var(--liturgical); font: 700 .82rem/1.1 var(--font-display); letter-spacing: .14em; }
.brandSub { color: var(--muted-2); font-size:.76rem; margin-top:4px; }
.languageSwitch { display:flex; border:1px solid var(--border); border-radius:999px; padding:2px; background:rgba(255,255,255,.025); }
.languageSwitch button { min-width:34px; min-height:32px; border:0; border-radius:999px; background:transparent; color:var(--muted-2); font:600 .68rem/1 system-ui,sans-serif; }
.languageSwitch button.active { color:var(--text); background:var(--liturgical-soft); }
.dateNavigator { display:grid; grid-template-columns:44px 1fr 44px; align-items:center; margin:14px 0 10px; }
.iconButton, .dateTitle { border:0; background:transparent; color:inherit; min-height:44px; }
.iconButton { font-size:1.7rem; color:var(--muted); }
.dateTitle { display:flex; flex-direction:column; align-items:center; gap:1px; }
.dateTitle span { color:var(--muted); text-transform:capitalize; font-size:.82rem; }
.dateTitle b { font-family:var(--font-display); font-weight:600; font-size:.78rem; letter-spacing:.04em; }
.dateRail { display:grid; grid-template-columns:repeat(7,1fr); gap:5px; padding:6px; border:1px solid var(--border); background:rgba(255,255,255,.025); border-radius:16px; }
.dayCell { min-height:52px; border:0; border-radius:11px; background:transparent; color:var(--muted); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3px; }
.dayCell span { font:600 .62rem/1 system-ui,sans-serif; text-transform:uppercase; }
.dayCell b { font-size:.95rem; font-weight:600; }
.dayCell.today:not(.selected) b::after { content:''; display:block; width:3px; height:3px; margin:2px auto -5px; border-radius:50%; background:var(--liturgical); }
.dayCell.selected { color:var(--text); background:var(--liturgical-soft); box-shadow: inset 0 0 0 1px var(--liturgical-border); }
.celebrationBlock { text-align:center; padding:24px 4px 18px; }
.eyebrow, .sectionLabel, .cardKicker { color:var(--liturgical); font:600 .68rem/1.2 var(--font-display); letter-spacing:.11em; text-transform:uppercase; }
.celebrationBlock h1 { margin:9px auto 8px; max-width:560px; font-family:var(--font-display); font-size:clamp(1.45rem,7vw,2.2rem); line-height:1.12; font-weight:600; letter-spacing:.018em; text-wrap:balance; }
.metaLine { display:flex; flex-wrap:wrap; justify-content:center; gap:5px 12px; color:var(--muted); font-size:.82rem; }
.loadingLine { margin-top:12px; display:flex; justify-content:center; gap:7px; align-items:center; color:var(--muted-2); font-size:.78rem; }
.loadingLine span { width:7px; height:7px; border-radius:50%; background:var(--liturgical); box-shadow:0 0 14px var(--liturgical); animation:pulse 1.1s infinite alternate; }
@keyframes pulse { to { opacity:.35; } }
.statusCard { display:flex; flex-direction:column; gap:4px; padding:12px 14px; margin:0 0 15px; border:1px solid var(--border); border-radius:14px; background:rgba(255,255,255,.035); }
.statusCard strong { font-size:.86rem; }.statusCard span { color:var(--muted); font-size:.8rem; line-height:1.35; }
.statusCard.warning { border-color:var(--liturgical-border); }.statusCard.error { border-color:rgba(184,91,88,.38); }
.homeSection { margin:2px 0 18px; }
.sectionLabel { margin:0 0 9px 3px; color:var(--muted-2); }
.phaseActions { display:grid; grid-template-columns:1fr 1.14fr 1fr; gap:8px; }
.phaseButton { min-height:72px; border-radius:16px; border:1px solid var(--border); background:var(--surface-1); color:var(--text); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px; box-shadow:0 8px 28px rgba(0,0,0,.12); }
.phaseButton span { color:var(--muted-2); font:600 .64rem/1 var(--font-display); }.phaseButton b { font-size:.9rem; font-weight:600; }
.phaseButton.primary { border-color:var(--liturgical-border); background:linear-gradient(180deg,var(--liturgical-soft),rgba(255,255,255,.035)); box-shadow:0 12px 35px var(--liturgical-glow); }
.phaseButton.primary b { color:var(--liturgical); }
.contentCard { margin:0 0 11px; padding:17px; border:1px solid var(--border); border-radius:var(--radius-m); background:linear-gradient(180deg,rgba(255,255,255,.045),rgba(255,255,255,.025)); box-shadow:0 12px 38px rgba(0,0,0,.14); }
.gospelCard { border-color:var(--liturgical-border); }
.scriptureRef { margin-top:6px; color:var(--text); font-size:.87rem; font-weight:600; }
.contentCard p { margin:9px 0 0; color:var(--muted); font-size:1rem; line-height:1.48; }
.textAction { border:0; padding:11px 0 0; background:transparent; color:var(--liturgical); font-weight:600; font-size:.88rem; }
.textAction span { margin-left:5px; }
.massCard,.moreCard { display:grid; grid-template-columns:1fr 46px; align-items:center; gap:14px; }
.massCard p,.moreCard p { font-size:.88rem; margin-top:5px; }
.roundAction { width:44px; height:44px; border-radius:50%; border:1px solid var(--border); background:rgba(255,255,255,.04); color:var(--text); font-size:1.05rem; }
.massCard .roundAction { border-color:var(--liturgical-border); color:var(--liturgical); background:var(--liturgical-soft); }
.moreCard { opacity:.88; }.homeSpacer{height:4px}.alphaNotice { position:sticky; bottom:calc(8px + var(--safe-bottom)); margin:8px auto 0; max-width:440px; padding:9px 12px; border-radius:12px; background:rgba(7,10,14,.94); border:1px solid var(--border); color:var(--muted); text-align:center; font-size:.76rem; }
@media (min-width:700px) { .homeScreen { padding-left:24px; padding-right:24px; } }
@media (max-width:350px) { .homeScreen{padding-left:10px;padding-right:10px}.brandSub{display:none}.phaseButton b{font-size:.78rem}.contentCard{padding:14px}.dateRail{gap:2px;padding:4px}.dayCell{min-height:48px}.celebrationBlock{padding-top:18px}.celebrationBlock h1{font-size:1.35rem}.metaLine{font-size:.75rem} }
@media (prefers-reduced-motion: reduce) { body { transition:none; } .loadingLine span{animation:none;} }
.formularyChooser{display:flex;gap:6px;overflow-x:auto;margin:12px auto 0;padding:2px;max-width:560px;scrollbar-width:none}.formularyChooser::-webkit-scrollbar{display:none}.formularyChooser button{flex:0 0 auto;min-height:38px;padding:7px 11px;border:1px solid var(--border);border-radius:999px;background:rgba(255,255,255,.025);color:var(--muted);font-size:.78rem}.formularyChooser button.selected{border-color:var(--liturgical-border);background:var(--liturgical-soft);color:var(--text)}
.resumeCard{width:100%;min-height:58px;margin:0 0 16px;padding:10px 13px;border:1px solid var(--liturgical-border);border-radius:14px;background:linear-gradient(180deg,var(--liturgical-soft),rgba(255,255,255,.025));color:var(--text);display:grid;grid-template-columns:1fr auto;gap:3px 12px;text-align:left}.resumeCard span{color:var(--liturgical);font:600 .62rem/1 var(--font-display);text-transform:uppercase;letter-spacing:.09em}.resumeCard b{grid-column:2;grid-row:1/3;align-self:center;font-size:.86rem}.resumeCard small{color:var(--muted);font-size:.72rem}.homeSheetBackdrop{position:fixed;z-index:70;inset:0;background:rgba(0,0,0,.6);display:flex;align-items:flex-end;justify-content:center;padding-top:var(--safe-top)}.homeSheet{width:min(100%,680px);max-height:88dvh;overflow:auto;padding:18px 16px calc(24px + var(--safe-bottom));background:#0e141d;border:1px solid var(--border);border-bottom:0;border-radius:22px 22px 0 0}.homeSheet header{display:grid;grid-template-columns:1fr 44px;gap:10px;align-items:start;position:sticky;top:-18px;background:#0e141d;padding:18px 0 12px;z-index:2}.homeSheet header span{color:var(--liturgical);font:600 .62rem/1 var(--font-display);text-transform:uppercase;letter-spacing:.1em}.homeSheet header h2{margin:5px 0 0;font-family:var(--font-display);font-size:1.3rem}.homeSheet header button{width:44px;height:44px;border:1px solid var(--border);border-radius:50%;background:rgba(255,255,255,.03);color:var(--text);font-size:1.2rem}.homeMassOverview{display:grid;gap:8px}.homeMassOverview article{padding:12px;border:1px solid var(--border);border-radius:13px;background:rgba(255,255,255,.025)}.homeMassOverview article b{color:var(--liturgical);font:600 .64rem/1 var(--font-display);text-transform:uppercase;letter-spacing:.07em}.homeMassOverview article p{margin:7px 0 0;color:var(--muted);font-family:var(--font-liturgical);font-size:1rem;line-height:1.42;white-space:pre-line}.moreActions{display:grid;gap:8px}.moreActions button{min-height:68px;padding:12px 14px;text-align:left;border:1px solid var(--border);border-radius:14px;background:var(--surface-1);color:var(--text);display:flex;flex-direction:column;gap:5px}.moreActions button b{font-size:.95rem}.moreActions button span{color:var(--muted);font-size:.79rem}.homeSettingGroup{margin:16px 0}.homeSettingGroup>label{display:block;color:var(--muted);font-size:.76rem;margin-bottom:7px}.homeSegments{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;padding:3px;border:1px solid var(--border);border-radius:13px;background:rgba(255,255,255,.025)}.homeSegments button{min-height:42px;border:0;border-radius:10px;background:transparent;color:var(--muted);font-weight:600}.homeSegments button.active{background:var(--liturgical-soft);color:var(--text);box-shadow:inset 0 0 0 1px var(--liturgical-border)}.homeToggle{width:100%;min-height:58px;margin:10px 0;padding:10px 12px;border:1px solid var(--border);border-radius:13px;background:rgba(255,255,255,.025);color:var(--text);display:flex;justify-content:space-between;align-items:center;text-align:left}.homeToggle span{display:flex;flex-direction:column;gap:4px}.homeToggle small{color:var(--muted)}.homeToggle i{width:38px;height:22px;border-radius:999px;background:rgba(255,255,255,.12);position:relative}.homeToggle i:after{content:'';position:absolute;top:3px;left:3px;width:16px;height:16px;border-radius:50%;background:var(--muted)}.homeToggle i.on{background:var(--liturgical-soft)}.homeToggle i.on:after{left:19px;background:var(--liturgical)}.resetPostureHome{width:100%;min-height:44px;border:1px solid var(--border);border-radius:12px;background:transparent;color:var(--muted)}


.liveScreen{width:min(100%,650px);min-height:100vh;min-height:100dvh;margin:0 auto;padding:0 18px calc(76px + var(--safe-bottom));position:relative}
.liveTopbar{position:sticky;top:0;z-index:20;margin:0 -18px;padding:calc(7px + var(--safe-top)) 12px 6px;min-height:calc(54px + var(--safe-top));display:grid;grid-template-columns:42px minmax(0,1fr) 42px;gap:2px;align-items:center;background:rgba(8,12,18,.985)}
.topIcon{width:42px;height:42px;min-height:42px;border:0;background:transparent;color:var(--muted);display:grid;place-items:center;padding:0}.liveTopbar .srOnly{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}.topTitle{min-width:0;text-align:center}.topTitle b{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text);font:600 .64rem/1.1 var(--font-display);letter-spacing:.095em;text-transform:uppercase}.liveProgress{height:1px;margin:0 -18px;background:rgba(255,255,255,.045)}.liveProgress span{display:block;height:100%;background:var(--liturgical);opacity:.8;transition:width .25s ease}
