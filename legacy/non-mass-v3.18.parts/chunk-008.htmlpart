        if (!options.contextOnly && effectiveKind === 'gospel') {
            try {
                const raw = await this.fetcher.get(`${source_config_1.CATENA_BASE}${reference.slug}.jsonl`);
                const nodes = raw.split(/\r?\n/).filter(Boolean).map(line => { try { return JSON.parse(line); } catch { return null; } }).filter(Boolean);
                let chosen = nodes.filter((n) => { const r = range(n); return r && r.chapter === reference.chapter && r.start <= reference.end && r.end >= reference.start; });
                if (!chosen.length)
                    chosen = nodes.filter((n) => { const m = String(n.id || '').match(/\.(\d+)\.(\d+)$/); return m && +m[1] === reference.chapter && +m[2] >= reference.start && +m[2] <= reference.end; });
                englishCatena = chosen.flatMap((n) => (n.segments || []).filter((s) => s?.text).map((s) => ({ father: String(s.father || 'Traditional commentary'), text: String(s.text), citation: String(n.citation || reference.display), lemma: n.lemma ? String(n.lemma) : undefined })));
