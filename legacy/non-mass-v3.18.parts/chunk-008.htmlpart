            { id:'crampon', label:'Bible Crampon 1923', language:'fr', kind:'scripture', url:source_config_1.CRAMPON_URL, note:`Public-domain French Scripture corpus pinned at ${source_config_1.CRAMPON_REVISION.slice(0, 7)}.` }
        ];
