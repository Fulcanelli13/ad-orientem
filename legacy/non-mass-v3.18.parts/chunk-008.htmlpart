                pericope.fr = frenchChapter.filter(v => v.verse >= reference.start && v.verse <= reference.end).map(v => v.text).join('\n');
        }
        catch (e) {
            errors.push(`French Scripture: ${e instanceof Error ? e.message : String(e)}`);
