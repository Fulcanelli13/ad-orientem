                provenance.push({ id:'catena-fr-edition', label:'BnF · Péronne edition record', language:'fr', kind:'source-catalogue', url:source_config_1.PERONNE_BNF_CATALOG, note:'Bibliographic control record for the 8-volume Paris, L. Vivès, 1868–1869 edition: Matthew I–III, Mark IV, Luke V–VI, John VII–VIII.' });
            } else if (frenchCatenaUrl) provenance.push({ id:'catena-fr-link', label:'Chaîne d’Or · Péronne', language:'fr', kind:'commentary-link', url:frenchCatenaUrl, note:'Fallback historical French source link shown only when structured Wikisource ingestion is unavailable.' });
        } else if (englishCommentary?.sourceId === 'bellarmine-en') {
            provenance.push({ id:'bellarmine-en', label:'St Robert Bellarmine · Commentary on the Book of Psalms (1866)', language:'en', kind:'commentary', url:source_config_1.BELLARMINE_SOURCE, note:`Public-domain O’Sullivan translation, James Duffy 1866. Edition-level source: Internet Archive scan. Retrieval route: ${englishCommentary.retrievalUrl || source_config_1.BELLARMINE_IA_OCR}. Psalm numbering follows the traditional/Vulgate Psalter.` });
            provenance.push({ id:'bellarmine-scan', label:'Bellarmine 1866 scan', language:'en', kind:'source-scan', url:source_config_1.BELLARMINE_SCAN, note:'Public-domain scan used to anchor edition provenance independently of any modern transcription layer.' });
            if (frenchCommentary?.sourceId === 'augustin-raulx-fr') provenance.push({ id:'augustin-raulx-fr', label:'Saint Augustin · Discours sur les psaumes · Raulx 1864', language:'fr', kind:'commentary', url:frenchCommentary.sourceUrl, note:'French historical commentary integrated from the Raulx 1864 transcription on Wikisource. It is presented at Psalm/discourse level; the app does not claim one-to-one verse mapping.' });
        } else if (englishCommentary?.sourceId === 'haydock-en') {
            provenance.push({ id:'haydock-en', label:'Haydock Catholic Bible Commentary', language:'en', kind:'commentary', url:source_config_1.HAYDOCK_BASE, note:effectiveKind === 'psalm' ? 'Public-domain historical commentary shown only because the Bellarmine Psalm provider was unavailable for this request.' : 'Public-domain historical English Catholic commentary, pinned to donor corpus v2.0.0.' });
            if (effectiveKind === 'psalm') provenance.push({ id:'bellarmine-source', label:'St Robert Bellarmine · Commentary on the Book of Psalms (1866)', language:'en', kind:'commentary-source', url:source_config_1.BELLARMINE_SOURCE, note:'Primary Psalm source; retrieval failed for this request, so Haydock is explicitly marked as fallback.' });
            if (frenchCommentary?.sourceId === 'augustin-raulx-fr') provenance.push({ id:'augustin-raulx-fr', label:'Saint Augustin · Discours sur les psaumes · Raulx 1864', language:'fr', kind:'commentary', url:frenchCommentary.sourceUrl, note:'French historical commentary integrated from the Raulx 1864 transcription on Wikisource. It is presented at Psalm/discourse level; the app does not claim one-to-one verse mapping.' });
        } else if (frenchCommentary?.sourceId === 'augustin-raulx-fr') {
            provenance.push({ id:'augustin-raulx-fr', label:'Saint Augustin · Discours sur les psaumes · Raulx 1864', language:'fr', kind:'commentary', url:frenchCommentary.sourceUrl, note:'French historical commentary integrated from the Raulx 1864 transcription on Wikisource. It is presented at Psalm/discourse level; the app does not claim one-to-one verse mapping.' });
        }
        if (frenchCommentary?.sourceId === 'glaire-vigouroux-fr' || frenchChapterSummary) {
            provenance.push({ id:'glaire-vigouroux-fr', label:'J.-B. Glaire / F. Vigouroux · La sainte Bible selon la Vulgate (1905)', language:'fr', kind:frenchCommentary?.entries?.length?'commentary':'context', url:frenchCommentary?.sourceUrl || glaireVigourouxUrl(glaireVigourouxTitle(reference)), note:'Public-domain French Catholic Bible edition on Wikisource. Verse-linked notes are shown only where the 1905 edition actually attaches them; chapter summaries may enrich Context but do not count as verse commentary.' });
        }
        return { kind:effectiveKind, relationship:parsed.relationship, reference, pericope, englishChapter, latinChapter, frenchChapter, chapterSummary, frenchChapterSummary, englishNotes, englishCatena, englishCommentary, frenchCommentary, frenchCatenaUrl, provenance, errors };
    }
}
exports.ScriptureService = ScriptureService;

