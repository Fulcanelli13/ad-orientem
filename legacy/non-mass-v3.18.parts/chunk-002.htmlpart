function inspect(){const green=Object.values(DATA.rows).filter(x=>x.status==='GREEN').length,hold=Object.values(DATA.rows).filter(x=>x.status==='HOLD').length,noArt=Object.values(DATA.rows).filter(x=>x.status==='NO_ART').length;return{version:'phase1-proper-art-v1.2',green,hold,noArt,genericFallback:false,currentOnly:true,saintArtTouched:false,rosaryArtTouched:false,stationsArtTouched:false}}
