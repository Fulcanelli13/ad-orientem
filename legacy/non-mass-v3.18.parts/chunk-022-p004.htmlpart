 if(k==='bow'&&ev.nameBow==='pope')return l==='fr'?'Incliner · nom du Pape':'Bow · Pope’s name';
 if(k==='bow'&&ev.nameBow==='saint')return l==='fr'?'Incliner · saint du jour':'Bow · Saint of the day';
 return map[k]||ev.label||k.replace(/_/g,' ');
