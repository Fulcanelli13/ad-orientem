    goodFridayPassionHydration: 'pass'
  },
  frozenArchitecture: true
});
</script>
<style id="ao-daily-catechism-v357-css">
/* v35.7 Daily Catechism — one canonical Catechism corpus, one daily Home entry point */
.aoDailyCateHome{position:relative;overflow:hidden}
.aoDailyCateHome .cateCardCopy{min-width:0}
.aoDailyCateHome .aoDailyCateMeta{display:flex;gap:7px;flex-wrap:wrap;margin-top:6px}
.aoDailyCateHome .aoDailyCateMeta span{display:inline-flex;align-items:center;min-height:24px;padding:3px 8px;border:1px solid var(--border);border-radius:999px;color:var(--muted);font-size:.67rem;line-height:1}
.aoDailyCateHome.complete .aoDailyCateMeta span:first-child{border-color:var(--liturgical-border);color:var(--liturgical)}
body.aoDailyCateOpen{overflow:hidden}
.aoDailyCateBackdrop{position:fixed;inset:0;z-index:17850;background:rgba(2,5,9,.82);backdrop-filter:blur(14px);display:flex;align-items:flex-end;justify-content:center}
.aoDailyCateSheet{width:min(100%,720px);max-height:94dvh;overflow:auto;overscroll-behavior:contain;background:var(--bg);border:1px solid var(--border);border-bottom:0;border-radius:24px 24px 0 0;box-shadow:0 -24px 80px rgba(0,0,0,.48);padding-bottom:max(24px,var(--safe-bottom))}
.aoDailyCateTop{position:sticky;top:0;z-index:3;display:grid;grid-template-columns:42px 1fr 42px;gap:8px;align-items:center;padding:calc(12px + var(--safe-top)) 14px 11px;background:color-mix(in srgb,var(--bg) 95%,transparent);backdrop-filter:blur(16px);border-bottom:1px solid var(--border)}
.aoDailyCateTop button{width:42px;height:42px;border:1px solid var(--border);border-radius:50%;background:var(--surface-1);color:var(--text);font-size:1.15rem}
.aoDailyCateTop>div{text-align:center;min-width:0}.aoDailyCateTop small{display:block;color:var(--liturgical);font:.62rem/1.2 var(--font-display);letter-spacing:.11em;text-transform:uppercase}.aoDailyCateTop strong{display:block;margin-top:3px;font:600 1rem/1.2 var(--font-display)}
.aoDailyCateBody{padding:18px 16px 30px}
.aoDailyCateProgressHead{display:flex;align-items:center;justify-content:space-between;gap:10px;color:var(--muted);font-size:.73rem}.aoDailyCateProgressHead b{color:var(--text);font-family:var(--font-display)}
.aoDailyCateProgress{height:5px;margin:9px 0 18px;background:rgba(255,255,255,.07);border-radius:999px;overflow:hidden}.aoDailyCateProgress i{display:block;height:100%;background:var(--liturgical);border-radius:inherit;transition:width .2s ease} .aoDailyCateNotice{margin:10px 0;padding:10px 12px;border:1px solid var(--liturgical-border);border-radius:12px;background:var(--liturgical-soft);color:var(--muted);font-size:.78rem;line-height:1.4}
.aoDailyCateCard{padding:18px;border:1px solid var(--border);border-radius:18px;background:var(--surface-1)}
.aoDailyCateCard.context{border-color:var(--liturgical-border);background:linear-gradient(180deg,var(--liturgical-soft),var(--surface-1))}
.aoDailyCateKicker{display:flex;justify-content:space-between;gap:10px;align-items:center;color:var(--liturgical);font:.64rem/1.2 var(--font-display);letter-spacing:.09em;text-transform:uppercase}.aoDailyCateKicker span:last-child{color:var(--muted);letter-spacing:.05em}
.aoDailyCateCard h2{margin:12px 0 0;font:600 clamp(1.25rem,5vw,1.7rem)/1.28 var(--font-display);letter-spacing:.01em}
.aoDailyCateAnswer{margin-top:16px;padding-top:16px;border-top:1px solid var(--border);font-size:1rem;line-height:1.65;color:var(--text)}
.aoDailyCateSource{margin-top:12px;color:var(--muted);font-size:.7rem}
.aoDailyCateActions{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:14px}.aoDailyCateActions button,.aoDailyCateReveal,.aoDailyCateLink,.aoDailyCatePrimary{min-height:46px;border:1px solid var(--border);border-radius:13px;background:var(--surface-1);color:var(--text);padding:10px 12px;font-weight:650}.aoDailyCateReveal,.aoDailyCatePrimary{width:100%;margin-top:14px;border-color:var(--liturgical-border);background:var(--liturgical);color:#0b0d11}.aoDailyCateActions .knew{border-color:var(--liturgical-border);background:var(--liturgical-soft)}.aoDailyCateActions .review{color:var(--muted-2)}
.aoDailyCateLink{width:100%;margin-top:9px;background:transparent;color:var(--muted)}
.aoDailyCateSummary{padding:20px;border:1px solid var(--liturgical-border);border-radius:18px;background:var(--liturgical-soft);text-align:center}.aoDailyCateSummary .mark{font-size:2rem;color:var(--liturgical)}.aoDailyCateSummary h2{margin:7px 0 6px;font-family:var(--font-display)}.aoDailyCateSummary p{margin:0;color:var(--muted);line-height:1.5}
.aoDailyCateStats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:14px 0}.aoDailyCateStat{padding:12px 8px;border:1px solid var(--border);border-radius:14px;background:var(--surface-1);text-align:center}.aoDailyCateStat b{display:block;font:600 1.15rem/1 var(--font-display)}.aoDailyCateStat span{display:block;margin-top:5px;color:var(--muted);font-size:.66rem;line-height:1.2}
.aoDailyCateEmpty{padding:18px;border:1px solid var(--border);border-radius:16px;background:var(--surface-1)}.aoDailyCateEmpty h2{margin:0 0 8px;font-family:var(--font-display)}.aoDailyCateEmpty p{margin:0;color:var(--muted);line-height:1.5}
@media(max-width:430px){.aoDailyCateBody{padding:15px 13px 26px}.aoDailyCateCard{padding:16px 14px}.aoDailyCateActions{grid-template-columns:1fr}.aoDailyCateStats{grid-template-columns:1fr 1fr}.aoDailyCateStats .aoDailyCateStat:last-child{grid-column:1/-1}.aoDailyCateHome{grid-template-columns:minmax(0,1fr) 38px!important}.aoDailyCateHome .roundAction{width:38px!important;min-width:38px!important;height:38px!important}}
</style>
<script id="ao-daily-catechism-v357-js">
(()=>{'use strict';
const VERSION='43.59.29-daily-catechism-instant';
const KEY='ao_daily_catechism_v1';
const TOTAL=10;
const REVIEW_INTERVALS=[0,2,7,14,30,60];
let openState={open:false,revealed:false,loading:false,error:'',language:null,contentLanguage:null,fallbackNotice:''};
let memoryState={version:1,sessions:{},history:{},completionDates:[]};
let storageMode='unknown';
let homeQueued=false,midnightTimer=null,storeHooked=false;
const api=()=>window.AO_TRADITIONAL_CATECHISM||null;
const rt=()=>window.AO_RUNTIME_V8||null;
const appState=()=>rt()?.store?.getState?.()||null;
const lang=()=>appState()?.language==='fr'?'fr':'en';
const L=(en,fr)=>lang()==='fr'?fr:en;
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function load(){if(storageMode==='memory')return memoryState;try{const raw=localStorage.getItem(KEY);if(raw){const x=JSON.parse(raw);if(x&&x.version===1){memoryState=x;storageMode='persistent';return x}}if(storageMode==='unknown')storageMode='persistent'}catch{storageMode='memory'}return memoryState}
function save(s){memoryState=s;if(storageMode==='memory')return s;try{localStorage.setItem(KEY,JSON.stringify(s));storageMode='persistent'}catch{storageMode='memory'}return s}
function dateKey(d=new Date()){const y=d.getFullYear(),m=String(d.getMonth()+1).padStart(2,'0'),day=String(d.getDate()).padStart(2,'0');return `${y}-${m}-${day}`}
function addDays(key,n){const d=new Date(`${key}T12:00:00`);d.setDate(d.getDate()+n);return dateKey(d)}
function hash(s){let h=2166136261;for(const c of String(s)){h^=c.charCodeAt(0);h=Math.imul(h,16777619)}return h>>>0}
function rng(seed){let a=hash(seed)||1;return()=>{a+=0x6D2B79F5;let t=a;t=Math.imul(t^t>>>15,t|1);t^=t+Math.imul(t^t>>>7,t|61);return((t^t>>>14)>>>0)/4294967296}}
function shuffle(a,r){a=[...a];for(let i=a.length-1;i>0;i--){const j=Math.floor(r()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
function currentTitle(){const s=appState();if(s?.selectedDate&&s.selectedDate!==dateKey())return '';return String(s?.resolution?.day?.main?.title||s?.resolution?.main?.title||'')}
function contextTerms(title=currentTitle()){
 const x=title.toLowerCase();
 const sets=[
  [['corpus christi','eucharist','sacred heart','holy thursday','first friday','saint-sacrement','eucharistie','sacré-cœur','jeudi saint'],['eucharist','holy communion','mass','body of christ','blood of christ','communion','messe']],
  [['immaculate','assumption','mary','rosary','notre-dame','marie','immaculée','assomption','rosaire'],['mary','blessed virgin','mother of god','virgin mary','marie','sainte vierge','mère de dieu']],
  [['pentecost','holy spirit','holy ghost','pentecôte','saint-esprit'],['holy spirit','holy ghost','saint-esprit']],
  [['trinity','trinité'],['trinity','trinité']],
  [['christmas','nativity','noël','nativité','advent','avent'],['incarnation','son of god','jesus christ','incarnation','fils de dieu','jésus-christ']],
  [['easter','resurrection','pâques','résurrection'],['resurrection','risen','résurrection','ressuscité']],
  [['passion','good friday','cross','vendredi saint','croix'],['passion','cross','redemption','croix','rédemption']],
  [['all saints','saints','toussaint'],['communion of saints','saints','communion des saints']],
  [['all souls','requiem','dead','défunts','trépassés'],['purgatory','dead','purgatoire','défunts']],
  [['lent','quadragesima','carême'],['penance','fast','prayer','pénitence','jeûne','prière']]
 ];
 for(const [keys,terms] of sets)if(keys.some(k=>x.includes(k)))return terms;
 return []
}
function partLabel(p){return ({intro:L('Foundations','Fondements'),faith:L('Creed & Faith','Credo & Foi'),moral:L('Commandments','Commandements'),grace:L('Sacraments','Sacrements'),prayer:L('Prayer','Prière')})[p]||L('Catechism','Catéchisme')}
function stats(s=load()){const day=dateKey(),month=day.slice(0,7);const h=Object.values(s.history||{});return {encountered:h.filter(x=>x&&x.seen).length,due:h.filter(x=>x&&x.due&&x.due<=day).length,month:(s.completionDates||[]).filter(x=>x.startsWith(month)).length,learned:api()?.learnedCount?.()||0}}
function isWeak(h){return !!h&&h.lastOutcome==='review'}
function isDue(h,day){return !!h&&h.lastOutcome==='knew'&&(!h.due||h.due<=day)}
function pickDiverse(pool,count,used,r,parts=['intro','faith','moral','grace','prayer']){
 const groups=new Map(parts.map(p=>[p,[]]));const other=[];
 for(const q of shuffle(pool.filter(q=>!used.has(q.n)),r)){(groups.get(q.part)||other).push(q)}
 const out=[];let idx=Math.floor(r()*parts.length),guard=0;
 while(out.length<count&&guard<100){guard++;let moved=false;for(let k=0;k<parts.length&&out.length<count;k++){const p=parts[(idx+k)%parts.length],g=groups.get(p);while(g?.length&&used.has(g[0].n))g.shift();if(g?.length){const q=g.shift();used.add(q.n);out.push(q);moved=true}}idx=(idx+1)%parts.length;if(!moved)break}
 const rest=shuffle([...groups.values()].flat().concat(other).filter(q=>!used.has(q.n)),r);for(const q of rest){if(out.length>=count)break;used.add(q.n);out.push(q)}return out
}
function contextualQuestion(qs,s,used,r){const terms=contextTerms();if(!terms.length)return null;const candidates=qs.filter(q=>!used.has(q.n)&&terms.some(k=>(`${q.q} ${q.a}`).toLowerCase().includes(k)));if(!candidates.length)return null;const unseen=candidates.filter(q=>!s.history?.[q.n]&&!api()?.isLearned?.(q.n));const due=candidates.filter(q=>isWeak(s.history?.[q.n])||isDue(s.history?.[q.n],dateKey()));const pool=unseen.length?unseen:due.length?due:candidates;return shuffle(pool,r)[0]||null}
function buildSession(qs,s,contentLanguage=lang()){const day=dateKey(),r=rng(`${day}|daily-catechism|${contentLanguage}`),used=new Set,ids=[];let contextualId=null;
 const cq=contextualQuestion(qs,s,used,r);if(cq){used.add(cq.n);ids.push(cq.n);contextualId=cq.n}
 const weak=qs.filter(q=>isWeak(s.history?.[q.n]));
 const review=qs.filter(q=>!isWeak(s.history?.[q.n])&&(isDue(s.history?.[q.n],day)||(!s.history?.[q.n]&&api()?.isLearned?.(q.n))));
 const fresh=qs.filter(q=>!s.history?.[q.n]&&!api()?.isLearned?.(q.n));
 const quotas=cq?[[fresh,4],[review,3],[weak,2]]:[[fresh,5],[review,3],[weak,2]];
 for(const [pool,count] of quotas)ids.push(...pickDiverse(pool,count,used,r).map(q=>q.n));
 if(ids.length<TOTAL){const fallback=qs.filter(q=>!used.has(q.n));ids.push(...pickDiverse(fallback,TOTAL-ids.length,used,r).map(q=>q.n))}
 const session={date:day,ids:ids.slice(0,TOTAL),index:0,outcomes:{},completedAt:null,contextualId,contentLanguage,createdAt:Date.now()};s.sessions[day]=session;save(s);return session}
function ensureSession(){const a=api();if(!a?.questions)throw new Error(L('Catechism is not ready yet. Please try again.','Le Catéchisme n’est pas encore prêt. Veuillez réessayer.'));const uiLang=lang();let contentLang=uiLang;let qs=a.questions?.(contentLang)||[];openState.fallbackNotice='';if(qs.length<TOTAL){const en=a.questions?.('en')||[];if(en.length>=TOTAL){contentLang='en';qs=en;if(uiLang==='fr')openState.fallbackNotice=L('The French Catechism is not yet available on this device. Today’s lesson is using the embedded English core.','Le Catéchisme français n’est pas encore disponible sur cet appareil. La leçon du jour utilise le noyau anglais intégré.')}}if(qs.length<TOTAL)throw new Error(L('Daily Catechism needs at least ten available questions.','Le Catéchisme quotidien nécessite au moins dix questions disponibles.'));openState.contentLanguage=contentLang;const s=load(),day=dateKey();let session=s.sessions?.[day];if(!session||!Array.isArray(session.ids)||session.ids.length!==TOTAL||session.contentLanguage!==contentLang)session=buildSession(qs,s,contentLang);else openState.contentLanguage=session.contentLanguage;return {s,session,qs}}
function nextIndex(session){for(let i=0;i<session.ids.length;i++)if(!session.outcomes?.[session.ids[i]])return i;return session.ids.length}
function recordOutcome(id,outcome){const s=load(),session=s.sessions?.[dateKey()];if(!session)return;session.outcomes=session.outcomes||{};session.outcomes[id]=outcome;const old=s.history[id]||{seen:0,knew:0,review:0,level:0};const h={...old};h.seen=(h.seen||0)+1;h.last=dateKey();h.lastOutcome=outcome;if(outcome==='knew'){h.knew=(h.knew||0)+1;h.level=Math.min(5,(h.level||0)+1);h.due=addDays(h.last,REVIEW_INTERVALS[h.level]||60);api()?.setLearned?.(id,true)}else{h.review=(h.review||0)+1;h.level=0;h.due=addDays(h.last,1);api()?.setLearned?.(id,false)}s.history[id]=h;session.index=nextIndex(session);if(session.index>=TOTAL){session.completedAt=Date.now();if(!(s.completionDates||[]).includes(session.date)){s.completionDates=s.completionDates||[];s.completionDates.push(session.date)}}save(s);openState.revealed=false;render();queueHome()}
function close(){document.getElementById('ao-daily-cate-root')?.remove();document.body.classList.remove('aoDailyCateOpen');openState={open:false,revealed:false,loading:false,error:'',language:null,contentLanguage:null,fallbackNotice:''};queueHome()}
function shell(){let root=document.getElementById('ao-daily-cate-root');if(root)return root;root=document.createElement('div');root.id='ao-daily-cate-root';root.className='aoDailyCateBackdrop';root.innerHTML='<section class="aoDailyCateSheet" role="dialog" aria-modal="true"></section>';document.body.appendChild(root);document.body.classList.add('aoDailyCateOpen');root.addEventListener('click',e=>{if(e.target===root)close()});return root.querySelector('.aoDailyCateSheet')}
function top(){return `<header class="aoDailyCateTop"><button type="button" data-dc-back aria-label="${esc(L('Back','Retour'))}"><svg class="aoUiIcon" aria-hidden="true" focusable="false"><use href="#ao-ui-back"></use></svg></button><div><small>${esc(L('DAILY FORMATION','FORMATION QUOTIDIENNE'))}</small><strong>${esc(L('Daily Catechism','Catéchisme quotidien'))}</strong></div><span></span></header>`}
function studyReader(body,title=L('Daily Catechism','Catéchisme quotidien')){
 const P=globalThis.AO_PRESENTATION_SHELLS_V435920;
 if(P?.reader)return P.reader({
  title,
  context:L('Daily Formation','Formation quotidienne'),
  showLead:false,
  backAttrs:'data-dc-close',
  backIcon:'ao-ui-close',
  backLabel:L('Close','Fermer'),
  body:`<div class="aoDailyCateBody">${body}</div>`
 });
 return `${top()}<div class="aoDailyCateBody">${body}</div>`
}
function open(){openState.open=true;openState.loading=false;openState.error='';openState.revealed=false;openState.language=lang();shell();try{ensureSession()}catch(e){openState.error=String(e?.message||e)}render();queueHome();return true}
function render(){
 if(!openState.open)return;
 const box=shell();
 if(openState.loading){
  box.innerHTML=studyReader(`<div class="aoDailyCateEmpty"><h2>${esc(L('Preparing today’s lesson…','Préparation de la leçon du jour…'))}</h2><p>${esc(L('Loading your Catechism questions and review schedule.','Chargement des questions et du programme de révision.'))}</p></div>`);
  return
 }
 if(openState.error){
  box.innerHTML=studyReader(`<div class="aoDailyCateEmpty"><h2>${esc(L('Daily lesson unavailable','Leçon quotidienne indisponible'))}</h2><p>${esc(L('Today’s lesson could not be prepared. You can continue in the full Catechism.','La leçon du jour n’a pas pu être préparée. Vous pouvez continuer dans le Catéchisme complet.'))}</p><button class="aoDailyCatePrimary" data-dc-full>${esc(L('Open full Catechism','Ouvrir le Catéchisme complet'))}</button></div>`);
  return
 }
 const s=load(),session=s.sessions?.[dateKey()],contentLang=session?.contentLanguage||openState.contentLanguage||lang(),qs=api()?.questions?.(contentLang)||[];
 if(!session){openState.error=L('Could not create today’s lesson.','Impossible de créer la leçon du jour.');return render()}
 const done=Object.keys(session.outcomes||{}).length,st=stats(s);
 if(session.completedAt||done>=TOTAL){
  box.innerHTML=studyReader(`<div class="aoDailyCateSummary"><div class="mark"><svg class="aoUiIcon" aria-hidden="true" focusable="false"><use href="#ao-ui-check"></use></svg></div><h2>${esc(L('Daily lesson complete','Leçon quotidienne terminée'))}</h2><p>${esc(L('Ten questions completed today. Come back tomorrow for a new set.','Dix questions terminées aujourd’hui. Revenez demain pour une nouvelle série.'))}</p></div><div class="aoDailyCateStats"><div class="aoDailyCateStat"><b>${st.encountered}/433</b><span>${esc(L('questions encountered','questions rencontrées'))}</span></div><div class="aoDailyCateStat"><b>${st.due}</b><span>${esc(L('due for review','à revoir'))}</span></div><div class="aoDailyCateStat"><b>${st.month}</b><span>${esc(L('daily lessons this month','leçons ce mois-ci'))}</span></div></div><button class="aoDailyCatePrimary" data-dc-full>${esc(L('Open full Catechism','Ouvrir le Catéchisme complet'))}</button>`,L('Lesson complete','Leçon terminée'));
  return
 }
 const idx=nextIndex(session);session.index=idx;save(s);
 const id=session.ids[idx],q=qs.find(x=>x.n===id)||api()?.question?.(id,lang());
 if(!q){openState.error=L('This question is unavailable in the current language.','Cette question n’est pas disponible dans la langue actuelle.');return render()}
 const pct=Math.round(done/TOTAL*100),context=session.contextualId===id;
 const body=`<div class="aoDailyCateProgressHead"><b>${esc(L('Today’s lesson','Leçon du jour'))}</b><span>${done}/${TOTAL}</span></div><div class="aoDailyCateProgress"><i style="width:${pct}%"></i></div>${openState.fallbackNotice?`<div class="aoDailyCateNotice">${esc(openState.fallbackNotice)}</div>`:''}<p class="aoDailyCateStudyContext"><b>${esc(L(`Question ${done+1} of ${TOTAL}`,`Question ${done+1} sur ${TOTAL}`))}</b> · ${esc(L('Answer from memory, then reveal the Catechism answer.','Répondez de mémoire, puis affichez la réponse du Catéchisme.'))}</p><article class="aoDailyCateCard ${context?'context':''}"><div class="aoDailyCateKicker"><span>${context?esc(L('TODAY’S THEME','THÈME DU JOUR')):esc(partLabel(q.part))}</span><span>Q ${q.n} / 433</span></div><h2>${esc(q.q)}</h2>${openState.revealed?`<div class="aoDailyCateAnswer">${esc(q.a)}</div><div class="aoDailyCateSource">${esc(L('Catechism of St Pius X','Catéchisme de Saint Pie X'))} · Q ${q.n}</div><div class="aoDailyCateActions"><button class="knew" data-dc-outcome="knew" data-id="${q.n}">${esc(L('I knew this','Je le savais'))}</button><button class="review" data-dc-outcome="review" data-id="${q.n}">${esc(L('Review again','À revoir'))}</button></div>`:`<button class="aoDailyCateReveal" data-dc-reveal>${esc(L('Reveal answer','Afficher la réponse'))}</button>`}<button class="aoDailyCateLink" data-dc-study="${q.n}">${esc(L('Study this question in the full Catechism','Étudier cette question dans le Catéchisme complet'))}<svg class="aoUiIcon" aria-hidden="true" focusable="false"><use href="#ao-ui-next"></use></svg></button></article>`;
 box.innerHTML=studyReader(body,L('Daily Catechism','Catéchisme quotidien'))
}
function homeCopy(){const s=load(),session=s.sessions?.[dateKey()],st=stats(s),done=session?Object.keys(session.outcomes||{}).length:0,complete=!!session?.completedAt||done>=TOTAL;if(complete)return {title:L('Daily Catechism','Catéchisme quotidien'),desc:L('Today’s ten questions are complete.','Les dix questions du jour sont terminées.'),badge:L('10/10 completed today','10/10 terminées aujourd’hui'),meta:`${st.encountered}/433 ${L('encountered','rencontrées')} · ${st.month} ${L('this month','ce mois-ci')}`,complete:true};if(session)return {title:L('Daily Catechism','Catéchisme quotidien'),desc:L('Continue today’s St Pius X lesson.','Continuez la leçon de Saint Pie X du jour.'),badge:`${done}/10 ${L('completed','terminées')}`,meta:`${st.due} ${L('due for review','à revoir')}`,complete:false};return {title:L('Daily Catechism','Catéchisme quotidien'),desc:L('Ten St Pius X questions: new material, review and weak points.','Dix questions de Saint Pie X : nouveautés, révision et points faibles.'),badge:L('10 questions · today','10 questions · aujourd’hui'),meta:st.encountered?`${st.encountered}/433 ${L('encountered','rencontrées')}`:L('Start your first daily lesson','Commencez votre première leçon'),complete:false}}
const HOME_HERO={id:'pius-x-selected-5',url:'https://commons.wikimedia.org/wiki/Special:Redirect/file/Pope_Pius_X_%28ca_1907%29.jpg?width=240',source:'Wikimedia Commons · Pope Pius X (ca. 1907) · Giuseppe Felici · public domain'};
function ensureHome(){
 const home=document.querySelector('.homeScreen');if(!home)return false;
 let card=home.querySelector('.aoDailyCateHome');const copy=homeCopy();
 if(!card){
  card=document.createElement('section');card.className='contentCard aoCateHomeCard aoDailyCateHome';
  const coming=home.querySelector('#aoComingUpCardV4323');
  const anchor=coming||home.querySelector('.contentCard.gospelCard')||home.querySelector('.aoLearnHomeCard')||home.querySelector('.contentCard.massCard');
  const spacer=home.querySelector('.homeSpacer');
  if(anchor)anchor.after(card);else if(spacer)spacer.before(card);else home.appendChild(card)
 }
 card.classList.remove('aoHomeStablePlaceholder','aoHomeFormationSkeleton');
 card.setAttribute('aria-busy','false');card.removeAttribute('data-ao-home-placeholder');
 card.dataset.aoHero=HOME_HERO.id;card.dataset.aoHeroSource=HOME_HERO.url;
 card.setAttribute('aria-label',L('Daily Catechism of St Pius X','Catéchisme quotidien de Saint Pie X'));
 card.classList.toggle('complete',copy.complete);
 const html=`<span class="aoPiusHeroMedia" aria-hidden="true"><img alt="" src="${HOME_HERO.url}" decoding="async" referrerpolicy="no-referrer"></span><div class="cateCardCopy"><div class="cardKicker">${esc(L('Formation','Formation'))}</div><b>${esc(copy.title)}</b><span class="aoPiusXByline">${esc(L('St Pius X','Saint Pie X'))}</span><p>${esc(copy.desc)}</p><span class="aoCateBadge">${esc(copy.badge)}</span><div class="aoDailyCateMeta"><span>${esc(copy.meta)}</span></div></div><button class="roundAction aoUiIconOnly" type="button" data-dc-open aria-label="${esc(L('Open Daily Catechism','Ouvrir le Catéchisme quotidien'))}"><svg class="aoUiIcon" aria-hidden="true" focusable="false"><use href="#ao-ui-next"></use></svg></button>`;
 if(card.dataset.signature!==html){card.innerHTML=html;card.dataset.signature=html}
 document.dispatchEvent(new CustomEvent('ao:home-content-ready',{detail:{source:'daily-catechism-v43.58'}}));
 return true