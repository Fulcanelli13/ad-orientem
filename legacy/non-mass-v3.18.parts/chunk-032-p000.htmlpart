 padding:.2rem .34rem!important;border-left:2px solid color-mix(in srgb,var(--liturgical) 54%,transparent)!important;
 border-radius:0 4px 4px 0!important;background:color-mix(in srgb,var(--liturgical) 5%,transparent)!important;color:var(--text)!important
}
</style>
<script id="ao-v401-group-state-bootstrap">
(()=>{'use strict';function sync(){let g=false;try{g=localStorage.getItem('ao-prayer-recitation-mode')==='group'}catch{}document.documentElement.classList.toggle('aoRecitationGroup',g);return g}sync();document.addEventListener('click',e=>{const b=e.target.closest?.('[data-ao-recitation],[data-rc2-flow-recitation]');if(!b)return;const m=b.dataset.aoRecitation||b.dataset.rc2FlowRecitation;if(m!=='group'&&m!=='individual')return;try{localStorage.setItem('ao-prayer-recitation-mode',m)}catch{}queueMicrotask(sync)},true);window.AO_GROUP_RECITATION_V401={sync}})();
</script>
<style id="ao-v401-rule-css">
.aoRuleCard{
  margin:12px 0 14px;
  padding:9px 11px 10px;
  border:1px solid var(--border);
  border-radius:14px;
  background:linear-gradient(180deg,rgba(255,255,255,.035),rgba(255,255,255,.018));
  box-shadow:0 10px 26px rgba(0,0,0,.12)
}
.aoRuleHead{
  display:flex;align-items:center;justify-content:space-between;gap:10px;
  min-height:24px;margin-bottom:6px
}
.aoRuleHead button{
  border:0;background:transparent;color:var(--text);padding:0;
  font:600 .68rem/1.2 var(--font-display);letter-spacing:.11em;text-transform:uppercase
}
.aoRuleCount{color:var(--muted-2);font:.67rem/1.2 var(--font-display);letter-spacing:.05em}
.aoRuleNow{
  display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:10px;
  margin:0 -2px 6px;padding:6px 8px;
  border-left:2px solid var(--liturgical);
  background:var(--liturgical-soft);
  border-radius:0 8px 8px 0
}
.aoRuleNowText{min-width:0}
.aoRuleNowText small{
  display:block;color:var(--liturgical);
  font:600 .59rem/1.2 var(--font-display);letter-spacing:.09em;text-transform:uppercase;
  margin-bottom:2px
}
.aoRuleNowText strong{
  display:inline;color:var(--text);
  font:600 .96rem/1.15 var(--font-liturgical);
  white-space:nowrap
}
.aoRuleNowText span{
  display:inline;color:var(--muted);font-size:.66rem;line-height:1.15;margin-left:.38rem
}
.aoRuleNowAction{
  border:0;background:transparent;color:var(--liturgical);
  padding:5px 2px;font:700 .64rem/1 var(--font-display);letter-spacing:.07em;text-transform:uppercase;
  white-space:nowrap
}
.aoRuleStatic{display:flex;align-items:center;gap:5px;flex-wrap:nowrap;min-height:25px;overflow-x:auto;scrollbar-width:none;overscroll-behavior-inline:contain}.aoRuleStatic::-webkit-scrollbar{display:none}
.aoRulePill{
  display:inline-flex;align-items:center;min-width:0;
  border:1px solid rgba(255,255,255,.085);border-radius:999px;
  background:rgba(255,255,255,.022);overflow:hidden
}
.aoRulePill.done{background:color-mix(in srgb,var(--liturgical) 7%,transparent);border-color:color-mix(in srgb,var(--liturgical) 30%,var(--border))}
.aoRuleCheck,.aoRuleOpen,.aoRuleMore{
  border:0;background:transparent;color:var(--text);min-height:25px
}
.aoRuleCheck{
  width:25px;padding:0;color:var(--muted-2);font-size:.76rem
}
.aoRulePill.done .aoRuleCheck{color:var(--liturgical)}
.aoRuleOpen{
  padding:3px 8px 3px 0;font-size:.68rem;white-space:nowrap
}
.aoRuleMore{
  border:1px solid var(--border);border-radius:999px;padding:3px 8px;
  color:var(--muted);font-size:.65rem
}

/* Full rule sheet */
#aoRuleSheet{
  position:fixed;inset:0;z-index:12340;display:flex;align-items:flex-end;justify-content:center;
  background:rgba(0,0,0,.66);backdrop-filter:blur(10px)
}
#aoRuleSheet[hidden]{display:none!important}
.aoRuleSheetPanel{
  width:min(720px,100%);max-height:min(88vh,880px);overflow:auto;
  border:1px solid var(--border);border-bottom:0;border-radius:22px 22px 0 0;
  background:color-mix(in srgb,var(--bg) 92%,#142033);color:var(--text);
  box-shadow:0 -18px 60px rgba(0,0,0,.45);
  padding:0 16px calc(18px + var(--safe-bottom))
}
.aoRuleSheetTop{
  position:sticky;top:0;z-index:3;display:flex;align-items:center;gap:10px;
  margin:0 -16px;padding:12px 16px;
  border-bottom:1px solid var(--border);
  background:color-mix(in srgb,var(--bg) 94%,transparent);backdrop-filter:blur(14px)
}
.aoRuleSheetTop>div{flex:1}.aoRuleSheetTop small{
  display:block;color:var(--liturgical);
  font:600 .61rem/1.2 var(--font-display);letter-spacing:.1em;text-transform:uppercase
}
.aoRuleSheetTop h2{margin:2px 0 0;font:600 1.12rem/1.15 var(--font-display)}
.aoRuleSheetTop button{
  width:38px;height:38px;border:1px solid var(--border);border-radius:50%;
  background:transparent;color:var(--text);font-size:1.15rem
}
.aoRuleSection{padding:16px 0;border-bottom:1px solid var(--border)}
.aoRuleSection:last-child{border-bottom:0}
.aoRuleSectionHead{
  display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin-bottom:9px
}
.aoRuleSectionHead h3{
  margin:0;font:600 .72rem/1.2 var(--font-display);letter-spacing:.1em;text-transform:uppercase
}
.aoRuleSectionHead span{color:var(--muted-2);font-size:.72rem}
.aoRuleList{display:grid;gap:4px}
.aoRuleRow{
  display:grid;grid-template-columns:32px minmax(0,1fr) auto;align-items:center;gap:8px;
  min-height:42px;padding:4px 2px;border-bottom:1px solid rgba(255,255,255,.055)
}
.aoRuleRow:last-child{border-bottom:0}
.aoRuleRow .mark{
  width:28px;height:28px;border:1px solid var(--border);border-radius:50%;
  background:transparent;color:var(--muted)
}
.aoRuleRow.done .mark{color:var(--liturgical);border-color:var(--liturgical-border);background:var(--liturgical-soft)}
.aoRuleRow .open{
  border:0;background:transparent;color:var(--text);text-align:left;padding:4px 0
}
.aoRuleRow .open strong{display:block;font-weight:600;font-size:.9rem}
.aoRuleRow .open small{display:block;color:var(--muted);font-size:.69rem;margin-top:2px}
.aoRuleToggle{display:flex;align-items:center;gap:6px;color:var(--muted);font-size:.67rem}
.aoRuleToggle input{accent-color:var(--liturgical)}
.aoRuleHours{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}
.aoRuleHour{
  padding:9px;border:1px solid var(--border);border-radius:10px;background:rgba(255,255,255,.02)
}
.aoRuleHour label{
  display:block;color:var(--muted);font:600 .58rem/1.2 var(--font-display);
  letter-spacing:.07em;text-transform:uppercase;margin-bottom:5px
}
.aoRuleHour input,.aoRuleSelect{
  width:100%;min-height:34px;border:1px solid var(--border);border-radius:8px;
  background:var(--surface-1);color:var(--text);padding:6px 8px
}
.aoRuleSettingRow{
  display:flex;align-items:center;justify-content:space-between;gap:12px;
  padding:9px 0;border-bottom:1px solid rgba(255,255,255,.055)
}
.aoRuleSettingRow:last-child{border-bottom:0}
.aoRuleSettingRow strong{display:block;font-size:.85rem}
.aoRuleSettingRow small{display:block;color:var(--muted);font-size:.69rem;margin-top:2px;max-width:460px}
.aoRuleSettingRow input[type=checkbox]{accent-color:var(--liturgical)}
.aoRuleConditional{
  display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:8px;
  padding:8px 0;border-bottom:1px solid rgba(255,255,255,.055)
}
.aoRuleConditional:last-child{border-bottom:0}
.aoRuleConditional strong{font-size:.86rem}
.aoRuleConditional small{display:block;color:var(--muted);font-size:.68rem;margin-top:2px}
.aoRuleConditional button{
  border:1px solid var(--border);border-radius:999px;background:transparent;color:var(--text);
  min-height:32px;padding:5px 9px;font-size:.68rem
}
.aoRuleSource{
  color:var(--muted);font-size:.69rem;line-height:1.45
}
@media(max-width:430px){
  .aoRuleCard{padding:8px 9px 9px}
  .aoRuleStatic{gap:4px}
  .aoRuleOpen{font-size:.65rem}
  .aoRuleHours{grid-template-columns:1fr 1fr 1fr}
  .aoRuleHour{padding:7px}
  .aoRuleHour input{font-size:.78rem;padding:5px}
}
</style>
<script id="ao-v411-rule-js">
(()=>{'use strict';

const KEY='ao-rule-v411';
const VERSION='41.1-traditional-rule';

/*
  STATIC RULE
  -----------
  Only genuine all-day items belong here.
  Rosary is permanent. Mass appears on Sundays and on an explicitly-known
  holy day of obligation. Morning/evening prayer, Angelus and examination
  are NOT static habits.
*/
const STATIC=[
 {id:'rosary',en:'Rosary',fr:'Rosaire',route:'pray.rosary',authority:'traditional_rule'}
];

const DEFAULT={
 version:2,
 completion:{date:'',static:{},dynamic:{}}
};

const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const pad=n=>String(n).padStart(2,'0');
const iso=d=>`${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
const nowDate=()=>new Date();
const langOf=state=>state?.language==='fr'?'fr':'en';
const L=(state,en,fr)=>langOf(state)==='fr'?fr:en;
const clone=v=>JSON.parse(JSON.stringify(v));

function normalize(raw){
 const s=raw&&typeof raw==='object'?raw:{};
 const d=clone(DEFAULT);
 d.completion={...d.completion,...(s.completion||{})};
 d.completion.static={...(s.completion?.static||{})};
 d.completion.dynamic={...(s.completion?.dynamic||{})};
 const today=iso(nowDate());
 if(d.completion.date!==today)d.completion={date:today,static:{},dynamic:{}};
 return d;
}
function load(){try{return normalize(JSON.parse(localStorage.getItem(KEY)||'null'))}catch{return normalize(null)}}
function save(s){const n=normalize(s);try{localStorage.setItem(KEY,JSON.stringify(n))}catch{}return n}
function currentState(){return window.AO_RUNTIME_V8?.store?.getState?.()||window.AdOrientemB1?.runtime?.store?.getState?.()||null}
function isTodayState(state){return !!state&&state.selectedDate===iso(nowDate())}
function mins(hhmm){const m=String(hhmm||'').match(/^(\d{1,2}):(\d{2})$/);return m?(+m[1])*60+(+m[2]):null}
function clockMinutes(d){return d.getHours()*60+d.getMinutes()}

function liturgicalContext(state){
 const proper=state?.resolution?.proper?.status==='ready'?state.resolution.proper.data:null;
 const day=state?.resolution?.day;
 const path=String(proper?.sourcePath||day?.selectedMassOption?.path||day?.main?.path||'');
 const title=[proper?.name,proper?.nameFr,day?.main?.title,day?.main?.name].filter(Boolean).join(' · ');
 return {
  isLent:/^Tempora\/Quad/.test(path)||/\bLent|Car[eê]me|Quadragesim/i.test(title),
  isEastertide:/^Tempora\/Pasc/.test(path)||/Eastertide|Temps pascal/i.test(title)
 };
}

/* Do not invent local holy-day obligations. Use Sunday universally, and
   accept an explicit obligation flag when another app/jurisdiction layer
   actually supplies one. */
function explicitHolyDayObligation(state){
 return !!(
  state?.holyDayOfObligation ||
  state?.discipline?.holyDayOfObligation ||
  state?.resolution?.day?.holyDayOfObligation ||
  window.AO_CELEBRATION_ARCH_V1?.rubricContext?.holyDayOfObligation
 );
}
function staticItems(state,now=nowDate()){
 const out=[...STATIC];
 if(now.getDay()===0||explicitHolyDayObligation(state)){
  out.unshift({
   id:'mass.obligation',
   en:'Mass',fr:'Messe',
   route:'mass.current',
   authority:'obligation'
  });
 }
 return out;
}

/*
 INTERNAL DYNAMIC TIMETABLE
 --------------------------
 These times are resolver data only and are never printed on Home.

 04:30–05:45  Morning Prayers
 05:45–06:15  Angelus / Regina Cæli
 06:15–11:45  Morning Prayers, if not completed
 11:45–12:15  Angelus / Regina Cæli
 12:15–17:45  nothing
 17:45–18:15  Angelus / Regina Cæli
 18:15–20:30  Friday-in-Lent Stations; otherwise nothing
 20:30–22:30  Evening Prayers
 22:30–04:30  Examination of Conscience
*/
function schedulerItems(state,settings,now=nowDate()){
 if(!state||state.selectedDate!==iso(now))return [];
 const cm=clockMinutes(now),ctx=liturgicalContext(state),done=settings.completion.dynamic||{};
 const friday=now.getDay()===5;
 const regina=ctx.isEastertide;
 const prayerName=regina?'Regina Cæli':'Angelus';

 const morning={
  id:'daily.morning_prayers',
  title:L(state,'Morning Prayers','Prières du matin'),
  action:L(state,'PRAY','PRIER'),
  route:'pray.morning_evening',
  daypart:'morning',
  hero:null
 };
 const evening={
  id:'daily.evening_prayers',
  title:L(state,'Evening Prayers','Prières du soir'),
  action:L(state,'PRAY','PRIER'),
  route:'pray.morning_evening',
  daypart:'evening',
  hero:null
 };
 const exam={
  id:'daily.examination',
  title:L(state,'Examination of Conscience','Examen de conscience'),
  action:L(state,'BEGIN','COMMENCER'),
  route:'pray.confession',
  hero:null
 };
 const angelus=slot=>({
  id:`angelus.${slot}`,
  title:prayerName,
  action:L(state,'PRAY','PRIER'),
  route:'pray.angelus_regina',
  hero:{kind:'rosary-preview',set:'joyful',index:0,label:prayerName}
 });
 const stations={
  id:'lent.friday.stations',
  title:L(state,'Stations of the Cross','Chemin de Croix'),
  action:L(state,'PRAY','PRIER'),
  route:'pray.stations',
  hero:{kind:'rosary-preview',set:'sorrowful',index:3,label:L(state,'Stations','Chemin de Croix')}
 };

 const maybe=item=>done[item.id]?[]:[item];

 if(cm>=270&&cm<345)return maybe(morning);              // 04:30–05:45
 if(cm>=345&&cm<375)return maybe(angelus('morning'));  // 05:45–06:15
 if(cm>=375&&cm<705)return maybe(morning);             // 06:15–11:45
 if(cm>=705&&cm<735)return maybe(angelus('noon'));     // 11:45–12:15
 if(cm>=735&&cm<1065)return [];                        // 12:15–17:45
 if(cm>=1065&&cm<1095)return maybe(angelus('evening'));// 17:45–18:15
 if(cm>=1095&&cm<1230){                               // 18:15–20:30
   if(friday&&ctx.isLent)return maybe(stations);
   return [];
 }
 if(cm>=1230&&cm<1350)return maybe(evening);           // 20:30–22:30
 return maybe(exam);                                   // 22:30–04:30
}
function activeDynamic(state,settings,now=nowDate()){return schedulerItems(state,settings,now)[0]||null}

function traditionalRosarySet(now=nowDate()){
 /* Pre-Luminous traditional weekly distribution. */
 const d=now.getDay();
 if(d===1||d===4)return'joyful';
 if(d===2||d===5)return'sorrowful';
 return'glorious';
}
const AO_RULE_HERO_ASSETS_V4310=Object.freeze({"rosary":"data:image/webp;base64,