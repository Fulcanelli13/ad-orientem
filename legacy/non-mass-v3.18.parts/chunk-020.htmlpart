 else body=`<div class="pbKicker">${esc(prayerTitle(p))}</div>${flipText(p.la,p[lang()]||p.en,'ben',false)}${id==='benediction_o_salutaris'?`<p class="pbTiny">${t('O Salutaris is a very common traditional exposition hymn, but it is not the only possible hymn and should not be mistaken for the legal essence of exposition.','O Salutaris est un hymne traditionnel très courant pour l’exposition, mais il n’est pas le seul possible et ne doit pas être confondu avec l’essence juridique de l’exposition.')}</p>`:''}${id==='benediction_divine_praises'?`<p class="pbTiny">${t('The Divine Praises are a customary devotional conclusion in many places; they developed later than the core Benediction rite.','Les Louanges divines sont une conclusion dévotionnelle coutumière en de nombreux lieux ; elles se sont développées plus tard que le noyau du rite de la bénédiction.')}</p>`:''}`;
 return `<div class="pbShell"><div class="pbFlow">${top(t('Benediction prayers','Prières de la bénédiction'))}<div class="pbProgress"><span style="width:${((i+1)/seq.length*100).toFixed(1)}%"></span></div><section class="pbFlowCard">${body}</section><nav class="pbFlowNav"><button data-pb-ben-prev ${i===0?'disabled':''}>← ${t('Previous','Précédent')}</button><button data-pb-ben-next>${i===seq.length-1?t('Finish','Terminer'):t('Next','Suivant')} →</button></nav>${aoFormation('What is traditional and what is essential','Ce qui est traditionnel et ce qui est essentiel',`<p>${t('The classic Roman core near the end of Benediction is Tantum Ergo, the versicle Panem de cælo with its response, the collect Deus qui nobis, and the blessing itself. O Salutaris at exposition, the Divine Praises, and Adoremus in aeternum at reposition are venerable and widespread customary elements, but should be identified as such.','Le noyau romain classique vers la fin de la bénédiction comprend le Tantum Ergo, le verset Panem de cælo avec son répons, l’oraison Deus qui nobis et la bénédiction elle-même. O Salutaris à l’exposition, les Louanges divines et Adoremus in aeternum à la reposition sont des éléments vénérables et largement répandus, mais doivent être identifiés comme coutumiers.')}</p><div class="pbSourceRow"><a href="${AO_LINKS.benediction}" target="_blank" rel="noopener">Holy See · Eucharistic adoration / Benediction ↗</a></div>`)}</div></div>`;
};

const _aoRenderConfession=renderConfession;
renderConfession=function(){
 const html=_aoRenderConfession();
 const extra=aoFormation('Traditional manner of confession','Manière traditionnelle de se confesser',`<p>${t('Older Roman prayer books commonly begin with a blessing request such as “Benedic mihi, Pater, quia peccavi” (“Bless me, Father, for I have sinned”) and may use part of the Confiteor before the accusation. These are venerable forms, not conditions for validity.','Les anciens livres romains commencent souvent par une demande de bénédiction telle que « Benedic mihi, Pater, quia peccavi » (« Bénissez-moi, mon Père, parce que j’ai péché ») et peuvent employer une partie du Confiteor avant l’accusation. Ce sont des formes vénérables, non des conditions de validité.')}</p><div class="pbTradFormula"><code>Benedic mihi, Pater, quia peccavi.</code><br>${t('Bless me, Father, for I have sinned.','Bénissez-moi, mon Père, parce que j’ai péché.')}</div><p>${t('Current canon law governs what must be confessed: remembered grave sins not yet directly remitted must be confessed in kind and number after diligent examination; confession of venial sins is recommended.','Le droit canonique actuel gouverne ce qui doit être confessé : les péchés graves dont on se souvient et qui n’ont pas encore été directement remis doivent être confessés selon leur espèce et leur nombre après un examen diligent ; la confession des péchés véniels est recommandée.')}</p><div class="pbSourceRow"><a href="${AO_LINKS.confession}" target="_blank" rel="noopener">CIC 987–988 ↗</a></div>`);
 return html.replace('</div></div>',extra+'</div></div>');
};

const AO_PRAYER_FORMATION={
 mass_devotion_leonine:{en:'These are the historical Prayers after Low Mass: three Hail Marys, Salve Regina with versicle and collect, the Prayer to St Michael, and the invocation Most Sacred Heart of Jesus three times. They were recited kneeling after Low Mass and were distinct from the Mass itself. Inter Oecumenici 48(j) suppressed their universal prescription in 1964/65; their use today is voluntary or customary unless a competent authority provides otherwise.',fr:'Il s’agit des anciennes Prières après la Messe basse : trois Ave Maria, Salve Regina avec verset et oraison, prière à saint Michel, puis trois fois l’invocation au Très Saint Cœur de Jésus. Elles étaient récitées à genoux après la Messe basse et demeuraient distinctes de la Messe elle-même. Inter Oecumenici 48(j) supprima leur prescription universelle en 1964/65 ; leur usage actuel est volontaire ou coutumier sauf disposition contraire de l’autorité compétente.',links:[[AO_LINKS.leonineText,'Historical text'],[AO_LINKS.leonineSuppressed,'Inter Oecumenici 48(j)']] },
 mass_confiteor:{en:'This is the traditional Confiteor familiar from the 1962 Mass, with invocation of St Michael, St John the Baptist and Saints Peter and Paul. Its use inside the Mass belongs to the liturgical form; using it privately or in preparation for confession is devotional and is not required for sacramental validity.',fr:'Il s’agit du Confiteor traditionnel familier de la Messe de 1962, avec l’invocation de saint Michel, saint Jean-Baptiste et des saints Pierre et Paul. Son emploi dans la Messe appartient à la forme liturgique ; son emploi privé ou dans la préparation à la confession est dévotionnel et n’est pas requis pour la validité du sacrement.',links:[]},
 litany_loreto_1962:{en:'This form preserves the invocations found in the 1962-era devotional corpus. Later invocations should not be silently retrofitted into a historical TLM prayer form; use the separate current version when you want the contemporary Litany.',fr:'Cette forme conserve les invocations du corpus dévotionnel de l’époque de 1962. Les invocations ajoutées ultérieurement ne doivent pas être insérées silencieusement dans une forme historique liée au TLM ; utilisez la version actuelle séparée lorsque vous souhaitez les Litanies contemporaines.',links:[]},
 litany_loreto_current:{en:'This separate version includes later approved invocations. It is presented as current devotional usage rather than as though those titles had been present in the 1962-era text.',fr:'Cette version séparée comprend les invocations approuvées ultérieurement. Elle est présentée comme usage dévotionnel actuel, et non comme si ces titres avaient figuré dans le texte de l’époque de 1962.',links:[]},
 benediction_o_salutaris:{en:'A traditional Eucharistic hymn by St Thomas Aquinas and a very common choice during exposition. It is customary, not the only text permitted for exposition.',fr:'Hymne eucharistique traditionnel de saint Thomas d’Aquin et choix très courant pendant l’exposition. Il relève de l’usage et n’est pas le seul texte possible pour l’exposition.',links:[[AO_LINKS.benediction,'Holy See guidance']]},
 benediction_tantum_ergo:{en:'Tantum Ergo belongs to the classic Roman Benediction sequence immediately before the versicle Panem de caelo, the collect Deus qui nobis and the blessing.',fr:'Le Tantum Ergo appartient à la séquence romaine classique de la bénédiction, immédiatement avant le verset Panem de caelo, l’oraison Deus qui nobis et la bénédiction.',links:[[AO_LINKS.benediction,'Holy See guidance']]},
 benediction_divine_praises:{en:'The Divine Praises are widely recited in connection with Benediction, especially after the blessing, but they are a later devotional accretion rather than the core of the older Roman rite itself.',fr:'Les Louanges divines sont très largement récitées en lien avec la bénédiction, notamment après la bénédiction elle-même, mais elles constituent un ajout dévotionnel plus tardif plutôt que le noyau de l’ancien rite romain.',links:[]},
 dead_de_profundis:{en:'De profundis is Psalm 129 in the Vulgate/older Roman numbering and Psalm 130 in most modern Hebrew-based numbering. It has long been associated with prayer for the faithful departed.',fr:'De profundis est le psaume 129 dans la numérotation de la Vulgate et de l’ancien usage romain, et le psaume 130 dans la plupart des numérotations modernes fondées sur l’hébreu. Il est depuis longtemps associé à la prière pour les fidèles défunts.',links:[]}
};
const _aoRenderPrayer=renderPrayer;
renderPrayer=function(){
 const p=D.prayers[S.prayer];if(!p)return go('hub');const f=AO_PRAYER_FORMATION[p.id];
 const form=f?aoFormation('Traditional practice / status','Pratique traditionnelle / statut',`<p>${esc(lang()==='fr'?f.fr:f.en)}</p>${f.links?.length?`<div class="pbSourceRow">${f.links.map(x=>`<a href="${esc(x[0])}" target="_blank" rel="noopener">${esc(x[1])} ↗</a>`).join('')}</div>`:''}`):'';
 return `<div class="pbShell"><div class="pbReader">${top(prayerTitle(p))}<div class="pbMeta"><span class="pbTag">${p.la?'LAT → '+lang().toUpperCase():lang().toUpperCase()}</span><span class="pbTag">${esc(D.categories[p.category]?.[lang()]||'')}</span></div>${flipText(p.la,p[lang()]||p.en)}${form}${source(p)}</div></div>`;
};

const _aoBindTrad=bind;
bind=function(){
 _aoBindTrad();
 const fat=root.querySelector('[data-pb-fatima]');if(fat)fat.onchange=e=>{S.rosaryFatima=e.target.checked;render()};
 const st=root.querySelector('[data-pb-stabat]');if(st)st.onchange=e=>{S.stationStabat=e.target.checked;render()};
};


const _aoBindBenFix=bind;
bind=function(){_aoBindBenFix();const prev=root.querySelector('[data-pb-ben-prev]'),next=root.querySelector('[data-pb-ben-next]');if(prev)prev.onclick=()=>{S.benedictionStep=Math.max(0,S.benedictionStep-1);render()};if(next)next.onclick=()=>{if(S.benedictionStep>=6){S.benedictionStep=0;return go('hub')}S.benedictionStep++;render()};};

window.AOTraditionalPrayerBook={open,close,back,openModule,openPrayer,openExisting:launchExisting,getState:()=>({...S,externalReturn})};


/* ===== Direct Lab-ora UI/UX port ===== */
function labHead(title,eyebrow=t('Traditional prayer book','Livre de prières traditionnel')){
 return `<header class="lab-view-head"><button class="lab-back" data-pb-back aria-label="${t('Back','Retour')}">←</button><div><p class="eyebrow">${esc(eyebrow)}</p><h1>${esc(title)}</h1></div><button type="button" class="aoModuleHome" data-app-home aria-label="${t('Return to Home','Retour à l’accueil')}">⌂</button><span class="lab-lang">${lang().toUpperCase()}</span></header>`;
}
function labFlip(la,vern,id='lab-flip'){
 if(!la)return `<div class="lab-prayer-flip" style="cursor:default">${esc(vern||'')}</div>`;
 return `<button class="lab-prayer-flip" data-pb-flip="${esc(id)}" data-face="latin"><span data-pb-latin>${esc(la)}</span><span data-pb-vern hidden>${esc(vern||'')}</span></button><div class="lab-flip-hint" data-pb-flip-hint>${t('Tap the text · show English','Touchez le texte · afficher le français')}</div>`;
}
function labSource(p){return `<div class="lab-source-note"><strong>${t('Source / provenance','Source / provenance')}</strong><br>${esc(p?.source||'')}${p?.note?`<br>${esc(p.note)}`:''}${p?.sourceUrl?`<br><a href="${esc(p.sourceUrl)}" target="_blank" rel="noopener">${t('Open source','Ouvrir la source')} ↗</a>`:''}</div>`}
function labPrayerBundle(keys,prefix='bundle'){const l=lang(),rp=D.rosaryPrayers;return keys.map((k,i)=>{const la=rp.la?.[k]?.[1]||'',v=rp[l]?.[k]?.[1]||'',label=rp[l]?.[k]?.[0]||k;return `<div style="margin:16px 0"><p class="eyebrow" style="color:var(--liturgical);margin-bottom:7px">${esc(label)}</p>${labFlip(la,v,prefix+'-'+k+'-'+i)}</div>`}).join('')}

const PB_SEARCH_ALIAS_GROUPS=[
 ['hail holy queen','salve regina','salut o reine','salut reine','holy queen'],
 ['sacred heart','sacre coeur','sacre coeur de jesus','cor iesu','cor jesu','most sacred heart'],
 ['holy ghost','holy spirit','saint esprit','esprit saint','veni sancte spiritus','come holy spirit'],
 ['stations','stations of the cross','way of the cross','chemin de croix','via crucis'],
 ['rosary','holy rosary','saint rosaire','rosaire'],
 ['angelus','regina caeli','regina coeli','angelus regina caeli'],
 ['benediction','benediction of the blessed sacrament','benediction du saint sacrement','tantum ergo'],
 ['adoration','eucharistic adoration','adoration eucharistique','blessed sacrament','saint sacrement'],
 ['first friday','premier vendredi','nine first fridays','neuf premiers vendredis'],
 ['first saturday','premier samedi','five first saturdays','cinq premiers samedis','immaculate heart','coeur immacule'],
 ['de profundis','psalm 129','psaume 129'],
 ['prayer for the pope','pope','pontiff','pape','pontife']
];
const PB_PRAYER_EXTRA_ALIASES={
 marian_hail_holy_queen:['hail holy queen','salve regina','salut o reine'],
 sacred_heart_short_prayer:['sacred heart','sacre coeur','cor iesu','cor jesu'],
 sacred_heart_aspiration_trust:['sacred heart','sacre coeur','cor iesu','cor jesu'],
 sacrament_come_holy_spirit:['come holy spirit','holy ghost','saint esprit','veni sancte spiritus'],
 traditional_veni_sancte_sequence:['veni sancte spiritus','holy spirit','holy ghost','saint esprit'],
 dead_de_profundis:['de profundis','psalm 129','psaume 129'],
 church_prayer_for_pope:['prayer for the pope','pope','pape','pontiff','pontife'],
 litany_loreto_1962:['litany of loreto','litanies de lorette','loreto'],
 litany_loreto_current:['litany of loreto','litanies de lorette','loreto']
};
const PB_SEARCH_MODULES=[
 {id:'confession',attr:'data-pb-module="confession"',title:['Confession','Confession'],desc:['Examination, contrition and sacramental preparation.','Examen, contrition et préparation au sacrement.'],aliases:['penance','reconciliation','confessional','penitence']},
 {id:'rosary',attr:'data-pb-module="rosary"',title:['Holy Rosary','Saint Rosaire'],desc:['Traditional mysteries, Scripture cues and guided decades.','Mystères traditionnels, repères bibliques et dizaines guidées.'],aliases:['rosary','rosaire','holy rosary']},
 {id:'angelus',attr:'data-pb-module="angelus"',title:['Angelus / Regina Cæli','Angélus / Regina Cæli'],desc:['Season-aware traditional Marian prayer.','Prière mariale traditionnelle selon le temps liturgique.'],aliases:['angelus','regina caeli','regina coeli']},
 {id:'stations',attr:'data-pb-module="stations"',title:['Stations of the Cross','Chemin de Croix'],desc:['St Alphonsus · traditional XIV Stations.','Saint Alphonse · XIV Stations traditionnelles.'],aliases:['stations','way of the cross','chemin de croix','via crucis']},
 {id:'benediction',attr:'data-pb-module="benediction"',title:['Benediction','Bénédiction'],desc:['O Salutaris, Tantum Ergo and the Divine Praises.','O Salutaris, Tantum Ergo et les Louanges divines.'],aliases:['benediction','blessed sacrament','tantum ergo','o salutaris']},
 {id:'prepare',attr:'data-pb-existing="prepare"',title:['Before Mass','Avant la Messe'],desc:['Sourced preparation for Mass and Holy Communion.','Préparation sourcée à la Messe et à la sainte Communion.'],aliases:['before mass','mass preparation','preparation for mass','avant la messe','preparation a la messe']},
 {id:'thanks',attr:'data-pb-existing="thanks"',title:['After Mass','Après la Messe'],desc:['Thanksgiving after Mass and Holy Communion.','Action de grâces après la Messe et la sainte Communion.'],aliases:['after mass','thanksgiving','action de graces','thanksgiving after communion']},
 {id:'adoration',attr:'data-ao354-launch="adoration"',title:['Adoration','Adoration'],desc:['Guided Eucharistic visits before the Blessed Sacrament.','Visites eucharistiques guidées devant le Saint-Sacrement.'],aliases:['adoration','eucharistic adoration','blessed sacrament','saint sacrement']},
 {id:'first-friday',attr:'data-ao354-launch="first-friday"',title:['First Friday','Premier vendredi'],desc:['Sacred Heart · Nine First Fridays.','Sacré-Cœur · neuf premiers vendredis.'],aliases:['first friday','premier vendredi','sacred heart','sacre coeur','nine first fridays']},
 {id:'first-saturday',attr:'data-ao354-launch="first-saturday"',title:['First Saturday','Premier samedi'],desc:['Immaculate Heart · Five First Saturdays.','Cœur Immaculé · cinq premiers samedis.'],aliases:['first saturday','premier samedi','immaculate heart','coeur immacule','five first saturdays']}
];
function pbSearchNorm(v){
 return String(v??'').toLowerCase()
  .replace(/œ/g,'oe').replace(/æ/g,'ae')
  .normalize('NFD').replace(/[\u0300-\u036f]/g,'')
  .replace(/[’'`´]/g,' ')
  .replace(/[^a-z0-9]+/g,' ')
  .trim().replace(/\s+/g,' ');
}
function pbSearchTerms(q){
 const n=pbSearchNorm(q);if(!n)return[];
 const out=new Set([n]);
 for(const group of PB_SEARCH_ALIAS_GROUPS){
  const norm=group.map(pbSearchNorm);
  if(norm.some(a=>a===n||a.includes(n)||n.includes(a)))norm.forEach(a=>out.add(a));
 }
 return [...out].filter(Boolean);
}
function pbFieldScore(value,terms,exact=120,prefix=108,contains=94){
 const v=pbSearchNorm(value);if(!v)return 0;let best=0;
 for(const q of terms){
  if(v===q)best=Math.max(best,exact);
  else if(v.startsWith(q))best=Math.max(best,prefix);
  else if(v.includes(q))best=Math.max(best,contains);
  else {const toks=q.split(' ').filter(Boolean);if(toks.length>1&&toks.every(x=>v.includes(x)))best=Math.max(best,contains-8)}
 }
 return best;
}
function pbPrayerScore(p,q){
 const terms=pbSearchTerms(q);if(!terms.length)return 1;
 const cat=D.categories[p.category]||{};
 let score=0;
 score=Math.max(score,pbFieldScore(p.title,terms,130,118,106),pbFieldScore(p.titleFr,terms,130,118,106));
 score=Math.max(score,pbFieldScore((PB_PRAYER_EXTRA_ALIASES[p.id]||[]).join(' '),terms,124,112,100));
 score=Math.max(score,pbFieldScore([p.category,cat.en,cat.fr].join(' '),terms,88,82,76));
 score=Math.max(score,pbFieldScore(p.la,terms,58,55,52),pbFieldScore(p.en,terms,56,53,50),pbFieldScore(p.fr,terms,56,53,50));
 return score;
}
function pbModuleScore(m,q){
 const terms=pbSearchTerms(q);if(!terms.length)return 1;
 let score=Math.max(pbFieldScore(m.title[0],terms,132,120,108),pbFieldScore(m.title[1],terms,132,120,108));
 score=Math.max(score,pbFieldScore((m.aliases||[]).join(' '),terms,126,114,102));
 score=Math.max(score,pbFieldScore(m.desc.join(' '),terms,68,62,58));
 return score;
}
function pbSearchPrayers(q){
 if(!pbSearchNorm(q))return Object.values(D.prayers).map(p=>({p,score:1}));
 return Object.values(D.prayers).map(p=>({p,score:pbPrayerScore(p,q)})).filter(x=>x.score>0).sort((a,b)=>b.score-a.score||prayerTitle(a.p).localeCompare(prayerTitle(b.p)));
}
function pbSearchModules(q){
 if(!pbSearchNorm(q))return PB_SEARCH_MODULES.slice();
 return PB_SEARCH_MODULES.map(m=>({...m,score:pbModuleScore(m,q)})).filter(x=>x.score>0).sort((a,b)=>b.score-a.score||(lang()==='fr'?a.title[1]:a.title[0]).localeCompare(lang()==='fr'?b.title[1]:b.title[0]));
}
window.AO_PRAYER_SEARCH_V372={version:'37.2',normalize:pbSearchNorm,terms:pbSearchTerms,searchPrayers:pbSearchPrayers,searchModules:pbSearchModules};

renderHub=function(){
 const q=S.query.trim(),searching=!!pbSearchNorm(q);
 const moduleCards=`<div class="lab-library-grid">
  <button class="featured" data-pb-module="confession"><strong>${t('Confession','Confession')}</strong><span>${t('Prepare · confess · receive mercy · amend','Préparer · confesser · recevoir la miséricorde · s’amender')}</span></button>
  <button class="featured" data-pb-module="rosary"><strong>${t('Holy Rosary','Saint Rosaire')}</strong><span>${t('Bead-by-bead · Scripture · traditional commentary','Perle par perle · Écriture · commentaire traditionnel')}</span></button>
  <button data-pb-module="angelus"><strong>${t('Angelus / Regina Cæli','Angélus / Regina Cæli')}</strong><span>${t('Season-aware · traditional conclusion','Selon le temps · conclusion traditionnelle')}</span></button>
  <button data-pb-module="stations"><strong>${t('Stations of the Cross','Chemin de Croix')}</strong><span>${t('St Alphonsus · traditional XIV Stations','Saint Alphonse · XIV Stations traditionnelles')}</span></button>
  <button data-pb-module="benediction"><strong>${t('Benediction','Bénédiction')}</strong><span>O Salutaris · Tantum Ergo · ${t('Divine Praises','Louanges divines')}</span></button>
  <button data-pb-existing="prepare"><strong>${t('Before Mass','Avant la Messe')}</strong><span>${t('Sourced preparation for Mass','Préparation sourcée à la Messe')}</span></button>
  <button data-pb-existing="thanks"><strong>${t('After Mass','Après la Messe')}</strong><span>${t('Thanksgiving after Mass','Action de grâces après la Messe')}</span></button>
 </div>`;
 const allCats=Object.entries(D.categories).map(([id,n])=>{
   const ps=Object.values(D.prayers).filter(p=>p.category===id);
   if(!ps.length)return'';
   return `<section class="lab-library-section"><div class="lab-library-head"><div><p class="eyebrow">${t('Prayer treasury','Trésor de prières')}</p><h2>${esc(n[lang()]||n.en)}</h2></div><span>${ps.length}</span></div><div class="lab-library-grid">${ps.map(p=>`<button data-pb-prayer="${esc(p.id)}"><strong>${esc(prayerTitle(p))}</strong><span>${p.la?t('Latin first · tap for vernacular','Latin d’abord · toucher pour le vernaculaire'):t('Vernacular text','Texte vernaculaire')}</span></button>`).join('')}</div></section>`;
 }).join('');
 const modules=searching?pbSearchModules(q):[];
 const prayers=searching?pbSearchPrayers(q):[];
 const searchResults=searching?`<section class="lab-library-section pbSearchResults"><div class="lab-library-head"><div><p class="eyebrow">${t('Search results','Résultats de recherche')}</p><h2>${esc(q)}</h2></div><span>${modules.length+prayers.length}</span></div>
 ${modules.length?`<div class="pbSearchResultGroup"><h3>${t('Practices & modules','Pratiques et modules')}</h3><div class="lab-library-grid">${modules.map(m=>`<button class="pbSearchModule" ${m.attr}><span class="pbSearchType">${t('Practice','Pratique')}</span><strong>${esc(lang()==='fr'?m.title[1]:m.title[0])}</strong><span>${esc(lang()==='fr'?m.desc[1]:m.desc[0])}</span></button>`).join('')}</div></div>`:''}
 ${prayers.length?`<div class="pbSearchResultGroup"><h3>${t('Prayers','Prières')}</h3><div class="lab-library-grid">${prayers.map(({p})=>{const c=D.categories[p.category]||{};return `<button data-pb-prayer="${esc(p.id)}"><span class="pbSearchType">${esc(c[lang()]||c.en||t('Prayer','Prière'))}</span><strong>${esc(prayerTitle(p))}</strong><span>${p.la?t('Latin · English · French indexed','Latin · anglais · français indexés'):t('English · French indexed','Anglais · français indexés')}</span></button>`}).join('')}</div></div>`:''}
 ${!modules.length&&!prayers.length?`<div class="pbNoResults">${t('No matching prayer or practice.','Aucune prière ni pratique correspondante.')}</div>`:''}</section>`:'';
 return `<div class="pbShell"><div class="lab-library-root">${labHead(t('Prayers','Prières'),t('Traditional Catholic prayer','Prière catholique traditionnelle'))}<section class="lab-library-section"><div class="lab-library-head"><div><p class="eyebrow">${t('Practices','Pratiques')}</p><h2>${t('Learn · prepare · pray','Apprendre · préparer · prier')}</h2></div></div>${searching?'':moduleCards}</section><section class="lab-library-section"><div class="lab-library-head"><div><p class="eyebrow">${t('Library','Bibliothèque')}</p><h2>${t('All prayers','Toutes les prières')}</h2></div></div><input class="lab-search" data-pb-search value="${esc(S.query)}" placeholder="${t('Search Latin, English or French…','Rechercher en latin, anglais ou français…')}" aria-label="${t('Search prayers and practices','Rechercher prières et pratiques')}"><p class="lab-source-note">${searching?t('Accent-insensitive multilingual search · titles and aliases rank before prayer text.','Recherche multilingue sans distinction d’accents · titres et alias classés avant le texte des prières.'):t('Latin remains primary outside Mass; tap a Latin prayer and the current EN/FR vernacular replaces it in the same place.','Le latin demeure principal hors de la Messe ; touchez une prière latine et le vernaculaire EN/FR courant la remplace au même endroit.')}</p></section>${searching?searchResults:allCats}</div></div>`;
};

renderPrayer=function(){
 const p=D.prayers[S.prayer];if(!p)return go('hub');
 return `<div class="pbShell">${labHead(prayerTitle(p),D.categories[p.category]?.[lang()]||t('Prayer','Prière'))}<article class="lab-prayer-sheet"><div class="lab-reader-meta"><span>${p.la?'LAT → '+lang().toUpperCase():lang().toUpperCase()}</span><span>${esc(D.categories[p.category]?.[lang()]||'')}</span></div>${labFlip(p.la,p[lang()]||p.en,'library-'+p.id)}${labSource(p)}</article></div>`;
};

function labRosarySetLabel(set){return {joyful:t('Joyful Mysteries','Mystères joyeux'),sorrowful:t('Sorrowful Mysteries','Mystères douloureux'),glorious:t('Glorious Mysteries','Mystères glorieux'),luminous:t('Luminous Mysteries','Mystères lumineux')}[set]||set}
function labRosaryIds(set){const pre={joyful:'joy',sorrowful:'sor',glorious:'glo',luminous:'lum'}[set];return Array.from({length:5},(_,i)=>pre+(i+1))}
const AO_DEVOTIONAL_ROSARY_V38=Object.freeze({
 opening:{
  en:'℣. Lord, open our lips.\n℟. And we shall praise your name.\n\n℣. O God, come to our aid.\n℟. O Lord, make haste to help us.',
  la:'℣. Domine, labia mea aperies.\n℟. Et os meum annuntiabit laudem tuam.\n\n℣. Deus, in adiutorium meum intende.\n℟. Domine, ad adiuvandum me festina.',
  fr:'℣. Seigneur, ouvrez mes lèvres.\n℟. Et ma bouche publiera votre louange.\n\n℣. Ô Dieu, venez à mon aide.\n℟. Seigneur, hâtez-vous de me secourir.'
 },
 intentions:{
  church:{title:{en:'For the Church and State',fr:'Pour l’Église et l’État'},lead:{en:'Let us pray for the needs of the Church and the State.',la:'Oremus pro necessitatibus Ecclesiæ et Reipublicæ.',fr:'Prions pour les besoins de l’Église et de l’État.'},prayers:['pater','ave','gloria']},
  bishop:{title:{en:'For the Bishop',fr:'Pour l’Évêque'},lead:{en:'Let us pray for the Bishop of this diocese and his intentions.',la:'Oremus pro Episcopo huius diœcesis eiusque intentionibus.',fr:'Prions pour l’Évêque de ce diocèse et à ses intentions.'},prayers:['pater','ave','gloria']},
  souls:{title:{en:'For the Holy Souls',fr:'Pour les âmes du purgatoire'},lead:{en:'Let us pray for the holy souls in purgatory.',la:'Oremus pro animabus in purgatorio.',fr:'Prions pour les saintes âmes du purgatoire.'},prayers:['pater','ave'],closing:{en:'℣. May they rest in peace.\n℟. Amen.',la:'℣. Requiescant in pace.\n℟. Amen.',fr:'℣. Qu’ils reposent en paix.\n℟. Ainsi soit-il.'}}
 }
});
function labRosarySteps(set){
 const ids=labRosaryIds(set),steps=[];
 const prayer=(key,phase,extra={})=>steps.push({kind:'prayer',key,phase,...extra});
 if(S.rosaryForm==='devotional'){
  prayer('sign','opening');steps.push({kind:'devotional-opening',phase:'opening'});prayer('gloria','opening');
 }else{
  prayer('sign','opening');prayer('credo','opening');prayer('pater','opening');
  for(let n=1;n<=3;n++)prayer('ave','opening',{openingAve:n});prayer('gloria','opening');
 }
 ids.forEach((id,mi)=>{
   const info=AO_ROSARY_DEPTH[id];steps.push({kind:'mystery',id,mi,phase:'decade'});
   prayer('pater','decade',{id,mi});
   for(let bead=1;bead<=10;bead++)prayer('ave','decade',{id,mi,bead,cue:info?.cues?.[bead-1]||null});
   prayer('gloria','decade',{id,mi});if(S.rosaryFatima!==false)prayer('fatima','decade',{id,mi});
 });
 if(S.rosaryForm==='devotional'){
   steps.push({kind:'devotional-salve',phase:'conclusion'});
   steps.push({kind:'devotional-prayer',prayerId:'sub_tuum',phase:'conclusion'});
   steps.push({kind:'devotional-prayer',prayerId:'litany_loreto_1962',phase:'conclusion'});
   steps.push({kind:'devotional-collect',phase:'conclusion'});
   steps.push({kind:'devotional-intention',target:'church',phase:'conclusion'});
   steps.push({kind:'devotional-intention',target:'bishop',phase:'conclusion'});
   steps.push({kind:'devotional-intention',target:'souls',phase:'conclusion'});
   prayer('sign','conclusion',{finalCross:true});
 }else{
   steps.push({kind:'conclusion',phase:'conclusion'});
   prayer('sign','conclusion',{finalCross:true});
 }
 return steps;
}
function labRosaryDevotionalStep(step,idx){
 const l=lang(),rp=D.rosaryPrayers;
 if(step.kind==='devotional-opening')return `<article class="lab-prayer-sheet"><p class="rubric">${t('Devotional opening','Ouverture dévotionnelle')}</p><h2>${t('Opening versicles','Versets d’ouverture')}</h2>${labFlip(AO_DEVOTIONAL_ROSARY_V38.opening.la,AO_DEVOTIONAL_ROSARY_V38.opening[l]||AO_DEVOTIONAL_ROSARY_V38.opening.en,'rosary-dev-open')}</article>`;
 if(step.kind==='devotional-salve')return `<article class="lab-prayer-sheet"><p class="rubric">${t('Devotional conclusion','Conclusion dévotionnelle')}</p><h2>Salve Regina</h2>${labFlip(D.salve.la,D.salve[l]||D.salve.en,'rosary-salve')}</article>`;
 if(step.kind==='devotional-collect')return `<article class="lab-prayer-sheet"><p class="rubric">${t('Rosary collect','Oraison du Rosaire')}</p><h2>${t('Let us pray','Prions')}</h2>${labFlip(D.rosaryCollect.la,D.rosaryCollect[l]||D.rosaryCollect.en,'rosary-collect')}</article>`;
 if(step.kind==='devotional-prayer'){
   const p=D.prayers?.[step.prayerId];if(!p)return'';return `<article class="lab-prayer-sheet"><p class="rubric">${t('Devotional conclusion','Conclusion dévotionnelle')}</p><h2>${esc(l==='fr'?(p.titleFr||p.title):p.title)}</h2>${labFlip(p.la,p[l]||p.en,'rosary-extra-'+idx)}</article>`;
 }
 if(step.kind==='devotional-intention'){
   const x=AO_DEVOTIONAL_ROSARY_V38.intentions[step.target],parts=x.prayers.map(k=>{const pair=rp[l]?.[k]||rp.en[k],lap=rp.la[k];return `<div class="v38RosaryIntentionPrayer"><strong>${esc(pair?.[0]||k)}</strong>${labFlip(lap?.[1]||'',pair?.[1]||'','rosary-int-'+step.target+'-'+k)}</div>`}).join('');
   const close=x.closing?`<div class="v38RosaryIntentionClose">${esc(x.closing[l]||x.closing.en)}</div>`:'';
   return `<article class="lab-prayer-sheet"><p class="rubric">${t('Concluding intentions','Intentions finales')}</p><h2>${esc(x.title[l]||x.title.en)}</h2><p class="v38IntentLead">${esc(x.lead[l]||x.lead.en)}</p>${parts}${close}</article>`;
 }
 return'';
}
function labRosaryDecadeBar(step){return `<div class="lab-decade-bar" aria-hidden="true">${Array.from({length:5},(_,i)=>`<i class="${step?.mi>i?'done':step?.mi===i?'current':''}"></i>`).join('')}</div>`}
function labRosaryBeads(step){
 if(step?.phase==='opening')return `<div class="lab-bead-stage">${Array.from({length:7},(_,i)=>`<i class="lab-bead ${i<S.rosaryStep?'past':i===S.rosaryStep?'current':''}"></i>`).join('')}</div>`;
 if(step?.mi===undefined)return '';
 const active=step.bead||0;
 return `<div class="lab-bead-stage" aria-label="${t('Decade beads','Perles de la dizaine')}">${Array.from({length:10},(_,i)=>`<i class="lab-bead ${active>i+1?'past':active===i+1?'current':''}"></i>`).join('')}</div>`;
}
function labRosaryPrayer(step,idx,total){
 const rp=D.rosaryPrayers,l=lang(),pair=rp[l][step.key],lapair=rp.la[step.key],title=pair?.[0]||step.key,text=pair?.[1]||'',la=lapair?.[1]||'';
 const cue=step.cue?`<div class="lab-scripture-cue"><strong>${esc(step.cue.reference||t('Scripture','Écriture'))}</strong>${esc(step.cue.excerpt||'')}</div>`:'';
 const count=step.key==='ave'&&step.bead?`<div class="lab-prayer-count">${t('Hail Mary','Ave Maria')} <strong>${step.bead}</strong> / 10</div>`:'';
 return `<article class="lab-prayer-sheet"><p class="rubric">${step.phase==='opening'?t('Opening prayers','Prières d’ouverture'):labRosarySetLabel(S.rosarySet)}</p><h2>${esc(title)}</h2>${count}${cue}${labFlip(la,text,'rosary-'+step.key+'-'+idx)}</article>`;
}
function labRosaryContemplation(step){
 const info=AO_ROSARY_DEPTH[step.id],l=lang(),names=rosaryNames()[S.rosarySet],name=names[step.mi],desc=l==='fr'?(info?.description_fr||info?.description):(info?.description||''),fruit=l==='fr'?(info?.fruit_fr||info?.fruit):(info?.fruit||''),comm=l==='fr'?(info?.commentary_fr||info?.commentary_en):(info?.commentary_en||'');
 return `<article class="lab-contemplation"><div class="kicker">${t('Mystery','Mystère')} ${step.mi+1} / 5</div><h2>${esc(name)}</h2><div class="principal"><strong>${esc(info?.primary_passage||'')}</strong><br>${esc(desc)}</div><div class="fruit">${t('Fruit / grace','Fruit / grâce')}: ${esc(fruit)}</div><p class="commentary">${esc(comm)}</p><div class="lab-source-row">${info?.source_url?`<a href="${esc(info.source_url)}" target="_blank" rel="noopener">${esc(info.source_label||t('Source','Source'))} ↗</a>`:''}${info?.traditional_commentary_url?`<a href="${esc(info.traditional_commentary_url)}" target="_blank" rel="noopener">${esc(info.traditional_commentary_label||t('Traditional commentary','Commentaire traditionnel'))} ↗</a>`:''}</div></article>`;
}
renderRosary=function(){
 if(!S.rosarySet){
   const sug=suggestedMystery(),names=rosaryNames();
   return `<div class="pbShell">${labHead(t('Pray the Rosary today','Prier le Rosaire aujourd’hui'),t('The Holy Rosary','Le Saint Rosaire'))}<section class="lab-rosary-hero"><small>${t('Suggested today','Suggérés aujourd’hui')}</small><strong>${labRosarySetLabel(sug)}</strong><p>${t('Choose the standard opening or the fuller Devotional Rosary. Both use the same mysteries and decades.','Choisissez l’ouverture standard ou le Rosaire dévotionnel plus développé. Les deux utilisent les mêmes mystères et dizaines.')}</p><button data-lab-rosary-today="${sug}">${t('Pray today’s mysteries','Prier les mystères du jour')}</button></section><div class="v38RosaryForm"><button type="button" class="${S.rosaryForm==='standard'?'active':''}" data-v38-rosary-form="standard"><strong>${t('Standard','Standard')}</strong><span>${t('Creed · introductory beads · five decades','Credo · grains d’introduction · cinq dizaines')}</span></button><button type="button" class="${S.rosaryForm==='devotional'?'active':''}" data-v38-rosary-form="devotional"><strong>${t('Devotional Rosary','Rosaire dévotionnel')}</strong><span>${t('Versicles · five decades · Salve · Sub tuum · Loreto · intentions','Versets · cinq dizaines · Salve · Sub tuum · Lorette · intentions')}</span></button></div><div class="lab-option-bar"><label><input type="checkbox" data-pb-fatima ${S.rosaryFatima!==false?'checked':''}> ${t('Fatima prayer','Prière de Fatima')}</label><span class="lab-step-count">${t('Latin prayer text flips to the current vernacular on tap.','Le texte latin passe au vernaculaire courant au toucher.')}</span></div><div class="lab-mystery-grid">${['joyful','sorrowful','glorious','luminous'].map(set=>`<button class="lab-mystery-card ${set===sug?'recommended':''}" data-pb-rosary-set="${set}"><small>${set===sug?t('Suggested today','Suggérés aujourd’hui'):set==='luminous'?t('Optional · 2002','Facultatifs · 2002'):t('Traditional cycle','Cycle traditionnel')}</small><strong>${labRosarySetLabel(set)}</strong><ol>${names[set].map(x=>`<li>${esc(x)}</li>`).join('')}</ol></button>`).join('')}</div>${aoRosaryPracticeIntro()}</div>`;
 }
 const steps=labRosarySteps(S.rosarySet);if(S.rosaryStep>=steps.length)S.rosaryStep=steps.length-1;if(S.rosaryStep<0)S.rosaryStep=0;const idx=S.rosaryStep,step=steps[idx];
 const content=step.kind==='mystery'?labRosaryContemplation(step):step.kind==='conclusion'?`<article class="lab-prayer-sheet"><p class="rubric">${t('Conclusion','Conclusion')}</p><h2>${t('Conclude the Rosary','Concluez le Rosaire')}</h2><div style="margin-bottom:22px">${labFlip(D.salve.la,D.salve[lang()],'rosary-salve')}</div><div>${labFlip(D.rosaryCollect.la,D.rosaryCollect[lang()],'rosary-collect')}</div><p class="lab-practice-note">${t('The Litany of Loreto may be added as a further Marian devotion.','Les Litanies de Lorette peuvent être ajoutées comme dévotion mariale supplémentaire.')}</p></article>`:step.kind.startsWith('devotional-')?labRosaryDevotionalStep(step,idx):labRosaryPrayer(step,idx,steps.length);
 return `<div class="pbShell"><section class="aoRosaryRitualGrid" data-ao-rosary-step="${idx}" data-ao-rosary-kind="${esc(step.kind||'')}" data-ao-rosary-key="${esc(step.key||'')}" data-ao-rosary-phase="${esc(step.phase||'')}" data-ao-rosary-bead="${Number(step.bead||0)}" data-ao-rosary-cue="${step.cue?'true':'false'}" data-ao-rosary-final-cross="${step.finalCross?'true':'false'}"><aside class="aoRitualRail aoRosaryFaithfulRail" data-ao-ritual-rail data-ao-ritual-module="rosary" data-ao-ritual-channels="posture,gesture,action" aria-label="${esc(t('Rosary posture, gesture and contemplation','Posture, geste et contemplation du Rosaire'))}"></aside><div class="aoRosaryRitualCenter">${labHead(step.kind==='mystery'?rosaryNames()[S.rosarySet][step.mi]:labRosarySetLabel(S.rosarySet),S.rosaryForm==='devotional'?t('Devotional Rosary','Rosaire dévotionnel'):t('The Holy Rosary','Le Saint Rosaire'))}${labRosaryDecadeBar(step)}${labRosaryBeads(step)}${content}<div class="lab-player-controls"><button data-lab-rosary-prev ${idx===0?'disabled':''}>← ${t('Previous','Précédent')}</button><button class="primary" data-lab-rosary-next>${idx===steps.length-1?t('Finish','Terminer'):t('Next','Suivant')} →</button></div><button class="lab-change" data-lab-rosary-change>${t('Change mysteries','Changer de mystères')}</button></div></section></div>`;
};

renderConfession=function(){
 const l=lang(),exam=l==='fr'?D.examFr:D.exam;
 const steps=l==='fr'?[['Réception','Suivez le prêtre et faites le signe de la Croix selon l’usage.'],['Commencez simplement','Benedic mihi, Pater, quia peccavi — une formule traditionnelle d’ouverture, non une condition de validité.'],['Confessez vos péchés','Confessez les péchés mortels dont vous vous souvenez selon leur espèce et leur nombre approximatif, puis les autres péchés que vous désirez accuser.'],['Conseil et pénitence','Écoutez le conseil du prêtre et acceptez la pénitence.'],['Acte du pénitent','Exprimez votre contrition lorsque le prêtre vous y invite.'],['Absolution','Le prêtre seul donne l’absolution sacramentelle. Écoutez et répondez Amen.'],['Renvoi','Recevez le sacrement comme achevé.'],['Après','Remerciez Dieu, accomplissez rapidement la pénitence et réparez le tort lorsque la justice l’exige.']]:[['Reception','Follow the priest and make the Sign of the Cross as customary.'],['Begin simply','Benedic mihi, Pater, quia peccavi — a traditional opening formula, not a condition for validity.'],['Confess your sins','Confess remembered mortal sins by kind and approximate number, then other sins you wish to bring.'],['Counsel and penance','Listen to the priest’s counsel and accept the penance.'],['Prayer of the penitent','Express contrition when the priest invites you.'],['Absolution','The priest alone gives sacramental absolution. Listen and answer Amen.'],['Dismissal','Receive the sacrament as complete.'],['Afterwards','Thank God, perform the penance promptly, and make restitution where justice requires it.']];
 const st=steps[S.confStep],act=D.prayers.sacrament_act_of_contrition;
 return `<div class="pbShell">${labHead(t('Confession','Confession'),t('Learn · prepare · pray','Apprendre · préparer · prier'))}<p class="lab-practice-lead">${t('Formation first: examine, confess, receive absolution, give thanks and amend. The app never simulates the priest or the sacrament.','Formation d’abord : examen, confession, absolution, action de grâces et amendement. L’application ne simule jamais le prêtre ni le sacrement.')}</p><div class="lab-practice-grid"><button class="primary-practice"><strong>${t('Prepare well','Bien se préparer')}</strong><span>${t('Examination · contrition · purpose of amendment','Examen · contrition · ferme propos')}</span></button><button><strong>${t('Traditional manner','Manière traditionnelle')}</strong><span>Benedic mihi, Pater, quia peccavi</span></button></div><article class="lab-practice-sheet"><span class="lab-practice-status official">${t('Current sacramental discipline','Discipline sacramentelle actuelle')}</span><span class="lab-practice-status custom">${t('Traditional manner','Usage traditionnel')}</span><details ${S.confStep===0?'open':''}><summary>${t('Examination of conscience','Examen de conscience')}</summary><p>${esc(exam.intro)}</p>${exam.sections.map(s=>`<details><summary>${esc(s[0])}</summary><ul>${s[1].map(q=>`<li>${esc(q)}</li>`).join('')}</ul></details>`).join('')}</details><div class="lab-progress"><i style="width:${((S.confStep+1)/steps.length*100).toFixed(1)}%"></i></div><p class="eyebrow" style="color:#806626">${S.confStep+1} / ${steps.length}</p><h2>${esc(st[0])}</h2><p>${esc(st[1])}</p>${S.confStep===4?`<div class="lab-practice-note" style="background:#e7ebed;color:#334d60"><strong>${t('Act of Contrition','Acte de contrition')}</strong></div>${labFlip(act.la,act[l]||act.en,'confession-act')}`:''}<div class="lab-actions"><button data-pb-conf-prev ${S.confStep===0?'disabled':''}>← ${t('Previous','Précédent')}</button><button class="accent" data-pb-conf-next>${S.confStep===steps.length-1?t('Finish','Terminer'):t('Next','Suivant')} →</button></div><div class="lab-source-note" style="color:#526879"><a href="https://www.vatican.va/archive/cod-iuris-canonici/eng/documents/cic_lib4-cann959-997_en.html" target="_blank" rel="noopener">CIC canons 959–997 ↗</a></div></article></div>`;
};

renderAngelus=function(){
 const useRegina=S.angelusOverride?S.angelusOverride==='regina':paschal(),x=useRegina?D.regina:D.angelus;
 return `<div class="pbShell">${labHead(useRegina?'Regina Cæli':'Angelus',t('Pause with Our Lady','Pause avec Notre-Dame'))}<p class="lab-practice-lead">${useRegina?t('Paschaltide: the Regina Cæli replaces the Angelus and is traditionally prayed standing.','Temps pascal : le Regina Cæli remplace l’Angélus et se prie traditionnellement debout.'):t('Traditionally prayed morning, noon and evening. Kneel ordinarily; stand on Sundays and in Paschaltide according to traditional custom.','Traditionnellement prié le matin, à midi et le soir. À genoux ordinairement ; debout le dimanche et au temps pascal selon l’usage traditionnel.')}</p><article class="lab-practice-sheet"><span class="lab-practice-status custom">${t('Documented traditional devotion','Dévotion traditionnelle documentée')}</span><h2>${useRegina?'Regina Cæli':'Angelus'}</h2><div class="lab-practice-note">${useRegina?t('Seasonal substitution in Paschaltide.','Substitution saisonnière au temps pascal.'):t('At Et Verbum caro factum est, a profound bow is documented in papal practice; genuflection is also found in devotional usage.','À Et Verbum caro factum est, une profonde inclination est attestée dans la pratique pontificale ; la génuflexion existe aussi dans l’usage dévotionnel.')}</div>${labFlip(x.la,x[lang()],'angelus-main')}${!useRegina?`<label class="lab-practice-note" style="display:flex;gap:10px;align-items:flex-start;background:#e7ebed;color:#334d60"><input type="checkbox" data-pb-angelus-conclusion ${S.angelusConclusion?'checked':''}><span><strong>${t('Traditional conclusion','Conclusion traditionnelle')}</strong><br>${t('Three Gloria Patri, prayer for the faithful departed, and Divinum auxilium.','Trois Gloria Patri, prière pour les fidèles défunts et Divinum auxilium.')}</span></label>${S.angelusConclusion?`<div style="margin-top:18px">${labFlip(D.angelusAppendix.la,D.angelusAppendix[lang()],'angelus-appendix')}</div>`:''}`:''}<div class="lab-actions"><button data-pb-toggle-angelus>${useRegina?t('Show Angelus instead','Afficher plutôt l’Angélus'):t('Show Regina Cæli instead','Afficher plutôt le Regina Cæli')}</button></div><div class="lab-source-row"><a href="${AO_LINKS.angelusDir}" target="_blank" rel="noopener">Directory on Popular Piety ↗</a><a href="${AO_LINKS.angelusRaccolta}" target="_blank" rel="noopener">Raccolta · Pius VII 1815 ↗</a></div></article></div>`;
};

renderStations=function(){
 const l=lang(),titles=D.stationTitles[l]||D.stationTitles.en;
 if(S.station===0)return `<div class="pbShell">${labHead(t('Stations of the Cross','Chemin de Croix'),'Via Crucis')}<section class="lab-stations-hero"><p class="eyebrow">${t('Traditional XIV Stations','XIV Stations traditionnelles')}</p><strong>${t('Walk with Our Lord to Calvary','Marcher avec Notre-Seigneur vers le Calvaire')}</strong><p>${t('The sourced St Alphonsus form is used directly: Guided includes his meditation and prayer; Simple retains the station versicle and the Pater · Ave · Gloria.','La forme sourcée de saint Alphonse est reprise directement : le mode Guidé comprend sa méditation et sa prière ; le mode Simple conserve le verset de la station et Pater · Ave · Gloria.')}</p></section><div class="lab-stations-settings"><button class="${S.stationMode==='guided'?'active':''}" data-pb-station-mode="guided"><strong>${t('Guided','Guidé')}</strong><br><span>${t('St Alphonsus meditation + prayer','Méditation + prière de saint Alphonse')}</span></button><button class="${S.stationMode==='simple'?'active':''}" data-pb-station-mode="simple"><strong>${t('Simple','Simple')}</strong><br><span>Pater · Ave · Gloria</span></button><label class="wide"><input type="checkbox" data-pb-stabat ${S.stationStabat?'checked':''}> <span>Stabat Mater · ${t('Latin between stations','latin entre les stations')}</span></label></div><div class="lab-actions"><button class="accent" data-pb-station-next>${t('Begin the Way of the Cross','Commencer le Chemin de Croix')} →</button></div><p class="lab-source-note">${t('St Alphonsus Maria de Liguori · Way of the Cross (1787). The traditional falls and Veronica are presented as received devotional tradition, not as explicit Gospel narratives.','Saint Alphonse-Marie de Liguori · Chemin de Croix (1787). Les chutes traditionnelles et Véronique sont présentées comme tradition dévotionnelle reçue, non comme récits évangéliques explicites.')}</p></div>`;
 const i=S.station,n=i-1,a=D.alphonsus[l]||D.alphonsus.en,ala=D.alphonsus.la,vr=D.stationVR,roman=['I','II','III','IV','V','VI','VII','VIII','IX','X','XI','XII','XIII','XIV'];
 return `<div class="pbShell">${labHead(titles[n],`Via Crucis · ${roman[n]} / XIV`)}<div class="lab-station-rail">${roman.map((r,j)=>`<i class="${j<n?'done':j===n?'current':''}">${r}</i>`).join('')}</div><article class="lab-prayer-sheet lab-station-text"><p class="rubric">${t('We adore Thee, O Christ, and we bless Thee','Nous vous adorons, ô Christ, et nous vous bénissons')}</p><h2>${esc(titles[n])}</h2><div style="margin-bottom:18px">${labFlip(vr.la.join('\n'),vr[l].join('\n'),'station-vr-'+n)}</div>${S.stationMode==='guided'?`<h3>${t('Consider','Considérez')}</h3><p>${esc(a[n].consider)}</p><h3>${t('Prayer of St Alphonsus','Prière de saint Alphonse')}</h3>${labFlip(ala[n].prayer,a[n].prayer,'station-alphonsus-'+n)}`:''}<h3>${t('Ordinary station prayers','Prières ordinaires de la station')}</h3>${labPrayerBundle(['pater','ave','gloria'],'station-prayers-'+n)}${S.stationStabat&&n<13?`<div class="lab-stabat"><p class="eyebrow" style="color:#806626">Stabat Mater</p>${labFlip(D.stabat[n],(l==='fr'?AO_STABAT_FR:AO_STABAT_EN)[n],'stabat-'+n)}</div>`:''}</article><div class="lab-player-controls"><button data-pb-station-prev>← ${t('Previous','Précédent')}</button><button class="primary" data-pb-station-next>${i===14?t('Finish','Terminer'):t('Next station','Station suivante')} →</button></div></div>`;
};

renderBenediction=function(){
 const seq=['benediction_o_salutaris','silence','benediction_tantum_ergo','benediction_versicles','blessing','benediction_divine_praises','benediction_adoremus_ps116'],idx=Math.min(S.benedictionStep,seq.length-1),id=seq[idx],p=D.prayers[id];let body='';
 if(id==='silence')body=`<p class="eyebrow" style="color:#806626">${t('Adoration','Adoration')}</p><h2>${t('Remain before the Blessed Sacrament','Demeurez devant le Saint-Sacrement')}</h2><p>${t('Remain in prayer and sacred silence.','Demeurez dans la prière et le silence sacré.')}</p>`;
 else if(id==='blessing')body=`<span class="lab-practice-status official">${t('Ministerial action','Action du ministre')}</span><h2>${t('Benediction occurs here','La bénédiction a lieu ici')}</h2><p>${t('The priest or deacon blesses the faithful with the Blessed Sacrament. The lay user does not simulate this action.','Le prêtre ou le diacre bénit les fidèles avec le Saint-Sacrement. L’utilisateur laïc ne simule pas cette action.')}</p>`;
 else body=`<p class="eyebrow" style="color:#806626">${esc(prayerTitle(p))}</p>${labFlip(p.la,p[lang()]||p.en,'library-'+p.id)}`;
 return `<div class="pbShell">${labHead(t('Benediction','Bénédiction'),t('Eucharistic devotion','Dévotion eucharistique'))}<div class="lab-progress"><i style="width:${((idx+1)/seq.length*100).toFixed(1)}%"></i></div><article class="lab-practice-sheet">${body}</article><div class="lab-player-controls"><button data-lab-ben-prev ${idx===0?'disabled':''}>← ${t('Previous','Précédent')}</button><button class="primary" data-lab-ben-next>${idx===seq.length-1?t('Finish','Terminer'):t('Next','Suivant')} →</button></div></div>`;
};

/* Extend the existing binder only for the Lab-ora player controls introduced above. */
const _laboraPortBind=bind;
bind=function(){
 _laboraPortBind();
 const today=root.querySelector('[data-lab-rosary-today]');if(today)today.onclick=()=>{S.rosarySet=today.dataset.labRosaryToday;S.rosaryStep=0;render()};
 root.querySelectorAll('[data-v38-rosary-form]').forEach(b=>b.onclick=()=>{S.rosaryForm=b.dataset.v38RosaryForm==='devotional'?'devotional':'standard';S.rosaryStep=0;render()});
 const rp=root.querySelector('[data-lab-rosary-prev]'),rn=root.querySelector('[data-lab-rosary-next]'),rc=root.querySelector('[data-lab-rosary-change]');
 if(rp)rp.onclick=()=>{S.rosaryStep=Math.max(0,S.rosaryStep-1);render()};
 if(rn)rn.onclick=()=>{const steps=labRosarySteps(S.rosarySet);if(S.rosaryStep>=steps.length-1){S.rosarySet=null;S.rosaryStep=0;render();return}S.rosaryStep++;render()};
 if(rc)rc.onclick=()=>{S.rosarySet=null;S.rosaryStep=0;render()};
 const bp=root.querySelector('[data-lab-ben-prev]'),bn=root.querySelector('[data-lab-ben-next]');
 if(bp)bp.onclick=()=>{S.benedictionStep=Math.max(0,S.benedictionStep-1);render()};
 if(bn)bn.onclick=()=>{const max=6;if(S.benedictionStep>=max){go('hub');return}S.benedictionStep++;render()};
};

