/data/catena/matthew.jsonl"},"catena.matthew.17.5":{"citation":"Catena Aurea, Matthew 17:5–9","gospel":"matthew","chapter":17,"start_verse":5,"source_url":"https://www.ecatholic2000.com/catena/untitled-24.shtml","normalized_source_file":"https://raw.githubusercontent.com/AlvaroBalbin/catena/main/data/catena/matthew.jsonl"},"catena.matthew.26.26":{"citation":"Catena Aurea, Matthew 26:26","gospel":"matthew","chapter":26,"start_verse":26,"source_url":"https://www.ecatholic2000.com/catena/untitled-33.shtml","normalized_source_file":"https://raw.githubusercontent.com/AlvaroBalbin/catena/main/data/catena/matthew.jsonl"},"catena.matthew.26.27":{"citation":"Catena Aurea, Matthew 26:27–29","gospel":"matthew","chapter":26,"start_verse":27,"source_url":"https://www.ecatholic2000.com/catena/untitled-33.shtml","normalized_source_file":"https://raw.githubusercontent.com/AlvaroBalbin/catena/main/data/catena/matthew.jsonl"},"catena.matthew.26.36":{"citation":"Catena Aurea, Matthew 26:36–38","gospel":"matthew","chapter":26,"start_verse":36,"source_url":"https://www.ecatholic2000.com/catena/untitled-33.shtml","normalized_source_file":"https://raw.githubusercontent.com/AlvaroBalbin/catena/main/data/catena/matthew.jsonl"},"catena.matthew.26.39":{"citation":"Catena Aurea, Matthew 26:39–44","gospel":"matthew","chapter":26,"start_verse":39,"source_url":"https://www.ecatholic2000.com/catena/untitled-33.shtml","normalized_source_file":"https://raw.githubusercontent.com/AlvaroBalbin/catena/main/data/catena/matthew.jsonl"},"catena.matthew.26.45":{"citation":"Catena Aurea, Matthew 26:45–46","gospel":"matthew","chapter":26,"start_verse":45,"source_url":"https://www.ecatholic2000.com/catena/untitled-33.shtml","normalized_source_file":"https://raw.githubusercontent.com/AlvaroBalbin/catena/main/data/catena/matthew.jsonl"},"catena.matthew.27.15":{"citation":"Catena Aurea, Matthew 27:15–26","gospel":"matthew","chapter":27,"start_verse":15,"source_url":"https://www.ecatholic2000.com/catena/untitled-34.shtml","normalized_source_file":"https://raw.githubusercontent.com/AlvaroBalbin/catena/main/data/catena/matthew.jsonl"},"catena.matthew.27.27":{"citation":"Catena Aurea, Matthew 27:27–30","gospel":"matthew","chapter":27,"start_verse":27,"source_url":"https://www.ecatholic2000.com/catena/untitled-34.shtml","normalized_source_file":"https://raw.githubusercontent.com/AlvaroBalbin/catena/main/data/catena/matthew.jsonl"},"catena.matthew.27.31":{"citation":"Catena Aurea, Matthew 27:31–34","gospel":"matthew","chapter":27,"start_verse":31,"source_url":"https://www.ecatholic2000.com/catena/untitled-34.shtml","normalized_source_file":"https://raw.githubusercontent.com/AlvaroBalbin/catena/main/data/catena/matthew.jsonl"},"catena.matthew.28.16":{"citation":"Catena Aurea, Matthew 28:16–20","gospel":"matthew","chapter":28,"start_verse":16,"source_url":"https://www.ecatholic2000.com/catena/untitled-35.shtml","normalized_source_file":"https://raw.githubusercontent.com/AlvaroBalbin/catena/main/data/catena/matthew.jsonl"},"catena.matthew.3.13":{"citation":"Catena Aurea, Matthew 3:13–15","gospel":"matthew","chapter":3,"start_verse":13,"source_url":"https://www.ecatholic2000.com/catena/untitled-10.shtml","normalized_source_file":"https://raw.githubusercontent.com/AlvaroBalbin/catena/main/data/catena/matthew.jsonl"},"catena.matthew.5.1":{"citation":"Catena Aurea, Matthew 5:1–3","gospel":"matthew","chapter":5,"start_verse":1,"source_url":"https://www.ecatholic2000.com/catena/untitled-12.shtml","normalized_source_file":"https://raw.githubusercontent.com/AlvaroBalbin/catena/main/data/catena/matthew.jsonl"},"catena.matthew.6.31":{"citation":"Catena Aurea, Matthew 6:31–33","gospel":"matthew","chapter":6,"start_verse":31,"source_url":"https://www.ecatholic2000.com/catena/untitled-13.shtml","normalized_source_file":"https://raw.githubusercontent.com/AlvaroBalbin/catena/main/data/catena/matthew.jsonl"}};
const AO_R_DRC_BASE='https://raw.githubusercontent.com/BibleCorps/ENG-B-DRC1750-pd-PSFM/master/';
const AO_R_CATENA_BASE='https://raw.githubusercontent.com/AlvaroBalbin/catena/main/data/catena/';
const AO_R_CRAMPTON_CUES='https://raw.githubusercontent.com/Fulcanelli13/lab-ora/main/data/rosary-scripture-fr-crampon-v1.compact.json';
const AO_R_CRAMPTON_CHAPTERS='https://raw.githubusercontent.com/Fulcanelli13/lab-ora/main/data/crampon-rosary-chapters-v1.json';
const AO_R_CACHE_PREFIX='ao-r-depth-v1:';

try{S.recitationMode=localStorage.getItem('ao-prayer-recitation-mode')||'individual'}catch{S.recitationMode='individual'}
let aoRFrCues=null,aoRFrChapters=null;
const aoRDrcBookCache=new Map(),aoRDrcChapterCache=new Map(),aoRCatenaCache=new Map();

function aoRMode(){
 try{
  const stored=localStorage.getItem('ao-prayer-recitation-mode');
  if(stored==='group'||stored==='individual')S.recitationMode=stored;
 }catch{}
 return S.recitationMode==='group'?'group':'individual';
}
function aoRSetMode(mode){
 S.recitationMode=mode==='group'?'group':'individual';
 try{localStorage.setItem('ao-prayer-recitation-mode',S.recitationMode)}catch{}
 try{document.documentElement.classList.toggle('aoRecitationGroup',S.recitationMode==='group')}catch{}
 render();
}
function aoRModeBar(){
 const m=aoRMode();
 return `<div class="lab-recitation-mode" role="group" aria-label="${t('Recitation mode','Mode de récitation')}"><span>${t('Recitation','Récitation')}</span><div><button type="button" class="${m==='individual'?'active':''}" data-ao-recitation="individual">${t('Individual','Individuel')}</button><button type="button" class="${m==='group'?'active':''}" data-ao-recitation="group">${t('Group','Groupe')}</button></div><small>${m==='group'?t('℣. leader · ℟. response; common prayers divide only where configured','℣. meneur · ℟. réponse ; les prières communes ne se divisent que lorsqu’elles sont configurées'):t('Intrinsic ℣./℟. remain visible; pray both parts yourself','Les ℣./℟. propres à la prière restent visibles ; récitez vous-même les deux parties')}</small></div>`;
}
function aoRInjectModeBar(markup){
 const p=String(markup||'').indexOf('</header>');
 if(p<0)return markup;
 return markup.slice(0,p+9)+aoRModeBar()+markup.slice(p+9);
}
function aoRCanonicalMarkers(text){
 return String(text||'')
  /* Source truth: intrinsic dialogue is always retained. V./R. is normalised to ℣./℟. */
  .replace(/([.!?;:])\s+V[.:]\s*/gi,'$1\n℣. ')
  .replace(/([.!?;:])\s+R[.:]\s*/gi,'$1\n℟. ')
  .replace(/([.!?;:])\s+℣[.:]?\s*/g,'$1\n℣. ')
  .replace(/([.!?;:])\s+℟[.:]?\s*/g,'$1\n℟. ')
  .replace(/(^|\n)\s*V[.:]\s*/gi,'$1℣. ')
  .replace(/(^|\n)\s*R[.:]\s*/gi,'$1℟. ')
  .replace(/(^|\n)\s*℣[.:]?\s*/g,'$1℣. ')
  .replace(/(^|\n)\s*℟[.:]?\s*/g,'$1℟. ');
}
function aoRCommonParts(text,id=''){
 const raw=String(text||'').trim(),low=raw.toLowerCase();
 const idPater=/(?:^|[-_])pater(?:[-_]|$)/i.test(id);
 const idAve=/(?:^|[-_])ave(?:[-_]|$)/i.test(id);
 const idGloria=/(?:^|[-_])gloria(?:[-_]|$)/i.test(id);

 const startsPater=/^(?:pater noster|our father|notre père|notre pere)\b/i.test(raw);
 const startsAve=/^(?:ave maria|hail mary|je vous salue)\b/i.test(raw);
 const startsGloria=/^(?:gloria patri|glory be|gloire au père|gloire au pere)\b/i.test(raw);

 const kind=(idPater||startsPater)?'pater':(idAve||startsAve)?'ave':(idGloria||startsGloria)?'gloria':'';
 if(!kind)return {kind:'',leader:raw,response:''};

 const markers={
  pater:['panem nostrum','give us this day','donnez-nous aujourd'],
  ave:['sancta maria','holy mary','sainte marie'],
  gloria:['sicut erat','as it was','comme il était','comme il etait']
 }[kind];

 for(const mark of markers){
  const at=low.indexOf(mark);
  if(at>0)return {kind,leader:raw.slice(0,at).trim(),response:raw.slice(at).trim()};
 }
 return {kind,leader:raw,response:''};
}
const AO_PRAYER_ROLES_V371=Object.freeze({
 intrinsic:new Set([
  'angelus-main','angelus-appendix','rosary-salve',
  'library-marian_hail_holy_queen','library-benediction_versicles','library-mass_devotion_leonine',
  'library-church_prayer_for_pope','library-dead_de_profundis','library-sacrament_come_holy_spirit'
 ]),
 litanies:new Set([
  'library-adoration_litany_blessed_sacrament','library-devotion_litany_st_joseph',
  'library-litany_loreto_1962','library-litany_loreto_current'
 ]),
 common:new Set([
  'library-foundations_our_father','library-foundations_hail_mary','library-foundations_glory_be'
 ])
});
function aoRRoleKind(id){
 id=String(id||'');
 if(AO_PRAYER_ROLES_V371.litanies.has(id))return'litany';
 if(AO_PRAYER_ROLES_V371.intrinsic.has(id)||id.startsWith('station-vr-'))return'intrinsic';
 if(AO_PRAYER_ROLES_V371.common.has(id)||/(?:^|[-_])(pater|ave|gloria)(?:[-_]|$)/i.test(id))return'common';
 return'plain';
}
function aoRResponsiveText(text,id=''){
 /* Intrinsic source dialogue keeps genuine ℣./℟. markers.
    Pater / Ave / Gloria are divided semantically by aoRPrayerHtml in Group mode,
    without inventing ℣./℟. characters in their prayer text. */
 return aoRCanonicalMarkers(text);
}
function aoREsc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function aoRRoleLine(line){
 const m=String(line).match(/^\s*([℣℟])\.\s*(.*)$/);
 if(!m)return `<span class="aoPrayerProse">${aoREsc(line)}</span>`;
 const cls=m[1]==='℣'?'aoVersicle':'aoResponse';
 const lab=m[1]==='℣'?t('Versicle','Verset'):t('Response','Répons');
 return `<span class="aoPrayerDialogueLine ${cls}"><span class="aoPrayerRole" aria-label="${esc(lab)}">${m[1]}.</span><span class="aoPrayerDialogueBody"><span class="aoPrayerWords">${aoREsc(m[2])}</span></span></span>`;
}
function aoRLitanyLine(line){
 const raw=String(line||'').trim();if(!raw)return'';
 let m=raw.match(/^(.+?)\s+[—–]\s+(.+)$/);
 if(!m)m=raw.match(/^(.+?),\s*((?:ora pro nobis|miserere nobis|parce nobis(?:, Domine)?|exaudi nos(?:, Domine)?|libera nos(?:, Domine)?|pray for us|have mercy on us|spare us(?:, O Lord)?|graciously hear us(?:, O Lord)?|deliver us(?:, O Lord)?|priez pour nous|ayez pitié de nous|pardonnez-nous(?:, Seigneur)?|exaucez-nous(?:, Seigneur)?|délivrez-nous(?:, Seigneur)?)\.?)$/i);
 if(!m)return aoRRoleLine(raw);
 return `<span class="aoLitanyLine"><span class="aoLitanyCall"><span class="aoPrayerRole" aria-hidden="true">℣.</span><span>${aoREsc(m[1].trim())}</span></span><span class="aoLitanyResponse"><span class="aoPrayerRole" aria-hidden="true">℟.</span><span>${aoREsc(m[2].trim())}</span></span></span>`;
}
function aoRPrayerHtml(text,id=''){
 const shown=aoRResponsiveText(text,id),kind=aoRRoleKind(id);
 const out=[];
 let blank=false;

 for(const raw of shown.split(/\n/)){
  const line=String(raw||'').trim();
  if(!line){blank=true;continue}
  if(blank&&out.length)out.push('<span class="aoPrayerSpacer" aria-hidden="true"></span>');
  blank=false;

  if(kind==='litany'){out.push(aoRLitanyLine(line));continue}

  /* Mixed sequences such as the Angelus contain complete Ave Maria prayers
     between intrinsic versicle/response pairs. Detect the complete common prayer
     by its actual text, not only by the module identifier. */
  if(aoRMode()==='group'&&!/^[℣℟]\./.test(line)){
   const parts=aoRCommonParts(line,id);
   if(parts.response){
    out.push(`<span class="aoCustomarySplit" data-common-prayer="${esc(parts.kind)}"><span class="aoCustomaryLeader"><span class="aoSrOnly">${t('Leader','Meneur')}</span>${aoREsc(parts.leader)}</span><span class="aoCustomaryResponse"><span class="aoSrOnly">${t('Group response','Réponse du groupe')}</span>${aoREsc(parts.response)}</span></span>`);
    continue;
   }
  }

  if(/^[℣℟]\./.test(line)){out.push(aoRRoleLine(line));continue}
  out.push(`<span class="aoPrayerProse">${aoREsc(line)}</span>`);
 }
 return out.join('');
}

/* All Latin-first devotional surfaces now share one source-aware recitation contract. */
labFlip=function(la,vern,id='lab-flip'){
 const laShown=aoRResponsiveText(la,id),vernShown=aoRResponsiveText(vern,id);
 if(!la)return `<div class="lab-prayer-flip" style="cursor:default">${aoRPrayerHtml(vernShown||'',id)}</div>`;
 return `<button class="lab-prayer-flip" data-pb-flip="${esc(id)}" data-face="latin"><span data-pb-latin>${aoRPrayerHtml(laShown,id)}</span><span data-pb-vern hidden>${aoRPrayerHtml(vernShown||'',id)}</span></button><div class="lab-flip-hint" data-pb-flip-hint>${t('Tap the text · show English','Touchez le texte · afficher le français')}</div>`;
};

/* Scripture context — same interaction contract as Lab-ora: cue -> passage -> full chapter. */
function aoRParseRef(reference){
 const m=String(reference||'').match(/^(.+?)\s+(\d+):(\d+)(?:[a-z])?(?:[–-](\d+)(?:[a-z])?)?/i);
 return m?{book:m[1],chapter:+m[2],verseStart:+m[3],verseEnd:+(m[4]||m[3])}:null;
}
function aoRContextFor(mid,cue){
 const r=aoRParseRef(cue?.reference);if(!r)return null;
 const range=AO_R_CONTEXT_RANGES[`${mid}|${r.book}|${r.chapter}`];
 if(!range)return null;
 return {...r,start:range[0],end:range[1],mid};
}
function aoRStripUsfm(x){
 return String(x||'')
  .replace(/\\f\s+[\s\S]*?\\f\*/g,'').replace(/\\x\s+[\s\S]*?\\x\*/g,'')
  .replace(/\\(?:add|bd|bdit|bk|dc|em|it|k|nd|ord|pn|qt|sc|sig|sls|tl|wj)\*/g,'')
  .replace(/\\(?:add|bd|bdit|bk|dc|em|it|k|nd|ord|pn|qt|sc|sig|sls|tl|wj)\s*/g,'')