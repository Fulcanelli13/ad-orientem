                    break;
                case 'credo':
                    next.privateAction = true;
                    next.audibility = 'mixed';
                    next.audibleFragment = AO_CREDO_INTONATION;
                    next.priestPosition = 'Centre for intonation/private recitation → may sit while choir continues';
                    add('PRIEST','The celebrant sings Credo in unum Deum, privately recites the Creed, and may sit while the choir continues; the prescribed reverence at Et incarnatus is retained.','Le célébrant chante Credo in unum Deum, récite le Credo à voix basse et peut s’asseoir pendant que le chœur continue ; la révérence prescrite à Et incarnatus demeure.','CEREMONIAL_1962');
                    break;
                case 'offertory':
                    next.privateAction = true;
                    next.audibility = 'mixed';
                    next.audibleFragment = ordinary_1.fixedOrdinary.offertoryDialogue;
                    add('PRIEST','Dominus vobiscum and Oremus are public; the celebrant then reads the Offertory antiphon privately while the schola sings it independently.','Dominus vobiscum et Oremus sont publics ; le célébrant lit ensuite l’antienne d’Offertoire à voix basse tandis que la schola la chante indépendamment.','CEREMONIAL_1962');
                    break;
                case 'agnus':
                    next.privateAction = true;
                    next.audibility = 'choir';
                    add('PRIEST','The celebrant says the Agnus Dei privately while the schola sings it; the two tracks need not finish together.','Le célébrant récite l’Agnus Dei à voix basse tandis que la schola le chante ; les deux pistes ne doivent pas nécessairement finir ensemble.','CEREMONIAL_1962');
                    break;
            }
        }
        switch (step.id) {
            case 'incense-entrance':
                if (incensed) {
                    add('THURIFER','The thurifer assists as incense is blessed and the cross and altar are incensed.','Le thuriféraire assiste pendant la bénédiction de l’encens et l’encensement de la croix et de l’autel.','CEREMONIAL_1962');
                    add('PRIEST','After the altar incensation, the celebrant is incensed according to the Sung-Mass ceremonial.','Après l’encensement de l’autel, le célébrant est encensé selon le cérémonial de la Messe chantée.','CEREMONIAL_1962');
                }
                break;
            case 'collect':
                next.priestPosition = 'Centre for Dominus vobiscum → Epistle side at the Missal for the Collect';
                add('PRIEST','At the centre the celebrant gives Dominus vobiscum, then turns to the Missal at the Epistle side for Oremus and the Collect(s).','Au centre le célébrant donne Dominus vobiscum, puis se tourne vers le Missel au côté de l’Épître pour Oremus et la ou les Collectes.','RUBRIC_1962');
                break;
            case 'epistle':
                next.ministerVariant = 'LECTOR_OR_CELEBRANT';
                add('SERVER','The Missal transfer and Gospel-side preparation follow the reading/interlection phase according to the ministers present.','Le transfert du Missel et la préparation du côté de l’Évangile suivent la lecture et les chants intermédiaires selon les ministres présents.','CEREMONIAL_IMPLEMENTATION');
                break;
            case 'preface':
                next.priestPosition = 'Centre · facing the altar / Missal';
                break;
            case 'nobis-quoque':
                next.privateAction = true;
                next.audibility = 'mixed';
                next.audibleFragment = AO_NOBIS_AUDIBLE_WORDS;
                break;
            case 'canon-doxology':
                next.privateAction = true;
                next.audibility = 'mixed';
                next.audibleFragment = AO_CANON_CONCLUSION;
                break;
            case 'pater':
                next.privateAction = true;
                next.audibility = 'mixed';
                next.audibleFragment = paterPublicPortion(next.text);
                add('PRIEST','The Pater noster and the appointed response Sed libera nos a malo are public/audible; the priest then says Amen secretly before the embolism.','Le Pater noster et la réponse prescrite Sed libera nos a malo sont publics/audibles ; le prêtre dit ensuite Amen à voix basse avant l’embolisme.','RUBRIC_1962');
                break;
            case 'libera-nos':
                next.privateAction = true;
                next.audibility = 'mixed';
                next.audibleFragment = AO_CANON_CONCLUSION;
                break;
            case 'priest-communion':
                if (!sung) {
                    next.privateAction = true;
                    next.audibility = 'mixed';
                    next.audibleFragment = AO_PRIEST_DNSD_AUDIBLE;
                    next.voiceAuthority = 'RG60_511_CLEAR_VOICE';
                    next.voiceNote = 'Low Mass: the priest’s Domine non sum dignus is clear voice; Panem caelestem, the Communion formulas and Quid retribuam remain secret. In Missa Cantata the celebrant follows RG60 513–514 and this private Communion track remains secret.';
                }
                break;
        }
        if (cues.length) next.ceremonialCues = cues;
        return next;
    });
}
function splitSanctusBenedictus(text) {
    const markers = {
        lat: ['Benedíctus qui venit', 'Benedictus qui venit'],
        en: ['Blessed is He who comes', 'Blessed is he who comes'],
        fr: ['Béni soit celui qui vient', 'Béni soit Celui qui vient'],
    };
    const sanctus = {}, benedictus = {};
    for (const lang of ['lat','en','fr']) {
        const raw = String(text?.[lang] || '').trim();
        let index = -1;
        for (const marker of markers[lang]) {
            const found = raw.indexOf(marker);
            if (found >= 0) { index = found; break; }
        }
        if (index < 0) {
            sanctus[lang] = raw;
            benedictus[lang] = '';
        } else {
            sanctus[lang] = raw.slice(0, index).trim();
            benedictus[lang] = raw.slice(index).trim();
        }
    }
    return { sanctus, benedictus };
}
function appendChoir(step, event) {
    return { ...step, choir: [...(step.choir || []), event] };
}
function applySungSynchronization(steps, options, proper) {
    if (options.form !== 'sung') return steps;
    const setting = options.sanctusSetting === 'divided' ? 'divided' : 'gregorian';
    const sanctusStep = steps.find(step => step.id === 'sanctus');
    const sanctusText = sanctusStep?.text || sanctusStep?.choir?.[0]?.text || null;
    const split = splitSanctusBenedictus(sanctusText);
    const gregorianPreCanon = new Set(['te-igitur','memento-living','communicantes','hanc','quam-oblationem']);
    const dividedPostCanon = new Set(['unde-et-memores','supra-quae','supplices','memento-dead','nobis-quoque']);
    return steps.map(step => {
        let next = { ...step };
        if (step.id === 'sanctus' && sanctusText) {
            next.privateAction = true;
            next.choir = [{
                id: setting === 'divided' ? 'sanctus-divided-choir' : 'sanctus-gregorian-choir',
                text: setting === 'divided' ? split.sanctus : sanctusText,
                timing: setting === 'divided' ? 'before-consecration' : 'continuous-sanctus-benedictus',
                continuation: setting !== 'divided',
                overlapStatus: setting !== 'divided' ? 'possible' : null,
            }];
            next.explanation = setting === 'divided'
                ? 'The celebrant privately recites the whole Sanctus and Benedictus and proceeds into the Canon. In a divided non-Gregorian setting the choir sings the Sanctus before the Consecration and withholds the Benedictus until the Consecration is complete.'
                : 'The celebrant privately recites the Sanctus and Benedictus and proceeds immediately into the Canon. In Gregorian chant the choir sings Sanctus and Benedictus continuously; its chant may overlap the early silent Canon but must be finished before the Consecration.';
        }
        if (setting === 'gregorian' && gregorianPreCanon.has(step.id) && sanctusText) {
            next = appendChoir(next, {
                id: 'sanctus-gregorian-choir',
                text: sanctusText,
                timing: 'may-overlap-early-canon',
                continuation: true,
                overlapStatus: 'possible',
            });
        }
        if (setting === 'divided' && dividedPostCanon.has(step.id) && Object.values(split.benedictus).some(Boolean)) {
            next = appendChoir(next, {
                id: 'benedictus-divided-choir',
                text: split.benedictus,
                timing: step.id === 'unde-et-memores' ? 'starts-after-consecration' : 'may-continue-post-consecration',
                continuation: true,
                overlapStatus: step.id === 'unde-et-memores' ? 'post-consecration' : 'possible',
            });
        }
        if (/^consecration-(host|chalice)$/.test(step.id)) {
            next.silenceGate = 'CONSECRATION';
            next.choir = [];
        }
        return next;
    });
}

function ceremonialCue(actor, en, fr, authority = 'CEREMONIAL_IMPLEMENTATION') {
    const roleLabels = {
        PRIEST: { en: 'Priest', fr: 'Prêtre' },
        SERVER: { en: 'Server', fr: 'Servant' },
        SERVERS: { en: 'Servers', fr: 'Servants' },
        THURIFER: { en: 'Thurifer', fr: 'Thuriféraire' },
        MUSIC: { en: 'Music', fr: 'Musique' },
        LECTOR: { en: 'Lector', fr: 'Lecteur' },
    };
    return { actor, actorLabel: roleLabels[actor] || { en: actor, fr: actor }, text: { en, fr }, authority };
}
function applyCeremonialGranularity(steps, options) {
    const incensed = options.form === 'sung' && options.incenseSung !== false;
    return steps.map(step => {
        let next = { ...step };
        const cues = [...(step.ceremonialCues || [])];
        const add = (actor, en, fr, authority) => cues.push(ceremonialCue(actor, en, fr, authority));
        switch (step.id) {
            case 'water-wine':
                add('SERVER',
                    'The server/acolyte presents the wine and water; the priest mixes a little water into the chalice.',
                    'Le servant/acolyte présente le vin et l’eau ; le prêtre mêle un peu d’eau au calice.',
                    'CEREMONIAL_IMPLEMENTATION');
                break;
            case 'incense-off':
                add('THURIFER',
                    'The thurifer assists while the offerings and altar are incensed; the remaining incensations follow the ceremonial applicable to this Sung Mass.',
                    'Le thuriféraire assiste pendant l’encensement des offrandes et de l’autel ; les encensements suivants suivent le cérémonial applicable à cette Messe chantée.',
                    'CEREMONIAL_IMPLEMENTATION');
                break;
            case 'lavabo':
                add('SERVER',
                    'The server presents the water, basin and towel at the Epistle side.',
                    'Le servant présente l’eau, le bassin et le manuterge du côté de l’Épître.',
                    'CEREMONIAL_IMPLEMENTATION');
                break;
            case 'consecration-host':
                next.ceremonialSequence = ['HOST_WORDS_COMPLETE','GENUFLECT','ELEVATE_HOST','REPLACE_HOST','GENUFLECT'];
                add('PRIEST',
                    'Words of Consecration → genuflection → elevation of the Sacred Host → replacement on the corporal → genuflection.',
                    'Paroles de la Consécration → génuflexion → élévation de la sainte Hostie → remise sur le corporal → génuflexion.',
                    'RUBRIC_1962');
                add('SERVER',
                    'During the elevation the server remains kneeling and lifts the chasuble.',
                    'Pendant l’élévation le servant reste à genoux et soulève la chasuble.',
                    'CEREMONIAL_1962');
                if (incensed) add('THURIFER',
                    'During the elevation the Sacred Host is censed three times.',
                    'Pendant l’élévation la sainte Hostie est encensée trois fois.',
                    'CEREMONIAL_1962');
                break;
            case 'consecration-chalice':
                next.ceremonialSequence = ['CHALICE_WORDS_COMPLETE','GENUFLECT','ELEVATE_CHALICE','REPLACE_CHALICE','GENUFLECT'];
                add('PRIEST',
                    'Words of Consecration → genuflection → elevation of the Precious Blood → replacement of the chalice → genuflection.',
                    'Paroles de la Consécration → génuflexion → élévation du Précieux Sang → remise du calice → génuflexion.',
                    'RUBRIC_1962');
                add('SERVER',
                    'During the elevation the server remains kneeling and lifts the chasuble.',
                    'Pendant l’élévation le servant reste à genoux et soulève la chasuble.',
                    'CEREMONIAL_1962');
                if (incensed) add('THURIFER',
                    'During the elevation the chalice is censed three times.',
                    'Pendant l’élévation le calice est encensé trois fois.',
                    'CEREMONIAL_1962');
                break;
            case 'canon-doxology':
                add('PRIEST',
                    'At Per ipsum the Host and chalice are raised together in the small elevation; this is distinct from the two major elevations at the Consecration.',
                    'Au Per ipsum, l’Hostie et le calice sont élevés ensemble dans la petite élévation ; celle-ci est distincte des deux grandes élévations de la Consécration.',
                    'CEREMONIAL_CONTEXT');
                break;
            case 'priest-communion':
                if (options.faithfulCommunion !== false) add('SERVER',
                    'The server prepares the Communion plate for the Communion of the faithful.',
                    'Le servant prépare le plateau de Communion pour la Communion des fidèles.',
                    'CEREMONIAL_1962');
                break;
            case 'communion-faithful':
                add('PRIEST',
                    'The priest distributes Holy Communion, moving along the communicants.',
                    'Le prêtre distribue la sainte Communion en se déplaçant le long des communiants.',
                    'RUBRIC_1962');
                add('SERVER',
                    'The server accompanies the priest during distribution with the Communion plate.',
                    'Le servant accompagne le prêtre pendant la distribution avec le plateau de Communion.',
                    'CEREMONIAL_1962');
                break;
            case 'ablutions':
                add('PRIEST',
                    'After distribution the celebrant returns to the altar for the prescribed purifications.',
                    'Après la distribution le célébrant retourne à l’autel pour les purifications prescrites.',
                    'RUBRIC_1962');
                if (options.faithfulCommunion !== false) add('SERVER',
                    'After distribution the Communion plate is returned to the altar.',
                    'Après la distribution le plateau de Communion est rapporté à l’autel.',
                    'CEREMONIAL_1962');
                add('SERVERS',
                    'The cruets are brought for the purifications; the Missal is restored to the Epistle side as the altar is reset.',
                    'Les burettes sont apportées pour les ablutions ; le Missel revient au côté de l’Épître pendant que l’autel est remis en ordre.',
                    'CEREMONIAL_IMPLEMENTATION');
                break;
            case 'postcommunion':
                next.priestPosition = 'Centre for Dominus vobiscum · then Epistle side at the Missal';
                add('PRIEST',
                    'At the centre the celebrant gives Dominus vobiscum, then goes to the Missal at the Epistle side for the Postcommunion prayer(s).',
                    'Au centre le célébrant donne Dominus vobiscum, puis se rend au Missel du côté de l’Épître pour la ou les Postcommunions.',
                    'RUBRIC_1962');
                break;
            case 'blessing':
                add('MUSIC',
                    'The organ and other instruments remain silent during the final blessing.',
                    'L’orgue et les autres instruments demeurent silencieux pendant la bénédiction finale.',
                    'MUSIC_LAW_1958');
                break;
            case 'last-gospel':
                add('PRIEST',
                    'The celebrant genuflects at Et Verbum caro factum est.',
                    'Le célébrant fait la génuflexion à Et Verbum caro factum est.',
                    'RUBRIC_1962');
                break;
        }
        if (cues.length) next.ceremonialCues = cues;
        return next;
    });
}


function applyExecutionStateClosure(steps, options, proper) {
    const sung = options.form === 'sung';
    const lector = sung && options.epistleMinister === 'lector';
    const seatLong = sung && options.longInterlectionSeating === true;
    const date = String(options.selectedDate || '');
    const properIdentity = [proper?.properId, proper?.sourcePath, proper?.name, proper?.nameFr].filter(Boolean).join(' · ');
    const incarnatusAllKneel = /-(?:12-25|03-25)$/.test(date) || /(?:^|\/)03-25(?:$|\D)/.test(properIdentity) || /Annuntiatio|Annunciation|Annonciation/i.test(properIdentity);
    return steps.map(step => {
        let next = { ...step };
        const cues = [...(next.ceremonialCues || [])];
        const add = (actor,en,fr,authority='CEREMONIAL_1962') => cues.push(ceremonialCue(actor,en,fr,authority));
        switch (step.id) {
            case 'gloria':
                if (sung) next.executionState = {
                    priest: ['PUBLIC_INTONATION','PRIVATE_RECITATION','MAY_SIT_WHILE_CHOIR_CONTINUES','RETURN_TO_ALTAR_FOR_COLLECT'],
                    choir: ['SUNG_GLORIA'],
                    completionTrigger: 'CHOIR_GLORIA_COMPLETE'
                };
                break;
            case 'epistle':
                next.epistleMinister = lector ? 'LECTOR' : 'CELEBRANT';
                next.celebrantDuplicate = false;
                if (lector) {
                    next.actor = 'lector';
                    next.priestPosition = 'Celebrant remains at altar / sedilia according to the ceremonial';
                    next.executionState = {lector:'PROCLAIMS_EPISTLE',celebrant:'NO_DUPLICATE_READING',server:'PREPARES_LATER_MISSAL_TRANSFER'};
                    add('LECTOR','The lector sings the Epistle. Under the 1962 rule the celebrant does not repeat a reading performed by the appointed minister.','Le lecteur chante l’Épître. Selon la règle de 1962, le célébrant ne répète pas une lecture accomplie par le ministre désigné.','RUBRIC_1962');
                    add('PRIEST','The celebrant does not duplicate the lector’s Epistle; he proceeds according to the Sung-Mass ceremonial.','Le célébrant ne répète pas l’Épître du lecteur ; il poursuit selon le cérémonial de la Messe chantée.','RUBRIC_1962');
                } else {
                    next.actor = 'celebrant';
                    next.priestPosition = 'Epistle side · celebrant reads or sings the Epistle';
                    next.executionState = {celebrant:'PROCLAIMS_EPISTLE',lector:'NOT_USED',server:'PREPARES_LATER_MISSAL_TRANSFER'};
                    if (sung) add('PRIEST','No lector is selected for this Mass; the celebrant himself performs the Epistle.','Aucun lecteur n’est sélectionné pour cette Messe ; le célébrant accomplit lui-même l’Épître.','CEREMONIAL_SESSION');
                }
                break;
            case 'gradual':
            case 'alleluia':
            case 'sequence':
                if (sung) {
                    next.interlectionState = {
                        celebrantPrivateReading: true,
                        choirIndependentExecution: true,
                        longChantDisposition: seatLong ? 'SEDILIA_OPTION_SELECTED' : 'REMAIN_AT_ALTAR_SELECTED',
                        returnForGospelPreparation: true
                    };
                    if (seatLong) {
                        next.priestPosition = 'Epistle side / altar → may sit at sedilia while the schola continues';
                        add('PRIEST','After his private reading, the celebrant may sit at the sedilia while a long interlection chant continues; he returns for the Gospel preparation.','Après sa lecture privée, le célébrant peut s’asseoir au siège pendant qu’un long chant entre les lectures se poursuit ; il revient pour la préparation de l’Évangile.','OCONNELL_1962_CEREMONIAL');
                    } else {
                        next.priestPosition = 'Epistle side / altar · remains at the altar while the schola continues';
                    }
                }
                break;
            case 'gospel-prep':
            case 'gospel-prep-requiem':
                if (sung) {
                    next.executionState = {celebrant:seatLong?'RETURN_FROM_SEDILIA_TO_CENTRE':'MOVE_TO_CENTRE',choir:'FINAL_INTERLECTION_MAY_STILL_BE_ENDING'};
                    if (seatLong) next.priestPosition = 'Sedilia → centre for Gospel preparation';
                }
                break;
            case 'credo':
                if (sung) {
                    next.incarnatusRule = {
                        celebrantPrivateRecitation:'GENUFLECT_AT_ET_INCARNATUS',
                        choirPassage:incarnatusAllKneel?'ALL_KNEEL':'STANDING_GENUFLECT_SEATED_BOW',
                        specialOccasion:incarnatusAllKneel?'CHRISTMAS_OR_ANNUNCIATION':null
                    };
                    add('PRIEST', incarnatusAllKneel
                        ? 'At the sung Et incarnatus on Christmas or the Annunciation, all kneel; the celebrant’s own private recitation retains its prescribed genuflection.'
                        : 'At the celebrant’s private Et incarnatus he genuflects. When the choir sings the passage, those standing genuflect while those seated bow.',
                        incarnatusAllKneel
                        ? 'À l’Et incarnatus chanté à Noël ou à l’Annonciation, tous s’agenouillent ; la récitation privée du célébrant conserve sa génuflexion prescrite.'
                        : 'À son Et incarnatus récité à voix basse, le célébrant fait la génuflexion. Lorsque le chœur chante le passage, ceux qui sont debout font la génuflexion tandis que ceux qui sont assis s’inclinent.',
                        'RUBRIC_1962');
                }
                break;
            case 'dismissal': {
                const sig = JSON.stringify([next.title,next.text,next.subtitle]);
                const altarFacing = /Requi[eé]scant|Benedic[aá]mus/i.test(sig);
                next.dismissalOrientation = altarFacing ? 'TOWARD_ALTAR' : 'TOWARD_PEOPLE';
                next.priestPosition = altarFacing ? 'Centre · altar-facing dismissal' : 'Centre · turns to the people for Ite, missa est';
                next.executionState = {greeting:'CENTRE',dismissal:next.dismissalOrientation,finalBlessingFollows:!altarFacing};
                break;
            }
            case 'placeat':
                next.privateAction = true;
                next.audibility = 'quiet';
                next.priestPosition = 'Centre · bowed at the altar';
                next.executionState = {celebrant:'PRIVATE_PLACEAT_AT_ALTAR'};
                break;
            case 'blessing':
                next.priestPosition = 'Centre · turns to the people for the blessing';
                next.executionState = {celebrant:['TURN_TO_PEOPLE','BLESS','TURN_BACK_TO_ALTAR'],music:'SILENT_DURING_BLESSING'};
                break;
            case 'last-gospel-announcement':
                next.priestPosition = 'Gospel side · prepares the Last Gospel';
                next.executionState = {celebrant:'MOVE_TO_GOSPEL_SIDE_AND_ANNOUNCE'};
                break;
            case 'last-gospel':
                next.priestPosition = 'Gospel side';
                next.executionState = {celebrant:['READ_LAST_GOSPEL','GENUFLECT_AT_ET_VERBUM_CARO_FACTUM_EST','COMPLETE_GOSPEL'],server:'RESPONDS'};
                break;
        }
        if (cues.length) next.ceremonialCues = cues;
        return next;
    });
}


const AO_COMPENDIUM_RECONCILIATION_V4340 = Object.freeze({"entrance-procession":{"sourceMomentRefs":["E01"],"canonicalEventRefs":["MC-PREP-010","MC-PREP-020","MC-PREP-030"]},"sign-cross":{"sourceMomentRefs":["E03"],"canonicalEventRefs":["MC-FOOT-010"]},"judica":{"sourceMomentRefs":["E03"],"canonicalEventRefs":["MC-FOOT-020"]},"adjutorium":{"sourceMomentRefs":["E03"],"canonicalEventRefs":["MC-FOOT-030"]},"priest-confiteor":{"sourceMomentRefs":["E04"],"canonicalEventRefs":["MC-FOOT-040","MC-FOOT-050"]},"ministers-confiteor":{"sourceMomentRefs":["E05"],"canonicalEventRefs":["MC-FOOT-060"]},"misereatur-vestri":{"sourceMomentRefs":["E05"],"canonicalEventRefs":["MC-FOOT-070"]},"indulgentiam-absolution":{"sourceMomentRefs":["E05"],"canonicalEventRefs":["MC-FOOT-070"]},"foot-versicles":{"sourceMomentRefs":["E05","E06"],"canonicalEventRefs":[]},"ascend":{"sourceMomentRefs":["E06"],"canonicalEventRefs":["MC-ALT-010","MC-ALT-020"]},"oramus-te":{"sourceMomentRefs":["E06"],"canonicalEventRefs":["MC-ALT-030"]},"incense-entrance":{"sourceMomentRefs":["E07"],"canonicalEventRefs":["MC-ALT-040"]},"introit":{"sourceMomentRefs":["E08"],"canonicalEventRefs":["MC-INT-010","MC-INT-020","MC-INT-030"]},"kyrie":{"sourceMomentRefs":["E09"],"canonicalEventRefs":["MC-KYR-010","MC-KYR-020","MC-KYR-030"]},"gloria":{"sourceMomentRefs":["E10"],"canonicalEventRefs":["MC-GLR-010","MC-GLR-020","MC-GLR-030","MC-GLR-040","MC-GLR-050","MC-GLR-060"]},"collect":{"sourceMomentRefs":["E11"],"canonicalEventRefs":["MC-COL-010","MC-COL-020","MC-COL-030"]},"epistle":{"sourceMomentRefs":["E12"],"canonicalEventRefs":["MC-EPI-010","MC-EPI-020","MC-EPI-030"]},"gradual":{"sourceMomentRefs":["E13"],"canonicalEventRefs":["MC-CHANT-010","MC-CHANT-020"]},"alleluia":{"sourceMomentRefs":["E14"],"canonicalEventRefs":["MC-CHANT-030","MC-CHANT-040"]},"sequence":{"sourceMomentRefs":["E15"],"canonicalEventRefs":["MC-CHANT-050"]},"gospel-prep":{"sourceMomentRefs":["E16"],"canonicalEventRefs":["MC-GSP-010","MC-GSP-020","MC-GSP-03