function applyCompendiumReconciliationMetadata(steps) {
    return steps.map(step => {
        const rec = AO_COMPENDIUM_RECONCILIATION_V4340[step.id];
        if (!rec) return step;
        return { ...step, sourceMomentRefs:[...rec.sourceMomentRefs], canonicalEventRefs:[...rec.canonicalEventRefs], canonicalIdentityPolicy:'E_SOURCE_MOMENT_TO_MC_EVENT_GRAPH', prototypeTraversalCanonical:false };
    });
}


function insertHomilyRuntimeState(steps) {
    if (steps.some(step => step.id === 'homily')) return steps;
    const idx = steps.findIndex(step => step.id === 'gospel');
    if (idx < 0) return steps;
    const step = {
        id:'homily', phase:'Mass of the Catechumens', section:'Homily / sermon',
        title:{lat:'Homilia / Sermo',en:'Homily / sermon (if given)',fr:'Homélie / sermon (s’il y en a un)'},
        subtitle:{en:'Optional open-ended synchronization state',fr:'État de synchronisation facultatif et ouvert'},
        actor:'preacher', priestPosition:'Place of preaching', audibility:'audible', privateAction:false,
        posture:{value:'SIT',policy:'custom',source:'traditional-lay-practice'}, gestures:[],
        text:null, skippable:true, openEnded:true, runtimeOnly:true, reviewStatus:'PROVISIONAL',
        explanation:'If a homily or sermon is given, remain on this state until it ends. This is a synchronization state, not a fixed text of the Ordinary and not a separate E01–E71 source moment.'
    };
    return [...steps.slice(0, idx + 1), step, ...steps.slice(idx + 1)];
}

function insertSuperPopulum(steps, proper, properAvailable) {
    const text = properAvailable ? (0, ordinary_1.normaliseText3)(proper?.superPopulum) : undefined;
    if (!text)
        return steps;
    const idx = steps.findIndex(step => step.id === "postcommunion");
    if (idx < 0)
        return steps;
    const step = {
        id: "super-populum",
        phase: "Conclusion",
        section: "Postcommunion",
        title: { lat: "Oratio super populum", en: "Prayer over the People", fr: "Oraison sur le peuple" },
        actor: "celebrant",
        audibility: "audible",
        privateAction: false,
        text,
        properSlot: "superPopulum",
        properStatus: "ready",
    };
    return [...steps.slice(0, idx + 1), step, ...steps.slice(idx + 1)];
}
function buildMassSequence(options) {
    const proper = options.proper || null;
    const properAvailable = options.properAvailable !== false && !!proper;
    let steps = clone(options.form === "sung" ? sungTemplate : lowTemplate);
    steps = filterOrdinarySteps(steps, options, proper);
    steps = insertSequenceStep(steps, options, proper);
    steps = steps.map(step => attachProper(step, proper, properAvailable));
    steps = insertSuperPopulum(steps, proper, properAvailable);
    if (options.exceptionalProfile)
        steps = (0, exceptional_days_1.applyExceptionalProfile)(steps, options.exceptionalProfile, options.form, proper);
    steps = insertEntranceProcession(steps, options, proper, properAvailable);
    steps = insertHomilyRuntimeState(steps);
    steps = applySungSynchronization(steps, options, proper);
    steps = applyAudibilityAndEarlyCeremonialRepair(steps, options);
    steps = applyCeremonialGranularity(steps, options);
    steps = applyExecutionStateClosure(steps, options, proper);
    steps = applyCompendiumReconciliationMetadata(steps);
    return {
        form: options.form,
        properName: proper?.name,
        properStatus: properAvailable ? "ready" : "unavailable",
        steps,
    };
}
function properUnavailableText() {
    return clone(PROPER_UNAVAILABLE_TITLE);
}

},28:function(module,exports,require){module.exports=[{"id":"sign-cross","phase":"Mass of the Catechumens","section":"Prayers at the Foot","title":{"en":"Sign of the Cross · Introibo","fr":"Signe de la Croix · Introibo"},"subtitle":{"en":"At the foot of the altar","fr":"Au bas de l’autel"},"actor":"celebrant","priestPosition":"Foot of the altar","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"gestures":[{"kind":"cross","label":"Sign of the cross","anchorLat":"In nómine Patris","anchorEng":"In the Name of the Father","before":true,"status":"custom"}],"explanation":"The celebrant begins below the altar with the sign of the cross, then says Introibo ad altare Dei; the ministers answer Ad Deum qui laetificat iuventutem meam. At a Sung Mass the choir may already be singing the Introit.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"In nómine Patris, ✠ et Fílii, et Spíritus Sancti. Amen.\n\n℣. Introíbo ad altáre Dei.\n℟. Ad Deum, qui lætíficat iuventútem meam.","en":"In the Name of the Father, ✠ and of the Son, and of the Holy Ghost. Amen.\n\n℣. I will go in unto the altar of God.\n℟. Unto God, Who giveth joy to my youth.","fr":"Au nom du Père, ✠ et du Fils, et du Saint-Esprit. Ainsi soit-il."},"concurrentProperChoir":"introit"},{"id":"judica","phase":"Mass of the Catechumens","section":"Prayers at the Foot","title":{"en":"Psalm 42 · Judica me","fr":"Psaume 42 · Judica me"},"subtitle":{"en":"Priest and ministers alternate the psalm","fr":"Le prêtre et les ministres alternent le psaume"},"actor":"mixed","priestPosition":"Foot of the altar","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The priest and ministers alternate Psalm 42, then repeat Introibo / Ad Deum. The psalm is omitted in Masses for the Dead and from Passion Sunday through Holy Saturday.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Ps 42, 1-5\nS. Iúdica me, Deus, et discérne causam meam de gente non sancta: ab hómine iníquo et dolóso érue me.\nM. Quia tu es, Deus, fortitudo mea: quare me reppulísti, et quare tristis incédo, dum afflígit me inimícus?\nS. Emítte lucem tuam et veritátem tuam: ipsa me deduxérunt, et adduxérunt in montem sanctum tuum et in tabernácula tua.\nM. Et introíbo ad altáre Dei: ad Deum, qui lætíficat iuventútem meam.\nS. Confitébor tibi in cíthara, Deus, Deus meus: quare tristis es, ánima mea, et quare contúrbas me?\nM. Spera in Deo, quóniam adhuc confitébor illi: salutáre vultus mei, et Deus meus.\nS. Glória Patri, et Fílio, et Spirítui Sancto.\nM. Sicut erat in princípio, et nunc, et semper: et in saecula sæculórum. Amen.\n\n℣. Introíbo ad altáre Dei.\n℟. Ad Deum, qui lætíficat iuventútem meam.","en":"Ps 42, 1-5\nS. Judge me, O God, and distinguish my cause from the nation that is not holy: deliver me from the unjust and deceitful man.\nM. For Thou, O God, art my strength: why hast Thou cast me off? and why do I go sorrowful whilst the enemy afflicteth me?\nS. Send forth Thy light and Thy truth: they have led me and brought me unto Thy holy hill, and into Thy tabernacles.\nM. And I will go in unto the Altar of God: unto God, Who giveth joy to my youth.\nS. I will praise Thee upon the harp, O God, my God: why art thou sad, O my soul? and why dost thou disquiet me?\nM. Hope thou in God, for I will yet praise Him: Who is the salvation of my countenance, and my God.\nS. Glory be to the Father, and to the Son, and to the Holy Ghost.\nM. As it was in the beginning, is now, and ever shall be, world without end. Amen.\n\n℣. I will go in unto the altar of God.\n℟. Unto God, Who giveth joy to my youth.","fr":"Ps 42, 1-5\nS. Jugez-moi, ô Dieu, et séparez ma cause de celle d’un peuple impie ; délivrez-moi de l’homme injuste et trompeur.\nM. Car vous êtes, ô Dieu, ma force : pourquoi m’avez-vous repoussé ? et pourquoi dois-je marcher dans la tristesse, tandis que l’ennemi m’afflige ?\nS. Envoyez votre lumière et votre vérité : elles m’ont conduit et amené à votre montagne sainte et dans vos tabernacles.\nM. Et j’irai vers l’autel de Dieu : vers Dieu qui réjouit ma jeunesse.\nS. Je vous louerai sur la harpe, ô Dieu, mon Dieu. Pourquoi es-tu triste, ô mon âme, et pourquoi me troubles-tu ?\nM. Espère en Dieu, car je le louerai encore : lui, le salut de mon visage et mon Dieu.\nS. Gloire au Père, et au Fils, et au Saint-Esprit.\nM. Comme il était au commencement, maintenant et toujours, et dans les siècles des siècles. Ainsi soit-il."},"concurrentProperChoir":"introit"},{"id":"adjutorium","phase":"Mass of the Catechumens","section":"Prayers at the Foot","title":{"en":"Adjutorium nostrum","fr":"Adjutorium nostrum"},"subtitle":{"en":"Our help is in the Name of the Lord","fr":"Notre secours est dans le Nom du Seigneur"},"actor":"mixed","priestPosition":"Foot of the altar","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"gestures":[{"kind":"cross","label":"Sign of the cross","anchorLat":"Adiutórium nostrum ✠","anchorEng":"Our help ✠","before":true,"status":"custom"}],"explanation":"The priest says Adiutorium nostrum in nomine Domini and the ministers answer Qui fecit caelum et terram. The printed ✠ marks the traditional sign of the cross.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"℣. Adiutórium nostrum ✠ in nómine Dómini.\n℟. Qui fecit coelum et terram.","en":"℣. Our help ✠ is in the Name of the Lord.\n℟. Who hath made heaven and earth.","fr":"℣. Notre secours ✠ est dans le nom du Seigneur.\n℟. Qui a fait le ciel et la terre."},"concurrentProperChoir":"introit"},{"id":"priest-confiteor","phase":"Mass of the Catechumens","section":"Prayers at the Foot","title":{"en":"Confiteor of the Priest","fr":"Confiteor du prêtre"},"subtitle":{"en":"The celebrant confesses first","fr":"Le célébrant se confesse en premier"},"actor":"celebrant","priestPosition":"Foot of the altar","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The celebrant makes the first Confiteor, saying et vobis, fratres. The ministers answer Misereatur tui; the priest replies Amen.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"[ROLE=PRIEST]\nConfíteor Deo omnipoténti, beátæ Maríæ semper Vírgini, beáto Michaéli Archángelo, beáto Ioánni Baptístæ,\nsanctis Apóstolis Petro et Paulo, ómnibus Sanctis, et vobis, fratres: quia peccávi nimis cogitatióne, verbo et opere:\nmea culpa, mea culpa, mea máxima culpa. Ideo precor beátam Maríam semper Vírginem, beátum Michaélem Archángelum,\nbeátum Ioánnem Baptístam, sanctos Apóstolos Petrum et Paulum, omnes Sanctos, et vos, fratres,\noráre pro me ad Dóminum Deum nostrum.\n[/ROLE]\n\n[ROLE=MINISTERS]\nMisereátur tui omnípotens Deus, et, dimíssis peccátis tuis, perdúcat te ad vitam ætérnam.\n[/ROLE]\n\n[ROLE=PRIEST]\nAmen.\n[/ROLE]","en":"[ROLE=PRIEST]\nI confess to almighty God, to blessed Mary ever Virgin, to blessed Michael the Archangel, to blessed John the Baptist,\nto the holy Apostles Peter and Paul, to all the Saints, and to you, brethren, that I have sinned exceedingly in thought,\nword and deed: through my fault, through my fault, through my most grievous fault. Therefore I beseech blessed Mary ever Virgin,\nblessed Michael the Archangel, blessed John the Baptist, the holy Apostles Peter and Paul, all the Saints, and you, brethren,\nto pray to the Lord our God for me.\n[/ROLE]\n\n[ROLE=MINISTERS]\nMay Almighty God have mercy upon you, forgive you your sins, and bring you to life everlasting.\n[/ROLE]\n\n[ROLE=PRIEST]\nAmen.\n[/ROLE]","fr":"[ROLE=PRIEST]\nJe confesse à Dieu tout-puissant, à la bienheureuse Marie toujours Vierge, à saint Michel Archange, à saint Jean-Baptiste, aux saints Apôtres Pierre et Paul, à tous les saints, et à vous, mes frères, que j’ai beaucoup péché par pensée, par parole et par action : c’est ma faute, c’est ma faute, c’est ma très grande faute. C’est pourquoi je supplie la bienheureuse Marie toujours Vierge, saint Michel Archange, saint Jean-Baptiste, les saints Apôtres Pierre et Paul, tous les saints, et vous, mes frères, de prier pour moi le Seigneur notre Dieu.\n[/ROLE]\n\n[ROLE=MINISTERS]\nQue Dieu tout-puissant vous fasse miséricorde, qu’il vous pardonne vos péchés et vous conduise à la vie éternelle.\n[/ROLE]\n\n[ROLE=PRIEST]\nAinsi soit-il.\n[/ROLE]"},"concurrentProperChoir":"introit"},{"id":"ministers-confiteor","phase":"Mass of the Catechumens","section":"Prayers at the Foot","title":{"en":"Confiteor of the Ministers","fr":"Confiteor des ministres"},"subtitle":{"en":"The ministers confess before the priest","fr":"Les ministres se confessent devant le prêtre"},"actor":"mixed","priestPosition":"Foot of the altar","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"gestures":[{"kind":"action","label":"Strike breast ×3","anchorLat":"mea culpa, mea culpa, mea máxima culpa","anchorEng":"through my fault, through my fault, through my most grievous fault","before":true,"status":"custom"}],"explanation":"The ministers make the second Confiteor at the foot of the altar, using et tibi, pater. The priest then answers with the prayers of mercy in the following distinct moments.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"[ROLE=MINISTERS]\nConfíteor Deo omnipoténti, beátæ Maríæ semper Vírgini, beáto Michaéli Archángelo, beáto Ioánni Baptístæ, sanctis Apóstolis Petro et Paulo, ómnibus Sanctis, et tibi, pater: quia peccávi nimis cogitatióne, verbo et opere: mea culpa, mea culpa, mea máxima culpa. Ideo precor beátam Maríam semper Vírginem, beátum Michaélem Archángelum, beátum Ioánnem Baptístam, sanctos Apóstolos Petrum et Paulum, omnes Sanctos, et te, pater, orare pro me ad Dóminum, Deum nostrum.\n[/ROLE]","en":"[ROLE=MINISTERS]\nI confess to Almighty God, to blessed Mary ever Virgin, to blessed Michael the Archangel, to blessed John the Baptist, to the holy Apostles Peter and Paul, to all the Saints, and to you Father, that I have sinned exceedingly, in thought, word and deed: through my fault, through my fault, through my most grievous fault. Therefore I beseech blessed Mary ever Virgin, blessed Michael the Archangel, blessed John the Baptist, the holy Apostles Peter and Paul, all the Saints, and Thee Father, to pray to the Lord our God for me.\n[/ROLE]","fr":"[ROLE=MINISTERS]\nJe confesse à Dieu tout-puissant, à la bienheureuse Marie toujours Vierge, à saint Michel Archange, à saint Jean-Baptiste, aux saints Apôtres Pierre et Paul, à tous les saints, et à vous, mon Père, que j’ai beaucoup péché par pensée, par parole et par action : c’est ma faute, c’est ma faute, c’est ma très grande faute. C’est pourquoi je supplie la bienheureuse Marie toujours Vierge, saint Michel Archange, saint Jean-Baptiste, les saints Apôtres Pierre et Paul, tous les saints, et vous, mon Père, de prier pour moi le Seigneur notre Dieu.\n[/ROLE]"},"concurrentProperChoir":"introit"},{"id":"misereatur-vestri","phase":"Mass of the Catechumens","section":"Preparation","title":{"en":"Misereatur vestri","fr":"Misereatur vestri"},"subtitle":{"en":"Prayer of mercy after the ministers’ Confiteor","fr":"Prière de miséricorde après le Confiteor des ministres"},"actor":"celebrant","priestPosition":"Foot of the altar","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The priest prays that Almighty God may have mercy, forgive sins and lead the ministers and faithful to everlasting life; the ministers answer Amen.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"[ROLE=PRIEST]\nMisereátur vestri omnípotens Deus, et, dimíssis peccátis vestris, perdúcat vos ad vitam ætérnam.\n[/ROLE]\n\n[ROLE=MINISTERS]\nAmen.\n[/ROLE]","en":"[ROLE=PRIEST]\nMay Almighty God have mercy upon you, forgive you your sins and bring you to life everlasting.\n[/ROLE]\n\n[ROLE=MINISTERS]\nAmen.\n[/ROLE]","fr":"[ROLE=PRIEST]\nQue Dieu tout-puissant vous fasse miséricorde, qu’il vous pardonne vos péchés et vous conduise à la vie éternelle.\n[/ROLE]\n\n[ROLE=MINISTERS]\nAinsi soit-il.\n[/ROLE]"},"concurrentProperChoir":"introit"},{"id":"indulgentiam-absolution","phase":"Mass of the Catechumens","section":"Preparation","title":{"en":"Indulgentiam · Absolution","fr":"Indulgentiam · Absolution"},"subtitle":{"en":"Pardon, absolution and remission of sins","fr":"Pardon, absolution et rémission des péchés"},"actor":"celebrant","priestPosition":"Foot of the altar","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"gestures":[{"kind":"cross","label":"Sign of the cross","anchorLat":"Indulgéntiam","anchorEng":"May the Almighty and merciful God","before":true,"status":"custom"}],"explanation":"The priest says Indulgentiam, asking the Almighty and merciful Lord for pardon, absolution and remission of sins. This is the liturgical prayer at the foot of the altar, not sacramental absolution in Confession.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"[ROLE=PRIEST]\nIndulgéntiam, ✠ absolutionem et remissiónem peccatórum nostrórum tríbuat nobis omnípotens et miséricors Dóminus.\n[/ROLE]\n\n[ROLE=MINISTERS]\nAmen.\n[/ROLE]","en":"[ROLE=PRIEST]\nMay the Almighty and merciful God grant us pardon, ✠ absolution, and remission of our sins.\n[/ROLE]\n\n[ROLE=MINISTERS]\nAmen.\n[/ROLE]","fr":"[ROLE=PRIEST]\nQue le Dieu tout-puissant et miséricordieux nous accorde le pardon, ✠ l’absolution et la rémission de nos péchés.\n[/ROLE]\n\n[ROLE=MINISTERS]\nAinsi soit-il.\n[/ROLE]"},"concurrentProperChoir":"introit"},{"id":"foot-versicles","phase":"Mass of the Catechumens","section":"Preparation","title":{"en":"Versicles before the Ascent","fr":"Versets avant la montée à l’autel"},"subtitle":{"en":"Deus, tu conversus · Ostende nobis · Domine, exaudi","fr":"Deus, tu conversus · Ostende nobis · Domine, exaudi"},"actor":"celebrant","priestPosition":"Foot of the altar","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The priest and ministers exchange the concluding versicles of the prayers at the foot, ending with Dominus vobiscum / Et cum spiritu tuo and Oremus before the priest ascends the altar.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"℣. Deus, tu convérsus vivificábis nos.\n℟. Et plebs tua lætábitur in te.\n℣. Osténde nobis, Dómine, misericórdiam tuam.\n℟. Et salutáre tuum da nobis.\n℣. Dómine, exáudi oratiónem meam.\n℟. Et clamor meus ad te véniat.\n℣. Dóminus vobíscum.\n℟. Et cum spíritu tuo.\n℣. Orémus.","en":"℣. Thou wilt turn, O God, and bring us to life.\n℟. And Thy people shall rejoice in Thee.\n℣. Show us, O Lord, Thy mercy.\n℟. And grant us Thy salvation.\n℣. O Lord, hear my prayer.\n℟. And let my cry come unto Thee.\n℣. The Lord be with you.\n℟. And with thy spirit.\n℣. Let us pray.","fr":"℣. Ô Dieu, vous vous retournerez vers nous et vous nous rendrez la vie.\n℟. Et votre peuple se réjouira en vous.\n℣. Montrez-nous, Seigneur, votre miséricorde.\n℟. Et donnez-nous votre salut.\n℣. Seigneur, exaucez ma prière.\n℟. Et que mon cri parvienne jusqu’à vous.\n℣. Le Seigneur soit avec vous.\n℟. Et avec votre esprit.\n℣. Prions."},"concurrentProperChoir":"introit"},{"id":"ascend","phase":"Mass of the Catechumens","section":"Prayers at the Foot","title":{"en":"The priest ascends the altar","fr":"Le prêtre monte à l’autel"},"subtitle":{"en":"Aufer a nobis","fr":"Aufer a nobis"},"actor":"mixed","priestPosition":"Steps of the altar","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The celebrant asks that his sins be taken away as he ascends to the altar.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Aufer a nobis, quaesumus, Dómine, iniquitátes nostras: ut ad Sancta sanctórum puris mereámur méntibus introíre. Per Christum, Dóminum nostrum. Amen.","en":"Take away from us our iniquities, we entreat Thee, O Lord, that with pure minds we may worthily enter into the Holy of Holies. Through Christ our Lord. Amen.","fr":"Enlevez de nous nos iniquités, nous vous en supplions, Seigneur, afin que nous méritions d’entrer avec une âme pure dans le Saint des saints. Par le Christ notre Seigneur. Ainsi soit-il."},"concurrentProperChoir":"introit"},{"id":"oramus-te","phase":"Mass of the Catechumens","section":"Prayers at the Foot","title":{"en":"Prayer at the Altar","fr":"Prière à l’autel"},"subtitle":{"en":"Oramus te, Domine","fr":"Oramus te, Domine"},"actor":"mixed","priestPosition":"Centre of the altar","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"At the altar the celebrant asks pardon through the merits of the saints whose relics are enclosed there, and kisses the altar.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Orámus te, Dómine, per mérita Sanctórum tuórum, quorum relíquiæ hic sunt, et ómnium Sanctórum: ut indulgére dignéris ómnia peccáta mea. Amen.","en":"We beseech Thee, O Lord, by the merits of Thy Saints, whose relics are here and of all the Saints, that Thou wilt deign to pardon me all my sins. Amen.","fr":"Nous vous prions, Seigneur, par les mérites de vos saints dont les reliques sont ici, et de tous les saints, de daigner me pardonner tous mes péchés. Ainsi soit-il."},"concurrentProperChoir":"introit"},{"id":"incense-entrance","phase":"Mass of the Catechumens","section":"Entrance","title":{"en":"Incensation of the Altar","fr":"Encensement de l’autel"},"subtitle":{"en":"At the beginning of Sung Mass","fr":"Au début de la Messe chantée"},"actor":"celebrant","priestPosition":"Altar","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"After kissing the altar, the celebrant blesses the incense and incenses the altar. The schola may still be singing the Introit.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Ab illo benedicáris, ✠ in cuius honóre cremáberis. Amen.","en":"May you be blessed ✠ by Him in whose honour you shall be burned. Amen.","fr":"Soyez béni ✠ par celui en l’honneur de qui vous allez brûler. Ainsi soit-il."},"concurrentProperChoir":"introit"},{"id":"introit","phase":"Mass of the Catechumens","section":"Entrance","title":{"en":"Introit","fr":"Introït"},"subtitle":{"en":"Proper of the day","fr":"Propre du jour"},"actor":"mixed","priestPosition":"Epistle side","audibility":"mixed","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The entrance antiphon gives the Mass its opening scriptural text. In a Sung Mass the choir’s chant and the celebrant’s recitation are parallel actions.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","properSlot":"introit","concurrentProperChoir":"introit"},{"id":"kyrie","phase":"Mass of the Catechumens","section":"Entrance","title":{"en":"Kyrie eleison","fr":"Kyrie eleison"},"subtitle":{"en":"Ninefold plea for mercy","fr":"Neuf invocations de miséricorde"},"actor":"mixed","priestPosition":"Epistle side / centre","audibility":"choir","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The Kyrie is a ninefold invocation for mercy, recited or sung in Greek.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Kýrie, eléison. (3×)\nChriste, eléison. (3×)\nKýrie, eléison. (3×)","en":"Lord, have mercy. (3×)\nChrist, have mercy. (3×)\nLord, have mercy. (3×)","fr":"Seigneur, ayez pitié. (3×)\nChrist, ayez pitié. (3×)\nSeigneur, ayez pitié. (3×)"},"choir":[{"id":"kyrie-choir","text":{"lat":"Kýrie, eléison. (3×)\nChriste, eléison. (3×)\nKýrie, eléison. (3×)","en":"Lord, have mercy. (3×)\nChrist, have mercy. (3×)\nLord, have mercy. (3×)","fr":"Seigneur, ayez pitié. (3×)\nChrist, ayez pitié. (3×)\nSeigneur, ayez pitié. (3×)"},"timing":"simultaneous"}]},{"id":"gloria","phase":"Mass of the Catechumens","section":"Entrance","title":{"en":"Gloria in excelsis Deo","fr":"Gloria in excelsis Deo"},"subtitle":{"en":"Hymn of praise","fr":"Hymne de louange"},"actor":"mixed","priestPosition":"Centre","audibility":"mixed","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"gestures":[{"kind":"cross","label":"Sign of the cross","anchorLat":"Cum Sancto Spíritu","anchorEng":"With the Holy Ghost","before":true,"status":"custom"}],"explanation":"The Gloria is a festal hymn beginning with the angels’ song at Bethlehem. At its conclusion, Cum Sancto Spiritu, the sign of the cross is customarily made.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Glória in excélsis Deo. Et in terra pax homínibus bonæ voluntátis. Laudámus te. Benedícimus te. Adorámus te. Glorificámus te. Grátias ágimus tibi propter magnam glóriam tuam. Dómine Deus, Rex cæléstis, Deus Pater omnípotens. Dómine Fili unigénite, Iesu Christe. Dómine Deus, Agnus Dei, Fílius Patris. Qui tollis peccáta mundi, miserére nobis. Qui tollis peccáta mundi, súscipe deprecatiónem nostram. Qui sedes ad déxteram Patris, miserére nobis. Quóniam tu solus Sanctus. Tu solus Dóminus. Tu solus Altíssimus, Iesu Christe. Cum Sancto Spíritu ✠ in glória Dei Patris. Amen.","en":"Glory to God in the highest. And on earth peace to men of good will. We praise Thee; we bless Thee; we adore Thee; we glorify Thee; we give Thee thanks for Thy great glory. Lord God, heavenly King, God the Father almighty. Lord Jesus Christ, only-begotten Son. Lord God, Lamb of God, Son of the Father. Thou who takest away the sins of the world, have mercy on us. Thou who takest away the sins of the world, receive our prayer. Thou who sittest at the right hand of the Father, have mercy on us. For Thou alone art holy; Thou alone art Lord; Thou alone art the Most High, Jesus Christ. With the Holy Ghost ✠ in the glory of God the Father. Amen.","fr":"GLOIRE À DIEU au plus haut des cieux. Et paix sur la terre aux hommes de bonne volonté. Nous vous louons. Nous vous bénissons. Nous vous adorons. Nous vous glorifions. Nous vous rendons grâces pour votre immense gloire. Seigneur Dieu, Roi du ciel, Dieu le Père tout-puissant. Seigneur Fils unique, Jésus-Christ. Seigneur Dieu, Agneau de Dieu, Fils du Père. Vous qui enlevez les péchés du monde, ayez pitié de nous. Vous qui enlevez les péchés du monde, accueillez notre prière. Vous qui êtes assis à la droite du Père, ayez pitié de nous. Car vous seul êtes Saint, vous seul êtes Seigneur, vous seul êtes le Très-Haut, Jésus-Christ, avec le Saint-Esprit ✠ dans la gloire de Dieu le Père. Ainsi soit-il."},"choir":[{"id":"gloria-choir","text":{"lat":"Glória in excélsis Deo. Et in terra pax homínibus bonæ voluntátis. Laudámus te. Benedícimus te. Adorámus te. Glorificámus te. Grátias ágimus tibi propter magnam glóriam tuam. Dómine Deus, Rex cæléstis, Deus Pater omnípotens. Dómine Fili unigénite, Iesu Christe. Dómine Deus, Agnus Dei, Fílius Patris. Qui tollis peccáta mundi, miserére nobis. Qui tollis peccáta mundi, súscipe deprecatiónem nostram. Qui sedes ad déxteram Patris, miserére nobis. Quóniam tu solus Sanctus. Tu solus Dóminus. Tu solus Altíssimus, Iesu Christe. Cum Sancto Spíritu ✠ in glória Dei Patris. Amen.","en":"Glory to God in the highest. And on earth peace to men of good will. We praise Thee; we bless Thee; we adore Thee; we glorify Thee; we give Thee thanks for Thy great glory. Lord God, heavenly King, God the Father almighty. Lord Jesus Christ, only-begotten Son. Lord God, Lamb of God, Son of the Father. Thou who takest away the sins of the world, have mercy on us. Thou who takest away the sins of the world, receive our prayer. Thou who sittest at the right hand of the Father, have mercy on us. For Thou alone art holy; Thou alone art Lord; Thou alone art the Most High, Jesus Christ. With the Holy Ghost ✠ in the glory of God the Father. Amen.","fr":"GLOIRE À DIEU au plus haut des cieux. Et paix sur la terre aux hommes de bonne volonté. Nous vous louons. Nous vous bénissons. Nous vous adorons. Nous vous glorifions. Nous vous rendons grâces pour votre immense gloire. Seigneur Dieu, Roi du ciel, Dieu le Père tout-puissant. Seigneur Fils unique, Jésus-Christ. Seigneur Dieu, Agneau de Dieu, Fils du Père. Vous qui enlevez les péchés du monde, ayez pitié de nous. Vous qui enlevez les péchés du monde, accueillez notre prière. Vous qui êtes assis à la droite du Père, ayez pitié de nous. Car vous seul êtes Saint, vous seul êtes Seigneur, vous seul êtes le Très-Haut, Jésus-Christ, avec le Saint-Esprit ✠ dans la gloire de Dieu le Père. Ainsi soit-il."},"timing":"simultaneous"}]},{"id":"collect","phase":"Mass of the Catechumens","section":"Collect & Readings","title":{"en":"Collect","fr":"Collecte"},"subtitle":{"en":"Proper prayer","fr":"Prière propre"},"actor":"celebrant","priestPosition":"Epistle side","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"Dóminus vobíscum","explanation":"The Collect gathers the Church’s prayer into the proper oration of the day; additional orations may be joined when commemorations are prescribed.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","properSlot":"collects"},{"id":"epistle","phase":"Mass of the Catechumens","section":"Collect & Readings","title":{"en":"Epistle or Lesson","fr":"Épître ou Lecture"},"subtitle":{"en":"Proper reading","fr":"Lecture propre"},"actor":"celebrant","priestPosition":"Epistle side","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The first scriptural reading. It may come from an Epistle or another book of Scripture. Deo gratias is the response.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","properSlot":"epistle"},{"id":"gradual","phase":"Mass of the Catechumens","section":"Collect & Readings","title":{"en":"Gradual","fr":"Graduel"},"subtitle":{"en":"Proper chant","fr":"Chant propre"},"actor":"choir","priestPosition":"Altar","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"This proper chant follows the Lesson in the order supplied by the 1962 Proper. At Low Mass it is read aloud by the celebrant; at Sung Mass the schola's chant provides the audible track.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","properSlot":"preGospelChants"},{"id":"alleluia","phase":"Mass of the Catechumens","section":"Collect & Readings","title":{"en":"Alleluia","fr":"Alleluia"},"subtitle":{"en":"Proper chant","fr":"Chant propre"},"actor":"choir","priestPosition":"Altar","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"This proper chant follows the Lesson in the order supplied by the 1962 Proper. At Low Mass it is read aloud by the celebrant; at Sung Mass the schola's chant provides the audible track.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","properSlot":"preGospelChants"},{"id":"gospel-prep","phase":"Mass of the Catechumens","section":"Gospel & Creed","title":{"en":"Preparation for the Gospel","fr":"Préparation à l’Évangile"},"subtitle":{"en":"Munda cor meum · Iube, Domine","fr":"Munda cor meum · Iube, Domine"},"actor":"mixed","priestPosition":"Centre","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The celebrant prepares for the Gospel while the chant may still be continuing.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Munda cor meum ac lábia mea, omnípotens Deus, qui lábia Isaíæ Prophétæ cálculo mundásti igníto:\nita me tua grata miseratióne dignáre mundáre, ut sanctum Evangélium tuum digne váleam nuntiáre.\nPer Christum Dóminum nostrum. Amen.\n\nIube, Dómine, benedícere. Dóminus sit in corde meo et in lábiis meis:\nut digne et competénter annúntiem Evangélium suum. Amen.","en":"Cleanse my heart and my lips, O almighty God, Who didst cleanse the lips of the prophet Isaias with a burning coal:\nthrough Thy gracious mercy so purify me that I may worthily proclaim Thy holy Gospel. Through Christ our Lord. Amen.\n\nGrant, O Lord, Thy blessing. May the Lord be in my heart and on my lips,\nthat I may worthily and fittingly proclaim His Gospel. Amen.","fr":"Purifiez mon cœur et mes lèvres, Dieu tout-puissant, qui avez purifié les lèvres du prophète Isaïe avec un charbon ardent ; daignez aussi me purifier par votre miséricordieuse bonté, afin que je puisse proclamer dignement votre saint Évangile. Par le Christ notre Seigneur. Ainsi soit-il.\n\nSeigneur, veuillez me bénir. Que le Seigneur soit dans mon cœur et sur mes lèvres, afin que j’annonce dignement et convenablement son Évangile. Ainsi soit-il."},"concurrentProperChoir":"preGospelChants"},{"id":"gospel-announcement","phase":"Mass of the Catechumens","section":"Gospel & Creed","title":{"en":"Gospel Announcement","fr":"Annonce de l’Évangile"},"subtitle":{"en":"Dominus vobiscum · Sequentia sancti Evangelii","fr":"Dominus vobiscum · Sequentia sancti Evangelii"},"actor":"celebrant","priestPosition":"Gospel side","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"gestures":[{"kind":"cross","label":"Forehead · lips · breast","anchorLat":"Sequéntia ✠ sancti Evangélii secúndum Lucam.","anchorEng":"Continuation ✠ of the Holy Gospel according to Luke","before":true,"status":"custom"}],"landmark":"Dóminus vobíscum","explanation":"The Gospel is announced with Dominus vobiscum, its title, and Gloria tibi, Domine before the text is proclaimed.","customNote":"The Pilgrim’s Booklet directs the faithful to make the three small Gospel crosses on forehead, lips and breast. Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"℣. Dóminus vobíscum.\n℟. Et cum spíritu tuo.\n\nSequéntia ✠ sancti Evangélii secúndum Lucam.\n\n℟. Glória tibi, Dómine.","en":"℣. The Lord be with you.\n℟. And with thy spirit.\n\nContinuation ✠ of the Holy Gospel according to Luke\n\n℟. Glory be to Thee, O Lord.","fr":"℣. Le Seigneur soit avec vous.\n℟. Et avec votre esprit.\n\nSequéntia ✠ sancti Evangélii secúndum Lucam."}},{"id":"gospel","phase":"Mass of the Catechumens","section":"Gospel & Creed","title":{"en":"Holy Gospel","fr":"Saint Évangile"},"subtitle":{"en":"Proper of the day","fr":"Propre du jour"},"actor":"celebrant","priestPosition":"Gospel side","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"Listen standing to the Gospel. At the end the response is Laus tibi, Christe; the celebrant kisses the book and says Per evangelica dicta.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","properSlot":"gospel"},{"id":"credo","phase":"Mass of the Catechumens","section":"Gospel & Creed","title":{"en":"Credo","fr":"Credo"},"subtitle":{"en":"Nicene Creed","fr":"Credo de Nicée"},"actor":"mixed","priestPosition":"Centre","audibility":"mixed","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"gestures":[{"kind":"genuflect","status":"custom","label":"Traditional/local genuflection","anchorLat":"Et incarnátus est","anchorEng":"And was incarnate","before":true},{"kind":"rise","status":"custom","label":"Rise","anchorLat":"et homo factus est.","anchorEng":"and was made man.","after":true},{"kind":"cross","status":"custom","label":"Traditional sign of the cross","anchorLat":"Et vitam ✠ ventúri sæculi","anchorEng":"the life ✠ of the world to come","before":true}],"explanation":"The Nicene Creed is professed at Masses where the rubrics prescribe it. The celebrant genuflects at Et incarnatus est; congregational imitation is a traditional/local practice.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Credo in unum Deum, Patrem omnipoténtem, factórem cæli et terræ, visibílium ómnium et invisibílium. Et in unum Dóminum Iesum Christum, Fílium Dei unigénitum. Et ex Patre natum ante ómnia sæcula. Deum de Deo, lumen de lúmine, Deum verum de Deo vero. Génitum, non factum, consubstantiálem Patri: per quem ómnia facta sunt. Qui propter nos hómines et propter nostram salútem descéndit de cælis. Et incarnátus est de Spíritu Sancto ex María Vírgine: et homo factus est. Crucifíxus étiam pro nobis: sub Póntio Piláto passus, et sepúltus est. Et resurréxit tértia die, secúndum Scriptúras. Et ascéndit in cælum: sedet ad déxteram Patris. Et íterum ventúrus est cum glória iudicáre vivos et mórtuos: cuius regni non erit finis. Et in Spíritum Sanctum, Dóminum et vivificántem: qui ex Patre Filióque procédit. Qui cum Patre et Fílio simul adorátur et conglorificátur: qui locútus est per Prophétas. Et unam sanctam cathólicam et apostólicam Ecclésiam. Confíteor unum baptísma in remissiónem peccatórum. Et exspécto resurrectiónem mortuórum. Et vitam ✠ ventúri sæculi. Amen.","en":"I believe in one God, the Father almighty, maker of heaven and earth, and of all things visible and invisible. And in one Lord Jesus Christ, the Only-begotten Son of God, born of the Father before all ages. God of God, Light of Light, true God of true God. Begotten, not made: consubstantial with the Father; by Whom all things were made. Who for us men, and for our salvation, came down from heaven. And was incarnate by the Holy Ghost of the Virgin Mary: and was made man. He was crucified also for us, suffered under Pontius Pilate, and was buried. And on the third day He rose again according to the Scriptures. And He ascended into heaven, and sitteth at the right hand of the Father. And He shall come again with glory to judge the living and the dead: of Whose kingdom there shall be no end. And in the Holy Ghost, the Lord and Giver of Life: Who proceedeth from the Father and the Son. Who together with the Father and the Son is adored and glorified: Who spoke through the Prophets. And in One, Holy, Catholic and Apostolic Church. I confess one Baptism for the remission of sins. And I look for the resurrection of the dead, and the life ✠ of the world to come. Amen.","fr":"JE CROIS en un seul Dieu, le Père tout-puissant, créateur du ciel et de la terre, de l’univers visible et invisible. Et en un seul Seigneur Jésus-Christ, le Fils unique de Dieu, né du Père avant tous les siècles. Dieu de Dieu, Lumière de Lumière, vrai Dieu de vrai Dieu. Engendré, non pas créé, consubstantiel au Père, et par qui tout a été fait. Pour nous les hommes et pour notre salut, il est descendu des cieux. Et il a pris chair de la Vierge Marie par le Saint-Esprit, et s’est fait homme. Crucifié aussi pour nous, il a souffert sous Ponce Pilate et a été enseveli. Il est ressuscité le troisième jour, conformément aux Écritures. Et il est monté au ciel : il siège à la droite du Père. Il reviendra dans la gloire pour juger les vivants et les morts ; et son règne n’aura pas de fin. Je crois en l’Esprit Saint, qui est Seigneur et qui donne la vie ; il procède du Père et du Fils. Avec le Père et le Fils, il reçoit même adoration et même gloire ; il a parlé par les prophètes. Je crois l’Église, une, sainte, catholique et apostolique. Je reconnais un seul baptême pour la rémission des péchés. J’attends la résurrection des morts et la vie ✠ du monde à venir. Ainsi soit-il."},"choir":[{"id":"credo-choir","text":{"lat":"Credo in unum Deum, Patrem omnipoténtem, factórem cæli et terræ, visibílium ómnium et invisibílium. Et in unum Dóminum Iesum Christum, Fílium Dei unigénitum. Et ex Patre natum ante ómnia sæcula. Deum de Deo, lumen de lúmine, Deum verum de Deo vero. Génitum, non factum, consubstantiálem Patri: per quem ómnia facta sunt. Qui propter nos hómines et propter nostram salútem descéndit de cælis. Et incarnátus est de Spíritu Sancto ex María Vírgine: et homo factus est. Crucifíxus étiam pro nobis: sub Póntio Piláto passus, et sepúltus est. Et resurréxit tértia die, secúndum Scriptúras. Et ascéndit in cælum: sedet ad déxteram Patris. Et íterum ventúrus est cum glória iudicáre vivos et mórtuos: cuius regni non erit finis. Et in Spíritum Sanctum, Dóminum et vivificántem: qui ex Patre Filióque procédit. Qui cum Patre et Fílio simul adorátur et conglorificátur: qui locútus est per Prophétas. Et unam sanctam cathólicam et apostólicam Ecclésiam. Confíteor unum baptísma in remissiónem peccatórum. Et exspécto resurrectiónem mortuórum. Et vitam ✠ ventúri sæculi. Amen.","en":"I believe in one God, the Father almighty, maker of heaven and earth, and of all things visible and invisible. And in one Lord Jesus Christ, the Only-begotten Son of God, born of the Father before all ages. God of God, Light of Light, true God of true God. Begotten, not made: consubstantial with the Father; by Whom all things were made. Who for us men, and for our salvation, came down from heaven. And was incarnate by the Holy Ghost of the Virgin Mary: and was made man. He was crucified also for us, suffered under Pontius Pilate, and was buried. And on the third day He rose again according to the Scriptures. And He ascended into heaven, and sitteth at the right hand of the Father. And He shall come again with glory to judge the living and the dead: of Whose kingdom there shall be no end. And in the Holy Ghost, the Lord and Giver of Life: Who proceedeth from the Father and the Son. Who together with the Father and the Son is adored and glorified: Who spoke through the Prophets. And in One, Holy, Catholic and Apostolic Church. I confess one Baptism for the remission of sins. And I look for the resurrection of the dead, and the life ✠ of the world to come. Amen.","fr":"JE CROIS en un seul Dieu, le Père tout-puissant, créateur du ciel et de la terre, de l’univers visible et invisible. Et en un seul Seigneur Jésus-Christ, le Fils unique de Dieu, né du Père avant tous les siècles. Dieu de Dieu, Lumière de Lumière, vrai Dieu de vrai Dieu. Engendré, non pas créé, consubstantiel au Père, et par qui tout a été fait. Pour nous les hommes et pour notre salut, il est descendu des cieux. Et il a pris chair de la Vierge Marie par le Saint-Esprit, et s’est fait homme. Crucifié aussi pour nous, il a souffert sous Ponce Pilate et a été enseveli. Il est ressuscité le troisième jour, conformément aux Écritures. Et il est monté au ciel : il siège à la droite du Père. Il reviendra dans la gloire pour juger les vivants et les morts ; et son règne n’aura pas de fin. Je crois en l’Esprit Saint, qui est Seigneur et qui donne la vie ; il procède du Père et du Fils. Avec le Père et le Fils, il reçoit même adoration et même gloire ; il a parlé par les prophètes. Je crois l’Église, une, sainte, catholique et apostolique. Je reconnais un seul baptême pour la rémission des péchés. J’attends la résurrection des morts et la vie ✠ du monde à venir. Ainsi soit-il."},"timing":"simultaneous"}]},{"id":"offertory","phase":"Offertory","section":"Proper & Offering","title":{"en":"Offertory","fr":"Offertoire"},"subtitle":{"en":"Dominus vobiscum · Oremus · Proper antiphon","fr":"Dominus vobiscum · Oremus · antienne propre"},"actor":"mixed","priestPosition":"Centre, then altar","audibility":"mixed","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"Dóminus vobíscum","explanation":"The Mass of the Faithful begins. The proper Offertory antiphon accompanies the preparation of the sacrifice.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","properSlot":"offertory","concurrentProperChoir":"offertory"},{"id":"offer-host","phase":"Offertory","section":"Proper & Offering","title":{"en":"Offering of the Host","fr":"Offrande de l’Hostie"},"subtitle":{"en":"Suscipe, sancte Pater","fr":"Suscipe, sancte Pater"},"actor":"mixed","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The priest offers the bread prepared for consecration while praying Suscipe, sancte Pater.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Suscipe, sancte Pater, omnipotens ætérne Deus, hanc immaculátam hóstiam, quam ego indígnus fámulus tuus óffero tibi Deo meo vivo et vero, pro innumerabílibus peccátis, et offensiónibus, et neglegéntiis meis, et pro ómnibus circumstántibus, sed et pro ómnibus fidélibus christiánis vivis atque defúnctis: ut mihi, et illis profíciat ad salútem in vitam ætérnam. Amen.","en":"Accept, O Holy father, Almighty and Eternal God, this spotless host, which I, Your unworthy servant, offer to You, my living and true God, to atone for my numberless sins, offences, and negligences; on behalf of all here present and likewise for all faithful Christians living and dead, that it may profit me and them as a means of salvation to life everlasting. Amen.","fr":"Recevez, Père saint, Dieu éternel et tout-puissant, cette hostie sans tache que moi, votre indigne serviteur, je vous offre, à vous mon Dieu vivant et vrai, pour mes innombrables péchés, offenses et négligences, pour tous ceux qui m’entourent, et pour tous les fidèles chrétiens vivants et morts ; qu’elle serve à mon salut et au leur pour la vie éternelle. Ainsi soit-il."},"concurrentProperChoir":"offertory"},{"id":"water-wine","phase":"Offertory","section":"Proper & Offering","title":{"en":"Blessing of the Water","fr":"Bénédiction de l’eau"},"subtitle":{"en":"Deus, qui humanae","fr":"Deus, qui humanae"},"actor":"mixed","priestPosition":"Epistle side / centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"A little water is mixed with the wine. The prayer links Christ’s sharing in our humanity with our sharing in His divinity.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Deus, qui humánæ substántiæ dignitátem mirabíliter condidísti, et mirabílius reformásti: da nobis per huius aquæ et vini mystérium, eius divinitátis esse consórtes, qui humanitátis nostræ fíeri dignátus est párticeps, Iesus Christus, Fílius tuus, Dóminus noster: Qui tecum vivit et regnat in unitáte Spíritus Sancti Deus: per ómnia saecula sæculórum. Amen.","en":"O God, who in creating man didst exalt his nature very wonderfully and yet more wonderfully didst establish it anew; by the Mystery signified in the mingling of this water and wine, grant us to have part in the Godhead of Him Who hath deigned to become a partaker of our humanity, Jesus Christ, Thy Son our Lord; Who liveth and reigneth with Thee, in the unity of the Holy Ghost, God. World without end. Amen.","fr":"Ô Dieu, qui avez merveilleusement créé la dignité de la nature humaine et l’avez plus merveilleusement encore restaurée, accordez-nous, par le mystère de cette eau et de ce vin, d’avoir part à la divinité de celui qui a daigné prendre part à notre humanité, Jésus-Christ, votre Fils, notre Seigneur ; qui vit et règne avec vous dans l’unité du Saint-Esprit, Dieu, dans tous les siècles des siècles. Ainsi soit-il."},"concurrentProperChoir":"offertory"},{"id":"offer-chalice","phase":"Offertory","section":"Proper & Offering","title":{"en":"Offering of the Chalice","fr":"Offrande du Calice"},"subtitle":{"en":"Offerimus tibi, Domine","fr":"Offerimus tibi, Domine"},"actor":"mixed","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The chalice of salvation is offered for our salvation and that of the whole world.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Offérimus tibi, Dómine, cálicem salutáris, tuam deprecántes cleméntiam: ut in conspéctu divínæ maiestátis tuæ, pro nostra et totíus mundi salute, cum odóre suavitátis ascéndat. Amen.","en":"We offer unto Thee, O Lord, the chalice of salvation, entreating Thy mercy that our offering may ascend with a sweet fragrance in the sight of Thy divine Majesty, for our own salvation, and for that of the whole world. Amen.","fr":"Nous vous offrons, Seigneur, le calice du salut, implorant votre clémence : qu’il s’élève en odeur de suavité devant votre divine Majesté, pour notre salut et celui du monde entier. Ainsi soit-il."},"concurrentProperChoir":"offertory"},{"id":"in-spiritu","phase":"Offertory","section":"Proper & Offering","title":{"en":"Prayer of Humility","fr":"Prière d’humilité"},"subtitle":{"en":"In spiritu humilitatis","fr":"In spiritu humilitatis"},"actor":"mixed","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The celebrant asks that the sacrifice offered in humility and contrition be pleasing to God.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"In spíritu humilitátis et in ánimo contríto suscipiámur a te, Dómine: et sic fiat sacrifícium nostrum in conspéctu tuo hódie, ut pláceat tibi, Dómine Deus.","en":"Humbled in spirit and contrite of heart, may we find favor with Thee, O Lord: and may our sacrifice be so offered this day in Thy sight as to be pleasing to Thee, O Lord God.","fr":"En esprit d’humilité et le cœur contrit, puissions-nous être accueillis par vous, Seigneur ; et que notre sacrifice s’accomplisse aujourd’hui devant vous de telle sorte qu’il vous soit agréable, Seigneur Dieu."},"concurrentProperChoir":"offertory"},{"id":"veni-sanctificator","phase":"Offertory","section":"Proper & Offering","title":{"en":"Invocation of the Holy Ghost","fr":"Invocation du Saint-Esprit"},"subtitle":{"en":"Veni, Sanctificator","fr":"Veni, Sanctificator"},"actor":"mixed","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The Holy Ghost is invoked over the sacrifice prepared upon the altar.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Veni, sanctificátor omnípotens ætérne Deus: et bene ✠ dic hoc sacrifícium, tuo sancto nómini præparátum.","en":"Come Thou, the Sanctifier, Almighty and Everlasting God, and bless ✠ this sacrifice which is prepared for the glory of Thy holy Name.","fr":"Venez, Sanctificateur, Dieu éternel et tout-puissant, et bénissez ✠ ce sacrifice préparé pour la gloire de votre saint Nom."},"concurrentProperChoir":"offertory"},{"id":"incense-off","phase":"Offertory","section":"Altar Preparation","title":{"en":"Incensation","fr":"Encensement"},"subtitle":{"en":"Gifts · crucifix · altar · priest · faithful","fr":"Offrandes · crucifix · autel · prêtre · fidèles"},"actor":"celebrant","priestPosition":"Around the altar","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The offerings and altar are incensed, followed by the celebrant, ministers and faithful.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Per intercessiónem beáti Michaélis Archángeli, stantis a dextris altáris incénsi, et ómnium electórum suórum, incénsum istud dignétur Dóminus bene ✠ dícere, et in odórem suavitátis accípere. Per Christum, Dóminum nostrum. Amen.\n\nIncénsum istud a te benedíctum ascéndat ad te, Dómine: et descéndat super nos misericórdia tua.\n\nPs 140, 2–4\nDirigátur, Dómine, orátio mea, sicut incénsum, in conspéctu tuo: elevátio mánuum meárum sacrifícium vespertínum.\nPone, Dómine, custódiam ori meo, et óstium circumstántiæ lábiis meis:\nut non declínet cor meum in verba malítiæ, ad excusándas excusatiónes in peccátis.\n\nAccéndat in nobis Dóminus ignem sui amóris, et flammam ætérnæ caritátis. Amen.","en":"Through the intercession of blessed Michael the Archangel, standing at the right hand of the altar of incense, and of all His elect, may the Lord vouchsafe to bless ✠ this incense and to receive it in the odor of sweetness. Through Christ our Lord. Amen.\n\nMay this incense blessed by You, arise before You, O Lord, and may Your mercy come down upon us.\n\nPs 140, 2–4\nLet my prayer, O Lord, like incense before You; the lifting up of my hands, like the evening sacrifice.\nO Lord, set a watch before my mouth, a guard at the door of my lips.\nLet not my heart incline to the evil of engaging in deeds of wickedness.\n\nMay the Lord enkindle in us the fire of His love and the flame of everlasting charity. Amen.","fr":"Par l’intercession du bienheureux Michel Archange, qui se tient à la droite de l’autel de l’encens, et de tous ses élus, que le Seigneur daigne bénir ✠ cet encens et le recevoir comme un parfum agréable. Par le Christ notre Seigneur. Ainsi soit-il.\n\nQue cet encens béni par vous monte vers vous, Seigneur, et que descende sur nous votre miséricorde.\n\nPs 140, 2–4\nQue ma prière, Seigneur, s’élève comme l’encens devant vous ; que l’élévation de mes mains soit comme le sacrifice du soir.\nPlacez, Seigneur, une garde à ma bouche et une barrière autour de mes lèvres, afin que mon cœur ne se porte pas à des paroles mauvaises pour chercher des excuses au péché.\n\nQue le Seigneur allume en nous le feu de son amour et la flamme de l’éternelle charité. Ainsi soit-il."},"concurrentProperChoir":"offertory"},{"id":"lavabo","phase":"Offertory","section":"Altar Preparation","title":{"en":"Lavabo","fr":"Lavabo"},"subtitle":{"en":"Psalm 25","fr":"Psalm 25"},"actor":"celebrant","priestPosition":"Epistle side","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The priest washes his fingers while praying Psalm 25, an outward sign of the inward purity appropriate to the sacred mysteries.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Ps 25, 6–12\nLavábo inter innocéntes manus meas: et circúmdabo altáre tuum, Dómine:\nUt áudiam vocem laudis, et enárrem univérsa mirabília tua.\nDómine, diléxi decórem domus tuæ et locum habitatiónis glóriæ tuæ.\nNe perdas cum ímpiis, Deus, ánimam meam, et cum viris sánguinum vitam meam:\nIn quorum mánibus iniquitátes sunt: déxtera eórum repléta est munéribus.\nEgo autem in innocéntia mea ingréssus sum: rédime me et miserére mei.\nPes meus stetit in dirécto: in ecclésiis benedícam te, Dómine.\n℣. Glória Patri, et Fílio, et Spirítui Sancto.\n℟. Sicut erat in princípio, et nunc, et semper: et in sǽcula sæculórum. Amen.","en":"Ps 25, 6–12\nI will wash my hands among the innocent, and I will encompass Thine Altar, O Lord.\nThat I may hear the voice of praise, and tell of all Thy wondrous works.\nI have loved, O Lord, the beauty of Thy house, and the place where Thy glory dwelleth.\nTake not away my soul, O God, with the wicked, nor my life with men of blood.\nIn whose hands are iniquities, their right hand is filled with gifts.\nBut as for me, I have walked in my innocence; redeem me, and have mercy on me.\nMy foot hath stood in the right way; in the churches I will bless Thee, O Lord.\n℣. Glory be to the Father, and to the Son, and to the Holy Ghost.\n℟. As it was in the beginning, is now, and ever shall be, world without end. Amen.","fr":"Ps 25, 6–12\nJe laverai mes mains parmi les innocents, et je me tiendrai autour de votre autel, Seigneur,\nafin d’entendre la voix de la louange et de raconter toutes vos merveilles.\nSeigneur, j’aime la beauté de votre maison et le lieu où habite votre gloire.\nNe perdez pas, ô Dieu, mon âme avec les impies, ni ma vie avec les hommes de sang,\ndont les mains commettent l’iniquité et dont la droite est remplie de présents.\nPour moi, je marche dans l’innocence ; rachetez-moi et ayez pitié de moi.\nMon pied s’est tenu dans le droit chemin ; dans les assemblées je vous bénirai, Seigneur.\n℣. Gloire au Père, et au Fils, et au Saint-Esprit.\n℟. Comme il était au commencement, maintenant et toujours, et dans les siècles des siècles. Ainsi soit-il."},"concurrentProperChoir":"offertory"},{"id":"suscipe-trinitas","phase":"Offertory","section":"Altar Preparation","title":{"en":"Prayer to the Holy Trinity","fr":"Prière à la Sainte Trinité"},"subtitle":{"en":"Suscipe, sancta Trinitas","fr":"Suscipe, sancta Trinitas"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The oblation is commended to the Holy Trinity in memory of the mysteries of Christ and in honour of the saints.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Súscipe, sancta Trinitas, hanc oblatiónem, quam tibi offérimus ob memóriam passiónis, resurrectiónis, et ascensiónis Iesu Christi, Dómini nostri: et in honórem beátæ Maríæ semper Vírginis, et beáti Ioannis Baptistæ, et sanctórum Apostolórum Petri et Pauli, et istórum et ómnium Sanctórum: ut illis profíciat ad honórem, nobis autem ad salútem: et illi pro nobis intercédere dignéntur in coelis, quorum memóriam ágimus in terris. Per eúndem Christum, Dóminum nostrum. Amen.","en":"Receive, O Holy Trinity, this oblation which we make to Thee in memory of the Passion, Resurrection and Ascension of our Lord Jesus Christ; and in honor of Blessed Mary ever Virgin, of blessed John the Baptist, the holy Apostles Peter and Paul, of these and of all the Saints. To them let it bring honor, and to us salvation, and may they whom we are commemorating here on earth deign to plead for us in heaven. Through the same Christ our Lord. Amen.","fr":"Recevez, Trinité sainte, cette offrande que nous vous présentons en mémoire de la Passion, de la Résurrection et de l’Ascension de Jésus-Christ notre Seigneur ; et en l’honneur de la bienheureuse Marie toujours Vierge, de saint Jean-Baptiste, des saints Apôtres Pierre et Paul, de ceux-ci et de tous les saints : qu’elle serve à leur honneur et à notre salut ; et qu’ils daignent intercéder au ciel pour nous qui faisons mémoire d’eux sur la terre. Par le même Christ notre Seigneur. Ainsi soit-il."},"concurrentProperChoir":"offertory"},{"id":"orate-fratres","phase":"Offertory","section":"Conclusion of Offertory","title":{"en":"Orate, fratres","fr":"Orate, fratres"},"subtitle":{"en":"Pray, brethren","fr":"Priez, mes frères"},"actor":"celebrant","priestPosition":"Centre · turns toward the people, then back to the altar","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"Oráte, fratres","explanation":"The celebrant turns toward the people for Orate, fratres, then turns back to the altar while the response is made before the Secret.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"℣. Oráte, fratres: ut meum ac vestrum sacrifícium acceptábile fiat apud Deum Patrem omnipoténtem.\n℟. Suscípiat Dóminus sacrifícium de mánibus tuis ad laudem et glóriam nominis sui, ad utilitátem quoque nostram, totiúsque Ecclésiæ suæ sanctæ.\nAmen.","en":"℣. Pray, brethren, that my Sacrifice and yours may be acceptable to God the Father Almighty.\n℟. May the Lord accept the Sacrifice from thy hands, to the praise and glory of His Name, for our benefit and for that of all His holy Church.\nAmen.","fr":"℣. Priez, mes frères, afin que mon sacrifice, qui est aussi le vôtre, soit agréé par Dieu le Père tout-puissant.\n℟. Que le Seigneur reçoive de vos mains le sacrifice, à la louange et à la gloire de son nom, et aussi pour notre bien et celui de toute sa sainte Église.\nAinsi soit-il."},"concurrentProperChoir":"offertory"},{"id":"secret","phase":"Offertory","section":"Conclusion of Offertory","title":{"en":"Secret","fr":"Secrète"},"subtitle":{"en":"Proper prayer · listen for the conclusion","fr":"Prière propre · écoutez la conclusion"},"actor":"celebrant","priestPosition":"Epistle side · toward the missal","audibility":"mixed","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"Per ómnia sǽcula sæculórum","explanation":"The Secret is said quietly. Its final conclusion becomes audible and is one of the easiest landmarks in the Mass: Per omnia sæcula sæculorum — Amen — immediately before the Preface dialogue.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","properSlot":"secrets"},{"id":"preface","phase":"Preface & Canon","section":"Preface","title":{"en":"Preface","fr":"Préface"},"subtitle":{"en":"Sursum corda","fr":"Sursum corda"},"actor":"celebrant","priestPosition":"Epistle side · toward the missal","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"Dóminus vobíscum · Sursum corda","explanation":"The Preface is the solemn prayer of thanksgiving that follows the Sursum corda dialogue and leads into the Sanctus and Roman Canon.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","properSlot":"preface"},{"id":"sanctus","phase":"Preface & Canon","section":"Preface","title":{"en":"Sanctus","fr":"Sanctus"},"subtitle":{"en":"Holy, Holy, Holy","fr":"Saint, Saint, Saint"},"actor":"mixed","priestPosition":"Centre","audibility":"mixed","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"gestures":[{"kind":"cross","label":"Sign of the cross","anchorLat":"Benedíctus qui venit","anchorEng":"Blessed is He who comes","before":true,"status":"custom"}],"landmark":"Bell at Sanctus","explanation":"The Sanctus concludes the Preface and leads into the Roman Canon. The altar bell is prescribed here; the 1962 Ritus does not itself fix a universal number of Sanctus strokes.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Sanctus, Sanctus, Sanctus Dóminus, Deus Sábaoth. Pleni sunt cæli et terra glória tua. Hosánna in excélsis. Benedíctus qui venit in nómine Dómini. Hosánna in excélsis.","en":"Holy, Holy, Holy, Lord God of Hosts. Heaven and earth are full of Thy glory. Hosanna in the highest. Blessed is He who comes in the name of the Lord. Hosanna in the highest.","fr":"Saint, Saint, Saint le Seigneur, Dieu des armées célestes. Le ciel et la terre sont remplis de votre gloire. Hosanna au plus haut des cieux. Béni soit celui qui vient au nom du Seigneur. Hosanna au plus haut des cieux."},"choir":[{"id":"sanctus-choir","text":{"lat":"Sanctus, Sanctus, Sanctus Dóminus, Deus Sábaoth. Pleni sunt cæli et terra glória tua. Hosánna in excélsis. Benedíctus qui venit in nómine Dómini. Hosánna in excélsis.","en":"Holy, Holy, Holy, Lord God of Hosts. Heaven and earth are full of Thy glory. Hosanna in the highest. Blessed is He who comes in the name of the Lord. Hosanna in the highest.","fr":"Saint, Saint, Saint le Seigneur, Dieu des armées célestes. Le ciel et la terre sont remplis de votre gloire. Hosanna au plus haut des cieux. Béni soit celui qui vient au nom du Seigneur. Hosanna au plus haut des cieux."},"timing":"simultaneous"}],"bells":[{"kind":"bell","label":"Sanctus bell","anchorLat":"Sanctus, Sanctus, Sanctus","anchorEng":"Holy, Holy, Holy","before":true,"pattern":"prescribed · exact count not fixed by the 1962 Ritus","legalStatus":"PRESCRIBED","authority":"RUBRIC_1962"}]},{"id":"te-igitur","phase":"Preface & Canon","section":"Canon before Consecration","title":{"en":"Prayer first for the Church","fr":"Prière d’abord pour l’Église"},"subtitle":{"en":"Te igitur","fr":"Te igitur"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The Roman Canon begins by offering the sacrifice for the Holy Catholic Church.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Te igitur, clementíssime Pater, per Iesum Christum, Fílium tuum, Dóminum nostrum, súpplices rogámus, ac pétimus, uti accepta habeas et benedícas, hæc ✠ dona, hæc ✠ múnera, hæc ✠ sancta sacrifícia illibáta.\n\nIn primis, quæ tibi offérimus pro Ecclésia tua sancta cathólica: quam pacificáre, custodíre, adunáre et régere dignéris toto orbe terrárum: una cum fámulo tuo Papa nostro N. et Antístite nostro et ómnibus orthodóxis, atque cathólicæ et apostólicae fídei cultóribus.","en":"Most merciful Father, we humbly pray and beseech Thee, through Jesus Christ Thy Son, Our Lord, to accept and to bless these ✠ gifts, these ✠ presents, these ✠ holy unspotted Sacrifices,\n\nWe offer them up to Thee, in the first place, for Thy Holy Catholic Church, that it may please Thee to grant her peace, to preserve, unite, and govern her throughout the world; as also for Thy servant N. our Pope, and N. our Bishop, and for all orthodox believers and all who profess the Catholic and Apostolic faith.","fr":"Père très clément, nous vous supplions et vous demandons humblement, par Jésus-Christ votre Fils, notre Seigneur, d’accepter et de bénir ces ✠ dons, ces ✠ présents, ces ✠ sacrifices saints et sans tache,\n\nque nous vous offrons d’abord pour votre sainte Église catholique : daignez lui donner la paix, la garder, l’unir et la gouverner dans le monde entier, avec votre serviteur notre Pape N., notre évêque N., et tous ceux qui, fidèles à la foi catholique et apostolique, la professent et la défendent."}},{"id":"memento-living","phase":"Preface & Canon","section":"Canon before Consecration","title":{"en":"Memento of the Living","fr":"Mémento des vivants"},"subtitle":{"en":"Memento, Domine","fr":"Memento, Domine"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The living for whom the sacrifice is offered are remembered before God.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Meménto, Dómine, famulórum famularúmque tuarum N. et N. et ómnium circumstántium, quorum tibi fides cógnita est et nota devótio, pro quibus tibi offérimus: vel qui tibi ófferunt hoc sacrifícium laudis, pro se suísque ómnibus: pro redemptióne animárum suárum, pro spe salútis et incolumitátis suæ: tibíque reddunt vota sua ætérno Deo, vivo et vero.","en":"Be mindful, O Lord, of Thy servants and handmaids N. and N. and of all here present, whose faith and devotion are known to Thee, for whom we offer, or who offer up to Thee this Sacrifice of praise for themselves and all those dear to them, for the redemption of their souls and the hope of their safety and salvation: who now pay their vows to Thee, the everlasting, living and true God.","fr":"Souvenez-vous, Seigneur, de vos serviteurs et servantes N. et N., et de tous ceux qui nous entourent, dont vous connaissez la foi et la dévotion ; pour eux nous vous offrons, ou eux-mêmes vous offrent, ce sacrifice de louange, pour eux et pour tous les leurs, pour la rédemption de leurs âmes, l’espérance de leur salut et de leur conservation ; et ils acquittent leurs vœux envers vous, Dieu éternel, vivant et vrai."}},{"id":"communicantes","phase":"Preface & Canon","section":"Canon before Consecration","title":{"en":"Our Intercessors in Heaven","fr":"Nos intercesseurs au Ciel"},"subtitle":{"en":"Communicantes","fr":"Communicantes"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The earthly Church joins the Blessed Virgin, Saint Joseph, the Apostles, Martyrs and all the saints.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Communicántes, et memóriam venerántes, in primis gloriósæ semper Vírginis Maríæ, Genetrícis Dei et Dómini nostri Iesu Christi: sed et beati Ioseph, eiusdem Virginis Sponsi, et beatórum Apostolórum ac Mártyrum tuórum, Petri et Pauli, Andréæ, Iacóbi, Ioánnis, Thomæ, Iacóbi, Philíppi, Bartholomaei, Matthaei, Simónis et Thaddaei: Lini, Cleti, Cleméntis, Xysti, Cornélii, Cypriáni, Lauréntii, Chrysógoni, Ioánnis et Pauli, Cosmæ et Damiáni: et ómnium Sanctórum tuórum; quorum méritis precibúsque concédas, ut in ómnibus protectiónis tuæ muniámur auxílio. Per eúndem Christum, Dóminum nostrum. Amen.","en":"In communion with, and honoring the memory in the first place of the glorious ever Virgin Mary Mother of our God and Lord Jesus Christ; also of blessed Joseph, her Spouse; and likewise of Thy blessed Apostles and Martyrs, Peter and Paul, Andrew, James, John, Thomas, James, Philip, Bartholomew, Matthew, Simon and Thaddeus, Linus, Cletus, Clement, Sixtus, Cornelius, Cyprian, Lawrence, Chrysogonus, John and Paul, Cosmas and Damian, and of all Thy Saints. Grant for the sake of their merits and prayers that in all things we may be guarded and helped by Thy protection. Through the same Christ our Lord. Amen.","fr":"Unis dans une même communion et vénérant d’abord la mémoire de la glorieuse Marie toujours Vierge, Mère de notre Dieu et Seigneur Jésus-Christ, puis de saint Joseph son époux, de vos bienheureux Apôtres et Martyrs Pierre et Paul, André, Jacques, Jean, Thomas, Jacques, Philippe, Barthélemy, Matthieu, Simon et Thaddée, Lin, Clet, Clément, Sixte, Corneille, Cyprien, Laurent, Chrysogone, Jean et Paul, Côme et Damien, et de tous vos saints ; par leurs mérites et leurs prières, accordez-nous d’être toujours fortifiés par le secours de votre protection. Par le même Christ notre Seigneur. Ainsi soit-il."}},{"id":"hanc","phase":"Preface & Canon","section":"Canon before Consecration","title":{"en":"Prayer for the whole family of God","fr":"Prière pour toute la famille de Dieu"},"subtitle":{"en":"Hanc igitur","fr":"Hanc igitur"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The celebrant extends his hands over the offerings and asks God to accept the oblation of His whole household. The 1962 Ritus prescribes a warning bell shortly before the Consecration; this screen uses Hanc igitur as the ceremonial synchronization point rather than claiming that exact placement as the wording of the primary rubric.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Hanc igitur oblatiónem servitutis nostræ, sed et cunctae famíliæ tuæ, quaesumus, Dómine, ut placátus accípias: diésque nostros in tua pace dispónas, atque ab ætérna damnatióne nos éripi, et in electórum tuórum iúbeas grege numerári. Per Christum, Dóminum nostrum. Amen.","en":"O Lord, we beseech Thee, graciously to accept this oblation of our service and that of Thy whole household. Order our days in Thy peace, and command that we be rescued from eternal damnation and numbered in the flock of Thine elect. Through Christ our Lord. Amen.","fr":"Cette offrande de notre servitude et de toute votre famille, nous vous en supplions, Seigneur, acceptez-la avec bienveillance ; disposez nos jours dans votre paix, arrachez-nous à la damnation éternelle et daignez nous compter au nombre de vos élus. Par le Christ notre Seigneur. Ainsi soit-il."},"bells":[{"kind":"bell","label":"Warning bell before the Consecration","anchorLat":"Hanc igitur","anchorEng":"This oblation","before":false,"pattern":"prescribed shortly before the Consecration","legalStatus":"PRESCRIBED","authority":"RUBRIC_1962","placementStatus":"CEREMONIAL_SYNCHRONIZATION"}]},{"id":"quam-oblationem","phase":"Preface & Canon","section":"Canon before Consecration","title":{"en":"Prayer immediately before the Consecration","fr":"Prière immédiatement avant la Consécration"},"subtitle":{"en":"Quam oblationem","fr":"Quam oblationem"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The offerings are blessed and commended immediately before the words of institution.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Quam oblatiónem tu, Deus, in ómnibus, quaesumus, bene ✠ díctam, adscríp ✠ tam, ra ✠ tam, rationábilem, acceptabilémque fácere dignéris: ut nobis Cor ✠ pus, et San ✠ guis fiat dilectíssimi Fílii tui, Dómini nostri Iesu Christi.","en":"Humbly we pray Thee, O God, be pleased to make this same offering wholly blessed ✠, to consecrate ✠ it and approve ✠ it, making it reasonable and acceptable, so that it may become for us the Body ✠ and Blood ✠ of Thy dearly beloved Son, our Lord Jesus Christ.","fr":"Daignez, ô Dieu, nous vous en supplions, rendre cette offrande pleinement bénie ✠, agréée ✠, ratifiée ✠, raisonnable et acceptable, afin qu’elle devienne pour nous le Corps ✠ et le Sang ✠ de votre Fils bien-aimé, notre Seigneur Jésus-Christ."}},{"id":"consecration-host","phase":"Preface & Canon","section":"Consecration","title":{"en":"Consecration of the Host","fr":"Consécration de l’Hostie"},"subtitle":{"en":"Hoc est enim Corpus meum","fr":"Hoc est enim Corpus meum"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"BELLS · Elevation of the Host","explanation":"The bread is consecrated; the Sacred Host is elevated for adoration.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Qui prídie quam paterétur, accépit panem in sanctas ac venerábiles manus suas, elevátis óculis in coelum ad te Deum, Patrem suum omnipoténtem, tibi grátias agens, bene ✠ dixit, fregit, dedítque discípulis suis, dicens: Accípite, et manducáte ex hoc omnes.\n\nHOC EST ENIM CORPUS MEUM.","en":"Who, the day before He suffered, took bread into His Holy and venerable hands, and having lifted up His eyes to heaven, to Thee, God, His Almighty Father, giving thanks to Thee, blessed it ✠, broke it, and gave it to His disciples, saying: Take and eat ye all of this.\n\nFOR THIS IS MY BODY.","fr":"La veille de sa Passion, il prit le pain dans ses mains saintes et vénérables et, levant les yeux au ciel vers vous, Dieu, son Père tout-puissant, vous rendant grâces, il le bénit ✠, le rompit et le donna à ses disciples en disant : Prenez et mangez-en tous.\n\nCAR CECI EST MON CORPS."},"bells":[{"kind":"bell","label":"Elevation bells","after":true,"pattern":"3 rings or continuous until the Sacred Species is lowered","legalStatus":"PRESCRIBED","authority":"RUBRIC_1962"}],"silenceGate":"CONSECRATION"},{"id":"consecration-chalice","phase":"Preface & Canon","section":"Consecration","title":{"en":"Consecration of the Chalice","fr":"Consécration du Calice"},"subtitle":{"en":"Hic est enim Calix Sanguinis mei","fr":"Hic est enim Calix Sanguinis mei"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"BELLS · Elevation of the Chalice","explanation":"After the words of consecration over the chalice, Haec quotiescumque is said and the chalice is elevated for adoration.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Símili modo postquam coenátum est, accípiens et hunc præclárum Cálicem in sanctas ac venerábiles manus suas: item tibi grátias agens, bene ✠ dixit, dedítque discípulis suis, dicens: Accípite, et bíbite ex eo omnes.\n\nHIC EST ENIM CALIX SÁNGUINIS MEI, NOVI ET ÆTÉRNI TESTAMÉNTI: MYSTÉRIUM FÍDEI: QUI PRO VOBIS ET PRO MULTIS EFFUNDÉTUR IN REMISSIÓNEM PECCATÓRUM.\n\nHæc quotiescúmque fecéritis, in mei memóriam faciétis.","en":"Taking also into His holy and venerable hands this goodly chalice, again giving thanks to Thee, He blessed it ✠, and gave it to His disciples, saying: Take and drink ye all of this.\n\nFOR THIS IS THE CHALICE OF MY BLOOD, OF THE NEW AND ETERNAL TESTAMENT: THE MYSTERY OF FAITH: WHICH SHALL BE SHED FOR YOU AND FOR MANY UNTO THE REMISSION OF SINS.\n\nAs often as ye shall do these things, ye shall do them in remembrance of Me.","fr":"De même, après le repas, prenant aussi ce précieux calice dans ses mains saintes et vénérables, vous rendant encore grâces, il le bénit ✠ et le donna à ses disciples en disant : Prenez et buvez-en tous.\n\nCAR CECI EST LE CALICE DE MON SANG, LE SANG DE L’ALLIANCE NOUVELLE ET ÉTERNELLE : MYSTÈRE DE FOI : QUI SERA RÉPANDU POUR VOUS ET POUR UN GRAND NOMBRE EN RÉMISSION DES PÉCHÉS.\n\nToutes les fois que vous ferez ces choses, vous les ferez en mémoire de moi."},"bells":[{"kind":"bell","label":"Elevation bells","after":true,"pattern":"3 rings or continuous until the Sacred Species is lowered","legalStatus":"PRESCRIBED","authority":"RUBRIC_1962"}],"silenceGate":"CONSECRATION"},{"id":"unde-et-memores","phase":"Preface & Canon","section":"Canon after Consecration","title":{"en":"Memory of the Mysteries of Christ","fr":"Mémoire des mystères du Christ"},"subtitle":{"en":"Unde et memores","fr":"Unde et memores"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The Passion, Resurrection and Ascension are recalled as the holy Victim is offered to the Father.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Unde et mémores, Dómine, nos servi tui, sed et plebs tua sancta, eiusdem Christi Fílii tui, Dómini nostri, tam beátæ passiónis, nec non et ab ínferis resurrectiónis, sed et in coelos gloriósæ ascensiónis: offérimus præcláræ maiestáti tuæ de tuis donis ac datis, hóstiam ✠ puram, hóstiam ✠ sanctam, hóstiam ✠ immaculátam, Panem ✠ sanctum vitæ ætérnæ, et Calicem ✠ salútis perpétuæ.","en":"And now, O Lord, we, Thy servants, and with us all Thy holy people, calling to mind the blessed Passion of this same Christ, Thy Son, our Lord, likewise His Resurrection from the grave, and also His glorious Ascension into heaven, do offer unto Thy most sovereign Majesty out of the gifts Thou hast bestowed upon us a Victim ✠ which is pure, a Victim ✠ which is holy, a Victim ✠ which is spotless, the holy Bread ✠ of life eternal, and the Chalice ✠ of everlasting Salvation.","fr":"C’est pourquoi, Seigneur, nous vos serviteurs, et avec nous votre peuple saint, faisant mémoire de la bienheureuse Passion du Christ votre Fils, notre Seigneur, de sa Résurrection des enfers et de sa glorieuse Ascension dans les cieux, nous offrons à votre souveraine Majesté, parmi les dons que vous nous avez faits, l’Hostie ✠ pure, l’Hostie ✠ sainte, l’Hostie ✠ sans tache, le Pain ✠ sacré de la vie éternelle et le Calice ✠ du salut perpétuel."}},{"id":"supra-quae","phase":"Preface & Canon","section":"Canon after Consecration","title":{"en":"The ancient sacrifices recalled","fr":"Rappel des anciens sacrifices"},"subtitle":{"en":"Supra quae","fr":"Supra quae"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The sacrifice is compared with the offerings of Abel, Abraham and Melchisedech.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Supra quæ propítio ac seréno vultu respícere dignéris: et accépta habére, sicúti accépta habére dignátus es múnera púeri tui iusti Abel, et sacrifícium Patriárchæ nostri Abrahæ: et quod tibi óbtulit summus sacérdos tuus Melchísedech, sanctum sacrifícium, immaculátam hóstiam.","en":"Deign to look upon them with a favorable and gracious countenance, and to accept them as Thou didst accept the offerings of Thy just servant Abel, and the sacrifice of our Patriarch Abraham, and that which Thy high priest Melchisedech offered up to Thee, a holy Sacrifice, an immaculate Victim.","fr":"Daignez jeter sur ces offrandes un regard favorable et bienveillant, et les agréer comme vous avez daigné agréer les présents de votre serviteur Abel le juste, le sacrifice de notre patriarche Abraham, et celui que vous offrit votre grand prêtre Melchisédech : sacrifice saint, hostie sans tache."}},{"id":"supplices","phase":"Preface & Canon","section":"Canon after Consecration","title":{"en":"Offering of the Mystical Body","fr":"Offrande du Corps mystique"},"subtitle":{"en":"Supplices te rogamus","fr":"Supplices te rogamus"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The Church asks that those who receive from this altar may be filled with heavenly blessing and grace.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Súpplices te rogámus, omnípotens Deus: iube hæc perférri per manus sancti Angeli tui in sublíme altáre tuum, in conspéctu divínæ maiestátis tuæ: ut, quotquot ex hac altáris participatióne sacrosánctum Fílii tui Cor ✠ pus, et Sán ✠ guinem sumpsérimus, omni benedictióne coelésti et grátia repleámur. Per eúndem Christum, Dóminum nostrum. Amen.","en":"Humbly we beseech Thee, almighty God, to command that these our offerings be carried by the hands of Thy holy Angel to Thine Altar on high, in the sight of Thy divine Majesty, so that those of us who shall receive the most sacred Body ✠ and Blood ✠ of Thy Son by partaking thereof from this Altar may be filled with every grace and heavenly blessing: Through the same Christ our Lord. Amen.","fr":"Nous vous supplions humblement, Dieu tout-puissant : commandez que ces offrandes soient portées par les mains de votre saint Ange sur votre autel sublime, en présence de votre divine Majesté, afin que nous tous qui, participant à cet autel, recevrons le Corps ✠ et le Sang ✠ très saints de votre Fils, soyons remplis de toute bénédiction céleste et de toute grâce. Par le même Christ notre Seigneur. Ainsi soit-il."}},{"id":"memento-dead","phase":"Preface & Canon","section":"Canon after Consecration","title":{"en":"Memento of the Dead","fr":"Mémento des défunts"},"subtitle":{"en":"Memento etiam, Domine","fr":"Memento etiam, Domine"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The faithful departed are remembered and commended to the place of refreshment, light and peace.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Meménto étiam, Dómine, famulórum famularúmque tuárum N. et N., qui nos præcessérunt cum signo fídei, et dórmiunt in somno pacis. Ipsis, Dómine, et ómnibus in Christo quiescéntibus locum refrigérii, lucis pacis ut indúlgeas, deprecámur. Per eúndem Christum, Dóminum nostrum. Amen.","en":"Be mindful, also, O Lord, of Thy servants and handmaids N. and N. who are gone before us with the sign of faith and who sleep the sleep of peace. To these, O Lord, and to all who rest in Christ, grant, we beseech Thee, a place of refreshment, light and peace. Through the same Christ our Lord. Amen.","fr":"Souvenez-vous aussi, Seigneur, de vos serviteurs et servantes N. et N., qui nous ont précédés marqués du signe de la foi et dorment du sommeil de la paix. À eux, Seigneur, et à tous ceux qui reposent dans le Christ, accordez, nous vous en supplions, le lieu du rafraîchissement, de la lumière et de la paix. Par le même Christ notre Seigneur. Ainsi soit-il."}},{"id":"nobis-quoque","phase":"Preface & Canon","section":"Canon after Consecration","title":{"en":"Communion of the Saints","fr":"Communion des saints"},"subtitle":{"en":"Nobis quoque peccatoribus","fr":"Nobis quoque peccatoribus"},"actor":"celebrant","priestPosition":"Centre","audibility":"mixed","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The celebrant briefly raises his voice at Nobis quoque peccatoribus, then continues the prayer quietly.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Nobis quoque peccatóribus fámulis tuis, de multitúdine miseratiónum tuárum sperántibus, partem áliquam et societátem donáre dignéris, cum tuis sanctis Apóstolis et Martýribus: cum Ioánne, Stéphano, Matthía, Bárnaba, Ignátio, Alexándro, Marcellíno, Petro, Felicitáte, Perpétua, Agatha, Lúcia, Agnéte, Cæcília, Anastásia, et ómnibus Sanctis tuis: intra quorum nos consórtium, non æstimátor mériti, sed véniæ, quaesumus, largítor admítte. Per Christum, Dóminum nostrum.","en":"To us also Thy sinful servants, who put our trust in the multitude of Thy mercies, vouchsafe to grant some part and fellowship with Thy holy Apostles and Martyrs: with John, Stephen, Matthias, Barnabas, Ignatius, Alexander, Marcellinus, Peter, Felicitas, Perpetua, Agatha, Lucy, Agnes, Cecilia, Anastasia, and all Thy Saints. Into their company we beseech Thee admit us, not considering our merits, but freely pardoning our offenses. Through Christ our Lord.","fr":"À nous aussi, vos serviteurs pécheurs, qui espérons en l’abondance de vos miséricordes, daignez accorder quelque part et société avec vos saints Apôtres et Martyrs : Jean, Étienne, Matthias, Barnabé, Ignace, Alexandre, Marcellin, Pierre, Félicité, Perpétue, Agathe, Lucie, Agnès, Cécile, Anastasie et tous vos saints. Admettez-nous, nous vous en supplions, dans leur compagnie, non en considération de nos mérites, mais en nous accordant largement votre pardon. Par le Christ notre Seigneur."},"audibleFragment":{"lat":"Nóbis quoque peccatóribus…","en":"To us also, Thy sinful servants…","fr":"À nous aussi, pécheurs, vos serviteurs…"}},{"id":"canon-doxology","phase":"Preface & Canon","section":"Canon after Consecration","title":{"en":"Conclusion of the Canon","fr":"Conclusion du Canon"},"subtitle":{"en":"Per quem · Per ipsum","fr":"Per quem · Per ipsum"},"actor":"celebrant","priestPosition":"Centre","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"Per ómnia sǽcula sæculórum · Amen","explanation":"The Canon ends with the great doxology. Its final Per omnia sæcula sæculorum is heard aloud and answered Amen.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Per quem hæc ómnia, Dómine, semper bona creas, sancti ✠ ficas, viví ✠ ficas, bene ✠ dícis et præstas nobis.\n\nPer ip ✠ sum, et cum ip ✠ so, et in ip ✠ so, est tibi Deo Patri ✠ omnipotenti, in unitáte Spíritus ✠ Sancti, omnis honor, et glória.\n℣. Per ómnia sǽcula sæculórum.\n℟. Amen.","en":"By whom, O Lord, Thou dost always create, sanctify ✠, quicken ✠, bless ✠, and bestow upon us all these good things.\n\nThrough Him ✠, and with Him ✠, and in Him ✠, is unto Thee, God the Father ✠ Almighty, in the unity of the Holy ✠ Ghost, all honor and glory.\n℣. World without end.\n℟. Amen.","fr":"Par lui, Seigneur, vous ne cessez de créer tous ces biens, de les sanctifier ✠, de les vivifier ✠, de les bénir ✠ et de nous les donner.\n\nPar lui ✠, avec lui ✠ et en lui ✠, à vous, Dieu le Père ✠ tout-puissant, dans l’unité du Saint ✠ Esprit, tout honneur et toute gloire.\n℣. Dans tous les siècles des siècles.\n℟. Ainsi soit-il."}},{"id":"pater","phase":"Communion","section":"Pater & Fraction","title":{"en":"Pater noster","fr":"Pater noster"},"subtitle":{"en":"The Lord’s Prayer","fr":"La prière du Seigneur"},"actor":"celebrant","priestPosition":"Centre","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The priest sings or says the Lord’s Prayer; the minister or choir answers Sed libera nos a malo, and the celebrant continues with the embolism Libera nos.","customNote":"The 1962 books do not impose one universal posture on the lay congregation here. Follow the established practice of the church unless you have selected a display preference. Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"℣. Orémus. Præcéptis salutáribus móniti, et divína institutione formáti, audémus dícere:\n\nPater noster, qui es in cælis: sanctificétur nomen tuum: advéniat regnum tuum: fiat volúntas tua, sicut in cælo et in terra. Panem nostrum cotidiánum da nobis hódie: et dimítte nobis débita nostra, sicut et nos dimíttimus debitóribus nostris: et ne nos indúcas in tentatiónem.\n℟. Sed líbera nos a malo.\nAmen.","en":"℣. Let us pray. Admonished by saving precepts, and formed by divine teaching, we dare to say:\n\nOur Father, who art in heaven, hallowed be Thy name; Thy kingdom come; Thy will be done on earth as it is in heaven. Give us this day our daily bread; and forgive us our debts as we also forgive our debtors; and lead us not into temptation.\n℟. But deliver us from evil.\nAmen.","fr":"℣. Prions. Instruits par les préceptes du Sauveur et formés par l’enseignement divin, nous osons dire :\n\nNotre Père, qui êtes aux cieux, que votre nom soit sanctifié ; que votre règne arrive ; que votre volonté soit faite sur la terre comme au ciel. Donnez-nous aujourd’hui notre pain de chaque jour ; pardonnez-nous nos offenses comme nous pardonnons à ceux qui nous ont offensés ; et ne nous laissez pas succomber à la tentation.\n℟. Mais délivrez-nous du mal.\nAinsi soit-il."}},{"id":"libera-nos","phase":"Communion","section":"Pater & Fraction","title":{"en":"Libera nos","fr":"Libera nos"},"subtitle":{"en":"Deliver us, O Lord","fr":"Délivrez-nous, Seigneur"},"actor":"celebrant","priestPosition":"Centre","audibility":"mixed","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"Per ómnia sæcula sæculórum · Amen","explanation":"The celebrant expands the final petition of the Pater, asking deliverance from every evil through the intercession of Our Lady and the saints. The conclusion breaks the silence with Per omnia sæcula sæculorum.","customNote":"Congregational posture through this transition varies locally. Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Líbera nos, quǽsumus, Dómine, ab ómnibus malis, prætéritis, præséntibus et futúris: et intercedénte beáta et gloriósa semper Vírgine Dei Genetríce María, cum beátis Apóstolis tuis Petro et Paulo, atque Andréa, et ómnibus Sanctis, da propítius pacem in diébus nostris: ut, ope misericórdiæ tuæ adiúti, et a peccáto simus semper líberi et ab omni perturbatióne secúri. Per eúndem Dóminum nostrum Iesum Christum Fílium tuum. Qui tecum vivit et regnat in unitáte Spíritus Sancti Deus.\n℣. Per ómnia sæcula sæculórum.\n℟. Amen.","en":"Deliver us, we beseech Thee, O Lord, from all evils, past, present and to come; and by the intercession of the blessed and glorious ever Virgin Mary, Mother of God, together with Thy blessed Apostles Peter and Paul, and Andrew, and all the Saints, mercifully grant peace in our days: that through the help of Thy mercy we may always be free from sin and safe from all disturbance. Through the same Jesus Christ, Thy Son our Lord, Who liveth and reigneth with Thee in the unity of the Holy Ghost, God.\n℣. World without end.\n℟. Amen.","fr":"Délivrez-nous, Seigneur, nous vous en prions, de tous les maux passés, présents et à venir ; et par l’intercession de la bienheureuse et glorieuse Marie toujours Vierge, Mère de Dieu, de vos bienheureux Apôtres Pierre et Paul, d’André et de tous les saints, daignez, dans votre bonté, donner la paix à nos jours : afin qu’avec le secours de votre miséricorde nous soyons toujours délivrés du péché et à l’abri de tout trouble. Par le même Jésus-Christ, votre Fils, notre Seigneur, qui vit et règne avec vous dans l’unité du Saint-Esprit, Dieu.\n℣. Dans tous les siècles des siècles.\n℟. Ainsi soit-il."},"audibleFragment":{"lat":"℣. Per ómnia sæcula sæculórum.\n℟. Amen.","en":"℣. World without end.\n℟. Amen.","fr":"℣. Dans tous les siècles des siècles.\n℟. Ainsi soit-il."}},{"id":"fraction-pax","phase":"Communion","section":"Pater & Fraction","title":{"en":"Fraction · Pax Domini","fr":"Fraction · Pax Domini"},"subtitle":{"en":"The Host is broken","fr":"L’Hostie est rompue"},"actor":"celebrant","priestPosition":"Centre","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"Pax Dómini sit semper vobíscum","explanation":"After the conclusion of Libera nos, the celebrant breaks the Sacred Host. The public Pax Domini follows and is answered Et cum spiritu tuo.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"℣. Pax ✠ Dómini sit ✠ semper ✠ vobíscum.\n℟. Et cum spíritu tuo.","en":"℣. May the peace ✠ of the Lord be ✠ always ✠ with you.\n℟. And with thy spirit.","fr":"℣. Que la paix ✠ du Seigneur soit ✠ toujours ✠ avec vous.\n℟. Et avec votre esprit."}},{"id":"commingling","phase":"Communion","section":"Pater & Fraction","title":{"en":"Commingling","fr":"Immixtion"},"subtitle":{"en":"Hæc commixtio","fr":"Hæc commixtio"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"A particle of the Sacred Host is placed in the chalice while the celebrant says Haec commixtio.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Hæc commíxtio et consecrátio Córporis et Sánguinis Dómini nostri Iesu Christi fiat accipiéntibus nobis in vitam ætérnam. Amen.","en":"May this mingling and consecration of the Body and Blood of our Lord Jesus Christ be for us who receive it unto life everlasting. Amen.","fr":"Que ce mélange et cette consécration du Corps et du Sang de notre Seigneur Jésus-Christ nous procurent, à nous qui les recevons, la vie éternelle. Ainsi soit-il."}},{"id":"agnus","phase":"Communion","section":"Preparation for Communion","title":{"en":"Agnus Dei","fr":"Agnus Dei"},"subtitle":{"en":"Lamb of God","fr":"Agneau de Dieu"},"actor":"mixed","priestPosition":"Centre","audibility":"mixed","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"gestures":[{"kind":"action","label":"Strike breast ×3","anchorLat":"Agnus Dei","anchorEng":"Lamb of God","before":true,"status":"custom"}],"explanation":"The Agnus Dei is invoked three times after the fraction and commingling: the first two invocations ask mercy and the third asks peace.","customNote":"The Pilgrim’s Booklet presents the breast-striking gesture as the practical action of the faithful here. Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Agnus Dei, qui tollis peccáta mundi: miserére nobis.\nAgnus Dei, qui tollis peccáta mundi: miserére nobis.\nAgnus Dei, qui tollis peccáta mundi: dona nobis pacem.","en":"Lamb of God, who takest away the sins of the world: have mercy on us.\nLamb of God, who takest away the sins of the world: have mercy on us.\nLamb of God, who takest away the sins of the world: grant us peace.","fr":"Agneau de Dieu, qui enlevez les péchés du monde : ayez pitié de nous.\nAgneau de Dieu, qui enlevez les péchés du monde : ayez pitié de nous.\nAgneau de Dieu, qui enlevez les péchés du monde : donnez-nous la paix."},"choir":[{"id":"agnus-choir","text":{"lat":"Agnus Dei, qui tollis peccáta mundi: miserére nobis.\nAgnus Dei, qui tollis peccáta mundi: miserére nobis.\nAgnus Dei, qui tollis peccáta mundi: dona nobis pacem.","en":"Lamb of God, who takest away the sins of the world: have mercy on us.\nLamb of God, who takest away the sins of the world: have mercy on us.\nLamb of God, who takest away the sins of the world: grant us peace.","fr":"Agneau de Dieu, qui enlevez les péchés du monde : ayez pitié de nous.\nAgneau de Dieu, qui enlevez les péchés du monde : ayez pitié de nous.\nAgneau de Dieu, qui enlevez les péchés du monde : donnez-nous la paix."},"timing":"simultaneous"}]},{"id":"peace-prayer","phase":"Communion","section":"Preparation for Communion","title":{"en":"Prayer for Peace","fr":"Prière pour la paix"},"subtitle":{"en":"Domine Iesu Christe, qui dixisti","fr":"Domine Iesu Christe, qui dixisti"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The celebrant asks for the peace and unity of the Church. Where the ceremonial Pax is exchanged, it follows this prayer before the remaining private prayers.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Dómine Iesu Christe, qui dixísti Apóstolis tuis: Pacem relínquo vobis, pacem meam do vobis:\nne respícias peccáta mea, sed fidem Ecclésiæ tuæ; eámque secúndum voluntátem tuam pacificáre et coadunáre dignéris:\nQui vivis et regnas Deus per ómnia sæcula sæculórum. Amen.","en":"O Lord Jesus Christ, Who saidst to Thine Apostles: Peace I leave you, My peace I give you:\nregard not my sins, but the faith of Thy Church; and vouchsafe to grant her peace and unity according to Thy will:\nWho livest and reignest God, world without end. Amen.","fr":"Seigneur Jésus-Christ, qui avez dit à vos Apôtres : Je vous laisse la paix, je vous donne ma paix ; ne regardez pas mes péchés, mais la foi de votre Église, et daignez, selon votre volonté, lui donner la paix et l’unité. Vous qui vivez et régnez, Dieu, dans tous les siècles des siècles. Ainsi soit-il."}},{"id":"communion-prep-fili","phase":"Communion","section":"Preparation for Communion","title":{"en":"Prayer before Communion","fr":"Prière avant la Communion"},"subtitle":{"en":"Domine Iesu Christe, Fili Dei vivi","fr":"Domine Iesu Christe, Fili Dei vivi"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The celebrant asks to be delivered from every iniquity and to remain always united to Christ.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Dómine Iesu Christe, Fili Dei vivi, qui ex voluntáte Patris, cooperánte Spíritu Sancto, per mortem tuam mundum vivificásti: líbera me per hoc sacrosánctum Corpus et Sánguinem tuum ab ómnibus iniquitátibus meis, et univérsis malis: et fac me tuis semper inhærére mandátis, et a te numquam separári permíttas: Qui cum eódem Deo Patre et Spíritu Sancto vivis et regnas Deus in saecula sæculórum. Amen.","en":"O Lord Jesus Christ, Son of the living God, Who, by the will of the Father and the co-operation of the Holy Ghost, hast by Thy death given life to the world: deliver me by this, Thy most sacred Body and Blood, from all my iniquities and from every evil; make me cling always to Thy commandments, and permit me never to be separated from Thee. Who with the same God, the Father and the Holy Ghost, livest and reignest God, world without end. Amen.","fr":"Seigneur Jésus-Christ, Fils du Dieu vivant, qui, selon la volonté du Père et avec la coopération du Saint-Esprit, avez donné la vie au monde par votre mort ; délivrez-moi par votre Corps et votre Sang sacrés de tous mes péchés et de tous les maux ; faites que je m’attache toujours à vos commandements et ne permettez pas que je sois jamais séparé de vous. Vous qui, étant Dieu, vivez et régnez avec le même Dieu le Père et le Saint-Esprit dans les siècles des siècles. Ainsi soit-il."}},{"id":"communion-prep-perceptio","phase":"Communion","section":"Preparation for Communion","title":{"en":"Prayer before Communion","fr":"Prière avant la Communion"},"subtitle":{"en":"Perceptio Corporis tui","fr":"Perceptio Corporis tui"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The celebrant asks that reception of the Sacrament may not bring judgment or condemnation, but healing of soul and body.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Percéptio Córporis tui, Dómine Iesu Christe, quod ego indígnus súmere præsúmo, non mihi provéniat in iudícium et condemnatiónem: sed pro tua pietáte prosit mihi ad tutaméntum mentis et córporis, et ad medélam percipiéndam: Qui vivis et regnas cum Deo Patre in unitáte Spíritus Sancti Deus, per ómnia saecula sæculórum. Amen.","en":"Let not the partaking of Thy Body, O Lord Jesus Christ, which I, though unworthy, presume to receive, turn to my judgment and condemnation; but through Thy mercy may it be unto me a safeguard and a healing remedy both of soul and body. Who livest and reignest with God the Father, in the unity of the Holy Ghost, God, world without end. Amen.","fr":"Que la réception de votre Corps, que j’ose prendre tout indigne que je suis, Seigneur Jésus-Christ, n’entraîne pour moi ni jugement ni condamnation ; mais que, par votre bonté, elle serve de soutien et de remède à mon âme et à mon corps. Vous qui, étant Dieu, vivez et régnez avec Dieu le Père dans l’unité du Saint-Esprit, dans tous les siècles des siècles. Ainsi soit-il."}},{"id":"priest-communion","phase":"Communion","section":"Holy Communion","title":{"en":"Communion of the Priest","fr":"Communion du prêtre"},"subtitle":{"en":"Sacred Host and Precious Blood","fr":"Sainte Hostie et Précieux Sang"},"actor":"mixed","priestPosition":"Centre","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The celebrant communicates himself first. At Sung Mass the Communion antiphon begins with the priest’s sacramental Communion; if the faithful communicate, the chant continues through the preparatory Communion rite and distribution.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Panem cæléstem accípiam, et nomen Dómini invocábo.\nDómine, non sum dignus, ut intres sub tectum meum: sed tantum dic verbo, et sanábitur ánima mea. (3×)\nCorpus ✠ Dómini nostri Iesu Christi custódiat ánimam meam in vitam ætérnam. Amen.\nQuid retríbuam Dómino pro ómnibus quæ retríbuit mihi? Cálicem salutáris accípiam, et nomen Dómini invocábo. Laudans invocábo Dóminum, et ab inimícis meis salvus ero.\nSanguis ✠ Dómini nostri Iesu Christi custódiat ánimam meam in vitam ætérnam. Amen.","en":"I will take the Bread of heaven and call upon the name of the Lord.\nLord, I am not worthy that Thou shouldst enter under my roof; but only say the word and my soul shall be healed. (3×)\nMay the Body ✠ of our Lord Jesus Christ preserve my soul unto life everlasting. Amen.\nWhat return shall I make to the Lord for all that He hath given me? I will take the chalice of salvation and call upon the name of the Lord. Praising I will call upon the Lord, and I shall be saved from my enemies.\nMay the Blood ✠ of our Lord Jesus Christ preserve my soul unto life everlasting. Amen.","fr":"Je prendrai le Pain du ciel et j’invoquerai le nom du Seigneur.\nSeigneur, je ne suis pas digne que vous entriez sous mon toit ; mais dites seulement une parole et mon âme sera guérie. (3×)\nQue le Corps ✠ de notre Seigneur Jésus-Christ garde mon âme pour la vie éternelle. Ainsi soit-il.\nQue rendrai-je au Seigneur pour tous ses bienfaits envers moi ? Je prendrai le calice du salut et j’invoquerai le nom du Seigneur. J’invoquerai le Seigneur en le louant et je serai sauvé de mes ennemis.\nQue le Sang ✠ de notre Seigneur Jésus-Christ garde mon âme pour la vie éternelle. Ainsi soit-il."}},{"id":"ecce","phase":"Communion","section":"Holy Communion","title":{"en":"Ecce Agnus Dei","fr":"Ecce Agnus Dei"},"subtitle":{"en":"Behold the Lamb of God","fr":"Voici l’Agneau de Dieu"},"actor":"celebrant","priestPosition":"Centre facing the people","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"Ecce Agnus Dei","explanation":"The priest turns toward the faithful and shows the Sacred Host. This is the clear audible and visual landmark before the three Domine, non sum dignus immediately preceding distribution of Communion.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Ecce Agnus Dei, ecce qui tollit peccáta mundi.","en":"Behold the Lamb of God, behold Him who taketh away the sins of the world.","fr":"Voici l’Agneau de Dieu, voici celui qui enlève les péchés du monde."}},{"id":"domine-non-sum-dignus","phase":"Communion","section":"Holy Communion","title":{"en":"Domine, non sum dignus","fr":"Domine, non sum dignus"},"subtitle":{"en":"Before Communion · three times","fr":"Avant la Communion · trois fois"},"actor":"celebrant","priestPosition":"Facing the faithful / altar rail","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The celebrant says Domine, non sum dignus three times immediately before Communion is distributed; congregational recitation is a traditional/local practice.","customNote":"The 1962 Communion rubric places the threefold Domine, non sum dignus with the celebrant before distribution. The Pilgrim’s Booklet presents the faithful as joining it; the app keeps the altar role and congregational practice distinct. Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","participationHint":"℟. You may join ×3","text":{"lat":"[ROLE=PRIEST]\nDómine, non sum dignus, ut intres sub tectum meum: sed tantum dic verbo, et sanábitur ánima mea. (3×)\n[/ROLE]","en":"[ROLE=PRIEST]\nLord, I am not worthy that Thou shouldst enter under my roof; but only say the word and my soul shall be healed. (3×)\n[/ROLE]","fr":"[ROLE=PRIEST]\n\n[/ROLE]"}},{"id":"communion-faithful","phase":"Communion","section":"Holy Communion","title":{"en":"Communion of the Faithful","fr":"Communion des fidèles"},"subtitle":{"en":"Communion chant accompanies the distribution","fr":"Le chant de Communion accompagne la distribution"},"actor":"mixed","priestPosition":"Communion rail","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"When the faithful communicate, distribution follows Ecce Agnus Dei and the threefold Domine, non sum dignus. The Communion chant has already begun with the priest’s Communion and may continue throughout the distribution; the celebrant’s own recitation of the Communion proper occurs later, after the ablutions.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Corpus ✠ Dómini nostri Iesu Christi custódiat ánimam tuam in vitam ætérnam. Amen.","en":"May the Body ✠ of our Lord Jesus Christ preserve thy soul unto life everlasting. Amen.","fr":"Que le Corps ✠ de notre Seigneur Jésus-Christ garde votre âme pour la vie éternelle. Ainsi soit-il."},"concurrentProperChoir":"communion"},{"id":"ablutions","phase":"Communion","section":"After Communion","title":{"en":"Ablutions","fr":"Ablutions"},"subtitle":{"en":"Purification of the sacred vessels","fr":"Purification des vases sacrés"},"actor":"celebrant","priestPosition":"Centre / Epistle side","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The priest purifies the sacred vessels and prays that Holy Communion may have its full effect in him. The canonical Communion-antiphon event has ended before the ablutions; any additional music here is a separate local/custom musical continuation, not the canonical Proper event.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Quod ore súmpsimus, Dómine, pura mente capiámus: et de múnere temporáli fiat nobis remédium sempitérnum.\nCorpus tuum, Dómine, quod sumpsi, et Sanguis, quem potávi, adhǽreat viscéribus meis: et præsta; ut in me non remáneat scélerum mácula, quem pura et sancta refecérunt sacraménta: Qui vivis et regnas in sæcula sæculórum. Amen.","en":"Grant, O Lord, that what we have taken with our mouth we may receive with a pure mind; and that from a temporal gift it may become for us an everlasting remedy.\nMay Thy Body, O Lord, which I have received, and Thy Blood which I have drunk, cleave to my inmost parts; and grant that no stain of sin remain in me, whom these pure and holy mysteries have refreshed. Who livest and reignest world without end. Amen.","fr":"Ce que nous avons reçu par la bouche, Seigneur, que nous l’embrassions d’une âme pure, et que de ce don temporel nous vienne un remède éternel.\nQue votre Corps, Seigneur, que j’ai reçu, et votre Sang que j’ai bu, adhèrent à mes entrailles ; et faites qu’aucune tache de péché ne demeure en moi, que de purs et saints mystères ont restauré. Vous qui vivez et régnez dans les siècles des siècles. Ainsi soit-il."}},{"id":"communion-proper","phase":"Communion","section":"After Communion","title":{"en":"Communion Antiphon","fr":"Antienne de Communion"},"subtitle":{"en":"At the altar after the ablutions","fr":"À l’autel après les ablutions"},"actor":"celebrant","priestPosition":"Epistle side","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"This is the celebrant’s recitation of the Communion proper after the ablutions. At a Sung Mass you may already have heard the choir sing it during Communion.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","properSlot":"communion"},{"id":"postcommunion","phase":"Conclusion","section":"Final Proper","title":{"en":"Postcommunion","fr":"Postcommunion"},"subtitle":{"en":"Proper prayer","fr":"Prière propre"},"actor":"celebrant","priestPosition":"Epistle side","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"Dóminus vobíscum","explanation":"The final proper oration asks that the mysteries received bear fruit in Christian life.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","properSlot":"postcommunions"},{"id":"dismissal","phase":"Conclusion","section":"Dismissal & Blessing","title":{"en":"Ite, missa est","fr":"Ite, missa est"},"subtitle":{"en":"Final greeting and dismissal","fr":"Salutation finale et renvoi"},"actor":"celebrant","priestPosition":"Centre · facing the people for the dismissal","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"Dóminus vobíscum · dismissal","explanation":"Ite, missa est is the normal 1962 dismissal; the celebrant turns toward the people for the dismissal.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"℣. Dóminus vobíscum.\n℟. Et cum spíritu tuo.\n\n℣. Ite, Missa est.\n℟. Deo grátias.","en":"℣. The Lord be with you.\n℟. And with thy spirit.\n\n℣. Go, the Mass is ended.\n℟. Thanks be to God.","fr":"℣. Le Seigneur soit avec vous.\n℟. Et avec votre esprit.\n\n℣. Allez, la Messe est dite.\n℟. Nous rendons grâces à Dieu."}},{"id":"placeat","phase":"Conclusion","section":"Dismissal & Blessing","title":{"en":"Placeat tibi","fr":"Placeat tibi"},"subtitle":{"en":"Prayer before leaving the altar","fr":"Prière avant de quitter l’autel"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The celebrant asks the Holy Trinity to accept the sacrifice he has offered. The blessing follows.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Pláceat tibi, sancta Trínitas, obséquium servitútis meæ: et præsta; ut sacrifícium,\nquod óculis tuæ maiestátis indígnus óbtuli, tibi sit acceptábile, mihíque et ómnibus,\npro quibus illud óbtuli, sit, te miseránte, propitiábile. Per Christum Dóminum nostrum. Amen.","en":"May the homage of my service be pleasing to Thee, O holy Trinity; and grant that the sacrifice which I,\nthough unworthy, have offered in the sight of Thy Majesty, may be acceptable to Thee, and through Thy mercy\nbe a propitiation for me and for all those for whom I have offered it. Through Christ our Lord. Amen.","fr":"Agréez, Trinité sainte, l’hommage de mon ministère ; et faites que le sacrifice que, malgré mon indignité, j’ai offert aux regards de votre Majesté vous soit agréable et que, par votre miséricorde, il puisse attirer votre faveur sur moi et sur tous ceux pour lesquels je l’ai offert. Par le Christ notre Seigneur. Ainsi soit-il."}},{"id":"blessing","phase":"Conclusion","section":"Dismissal & Blessing","title":{"en":"Blessing","fr":"Bénédiction"},"subtitle":{"en":"Benedicat vos omnipotens Deus","fr":"Benedicat vos omnipotens Deus"},"actor":"celebrant","priestPosition":"Centre facing the people","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"gestures":[{"kind":"cross","label":"Sign of the cross","anchorLat":"Benedícat vos","anchorEng":"May almighty God bless you","before":true,"status":"custom"}],"explanation":"The celebrant gives the final blessing; it is omitted in a Requiem Mass and in certain special endings.","customNote":"Receive the blessing kneeling and make the sign of the cross. Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Benedícat vos omnípotens Deus, Pater, et Fílius, ✠ et Spíritus Sanctus.\n℟. Amen.","en":"May almighty God bless you: the Father, and the Son, ✠ and the Holy Ghost.\n℟. Amen.","fr":"Que le Dieu tout-puissant vous bénisse : le Père, et le Fils, ✠ et le Saint-Esprit.\n℟. Ainsi soit-il."}},{"id":"last-gospel-announcement","phase":"Conclusion","section":"Last Gospel","title":{"en":"Last Gospel · Announcement","fr":"Dernier Évangile · annonce"},"subtitle":{"en":"Dominus vobiscum · Initium sancti Evangelii","fr":"Dominus vobiscum · Initium sancti Evangelii"},"actor":"celebrant","priestPosition":"Gospel side","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"gestures":[{"kind":"cross","label":"Forehead · lips · breast","anchorLat":"Initium ✠ sancti Evangélii","anchorEng":"The beginning ✠ of the holy Gospel","before":true,"status":"custom"}],"landmark":"Dóminus vobíscum · Initium sancti Evangelii","explanation":"The celebrant announces the Last Gospel at the Gospel side. The faithful often imitate the small crosses made at the Gospel announcement.","customNote":"As at the Gospel, make the three small crosses. Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"℣. Dóminus vobíscum.\n℟. Et cum spíritu tuo.\nInitium ✠ sancti Evangélii secúndum Ioánnem.\n℟. Glória tibi, Dómine.","en":"℣. The Lord be with you.\n℟. And with thy spirit.\nThe beginning ✠ of the holy Gospel according to Saint John.\n℟. Glory be to Thee, O Lord.","fr":"℣. Le Seigneur soit avec vous.\n℟. Et avec votre esprit.\nCommencement ✠ du saint Évangile selon saint Jean.\n℟. Gloire à vous, Seigneur."}},{"id":"last-gospel","phase":"Conclusion","section":"Last Gospel","title":{"en":"Last Gospel","fr":"Dernier Évangile"},"subtitle":{"en":"In principio erat Verbum · John 1:1–14","fr":"In principio erat Verbum · John 1:1–14"},"actor":"celebrant","priestPosition":"Gospel side","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"gestures":[{"kind":"genuflect","status":"custom","label":"Traditional/local genuflection","anchorLat":"ET VERBUM CARO FACTUM EST.","anchorEng":"AND THE WORD WAS MADE FLESH.","before":true},{"kind":"rise","label":"Rise","anchorLat":"ET VERBUM CARO FACTUM EST.","anchorEng":"AND THE WORD WAS MADE FLESH.","after":true,"status":"custom"}],"explanation":"The Prologue of Saint John normally closes the Mass; the traditional genuflection occurs at Et Verbum caro factum est.","customNote":"The Pilgrim’s Booklet directs the faithful to genuflect at Et Verbum caro factum est. Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"In princípio erat Verbum, et Verbum erat apud Deum, et Deus erat Verbum. Hoc erat in princípio apud Deum.\nÓmnia per ipsum facta sunt: et sine ipso factum est nihil, quod factum est. In ipso vita erat, et vita erat lux hóminum:\net lux in ténebris lucet, et ténebræ eam non comprehendérunt.\n\nFuit homo missus a Deo, cui nomen erat Ioánnes. Hic venit in testimónium, ut testimónium perhibéret de lúmine,\nut omnes créderent per illum. Non erat ille lux, sed ut testimónium perhibéret de lúmine. Erat lux vera,\nquæ illúminat omnem hóminem veniéntem in hunc mundum. In mundo erat, et mundus per ipsum factus est,\net mundus eum non cognóvit. In própria venit, et sui eum non recepérunt. Quotquot autem recepérunt eum,\ndedit eis potestátem fílios Dei fíeri, his, qui credunt in nómine eius: qui non ex sanguínibus, neque ex voluntáte carnis,\nneque ex voluntáte viri, sed ex Deo nati sunt.\n\nET VERBUM CARO FACTUM EST.\n\nEt habitávit in nobis: et vídimus glóriam eius, glóriam quasi Unigéniti a Patre, plenum grátiæ et veritátis.\n℟. Deo grátias.","en":"In the beginning was the Word, and the Word was with God, and the Word was God. The same was in the beginning with God.\nAll things were made by Him; and without Him was made nothing that was made. In Him was life, and the life was the light of men.\nAnd the light shineth in darkness, and the darkness did not comprehend it.\n\nThere was a man sent from God, whose name was John. This man came for a witness, to give testimony of the light,\nthat all men might believe through him. He was not the light, but was to give testimony of the light. That was the true light,\nwhich enlighteneth every man that cometh into this world. He was in the world, and the world was made by Him, and the world knew Him not.\nHe came unto His own, and His own received Him not. But as many as received Him, He gave them power to be made the sons of God,\nto them that believe in His name: who are born, not of blood, nor of the will of the flesh, nor of the will of man, but of God.\n\nAND THE WORD WAS MADE FLESH.\n\nAnd dwelt among us: and we saw His glory, the glory as it were of the Only-begotten of the Father, full of grace and truth.\n℟. Thanks be to God.","fr":"Au commencement était le Verbe, et le Verbe était auprès de Dieu, et le Verbe était Dieu. Il était au commencement auprès de Dieu.\nToutes choses ont été faites par lui, et rien de ce qui a été fait n’a été fait sans lui. En lui était la vie, et la vie était la lumière des hommes.\nEt la lumière luit dans les ténèbres, et les ténèbres ne l’ont point comprise.\n\nIl y eut un homme envoyé de Dieu, appelé Jean. Il vint comme témoin, pour rendre témoignage à la lumière, afin que tous crussent par lui. Il n’était pas lui-même la lumière, mais il devait rendre témoignage à la lumière. Celui-là était la vraie lumière qui éclaire tout homme venant en ce monde. Il était dans le monde, et le monde a été fait par lui, et le monde ne l’a pas connu.\nIl est venu chez lui, et les siens ne l’ont pas reçu. Mais à tous ceux qui l’ont reçu, il a donné le pouvoir de devenir enfants de Dieu, à ceux qui croient en son nom : eux qui ne sont nés ni du sang, ni de la volonté de la chair, ni de la volonté de l’homme, mais de Dieu.\n\nET LE VERBE S’EST FAIT CHAIR.\n\nEt il a habité parmi nous ; et nous avons vu sa gloire, gloire qu’il tient de son Père comme Fils unique, plein de grâce et de vérité.\n℟. Nous rendons grâces à Dieu."}}];},29:function(module,exports,require){module.exports=[{"id":"sign-cross","phase":"Mass of the Catechumens","section":"Prayers at the Foot","title":{"en":"Sign of the Cross · Introibo","fr":"Signe de la Croix · Introibo"},"subtitle":{"en":"At the foot of the altar","fr":"Au bas de l’autel"},"actor":"celebrant","priestPosition":"Foot of the altar","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"gestures":[{"kind":"cross","label":"Sign of the cross","anchorLat":"In nómine Patris","anchorEng":"In the Name of the Father","before":true,"status":"custom"}],"explanation":"The celebrant begins below the altar with the sign of the cross, then says Introibo ad altare Dei; the ministers answer Ad Deum qui laetificat iuventutem meam. At a Sung Mass the choir may already be singing the Introit.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"In nómine Patris, ✠ et Fílii, et Spíritus Sancti. Amen.\n\n℣. Introíbo ad altáre Dei.\n℟. Ad Deum, qui lætíficat iuventútem meam.","en":"In the Name of the Father, ✠ and of the Son, and of the Holy Ghost. Amen.\n\n℣. I will go in unto the altar of God.\n℟. Unto God, Who giveth joy to my youth.","fr":"Au nom du Père, ✠ et du Fils, et du Saint-Esprit. Ainsi soit-il."}},{"id":"judica","phase":"Mass of the Catechumens","section":"Prayers at the Foot","title":{"en":"Psalm 42 · Judica me","fr":"Psaume 42 · Judica me"},"subtitle":{"en":"Priest and ministers alternate the psalm","fr":"Le prêtre et les ministres alternent le psaume"},"actor":"celebrant","priestPosition":"Foot of the altar","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The priest and ministers alternate Psalm 42, then repeat Introibo / Ad Deum. The psalm is omitted in Masses for the Dead and from Passion Sunday through Holy Saturday.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Ps 42, 1-5\nS. Iúdica me, Deus, et discérne causam meam de gente non sancta: ab hómine iníquo et dolóso érue me.\nM. Quia tu es, Deus, fortitudo mea: quare me reppulísti, et quare tristis incédo, dum afflígit me inimícus?\nS. Emítte lucem tuam et veritátem tuam: ipsa me deduxérunt, et adduxérunt in montem sanctum tuum et in tabernácula tua.\nM. Et introíbo ad altáre Dei: ad Deum, qui lætíficat iuventútem meam.\nS. Confitébor tibi in cíthara, Deus, Deus meus: quare tristis es, ánima mea, et quare contúrbas me?\nM. Spera in Deo, quóniam adhuc confitébor illi: salutáre vultus mei, et Deus meus.\nS. Glória Patri, et Fílio, et Spirítui Sancto.\nM. Sicut erat in princípio, et nunc, et semper: et in saecula sæculórum. Amen.\n\n℣. Introíbo ad altáre Dei.\n℟. Ad Deum, qui lætíficat iuventútem meam.","en":"Ps 42, 1-5\nS. Judge me, O God, and distinguish my cause from the nation that is not holy: deliver me from the unjust and deceitful man.\nM. For Thou, O God, art my strength: why hast Thou cast me off? and why do I go sorrowful whilst the enemy afflicteth me?\nS. Send forth Thy light and Thy truth: they have led me and brought me unto Thy holy hill, and into Thy tabernacles.\nM. And I will go in unto the Altar of God: unto God, Who giveth joy to my youth.\nS. I will praise Thee upon the harp, O God, my God: why art thou sad, O my soul? and why dost thou disquiet me?\nM. Hope thou in God, for I will yet praise Him: Who is the salvation of my countenance, and my God.\nS. Glory be to the Father, and to the Son, and to the Holy Ghost.\nM. As it was in the beginning, is now, and ever shall be, world without end. Amen.\n\n℣. I will go in unto the altar of God.\n℟. Unto God, Who giveth joy to my youth.","fr":"Ps 42, 1-5\nS. Jugez-moi, ô Dieu, et séparez ma cause de celle d’un peuple impie ; délivrez-moi de l’homme injuste et trompeur.\nM. Car vous êtes, ô Dieu, ma force : pourquoi m’avez-vous repoussé ? et pourquoi dois-je marcher dans la tristesse, tandis que l’ennemi m’afflige ?\nS. Envoyez votre lumière et votre vérité : elles m’ont conduit et amené à votre montagne sainte et dans vos tabernacles.\nM. Et j’irai vers l’autel de Dieu : vers Dieu qui réjouit ma jeunesse.\nS. Je vous louerai sur la harpe, ô Dieu, mon Dieu. Pourquoi es-tu triste, ô mon âme, et pourquoi me troubles-tu ?\nM. Espère en Dieu, car je le louerai encore : lui, le salut de mon visage et mon Dieu.\nS. Gloire au Père, et au Fils, et au Saint-Esprit.\nM. Comme il était au commencement, maintenant et toujours, et dans les siècles des siècles. Ainsi soit-il."}},{"id":"adjutorium","phase":"Mass of the Catechumens","section":"Prayers at the Foot","title":{"en":"Adjutorium nostrum","fr":"Adjutorium nostrum"},"subtitle":{"en":"Our help is in the Name of the Lord","fr":"Notre secours est dans le Nom du Seigneur"},"actor":"celebrant","priestPosition":"Foot of the altar","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"gestures":[{"kind":"cross","label":"Sign of the cross","anchorLat":"Adiutórium nostrum ✠","anchorEng":"Our help ✠","before":true,"status":"custom"}],"explanation":"The priest says Adiutorium nostrum in nomine Domini and the ministers answer Qui fecit caelum et terram. The printed ✠ marks the traditional sign of the cross.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"℣. Adiutórium nostrum ✠ in nómine Dómini.\n℟. Qui fecit coelum et terram.","en":"℣. Our help ✠ is in the Name of the Lord.\n℟. Who hath made heaven and earth.","fr":"℣. Notre secours ✠ est dans le nom du Seigneur.\n℟. Qui a fait le ciel et la terre."}},{"id":"priest-confiteor","phase":"Mass of the Catechumens","section":"Prayers at the Foot","title":{"en":"Confiteor of the Priest","fr":"Confiteor du prêtre"},"subtitle":{"en":"The celebrant confesses first","fr":"Le célébrant se confesse en premier"},"actor":"celebrant","priestPosition":"Foot of the altar","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The celebrant makes the first Confiteor, saying et vobis, fratres. The ministers answer Misereatur tui; the priest replies Amen.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"[ROLE=PRIEST]\nConfíteor Deo omnipoténti, beátæ Maríæ semper Vírgini, beáto Michaéli Archángelo, beáto Ioánni Baptístæ,\nsanctis Apóstolis Petro et Paulo, ómnibus Sanctis, et vobis, fratres: quia peccávi nimis cogitatióne, verbo et opere:\nmea culpa, mea culpa, mea máxima culpa. Ideo precor beátam Maríam semper Vírginem, beátum Michaélem Archángelum,\nbeátum Ioánnem Baptístam, sanctos Apóstolos Petrum et Paulum, omnes Sanctos, et vos, fratres,\noráre pro me ad Dóminum Deum nostrum.\n[/ROLE]\n\n[ROLE=MINISTERS]\nMisereátur tui omnípotens Deus, et, dimíssis peccátis tuis, perdúcat te ad vitam ætérnam.\n[/ROLE]\n\n[ROLE=PRIEST]\nAmen.\n[/ROLE]","en":"[ROLE=PRIEST]\nI confess to almighty God, to blessed Mary ever Virgin, to blessed Michael the Archangel, to blessed John the Baptist,\nto the holy Apostles Peter and Paul, to all the Saints, and to you, brethren, that I have sinned exceedingly in thought,\nword and deed: through my fault, through my fault, through my most grievous fault. Therefore I beseech blessed Mary ever Virgin,\nblessed Michael the Archangel, blessed John the Baptist, the holy Apostles Peter and Paul, all the Saints, and you, brethren,\nto pray to the Lord our God for me.\n[/ROLE]\n\n[ROLE=MINISTERS]\nMay Almighty God have mercy upon you, forgive you your sins, and bring you to life everlasting.\n[/ROLE]\n\n[ROLE=PRIEST]\nAmen.\n[/ROLE]","fr":"[ROLE=PRIEST]\nJe confesse à Dieu tout-puissant, à la bienheureuse Marie toujours Vierge, à saint Michel Archange, à saint Jean-Baptiste, aux saints Apôtres Pierre et Paul, à tous les saints, et à vous, mes frères, que j’ai beaucoup péché par pensée, par parole et par action : c’est ma faute, c’est ma faute, c’est ma très grande faute. C’est pourquoi je supplie la bienheureuse Marie toujours Vierge, saint Michel Archange, saint Jean-Baptiste, les saints Apôtres Pierre et Paul, tous les saints, et vous, mes frères, de prier pour moi le Seigneur notre Dieu.\n[/ROLE]\n\n[ROLE=MINISTERS]\nQue Dieu tout-puissant vous fasse miséricorde, qu’il vous pardonne vos péchés et vous conduise à la vie éternelle.\n[/ROLE]\n\n[ROLE=PRIEST]\nAinsi soit-il.\n[/ROLE]"}},{"id":"ministers-confiteor","phase":"Mass of the Catechumens","section":"Prayers at the Foot","title":{"en":"Confiteor of the Ministers","fr":"Confiteor des ministres"},"subtitle":{"en":"The ministers confess before the priest","fr":"Les ministres se confessent devant le prêtre"},"actor":"celebrant","priestPosition":"Foot of the altar","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"gestures":[{"kind":"action","label":"Strike breast ×3","anchorLat":"mea culpa, mea culpa, mea máxima culpa","anchorEng":"through my fault, through my fault, through my most grievous fault","before":true,"status":"custom"}],"explanation":"The ministers make the second Confiteor at the foot of the altar, using et tibi, pater. The priest then answers with the prayers of mercy in the following distinct moments.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"[ROLE=MINISTERS]\nConfíteor Deo omnipoténti, beátæ Maríæ semper Vírgini, beáto Michaéli Archángelo, beáto Ioánni Baptístæ, sanctis Apóstolis Petro et Paulo, ómnibus Sanctis, et tibi, pater: quia peccávi nimis cogitatióne, verbo et opere: mea culpa, mea culpa, mea máxima culpa. Ideo precor beátam Maríam semper Vírginem, beátum Michaélem Archángelum, beátum Ioánnem Baptístam, sanctos Apóstolos Petrum et Paulum, omnes Sanctos, et te, pater, orare pro me ad Dóminum, Deum nostrum.\n[/ROLE]","en":"[ROLE=MINISTERS]\nI confess to Almighty God, to blessed Mary ever Virgin, to blessed Michael the Archangel, to blessed John the Baptist, to the holy Apostles Peter and Paul, to all the Saints, and to you Father, that I have sinned exceedingly, in thought, word and deed: through my fault, through my fault, through my most grievous fault. Therefore I beseech blessed Mary ever Virgin, blessed Michael the Archangel, blessed John the Baptist, the holy Apostles Peter and Paul, all the Saints, and Thee Father, to pray to the Lord our God for me.\n[/ROLE]","fr":"[ROLE=MINISTERS]\nJe confesse à Dieu tout-puissant, à la bienheureuse Marie toujours Vierge, à saint Michel Archange, à saint Jean-Baptiste, aux saints Apôtres Pierre et Paul, à tous les saints, et à vous, mon Père, que j’ai beaucoup péché par pensée, par parole et par action : c’est ma faute, c’est ma faute, c’est ma très grande faute. C’est pourquoi je supplie la bienheureuse Marie toujours Vierge, saint Michel Archange, saint Jean-Baptiste, les saints Apôtres Pierre et Paul, tous les saints, et vous, mon Père, de prier pour moi le Seigneur notre Dieu.\n[/ROLE]"}},{"id":"misereatur-vestri","phase":"Mass of the Catechumens","section":"Preparation","title":{"en":"Misereatur vestri","fr":"Misereatur vestri"},"subtitle":{"en":"Prayer of mercy after the ministers’ Confiteor","fr":"Prière de miséricorde après le Confiteor des ministres"},"actor":"celebrant","priestPosition":"Foot of the altar","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The priest prays that Almighty God may have mercy, forgive sins and lead the ministers and faithful to everlasting life; the ministers answer Amen.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"[ROLE=PRIEST]\nMisereátur vestri omnípotens Deus, et, dimíssis peccátis vestris, perdúcat vos ad vitam ætérnam.\n[/ROLE]\n\n[ROLE=MINISTERS]\nAmen.\n[/ROLE]","en":"[ROLE=PRIEST]\nMay Almighty God have mercy upon you, forgive you your sins and bring you to life everlasting.\n[/ROLE]\n\n[ROLE=MINISTERS]\nAmen.\n[/ROLE]","fr":"[ROLE=PRIEST]\nQue Dieu tout-puissant vous fasse miséricorde, qu’il vous pardonne vos péchés et vous conduise à la vie éternelle.\n[/ROLE]\n\n[ROLE=MINISTERS]\nAinsi soit-il.\n[/ROLE]"}},{"id":"indulgentiam-absolution","phase":"Mass of the Catechumens","section":"Preparation","title":{"en":"Indulgentiam · Absolution","fr":"Indulgentiam · Absolution"},"subtitle":{"en":"Pardon, absolution and remission of sins","fr":"Pardon, absolution et rémission des péchés"},"actor":"celebrant","priestPosition":"Foot of the altar","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"gestures":[{"kind":"cross","label":"Sign of the cross","anchorLat":"Indulgéntiam","anchorEng":"May the Almighty and merciful God","before":true,"status":"custom"}],"explanation":"The priest says Indulgentiam, asking the Almighty and merciful Lord for pardon, absolution and remission of sins. This is the liturgical prayer at the foot of the altar, not sacramental absolution in Confession.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"[ROLE=PRIEST]\nIndulgéntiam, ✠ absolutionem et remissiónem peccatórum nostrórum tríbuat nobis omnípotens et miséricors Dóminus.\n[/ROLE]\n\n[ROLE=MINISTERS]\nAmen.\n[/ROLE]","en":"[ROLE=PRIEST]\nMay the Almighty and merciful God grant us pardon, ✠ absolution, and remission of our sins.\n[/ROLE]\n\n[ROLE=MINISTERS]\nAmen.\n[/ROLE]","fr":"[ROLE=PRIEST]\nQue le Dieu tout-puissant et miséricordieux nous accorde le pardon, ✠ l’absolution et la rémission de nos péchés.\n[/ROLE]\n\n[ROLE=MINISTERS]\nAinsi soit-il.\n[/ROLE]"}},{"id":"foot-versicles","phase":"Mass of the Catechumens","section":"Preparation","title":{"en":"Versicles before the Ascent","fr":"Versets avant la montée à l’autel"},"subtitle":{"en":"Deus, tu conversus · Ostende nobis · Domine, exaudi","fr":"Deus, tu conversus · Ostende nobis · Domine, exaudi"},"actor":"celebrant","priestPosition":"Foot of the altar","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The priest and ministers exchange the concluding versicles of the prayers at the foot, ending with Dominus vobiscum / Et cum spiritu tuo and Oremus before the priest ascends the altar.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"℣. Deus, tu convérsus vivificábis nos.\n℟. Et plebs tua lætábitur in te.\n℣. Osténde nobis, Dómine, misericórdiam tuam.\n℟. Et salutáre tuum da nobis.\n℣. Dómine, exáudi oratiónem meam.\n℟. Et clamor meus ad te véniat.\n℣. Dóminus vobíscum.\n℟. Et cum spíritu tuo.\n℣. Orémus.","en":"℣. Thou wilt turn, O God, and bring us to life.\n℟. And Thy people shall rejoice in Thee.\n℣. Show us, O Lord, Thy mercy.\n℟. And grant us Thy salvation.\n℣. O Lord, hear my prayer.\n℟. And let my cry come unto Thee.\n℣. The Lord be with you.\n℟. And with thy spirit.\n℣. Let us pray.","fr":"℣. Ô Dieu, vous vous retournerez vers nous et vous nous rendrez la vie.\n℟. Et votre peuple se réjouira en vous.\n℣. Montrez-nous, Seigneur, votre miséricorde.\n℟. Et donnez-nous votre salut.\n℣. Seigneur, exaucez ma prière.\n℟. Et que mon cri parvienne jusqu’à vous.\n℣. Le Seigneur soit avec vous.\n℟. Et avec votre esprit.\n℣. Prions."}},{"id":"ascend","phase":"Mass of the Catechumens","section":"Prayers at the Foot","title":{"en":"The priest ascends the altar","fr":"Le prêtre monte à l’autel"},"subtitle":{"en":"Aufer a nobis","fr":"Aufer a nobis"},"actor":"celebrant","priestPosition":"Steps of the altar","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The celebrant asks that his sins be taken away as he ascends to the altar.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Aufer a nobis, quaesumus, Dómine, iniquitátes nostras: ut ad Sancta sanctórum puris mereámur méntibus introíre. Per Christum, Dóminum nostrum. Amen.","en":"Take away from us our iniquities, we entreat Thee, O Lord, that with pure minds we may worthily enter into the Holy of Holies. Through Christ our Lord. Amen.","fr":"Enlevez de nous nos iniquités, nous vous en supplions, Seigneur, afin que nous méritions d’entrer avec une âme pure dans le Saint des saints. Par le Christ notre Seigneur. Ainsi soit-il."}},{"id":"oramus-te","phase":"Mass of the Catechumens","section":"Prayers at the Foot","title":{"en":"Prayer at the Altar","fr":"Prière à l’autel"},"subtitle":{"en":"Oramus te, Domine","fr":"Oramus te, Domine"},"actor":"celebrant","priestPosition":"Centre of the altar","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"At the altar the celebrant asks pardon through the merits of the saints whose relics are enclosed there, and kisses the altar.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Orámus te, Dómine, per mérita Sanctórum tuórum, quorum relíquiæ hic sunt, et ómnium Sanctórum: ut indulgére dignéris ómnia peccáta mea. Amen.","en":"We beseech Thee, O Lord, by the merits of Thy Saints, whose relics are here and of all the Saints, that Thou wilt deign to pardon me all my sins. Amen.","fr":"Nous vous prions, Seigneur, par les mérites de vos saints dont les reliques sont ici, et de tous les saints, de daigner me pardonner tous mes péchés. Ainsi soit-il."}},{"id":"introit","phase":"Mass of the Catechumens","section":"Entrance","title":{"en":"Introit","fr":"Introït"},"subtitle":{"en":"Proper of the day","fr":"Propre du jour"},"actor":"celebrant","priestPosition":"Epistle side","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The entrance antiphon gives the Mass its opening scriptural text. In a Sung Mass the choir’s chant and the celebrant’s recitation are parallel actions.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","properSlot":"introit"},{"id":"kyrie","phase":"Mass of the Catechumens","section":"Entrance","title":{"en":"Kyrie eleison","fr":"Kyrie eleison"},"subtitle":{"en":"Ninefold plea for mercy","fr":"Neuf invocations de miséricorde"},"actor":"celebrant","priestPosition":"Epistle side / centre","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The Kyrie is a ninefold invocation for mercy, recited or sung in Greek.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Kýrie, eléison. (3×)\nChriste, eléison. (3×)\nKýrie, eléison. (3×)","en":"Lord, have mercy. (3×)\nChrist, have mercy. (3×)\nLord, have mercy. (3×)","fr":"Seigneur, ayez pitié. (3×)\nChrist, ayez pitié. (3×)\nSeigneur, ayez pitié. (3×)"}},{"id":"gloria","phase":"Mass of the Catechumens","section":"Entrance","title":{"en":"Gloria in excelsis Deo","fr":"Gloria in excelsis Deo"},"subtitle":{"en":"Hymn of praise","fr":"Hymne de louange"},"actor":"celebrant","priestPosition":"Centre","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"gestures":[{"kind":"cross","label":"Sign of the cross","anchorLat":"Cum Sancto Spíritu","anchorEng":"With the Holy Ghost","before":true,"status":"custom"}],"explanation":"The Gloria is a festal hymn beginning with the angels’ song at Bethlehem. At its conclusion, Cum Sancto Spiritu, the sign of the cross is customarily made.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Glória in excélsis Deo. Et in terra pax homínibus bonæ voluntátis. Laudámus te. Benedícimus te. Adorámus te. Glorificámus te. Grátias ágimus tibi propter magnam glóriam tuam. Dómine Deus, Rex cæléstis, Deus Pater omnípotens. Dómine Fili unigénite, Iesu Christe. Dómine Deus, Agnus Dei, Fílius Patris. Qui tollis peccáta mundi, miserére nobis. Qui tollis peccáta mundi, súscipe deprecatiónem nostram. Qui sedes ad déxteram Patris, miserére nobis. Quóniam tu solus Sanctus. Tu solus Dóminus. Tu solus Altíssimus, Iesu Christe. Cum Sancto Spíritu ✠ in glória Dei Patris. Amen.","en":"Glory to God in the highest. And on earth peace to men of good will. We praise Thee; we bless Thee; we adore Thee; we glorify Thee; we give Thee thanks for Thy great glory. Lord God, heavenly King, God the Father almighty. Lord Jesus Christ, only-begotten Son. Lord God, Lamb of God, Son of the Father. Thou who takest away the sins of the world, have mercy on us. Thou who takest away the sins of the world, receive our prayer. Thou who sittest at the right hand of the Father, have mercy on us. For Thou alone art holy; Thou alone art Lord; Thou alone art the Most High, Jesus Christ. With the Holy Ghost ✠ in the glory of God the Father. Amen.","fr":"GLOIRE À DIEU au plus haut des cieux. Et paix sur la terre aux hommes de bonne volonté. Nous vous louons. Nous vous bénissons. Nous vous adorons. Nous vous glorifions. Nous vous rendons grâces pour votre immense gloire. Seigneur Dieu, Roi du ciel, Dieu le Père tout-puissant. Seigneur Fils unique, Jésus-Christ. Seigneur Dieu, Agneau de Dieu, Fils du Père. Vous qui enlevez les péchés du monde, ayez pitié de nous. Vous qui enlevez les péchés du monde, accueillez notre prière. Vous qui êtes assis à la droite du Père, ayez pitié de nous. Car vous seul êtes Saint, vous seul êtes Seigneur, vous seul êtes le Très-Haut, Jésus-Christ, avec le Saint-Esprit ✠ dans la gloire de Dieu le Père. Ainsi soit-il."}},{"id":"collect","phase":"Mass of the Catechumens","section":"Collect & Readings","title":{"en":"Collect","fr":"Collecte"},"subtitle":{"en":"Proper prayer","fr":"Prière propre"},"actor":"celebrant","priestPosition":"Epistle side","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"Dóminus vobíscum","explanation":"The Collect gathers the Church’s prayer into the proper oration of the day; additional orations may be joined when commemorations are prescribed.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","properSlot":"collects"},{"id":"epistle","phase":"Mass of the Catechumens","section":"Collect & Readings","title":{"en":"Epistle or Lesson","fr":"Épître ou Lecture"},"subtitle":{"en":"Proper reading","fr":"Lecture propre"},"actor":"celebrant","priestPosition":"Epistle side","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The first scriptural reading. It may come from an Epistle or another book of Scripture. Deo gratias is the response.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","properSlot":"epistle"},{"id":"gradual","phase":"Mass of the Catechumens","section":"Collect & Readings","title":{"en":"Gradual","fr":"Graduel"},"subtitle":{"en":"Proper chant","fr":"Chant propre"},"actor":"celebrant","priestPosition":"Altar","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"This proper chant follows the Lesson in the order supplied by the 1962 Proper. At Low Mass it is read aloud by the celebrant; at Sung Mass the schola's chant provides the audible track.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","properSlot":"preGospelChants"},{"id":"alleluia","phase":"Mass of the Catechumens","section":"Collect & Readings","title":{"en":"Alleluia","fr":"Alleluia"},"subtitle":{"en":"Proper chant","fr":"Chant propre"},"actor":"celebrant","priestPosition":"Altar","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"This proper chant follows the Lesson in the order supplied by the 1962 Proper. At Low Mass it is read aloud by the celebrant; at Sung Mass the schola's chant provides the audible track.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","properSlot":"preGospelChants"},{"id":"gospel-prep","phase":"Mass of the Catechumens","section":"Gospel & Creed","title":{"en":"Preparation for the Gospel","fr":"Préparation à l’Évangile"},"subtitle":{"en":"Munda cor meum · Iube, Domine","fr":"Munda cor meum · Iube, Domine"},"actor":"celebrant","priestPosition":"Centre","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The celebrant prepares for the Gospel while the chant may still be continuing.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Munda cor meum ac lábia mea, omnípotens Deus, qui lábia Isaíæ Prophétæ cálculo mundásti igníto:\nita me tua grata miseratióne dignáre mundáre, ut sanctum Evangélium tuum digne váleam nuntiáre.\nPer Christum Dóminum nostrum. Amen.\n\nIube, Dómine, benedícere. Dóminus sit in corde meo et in lábiis meis:\nut digne et competénter annúntiem Evangélium suum. Amen.","en":"Cleanse my heart and my lips, O almighty God, Who didst cleanse the lips of the prophet Isaias with a burning coal:\nthrough Thy gracious mercy so purify me that I may worthily proclaim Thy holy Gospel. Through Christ our Lord. Amen.\n\nGrant, O Lord, Thy blessing. May the Lord be in my heart and on my lips,\nthat I may worthily and fittingly proclaim His Gospel. Amen.","fr":"Purifiez mon cœur et mes lèvres, Dieu tout-puissant, qui avez purifié les lèvres du prophète Isaïe avec un charbon ardent ; daignez aussi me purifier par votre miséricordieuse bonté, afin que je puisse proclamer dignement votre saint Évangile. Par le Christ notre Seigneur. Ainsi soit-il.\n\nSeigneur, veuillez me bénir. Que le Seigneur soit dans mon cœur et sur mes lèvres, afin que j’annonce dignement et convenablement son Évangile. Ainsi soit-il."}},{"id":"gospel-announcement","phase":"Mass of the Catechumens","section":"Gospel & Creed","title":{"en":"Gospel Announcement","fr":"Annonce de l’Évangile"},"subtitle":{"en":"Dominus vobiscum · Sequentia sancti Evangelii","fr":"Dominus vobiscum · Sequentia sancti Evangelii"},"actor":"celebrant","priestPosition":"Gospel side","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"gestures":[{"kind":"cross","label":"Forehead · lips · breast","anchorLat":"Sequéntia ✠ sancti Evangélii secúndum Lucam.","anchorEng":"Continuation ✠ of the Holy Gospel according to Luke","before":true,"status":"custom"}],"landmark":"Dóminus vobíscum","explanation":"The Gospel is announced with Dominus vobiscum, its title, and Gloria tibi, Domine before the text is proclaimed.","customNote":"The Pilgrim’s Booklet directs the faithful to make the three small Gospel crosses on forehead, lips and breast. Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"℣. Dóminus vobíscum.\n℟. Et cum spíritu tuo.\n\nSequéntia ✠ sancti Evangélii secúndum Lucam.\n\n℟. Glória tibi, Dómine.","en":"℣. The Lord be with you.\n℟. And with thy spirit.\n\nContinuation ✠ of the Holy Gospel according to Luke\n\n℟. Glory be to Thee, O Lord.","fr":"℣. Le Seigneur soit avec vous.\n℟. Et avec votre esprit.\n\nSequéntia ✠ sancti Evangélii secúndum Lucam."}},{"id":"gospel","phase":"Mass of the Catechumens","section":"Gospel & Creed","title":{"en":"Holy Gospel","fr":"Saint Évangile"},"subtitle":{"en":"Proper of the day","fr":"Propre du jour"},"actor":"celebrant","priestPosition":"Gospel side","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"Listen standing to the Gospel. At the end the response is Laus tibi, Christe; the celebrant kisses the book and says Per evangelica dicta.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","properSlot":"gospel"},{"id":"credo","phase":"Mass of the Catechumens","section":"Gospel & Creed","title":{"en":"Credo","fr":"Credo"},"subtitle":{"en":"Nicene Creed","fr":"Credo de Nicée"},"actor":"celebrant","priestPosition":"Centre","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"gestures":[{"kind":"genuflect","status":"custom","label":"Traditional/local genuflection","anchorLat":"Et incarnátus est","anchorEng":"And was incarnate","before":true},{"kind":"rise","status":"custom","label":"Rise","anchorLat":"et homo factus est.","anchorEng":"and was made man.","after":true},{"kind":"cross","status":"custom","label":"Traditional sign of the cross","anchorLat":"Et vitam ✠ ventúri sæculi","anchorEng":"the life ✠ of the world to come","before":true}],"explanation":"The Nicene Creed is professed at Masses where the rubrics prescribe it. The celebrant genuflects at Et incarnatus est; congregational imitation is a traditional/local practice.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Credo in unum Deum, Patrem omnipoténtem, factórem cæli et terræ, visibílium ómnium et invisibílium. Et in unum Dóminum Iesum Christum, Fílium Dei unigénitum. Et ex Patre natum ante ómnia sæcula. Deum de Deo, lumen de lúmine, Deum verum de Deo vero. Génitum, non factum, consubstantiálem Patri: per quem ómnia facta sunt. Qui propter nos hómines et propter nostram salútem descéndit de cælis. Et incarnátus est de Spíritu Sancto ex María Vírgine: et homo factus est. Crucifíxus étiam pro nobis: sub Póntio Piláto passus, et sepúltus est. Et resurréxit tértia die, secúndum Scriptúras. Et ascéndit in cælum: sedet ad déxteram Patris. Et íterum ventúrus est cum glória iudicáre vivos et mórtuos: cuius regni non erit finis. Et in Spíritum Sanctum, Dóminum et vivificántem: qui ex Patre Filióque procédit. Qui cum Patre et Fílio simul adorátur et conglorificátur: qui locútus est per Prophétas. Et unam sanctam cathólicam et apostólicam Ecclésiam. Confíteor unum baptísma in remissiónem peccatórum. Et exspécto resurrectiónem mortuórum. Et vitam ✠ ventúri sæculi. Amen.","en":"I believe in one God, the Father almighty, maker of heaven and earth, and of all things visible and invisible. And in one Lord Jesus Christ, the Only-begotten Son of God, born of the Father before all ages. God of God, Light of Light, true God of true God. Begotten, not made: consubstantial with the Father; by Whom all things were made. Who for us men, and for our salvation, came down from heaven. And was incarnate by the Holy Ghost of the Virgin Mary: and was made man. He was crucified also for us, suffered under Pontius Pilate, and was buried. And on the third day He rose again according to the Scriptures. And He ascended into heaven, and sitteth at the right hand of the Father. And He shall come again with glory to judge the living and the dead: of Whose kingdom there shall be no end. And in the Holy Ghost, the Lord and Giver of Life: Who proceedeth from the Father and the Son. Who together with the Father and the Son is adored and glorified: Who spoke through the Prophets. And in One, Holy, Catholic and Apostolic Church. I confess one Baptism for the remission of sins. And I look for the resurrection of the dead, and the life ✠ of the world to come. Amen.","fr":"JE CROIS en un seul Dieu, le Père tout-puissant, créateur du ciel et de la terre, de l’univers visible et invisible. Et en un seul Seigneur Jésus-Christ, le Fils unique de Dieu, né du Père avant tous les siècles. Dieu de Dieu, Lumière de Lumière, vrai Dieu de vrai Dieu. Engendré, non pas créé, consubstantiel au Père, et par qui tout a été fait. Pour nous les hommes et pour notre salut, il est descendu des cieux. Et il a pris chair de la Vierge Marie par le Saint-Esprit, et s’est fait homme. Crucifié aussi pour nous, il a souffert sous Ponce Pilate et a été enseveli. Il est ressuscité le troisième jour, conformément aux Écritures. Et il est monté au ciel : il siège à la droite du Père. Il reviendra dans la gloire pour juger les vivants et les morts ; et son règne n’aura pas de fin. Je crois en l’Esprit Saint, qui est Seigneur et qui donne la vie ; il procède du Père et du Fils. Avec le Père et le Fils, il reçoit même adoration et même gloire ; il a parlé par les prophètes. Je crois l’Église, une, sainte, catholique et apostolique. Je reconnais un seul baptême pour la rémission des péchés. J’attends la résurrection des morts et la vie ✠ du monde à venir. Ainsi soit-il."}},{"id":"offertory","phase":"Offertory","section":"Proper & Offering","title":{"en":"Offertory","fr":"Offertoire"},"subtitle":{"en":"Dominus vobiscum · Oremus · Proper antiphon","fr":"Dominus vobiscum · Oremus · antienne propre"},"actor":"celebrant","priestPosition":"Centre, then altar","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"Dóminus vobíscum","explanation":"The Mass of the Faithful begins. The proper Offertory antiphon accompanies the preparation of the sacrifice.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","properSlot":"offertory"},{"id":"offer-host","phase":"Offertory","section":"Proper & Offering","title":{"en":"Offering of the Host","fr":"Offrande de l’Hostie"},"subtitle":{"en":"Suscipe, sancte Pater","fr":"Suscipe, sancte Pater"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The priest offers the bread prepared for consecration while praying Suscipe, sancte Pater.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Suscipe, sancte Pater, omnipotens ætérne Deus, hanc immaculátam hóstiam, quam ego indígnus fámulus tuus óffero tibi Deo meo vivo et vero, pro innumerabílibus peccátis, et offensiónibus, et neglegéntiis meis, et pro ómnibus circumstántibus, sed et pro ómnibus fidélibus christiánis vivis atque defúnctis: ut mihi, et illis profíciat ad salútem in vitam ætérnam. Amen.","en":"Accept, O Holy father, Almighty and Eternal God, this spotless host, which I, Your unworthy servant, offer to You, my living and true God, to atone for my numberless sins, offences, and negligences; on behalf of all here present and likewise for all faithful Christians living and dead, that it may profit me and them as a means of salvation to life everlasting. Amen.","fr":"Recevez, Père saint, Dieu éternel et tout-puissant, cette hostie sans tache que moi, votre indigne serviteur, je vous offre, à vous mon Dieu vivant et vrai, pour mes innombrables péchés, offenses et négligences, pour tous ceux qui m’entourent, et pour tous les fidèles chrétiens vivants et morts ; qu’elle serve à mon salut et au leur pour la vie éternelle. Ainsi soit-il."}},{"id":"water-wine","phase":"Offertory","section":"Proper & Offering","title":{"en":"Blessing of the Water","fr":"Bénédiction de l’eau"},"subtitle":{"en":"Deus, qui humanae","fr":"Deus, qui humanae"},"actor":"celebrant","priestPosition":"Epistle side / centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"A little water is mixed with the wine. The prayer links Christ’s sharing in our humanity with our sharing in His divinity.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Deus, qui humánæ substántiæ dignitátem mirabíliter condidísti, et mirabílius reformásti: da nobis per huius aquæ et vini mystérium, eius divinitátis esse consórtes, qui humanitátis nostræ fíeri dignátus est párticeps, Iesus Christus, Fílius tuus, Dóminus noster: Qui tecum vivit et regnat in unitáte Spíritus Sancti Deus: per ómnia saecula sæculórum. Amen.","en":"O God, who in creating man didst exalt his nature very wonderfully and yet more wonderfully didst establish it anew; by the Mystery signified in the mingling of this water and wine, grant us to have part in the Godhead of Him Who hath deigned to become a partaker of our humanity, Jesus Christ, Thy Son our Lord; Who liveth and reigneth with Thee, in the unity of the Holy Ghost, God. World without end. Amen.","fr":"Ô Dieu, qui avez merveilleusement créé la dignité de la nature humaine et l’avez plus merveilleusement encore restaurée, accordez-nous, par le mystère de cette eau et de ce vin, d’avoir part à la divinité de celui qui a daigné prendre part à notre humanité, Jésus-Christ, votre Fils, notre Seigneur ; qui vit et règne avec vous dans l’unité du Saint-Esprit, Dieu, dans tous les siècles des siècles. Ainsi soit-il."}},{"id":"offer-chalice","phase":"Offertory","section":"Proper & Offering","title":{"en":"Offering of the Chalice","fr":"Offrande du Calice"},"subtitle":{"en":"Offerimus tibi, Domine","fr":"Offerimus tibi, Domine"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The chalice of salvation is offered for our salvation and that of the whole world.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Offérimus tibi, Dómine, cálicem salutáris, tuam deprecántes cleméntiam: ut in conspéctu divínæ maiestátis tuæ, pro nostra et totíus mundi salute, cum odóre suavitátis ascéndat. Amen.","en":"We offer unto Thee, O Lord, the chalice of salvation, entreating Thy mercy that our offering may ascend with a sweet fragrance in the sight of Thy divine Majesty, for our own salvation, and for that of the whole world. Amen.","fr":"Nous vous offrons, Seigneur, le calice du salut, implorant votre clémence : qu’il s’élève en odeur de suavité devant votre divine Majesté, pour notre salut et celui du monde entier. Ainsi soit-il."}},{"id":"in-spiritu","phase":"Offertory","section":"Proper & Offering","title":{"en":"Prayer of Humility","fr":"Prière d’humilité"},"subtitle":{"en":"In spiritu humilitatis","fr":"In spiritu humilitatis"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The celebrant asks that the sacrifice offered in humility and contrition be pleasing to God.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"In spíritu humilitátis et in ánimo contríto suscipiámur a te, Dómine: et sic fiat sacrifícium nostrum in conspéctu tuo hódie, ut pláceat tibi, Dómine Deus.","en":"Humbled in spirit and contrite of heart, may we find favor with Thee, O Lord: and may our sacrifice be so offered this day in Thy sight as to be pleasing to Thee, O Lord God.","fr":"En esprit d’humilité et le cœur contrit, puissions-nous être accueillis par vous, Seigneur ; et que notre sacrifice s’accomplisse aujourd’hui devant vous de telle sorte qu’il vous soit agréable, Seigneur Dieu."}},{"id":"veni-sanctificator","phase":"Offertory","section":"Proper & Offering","title":{"en":"Invocation of the Holy Ghost","fr":"Invocation du Saint-Esprit"},"subtitle":{"en":"Veni, Sanctificator","fr":"Veni, Sanctificator"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The Holy Ghost is invoked over the sacrifice prepared upon the altar.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Veni, sanctificátor omnípotens ætérne Deus: et bene ✠ dic hoc sacrifícium, tuo sancto nómini præparátum.","en":"Come Thou, the Sanctifier, Almighty and Everlasting God, and bless ✠ this sacrifice which is prepared for the glory of Thy holy Name.","fr":"Venez, Sanctificateur, Dieu éternel et tout-puissant, et bénissez ✠ ce sacrifice préparé pour la gloire de votre saint Nom."}},{"id":"lavabo","phase":"Offertory","section":"Altar Preparation","title":{"en":"Lavabo","fr":"Lavabo"},"subtitle":{"en":"Psalm 25","fr":"Psalm 25"},"actor":"celebrant","priestPosition":"Epistle side","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The priest washes his fingers while praying Psalm 25, an outward sign of the inward purity appropriate to the sacred mysteries.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Ps 25, 6–12\nLavábo inter innocéntes manus meas: et circúmdabo altáre tuum, Dómine:\nUt áudiam vocem laudis, et enárrem univérsa mirabília tua.\nDómine, diléxi decórem domus tuæ et locum habitatiónis glóriæ tuæ.\nNe perdas cum ímpiis, Deus, ánimam meam, et cum viris sánguinum vitam meam:\nIn quorum mánibus iniquitátes sunt: déxtera eórum repléta est munéribus.\nEgo autem in innocéntia mea ingréssus sum: rédime me et miserére mei.\nPes meus stetit in dirécto: in ecclésiis benedícam te, Dómine.\n℣. Glória Patri, et Fílio, et Spirítui Sancto.\n℟. Sicut erat in princípio, et nunc, et semper: et in sǽcula sæculórum. Amen.","en":"Ps 25, 6–12\nI will wash my hands among the innocent, and I will encompass Thine Altar, O Lord.\nThat I may hear the voice of praise, and tell of all Thy wondrous works.\nI have loved, O Lord, the beauty of Thy house, and the place where Thy glory dwelleth.\nTake not away my soul, O God, with the wicked, nor my life with men of blood.\nIn whose hands are iniquities, their right hand is filled with gifts.\nBut as for me, I have walked in my innocence; redeem me, and have mercy on me.\nMy foot hath stood in the right way; in the churches I will bless Thee, O Lord.\n℣. Glory be to the Father, and to the Son, and to the Holy Ghost.\n℟. As it was in the beginning, is now, and ever shall be, world without end. Amen.","fr":"Ps 25, 6–12\nJe laverai mes mains parmi les innocents, et je me tiendrai autour de votre autel, Seigneur,\nafin d’entendre la voix de la louange et de raconter toutes vos merveilles.\nSeigneur, j’aime la beauté de votre maison et le lieu où habite votre gloire.\nNe perdez pas, ô Dieu, mon âme avec les impies, ni ma vie avec les hommes de sang,\ndont les mains commettent l’iniquité et dont la droite est remplie de présents.\nPour moi, je marche dans l’innocence ; rachetez-moi et ayez pitié de moi.\nMon pied s’est tenu dans le droit chemin ; dans les assemblées je vous bénirai, Seigneur.\n℣. Gloire au Père, et au Fils, et au Saint-Esprit.\n℟. Comme il était au commencement, maintenant et toujours, et dans les siècles des siècles. Ainsi soit-il."}},{"id":"suscipe-trinitas","phase":"Offertory","section":"Altar Preparation","title":{"en":"Prayer to the Holy Trinity","fr":"Prière à la Sainte Trinité"},"subtitle":{"en":"Suscipe, sancta Trinitas","fr":"Suscipe, sancta Trinitas"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The oblation is commended to the Holy Trinity in memory of the mysteries of Christ and in honour of the saints.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Súscipe, sancta Trinitas, hanc oblatiónem, quam tibi offérimus ob memóriam passiónis, resurrectiónis, et ascensiónis Iesu Christi, Dómini nostri: et in honórem beátæ Maríæ semper Vírginis, et beáti Ioannis Baptistæ, et sanctórum Apostolórum Petri et Pauli, et istórum et ómnium Sanctórum: ut illis profíciat ad honórem, nobis autem ad salútem: et illi pro nobis intercédere dignéntur in coelis, quorum memóriam ágimus in terris. Per eúndem Christum, Dóminum nostrum. Amen.","en":"Receive, O Holy Trinity, this oblation which we make to Thee in memory of the Passion, Resurrection and Ascension of our Lord Jesus Christ; and in honor of Blessed Mary ever Virgin, of blessed John the Baptist, the holy Apostles Peter and Paul, of these and of all the Saints. To them let it bring honor, and to us salvation, and may they whom we are commemorating here on earth deign to plead for us in heaven. Through the same Christ our Lord. Amen.","fr":"Recevez, Trinité sainte, cette offrande que nous vous présentons en mémoire de la Passion, de la Résurrection et de l’Ascension de Jésus-Christ notre Seigneur ; et en l’honneur de la bienheureuse Marie toujours Vierge, de saint Jean-Baptiste, des saints Apôtres Pierre et Paul, de ceux-ci et de tous les saints : qu’elle serve à leur honneur et à notre salut ; et qu’ils daignent intercéder au ciel pour nous qui faisons mémoire d’eux sur la terre. Par le même Christ notre Seigneur. Ainsi soit-il."}},{"id":"orate-fratres","phase":"Offertory","section":"Conclusion of Offertory","title":{"en":"Orate, fratres","fr":"Orate, fratres"},"subtitle":{"en":"Pray, brethren","fr":"Priez, mes frères"},"actor":"celebrant","priestPosition":"Centre · turns toward the people, then back to the altar","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"Oráte, fratres","explanation":"The celebrant turns toward the people for Orate, fratres, then turns back to the altar while the response is made before the Secret.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"℣. Oráte, fratres: ut meum ac vestrum sacrifícium acceptábile fiat apud Deum Patrem omnipoténtem.\n℟. Suscípiat Dóminus sacrifícium de mánibus tuis ad laudem et glóriam nominis sui, ad utilitátem quoque nostram, totiúsque Ecclésiæ suæ sanctæ.\nAmen.","en":"℣. Pray, brethren, that my Sacrifice and yours may be acceptable to God the Father Almighty.\n℟. May the Lord accept the Sacrifice from thy hands, to the praise and glory of His Name, for our benefit and for that of all His holy Church.\nAmen.","fr":"℣. Priez, mes frères, afin que mon sacrifice, qui est aussi le vôtre, soit agréé par Dieu le Père tout-puissant.\n℟. Que le Seigneur reçoive de vos mains le sacrifice, à la louange et à la gloire de son nom, et aussi pour notre bien et celui de toute sa sainte Église.\nAinsi soit-il."}},{"id":"secret","phase":"Offertory","section":"Conclusion of Offertory","title":{"en":"Secret","fr":"Secrète"},"subtitle":{"en":"Proper prayer · listen for the conclusion","fr":"Prière propre · écoutez la conclusion"},"actor":"celebrant","priestPosition":"Epistle side · toward the missal","audibility":"mixed","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"Per ómnia sǽcula sæculórum","explanation":"The Secret is said quietly. Its final conclusion becomes audible and is one of the easiest landmarks in the Mass: Per omnia sæcula sæculorum — Amen — immediately before the Preface dialogue.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","properSlot":"secrets"},{"id":"preface","phase":"Preface & Canon","section":"Preface","title":{"en":"Preface","fr":"Préface"},"subtitle":{"en":"Sursum corda","fr":"Sursum corda"},"actor":"celebrant","priestPosition":"Epistle side · toward the missal","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"Dóminus vobíscum · Sursum corda","explanation":"The Preface is the solemn prayer of thanksgiving that follows the Sursum corda dialogue and leads into the Sanctus and Roman Canon.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","properSlot":"preface"},{"id":"sanctus","phase":"Preface & Canon","section":"Preface","title":{"en":"Sanctus","fr":"Sanctus"},"subtitle":{"en":"Holy, Holy, Holy","fr":"Saint, Saint, Saint"},"actor":"celebrant","priestPosition":"Centre","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"gestures":[{"kind":"cross","label":"Sign of the cross","anchorLat":"Benedíctus qui venit","anchorEng":"Blessed is He who comes","before":true,"status":"custom"}],"landmark":"Bell at Sanctus","explanation":"The Sanctus concludes the Preface and leads into the Roman Canon. The altar bell is prescribed here; the 1962 Ritus does not itself fix a universal number of Sanctus strokes.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Sanctus, Sanctus, Sanctus Dóminus, Deus Sábaoth. Pleni sunt cæli et terra glória tua. Hosánna in excélsis. Benedíctus qui venit in nómine Dómini. Hosánna in excélsis.","en":"Holy, Holy, Holy, Lord God of Hosts. Heaven and earth are full of Thy glory. Hosanna in the highest. Blessed is He who comes in the name of the Lord. Hosanna in the highest.","fr":"Saint, Saint, Saint le Seigneur, Dieu des armées célestes. Le ciel et la terre sont remplis de votre gloire. Hosanna au plus haut des cieux. Béni soit celui qui vient au nom du Seigneur. Hosanna au plus haut des cieux."},"bells":[{"kind":"bell","label":"Sanctus bell","anchorLat":"Sanctus, Sanctus, Sanctus","anchorEng":"Holy, Holy, Holy","before":true,"pattern":"prescribed · exact count not fixed by the 1962 Ritus","legalStatus":"PRESCRIBED","authority":"RUBRIC_1962"}]},{"id":"te-igitur","phase":"Preface & Canon","section":"Canon before Consecration","title":{"en":"Prayer first for the Church","fr":"Prière d’abord pour l’Église"},"subtitle":{"en":"Te igitur","fr":"Te igitur"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The Roman Canon begins by offering the sacrifice for the Holy Catholic Church.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Te igitur, clementíssime Pater, per Iesum Christum, Fílium tuum, Dóminum nostrum, súpplices rogámus, ac pétimus, uti accepta habeas et benedícas, hæc ✠ dona, hæc ✠ múnera, hæc ✠ sancta sacrifícia illibáta.\n\nIn primis, quæ tibi offérimus pro Ecclésia tua sancta cathólica: quam pacificáre, custodíre, adunáre et régere dignéris toto orbe terrárum: una cum fámulo tuo Papa nostro N. et Antístite nostro et ómnibus orthodóxis, atque cathólicæ et apostólicae fídei cultóribus.","en":"Most merciful Father, we humbly pray and beseech Thee, through Jesus Christ Thy Son, Our Lord, to accept and to bless these ✠ gifts, these ✠ presents, these ✠ holy unspotted Sacrifices,\n\nWe offer them up to Thee, in the first place, for Thy Holy Catholic Church, that it may please Thee to grant her peace, to preserve, unite, and govern her throughout the world; as also for Thy servant N. our Pope, and N. our Bishop, and for all orthodox believers and all who profess the Catholic and Apostolic faith.","fr":"Père très clément, nous vous supplions et vous demandons humblement, par Jésus-Christ votre Fils, notre Seigneur, d’accepter et de bénir ces ✠ dons, ces ✠ présents, ces ✠ sacrifices saints et sans tache,\n\nque nous vous offrons d’abord pour votre sainte Église catholique : daignez lui donner la paix, la garder, l’unir et la gouverner dans le monde entier, avec votre serviteur notre Pape N., notre évêque N., et tous ceux qui, fidèles à la foi catholique et apostolique, la professent et la défendent."}},{"id":"memento-living","phase":"Preface & Canon","section":"Canon before Consecration","title":{"en":"Memento of the Living","fr":"Mémento des vivants"},"subtitle":{"en":"Memento, Domine","fr":"Memento, Domine"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The living for whom the sacrifice is offered are remembered before God.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Meménto, Dómine, famulórum famularúmque tuarum N. et N. et ómnium circumstántium, quorum tibi fides cógnita est et nota devótio, pro quibus tibi offérimus: vel qui tibi ófferunt hoc sacrifícium laudis, pro se suísque ómnibus: pro redemptióne animárum suárum, pro spe salútis et incolumitátis suæ: tibíque reddunt vota sua ætérno Deo, vivo et vero.","en":"Be mindful, O Lord, of Thy servants and handmaids N. and N. and of all here present, whose faith and devotion are known to Thee, for whom we offer, or who offer up to Thee this Sacrifice of praise for themselves and all those dear to them, for the redemption of their souls and the hope of their safety and salvation: who now pay their vows to Thee, the everlasting, living and true God.","fr":"Souvenez-vous, Seigneur, de vos serviteurs et servantes N. et N., et de tous ceux qui nous entourent, dont vous connaissez la foi et la dévotion ; pour eux nous vous offrons, ou eux-mêmes vous offrent, ce sacrifice de louange, pour eux et pour tous les leurs, pour la rédemption de leurs âmes, l’espérance de leur salut et de leur conservation ; et ils acquittent leurs vœux envers vous, Dieu éternel, vivant et vrai."}},{"id":"communicantes","phase":"Preface & Canon","section":"Canon before Consecration","title":{"en":"Our Intercessors in Heaven","fr":"Nos intercesseurs au Ciel"},"subtitle":{"en":"Communicantes","fr":"Communicantes"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The earthly Church joins the Blessed Virgin, Saint Joseph, the Apostles, Martyrs and all the saints.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Communicántes, et memóriam venerántes, in primis gloriósæ semper Vírginis Maríæ, Genetrícis Dei et Dómini nostri Iesu Christi: sed et beati Ioseph, eiusdem Virginis Sponsi, et beatórum Apostolórum ac Mártyrum tuórum, Petri et Pauli, Andréæ, Iacóbi, Ioánnis, Thomæ, Iacóbi, Philíppi, Bartholomaei, Matthaei, Simónis et Thaddaei: Lini, Cleti, Cleméntis, Xysti, Cornélii, Cypriáni, Lauréntii, Chrysógoni, Ioánnis et Pauli, Cosmæ et Damiáni: et ómnium Sanctórum tuórum; quorum méritis precibúsque concédas, ut in ómnibus protectiónis tuæ muniámur auxílio. Per eúndem Christum, Dóminum nostrum. Amen.","en":"In communion with, and honoring the memory in the first place of the glorious ever Virgin Mary Mother of our God and Lord Jesus Christ; also of blessed Joseph, her Spouse; and likewise of Thy blessed Apostles and Martyrs, Peter and Paul, Andrew, James, John, Thomas, James, Philip, Bartholomew, Matthew, Simon and Thaddeus, Linus, Cletus, Clement, Sixtus, Cornelius, Cyprian, Lawrence, Chrysogonus, John and Paul, Cosmas and Damian, and of all Thy Saints. Grant for the sake of their merits and prayers that in all things we may be guarded and helped by Thy protection. Through the same Christ our Lord. Amen.","fr":"Unis dans une même communion et vénérant d’abord la mémoire de la glorieuse Marie toujours Vierge, Mère de notre Dieu et Seigneur Jésus-Christ, puis de saint Joseph son époux, de vos bienheureux Apôtres et Martyrs Pierre et Paul, André, Jacques, Jean, Thomas, Jacques, Philippe, Barthélemy, Matthieu, Simon et Thaddée, Lin, Clet, Clément, Sixte, Corneille, Cyprien, Laurent, Chrysogone, Jean et Paul, Côme et Damien, et de tous vos saints ; par leurs mérites et leurs prières, accordez-nous d’être toujours fortifiés par le secours de votre protection. Par le même Christ notre Seigneur. Ainsi soit-il."}},{"id":"hanc","phase":"Preface & Canon","section":"Canon before Consecration","title":{"en":"Prayer for the whole family of God","fr":"Prière pour toute la famille de Dieu"},"subtitle":{"en":"Hanc igitur","fr":"Hanc igitur"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The celebrant extends his hands over the offerings and asks God to accept the oblation of His whole household. The 1962 Ritus prescribes a warning bell shortly before the Consecration; this screen uses Hanc igitur as the ceremonial synchronization point rather than claiming that exact placement as the wording of the primary rubric.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Hanc igitur oblatiónem servitutis nostræ, sed et cunctae famíliæ tuæ, quaesumus, Dómine, ut placátus accípias: diésque nostros in tua pace dispónas, atque ab ætérna damnatióne nos éripi, et in electórum tuórum iúbeas grege numerári. Per Christum, Dóminum nostrum. Amen.","en":"O Lord, we beseech Thee, graciously to accept this oblation of our service and that of Thy whole household. Order our days in Thy peace, and command that we be rescued from eternal damnation and numbered in the flock of Thine elect. Through Christ our Lord. Amen.","fr":"Cette offrande de notre servitude et de toute votre famille, nous vous en supplions, Seigneur, acceptez-la avec bienveillance ; disposez nos jours dans votre paix, arrachez-nous à la damnation éternelle et daignez nous compter au nombre de vos élus. Par le Christ notre Seigneur. Ainsi soit-il."},"bells":[{"kind":"bell","label":"Warning bell before the Consecration","anchorLat":"Hanc igitur","anchorEng":"This oblation","before":false,"pattern":"prescribed shortly before the Consecration","legalStatus":"PRESCRIBED","authority":"RUBRIC_1962","placementStatus":"CEREMONIAL_SYNCHRONIZATION"}]},{"id":"quam-oblationem","phase":"Preface & Canon","section":"Canon before Consecration","title":{"en":"Prayer immediately before the Consecration","fr":"Prière immédiatement avant la Consécration"},"subtitle":{"en":"Quam oblationem","fr":"Quam oblationem"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The offerings are blessed and commended immediately before the words of institution.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Quam oblatiónem tu, Deus, in ómnibus, quaesumus, bene ✠ díctam, adscríp ✠ tam, ra ✠ tam, rationábilem, acceptabilémque fácere dignéris: ut nobis Cor ✠ pus, et San ✠ guis fiat dilectíssimi Fílii tui, Dómini nostri Iesu Christi.","en":"Humbly we pray Thee, O God, be pleased to make this same offering wholly blessed ✠, to consecrate ✠ it and approve ✠ it, making it reasonable and acceptable, so that it may become for us the Body ✠ and Blood ✠ of Thy dearly beloved Son, our Lord Jesus Christ.","fr":"Daignez, ô Dieu, nous vous en supplions, rendre cette offrande pleinement bénie ✠, agréée ✠, ratifiée ✠, raisonnable et acceptable, afin qu’elle devienne pour nous le Corps ✠ et le Sang ✠ de votre Fils bien-aimé, notre Seigneur Jésus-Christ."}},{"id":"consecration-host","phase":"Preface & Canon","section":"Consecration","title":{"en":"Consecration of the Host","fr":"Consécration de l’Hostie"},"subtitle":{"en":"Hoc est enim Corpus meum","fr":"Hoc est enim Corpus meum"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"BELLS · Elevation of the Host","explanation":"The bread is consecrated; the Sacred Host is elevated for adoration.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Qui prídie quam paterétur, accépit panem in sanctas ac venerábiles manus suas, elevátis óculis in coelum ad te Deum, Patrem suum omnipoténtem, tibi grátias agens, bene ✠ dixit, fregit, dedítque discípulis suis, dicens: Accípite, et manducáte ex hoc omnes.\n\nHOC EST ENIM CORPUS MEUM.","en":"Who, the day before He suffered, took bread into His Holy and venerable hands, and having lifted up His eyes to heaven, to Thee, God, His Almighty Father, giving thanks to Thee, blessed it ✠, broke it, and gave it to His disciples, saying: Take and eat ye all of this.\n\nFOR THIS IS MY BODY.","fr":"La veille de sa Passion, il prit le pain dans ses mains saintes et vénérables et, levant les yeux au ciel vers vous, Dieu, son Père tout-puissant, vous rendant grâces, il le bénit ✠, le rompit et le donna à ses disciples en disant : Prenez et mangez-en tous.\n\nCAR CECI EST MON CORPS."},"bells":[{"kind":"bell","label":"Elevation bells","after":true,"pattern":"3 rings or continuous until the Sacred Species is lowered","legalStatus":"PRESCRIBED","authority":"RUBRIC_1962"}]},{"id":"consecration-chalice","phase":"Preface & Canon","section":"Consecration","title":{"en":"Consecration of the Chalice","fr":"Consécration du Calice"},"subtitle":{"en":"Hic est enim Calix Sanguinis mei","fr":"Hic est enim Calix Sanguinis mei"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"BELLS · Elevation of the Chalice","explanation":"After the words of consecration over the chalice, Haec quotiescumque is said and the chalice is elevated for adoration.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Símili modo postquam coenátum est, accípiens et hunc præclárum Cálicem in sanctas ac venerábiles manus suas: item tibi grátias agens, bene ✠ dixit, dedítque discípulis suis, dicens: Accípite, et bíbite ex eo omnes.\n\nHIC EST ENIM CALIX SÁNGUINIS MEI, NOVI ET ÆTÉRNI TESTAMÉNTI: MYSTÉRIUM FÍDEI: QUI PRO VOBIS ET PRO MULTIS EFFUNDÉTUR IN REMISSIÓNEM PECCATÓRUM.\n\nHæc quotiescúmque fecéritis, in mei memóriam faciétis.","en":"Taking also into His holy and venerable hands this goodly chalice, again giving thanks to Thee, He blessed it ✠, and gave it to His disciples, saying: Take and drink ye all of this.\n\nFOR THIS IS THE CHALICE OF MY BLOOD, OF THE NEW AND ETERNAL TESTAMENT: THE MYSTERY OF FAITH: WHICH SHALL BE SHED FOR YOU AND FOR MANY UNTO THE REMISSION OF SINS.\n\nAs often as ye shall do these things, ye shall do them in remembrance of Me.","fr":"De même, après le repas, prenant aussi ce précieux calice dans ses mains saintes et vénérables, vous rendant encore grâces, il le bénit ✠ et le donna à ses disciples en disant : Prenez et buvez-en tous.\n\nCAR CECI EST LE CALICE DE MON SANG, LE SANG DE L’ALLIANCE NOUVELLE ET ÉTERNELLE : MYSTÈRE DE FOI : QUI SERA RÉPANDU POUR VOUS ET POUR UN GRAND NOMBRE EN RÉMISSION DES PÉCHÉS.\n\nToutes les fois que vous ferez ces choses, vous les ferez en mémoire de moi."},"bells":[{"kind":"bell","label":"Elevation bells","after":true,"pattern":"3 rings or continuous until the Sacred Species is lowered","legalStatus":"PRESCRIBED","authority":"RUBRIC_1962"}]},{"id":"unde-et-memores","phase":"Preface & Canon","section":"Canon after Consecration","title":{"en":"Memory of the Mysteries of Christ","fr":"Mémoire des mystères du Christ"},"subtitle":{"en":"Unde et memores","fr":"Unde et memores"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The Passion, Resurrection and Ascension are recalled as the holy Victim is offered to the Father.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Unde et mémores, Dómine, nos servi tui, sed et plebs tua sancta, eiusdem Christi Fílii tui, Dómini nostri, tam beátæ passiónis, nec non et ab ínferis resurrectiónis, sed et in coelos gloriósæ ascensiónis: offérimus præcláræ maiestáti tuæ de tuis donis ac datis, hóstiam ✠ puram, hóstiam ✠ sanctam, hóstiam ✠ immaculátam, Panem ✠ sanctum vitæ ætérnæ, et Calicem ✠ salútis perpétuæ.","en":"And now, O Lord, we, Thy servants, and with us all Thy holy people, calling to mind the blessed Passion of this same Christ, Thy Son, our Lord, likewise His Resurrection from the grave, and also His glorious Ascension into heaven, do offer unto Thy most sovereign Majesty out of the gifts Thou hast bestowed upon us a Victim ✠ which is pure, a Victim ✠ which is holy, a Victim ✠ which is spotless, the holy Bread ✠ of life eternal, and the Chalice ✠ of everlasting Salvation.","fr":"C’est pourquoi, Seigneur, nous vos serviteurs, et avec nous votre peuple saint, faisant mémoire de la bienheureuse Passion du Christ votre Fils, notre Seigneur, de sa Résurrection des enfers et de sa glorieuse Ascension dans les cieux, nous offrons à votre souveraine Majesté, parmi les dons que vous nous avez faits, l’Hostie ✠ pure, l’Hostie ✠ sainte, l’Hostie ✠ sans tache, le Pain ✠ sacré de la vie éternelle et le Calice ✠ du salut perpétuel."}},{"id":"supra-quae","phase":"Preface & Canon","section":"Canon after Consecration","title":{"en":"The ancient sacrifices recalled","fr":"Rappel des anciens sacrifices"},"subtitle":{"en":"Supra quae","fr":"Supra quae"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The sacrifice is compared with the offerings of Abel, Abraham and Melchisedech.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Supra quæ propítio ac seréno vultu respícere dignéris: et accépta habére, sicúti accépta habére dignátus es múnera púeri tui iusti Abel, et sacrifícium Patriárchæ nostri Abrahæ: et quod tibi óbtulit summus sacérdos tuus Melchísedech, sanctum sacrifícium, immaculátam hóstiam.","en":"Deign to look upon them with a favorable and gracious countenance, and to accept them as Thou didst accept the offerings of Thy just servant Abel, and the sacrifice of our Patriarch Abraham, and that which Thy high priest Melchisedech offered up to Thee, a holy Sacrifice, an immaculate Victim.","fr":"Daignez jeter sur ces offrandes un regard favorable et bienveillant, et les agréer comme vous avez daigné agréer les présents de votre serviteur Abel le juste, le sacrifice de notre patriarche Abraham, et celui que vous offrit votre grand prêtre Melchisédech : sacrifice saint, hostie sans tache."}},{"id":"supplices","phase":"Preface & Canon","section":"Canon after Consecration","title":{"en":"Offering of the Mystical Body","fr":"Offrande du Corps mystique"},"subtitle":{"en":"Supplices te rogamus","fr":"Supplices te rogamus"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The Church asks that those who receive from this altar may be filled with heavenly blessing and grace.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Súpplices te rogámus, omnípotens Deus: iube hæc perférri per manus sancti Angeli tui in sublíme altáre tuum, in conspéctu divínæ maiestátis tuæ: ut, quotquot ex hac altáris participatióne sacrosánctum Fílii tui Cor ✠ pus, et Sán ✠ guinem sumpsérimus, omni benedictióne coelésti et grátia repleámur. Per eúndem Christum, Dóminum nostrum. Amen.","en":"Humbly we beseech Thee, almighty God, to command that these our offerings be carried by the hands of Thy holy Angel to Thine Altar on high, in the sight of Thy divine Majesty, so that those of us who shall receive the most sacred Body ✠ and Blood ✠ of Thy Son by partaking thereof from this Altar may be filled with every grace and heavenly blessing: Through the same Christ our Lord. Amen.","fr":"Nous vous supplions humblement, Dieu tout-puissant : commandez que ces offrandes soient portées par les mains de votre saint Ange sur votre autel sublime, en présence de votre divine Majesté, afin que nous tous qui, participant à cet autel, recevrons le Corps ✠ et le Sang ✠ très saints de votre Fils, soyons remplis de toute bénédiction céleste et de toute grâce. Par le même Christ notre Seigneur. Ainsi soit-il."}},{"id":"memento-dead","phase":"Preface & Canon","section":"Canon after Consecration","title":{"en":"Memento of the Dead","fr":"Mémento des défunts"},"subtitle":{"en":"Memento etiam, Domine","fr":"Memento etiam, Domine"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The faithful departed are remembered and commended to the place of refreshment, light and peace.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Meménto étiam, Dómine, famulórum famularúmque tuárum N. et N., qui nos præcessérunt cum signo fídei, et dórmiunt in somno pacis. Ipsis, Dómine, et ómnibus in Christo quiescéntibus locum refrigérii, lucis pacis ut indúlgeas, deprecámur. Per eúndem Christum, Dóminum nostrum. Amen.","en":"Be mindful, also, O Lord, of Thy servants and handmaids N. and N. who are gone before us with the sign of faith and who sleep the sleep of peace. To these, O Lord, and to all who rest in Christ, grant, we beseech Thee, a place of refreshment, light and peace. Through the same Christ our Lord. Amen.","fr":"Souvenez-vous aussi, Seigneur, de vos serviteurs et servantes N. et N., qui nous ont précédés marqués du signe de la foi et dorment du sommeil de la paix. À eux, Seigneur, et à tous ceux qui reposent dans le Christ, accordez, nous vous en supplions, le lieu du rafraîchissement, de la lumière et de la paix. Par le même Christ notre Seigneur. Ainsi soit-il."}},{"id":"nobis-quoque","phase":"Preface & Canon","section":"Canon after Consecration","title":{"en":"Communion of the Saints","fr":"Communion des saints"},"subtitle":{"en":"Nobis quoque peccatoribus","fr":"Nobis quoque peccatoribus"},"actor":"celebrant","priestPosition":"Centre","audibility":"mixed","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The celebrant briefly raises his voice at Nobis quoque peccatoribus, then continues the prayer quietly.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Nobis quoque peccatóribus fámulis tuis, de multitúdine miseratiónum tuárum sperántibus, partem áliquam et societátem donáre dignéris, cum tuis sanctis Apóstolis et Martýribus: cum Ioánne, Stéphano, Matthía, Bárnaba, Ignátio, Alexándro, Marcellíno, Petro, Felicitáte, Perpétua, Agatha, Lúcia, Agnéte, Cæcília, Anastásia, et ómnibus Sanctis tuis: intra quorum nos consórtium, non æstimátor mériti, sed véniæ, quaesumus, largítor admítte. Per Christum, Dóminum nostrum.","en":"To us also Thy sinful servants, who put our trust in the multitude of Thy mercies, vouchsafe to grant some part and fellowship with Thy holy Apostles and Martyrs: with John, Stephen, Matthias, Barnabas, Ignatius, Alexander, Marcellinus, Peter, Felicitas, Perpetua, Agatha, Lucy, Agnes, Cecilia, Anastasia, and all Thy Saints. Into their company we beseech Thee admit us, not considering our merits, but freely pardoning our offenses. Through Christ our Lord.","fr":"À nous aussi, vos serviteurs pécheurs, qui espérons en l’abondance de vos miséricordes, daignez accorder quelque part et société avec vos saints Apôtres et Martyrs : Jean, Étienne, Matthias, Barnabé, Ignace, Alexandre, Marcellin, Pierre, Félicité, Perpétue, Agathe, Lucie, Agnès, Cécile, Anastasie et tous vos saints. Admettez-nous, nous vous en supplions, dans leur compagnie, non en considération de nos mérites, mais en nous accordant largement votre pardon. Par le Christ notre Seigneur."},"audibleFragment":{"lat":"Nóbis quoque peccatóribus…","en":"To us also, Thy sinful servants…","fr":"À nous aussi, pécheurs, vos serviteurs…"}},{"id":"canon-doxology","phase":"Preface & Canon","section":"Canon after Consecration","title":{"en":"Conclusion of the Canon","fr":"Conclusion du Canon"},"subtitle":{"en":"Per quem · Per ipsum","fr":"Per quem · Per ipsum"},"actor":"celebrant","priestPosition":"Centre","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"Per ómnia sǽcula sæculórum · Amen","explanation":"The Canon ends with the great doxology. Its final Per omnia sæcula sæculorum is heard aloud and answered Amen.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Per quem hæc ómnia, Dómine, semper bona creas, sancti ✠ ficas, viví ✠ ficas, bene ✠ dícis et præstas nobis.\n\nPer ip ✠ sum, et cum ip ✠ so, et in ip ✠ so, est tibi Deo Patri ✠ omnipotenti, in unitáte Spíritus ✠ Sancti, omnis honor, et glória.\n℣. Per ómnia sǽcula sæculórum.\n℟. Amen.","en":"By whom, O Lord, Thou dost always create, sanctify ✠, quicken ✠, bless ✠, and bestow upon us all these good things.\n\nThrough Him ✠, and with Him ✠, and in Him ✠, is unto Thee, God the Father ✠ Almighty, in the unity of the Holy ✠ Ghost, all honor and glory.\n℣. World without end.\n℟. Amen.","fr":"Par lui, Seigneur, vous ne cessez de créer tous ces biens, de les sanctifier ✠, de les vivifier ✠, de les bénir ✠ et de nous les donner.\n\nPar lui ✠, avec lui ✠ et en lui ✠, à vous, Dieu le Père ✠ tout-puissant, dans l’unité du Saint ✠ Esprit, tout honneur et toute gloire.\n℣. Dans tous les siècles des siècles.\n℟. Ainsi soit-il."}},{"id":"pater","phase":"Communion","section":"Pater & Fraction","title":{"en":"Pater noster","fr":"Pater noster"},"subtitle":{"en":"The Lord’s Prayer","fr":"La prière du Seigneur"},"actor":"celebrant","priestPosition":"Centre","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The priest sings or says the Lord’s Prayer; the minister or choir answers Sed libera nos a malo, and the celebrant continues with the embolism Libera nos.","customNote":"The 1962 books do not impose one universal posture on the lay congregation here. Follow the established practice of the church unless you have selected a display preference. Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"℣. Orémus. Præcéptis salutáribus móniti, et divína institutione formáti, audémus dícere:\n\nPater noster, qui es in cælis: sanctificétur nomen tuum: advéniat regnum tuum: fiat volúntas tua, sicut in cælo et in terra. Panem nostrum cotidiánum da nobis hódie: et dimítte nobis débita nostra, sicut et nos dimíttimus debitóribus nostris: et ne nos indúcas in tentatiónem.\n℟. Sed líbera nos a malo.\nAmen.","en":"℣. Let us pray. Admonished by saving precepts, and formed by divine teaching, we dare to say:\n\nOur Father, who art in heaven, hallowed be Thy name; Thy kingdom come; Thy will be done on earth as it is in heaven. Give us this day our daily bread; and forgive us our debts as we also forgive our debtors; and lead us not into temptation.\n℟. But deliver us from evil.\nAmen.","fr":"℣. Prions. Instruits par les préceptes du Sauveur et formés par l’enseignement divin, nous osons dire :\n\nNotre Père, qui êtes aux cieux, que votre nom soit sanctifié ; que votre règne arrive ; que votre volonté soit faite sur la terre comme au ciel. Donnez-nous aujourd’hui notre pain de chaque jour ; pardonnez-nous nos offenses comme nous pardonnons à ceux qui nous ont offensés ; et ne nous laissez pas succomber à la tentation.\n℟. Mais délivrez-nous du mal.\nAinsi soit-il."}},{"id":"libera-nos","phase":"Communion","section":"Pater & Fraction","title":{"en":"Libera nos","fr":"Libera nos"},"subtitle":{"en":"Deliver us, O Lord","fr":"Délivrez-nous, Seigneur"},"actor":"celebrant","priestPosition":"Centre","audibility":"mixed","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"Per ómnia sæcula sæculórum · Amen","explanation":"The celebrant expands the final petition of the Pater, asking deliverance from every evil through the intercession of Our Lady and the saints. The conclusion breaks the silence with Per omnia sæcula sæculorum.","customNote":"Congregational posture through this transition varies locally. Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Líbera nos, quǽsumus, Dómine, ab ómnibus malis, prætéritis, præséntibus et futúris: et intercedénte beáta et gloriósa semper Vírgine Dei Genetríce María, cum beátis Apóstolis tuis Petro et Paulo, atque Andréa, et ómnibus Sanctis, da propítius pacem in diébus nostris: ut, ope misericórdiæ tuæ adiúti, et a peccáto simus semper líberi et ab omni perturbatióne secúri. Per eúndem Dóminum nostrum Iesum Christum Fílium tuum. Qui tecum vivit et regnat in unitáte Spíritus Sancti Deus.\n℣. Per ómnia sæcula sæculórum.\n℟. Amen.","en":"Deliver us, we beseech Thee, O Lord, from all evils, past, present and to come; and by the intercession of the blessed and glorious ever Virgin Mary, Mother of God, together with Thy blessed Apostles Peter and Paul, and Andrew, and all the Saints, mercifully grant peace in our days: that through the help of Thy mercy we may always be free from sin and safe from all disturbance. Through the same Jesus Christ, Thy Son our Lord, Who liveth and reigneth with Thee in the unity of the Holy Ghost, God.\n℣. World without end.\n℟. Amen.","fr":"Délivrez-nous, Seigneur, nous vous en prions, de tous les maux passés, présents et à venir ; et par l’intercession de la bienheureuse et glorieuse Marie toujours Vierge, Mère de Dieu, de vos bienheureux Apôtres Pierre et Paul, d’André et de tous les saints, daignez, dans votre bonté, donner la paix à nos jours : afin qu’avec le secours de votre miséricorde nous soyons toujours délivrés du péché et à l’abri de tout trouble. Par le même Jésus-Christ, votre Fils, notre Seigneur, qui vit et règne avec vous dans l’unité du Saint-Esprit, Dieu.\n℣. Dans tous les siècles des siècles.\n℟. Ainsi soit-il."},"audibleFragment":{"lat":"℣. Per ómnia sæcula sæculórum.\n℟. Amen.","en":"℣. World without end.\n℟. Amen.","fr":"℣. Dans tous les siècles des siècles.\n℟. Ainsi soit-il."}},{"id":"fraction-pax","phase":"Communion","section":"Pater & Fraction","title":{"en":"Fraction · Pax Domini","fr":"Fraction · Pax Domini"},"subtitle":{"en":"The Host is broken","fr":"L’Hostie est rompue"},"actor":"celebrant","priestPosition":"Centre","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"Pax Dómini sit semper vobíscum","explanation":"After the conclusion of Libera nos, the celebrant breaks the Sacred Host. The public Pax Domini follows and is answered Et cum spiritu tuo.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"℣. Pax ✠ Dómini sit ✠ semper ✠ vobíscum.\n℟. Et cum spíritu tuo.","en":"℣. May the peace ✠ of the Lord be ✠ always ✠ with you.\n℟. And with thy spirit.","fr":"℣. Que la paix ✠ du Seigneur soit ✠ toujours ✠ avec vous.\n℟. Et avec votre esprit."}},{"id":"commingling","phase":"Communion","section":"Pater & Fraction","title":{"en":"Commingling","fr":"Immixtion"},"subtitle":{"en":"Hæc commixtio","fr":"Hæc commixtio"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"A particle of the Sacred Host is placed in the chalice while the celebrant says Haec commixtio.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Hæc commíxtio et consecrátio Córporis et Sánguinis Dómini nostri Iesu Christi fiat accipiéntibus nobis in vitam ætérnam. Amen.","en":"May this mingling and consecration of the Body and Blood of our Lord Jesus Christ be for us who receive it unto life everlasting. Amen.","fr":"Que ce mélange et cette consécration du Corps et du Sang de notre Seigneur Jésus-Christ nous procurent, à nous qui les recevons, la vie éternelle. Ainsi soit-il."}},{"id":"agnus","phase":"Communion","section":"Preparation for Communion","title":{"en":"Agnus Dei","fr":"Agnus Dei"},"subtitle":{"en":"Lamb of God","fr":"Agneau de Dieu"},"actor":"celebrant","priestPosition":"Centre","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"gestures":[{"kind":"action","label":"Strike breast ×3","anchorLat":"Agnus Dei","anchorEng":"Lamb of God","before":true,"status":"custom"}],"explanation":"The Agnus Dei is invoked three times after the fraction and commingling: the first two invocations ask mercy and the third asks peace.","customNote":"The Pilgrim’s Booklet presents the breast-striking gesture as the practical action of the faithful here. Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Agnus Dei, qui tollis peccáta mundi: miserére nobis.\nAgnus Dei, qui tollis peccáta mundi: miserére nobis.\nAgnus Dei, qui tollis peccáta mundi: dona nobis pacem.","en":"Lamb of God, who takest away the sins of the world: have mercy on us.\nLamb of God, who takest away the sins of the world: have mercy on us.\nLamb of God, who takest away the sins of the world: grant us peace.","fr":"Agneau de Dieu, qui enlevez les péchés du monde : ayez pitié de nous.\nAgneau de Dieu, qui enlevez les péchés du monde : ayez pitié de nous.\nAgneau de Dieu, qui enlevez les péchés du monde : donnez-nous la paix."}},{"id":"peace-prayer","phase":"Communion","section":"Preparation for Communion","title":{"en":"Prayer for Peace","fr":"Prière pour la paix"},"subtitle":{"en":"Domine Iesu Christe, qui dixisti","fr":"Domine Iesu Christe, qui dixisti"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The celebrant asks for the peace and unity of the Church. Where the ceremonial Pax is exchanged, it follows this prayer before the remaining private prayers.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Dómine Iesu Christe, qui dixísti Apóstolis tuis: Pacem relínquo vobis, pacem meam do vobis:\nne respícias peccáta mea, sed fidem Ecclésiæ tuæ; eámque secúndum voluntátem tuam pacificáre et coadunáre dignéris:\nQui vivis et regnas Deus per ómnia sæcula sæculórum. Amen.","en":"O Lord Jesus Christ, Who saidst to Thine Apostles: Peace I leave you, My peace I give you:\nregard not my sins, but the faith of Thy Church; and vouchsafe to grant her peace and unity according to Thy will:\nWho livest and reignest God, world without end. Amen.","fr":"Seigneur Jésus-Christ, qui avez dit à vos Apôtres : Je vous laisse la paix, je vous donne ma paix ; ne regardez pas mes péchés, mais la foi de votre Église, et daignez, selon votre volonté, lui donner la paix et l’unité. Vous qui vivez et régnez, Dieu, dans tous les siècles des siècles. Ainsi soit-il."}},{"id":"communion-prep-fili","phase":"Communion","section":"Preparation for Communion","title":{"en":"Prayer before Communion","fr":"Prière avant la Communion"},"subtitle":{"en":"Domine Iesu Christe, Fili Dei vivi","fr":"Domine Iesu Christe, Fili Dei vivi"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The celebrant asks to be delivered from every iniquity and to remain always united to Christ.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Dómine Iesu Christe, Fili Dei vivi, qui ex voluntáte Patris, cooperánte Spíritu Sancto, per mortem tuam mundum vivificásti: líbera me per hoc sacrosánctum Corpus et Sánguinem tuum ab ómnibus iniquitátibus meis, et univérsis malis: et fac me tuis semper inhærére mandátis, et a te numquam separári permíttas: Qui cum eódem Deo Patre et Spíritu Sancto vivis et regnas Deus in saecula sæculórum. Amen.","en":"O Lord Jesus Christ, Son of the living God, Who, by the will of the Father and the co-operation of the Holy Ghost, hast by Thy death given life to the world: deliver me by this, Thy most sacred Body and Blood, from all my iniquities and from every evil; make me cling always to Thy commandments, and permit me never to be separated from Thee. Who with the same God, the Father and the Holy Ghost, livest and reignest God, world without end. Amen.","fr":"Seigneur Jésus-Christ, Fils du Dieu vivant, qui, selon la volonté du Père et avec la coopération du Saint-Esprit, avez donné la vie au monde par votre mort ; délivrez-moi par votre Corps et votre Sang sacrés de tous mes péchés et de tous les maux ; faites que je m’attache toujours à vos commandements et ne permettez pas que je sois jamais séparé de vous. Vous qui, étant Dieu, vivez et régnez avec le même Dieu le Père et le Saint-Esprit dans les siècles des siècles. Ainsi soit-il."}},{"id":"communion-prep-perceptio","phase":"Communion","section":"Preparation for Communion","title":{"en":"Prayer before Communion","fr":"Prière avant la Communion"},"subtitle":{"en":"Perceptio Corporis tui","fr":"Perceptio Corporis tui"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The celebrant asks that reception of the Sacrament may not bring judgment or condemnation, but healing of soul and body.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Percéptio Córporis tui, Dómine Iesu Christe, quod ego indígnus súmere præsúmo, non mihi provéniat in iudícium et condemnatiónem: sed pro tua pietáte prosit mihi ad tutaméntum mentis et córporis, et ad medélam percipiéndam: Qui vivis et regnas cum Deo Patre in unitáte Spíritus Sancti Deus, per ómnia saecula sæculórum. Amen.","en":"Let not the partaking of Thy Body, O Lord Jesus Christ, which I, though unworthy, presume to receive, turn to my judgment and condemnation; but through Thy mercy may it be unto me a safeguard and a healing remedy both of soul and body. Who livest and reignest with God the Father, in the unity of the Holy Ghost, God, world without end. Amen.","fr":"Que la réception de votre Corps, que j’ose prendre tout indigne que je suis, Seigneur Jésus-Christ, n’entraîne pour moi ni jugement ni condamnation ; mais que, par votre bonté, elle serve de soutien et de remède à mon âme et à mon corps. Vous qui, étant Dieu, vivez et régnez avec Dieu le Père dans l’unité du Saint-Esprit, dans tous les siècles des siècles. Ainsi soit-il."}},{"id":"priest-communion","phase":"Communion","section":"Holy Communion","title":{"en":"Communion of the Priest","fr":"Communion du prêtre"},"subtitle":{"en":"Sacred Host and Precious Blood","fr":"Sainte Hostie et Précieux Sang"},"actor":"celebrant","priestPosition":"Centre","audibility":"quiet","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The celebrant communicates himself before Communion is distributed to the faithful.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Panem cæléstem accípiam, et nomen Dómini invocábo.\nDómine, non sum dignus, ut intres sub tectum meum: sed tantum dic verbo, et sanábitur ánima mea. (3×)\nCorpus ✠ Dómini nostri Iesu Christi custódiat ánimam meam in vitam ætérnam. Amen.\nQuid retríbuam Dómino pro ómnibus quæ retríbuit mihi? Cálicem salutáris accípiam, et nomen Dómini invocábo. Laudans invocábo Dóminum, et ab inimícis meis salvus ero.\nSanguis ✠ Dómini nostri Iesu Christi custódiat ánimam meam in vitam ætérnam. Amen.","en":"I will take the Bread of heaven and call upon the name of the Lord.\nLord, I am not worthy that Thou shouldst enter under my roof; but only say the word and my soul shall be healed. (3×)\nMay the Body ✠ of our Lord Jesus Christ preserve my soul unto life everlasting. Amen.\nWhat return shall I make to the Lord for all that He hath given me? I will take the chalice of salvation and call upon the name of the Lord. Praising I will call upon the Lord, and I shall be saved from my enemies.\nMay the Blood ✠ of our Lord Jesus Christ preserve my soul unto life everlasting. Amen.","fr":"Je prendrai le Pain du ciel et j’invoquerai le nom du Seigneur.\nSeigneur, je ne suis pas digne que vous entriez sous mon toit ; mais dites seulement une parole et mon âme sera guérie. (3×)\nQue le Corps ✠ de notre Seigneur Jésus-Christ garde mon âme pour la vie éternelle. Ainsi soit-il.\nQue rendrai-je au Seigneur pour tous ses bienfaits envers moi ? Je prendrai le calice du salut et j’invoquerai le nom du Seigneur. J’invoquerai le Seigneur en le louant et je serai sauvé de mes ennemis.\nQue le Sang ✠ de notre Seigneur Jésus-Christ garde mon âme pour la vie éternelle. Ainsi soit-il."}},{"id":"ecce","phase":"Communion","section":"Holy Communion","title":{"en":"Ecce Agnus Dei","fr":"Ecce Agnus Dei"},"subtitle":{"en":"Behold the Lamb of God","fr":"Voici l’Agneau de Dieu"},"actor":"celebrant","priestPosition":"Centre facing the people","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"Ecce Agnus Dei","explanation":"The priest turns toward the faithful and shows the Sacred Host. This is the clear audible and visual landmark before the three Domine, non sum dignus immediately preceding distribution of Communion.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Ecce Agnus Dei, ecce qui tollit peccáta mundi.","en":"Behold the Lamb of God, behold Him who taketh away the sins of the world.","fr":"Voici l’Agneau de Dieu, voici celui qui enlève les péchés du monde."}},{"id":"domine-non-sum-dignus","phase":"Communion","section":"Holy Communion","title":{"en":"Domine, non sum dignus","fr":"Domine, non sum dignus"},"subtitle":{"en":"Before Communion · three times","fr":"Avant la Communion · trois fois"},"actor":"celebrant","priestPosition":"Facing the faithful / altar rail","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The celebrant says Domine, non sum dignus three times immediately before Communion is distributed; congregational recitation is a traditional/local practice.","customNote":"The 1962 Communion rubric places the threefold Domine, non sum dignus with the celebrant before distribution. The Pilgrim’s Booklet presents the faithful as joining it; the app keeps the altar role and congregational practice distinct. Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","participationHint":"℟. You may join ×3","text":{"lat":"[ROLE=PRIEST]\nDómine, non sum dignus, ut intres sub tectum meum: sed tantum dic verbo, et sanábitur ánima mea. (3×)\n[/ROLE]","en":"[ROLE=PRIEST]\nLord, I am not worthy that Thou shouldst enter under my roof; but only say the word and my soul shall be healed. (3×)\n[/ROLE]","fr":"[ROLE=PRIEST]\n\n[/ROLE]"}},{"id":"communion-faithful","phase":"Communion","section":"Holy Communion","title":{"en":"Communion of the Faithful","fr":"Communion des fidèles"},"subtitle":{"en":"At the altar rail","fr":"À la table de Communion"},"actor":"celebrant","priestPosition":"Communion rail","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"Holy Communion is distributed after the celebrant’s Communion and before the ablutions. The formula, including Amen, is spoken by the priest to each communicant.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Corpus ✠ Dómini nostri Iesu Christi custódiat ánimam tuam in vitam ætérnam. Amen.","en":"May the Body ✠ of our Lord Jesus Christ preserve thy soul unto life everlasting. Amen.","fr":"Que le Corps ✠ de notre Seigneur Jésus-Christ garde votre âme pour la vie éternelle. Ainsi soit-il."}},{"id":"ablutions","phase":"Communion","section":"After Communion","title":{"en":"Ablutions","fr":"Ablutions"},"subtitle":{"en":"Purification of the sacred vessels","fr":"Purification des vases sacrés"},"actor":"celebrant","priestPosition":"Centre / Epistle side","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The priest purifies the sacred vessels and prays that Holy Communion may have its full effect in him. The canonical Communion-antiphon event has ended before the ablutions; any additional music here is a separate local/custom musical continuation, not the canonical Proper event.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Quod ore súmpsimus, Dómine, pura mente capiámus: et de múnere temporáli fiat nobis remédium sempitérnum.\nCorpus tuum, Dómine, quod sumpsi, et Sanguis, quem potávi, adhǽreat viscéribus meis: et præsta; ut in me non remáneat scélerum mácula, quem pura et sancta refecérunt sacraménta: Qui vivis et regnas in sæcula sæculórum. Amen.","en":"Grant, O Lord, that what we have taken with our mouth we may receive with a pure mind; and that from a temporal gift it may become for us an everlasting remedy.\nMay Thy Body, O Lord, which I have received, and Thy Blood which I have drunk, cleave to my inmost parts; and grant that no stain of sin remain in me, whom these pure and holy mysteries have refreshed. Who livest and reignest world without end. Amen.","fr":"Ce que nous avons reçu par la bouche, Seigneur, que nous l’embrassions d’une âme pure, et que de ce don temporel nous vienne un remède éternel.\nQue votre Corps, Seigneur, que j’ai reçu, et votre Sang que j’ai bu, adhèrent à mes entrailles ; et faites qu’aucune tache de péché ne demeure en moi, que de purs et saints mystères ont restauré. Vous qui vivez et régnez dans les siècles des siècles. Ainsi soit-il."}},{"id":"communion-proper","phase":"Communion","section":"After Communion","title":{"en":"Communion Antiphon","fr":"Antienne de Communion"},"subtitle":{"en":"At the altar after the ablutions","fr":"À l’autel après les ablutions"},"actor":"celebrant","priestPosition":"Epistle side","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"This is the celebrant’s recitation of the Communion proper after the ablutions. At a Sung Mass you may already have heard the choir sing it during Communion.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","properSlot":"communion"},{"id":"postcommunion","phase":"Conclusion","section":"Final Proper","title":{"en":"Postcommunion","fr":"Postcommunion"},"subtitle":{"en":"Proper prayer","fr":"Prière propre"},"actor":"celebrant","priestPosition":"Epistle side","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"Dóminus vobíscum","explanation":"The final proper oration asks that the mysteries received bear fruit in Christian life.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","properSlot":"postcommunions"},{"id":"dismissal","phase":"Conclusion","section":"Dismissal & Blessing","title":{"en":"Ite, missa est","fr":"Ite, missa est"},"subtitle":{"en":"Final greeting and dismissal","fr":"Salutation finale et renvoi"},"actor":"celebrant","priestPosition":"Centre · facing the people for the dismissal","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"landmark":"Dóminus vobíscum · dismissal","explanation":"Ite, missa est is the normal 1962 dismissal; the celebrant turns toward the people for the dismissal.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"℣. Dóminus vobíscum.\n℟. Et cum spíritu tuo.\n\n℣. Ite, Missa est.\n℟. Deo grátias.","en":"℣. The Lord be with you.\n℟. And with thy spirit.\n\n℣. Go, the Mass is ended.\n℟. Thanks be to God.","fr":"℣. Le Seigneur soit avec vous.\n℟. Et avec votre esprit.\n\n℣. Allez, la Messe est dite.\n℟. Nous rendons grâces à Dieu."}},{"id":"placeat","phase":"Conclusion","section":"Dismissal & Blessing","title":{"en":"Placeat tibi","fr":"Placeat tibi"},"subtitle":{"en":"Prayer before leaving the altar","fr":"Prière avant de quitter l’autel"},"actor":"celebrant","priestPosition":"Centre","audibility":"silent","privateAction":true,"posture":{"value":"custom","policy":"local","source":"local"},"explanation":"The celebrant asks the Holy Trinity to accept the sacrifice he has offered. The blessing follows.","customNote":"Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Pláceat tibi, sancta Trínitas, obséquium servitútis meæ: et præsta; ut sacrifícium,\nquod óculis tuæ maiestátis indígnus óbtuli, tibi sit acceptábile, mihíque et ómnibus,\npro quibus illud óbtuli, sit, te miseránte, propitiábile. Per Christum Dóminum nostrum. Amen.","en":"May the homage of my service be pleasing to Thee, O holy Trinity; and grant that the sacrifice which I,\nthough unworthy, have offered in the sight of Thy Majesty, may be acceptable to Thee, and through Thy mercy\nbe a propitiation for me and for all those for whom I have offered it. Through Christ our Lord. Amen.","fr":"Agréez, Trinité sainte, l’hommage de mon ministère ; et faites que le sacrifice que, malgré mon indignité, j’ai offert aux regards de votre Majesté vous soit agréable et que, par votre miséricorde, il puisse attirer votre faveur sur moi et sur tous ceux pour lesquels je l’ai offert. Par le Christ notre Seigneur. Ainsi soit-il."}},{"id":"blessing","phase":"Conclusion","section":"Dismissal & Blessing","title":{"en":"Blessing","fr":"Bénédiction"},"subtitle":{"en":"Benedicat vos omnipotens Deus","fr":"Benedicat vos omnipotens Deus"},"actor":"celebrant","priestPosition":"Centre facing the people","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"gestures":[{"kind":"cross","label":"Sign of the cross","anchorLat":"Benedícat vos","anchorEng":"May almighty God bless you","before":true,"status":"custom"}],"explanation":"The celebrant gives the final blessing; it is omitted in a Requiem Mass and in certain special endings.","customNote":"Receive the blessing kneeling and make the sign of the cross. Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"Benedícat vos omnípotens Deus, Pater, et Fílius, ✠ et Spíritus Sanctus.\n℟. Amen.","en":"May almighty God bless you: the Father, and the Son, ✠ and the Holy Ghost.\n℟. Amen.","fr":"Que le Dieu tout-puissant vous bénisse : le Père, et le Fils, ✠ et le Saint-Esprit.\n℟. Ainsi soit-il."}},{"id":"last-gospel-announcement","phase":"Conclusion","section":"Last Gospel","title":{"en":"Last Gospel · Announcement","fr":"Dernier Évangile · annonce"},"subtitle":{"en":"Dominus vobiscum · Initium sancti Evangelii","fr":"Dominus vobiscum · Initium sancti Evangelii"},"actor":"celebrant","priestPosition":"Gospel side","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"gestures":[{"kind":"cross","label":"Forehead · lips · breast","anchorLat":"Initium ✠ sancti Evangélii","anchorEng":"The beginning ✠ of the holy Gospel","before":true,"status":"custom"}],"landmark":"Dóminus vobíscum · Initium sancti Evangelii","explanation":"The celebrant announces the Last Gospel at the Gospel side. The faithful often imitate the small crosses made at the Gospel announcement.","customNote":"As at the Gospel, make the three small crosses. Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"℣. Dóminus vobíscum.\n℟. Et cum spíritu tuo.\nInitium ✠ sancti Evangélii secúndum Ioánnem.\n℟. Glória tibi, Dómine.","en":"℣. The Lord be with you.\n℟. And with thy spirit.\nThe beginning ✠ of the holy Gospel according to Saint John.\n℟. Glory be to Thee, O Lord.","fr":"℣. Le Seigneur soit avec vous.\n℟. Et avec votre esprit.\nCommencement ✠ du saint Évangile selon saint Jean.\n℟. Gloire à vous, Seigneur."}},{"id":"last-gospel","phase":"Conclusion","section":"Last Gospel","title":{"en":"Last Gospel","fr":"Dernier Évangile"},"subtitle":{"en":"In principio erat Verbum · John 1:1–14","fr":"In principio erat Verbum · John 1:1–14"},"actor":"celebrant","priestPosition":"Gospel side","audibility":"audible","privateAction":false,"posture":{"value":"custom","policy":"local","source":"local"},"gestures":[{"kind":"genuflect","status":"custom","label":"Traditional/local genuflection","anchorLat":"ET VERBUM CARO FACTUM EST.","anchorEng":"AND THE WORD WAS MADE FLESH.","before":true},{"kind":"rise","label":"Rise","anchorLat":"ET VERBUM CARO FACTUM EST.","anchorEng":"AND THE WORD WAS MADE FLESH.","after":true,"status":"custom"}],"explanation":"The Prologue of Saint John normally closes the Mass; the traditional genuflection occurs at Et Verbum caro factum est.","customNote":"The Pilgrim’s Booklet directs the faithful to genuflect at Et Verbum caro factum est. Congregational posture here is treated as local/traditional practice, not as a universal lay rubric of the 1962 Missal.","text":{"lat":"In princípio erat Verbum, et Verbum erat apud Deum, et Deus erat Verbum. Hoc erat in princípio apud Deum.\nÓmnia per ipsum facta sunt: et sine ipso factum est nihil, quod factum est. In ipso vita erat, et vita erat lux hóminum:\net lux in ténebris lucet, et ténebræ eam non comprehendérunt.\n\nFuit homo missus a Deo, cui nomen erat Ioánnes. Hic venit in testimónium, ut testimónium perhibéret de lúmine,\nut omnes créderent per illum. Non erat ille lux, sed ut testimónium perhibéret de lúmine. Erat lux vera,\nquæ illúminat omnem hóminem veniéntem in hunc mundum. In mundo erat, et mundus per ipsum factus est,\net mundus eum non cognóvit. In própria venit, et sui eum non recepérunt. Quotquot autem recepérunt eum,\ndedit eis potestátem fílios Dei fíeri, his, qui credunt in nómine eius: qui non ex sanguínibus, neque ex voluntáte carnis,\nneque ex voluntáte viri, sed ex Deo nati sunt.\n\nET VERBUM CARO FACTUM EST.\n\nEt habitávit in nobis: et vídimus glóriam eius, glóriam quasi Unigéniti a Patre, plenum grátiæ et veritátis.\n℟. Deo grátias.","en":"In the beginning was the Word, and the Word was with God, and the Word was God. The same was in the beginning with God.\nAll things were made by Him; and without Him was made nothing that was made. In Him was life, and the life was the light of men.\nAnd the light shineth in darkness, and the darkness did not comprehend it.\n\nThere was a man sent from God, whose name was John. This man came for a witness, to give testimony of the light,\nthat all men might believe through him. He was not the light, but was to give testimony of the light. That was the true light,\nwhich enlighteneth every man that cometh into this world. He was in the world, and the world was made by Him, and the world knew Him not.\nHe came unto His own, and His own received Him not. But as many as received Him, He gave them power to be made the sons of God,\nto them that believe in His name: who are born, not of blood, nor of the will of the flesh, nor of the will of man, but of God.\n\nAND THE WORD WAS MADE FLESH.\n\nAnd dwelt among us: and we saw His glory, the glory as it were of the Only-begotten of the Father, full of grace and truth.\n℟. Thanks be to God.","fr":"Au commencement était le Verbe, et le Verbe était auprès de Dieu, et le Verbe était Dieu. Il était au commencement auprès de Dieu.\nToutes choses ont été faites par lui, et rien de ce qui a été fait n’a été fait sans lui. En lui était la vie, et la vie était la lumière des hommes.\nEt la lumière luit dans les ténèbres, et les ténèbres ne l’ont point comprise.\n\nIl y eut un homme envoyé de Dieu, appelé Jean. Il vint comme témoin, pour rendre témoignage à la lumière, afin que tous crussent par lui. Il n’était pas lui-même la lumière, mais il devait rendre témoignage à la lumière. Celui-là était la vraie lumière qui éclaire tout homme venant en ce monde. Il était dans le monde, et le monde a été fait par lui, et le monde ne l’a pas connu.\nIl est venu chez lui, et les siens ne l’ont pas reçu. Mais à tous ceux qui l’ont reçu, il a donné le pouvoir de devenir enfants de Dieu, à ceux qui croient en son nom : eux qui ne sont nés ni du sang, ni de la volonté de la chair, ni de la volonté de l’homme, mais de Dieu.\n\nET LE VERBE S’EST FAIT CHAIR.\n\nEt il a habité parmi nous ; et nous avons vu sa gloire, gloire qu’il tient de son Père comme Fils unique, plein de grâce et de vérité.\n℟. Nous rendons grâces à Dieu."}}];},30:function(module,exports,require){
"use strict";
var __importDefault = (this && this.__importDefault) || function (mod) {
    return (mod && mod.__esModule) ? mod : { "default": mod };
};
Object.defineProperty(exports, "__esModule", { value: true });
exports.prayerStubs = exports.fixedOrdinary = void 0;
