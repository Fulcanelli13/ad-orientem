function normaliseText3(value) {
    if (!value || typeof value !== "object")
        return undefined;
    const out = {};
    if (typeof value.lat === "string" && value.lat.trim())
        out.lat = value.lat;
    const en = typeof value.en === "string" ? value.en : typeof value.eng === "string" ? value.eng : undefined;
    if (en && en.trim())
        out.en = en;
    if (typeof value.fr === "string" && value.fr.trim())
        out.fr = value.fr;
    return Object.keys(out).length ? out : undefined;
}
function concatText3(parts, separator = "\n\n") {
    const norm = parts.map(normaliseText3).filter((v) => !!v);
    if (!norm.length)
        return undefined;
    const out = {};
    for (const lang of ["lat", "en", "fr"]) {
        const values = norm.map(v => v[lang]).filter((v) => !!v && !!v.trim());
        if (values.length)
            out[lang] = values.join(separator);
    }
    return Object.keys(out).length ? out : undefined;