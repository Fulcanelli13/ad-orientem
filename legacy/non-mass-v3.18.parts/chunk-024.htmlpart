<script id="ao-v423-votive-proper-source-meta">
(()=>{'use strict';
const SOURCE={
 crossEn:'https://media.musicasacra.com/sjfm/Votive/Votive-Cross-general.pdf',
 holySpiritSecretEn:'https://propria.org/wp-content/uploads/2024/05/propers-for-votive-mass-for-obtaining-the-grace-of-the-holy-spirit.pdf',
 holySpiritPostEn:'https://www.preces-latinae.org/thesaurus/Spiritus/ConcedeQ.html'
};
const completed=[
 'Votive/Cross:en:Oratio','Votive/Cross:en:Tractus','Votive/Cross:en:Secreta','Votive/Cross:en:Postcommunio',
 'Votive/HolySpirit2:en:Secreta','Votive/HolySpirit2:en:Postcommunio'
];
const intentionallyPending=[
 'marian_consecration_immaculate_heart:la','marian_consecration_immaculate_heart:fr'
];
const supersededProperPending=[
 'Votive/Cross:fr:Oratio','Votive/Cross:fr:Tractus','Votive/Cross:fr:Secreta'
];
window.AO_V423_VOTIVE_SOURCE_META=Object.freeze({
 version:'42.3-votive-proper-source-completion',
 baseline:'42.2-canonical-content-rebase',
 completed:Object.freeze(completed),
 intentionallyPending:Object.freeze(intentionallyPending),
 supersededProperPending:Object.freeze(supersededProperPending),
 sources:Object.freeze(SOURCE),
 policy:'exact-witness/fail-closed; no generated liturgical translations',
 inspect(){
   const r=globalThis.AO_RUNTIME_V8;
   const registry=globalThis.AO_VOTIVE_EXTERNAL_VERIFIED_V423||null;
   return {
     pass:!!registry && !!registry['Votive/Cross']?.en?.Secreta?.length && !!registry['Votive/HolySpirit2']?.en?.Postcommunio?.length,
     completed:[...completed], pending:[...intentionallyPending], supersededProperPending:[...supersededProperPending], runtime:!!r
   };
 }
});
})();
</script>
<script id="ao-v423-final-title-authority">
(()=>{'use strict';const TITLE='Ad Orientem 2.0 · v42.3 Votive Proper Source Completion';const set=()=>{try{if(!globalThis.AO_RELEASE_AUTHORITY_V4359)document.title=TITLE;if(!globalThis.AO_RELEASE_AUTHORITY_V4359)document.documentElement.dataset.aoRelease='42.3';if(!globalThis.AO_RELEASE_AUTHORITY_V4359)document.documentElement.dataset.aoCanonicalHead='v42.3'}catch{}};set();if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',set,{once:true});window.AO_V423_TITLE=TITLE;})();
</script>
<!-- ============================================================
 AD ORIENTEM v26 · TRADITIONAL EXERCISES ENGINE + PHASE A
 Additive layer. v25 is retained byte-for-byte as the file prefix.
 ============================================================ -->
<style id="ao-v26-traditional-exercises-css">
body.aoV26Open{overflow:hidden}
#ao-v26-exercises{position:fixed;inset:0;z-index:12080;background:var(--bg,#07192c);color:var(--text,#f1eee5);overflow:auto;overscroll-behavior:contain;font-family:var(--font-body,Georgia,serif)}
#ao-v26-exercises[hidden]{display:none!important}.aoV26Shell{width:min(920px,100%);margin:0 auto;padding:0 16px max(80px,var(--safe-bottom,0px))}
.aoV26Top{position:sticky;top:0;z-index:5;margin:0 -16px;padding:calc(10px + var(--safe-top,0px)) 16px 10px;display:flex;gap:10px;align-items:center;background:color-mix(in srgb,var(--bg,#07192c) 93%,transparent);backdrop-filter:blur(16px);border-bottom:1px solid var(--border,rgba(255,255,255,.12))}
.aoV26Top button,.aoV26Btn{border:1px solid var(--border,rgba(255,255,255,.14));background:var(--surface-1,rgba(255,255,255,.04));color:inherit;border-radius:999px;padding:10px 13px;min-height:42px}.aoV26Top>div{flex:1;min-width:0}.aoV26Top small,.aoV26Eyebrow{display:block;text-transform:uppercase;letter-spacing:.13em;font-size:.68rem;color:var(--muted,#9fb0bf)}.aoV26Top strong{font-family:var(--font-display,Georgia,serif);font-size:1.05rem}.aoV26Hero{padding:26px 0 15px}.aoV26Hero h1{font-family:var(--font-display,Georgia,serif);font-weight:500;font-size:clamp(2rem,8vw,3.6rem);line-height:1.03;margin:6px 0 12px}.aoV26Hero p{color:var(--muted,#9fb0bf);line-height:1.55;max-width:720px;margin:0}
.aoV26Badge{display:inline-flex;width:max-content;max-width:100%;font-size:.69rem;letter-spacing:.08em;text-transform:uppercase;border:1px solid var(--border,rgba(255,255,255,.14));border-radius:999px;padding:4px 7px;color:var(--muted,#9fb0bf)}.aoV26Badge.ready{color:var(--text,#fff);border-color:var(--liturgical-border,var(--border))}.aoV26Badge.pending{opacity:.8}
.aoV26Section{margin:18px 0;padding:16px;border:1px solid var(--border,rgba(255,255,255,.12));border-radius:16px;background:var(--surface-1,rgba(255,255,255,.035))}.aoV26Section h2,.aoV26Section h3{font-family:var(--font-display,Georgia,serif);font-weight:500;margin:0 0 9px}.aoV26Section p{line-height:1.55}.aoV26Step{margin:10px 0;padding:14px;border-left:2px solid var(--liturgical,var(--text,#fff));background:rgba(255,255,255,.025);border-radius:0 12px 12px 0}.aoV26Step h3{margin:0 0 7px;font-size:1.02rem}.aoV26Step p{margin:0;line-height:1.56}.aoV26Role{display:block;margin-top:8px;font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted,#9fb0bf)}
.aoV26Source dl{display:grid;grid-template-columns:max-content 1fr;gap:7px 12px;margin:12px 0}.aoV26Source dt{color:var(--muted,#9fb0bf)}.aoV26Source dd{margin:0}.aoV26Source a{color:inherit;text-decoration:underline;text-underline-offset:3px}.aoV26Notice{padding:12px 14px;border-radius:12px;background:var(--liturgical-soft,rgba(255,255,255,.06));border:1px solid var(--liturgical-border,var(--border));line-height:1.5}.aoV26Actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.aoV26Btn.primary{background:var(--text,#eee);color:var(--bg,#07192c);border-color:transparent;font-weight:700}.aoV26Btn.danger{border-color:#a55}
.aoV26Form{display:grid;gap:9px}.aoV26Form input,.aoV26Form select,.aoV26Form textarea{width:100%;box-sizing:border-box;background:var(--surface-2,rgba(255,255,255,.06));border:1px solid var(--border,rgba(255,255,255,.14));color:inherit;border-radius:10px;padding:11px;font:inherit}.aoV26Intention{display:grid;grid-template-columns:auto 1fr auto;gap:9px;align-items:start;padding:10px 0;border-bottom:1px solid var(--border,rgba(255,255,255,.1))}.aoV26Intention small{color:var(--muted,#9fb0bf)}

@media(max-width:620px){.aoV26Source dl{grid-template-columns:1fr;gap:2px}.aoV26Source dd{margin-bottom:8px}}
</style>
<div id="ao-v26-exercises" hidden aria-hidden="true"></div>
<script id="ao-v26-traditional-exercises-engine">
(()=>{'use strict';
const VERSION='26.0';
const root=()=>document.getElementById('ao-v26-exercises');
const rt=()=>window.AO_RUNTIME_V8||window.AdOrientemB1?.runtime||null;
const state=()=>rt()?.store?.getState?.()||null;
const fr=()=>state()?.language==='fr';
const L=(en,frs)=>fr()?frs:en;
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
const SOURCES={
 balt1888:{id:'balt1888',author:'Third Plenary Council of Baltimore',work:'A Manual of Prayers for the Use of the Catholic Laity',publisher:'The Catholic Publication Society',editionYear:1888,pages:'89 ff. (Devotions for Mass)',sourceType:'private_devotion',publicDomain:true,url:'https://en.wikisource.org/wiki/A_Manual_of_Prayers_for_the_Use_of_the_Catholic_Laity/Instructions_for_Hearing_Mass'},
 las1911_mass:{id:'las1911_mass',author:'F. X. Lasance',work:'With God',publisher:'Benziger Brothers',editionYear:1911,pages:'160 (The Four Great Ends of Mass)',sourceType:'private_devotion',publicDomain:true,url:'https://en.wikisource.org/wiki/With_God/The_Holy_Sacrifice_of_the_Mass'},
 las1911_conf:{id:'las1911_conf',author:'F. X. Lasance',work:'With God',publisher:'Benziger Brothers',editionYear:1911,pages:'382–395 (Devotions for Confession)',sourceType:'private_devotion',publicDomain:true,url:'https://en.wikisource.org/wiki/With_God/Devotions_for_Confession'},
 las1911_comm:{id:'las1911_comm',author:'F. X. Lasance',work:'With God',publisher:'Benziger Brothers',editionYear:1911,pages:'419–453 (Devotions for Holy Communion)',sourceType:'private_devotion',publicDomain:true,url:'https://en.wikisource.org/wiki/With_God/Devotions_for_Holy_Communion'}
};
const FOUR_ENDS_EN=[
 {id:'adoration',title:'Adoration',text:'To praise, honor, and adore the infinite majesty of God, Who is infinitely deserving of all the glory that can be given Him by His creatures.'},
 {id:'satisfaction',title:'Satisfaction',text:'To satisfy the infinite justice of God, Who is infinitely offended by the sins committed against Him.'},
 {id:'thanksgiving',title:'Thanksgiving',text:'To thank the infinite liberality of God, Who requires an infinite return for all the favors bestowed upon His creatures.'},
 {id:'petition',title:'Petition',text:'To petition the infinite goodness of God, Whom nothing but a pleading of infinite value can move to grant us all needful blessings.'}
];
const FOUR_ENDS_FR=[
 {id:'latreutic',title:'Adoration · fin latreutique',text:'Pour lui rendre l’honneur qui lui est dû, et à ce point de vue le Sacrifice est latreutique.'},
 {id:'eucharistic',title:'Action de grâces · fin eucharistique',text:'Pour le remercier de ses bienfaits, et à ce point de vue le Sacrifice est eucharistique.'},
 {id:'propitiatory',title:'Propitiation · fin propitiatoire',text:'Pour l’apaiser, lui donner la satisfaction due pour nos péchés, soulager les âmes du purgatoire, et à ce point de vue le sacrifice est propitiatoire.'},
 {id:'impetratory',title:'Demande · fin impétratoire',text:'Pour obtenir toutes les grâces qui nous sont nécessaires, et à ce point de vue le sacrifice est impétratoire.'}
];
const FOUR_ENDS_FR_URL='https://icrsp-lille.fr/presentation/336-2/';
const MODULES={
 MASS_PREP_BALT_1888:{id:'MASS_PREP_BALT_1888',domain:'pray',family:'mass_sacraments',title:{en:'Before Mass',fr:'Avant la Messe'},summary:{en:'Enter the retained v25 preparation flow. The Baltimore 1888 canonical source package is registered but not falsely substituted for the existing flow.',fr:'Ouvrir le parcours de préparation v25 conservé. Le paquet source canonique Baltimore 1888 est enregistré sans être faussement substitué au parcours existant.'},source:'balt1888',status:'legacy_adapter',adapter:'prepare',provenanceRequired:true,contentReady:false},
 MASS_OFFER_BALT_1888:{id:'MASS_OFFER_BALT_1888',domain:'pray',family:'mass_sacraments',title:{en:'Offer This Mass',fr:'Offrir cette Messe'},summary:{en:'Choose locally saved intentions, then carry those names into the existing preparation intention field without rewriting a historical prayer.',fr:'Choisir des intentions enregistrées localement puis porter ces noms dans le champ d’intention existant, sans réécrire une prière historique.'},source:'balt1888',status:'editorial_bridge',renderer:'intentions',provenanceRequired:true,contentReady:false},
 MASS_FOUR_ENDS_LAS_1911:{id:'MASS_FOUR_ENDS_LAS_1911',domain:'assist',family:'mass_assistance',title:{en:'The Four Ends',fr:'Les quatre fins'},summary:{en:'Lasance’s four ends of the Holy Sacrifice: Adoration, Satisfaction, Thanksgiving and Petition.',fr:'Les quatre fins du Saint Sacrifice selon Lasance : Adoration, Satisfaction, Action de grâces et Demande.'},source:'las1911_mass',status:'canonical',renderer:'four_ends',provenanceRequired:true,contentReady:true},
 COMM_PREP_LAS_1911:{id:'COMM_PREP_LAS_1911',domain:'pray',family:'mass_sacraments',title:{en:'Prepare for Holy Communion',fr:'Préparation à la Sainte Communion'},summary:{en:'Canonical sequence registered: Faith, Hope, Charity, Contrition, Desire, Humility. Full Lasance source-text package remains pending; current v25 Communion preparation remains available.',fr:'Séquence canonique enregistrée : Foi, Espérance, Charité, Contrition, Désir, Humilité. Le paquet intégral du texte-source de Lasance reste à importer ; la préparation v25 actuelle demeure disponible.'},source:'las1911_comm',status:'source_pending',adapter:'prepare_communion',provenanceRequired:true,contentReady:false,headings:['Faith','Hope','Charity','Contrition','Desire','Humility']},
 COMM_THANKS_LAS_1911:{id:'COMM_THANKS_LAS_1911',domain:'pray',family:'mass_sacraments',title:{en:'Thanksgiving after Holy Communion',fr:'Action de grâces après la Sainte Communion'},summary:{en:'Enter the retained v25 Thanksgiving flow. It contains sourced traditional prayers, but v26 does not relabel that corpus as the Lasance 1911 canonical sequence.',fr:'Ouvrir le parcours d’action de grâces v25 conservé. Il contient des prières traditionnelles sourcées, mais v26 ne rebaptise pas ce corpus comme la séquence canonique de Lasance 1911.'},source:'las1911_comm',status:'legacy_adapter',adapter:'thanks',provenanceRequired:true,contentReady:false},
 CONFESSION_LAS_1911:{id:'CONFESSION_LAS_1911',domain:'pray',family:'mass_sacraments',title:{en:'Confession',fr:'Confession'},summary:{en:'Open the retained v25 Confession module. The Lasance source package is registered separately; sensitive marked-state storage is session-only in the new engine.',fr:'Ouvrir le module de Confession v25 conservé. Le paquet source Lasance est enregistré séparément ; les éléments sensibles marqués dans le nouveau moteur restent uniquement en session.'},source:'las1911_conf',status:'legacy_adapter',adapter:'confession',provenanceRequired:true,contentReady:false}
};
const S={open:false,view:'home',domain:'pray',module:null,selectedIntentions:new Set(),sourceOpen:false};
const intentionKey='ao2:traditional-intentions:v1';
let intentionMemory=[];
const Intentions={
 list(){try{const raw=localStorage.getItem(intentionKey);if(raw!==null){const rows=JSON.parse(raw).filter(x=>x&&x.id);intentionMemory=rows;return rows}}catch{}return intentionMemory.slice()},
 save(rows){intentionMemory=rows.slice();try{localStorage.setItem(intentionKey,JSON.stringify(rows))}catch{}},
 add(row){const rows=this.list();const item={id:'i_'+Date.now().toString(36)+'_'+Math.random().toString(36).slice(2,7),type:row.type||'request',name:String(row.name||'').trim(),note:String(row.note||'').trim(),createdAt:new Date().toISOString(),archived:false};if(!item.name&&!item.note)return null;rows.unshift(item);this.save(rows);return item},
 archive(id){this.save(this.list().map(x=>x.id===id?{...x,archived:true}:x))},
 active(){return this.list().filter(x=>!x.archived)}
};
const ConfessionSession=(()=>{let marks=new Map(),timer=null;const arm=()=>{clearTimeout(timer);timer=setTimeout(()=>marks.clear(),30*60*1000)};return{set(id,value){marks.set(id,!!value);arm()},get(id){return !!marks.get(id)},clear(){marks.clear();clearTimeout(timer)},size(){return marks.size},storageClass:'session_only_memory'}})();
function statusLabel(m){if(m.status==='canonical')return L('Canonical source package','Paquet source canonique');if(m.status==='legacy_adapter')return L('Retained v25 adapter','Adaptateur v25 conservé');if(m.status==='editorial_bridge')return L('Editorial bridge · no prayer rewrite','Pont éditorial · aucune réécriture');return L('Source text pending','Texte-source à importer')}
function sourcePanel(m){const s=SOURCES[m.source];if(!s)return'';return `<section class="aoV26Section aoV26Source"><span class="aoV26Eyebrow">${L('About this source','À propos de cette source')}</span><h2>${esc(s.work)}</h2><dl><dt>${L('Author / editor','Auteur / éditeur')}</dt><dd>${esc(s.author)}</dd><dt>${L('Edition','Édition')}</dt><dd>${esc(s.publisher)} · ${s.editionYear}</dd><dt>${L('Pages / section','Pages / section')}</dt><dd>${esc(s.pages)}</dd><dt>${L('Content type','Type de contenu')}</dt><dd>${esc(s.sourceType)}</dd><dt>${L('Reuse status','Statut de réutilisation')}</dt><dd>${s.publicDomain?L('Public domain edition','Édition du domaine public'):L('Check required','Vérification requise')}</dd><dt>${L('v26 treatment','Traitement v26')}</dt><dd>${esc(statusLabel(m))}</dd></dl><a href="${esc(s.url)}" target="_blank" rel="noopener">${L('Open source witness','Ouvrir le témoin source')} ↗</a></section>`}
function top(title,sub='Traditional Exercises'){return `<header class="aoV26Top"><button type="button" data-v26-back aria-label="${L('Back','Retour')}">←</button><div><small>${esc(sub)}</small><strong>${esc(title)}</strong></div><button type="button" data-v26-close aria-label="${L('Close','Fermer')}">×</button></header>`}
function renderFourEnds(m){const items=fr()?FOUR_ENDS_FR:FOUR_ENDS_EN;const witness=fr()?'Catéchisme de saint Pie X · formulation française traditionnelle':'Lasance 1911 · p. 160';const provenance=fr()?`<section class="aoV26Section aoV26Source"><span class="aoV26Eyebrow">Source française traditionnelle distincte</span><h2>Catéchisme de saint Pie X · Les quatre fins du Saint Sacrifice</h2><p>Cette formulation française est un témoin traditionnel propre, et non une traduction fabriquée des paragraphes anglais de Lasance. L’ordre et les termes suivent le Catéchisme de saint Pie X.</p><a href="${FOUR_ENDS_FR_URL}" target="_blank" rel="noopener">Ouvrir le témoin source ↗</a></section>`:sourcePanel(m);return `${top(fr()?m.title.fr:m.title.en,L('Assist at Mass','Assister à la Messe'))}<section class="aoV26Hero"><span class="aoV26Badge ready">${statusLabel(m)}</span><h1>${esc(fr()?m.title.fr:m.title.en)}</h1><p>${esc(fr()?'Les quatre fins du Saint Sacrifice selon le Catéchisme de saint Pie X : adoration, action de grâces, propitiation et impétration.':m.summary.en)}</p></section>${fr()?'<p class="aoV26Notice">Le français utilise un témoin traditionnel indépendant ; il n’est pas présenté comme une traduction de Lasance.</p>':''}${items.map((x,i)=>`<article class="aoV26Step"><span class="aoV26Eyebrow">${i+1} / 4</span><h3>${esc(x.title)}</h3><p>${esc(x.text)}</p><span class="aoV26Role">source_text · ${witness}</span></article>`).join('')}<div class="aoV26Actions"><button class="aoV26Btn primary" data-v26-close>${L('Return to Mass / app','Retourner à la Messe / à l’application')}</button></div>${provenance}`}
function renderIntentions(m){const rows=Intentions.active();return `${top(fr()?m.title.fr:m.title.en,L('Mass & Sacraments','Messe & sacrements'))}<section class="aoV26Hero"><span class="aoV26Badge">${statusLabel(m)}</span><h1>${esc(fr()?m.title.fr:m.title.en)}</h1><p>${esc(fr()?m.summary.fr:m.summary.en)}</p></section><section class="aoV26Section"><h2>${L('Saved intentions','Intentions enregistrées')}</h2><p class="aoV26Notice">${L('Names and notes are user content stored locally on this device. They are not inserted into rewritten prayer prose.','Les noms et notes sont du contenu utilisateur enregistré localement sur cet appareil. Ils ne sont pas insérés dans une prière réécrite.')}</p><div>${rows.length?rows.map(x=>`<label class="aoV26Intention"><input type="checkbox" data-v26-intention-select="${esc(x.id)}" ${S.selectedIntentions.has(x.id)?'checked':''}><span><strong>${esc(x.name||L('Unnamed intention','Intention sans nom'))}</strong><br><small>${esc(x.type)}${x.note?' · '+esc(x.note):''}</small></span><button class="aoV26Btn" type="button" data-v26-intention-archive="${esc(x.id)}">${L('Archive','Archiver')}</button></label>`).join(''):`<p>${L('No saved intentions yet.','Aucune intention enregistrée.')}</p>`}</div></section><section class="aoV26Section"><h2>${L('Add intention','Ajouter une intention')}</h2><form class="aoV26Form" data-v26-intention-form><select name="type"><option value="living">${L('Living person','Personne vivante')}</option><option value="dead">${L('Deceased person','Défunt')}</option><option value="thanksgiving">${L('Thanksgiving','Action de grâces')}</option><option value="request">${L('Particular request','Demande particulière')}</option></select><input name="name" autocomplete="off" placeholder="${L('Name / short label','Nom / libellé court')}"><textarea name="note" rows="2" placeholder="${L('Optional note','Note facultative')}"></textarea><button class="aoV26Btn" type="submit">${L('Save locally','Enregistrer localement')}</button></form><div class="aoV26Actions"><button class="aoV26Btn primary" data-v26-use-intentions>${L('Continue to Mass preparation','Continuer vers la préparation à la Messe')}</button></div></section>${sourcePanel(m)}`}
function renderPending(m){const heads=(m.headings||[]).map((h,i)=>`<div class="aoV26Step"><span class="aoV26Eyebrow">${i+1}</span><h3>${esc(h)}</h3><p>${L('Source-text step registered; verified transcription not yet imported into v26.','Étape du texte-source enregistrée ; transcription vérifiée pas encore importée dans v26.')}</p><span class="aoV26Role">source_note</span></div>`).join('');return `${top(fr()?m.title.fr:m.title.en,L('Mass & Sacraments','Messe & sacrements'))}<section class="aoV26Hero"><span class="aoV26Badge pending">${statusLabel(m)}</span><h1>${esc(fr()?m.title.fr:m.title.en)}</h1><p>${esc(fr()?m.summary.fr:m.summary.en)}</p></section>${heads}<div class="aoV26Actions"><button class="aoV26Btn primary" data-v26-adapter="${esc(m.adapter||'')}">${L('Use retained v25 preparation','Utiliser la préparation v25 conservée')}</button></div>${sourcePanel(m)}`}
function renderAdapter(m){return `${top(fr()?m.title.fr:m.title.en,L('Mass & Sacraments','Messe & sacrements'))}<section class="aoV26Hero"><span class="aoV26Badge">${statusLabel(m)}</span><h1>${esc(fr()?m.title.fr:m.title.en)}</h1><p>${esc(fr()?m.summary.fr:m.summary.en)}</p></section><section class="aoV26Section"><p class="aoV26Notice">${L('v26 preserves the working v25 module and does not silently relabel its text as the canonical source package named in this blueprint.','v26 conserve le module v25 fonctionnel et ne rebaptise pas silencieusement son texte comme le paquet canonique nommé dans ce plan.')}</p><div class="aoV26Actions"><button class="aoV26Btn primary" data-v26-adapter="${esc(m.adapter||'')}">${L('Open retained module','Ouvrir le module conservé')}</button></div></section>${sourcePanel(m)}`}
function renderModule(m){if(m.renderer==='four_ends')return renderFourEnds(m);if(m.renderer==='intentions')return renderIntentions(m);if(m.status==='source_pending')return renderPending(m);return renderAdapter(m)}
function render(){const r=root();if(!r)return;r.innerHTML=S.view==='module'&&S.module&&MODULES[S.module]?`<div class="aoV26Shell">${renderModule(MODULES[S.module])}</div>`:`<div class="aoV26Shell">${renderHome()}</div>`;r.hidden=!S.open;r.setAttribute('aria-hidden',S.open?'false':'true')}
function open(module=null){if(module&&MODULES[module]){S.open=true;document.body.classList.add('aoV26Open');S.view='module';S.module=module;render();return true}close();const target=S.domain==='assist'?'mass':S.domain==='learn'?'learn':'pray';return !!window.AO_V37_SHELL?.openDomain?.(target)}
function close(){S.open=false;root().hidden=true;root().setAttribute('aria-hidden','true');document.body.classList.remove('aoV26Open');return true}
function back(){if(S.view==='module'){close();const target=S.domain==='assist'?'mass':S.domain==='learn'?'learn':'pray';return !!window.AO_V37_SHELL?.openDomain?.(target)}return close()}
function openPrayerBookModule(name){const ret={surface:'traditional-exercises'};close();if(window.AOTraditionalPrayerBook?.openModule)return window.AOTraditionalPrayerBook.openModule(name,{returnContext:ret});return false}
function adapter(kind){const store=rt()?.store;if(kind==='prepare'||kind==='prepare_communion'){close();store?.dispatch({type:'enter-prepare'});if(kind==='prepare_communion')store?.dispatch({type:'prepare-communion',value:true});return true}if(kind==='thanks'){close();store?.dispatch({type:'enter-thanksgiving'});return true}if(kind==='confession')return openPrayerBookModule('confession');return false}
function selectedIntentionText(){const ids=S.selectedIntentions,rows=Intentions.active().filter(x=>ids.has(x.id));return rows.map(x=>x.name||x.note).filter(Boolean).join('; ')}
function qa(){const regs=Object.values(MODULES),src=Object.values(SOURCES);return{version:VERSION,registry:{expected:6,actual:regs.length,pass:regs.length===6},idsUnique:new Set(regs.map(x=>x.id)).size===regs.length,sources:{count:src.length,allHaveEdition:src.every(x=>x.editionYear&&x.work&&x.author),allHavePageOrSection:src.every(x=>x.pages)},contentStates:{canonical:regs.filter(x=>x.status==='canonical').length,legacyAdapters:regs.filter(x=>x.status==='legacy_adapter').length,sourcePending:regs.filter(x=>x.status==='source_pending').length,editorialBridges:regs.filter(x=>x.status==='editorial_bridge').length},storage:{intentions:'localStorage only',confession:ConfessionSession.storageClass},massEngineChanged:false,v25PrefixPreserved:true}}
function bind(){document.addEventListener('click',e=>{if(e.target.closest?.('[data-v26-close]')){e.preventDefault();close();return}if(e.target.closest?.('[data-v26-back]')){e.preventDefault();back();return}const a=e.target.closest?.('[data-v26-adapter]');if(a){adapter(a.dataset.v26Adapter);return}const ar=e.target.closest?.('[data-v26-intention-archive]');if(ar){Intentions.archive(ar.dataset.v26IntentionArchive);S.selectedIntentions.delete(ar.dataset.v26IntentionArchive);render();return}const use=e.target.closest?.('[data-v26-use-intentions]');if(use){const txt=selectedIntentionText();const store=rt()?.store;if(txt)store?.dispatch({type:'prepare-intention',value:txt});close();store?.dispatch({type:'enter-prepare'});return}},true);
 document.addEventListener('change',e=>{const c=e.target.closest?.('[data-v26-intention-select]');if(c){if(c.checked)S.selectedIntentions.add(c.dataset.v26IntentionSelect);else S.selectedIntentions.delete(c.dataset.v26IntentionSelect)}},true);
 document.addEventListener('submit',e=>{const f=e.target.closest?.('[data-v26-intention-form]');if(!f)return;e.preventDefault();const fd=new FormData(f);const item=Intentions.add({type:fd.get('type'),name:fd.get('name'),note:fd.get('note')});if(item)S.selectedIntentions.add(item.id);render()},true);
 document.addEventListener('keydown',e=>{if(e.key==='Escape'&&S.open){e.preventDefault();back()}},true);

}
window.AO_TRAD_V26={version:VERSION,open,close,back,registry:MODULES,sources:SOURCES,intentions:Intentions,confessionStore:ConfessionSession,qa,getState:()=>({...S,selectedIntentions:[...S.selectedIntentions]})};
window.AO_V26_META={version:'v26',baseline:'Ad-Orientem-2.0-v25-NAVIGATION-INTERACTION-CONSOLIDATION.html',scope:['shared devotional module registry','source registry','step renderer','provenance UI','storage-class separation','Phase A routing'],massEngineChanged:false,v25PrayerCorpusChanged:false,canonicalPhaseAReady:['MASS_FOUR_ENDS_LAS_1911'],phaseAAdapters:['MASS_PREP_BALT_1888','COMM_THANKS_LAS_1911','CONFESSION_LAS_1911'],phaseASourcePending:['COMM_PREP_LAS_1911'],phaseAEditorialBridge:['MASS_OFFER_BALT_1888']};
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',bind,{once:true});else bind();
})();
</script>
<script id="ao-v26-certification-meta">
window.AO_COMPLETION_V26={version:'26',traditionalExercisesEngine:true,protectedBaseline:'v25',massEngineChanged:false,v25PrayerCorpusChanged:false,moduleRegistry:true,sourceRegistry:true,provenancePanel:true,localIntentionStore:true,sessionOnlyConfessionStore:true,phaseAModuleEntries:6,canonicalSourcePackagesReady:1,knownLimitations:['Five Phase A entries are not yet complete canonical source-text packages: three are retained-v25 adapters, one is an editorial intention bridge, and Communion Preparation remains source-text pending.','French translations are not fabricated for source texts that have not been source-verified.','The new session-only confession store is provided by the engine but the retained v25 Confession module has not yet been migrated to use it.']};
</script>

<!-- ============================================================
 AD ORIENTEM v26.1 · SOURCE-PACKAGE LOCK + 1962 OVERLAY
 Additive branch-safe pass. v26 is retained byte-for-byte as prefix.
 No devotional prayer wording is introduced by this patch.
 ============================================================ -->
<style id="ao-v261-source-lock-css">
.aoV261Badge{display:inline-flex;width:max-content;max-width:100%;border:1px solid var(--liturgical-border,var(--border));border-radius:999px;padding:5px 8px;color:var(--liturgical,var(--text));font-size:.68rem;letter-spacing:.08em;text-transform:uppercase}
.aoV261Step{margin:10px 0;padding:14px;border:1px solid var(--border,rgba(255,255,255,.12));border-radius:14px;background:var(--surface-1,rgba(255,255,255,.035))}.aoV261Step header{display:flex;align-items:flex-start;gap:9px}.aoV261No{flex:none;display:grid;place-items:center;width:28px;height:28px;border:1px solid var(--border);border-radius:999px;color:var(--muted);font-size:.72rem}.aoV261Step h3{margin:1px 0 4px;font-family:var(--font-display,Georgia,serif);font-size:1rem;font-weight:600}.aoV261Step p{margin:6px 0 0;color:var(--muted,#9fb0bf);line-height:1.5}.aoV261Meta{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.aoV261Meta span{border:1px solid var(--border);border-radius:999px;padding:4px 7px;color:var(--muted);font-size:.66rem}.aoV261Overlay{margin:14px 0;padding:14px;border-left:3px solid var(--liturgical,var(--text));background:var(--liturgical-soft,rgba(255,255,255,.06));border-radius:0 13px 13px 0}.aoV261Overlay h3{margin:0 0 7px;font-family:var(--font-display,Georgia,serif)}.aoV261Overlay p{margin:6px 0;color:var(--muted);line-height:1.5}.aoV261SourceGrid{display:grid;grid-template-columns:max-content 1fr;gap:7px 12px;margin:12px 0}.aoV261SourceGrid dt{color:var(--muted);font-size:.76rem}.aoV261SourceGrid dd{margin:0;line-height:1.4}.aoV261Actions{display:flex;gap:8px;flex-wrap:wrap;margin:16px 0}.aoV261Actions button{min-height:42px;border:1px solid var(--border);border-radius:999px;background:var(--surface-1);color:var(--text);padding:9px 13px;font-weight:650}.aoV261Actions button.primary{border-color:var(--liturgical-border,var(--border));background:var(--liturgical,var(--text));color:#09111b}.aoV261Notice{padding:11px 12px;border:1px solid var(--border);border-radius:12px;color:var(--muted);line-height:1.5;background:rgba(255,255,255,.025)}
</style>
<script id="ao-v261-source-package-lock">
(()=>{'use strict';
const VERSION='26.1-source-package-lock';
const base=window.AO_TRAD_V26;
if(!base||!base.registry||!base.sources)return;
const rt=()=>window.AO_RUNTIME_V8||window.AdOrientemB1?.runtime||null;
const state=()=>rt()?.store?.getState?.()||null;
const fr=()=>state()?.language==='fr';
const L=(en,frs)=>fr()?frs:en;
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
const VALID_ROLES=new Set(['source_text','liturgical_text','historical_instruction','current_instruction','editorial_navigation','source_note','historical_note','rubrical_note','user_content']);
const WITNESSES={
 balt1888:{id:'balt1888',work:'A Manual of Prayers for the Use of the Catholic Laity',author:'Third Plenary Council of Baltimore',publisher:'The Catholic Publication Society',year:1888,edition:'New York, 1888',rights:'public_domain',sourceType:'private_devotion',framework:'historical prayer manual; 1962 overlay required where ritual instructions touch Mass',url:'https://en.wikisource.org/wiki/A_Manual_of_Prayers_for_the_Use_of_the_Catholic_Laity/Instructions_for_Hearing_Mass'},
 las1911:{id:'las1911',work:'With God: A Book of Prayers and Reflections',author:'F. X. Lasance',publisher:'Benziger Brothers',year:1911,edition:'New York / Cincinnati / Chicago, 1911',rights:'public_domain',sourceType:'private_devotion',framework:'historical prayer manual; 1962 overlay required where ritual instructions touch Mass',url:'https://en.wikisource.org/wiki/With_God'}
};
const PACKAGES={
 MASS_PREP_BALT_1888:{
  id:'MASS_PREP_BALT_1888',witness:'balt1888',status:'source_text_supplied_v352',section:'On the Manner of Hearing Mass → Prayers before Mass',pages:'89–90',verifiedStructure:true,
  title:{en:'Before Mass · Baltimore 1888',fr:'Avant la Messe · Baltimore 1888'},
  note:{en:'The source structure is locked in v26.1. The live public-domain source transcription is supplied by the later v35.2 reader; v26.1 remains the provenance/structure compatibility layer.',fr:'La structure de la source est verrouillée dans v26.1. La transcription publique active est fournie par le lecteur v35.2 ; v26.1 demeure la couche de compatibilité pour la provenance et la structure.'},
  steps:[
   {id:'prep_recollection',role:'historical_instruction',heading:'Recollection, humility and lively faith',sourceRef:'p. 89',description:'Introductory instruction immediately before the Prayers before Mass.'},
   {id:'prep_holy_ghost',role:'source_text',heading:'Invocation of the Holy Ghost',sourceRef:'p. 89',description:'Prayer text is rendered by v35.2; this v26.1 record preserves source role and page mapping.'},
   {id:'prep_versicle_collect',role:'source_text',heading:'Versicle, response and collect',sourceRef:'p. 89',description:'Prayer text is rendered by v35.2; this v26.1 record preserves source role and page mapping.'},
   {id:'prep_look_down',role:'source_text',heading:'Prayer before the Holy Sacrifice',sourceRef:'pp. 89–90',description:'Prayer text is rendered by v35.2; this v26.1 record preserves source role and page mapping.'},
   {id:'prep_transition',role:'editorial_navigation',heading:'Start Mass',sourceRef:null,description:'Application navigation only; not part of the historical prayer text.'}
  ],
  action:{adapter:'prepare',labelEn:'Use retained v25 preparation',labelFr:'Utiliser la préparation v25 conservée'}
 },
 MASS_OFFER_BALT_1888:{
  id:'MASS_OFFER_BALT_1888',witness:'balt1888',status:'source_locked_editorial_bridge',section:'Devotions for Mass · Part I · Prayer at the beginning of Mass',pages:'90–91',verifiedStructure:true,
  title:{en:'Offer This Mass · Baltimore 1888',fr:'Offrir cette Messe · Baltimore 1888'},
  note:{en:'Baltimore explicitly provides places to mention persons and particular requests. Ad Orientem may attach locally saved user intentions at those source-defined insertion points without rewriting the prayer itself.',fr:'Baltimore prévoit explicitement des endroits où mentionner des personnes et des demandes particulières. Ad Orientem peut y rattacher des intentions locales sans réécrire la prière.'},
  steps:[
   {id:'offer_glory',role:'source_note',heading:'God’s honor, praise, adoration and glory',sourceRef:'p. 90',description:'Source-defined first intention of the offering.'},
   {id:'offer_passion',role:'source_note',heading:'Remembrance of the Passion and Death of Christ',sourceRef:'p. 90',description:'Source-defined second intention.'},
   {id:'offer_thanks',role:'source_note',heading:'Thanksgiving for blessings',sourceRef:'p. 90',description:'Source-defined third intention.'},
   {id:'offer_people',role:'user_content',heading:'Persons for whom the user wishes to pray',sourceRef:'p. 90',description:'User-entered names attach to the source’s explicit names placeholder; they are not interpolated into newly written prayer prose.'},
   {id:'offer_requests',role:'user_content',heading:'Particular requests',sourceRef:'p. 90',description:'User-entered requests attach to the source’s explicit requests placeholder.'}
  ],
  action:{legacyModule:'MASS_OFFER_BALT_1888',labelEn:'Manage saved intentions',labelFr:'Gérer les intentions enregistrées'}
 },
 COMM_PREP_LAS_1911:{
  id:'COMM_PREP_LAS_1911',witness:'las1911',status:'source_text_supplied_v352',section:'Devotions for Holy Communion → Short Acts and Prayers for Holy Communion → Before Holy Communion',pages:'419–421',verifiedStructure:true,
  title:{en:'Prepare for Holy Communion · Lasance 1911',fr:'Préparation à la Sainte Communion · Lasance 1911'},
  note:{en:'The six-act sequence is source-verified here; the live public-domain transcription is supplied by v35.2. v41.5 certifies that six-act scope as complete while keeping the 1911 ritual note historical.',fr:'La séquence en six actes est vérifiée ici ; la transcription publique active est fournie par v35.2. v41.5 certifie ce périmètre en six actes comme complet tout en conservant la note rituelle de 1911 comme historique.'},
  steps:['Faith','Hope','Charity','Contrition','Desire','Humility'].map((heading,i)=>({id:'comm_prep_'+heading.toLowerCase(),role:'source_text',heading,sourceRef:i<4?'p. 419–420':'pp. 420–421',description:'Source text is rendered by v35.2; this v26.1 record preserves the Lasance role and page mapping.'})),
  overlays:[{kind:'rubrical_note',title:'Historical source vs 1962 Communion rite',historical:'Lasance directs the communicant to make a new act of contrition while the pre-Communion Confiteor and absolution are recited.',current:'For the 1962 framework, Ad Orientem must not make that Confiteor universal. The 1962 rubric omits the confession and absolution when Communion is distributed within Mass, while retaining Ecce Agnus Dei and the threefold Domine, non sum dignus.',policy:'Keep Lasance’s historical instruction in source metadata; let the 1962 Mass engine determine the actual ritual cues.'}],
  action:{adapter:'prepare_communion',labelEn:'Use retained v25 Communion preparation',labelFr:'Utiliser la préparation à la Communion v25'}
 },
 COMM_THANKS_LAS_1911:{
  id:'COMM_THANKS_LAS_1911',witness:'las1911',status:'source_text_supplied_v352',section:'Devotions for Holy Communion → After Holy Communion',pages:'415–433 (recollection counsel and principal thanksgiving sequence)',verifiedStructure:true,
  title:{en:'Thanksgiving after Holy Communion · Lasance 1911',fr:'Action de grâces après la Sainte Communion · Lasance 1911'},
  note:{en:'The principal thanksgiving sequence is source-locked here and populated by v35.2. v41.5 records it as a scoped core sequence rather than claiming every optional Lasance devotion is embedded.',fr:'La séquence principale d’action de grâces est verrouillée ici et alimentée par v35.2. v41.5 l’enregistre comme noyau délimité sans prétendre que toutes les dévotions facultatives de Lasance sont intégrées.'},
  steps:[
   {id:'thanks_silence',role:'historical_instruction',heading:'Silence and recollection',sourceRef:'pp. 415–418',description:'Lasance transmits Eymard’s counsel to remain in simple recollection after receiving.'},
   {id:'thanks_faith',role:'source_text',heading:'Faith & Adoration',sourceRef:'p. 422',description:'Source text is rendered by v35.2; this v26.1 record preserves source role and page mapping.'},
   {id:'thanks_hope',role:'source_text',heading:'Hope',sourceRef:'p. 423',description:'Source text is rendered by v35.2; this v26.1 record preserves source role and page mapping.'},
   {id:'thanks_love',role:'source_text',heading:'Love',sourceRef:'p. 423',description:'Source text is rendered by v35.2; this v26.1 record preserves source role and page mapping.'},
   {id:'thanks_thanksgiving',role:'source_text',heading:'Thanksgiving',sourceRef:'pp. 423–424',description:'Source text is rendered by v35.2; this v26.1 record preserves source role and page mapping.'},
   {id:'thanks_reparation',role:'source_text',heading:'Reparation & Consecration',sourceRef:'pp. 424–425',description:'Source text is rendered by v35.2; this v26.1 record preserves source role and page mapping.'},
   {id:'thanks_petitions',role:'source_text',heading:'Petitions',sourceRef:'pp. 425–426',description:'Source text is rendered by v35.2; this v26.1 record preserves source role and page mapping.'},
   {id:'thanks_living',role:'source_text',heading:'Commemoration of the Living',sourceRef:'p. 426',description:'Optional source section.'},
   {id:'thanks_dead',role:'source_text',heading:'Commemoration of the Dead',sourceRef:'pp. 426–427',description:'Optional source section.'},
   {id:'thanks_resolution',role:'source_text',heading:'Final prayers, reflections and resolutions',sourceRef:'pp. 428–433',description:'Source sequence continues with concluding material and traditional prayers.'}
  ],
  overlays:[{kind:'historical_note',title:'Historical indulgence notes',historical:'The 1911 source includes period indulgence notices alongside several prayers.',current:'v26.1 does not present those notices as presently operative grants.',policy:'Preserve them only as historical source metadata until independently verified against current norms.'}],
  action:{adapter:'thanks',labelEn:'Use retained v25 Thanksgiving',labelFr:'Utiliser l’action de grâces v25 conservée'}
 },
 CONFESSION_LAS_1911:{
  id:'CONFESSION_LAS_1911',witness:'las1911',status:'source_text_supplied_v352',section:'Devotions for Confession',pages:'382–395',verifiedStructure:true,
  title:{en:'Confession · Lasance 1911',fr:'Confession · Lasance 1911'},
  note:{en:'The Lasance Confession sequence and page map are locked here; the live historical source core is rendered by v35.2. Sensitive marked examination state remains session-only and separate from ordinary saved intentions.',fr:'La séquence et la cartographie des pages de Lasance sont verrouillées ici ; le noyau historique actif est rendu par v35.2. Les éléments sensibles cochés demeurent uniquement en session et séparés des intentions enregistrées.'},
  steps:[
   {id:'conf_before',role:'source_text',heading:'Prayer before Confession',sourceRef:'pp. 382–384',description:'Source section is rendered by v35.2; this v26.1 record preserves structure and page mapping.'},
   {id:'conf_exam',role:'source_text',heading:'Examination of Conscience',sourceRef:'pp. 384–389',description:'Historical examination retained as historical source material.'},
   {id:'conf_after_exam',role:'source_text',heading:'After the Examination',sourceRef:'p. 389',description:'Source section locked.'},
   {id:'conf_contrition',role:'source_text',heading:'Considerations to excite true Contrition',sourceRef:'pp. 389–391',description:'Source section locked.'},
   {id:'conf_act',role:'source_text',heading:'Act of Contrition',sourceRef:'p. 391',description:'Source section locked.'},
   {id:'conf_how',role:'historical_instruction',heading:'How to make the Confession',sourceRef:'pp. 391–395',description:'Historical instruction must remain distinct from any current-disciplinary overlay.'},
   {id:'conf_thanks',role:'source_text',heading:'Thanksgiving after Confession',sourceRef:'p. 395',description:'Source section locked.'}
  ],
  overlays:[{kind:'current_instruction',title:'Discipline separation',historical:'Lasance’s examination and practical instructions remain intact as a 1911 historical witness.',current:'Any present canonical or disciplinary guidance must be separately sourced and rendered as a current-practice overlay.',policy:'Never rewrite the historical source as though every disciplinary statement were current.'},{kind:'source_note',title:'Privacy class',historical:'Not a source-text claim.',current:'Marked examination items use session-only memory; no cloud sync, analytics payload, or persistent save is introduced by this engine.',policy:'Clear preparation explicitly after use; sensitive state remains separate from ordinary intentions.'}],
  action:{adapter:'confession',labelEn:'Use retained v25 Confession',labelFr:'Utiliser la Confession v25 conservée'}
 }
};
const origOpen=base.open.bind(base);
const origClose=base.close.bind(base);
function root(){return document.getElementById('ao-v26-exercises')}
function witness(p){return WITNESSES[p.witness]}
function sourceMeta(p){const w=witness(p);return `<section class="aoV26Section aoV26Source"><span class="aoV26Eyebrow">${L('Source lock','Verrouillage de source')}</span><h2>${esc(w.work)}</h2><dl class="aoV261SourceGrid"><dt>${L('Author / editor','Auteur / éditeur')}</dt><dd>${esc(w.author)}</dd><dt>${L('Edition','Édition')}</dt><dd>${esc(w.publisher)} · ${w.year}</dd><dt>${L('Section','Section')}</dt><dd>${esc(p.section)}</dd><dt>${L('Pages','Pages')}</dt><dd>${esc(p.pages)}</dd><dt>${L('Content type','Type')}</dt><dd>${esc(w.sourceType)}</dd><dt>${L('Reuse','Réutilisation')}</dt><dd>${L('Public-domain historical edition','Édition historique du domaine public')}</dd><dt>${L('Package state','État du paquet')}</dt><dd>${L('Source structure locked · live source text supplied by v35.2','Structure verrouillée · texte-source actif fourni par v35.2')}</dd></dl><a href="${esc(w.url)}" target="_blank" rel="noopener">${L('Open source witness','Ouvrir le témoin source')} ↗</a></section>`}
function top(p){return `<header class="aoV26Top"><button type="button" data-v261-back aria-label="${L('Back','Retour')}">←</button><div><small>${L('Traditional Exercises · source package','Exercices traditionnels · paquet source')}</small><strong>${esc(fr()?p.title.fr:p.title.en)}</strong></div><button type="button" data-v261-close aria-label="${L('Close','Fermer')}">×</button></header>`}
function stepCard(s,i){return `<article class="aoV261Step"><header><span class="aoV261No">${i+1}</span><div><h3>${esc(s.heading)}</h3><div class="aoV261Meta"><span>${esc(s.role)}</span>${s.sourceRef?`<span>${esc(s.sourceRef)}</span>`:''}</div></div></header><p>${esc(s.description||'')}</p></article>`}
function overlays(p){return (p.overlays||[]).map(o=>`<aside class="aoV261Overlay"><span class="aoV26Eyebrow">${esc(o.kind)}</span><h3>${esc(o.title)}</h3><p><strong>${L('Historical source:','Source historique :')}</strong> ${esc(o.historical)}</p><p><strong>${L('1962 / current layer:','Couche 1962 / actuelle :')}</strong> ${esc(o.current)}</p><p><strong>${L('Rendering policy:','Règle d’affichage :')}</strong> ${esc(o.policy)}</p></aside>`).join('')}
function actions(p){const a=p.action||{};if(a.legacyModule)return `<div class="aoV261Actions"><button type="button" class="primary" data-v261-legacy-module="${esc(a.legacyModule)}">${esc(L(a.labelEn,a.labelFr))}</button></div>`;if(a.adapter)return `<div class="aoV261Actions"><button type="button" class="primary" data-v261-adapter="${esc(a.adapter)}">${esc(L(a.labelEn,a.labelFr))}</button></div>`;return''}
function renderPackage(id){const p=PACKAGES[id],r=root();if(!p||!r)return false;document.body.classList.add('aoV26Open');r.hidden=false;r.setAttribute('aria-hidden','false');r.innerHTML=`<div class="aoV26Shell">${top(p)}<section class="aoV26Hero"><span class="aoV261Badge">${L('Source structure · text supplied by v35.2','Structure source · texte fourni par v35.2')}</span><h1>${esc(fr()?p.title.fr:p.title.en)}</h1><p>${esc(fr()?p.note.fr:p.note.en)}</p></section><p class="aoV261Notice">${L('This pass intentionally records structure, provenance, page mapping, content roles and compatibility overlays without inventing or silently normalising devotional wording.','Cette passe enregistre volontairement la structure, la provenance, les pages, les rôles de contenu et les surcouches de compatibilité sans inventer ni normaliser silencieusement le texte dévotionnel.')}</p>${p.steps.map(stepCard).join('')}${overlays(p)}${actions(p)}${sourceMeta(p)}</div>`;return true}
function open(id=null){if(id&&PACKAGES[id])return renderPackage(id);return origOpen(id)}
function adapter(kind){origClose();const store=rt()?.store;if(kind==='prepare'||kind==='prepare_communion'){store?.dispatch({type:'enter-prepare'});if(kind==='prepare_communion')store?.dispatch({type:'prepare-communion',value:true});return true}if(kind==='thanks'){store?.dispatch({type:'enter-thanksgiving'});return true}if(kind==='confession'){if(window.AOTraditionalPrayerBook?.openModule){window.AOTraditionalPrayerBook.openModule('confession',{returnContext:{surface:'traditional-exercises'}});return true}}return false}
function close(){origClose();return true}
function patchRegistry(){for(const [id,p] of Object.entries(PACKAGES)){const m=base.registry[id];if(!m)continue;m.sourcePackage={status:p.status,section:p.section,pages:p.pages,verifiedStructure:p.verifiedStructure,stepCount:p.steps.length,overlayCount:(p.overlays||[]).length};m.sourceLocked=true;if(m.status==='source_pending')m.status='source_locked';m.contentReady=false;m.summary=m.summary||{};m.summary.en=(m.summary.en||'')+' Source structure and page mapping locked in v26.1.';m.summary.fr=(m.summary.fr||'')+' Structure et cartographie des pages verrouillées dans v26.1.'}}
function qa(){const ps=Object.values(PACKAGES),steps=ps.flatMap(p=>p.steps),roles=[...new Set(steps.map(s=>s.role))];return{version:VERSION,packages:{expected:5,actual:ps.length,pass:ps.length===5,allVerifiedStructure:ps.every(p=>p.verifiedStructure===true),allPageMapped:ps.every(p=>!!p.pages&&p.steps.every(s=>s.sourceRef!==undefined)),allWitnessed:ps.every(p=>!!WITNESSES[p.witness])},steps:{count:steps.length,roles,rolesValid:roles.every(r=>VALID_ROLES.has(r)),idsUnique:new Set(steps.map(s=>s.id)).size===steps.length},overlays:{count:ps.reduce((n,p)=>n+(p.overlays||[]).length,0),communion1962Overlay:(PACKAGES.COMM_PREP_LAS_1911.overlays||[]).some(x=>x.kind==='rubrical_note'),confessionDisciplineOverlay:(PACKAGES.CONFESSION_LAS_1911.overlays||[]).some(x=>x.kind==='current_instruction')},contentIntegrity:{originalPrayerTextAdded:false,sourceTextFieldsEmbedded:steps.filter(s=>Object.prototype.hasOwnProperty.call(s,'text')).length,pass:steps.every(s=>!Object.prototype.hasOwnProperty.call(s,'text'))},privacy:{confessionStorage:base.confessionStore?.storageClass||null,intentionStorage:'localStorage with memory fallback'},massEngineChanged:false,v26PrefixPreserved:true}}
patchRegistry();
const patched={...base,version:VERSION,open,close,sourcePackages:PACKAGES,sourceWitnesses:WITNESSES,qaSourceLock:qa};
window.AO_TRAD_V26=patched;
window.AO_TRAD_SOURCE_V261={version:VERSION,packages:PACKAGES,witnesses:WITNESSES,qa,open:renderPackage};
window.AO_V261_META={version:'v26.1',baseline:'Ad-Orientem-2.0-v26-TRADITIONAL-EXERCISES-ENGINE-PHASE-A.html',scope:['source-package lock','page mapping','content-role lock','1962 compatibility overlay','confession discipline/privacy separation'],massEngineChanged:false,v26PrefixPreserved:true,originalPrayerTextAdded:false};
document.addEventListener('click',e=>{const back=e.target.closest?.('[data-v261-back]');if(back){e.preventDefault();origOpen();return}const c=e.target.closest?.('[data-v261-close]');if(c){e.preventDefault();close();return}const a=e.target.closest?.('[data-v261-adapter]');if(a){e.preventDefault();adapter(a.dataset.v261Adapter);return}const lm=e.target.closest?.('[data-v261-legacy-module]');if(lm){e.preventDefault();origOpen(lm.dataset.v261LegacyModule);return}},true);
})();
</script>
<script id="ao-v261-certification-meta">
window.AO_COMPLETION_V261={version:'26.1',protectedBaseline:'v26',sourcePackagesLocked:5,sourceWitnesses:2,sourceTextImportedBy:'v35.2',sourcePackagesPending:0,originalPrayerTextAdded:false,massEngineChanged:false,communion1962Overlay:true,confessionDisciplineOverlay:true,knownLimitations:['v26.1 is the provenance/structure compatibility layer; live source text is rendered by v35.2 and completion is certified by scope in v41.5.','French translations of the historical witnesses remain unavailable unless separately source-verified; the app must not fabricate them.','Current Confession discipline remains a separate current-law overlay.']};
</script>
<style id="ao-saint-art-runtime-v1-css">
.aoSaintArtCard{margin:16px 0;padding:0;overflow:hidden;border:1px solid var(--liturgical-border,rgba(255,255,255,.13));border-radius:18px;background:var(--surface,#111820);box-shadow:0 14px 34px rgba(0,0,0,.18)}
.aoSaintArtMedia{position:relative;aspect-ratio:16/10;background:linear-gradient(135deg,var(--liturgical-soft,rgba(255,255,255,.06)),rgba(255,255,255,.025));display:flex;align-items:center;justify-content:center;overflow:hidden}.aoSaintArtMedia img{width:100%;height:100%;object-fit:cover;display:block}.aoSaintArtPlaceholder{padding:22px;text-align:center;color:var(--muted,#aab3bb);font-size:.84rem}.aoSaintArtBody{padding:14px 15px 15px}.aoSaintArtKicker{font-size:.62rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--liturgical,#c7ae7b)}.aoSaintArtTitle{margin:4px 0 5px;font:700 1.08rem/1.25 var(--font-display,Georgia,serif)}.aoSaintArtMeta{margin:0;color:var(--muted,#aab3bb);font-size:.75rem;line-height:1.4}.aoSaintArtActions{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:11px}.aoSaintArtActions button,.aoSaintArtActions a{min-height:36px;padding:0 10px;border:1px solid var(--liturgical-border,rgba(255,255,255,.14));border-radius:999px;background:transparent;color:inherit;font:inherit;font-size:.72rem;text-decoration:none}.aoSaintArtComponents{display:flex;gap:6px;overflow:auto;margin-top:10px;padding-bottom:2px}.aoSaintArtComponents button{white-space:nowrap;border:1px solid var(--liturgical-border,rgba(255,255,255,.12));background:transparent;color:inherit;border-radius:999px;padding:6px 9px;font-size:.67rem}.aoSaintArtComponents button.active{background:var(--liturgical-soft,rgba(255,255,255,.09));border-color:var(--liturgical,#999)}
.aoArtInfoBackdrop,.aoArtQaBackdrop{position:fixed;inset:0;z-index:99992;background:rgba(0,0,0,.72);display:flex;align-items:flex-end;justify-content:center}.aoArtInfoSheet,.aoArtQaSheet{width:min(720px,100%);max-height:88vh;overflow:auto;border-radius:22px 22px 0 0;border:1px solid var(--liturgical-border,rgba(255,255,255,.15));background:var(--surface,#10171f);padding:18px}.aoArtInfoSheet header,.aoArtQaSheet header{display:flex;justify-content:space-between;gap:12px;align-items:start}.aoArtInfoSheet h2,.aoArtQaSheet h2{margin:3px 0 10px;font-size:1.15rem}.aoArtInfoSheet button,.aoArtQaSheet button{border:1px solid var(--liturgical-border,rgba(255,255,255,.15));border-radius:10px;background:transparent;color:inherit;min-height:36px;padding:0 10px}.aoArtInfoGrid,.aoArtDiagGrid{display:grid;gap:8px}.aoArtInfoGrid article,.aoArtDiagGrid article{padding:10px;border:1px solid var(--liturgical-border,rgba(255,255,255,.12));border-radius:12px}.aoArtInfoGrid b,.aoArtDiagGrid b{display:block;font-size:.65rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted,#aab3bb);margin-bottom:3px}.aoArtQaStats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:12px 0}.aoArtQaStats div{padding:10px;border:1px solid var(--liturgical-border,rgba(255,255,255,.12));border-radius:12px}.aoArtQaStats b{display:block;font-size:1.25rem}.aoArtQaTable{overflow:auto}.aoArtQaTable table{width:100%;border-collapse:collapse;min-width:660px;font-size:.72rem}.aoArtQaTable th,.aoArtQaTable td{text-align:left;padding:7px;border-bottom:1px solid rgba(255,255,255,.08);vertical-align:top}.aoArtQaBad{color:#e3a0a6}.aoArtQaWarn{color:#d8bd7d}@media(max-width:560px){.aoArtQaStats{grid-template-columns:1fr 1fr}.aoSaintArtCard{border-radius:15px}}
</style>
<script id="ao-saint-art-runtime-v1-js">
(()=>{'use strict';
const VERSION='SAINT-ART-MANIFEST-v3.3', CACHE_VERSION='saints-art-v13', APPROVAL_EPOCH='approval-pass10-gated-v1', CLOSURE_VERSION='SAINT-ART-CLOSURE-v1', CERTIFIED_NO_ART_REASON='No explicitly researched and verified reusable artwork rule exists in the frozen saint-art registry. This identity is intentionally closed with no artwork rather than using an unverified generic Commons category.', EXPECTED={saintBearingDates:252,components:311,monthly:{'01':{days:20,components:26},'02':{days:17,components:20},'03':{days:14,components:15},'04':{days:17,components:18},'05':{days:25,components:32},'06':{days:23,components:28},'07':{days:25,components:36},'08':{days:28,components:36},'09':{days:22,components:27},'10':{days:23,components:27},'11':{days:21,components:28},'12':{days:17,components:18}}};
const DENOMINATOR_RECONCILIATION=Object.freeze({previousTarget:307,resolvedTarget:311,changes:Object.freeze({January:Object.freeze({from:25,to:26,delta:1,reason:'The frozen January subtotal contradicted its own researched decisions: every retained mixed-date commemoration is independent, while the stable multi-saint titles remain one component. Those explicit decisions sum to 26, not 25.'}),August:Object.freeze({from:34,to:36,delta:2,reason:'The raw saint-art scope yields 34 components before researched composite expansion. The later locked 22 August rule intentionally splits Timothy, Hippolytus and Symphorian into three independent canonical art components, adding two.'}),November:Object.freeze({from:27,to:28,delta:1,reason:'The frozen November subtotal predated the later clearance of St Pontian on 19 November as a separate retained commemoration component. The explicit retained identities sum to 28.'})}),policy:'Correct the denominator to the explicit canonical-component decisions; do not merge historically distinct identities merely to preserve a stale total.'});
const COMMONS_API='https://commons.wikimedia.org/w/api.php', TTL=14*24*60*60*1000;
const ALLOWED_LICENSE=/\b(public domain|pd(?:-|\b)|cc0|cc by(?:-|\s)|cc-by|cc by-sa|cc-by-sa)\b/i;
