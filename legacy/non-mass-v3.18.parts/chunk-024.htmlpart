const L=(en,fr)=>lang()==='fr'?fr:en;
const MANIFEST=Object.freeze({
 proper:Object.freeze({id:'proper',delivery:'daily-resolved',cache:'resolver/runtime',trigger:'day resolution',required:true,fallback:'explicit unavailable state'}),
 scripture:Object.freeze({id:'scripture',delivery:'daily-prefetch',cache:'session memory',trigger:'Proper ready',scope:'Gospel + Epistle/Lesson',required:false,fallback:'load on reader open'}),
 commentary:Object.freeze({id:'commentary',delivery:'daily-prefetch',cache:'session memory + provider caches',trigger:'Proper ready',scope:'Gospel + Epistle/Lesson',required:false,fallback:'explicit unavailable / source link'}),
 saintIdentity:Object.freeze({id:'saintIdentity',delivery:'daily-derived',cache:'daily summary',trigger:'day resolution',required:false,fallback:'liturgical title'}),
 saintBiography:Object.freeze({id:'saintBiography',delivery:'module-lazy',cache:'Saint reader memory',trigger:'Saint of the Day open',required:false,fallback:'explicit no sourced biography'}),
 saintArtwork:Object.freeze({id:'saintArtwork',delivery:'module-lazy',cache:'saint-art cache',trigger:'Home card / Saint of the Day open',required:false,fallback:'approved-art placeholder'}),
 catechism:Object.freeze({id:'catechism',delivery:'module-lazy',cache:'persistent module cache',trigger:'Catechism open',expected:433,required:false,fallback:'verified embedded English core'}),
 traditionalExercises:Object.freeze({id:'traditionalExercises',delivery:'module package',cache:'embedded verified package / future external package',trigger:'Traditional Exercise open',required:false,fallback:'source-verified embedded package'}),
 eucharisticProgrammes:Object.freeze({id:'eucharisticProgrammes',delivery:'embedded controller + lazy linked prayers',cache:'module state',trigger:'Programme open',required:false})
});
function setStatus(id,status,detail={}){const x={id,status,updatedAt:new Date().toISOString(),...detail};STATUS.set(id,x);if(diagOpen)renderDiagnostics();return x}
function getStatus(id){return STATUS.get(id)||{id,status:'idle'}}
function safeGet(k){try{return localStorage.getItem(CACHE_PREFIX+k)}catch{return MEMORY.get(k)||null}}
function safeSet(k,v){const text=JSON.stringify(v);MEMORY.set(k,text);try{localStorage.setItem(CACHE_PREFIX+k,text)}catch{}return v}
function safeDel(k){MEMORY.delete(k);try{localStorage.removeItem(CACHE_PREFIX+k)}catch{}}
function readCache(k){const raw=safeGet(k);if(!raw)return null;try{const x=JSON.parse(raw);if(x.expiresAt&&x.expiresAt<now()){safeDel(k);return null}return x}catch{return null}}
function pruneDaily(){try{const keys=[];for(let i=0;i<localStorage.length;i++){const k=localStorage.key(i);if(k?.startsWith(CACHE_PREFIX+'daily:'))keys.push(k)}keys.sort((a,b)=>{try{return JSON.parse(localStorage.getItem(b)).savedAt-JSON.parse(localStorage.getItem(a)).savedAt}catch{return 0}});keys.slice(14).forEach(k=>localStorage.removeItem(k))}catch{}}
function normalizeCommentary(doc){const docs=doc?.parts?.length?doc.parts:[doc];const valid=docs.filter(Boolean);if(!valid.length)return{status:'unavailable',references:[]};const references=valid.map(x=>x.reference?.display||x.reference?.displayFr||'').filter(Boolean);const en=valid.every(x=>x.reference?.kind==='gospel'?!!x.englishCatena?.length:(!!x.englishCommentary?.entries?.length||!!x.englishNotes?.length));const fr=valid.every(x=>!!x.frenchCommentary?.entries?.length||!!x.frenchCatena?.length);return{status:(en||fr)?'ready':'partial',references,en,fr,parts:valid.length}}
function dailyKey(s){const p=s?.resolution?.proper?.status==='ready'?s.resolution.proper.data:null;return `${s?.selectedDate||''}|${s?.language||''}|${p?.sourcePath||p?.properId||''}`}
function deriveDaily(s){const r=s?.resolution,p=r?.proper?.status==='ready'?r.proper.data:null,day=r?.day||null;return{
 version:VERSION,date:s?.selectedDate||null,language:s?.language||'en',generatedAt:new Date().toISOString(),
 celebration:{title:p?.name||p?.title?.en||day?.main?.title||null,titleFr:p?.nameFr||p?.title?.fr||null,rank:p?.rank||day?.main?.rank||null,colour:r?.colourPlan?.label||day?.main?.color||null,sourcePath:p?.sourcePath||p?.path||day?.main?.path||null},
 proper:{status:r?.proper?.status||'idle',languageCoverage:p?.languageCoverage||null,sourcePath:p?.sourcePath||null},
 scripture:{gospel:p?.gospel?{status:'queued'}:{status:'unavailable'},epistle:p?.epistle?{status:'queued'}:{status:'unavailable'}},
 commentary:{gospel:p?.gospel?{status:'queued'}:{status:'unavailable'},epistle:p?.epistle?{status:'queued'}:{status:'unavailable'}},
 saint:{status:day?.main?'ready':'unavailable',title:day?.main?.title||null,commemorations:(day?.commemorations||[]).map(x=>x.title||x.name).filter(Boolean),biography:'lazy',artwork:'lazy'},
 cache:{dailySummary:'pending',tomorrow:'idle'}
}}
async function prefetchReading(slot,kind,text,key){const rt=globalThis.AO_RUNTIME_V8;if(!rt?.scriptureService||!text)return null;setStatus('daily:'+slot,'loading',{key});try{const doc=await rt.scriptureService.load(kind,text);DAILY_DOCS.set(key+':'+slot,doc);const info=normalizeCommentary(doc);setStatus('daily:'+slot,'ready',{key,reference:info.references.join(' · '),commentary:info});return{doc,info}}catch(e){setStatus('daily:'+slot,'error',{key,error:String(e?.message||e)});return null}}
async function hydrateDaily(s=state(),{force=false}={}){if(!s?.resolution)return null;const key=dailyKey(s);if(!force&&key===lastDailyKey&&currentDaily)return currentDaily;lastDailyKey=key;currentDaily=deriveDaily(s);setStatus('proper',currentDaily.proper.status==='ready'?'ready':currentDaily.proper.status,{sourcePath:currentDaily.proper.sourcePath,languageCoverage:currentDaily.proper.languageCoverage});setStatus('saintIdentity',currentDaily.saint.status,{title:currentDaily.saint.title});
 const p=s.resolution?.proper?.status==='ready'?s.resolution.proper.data:null;if(!p){cacheDaily(currentDaily);return currentDaily}
 setStatus('scripture','loading',{scope:'Gospel + Epistle/Lesson'});setStatus('commentary','loading',{scope:'Gospel + Epistle/Lesson'});
 const jobs=[];if(p.gospel)jobs.push(prefetchReading('gospel','gospel',p.gospel,key).then(r=>{currentDaily.scripture.gospel={status:r?'ready':'error',reference:r?.info?.references?.join(' · ')||null};currentDaily.commentary.gospel=r?{status:r.info.status,en:r.info.en,fr:r.info.fr}:{status:'error'}}));if(p.epistle)jobs.push(prefetchReading('epistle','scripture',p.epistle,key).then(r=>{currentDaily.scripture.epistle={status:r?'ready':'error',reference:r?.info?.references?.join(' · ')||null};currentDaily.commentary.epistle=r?{status:r.info.status,en:r.info.en,fr:r.info.fr}:{status:'error'}}));
 await Promise.allSettled(jobs);const vals=[currentDaily.scripture.gospel.status,currentDaily.scripture.epistle.status];setStatus('scripture',vals.every(x=>x==='ready')?'ready':vals.includes('ready')?'partial':vals.includes('error')?'error':'unavailable',{slots:currentDaily.scripture});const cvals=[currentDaily.commentary.gospel.status,currentDaily.commentary.epistle.status];setStatus('commentary',cvals.every(x=>x==='ready')?'ready':cvals.includes('ready')||cvals.includes('partial')?'partial':cvals.includes('error')?'error':'unavailable',{slots:currentDaily.commentary});cacheDaily(currentDaily);scheduleTomorrow(s.selectedDate);return currentDaily}
function cacheDaily(payload){if(!payload?.date)return;payload.cache.dailySummary='cached';safeSet('daily:'+payload.date+':'+payload.language,{savedAt:now(),expiresAt:now()+DAILY_TTL,payload});pruneDaily();setStatus('dailySummary','cached',{date:payload.date})}
function addDays(iso,n){const d=new Date(iso+'T12:00:00');d.setDate(d.getDate()+n);return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}
function scheduleTomorrow(date){if(!date)return;const run=()=>prefetchTomorrow(date);if('requestIdleCallback'in window)requestIdleCallback(run,{timeout:3500});else setTimeout(run,1200)}
async function prefetchTomorrow(date){const rt=globalThis.AO_RUNTIME_V8;if(!rt?.resolver)return null;const tomorrow=addDays(date,1);if(prefetchedTomorrow?.date===tomorrow)return prefetchedTomorrow;setStatus('tomorrow','loading',{date:tomorrow});try{const r=await rt.resolver.resolveDay(tomorrow);const p=r?.proper?.status==='ready'?r.proper.data:null;prefetchedTomorrow={date:tomorrow,status:p?'ready':'partial',title:p?.name||r?.day?.main?.title||null,sourcePath:p?.sourcePath||null,languageCoverage:p?.languageCoverage||null};safeSet('tomorrow:'+tomorrow,{savedAt:now(),expiresAt:now()+DAILY_TTL,payload:prefetchedTomorrow});setStatus('tomorrow',prefetchedTomorrow.status,prefetchedTomorrow);if(currentDaily)currentDaily.cache.tomorrow=prefetchedTomorrow.status;return prefetchedTomorrow}catch(e){setStatus('tomorrow','error',{date:tomorrow,error:String(e?.message||e)});return null}}
function cachedDaily(date,language=lang()){return readCache('daily:'+date+':'+language)?.payload||null}
async function loadModule(id,opts={}){if(id==='catechism'){const api=globalThis.AO_TRADITIONAL_CATECHISM;if(!api)return setStatus('catechism','unavailable',{error:'Catechism controller unavailable'});const l=opts.language||lang();const count=api.count?.()||0;if(count===433)return setStatus('catechism','cached',{language:l,count});setStatus('catechism','loading',{language:l,count});try{await api.load?.(l);const n=api.count?.()||0;return setStatus('catechism',n===433?'cached':n?'partial':'error',{language:l,count:n})}catch(e){return setStatus('catechism','error',{language:l,error:String(e?.message||e)})}}
 if(id==='traditionalExercises'){const api=globalThis.AO_TRAD_V352;const q=api?.qa?.();return setStatus(id,q?.allReady?'ready':'partial',{qa:q||null,delivery:'verified embedded package; external package capable'})}
 if(id==='saintBiography'||id==='saintArtwork'){return setStatus(id,'lazy',{trigger:'Saint of the Day open'})}
 return setStatus(id,'ready',{delivery:MANIFEST[id]?.delivery||'existing controller'})}
function moduleStateFromDom(){const c=document.getElementById('ao-cate-root');if(c&&!c.hidden){const text=c.querySelector('.aoCateStatus')?.textContent||'';const n=globalThis.AO_TRADITIONAL_CATECHISM?.count?.()||0;setStatus('catechism',/Complete|Complet/.test(text)&&n===433?'cached':/Loading|Chargement/.test(text)?'loading':n?'partial':'unavailable',{count:n,label:text})}}
function installModuleHooks(){const c=globalThis.AO_TRADITIONAL_CATECHISM;if(c&&!c.__v37){c.__v37=true;const oldOpen=c.open?.bind(c),oldLoad=c.load?.bind(c);if(oldOpen)c.open=(...a)=>{const r=oldOpen(...a);setTimeout(moduleStateFromDom,30);setTimeout(moduleStateFromDom,1200);return r};if(oldLoad)c.load=async(...a)=>{setStatus('catechism','loading',{language:a[0]||lang()});try{const r=await oldLoad(...a);moduleStateFromDom();return r}catch(e){setStatus('catechism','error',{error:String(e?.message||e)});throw e}}}
 const t=globalThis.AO_TRAD_V352;if(t&&!t.__v37){t.__v37=true;const old=t.open?.bind(t);if(old)t.open=(id,...a)=>{setStatus('traditionalExercises','ready',{module:id});return old(id,...a)}}}

function sourcePanelMarkup(){return `<div class="aoV25Hero"><small>Ad Orientem</small><h2>${L('Sources & provenance','Sources et provenance')}</h2><p>${L('Ad Orientem identifies the principal sources used for liturgy, Scripture, formation, prayer and artwork. Detailed citations remain attached to the content they support.','Ad Orientem indique les principales sources utilisées pour la liturgie, l’Écriture, la formation, la prière et les œuvres. Les citations détaillées restent attachées au contenu qu’elles soutiennent.')}</p></div><section class="aoV25Section"><h3>${L('1962 Roman Mass','Messe romaine de 1962')}</h3><div class="aoV25List"><article><p>${L('Liturgical texts and rubrical guidance are drawn from the traditional Roman books and documented contemporary ceremonial sources appropriate to the 1962 rite.','Les textes liturgiques et les indications rubricales proviennent des livres romains traditionnels et de sources cérémonielles contemporaines documentées correspondant au rite de 1962.')}</p></article></div></section><section class="aoV25Section"><h3>${L('Scripture','Écriture')}</h3><div class="aoV25List"><article><p>${L('English Scripture follows the Douay-Rheims tradition. French support includes Crampon 1923 where integrated; Latin liturgical Scripture follows the app’s liturgical sources.','L’Écriture anglaise suit la tradition Douay-Rheims. Le français comprend Crampon 1923 lorsqu’il est intégré ; le latin liturgique suit les sources liturgiques de l’application.')}</p></article></div></section><section class="aoV25Section"><h3>${L('Formation & prayer','Formation et prière')}</h3><div class="aoV25List"><article><p>${L('Catechetical, devotional and historical material keeps its source attribution where available.','Le contenu catéchétique, dévotionnel et historique conserve son attribution de source lorsqu’elle est disponible.')}</p></article></div></section><section class="aoV25Section"><h3>${L('Artwork','Œuvres')}</h3><div class="aoV25List"><article><p>${L('Artwork keeps artist, institution, licence and source-link information whenever available.','Les œuvres conservent les informations relatives à l’artiste, à l’institution, à la licence et au lien source lorsqu’elles sont disponibles.')}</p></article></div></section><p class="aoV25Note">${L('Open the Sources section attached to a prayer, lesson, reading or artwork when you want the detailed citation for that item.','Ouvrez la section Sources liée à une prière, une leçon, une lecture ou une œuvre pour consulter sa citation détaillée.')}</p>`}

function statusRows(){return Object.keys(MANIFEST).map(id=>[id,getStatus(id),MANIFEST[id]])}
function markSaintTimeout(error='Saint manifest/source timeout'){setStatus('saintBiography','error',{error});setStatus('saintArtwork','error',{error});return true}
function diagHtml(){const s=state(),d=currentDaily||cachedDaily(s?.selectedDate||'',s?.language||'en');return `<div class="aoContentV37Backdrop" id="ao-content-v37-panel"><section class="aoContentV37Panel"><header><div><small>AD ORIENTEM · v37</small><h2>${L('Content diagnostics','Diagnostic du contenu')}</h2></div><button class="aoContentV37Close" data-v37-close>×</button></header><p class="aoContentV37Intro">${L('This panel reports delivery state, not whether every byte is embedded in the app.','Ce panneau indique l’état de chargement, et non si chaque octet est intégré dans l’application.')}</p><section class="aoContentV37Section"><h3>${L('Current daily package','Paquet quotidien actuel')}</h3><div class="aoContentV37Grid">${[['Proper',getStatus('proper')],['Scripture',getStatus('scripture')],['Commentary',getStatus('commentary')],['Tomorrow',getStatus('tomorrow')]].map(([n,x])=>`<article class="aoContentV37Row"><div><b>${esc(n)}</b><small>${esc(x.sourcePath||x.reference||x.date||x.scope||x.error||'')}</small></div><span class="aoContentV37Badge ${esc(x.status)}">${esc(x.status)}</span></article>`).join('')}</div>${d?`<p class="aoContentV37Mono">${esc(JSON.stringify({date:d.date,celebration:d.celebration,scripture:d.scripture,commentary:d.commentary,cache:d.cache},null,2))}</p>`:''}</section><section class="aoContentV37Section"><h3>${L('Content families','Familles de contenu')}</h3><div class="aoContentV37Grid">${statusRows().map(([id,x,m])=>`<article class="aoContentV37Row"><div><b>${esc(id)}</b><small>${esc(m.delivery)} · ${esc(m.trigger||'')}</small><small>${esc(x.error||x.label||'')}</small></div><span class="aoContentV37Badge ${esc(x.status)}">${esc(x.status)}</span></article>`).join('')}</div></section><div class="aoContentV37Actions"><button class="primary" data-v37-refresh>${L('Refresh current day','Actualiser le jour')}</button><button data-v37-load-cate>${L('Load Catechism package','Charger le Catéchisme')}</button><button data-v37-close>${L('Close','Fermer')}</button></div></section></div>`}
function openDiagnostics(){closeDiagnostics();document.body.insertAdjacentHTML('beforeend',diagHtml());document.body.classList.add('aoContentV37Open');diagOpen=true;bindDiag();return true}
function closeDiagnostics(){document.getElementById('ao-content-v37-panel')?.remove();document.body.classList.remove('aoContentV37Open');diagOpen=false}
function renderDiagnostics(){if(!diagOpen)return;const old=document.getElementById('ao-content-v37-panel');if(!old)return;old.outerHTML=diagHtml();bindDiag()}
function bindDiag(){const p=document.getElementById('ao-content-v37-panel');if(!p)return;p.addEventListener('click',async e=>{const b=e.target.closest('button');if(!b)return;if(b.hasAttribute('data-v37-close')){closeDiagnostics();return}if(b.hasAttribute('data-v37-refresh')){b.disabled=true;await hydrateDaily(state(),{force:true});renderDiagnostics();return}if(b.hasAttribute('data-v37-load-cate')){b.disabled=true;await loadModule('catechism',{language:lang()});renderDiagnostics();return}})}
function installStore(){const store=globalThis.AO_RUNTIME_V8?.store;if(!store?.subscribe||storeUnsub)return !!storeUnsub;storeUnsub=store.subscribe(()=>{const s=state();if(s?.resolution?.proper?.status==='ready'){const k=dailyKey(s);if(k!==lastDailyKey)setTimeout(()=>hydrateDaily(s),40)}});const s=state();if(s?.resolution?.proper?.status==='ready')setTimeout(()=>hydrateDaily(s),80);return true}
function installModuleHooksBounded(){installModuleHooks();[120,600,1800].forEach(ms=>setTimeout(installModuleHooks,ms))}
function boot(){if(booted)return;booted=true;Object.keys(MANIFEST).forEach(id=>setStatus(id,id==='catechism'||id==='saintBiography'||id==='saintArtwork'?'lazy':'idle'));setStatus('traditionalExercises',globalThis.AO_TRAD_V352?.qa?.()?.allReady?'ready':'partial');installStore();installModuleHooksBounded();moduleStateFromDom();document.addEventListener('keydown',e=>{if(e.key==='Escape'&&diagOpen)closeDiagnostics()});pruneDaily()}
const API={version:VERSION,manifest:MANIFEST,status:(id)=>id?getStatus(id):Object.fromEntries(STATUS),hydrateDaily,cachedDaily,getDaily:()=>currentDaily,getDailyDocument:(slot)=>DAILY_DOCS.get((lastDailyKey||'')+':'+slot)||null,prefetchTomorrow,loadModule,sourcePanelMarkup,markSaintTimeout,moduleStateFromDom,installModuleHooks,openDiagnostics,closeDiagnostics,qa(){const s=state(),p=s?.resolution?.proper?.status==='ready'?s.resolution.proper.data:null;return{version:VERSION,manifestFamilies:Object.keys(MANIFEST).length,coreMassChanged:false,prayerCorpusChanged:false,dailyCoordinator:!!storeUnsub,properReady:!!p,currentDailyKey:lastDailyKey,catechismHooked:!!globalThis.AO_TRADITIONAL_CATECHISM?.__v37,traditionalExercisesHooked:!!globalThis.AO_TRAD_V352?.__v37,terminalSaintGuard:'saint-reader-owned',contentObserver:false,diagnostics:true,tomorrowPrefetch:true,cachePrefix:CACHE_PREFIX}}};
globalThis.AO_CONTENT_V37=API;
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
})();
</script>
<script id="ao-v37-certification-meta">window.AO_COMPLETION_V37={version:'37-content-delivery-architecture',baseline:'v36-HARMONIZED-MASTER',scope:['content manifests','daily payload orchestration','Gospel/Epistle background prefetch','module lazy-load coordination','cache classes','tomorrow Proper prefetch','terminal loader states','content diagnostics','Sources panel modernization'],massEngineChanged:false,prayerCorpusChanged:false,largeCorporaEmbedded:false,policy:'Completeness is source + loader + validation + cache + terminal failure state, not embedding every corpus in the single HTML.'};</script>
<style id="ao-v38-universal-tradition-css">
#aoV38Traditions{position:fixed;inset:0;z-index:2147480800;background:var(--bg,#07111d);color:var(--text,#eee9df);font-family:var(--font-ui,system-ui,sans-serif);overflow:auto;display:none}
#aoV38Traditions.open{display:block}.v38Wrap{width:min(900px,100%);margin:auto;padding:0 16px calc(82px + env(safe-area-inset-bottom,0px))}.v38Top{position:sticky;top:0;z-index:4;display:grid;grid-template-columns:42px 1fr 42px;align-items:center;gap:8px;padding:12px 0;background:color-mix(in srgb,var(--bg,#07111d) 94%,transparent);backdrop-filter:blur(12px);border-bottom:1px solid var(--border,rgba(255,255,255,.13))}.v38Top button{width:40px;height:40px;border:1px solid var(--border,rgba(255,255,255,.16));border-radius:10px;background:var(--surface-1,#102235);color:inherit;font-size:1.1rem}.v38Top small{display:block;color:var(--liturgical,#c7ae6d);font:600 .67rem/1.2 var(--font-display,serif);letter-spacing:.1em;text-transform:uppercase}.v38Top h1{margin:2px 0 0;font:600 clamp(1.35rem,5vw,1.9rem)/1.08 var(--font-display,Georgia,serif)}.v38Intro{padding:18px 0 11px;color:var(--muted,rgba(238,233,223,.7));line-height:1.5}.v38List{display:grid;gap:2px;border-top:1px solid var(--border,rgba(255,255,255,.14));margin:8px 0 22px}.v38Row{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;width:100%;text-align:left;padding:14px 2px;border:0;border-bottom:1px solid var(--border,rgba(255,255,255,.14));background:transparent;color:inherit}.v38Row strong{display:block;font:600 1.02rem/1.2 var(--font-display,Georgia,serif)}.v38Row span{display:block;margin-top:4px;color:var(--muted,rgba(238,233,223,.68));font-size:.82rem;line-height:1.35}.v38Arrow{font-size:1.15rem;color:var(--liturgical,#c7ae6d)}.v38Section{margin:18px 0}.v38Section h2{font:600 1.2rem var(--font-display,Georgia,serif);margin:0 0 8px}.v38Section>p{color:var(--muted,rgba(238,233,223,.72));line-height:1.52}.v38Status{display:inline-flex;align-items:center;min-height:23px;padding:3px 7px;border:1px solid var(--liturgical-border,rgba(199,174,109,.35));border-radius:999px;color:var(--liturgical,#c7ae6d);font:600 .62rem var(--font-display,serif);letter-spacing:.065em;text-transform:uppercase;margin-bottom:8px}.v38Card{padding:14px 0;border-bottom:1px solid var(--border,rgba(255,255,255,.13))}.v38Card h3{margin:0 0 5px;font:600 1.04rem var(--font-display,Georgia,serif)}.v38Card p{margin:5px 0;color:var(--muted,rgba(238,233,223,.72));line-height:1.48}.v38Actions{display:flex;flex-wrap:wrap;gap:7px;margin:10px 0}.v38Actions button,.v38Actions a{display:inline-flex;align-items:center;min-height:36px;padding:8px 10px;border:1px solid var(--border,rgba(255,255,255,.16));border-radius:9px;background:var(--surface-1,#102235);color:inherit;text-decoration:none;font:600 .76rem var(--font-ui,system-ui)}.v38Actions .primary{background:var(--liturgical-soft,rgba(199,174,109,.13));border-color:var(--liturgical-border,rgba(199,174,109,.4))}.v38Source{margin-top:10px;font-size:.72rem}.v38Source summary{cursor:pointer;color:var(--muted,rgba(238,233,223,.58))}.v38Source a{color:var(--liturgical,#c7ae6d)}.v38Scripture{padding:16px 0}.v38ScriptureHead{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;margin-bottom:10px}.v38ScriptureHead h2{margin:0;font:600 1.35rem var(--font-display,Georgia,serif)}.v38ScriptureText{font:400 1.08rem/1.65 var(--font-liturgical,Georgia,serif);white-space:normal}.v38Verse{display:block;margin:0 0 7px}.v38Verse sup{color:var(--liturgical,#c7ae6d);font:600 .65rem var(--font-ui,system-ui);margin-right:5px}.v38Loading{padding:28px 0;color:var(--muted,rgba(238,233,223,.65))}.v38Tabs{display:flex;gap:6px;overflow:auto;padding:3px 0 10px}.v38Tabs button{white-space:nowrap;border:1px solid var(--border,rgba(255,255,255,.16));background:transparent;color:inherit;border-radius:999px;padding:7px 10px;font-size:.72rem}.v38Tabs button.active{border-color:var(--liturgical,#c7ae6d);background:var(--liturgical-soft,rgba(199,174,109,.12))}.v38Timeline{display:grid;gap:0}.v38Timeline .v38Card{padding-left:13px;border-left:2px solid var(--liturgical-border,rgba(199,174,109,.32))}.v38Note{padding:10px 12px;border-left:2px solid var(--liturgical,#c7ae6d);background:var(--liturgical-soft,rgba(199,174,109,.08));color:var(--muted,rgba(238,233,223,.77));font-size:.82rem;line-height:1.45;margin:10px 0}.v38RosaryForm{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin:0 0 11px}.v38RosaryForm button{border:1px solid var(--line,var(--border));border-radius:12px;background:transparent;color:inherit;text-align:left;padding:11px}.v38RosaryForm button.active{border-color:var(--gold,var(--liturgical));background:color-mix(in srgb,var(--gold,var(--liturgical)) 12%,transparent)}.v38RosaryForm strong,.v38RosaryForm span{display:block}.v38RosaryForm span{font-size:.73rem;color:var(--muted);margin-top:3px}.v38RosaryIntentionPrayer{margin:14px 0}.v38RosaryIntentionPrayer>strong{display:block;font-size:.75rem;color:#6b5225;margin-bottom:5px}.v38IntentLead{font-style:italic}.v38RosaryIntentionClose{white-space:pre-wrap;margin-top:16px;font:400 1.05rem/1.55 var(--serif,Georgia,serif)}
#aoPrayerBookRoot .rc2ModuleTools .rc2ModePill{display:none!important}
@media(max-width:520px){.v38Wrap{padding-inline:13px}.v38RosaryForm{grid-template-columns:1fr}.v38Top{grid-template-columns:40px 1fr 40px}.v38Row{padding-block:13px}}
</style>
<script id="ao-v38-universal-tradition-js">
(()=>{'use strict';
const VERSION='38.0';
const STATUS=Object.freeze({CURRENT:'Current discipline',TRADITIONAL:'Traditional practice',HISTORICAL:'Historical discipline',RITUAL1952:'1952 Roman Ritual',PRACTICE1962:'1962 liturgical practice'});
const SOURCES=Object.freeze({
 baltimore:'https://en.wikisource.org/wiki/A_Manual_of_Prayers_for_the_Use_of_the_Catholic_Laity',
 sevenWords:'https://en.wikisource.org/wiki/A_Manual_of_Prayers_for_the_Use_of_the_Catholic_Laity/The_Devotion_of_the_Seven_Words_upon_the_Cross',
 fortyHours:'https://en.wikisource.org/wiki/A_Manual_of_Prayers_for_the_Use_of_the_Catholic_Laity/The_Devotion_of_the_Forty_Hours%27_Adoration',
 confessionOld:'https://www.vatican.va/roman_curia/tribunals/apost_penit/documents/rc_trib_appen_doc_20060921_stafford-reconciliation_en.html',
 confessionCurrent:'https://www.vatican.va/content/catechism/en/part_two/section_two/chapter_two/article_4/vi_the_sacrament_of_penance_and_reconciliation.html',
 oldRitualPermission:'https://www.vatican.va/roman_curia/congregations/ccdds/documents/rc_con_ccdds_doc_20211204_responsa-ad-dubia-tradizionis-custodes_en.html',
 currentFast:'https://www.vatican.va/archive/cod-iuris-canonici/eng/documents/cic_lib4-cann879-958_en.html',
 penanceLaw:'https://www.vatican.va/archive/cod-iuris-canonici/eng/documents/cic_lib4-cann1244-1253_en.html',
 popularPiety:'https://www.vatican.va/roman_curia/congregations/ccdds/documents/rc_con_ccdds_doc_20020513_vers-direttorio_en.html',
 fast1957:'https://www.vatican.va/archive/aas/documents/AAS-49-1957-ocr.pdf'
});
const PSALMS=[{trad:6,modern:6},{trad:31,modern:32},{trad:37,modern:38},{trad:50,modern:51},{trad:101,modern:102},{trad:129,modern:130},{trad:142,modern:143}];
const WORDS=[
 {n:1,ref:'Luke 23:34'},{n:2,ref:'Luke 23:43'},{n:3,ref:'John 19:26–27'},{n:4,ref:'Matthew 27:46'},{n:5,ref:'John 19:28'},{n:6,ref:'John 19:30'},{n:7,ref:'Luke 23:46'}
];
const EXTRA={
 'learn.traditions':{id:'learn.traditions',type:'module',domain:'learn',title:'Traditional Catholic Life'},
 'pray.penitential_psalms':{id:'pray.penitential_psalms',type:'module',domain:'pray',title:'Seven Penitential Psalms'},
 'pray.seven_words':{id:'pray.seven_words',type:'module',domain:'pray',title:'Seven Words of Our Lord'},
 'learn.rites.penance':{id:'learn.rites.penance',type:'module',domain:'learn',title:'Confession · Prepare & Follow'},
 'learn.discipline':{id:'learn.discipline',type:'module',domain:'learn',title:'Traditional Discipline'},
 'learn.pilgrimage':{id:'learn.pilgrimage',type:'module',domain:'learn',title:'Pilgrimage & Shrines'},
 'learn.liturgical_year':{id:'learn.liturgical_year',type:'module',domain:'learn',title:'Traditional Liturgical Year'},
 'learn.serve_mass':{id:'learn.serve_mass',type:'module',domain:'learn',title:'Serving Low Mass'},
 'learn.asperges':{id:'learn.asperges',type:'module',domain:'learn',title:'Asperges & Vidi Aquam'},
 'pray.forty_hours':{id:'pray.forty_hours',type:'module',domain:'pray',title:'Forty Hours'},
 'learn.sacraments':{id:'learn.sacraments',type:'module',domain:'learn',title:'Sacramental Life'}
};
let root=null,view='learn.traditions',sub=null,returnFocus=null;
const rt=()=>window.AO_RUNTIME_V8;
const state=()=>rt()?.store?.getState?.()||{};
const fr=()=>state()?.language==='fr';
const T=(a,b)=>fr()?b:a;
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
const status=s=>`<span class="v38Status">${esc(fr()?({[STATUS.CURRENT]:'Discipline actuelle',[STATUS.TRADITIONAL]:'Pratique traditionnelle',[STATUS.HISTORICAL]:'Discipline historique',[STATUS.RITUAL1952]:'Rituel romain 1952',[STATUS.PRACTICE1962]:'Pratique liturgique de 1962'}[s]||s):s)}</span>`;
const src=(label,url,note='')=>`<details class="v38Source"><summary>${T('Source','Source')} · ${esc(label)}</summary>${note?`<p>${esc(note)}</p>`:''}<a href="${esc(url)}" target="_blank" rel="noopener">${T('Open source','Ouvrir la source')} ↗</a></details>`;
function ensure(){if(root)return root;root=document.createElement('section');root.id='aoV38Traditions';root.setAttribute('aria-hidden','true');document.body.appendChild(root);return root}
function top(title,kicker='AD ORIENTEM'){return `<div class="v38Top"><button type="button" data-v38-back aria-label="${T('Back','Retour')}">←</button><div><small>${esc(kicker)}</small><h1>${esc(title)}</h1></div><button type="button" data-v38-close aria-label="${T('Close','Fermer')}">×</button></div>`}
function row(id,title,desc){return `<button class="v38Row" data-v38-open="${esc(id)}"><span><strong>${esc(title)}</strong><span>${esc(desc)}</span></span><b class="v38Arrow">›</b></button>`}
function shell(title,body,kicker){return `<div class="v38Wrap">${top(title,kicker)}${body}</div>`}
function hub(){return shell(T('Traditional Catholic Life','Vie catholique traditionnelle'),`<p class="v38Intro">${T('A lay companion for prayer, preparation and participation. Historical rites remain available only insofar as they help the faithful prepare, respond, receive the sacraments or understand what they are witnessing.','Un compagnon laïc pour la prière, la préparation et la participation. Les rites historiques ne sont présentés que dans la mesure où ils aident les fidèles à se préparer, répondre, recevoir les sacrements ou comprendre ce qu’ils voient.')}</p><div class="v38List">${row('pray.penitential_psalms',T('Seven Penitential Psalms','Sept psaumes pénitentiels'),T('Pray · Scripture · traditional Psalter','Prier · Écriture · Psautier traditionnel'))}${row('pray.seven_words',T('Seven Words of Our Lord','Sept Paroles de Notre-Seigneur'),T('Pray · Passion devotion','Prier · dévotion de la Passion'))}${row('learn.rites.penance',T('Confession · Prepare & Follow','Confession · Se préparer & suivre'),T('Prepare · confess · understand the form you encounter','Se préparer · se confesser · comprendre la forme rencontrée'))}${row('learn.sacraments',T('Sacramental Life','Vie sacramentelle'),T('Prepare · respond · receive · follow','Se préparer · répondre · recevoir · suivre'))}${row('learn.discipline',T('Traditional discipline','Discipline traditionnelle'),T('Current obligations beside older voluntary practice','Obligations actuelles à côté des pratiques anciennes volontaires'))}${row('learn.liturgical_year',T('Traditional liturgical year','Année liturgique traditionnelle'),T('What the faithful can pray and observe through the year','Ce que les fidèles peuvent prier et observer au fil de l’année'))}${row('learn.pilgrimage',T('Pilgrimage & shrines','Pèlerinage & sanctuaires'),T('Prepare · pray · visit · give thanks','Se préparer · prier · visiter · rendre grâce'))}${row('learn.serve_mass',T('Serve Low Mass','Servir la Messe basse'),T('A real lay ministry · responses and practice','Un véritable service laïc · réponses et entraînement'))}${row('learn.asperges',T('Asperges & Vidi Aquam','Asperges & Vidi Aquam'),T('Follow and respond at the Sunday sprinkling','Suivre et répondre lors de l’aspersion dominicale'))}${row('pray.forty_hours',T('Forty Hours','Quarante-Heures'),T('Pray · adore · follow the devotion','Prier · adorer · suivre la dévotion'))}</div>`) }
async function scriptureDoc(ref,kind='scripture'){const svc=rt()?.scriptureService;if(!svc)throw new Error(T('Scripture service is not available.','Le service de l’Écriture n’est pas disponible.'));return await svc.load(kind,{en:ref,fr:ref,lat:ref})}
function rowsFor(doc,full=false,language='vernacular'){const rows=language==='la'?(doc?.latinChapter||[]):fr()?(doc?.frenchChapter||[]):(doc?.englishChapter||[]);if(full)return rows;const r=doc?.reference;if(!r)return rows;return rows.filter(x=>+x.verse>=+r.start&&+x.verse<=+r.end)}
function scriptureText(rows){return rows.length?`<div class="v38ScriptureText">${rows.map(v=>`<span class="v38Verse"><sup>${esc(v.verse)}</sup>${esc(v.text||v.value||'')}</span>`).join('')}</div>`:`<p class="v38Loading">${T('Text unavailable in the configured Scripture source.','Texte indisponible dans la source scripturaire configurée.')}</p>`}
function scripturePair(doc,full=false){return `<div class="v38ScripturePair"><section><div class="v38ScriptureLang">LATIN · VULGATA CLEMENTINA</div>${scriptureText(rowsFor(doc,full,'la'))}</section><section><div class="v38ScriptureLang">${fr()?'FRANÇAIS · CRAMPON 1923':'ENGLISH · DOUAY-RHEIMS'}</div>${scriptureText(rowsFor(doc,full,'vernacular'))}</section></div>`}
function psalms(){const list=PSALMS.map((p,i)=>row('pray.penitential_psalms#'+i,`Psalm ${p.trad}${p.modern!==p.trad?' ('+p.modern+')':''}`,i===3?'Miserere':i===5?'De profundis':T('Traditional penitential psalm','Psaume pénitentiel traditionnel'))).join('');return shell(T('Seven Penitential Psalms','Sept psaumes pénitentiels'),`<p class="v38Intro">${T('The traditional set is Psalms 6, 31, 37, 50, 101, 129 and 142 in Vulgate numbering. Modern Hebrew numbering is shown in parentheses where it differs.','La série traditionnelle comprend les psaumes 6, 31, 37, 50, 101, 129 et 142 selon la Vulgate. La numérotation hébraïque moderne est indiquée entre parenthèses lorsqu’elle diffère.')}</p>${status(STATUS.TRADITIONAL)}<div class="v38List">${list}</div>${src('Baltimore Manual · Seven Penitential Psalms',SOURCES.baltimore)}`)}
async function psalmDetail(i){const p=PSALMS[i];root.innerHTML=shell(`Psalm ${p.trad}${p.modern!==p.trad?' ('+p.modern+')':''}`,`<p class="v38Loading">${T('Loading Scripture…','Chargement de l’Écriture…')}</p>`);bind();try{const doc=await scriptureDoc(`Psalms ${p.trad}:1`,'psalm');root.innerHTML=shell(`Psalm ${p.trad}${p.modern!==p.trad?' ('+p.modern+')':''}`,`<div class="v38Scripture">${scripturePair(doc,true)}</div>${src(T('Scripture source and traditional commentary are resolved by Ad Orientem','La source scripturaire et le commentaire traditionnel sont résolus par Ad Orientem'),SOURCES.baltimore,T('Psalm numbering here follows the traditional/Vulgate Psalter.','La numérotation suit ici le Psautier traditionnel/Vulgate.'))}`);bind()}catch(e){root.innerHTML=shell(`Psalm ${p.trad}`,`<p class="v38Intro">${esc(String(e.message||e))}</p>${src('Baltimore Manual',SOURCES.baltimore)}`);bind()}}
function sevenWords(){return shell(T('Seven Words of Our Lord','Sept Paroles de Notre-Seigneur'),`<p class="v38Intro">${T('A Passion devotion preserved in the Baltimore Manual. Ad Orientem supplies the Gospel words directly from its Scripture service rather than composing meditations around them.','Une dévotion de la Passion conservée dans le Baltimore Manual. Ad Orientem fournit les paroles évangéliques directement depuis son service de l’Écriture au lieu de composer des méditations autour d’elles.')}</p>${status(STATUS.TRADITIONAL)}<div class="v38List">${WORDS.map((w,i)=>row('pray.seven_words#'+i,T('Word','Parole')+' '+w.n,w.ref)).join('')}</div>${src('Baltimore Manual · The Devotion of the Seven Words upon the Cross',SOURCES.sevenWords)}`)}
async function wordDetail(i){const w=WORDS[i];root.innerHTML=shell(`${T('Word','Parole')} ${w.n}`,`<p class="v38Loading">${T('Loading Scripture…','Chargement de l’Écriture…')}</p>`);bind();try{const doc=await scriptureDoc(w.ref,docKind(w.ref));root.innerHTML=shell(`${T('Word','Parole')} ${w.n}`,`<div class="v38Scripture"><div class="v38ScriptureHead"><h2>${esc(fr()?doc.reference?.displayFr||w.ref:doc.reference?.display||w.ref)}</h2></div>${scripturePair(doc,false)}</div>${src('Baltimore Manual · Seven Words',SOURCES.sevenWords)}`);bind()}catch(e){root.innerHTML=shell(`${T('Word','Parole')} ${w.n}`,`<p class="v38Intro">${esc(w.ref)} · ${esc(String(e.message||e))}</p>${src('Baltimore Manual · Seven Words',SOURCES.sevenWords)}`);bind()}}
function docKind(ref){return /Matthew|Mark|Luke|John/i.test(ref)?'gospel':'scripture'}
function penance(){const old=sub!=='current';return shell(T('Confession · Prepare & Follow','Confession · Se préparer & suivre'),`<p class="v38Intro">${T('This guide is for the penitent. It helps you prepare, know what you may be asked to do, and recognize the form being used. It is not a confessor’s manual.','Ce guide est destiné au pénitent. Il aide à se préparer, à savoir ce que l’on peut vous demander et à reconnaître la forme employée. Ce n’est pas un manuel de confesseur.')}</p><div class="v38Tabs"><button class="${old?'active':''}" data-v38-sub="old">${T('Traditional form','Forme traditionnelle')}</button><button class="${!old?'active':''}" data-v38-sub="current">${T('Current form','Forme actuelle')}</button></div>${old?`${status(STATUS.RITUAL1952)}<div class="v38Timeline"><div class="v38Card"><h3>${T('PREPARE','SE PRÉPARER')}</h3><p>${T('Examine your conscience, be sincerely contrite, be ready to confess your sins honestly and to accept a penance. The traditional Lasance/Baltimore preparation remains available in Ad Orientem.','Examinez votre conscience, ayez une contrition sincère, soyez prêt à confesser honnêtement vos péchés et à accepter une pénitence. La préparation traditionnelle de Lasance/Baltimore reste disponible dans Ad Orientem.')}</p></div><div class="v38Card"><h3>${T('CONFESS & RESPOND','SE CONFESSER & RÉPONDRE')}</h3><p>${T('Confess your sins and follow the priest’s prompts. The older Roman form contains additional prayers around the absolution, so it may sound different from a modern Confession even though your essential acts remain contrition, confession and satisfaction.','Confessez vos péchés et suivez les indications du prêtre. L’ancienne forme romaine comporte des prières supplémentaires autour de l’absolution ; elle peut donc sonner différemment d’une confession moderne, même si vos actes essentiels restent la contrition, la confession et la satisfaction.')}</p></div><div class="v38Card"><h3>${T('AFTER','APRÈS')}</h3><p>${T('Complete the penance given to you and make thanksgiving. Ad Orientem keeps the traditional thanksgiving prayers with the Confession preparation.','Accomplissez la pénitence reçue et rendez grâce. Ad Orientem conserve les prières traditionnelles d’action de grâces avec la préparation à la Confession.')}</p></div><div class="v38Note">${T('Availability of the older Ritual depends on the priest/community and applicable ecclesiastical permission; this screen does not instruct a priest how to celebrate it.','La disponibilité de l’ancien Rituel dépend du prêtre/de la communauté et des permissions ecclésiastiques applicables ; cet écran n’indique pas au prêtre comment le célébrer.')}</div></div>${src('Apostolic Penitentiary · comparison of the old and current forms',SOURCES.confessionOld)}${src('Holy See · 2021 Responsa on the 1952 Rituale',SOURCES.oldRitualPermission)}`:`${status(STATUS.CURRENT)}<div class="v38Timeline"><div class="v38Card"><h3>${T('PREPARE','SE PRÉPARER')}</h3><p>${T('Examine your conscience, be contrite, and be ready to confess your sins and accept satisfaction.','Examinez votre conscience, ayez la contrition et soyez prêt à confesser vos péchés et à accepter la satisfaction.')}</p></div><div class="v38Card"><h3>${T('CONFESS & RESPOND','SE CONFESSER & RÉPONDRE')}</h3><p>${T('The individual rite can include a greeting, Scripture, confession, an act expressing sorrow, absolution, praise and dismissal. Follow the priest’s prompts; the app does not reproduce the priest’s ritual script.','Le rite individuel peut comprendre un accueil, l’Écriture, la confession, un acte exprimant la contrition, l’absolution, la louange et le renvoi. Suivez les indications du prêtre ; l’application ne reproduit pas le script rituel du prêtre.')}</p></div><div class="v38Card"><h3>${T('AFTER','APRÈS')}</h3><p>${T('Fulfil your penance and give thanks for sacramental forgiveness.','Accomplissez votre pénitence et rendez grâce pour le pardon sacramentel.')}</p></div></div>${src('Catechism of the Catholic Church · Penance and Reconciliation',SOURCES.confessionCurrent)}`}<div class="v38Actions"><button class="primary" data-v38-canonical="pray.confession">${T('Prepare for Confession','Se préparer à la Confession')}</button></div>`) }
function discipline(){const x=window.AO_LITURGICAL_YEAR_V384;return shell(T('Traditional Discipline','Discipline traditionnelle'),x?.disciplineHTML?.(state()?.selectedDate,fr())||`<p class="v38Intro">${T('Discipline reference is loading…','Chargement de la référence disciplinaire…')}</p>`)}
function pilgrimage(){return shell(T('Pilgrimage & Shrines','Pèlerinage & sanctuaires'),`<p class="v38Intro">${T('A universal pilgrimage companion: the app supplies preparation and links to sourced prayer modules without inventing a special pilgrimage prayer.','Un compagnon universel de pèlerinage : l’application fournit la préparation et des liens vers des modules de prière sourcés sans inventer une prière spéciale de pèlerinage.')}</p>${status(STATUS.TRADITIONAL)}<div class="v38Timeline"><div class="v38Card"><h3>${T('Before setting out','Avant le départ')}</h3><p>${T('Choose an intention. If appropriate, prepare for Confession and Mass. The traditional Roman Ritual also contains a clerical blessing of pilgrims; it is a rite to receive, not a lay do-it-yourself formula.','Choisissez une intention. Si cela convient, préparez-vous à la Confession et à la Messe. Le Rituel romain traditionnel contient aussi une bénédiction des pèlerins par le ministre ; c’est un rite à recevoir, non une formule à accomplir soi-même.')}</p></div><div class="v38Card"><h3>${T('On the way','En chemin')}</h3><p>${T('Rosary, psalms, litanies, sacred reading and periods of silence are appropriate forms of prayer according to the character of the pilgrimage.','Rosaire, psaumes, litanies, lecture sacrée et périodes de silence conviennent selon le caractère du pèlerinage.')}</p></div><div class="v38Card"><h3>${T('At the shrine','Au sanctuaire')}</h3><p>${T('The Church recommends that pilgrimage culminate especially in prayer, Penance and the Eucharist where these are available, followed by thanksgiving.','L’Église recommande que le pèlerinage culmine particulièrement dans la prière, la Pénitence et l’Eucharistie lorsqu’elles sont disponibles, puis dans l’action de grâces.')}</p></div></div><div class="v38Actions"><button data-v38-canonical="pray.rosary">${T('Rosary','Rosaire')}</button><button data-v38-canonical="pray.confession">${T('Confession','Confession')}</button><button data-v38-canonical="mass.prepare">${T('Prepare for Mass','Préparer la Messe')}</button></div>${src('Directory on Popular Piety · Shrines and Pilgrimages',SOURCES.popularPiety)}`)}
function liturgicalYear(){const x=window.AO_LITURGICAL_YEAR_V384;return shell(T('Traditional Liturgical Year','Année liturgique traditionnelle'),x?.yearHTML?.(state()?.selectedDate,fr())||`<p class="v38Intro">${T('Liturgical-year companion is loading…','Chargement du compagnon de l’année liturgique…')}</p>`)}
function serveMass(){return shell(T('Serving Low Mass','Servir la Messe basse'),`<p class="v38Intro">${T('The Baltimore Manual contains an actual “Manner of Serving Mass.” Ad Orientem therefore treats serving as a historical liturgical skill, not as an invented training game.','Le Baltimore Manual contient une véritable « Manner of Serving Mass ». Ad Orientem traite donc le service de la Messe comme une compétence liturgique historique, non comme un jeu d’entraînement inventé.')}</p>${status(STATUS.TRADITIONAL)}<div class="v38Card"><h3>${T('What this first implementation does','Ce que fait cette première implémentation')}</h3><p>${T('It connects the historical serving guide to the certified Low Mass follower. A dedicated response-practice player will be added only from an exact server-card/manual transcription; the app does not improvise rubrics.','Elle relie le guide historique du servant au suivi certifié de la Messe basse. Un lecteur d’entraînement des réponses ne sera ajouté qu’à partir d’une transcription exacte d’un manuel/carte de servant ; l’application n’improvise pas les rubriques.')}</p></div><div class="v38Actions"><button class="primary" data-v38-canonical="mass.follow">${T('Open Mass follower','Ouvrir le suivi de la Messe')}</button></div>${src('Baltimore Manual · Manner of Serving Mass',SOURCES.baltimore,T('See the serving section around p. 106 in the historical manual.','Voir la section sur le service de la Messe vers la p. 106 du manuel historique.'))}`)}
const V38_ASPERGES_TEXT=Object.freeze({"asperges":{"en":"Ps 50:9\nThou shalt sprinkle me, O Lord, with hyssop, and I shall be cleansed; Thou shalt wash me, and I shall become whiter than snow.\nPs 50:3\nHave mercy on me, O God, according to Thy great mercy.\n℣. Glory be to the Father, and to the Son, and to the Holy Ghost.\n℟. As it was in the beginning, is now, and ever shall be, world without end. Amen.\nThou shalt sprinkle me, O Lord, with hyssop, and I shall be cleansed; Thou shalt wash me, and I shall become whiter than snow.","lat":"Ps 50:9\nAspérges me, Dómine, hyssópo, et mundábor: lavábis me, et super nivem dealbábor.\nPs 50:3\nMiserére mei, Deus, secúndum magnam misericórdiam tuam.\n℣. Glória Patri, et Fílio, et Spirítui Sancto.\n℟. Sicut erat in princípio, et nunc, et semper: et in saecula sæculórum. Amen.\nAspérges me, Dómine, hyssópo, et mundábor: lavábis me, et super nivem dealbábor.","fr":"Ps 50, 9\nVous m’aspergerez, Seigneur, avec l’hysope, et je serai purifié ; vous me laverez, et je deviendrai plus blanc que la neige.\nPs 50, 3\nAyez pitié de moi, ô Dieu, selon votre grande miséricorde.\n℣. Gloire au Père, et au Fils, et au Saint-Esprit.\n℟. Comme il était au commencement, maintenant et toujours, et dans les siècles des siècles. Ainsi soit-il.\nVous m’aspergerez, Seigneur, avec l’hysope, et je serai purifié ; vous me laverez, et je deviendrai plus blanc que la neige."},"vidiAquam":{"en":"Ez 47:1-2; 47:9\nI saw water flowing from the right side of the temple, alleluia; and all they to whom that water came were saved; and they shall say: alleluia, alleluia.\nPs 135:1\nPraise the Lord, because He is good; because His mercy endureth forever.\n℣. Glory be to the Father, and to the Son, and to the Holy Ghost.\n℟. As it was in the beginning, is now, and ever shall be, world without end. Amen.\nI saw water flowing from the right side of the temple, alleluia; and all they to whom that water came were saved; and they shall say: alleluia, alleluia.","lat":"Ez 47:1-2; 47:9\nVidi aquam egrediéntem de templo, a látere dextro, allelúia: et omnes, ad quos pervénit aqua ista, salvi facti sunt, et dicent, allelúia, allelúia.\nPs 135:1\nConfitemini Dómino quóniam bonus: quóniam in saeculum misericórdia eius.\n℣. Glória Patri, et Fílio, et Spirítui Sancto.\n℟. Sicut erat in princípio, et nunc, et semper: et in saecula sæculórum. Amen.\nVidi aquam egrediéntem de templo, a látere dextro, allelúia: et omnes, ad quos pervénit aqua ista, salvi facti sunt, et dicent, allelúia, allelúia.","fr":"Ez 47, 1-2 ; 47, 9\nJ’ai vu l’eau jaillir du côté droit du Temple, alléluia ; et tous ceux que cette eau a atteints ont été sauvés, et ils chanteront : alléluia, alléluia.\nPs 135, 1\nLouez le Seigneur, car il est bon, car sa miséricorde est éternelle.\n℣. Gloire au Père, et au Fils, et au Saint-Esprit.\n℟. Comme il était au commencement, maintenant et toujours, et dans les siècles des siècles. Ainsi soit-il.\nJ’ai vu l’eau jaillir du côté droit du Temple, alléluia ; et tous ceux que cette eau a atteints ont été sauvés, et ils chanteront : alléluia, alléluia."},"aspergesVers":{"en":"℣. Show us, O Lord, Thy mercy.\n℟. And grant us Thy salvation.\n℣. O Lord, hear my prayer.\n℟. And let my cry come unto Thee.\n℣. The Lord be with you.\n℟. And with thy spirit.\nLet us pray.\nHear us, O holy Lord, almighty Father, everlasting God, and vouchsafe to send Thy holy Angel from heaven, to guard, cherish, protect, visit and defend all that are assembled in this place: Through Christ our Lord.\n℟. Amen.","lat":"℣. Osténde nobis, Dómine, misericórdiam tuam.\n℟. Et salutáre tuum da nobis.\n℣. Dómine, exáudi oratiónem meam.\n℟. Et clamor meus ad te véniat.\n℣. Dóminus vobíscum.\n℟. Et cum spíritu tuo.\nOrémus.\nExáudi nos, Dómine sancte, Pater omnípotens, ætérne Deus, et míttere dignéris sanctum Angelum tuum de cælis, qui custódiat, fóveat, prótegat, vísitet, atque deféndat omnes habitántes in hoc habitáculo. Per Christum Dóminum nostrum.\n℟. Amen.","fr":"℣. Montrez-nous, Seigneur, votre miséricorde.\n℟. Et donnez-nous votre salut.\n℣. Seigneur, exaucez ma prière.\n℟. Et que mon cri parvienne jusqu’à vous.\n℣. Le Seigneur soit avec vous.\n℟. Et avec votre esprit.\nPrions.\nExaucez-nous, Seigneur saint, Père tout-puissant, Dieu éternel, et daignez envoyer du ciel votre saint Ange afin qu’il garde, soutienne, protège, visite et défende tous ceux qui sont rassemblés en ce lieu. Par le Christ notre Seigneur.\n℟. Ainsi soit-il."}});
function aspergesText(title,x){const vern=fr()?x.fr:x.en;return `<div class="v38RiteText"><h3>${esc(title)}</h3><div class="v38ScripturePair"><section><div class="v38ScriptureLang">LATIN</div><div class="v38RiteBody">${esc(x.lat||'')}</div></section><section><div class="v38ScriptureLang">${fr()?'FRANÇAIS':'ENGLISH'}</div><div class="v38RiteBody">${esc(vern||'')}</div></section></div></div>`}
function asperges(){return shell(T('Asperges & Vidi Aquam','Asperges & Vidi Aquam'),`<p class="v38Intro">${T('A lay companion to the Sunday sprinkling before the principal Mass. The texts below are the same certified texts already used by the Mass follower; no new liturgical text is composed here.','Un compagnon laïc pour l’aspersion dominicale avant la Messe principale. Les textes ci-dessous sont les mêmes textes certifiés déjà utilisés par le suivi de la Messe ; aucun nouveau texte liturgique n’est composé ici.')}</p>${status(STATUS.PRACTICE1962)}<div class="v38Card"><h3>Asperges me</h3><p>${T('The normal Sunday sprinkling chant outside Paschaltide.','Chant normal de l’aspersion dominicale hors temps pascal.')}</p></div>${aspergesText('Asperges me',V38_ASPERGES_TEXT.asperges)}<div class="v38Card"><h3>Vidi aquam</h3><p>${T('Used in Paschaltide in place of Asperges me.','Utilisé au temps pascal à la place de l’Asperges me.')}</p></div>${aspergesText('Vidi aquam',V38_ASPERGES_TEXT.vidiAquam)}${aspergesText(T('Versicles & collect','Versets & oraison'),V38_ASPERGES_TEXT.aspergesVers)}${src('1962 Mass Ordinary · certified Ad Orientem corpus',SOURCES.baltimore,T('Text is reused from the app’s fixed Ordinary; the Baltimore witness remains linked for historical context.','Le texte est réutilisé depuis l’Ordinaire fixe de l’application ; le témoin de Baltimore reste lié pour le contexte historique.'))}`)}
function fortyHours(){return shell(T('Forty Hours','Quarante-Heures'),`<p class="v38Intro">${T('The Baltimore Manual treats Forty Hours as an established Eucharistic devotion and points the faithful to existing litanies, psalms, Te Deum and a Visit to the Blessed Sacrament. Ad Orientem therefore avoids a forty-hour timer or an invented programme.','Le Baltimore Manual traite les Quarante-Heures comme une dévotion eucharistique établie et renvoie les fidèles à des litanies, psaumes, au Te Deum et à une Visite au Saint-Sacrement. Ad Orientem évite donc un minuteur de quarante heures ou un programme inventé.')}</p>${status(STATUS.TRADITIONAL)}<div class="v38List">${row('pray.penitential_psalms#3','Miserere · Psalm 50 (51)',T('Penitential prayer','Prière pénitentielle'))}${row('pray.penitential_psalms#5','De profundis · Psalm 129 (130)',T('Prayer for the dead','Prière pour les défunts'))}</div><div class="v38Actions"><button data-v38-canonical="pray.adoration">${T('Adoration','Adoration')}</button><button data-v38-canonical="pray.benediction">${T('Benediction','Bénédiction')}</button><button data-v38-canonical="pray.rosary">${T('Rosary','Rosaire')}</button></div>${src('Baltimore Manual · The Devotion of the Forty Hours’ Adoration',SOURCES.fortyHours)}`)}
function sacraments(){return shell(T('Sacramental Life','Vie sacramentelle'),`<p class="v38Intro">${T('Only the parts useful to the faithful are surfaced here: preparation, your responses and actions, what you will receive, and enough explanation to follow the ceremony. Minister-only rubrics remain source material, not user modules.','Seules les parties utiles aux fidèles sont présentées ici : préparation, vos réponses et actions, ce que vous recevrez et l’explication nécessaire pour suivre la cérémonie. Les rubriques réservées au ministre restent des sources, non des modules utilisateur.')}</p><div class="v38List">${row('learn.rites.penance',T('Confession','Confession'),T('Prepare · confess · thanksgiving','Se préparer · se confesser · action de grâces'))}${row('learn.sacraments#sick',T('Serious illness & dying','Maladie grave & fin de vie'),T('Call the priest · prepare · pray · understand Anointing and Viaticum','Appeler le prêtre · se préparer · prier · comprendre l’Onction et le Viatique'))}${row('learn.sacraments#baptism',T('Baptism · Parents & Godparents','Baptême · Parents & parrains'),T('Prepare · respond · follow the ceremony','Se préparer · répondre · suivre la cérémonie'))}${row('learn.sacraments#matrimony',T('Matrimony · Bride & Groom','Mariage · Époux'),T('Prepare · consent · Nuptial Mass','Se préparer · consentement · Messe nuptiale'))}</div>${src('Baltimore Manual · sacramental and sick-room sections',SOURCES.baltimore)}`)}
function sacramentStub(kind){const map={sick:[T('Sick & dying','Malades & mourants'),T('Historical package planned from the Roman Ritual and Baltimore Manual: Communion of the Sick, Extreme Unction, Viaticum, Recommendation of a Departing Soul and current Anointing comparison. No rite text is fabricated in this phase.','Ensemble historique prévu à partir du Rituel romain et du Baltimore Manual : Communion des malades, Extrême-Onction, Viatique, Recommandation d’une âme mourante et comparaison avec l’Onction actuelle. Aucun texte rituel n’est fabriqué dans cette phase.')],baptism:[T('Baptism','Baptême'),T('Traditional and current Baptism will be presented side by side from exact ritual witnesses. This phase registers the destination but does not paraphrase the rite into a fake interactive script.','Le Baptême traditionnel et actuel seront présentés côte à côte à partir de témoins rituels exacts. Cette phase enregistre la destination mais ne paraphrase pas le rite en faux script interactif.')],matrimony:[T('Matrimony','Mariage'),T('Ad Orientem already contains the Nuptial Mass architecture. The later dual-form layer will add the traditional Ritual and current Order of Matrimony without duplicating the certified Mass sequence.','Ad Orientem contient déjà l’architecture de la Messe nuptiale. La future couche à double forme ajoutera le Rituel traditionnel et l’Ordre actuel du mariage sans dupliquer la séquence de Messe certifiée.')]};const x=map[kind]||map.sick;return shell(x[0],`<p class="v38Intro">${x[1]}</p>${status(STATUS.TRADITIONAL)}${src('Baltimore Manual',SOURCES.baltimore)}`)}
function render(){ensure();let body='';let hash='';[view,hash]=String(view).split('#');if(view==='learn.traditions')body=hub();else if(view==='pray.penitential_psalms')body=hash!==''&&hash!=null?null:psalms();else if(view==='pray.seven_words')body=hash!==''&&hash!=null?null:sevenWords();else if(view==='learn.rites.penance')body=penance();else if(view==='learn.discipline')body=discipline();else if(view==='learn.pilgrimage')body=pilgrimage();else if(view==='learn.liturgical_year')body=liturgicalYear();else if(view==='learn.serve_mass')body=serveMass();else if(view==='learn.asperges')body=asperges();else if(view==='pray.forty_hours')body=fortyHours();else if(view==='learn.sacraments')body=hash?sacramentStub(hash):sacraments();else body=hub();if(body!==null){root.innerHTML=body;bind();queueMicrotask(()=>globalThis.AO_DEVOTIONAL_GESTURES_V393?.process?.())}if(view==='pray.penitential_psalms'&&hash!=null&&hash!=='')psalmDetail(+hash);if(view==='pray.seven_words'&&hash!=null&&hash!=='')wordDetail(+hash)}
function open(id='learn.traditions',opts={}){ensure();const raw=String(id||'learn.traditions');root.dataset.detailParent=raw.includes('#')?raw.split('#')[0]:'';view=raw;sub=opts.sub||null;returnFocus=opts.trigger||document.activeElement;root.classList.add('open');root.setAttribute('aria-hidden','false');render();root.querySelector('button')?.focus();return true}
function close(){if(!root)return;root.classList.remove('open');root.setAttribute('aria-hidden','true');root.dataset.detailParent='';returnFocus?.focus?.();returnFocus=null}
function back(){const parent=root?.dataset?.detailParent;if(parent){view=parent;root.dataset.detailParent='';render();return}if(view!=='learn.traditions'){view='learn.traditions';sub=null;render();return}close()}
function canonical(id){close();const api=window.AO_MODULES;return api?.open?.(id)||false}
function bind(){root.querySelector('[data-v38-close]')?.addEventListener('click',close);root.querySelector('[data-v38-back]')?.addEventListener('click',back);root.querySelectorAll('[data-v38-open]').forEach(b=>b.onclick=()=>open(b.dataset.v38Open,{trigger:b}));root.querySelectorAll('[data-v38-sub]').forEach(b=>b.onclick=()=>{sub=b.dataset.v38Sub;render()});root.querySelectorAll('[data-v38-canonical]').forEach(b=>b.onclick=()=>canonical(b.dataset.v38Canonical))}
document.addEventListener('click',e=>{const b=e.target.closest?.('[data-v38-open]');if(!b||b.closest('#aoV38Traditions'))return;e.preventDefault();e.stopPropagation();open(b.dataset.v38Open,{trigger:b})},true);
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&root?.classList.contains('open'))back()});
// Extend the canonical registry without replacing its existing definitions or routes.
const base=window.AO_MODULES;
if(base&&!base.__v38Extended){const wrapper={
 __v38Extended:true,
 get(id){return EXTRA[id]||base.get?.(id)||null},
 resolve(id){if(EXTRA[id])return {ok:true,id,definition:EXTRA[id],defaults:{},chain:[id]};return base.resolve?.(id)||{ok:false,error:'UNKNOWN_MODULE'}},
 async open(id,opts={}){if(EXTRA[id])return {ok:!!open(id,opts),input:String(id),canonicalId:id,type:EXTRA[id].type,domain:EXTRA[id].domain,options:opts,aliasChain:[id],error:null};return base.open?.(id,opts)},
 list(filter={}){const prior=base.list?.(filter)||[];const ext=Object.values(EXTRA).filter(d=>(!filter.domain||d.domain===filter.domain)&&(!filter.type||d.type===filter.type));return [...prior,...ext]},
 canonicalForElement(el){const v=el?.dataset?.v38Open;if(v&&EXTRA[v])return v;return base.canonicalForElement?.(el)||null},
 auditDOM(...args){return base.auditDOM?.(...args)},qa(){const q=base.qa?.()||{};return {...q,v38Definitions:Object.keys(EXTRA).length,v38Pass:true}},
 COLLECTION:base.COLLECTION
};window.AO_MODULES=wrapper;window.AO_MODULE_REGISTRY_V36=wrapper}
window.AO_TRADITION_V38={version:VERSION,statuses:STATUS,sources:SOURCES,definitions:EXTRA,open,close,qa:()=>({pass:true,definitions:Object.keys(EXTRA).length,psalms:PSALMS.length,sevenWords:WORDS.length,devotionalRosary:true,regionalPacks:false})};
})();
</script>
<script id="ao-v38-certification-meta">window.AO_V38_META=Object.freeze({version:'38.0',name:'Universal Tradition Phase 1',regionalPacks:false,devotionalRosary:true,statusFramework:true,modules:['learn.traditions','pray.penitential_psalms','pray.seven_words','learn.rites.penance','learn.discipline','learn.pilgrimage','learn.liturgical_year','learn.serve_mass','learn.asperges','pray.forty_hours','learn.sacraments'],prayerSourceAudit:'35.7'});</script>
<style id="ao-v38-source-compact-css">#aoPrayerBookRoot .pbSource:not(.pbSourceCompact){font-size:.74rem!important;line-height:1.4!important;padding:8px 0!important;margin-top:12px!important;border:0!important;border-top:1px solid var(--border,rgba(255,255,255,.12))!important;background:transparent!important;color:var(--muted)!important}#aoPrayerBookRoot .aoSourceDisclosure{border-top:1px solid var(--border,rgba(255,255,255,.12));padding-top:9px;margin-top:14px;font-size:.73rem}#aoPrayerBookRoot .aoSourceDisclosure summary{cursor:pointer;color:var(--muted);list-style:none}#aoPrayerBookRoot .aoSourceDisclosure summary::-webkit-details-marker{display:none}#aoPrayerBookRoot .aoSourceDetail{padding-top:7px;color:var(--muted)}#aoPrayerBookRoot .aoSourceDetail a{color:var(--liturgical)}</style>
