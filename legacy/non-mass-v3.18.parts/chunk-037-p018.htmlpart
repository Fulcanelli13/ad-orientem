"];
const ROMAN=['I','II','III','IV','V','VI','VII','VIII','IX','X','XI','XII','XIII','XIV'];
const MODE_KEY='ao.stations-sacred-art.mode.v1';
const RESUME_KEY='ao.stations.session.v1';
const LANDING_INDEX=1; // Station II — Christ takes up His Cross.
let queued=false,wrapped=false,artToken=0;
const pb=()=>window.AOTraditionalPrayerBook;
const root=()=>document.getElementById('aoPrayerBookRoot');
const state=()=>pb()?.getState?.()||null;
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
function mode(){try{const v=localStorage.getItem(MODE_KEY);return ['on','subtle','off'].includes(v)?v:'on'}catch{return'on'}}
function setMode(v){v=['on','subtle','off'].includes(v)?v:'on';try{localStorage.setItem(MODE_KEY,v)}catch{}schedule();return v}
function saveResume(n){n=Math.trunc(Number(n)||0);try{if(n>=1&&n<=14)localStorage.setItem(RESUME_KEY,String(n));else localStorage.removeItem(RESUME_KEY)}catch{}}
function loadResume(){try{const n=Math.trunc(Number(localStorage.getItem(RESUME_KEY))||0);return n>=1&&n<=14?n:0}catch{return 0}}
function clearResume(){saveResume(0)}
function preload(index){if(index<0||index>=ART.length)return;try{const im=new Image();im.decoding='async';im.src=ART[index];if(im.decode)im.decode().catch(()=>{})}catch{}}
function cleanup(shell){if(!shell)return;shell.querySelectorAll('.aoV4311StationsArt').forEach(x=>x.remove())}
function makeFigure(index,title,landing=false){
 const fig=document.createElement('figure');fig.className='aoV4311StationsArt'+(landing?' aoV4311StationsLandingArt':'')+(mode()==='subtle'?' is-subtle':'');
 const stationNo=index+1,caption=landing?(document.documentElement.lang?.toLowerCase().startsWith('fr')?'Chemin de Croix':'Stations of the Cross'):`${ROMAN[index]} · ${title||''}`;
 const meditation=document.documentElement.lang?.toLowerCase().startsWith('fr')?'Méditation par l’art sacré':'Sacred art meditation';
 fig.innerHTML=`<img alt="${esc(landing?(document.documentElement.lang?.toLowerCase().startsWith('fr')?'Le Christ prend sa Croix':'Christ takes up His Cross'):(`Station ${stationNo} — ${title||''}`))}" src="${ART[index]}" decoding="async"><figcaption><span>${esc(caption)}</span><span>${meditation}</span></figcaption>`;
 const img=fig.querySelector('img'),token=++artToken;
 img.addEventListener('error',()=>{if(token===artToken)fig.remove()},{once:true});
 return fig;
}
function applyArt(){
 const r=root(),s=state();if(!r||s?.view!=='stations')return;
 const shell=r.querySelector('.pbShell[data-rc2-module="stations"]')||r.querySelector('.pbShell');if(!shell)return;
 cleanup(shell);if(mode()==='off')return;
 const n=Math.trunc(Number(s.station)||0);
 if(n===0){const hero=shell.querySelector('.lab-stations-hero');if(!hero)return;hero.prepend(makeFigure(LANDING_INDEX,'',true));preload(0);return}
 if(n<1||n>14)return;
 const idx=n-1,card=shell.querySelector('.lab-station-text');if(!card)return;
 const title=card.querySelector('h2')?.textContent?.trim()||'';
 card.insertAdjacentElement('beforebegin',makeFigure(idx,title,false));
 preload(idx+1);
}
function enhancePrefs(){
 const sheet=document.getElementById('rc2-module-sheet'),body=sheet?.querySelector('.rc2SheetBody');if(!body||!sheet.querySelector('[data-rc2-station-mode]')||body.querySelector('.aoV4311StationsArtPref'))return;
 const fr=(document.documentElement.lang||'').toLowerCase().startsWith('fr')||/Présentation du Chemin/.test(body.textContent||''),m=mode();
 const sec=document.createElement('section');sec.className='rc2PrefSection aoV4311StationsArtPref';
 sec.innerHTML=`<h3>${fr?'Art sacré':'Sacred art'}</h3><p>${fr?'Choisissez comment l’image de chaque Station accompagne la méditation.':'Choose how each Station image accompanies the meditation.'}</p><div class="rc2Segments three">${[['on',fr?'Activé':'On'],['subtle',fr?'Discret':'Subtle'],['off',fr?'Désactivé':'Off']].map(([v,l])=>`<button type="button" class="${m===v?'active':''}" data-v4311-station-art="${v}">${l}</button>`).join('')}</div>`;
 const first=body.querySelector('.rc2PrefSection');first?.insertAdjacentElement('afterend',sec)||body.prepend(sec);
}
function enhance(){queued=false;applyArt();enhancePrefs()}
function schedule(){if(queued)return;queued=true;requestAnimationFrame(enhance)}
function restoreSavedStation(){
 const target=loadResume();if(!target)return schedule();
 requestAnimationFrame(()=>{let guard=0;while(guard++<target){const s=state();if((Number(s?.station)||0)>=target)break;const b=root()?.querySelector('[data-pb-station-next]');if(!b)break;b.click()}schedule()});
}
function wrapPrayerBook(){
 if(wrapped||!pb()?.openModule)return false;wrapped=true;const api=pb(),orig=api.openModule.bind(api);
 api.openModule=(id,opts={})=>{const result=orig(id,opts);if(id==='stations')restoreSavedStation();return result};
 api.getStationsArtState=()=>({station:Number(state()?.station)||0,artMode:mode(),resume:loadResume()});
 return true;
}
document.addEventListener('click',e=>{
 const art=e.target.closest?.('[data-v4311-station-art]');if(art){e.preventDefault();e.stopPropagation();setMode(art.dataset.v4311StationArt);document.getElementById('rc2-module-sheet')?.remove();setTimeout(()=>{window.AO_RC2_MODULE_UX?.openPreferences?.('stations');setTimeout(enhancePrefs,0)},0);return}
 const next=e.target.closest?.('[data-pb-station-next]');if(next){const before=Number(state()?.station)||0;if(before>=14)clearResume();setTimeout(()=>{const after=Number(state()?.station)||0;if(before<14)saveResume(after);schedule()},0)}
 const prev=e.target.closest?.('[data-pb-station-prev]');if(prev)setTimeout(()=>{const after=Number(state()?.station)||0;saveResume(after);schedule()},0);
 if(e.target.closest?.('[data-pb-station-mode],[data-rc2-station-mode],[data-rc2-prefs="stations"]'))setTimeout(()=>{schedule();enhancePrefs()},0);
},true);
document.addEventListener('change',e=>{if(e.target.closest?.('[data-pb-stabat],[data-rc2-toggle="stationStabat"]'))setTimeout(schedule,0)},true);
function install(){wrapPrayerBook();schedule();if(!wrapped)setTimeout(install,60)}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',install,{once:true});else install();
window.addEventListener('pageshow',()=>{wrapPrayerBook();schedule()});
window.AO_STATIONS_ART_V4311=Object.freeze({
 version:VERSION,count:14,landingStation:2,source:'approved 2026-09-19 stained-glass XIV cycle',embedded:true,width:1086,height:1448,
 getMode:mode,setMode,resume:loadResume,clearResume,sync:schedule,
 inspect:()=>{const s=state(),r=root(),n=Number(s?.station)||0,figs=r?.querySelectorAll('.aoV4311StationsArt').length||0;return{version:VERSION,station:n,mode:mode(),resume:loadResume(),figures:figs,expectedFigure:(s?.view==='stations'&&mode()!=='off')?1:0,pass:ART.length===14&&(!s||s.view!=='stations'||mode()==='off'||figs===1)}}
});
try{if(!globalThis.AO_RELEASE_AUTHORITY_V4359)document.title='Ad Orientem 2.0 · v43.11 · Stations Sacred Art Integration';if(!globalThis.AO_RELEASE_AUTHORITY_V4359)document.documentElement.dataset.aoRelease='43.11'}catch{}
})();
</script>
<script id="ao-v4311-stations-sacred-art-meta">
window.AO_V4311_STATIONS_META=Object.freeze({version:'43.11',base:'v43.10-RULE-HERO-REUSE',lane:'stations-sacred-art',stationCount:14,landingHero:'Station II',delivery:'embedded full-dimension WebP + next-station decode prefetch',resume:true,failClosed:true,olderMixedStationsArtUsed:false});
</script>
<script id="ao-v4312-cinematic-loading-js">
(()=>{'use strict';
const VERSION='43.12-ZERO-OBSERVER-CINEMATIC-CERTIFICATION';
const q=(s,r=document)=>r.querySelector(s);
const bootEl=()=>q('#ao-cinema-boot');
const transitionEl=()=>q('#ao-cinema-transition');
const loaderEl=()=>q('#ao-cinema-loader');
const runtime=()=>globalThis.AO_RUNTIME_V8||null;
const state=()=>runtime()?.store?.getState?.()||null;
const fr=()=>state()?.language==='fr';
const L=(en,frText)=>fr()?frText:en;
const systemReduced=()=>!!globalThis.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches;
const reduced=()=>systemReduced()||!!state()?.settings?.reducedMotion;
const routeMeta={
 'enter-live':()=>({kicker:'AD ORIENTEM',title:L('Entering Mass','Entrée dans la Messe')}),
 'leave-live':()=>({kicker:'AD ORIENTEM',title:L('Returning home','Retour à l’accueil')}),
 'enter-prepare':()=>({kicker:L('BEFORE MASS','AVANT LA MESSE'),title:L('Preparation for Mass','Préparation à la Messe')}),
 'leave-prepare':()=>({kicker:'AD ORIENTEM',title:L('Returning home','Retour à l’accueil')}),
 'enter-thanksgiving':()=>({kicker:L('AFTER MASS','APRÈS LA MESSE'),title:L('Thanksgiving','Action de grâce')}),
 'finish-live':()=>({kicker:L('AFTER MASS','APRÈS LA MESSE'),title:L('Thanksgiving','Action de grâce')}),
 'leave-thanksgiving':()=>({kicker:'AD ORIENTEM',title:L('Returning home','Retour à l’accueil')}),
 'scripture-open':()=>({kicker:L('SACRED SCRIPTURE','SAINTE ÉCRITURE'),title:L('Opening the reading','Ouverture de la lecture')}),
 'scripture-close':()=>({kicker:'AD ORIENTEM',title:L('Returning','Retour')})
};
let transitionTimer=0,loaderTimer=0,loaderHideTimer=0,bootFinished=false,storeInstalled=false,lastLoadingKey='';
function sceneIn(){const app=q('#app');if(!app||reduced())return;app.classList.remove('aoCinemaSceneEnter');void app.offsetWidth;app.classList.add('aoCinemaSceneEnter');setTimeout(()=>app.classList.remove('aoCinemaSceneEnter'),620)}
function showTransition(meta){
 const el=transitionEl();if(!el||reduced()||bootEl()?.classList.contains('aoCinemaBootDone')===false)return;
 clearTimeout(transitionTimer);q('[data-ao-cinema-transition-kicker]',el).textContent=meta.kicker||'AD ORIENTEM';q('[data-ao-cinema-transition-title]',el).textContent=meta.title||'';el.classList.remove('aoCinemaTransitionOut');el.classList.add('aoCinemaTransitionOn');el.setAttribute('aria-hidden','false');
 requestAnimationFrame(()=>requestAnimationFrame(sceneIn));
 transitionTimer=setTimeout(()=>{el.classList.remove('aoCinemaTransitionOn');el.classList.add('aoCinemaTransitionOut');transitionTimer=setTimeout(()=>{el.classList.remove('aoCinemaTransitionOut');el.setAttribute('aria-hidden','true')},520)},Math.max(260,meta.hold||360));
}
function contentLoadingSpec(s){if(!s)return null;if(s.resolving){const ribbon=globalThis.AO_GLOBAL_RIBBON_V4323?.getActive?.();const panel=globalThis.AO_NAV_V25?.getState?.()?.panel;const calendarForeground=ribbon==='calendar'||panel==='calendar';if(calendarForeground)return {key:'calendar',title:L('Resolving the 1962 calendar','Résolution du calendrier de 1962'),sub:L('Selecting the proper Mass and liturgical colour','Sélection de la Messe et de la couleur liturgique')}}if(s.scripture?.loading)return {key:'scripture',title:L('Opening Sacred Scripture','Ouverture de la Sainte Écriture'),sub:L('Loading the appointed reading and commentary','Chargement de la lecture et du commentaire')};return null}
function hideLoader(){clearTimeout(loaderTimer);lastLoadingKey='';const el=loaderEl();if(!el)return;clearTimeout(loaderHideTimer);el.classList.remove('aoCinemaLoaderOn');el.removeAttribute('data-kind');el.setAttribute('aria-hidden','true')}
function scheduleLoader(spec){
 if(!spec){hideLoader();return}if(bootEl()&&!bootEl().classList.contains('aoCinemaBootDone'))return;if(lastLoadingKey===spec.key&&loaderEl()?.classList.contains('aoCinemaLoaderOn'))return;lastLoadingKey=spec.key;clearTimeout(loaderTimer);loaderTimer=setTimeout(()=>{const current=contentLoadingSpec(state());if(!current||current.key!==spec.key)return;const el=loaderEl();if(!el)return;q('[data-ao-cinema-loader-title]',el).textContent=current.title;q('[data-ao-cinema-loader-sub]',el).textContent=current.sub;el.dataset.kind=current.key;el.classList.add('aoCinemaLoaderOn');el.setAttribute('aria-hidden','false')},220)}
function syncLoading(s=state()){const spec=contentLoadingSpec(s);if(spec)scheduleLoader(spec);else hideLoader()}
function installStore(){
 const store=runtime()?.store;if(!store?.dispatch||!store?.subscribe||storeInstalled)return !!storeInstalled;storeInstalled=true;
 const original=store.dispatch.bind(store);store.dispatch=(action)=>{const type=action?.type,make=routeMeta[type];if(make)showTransition(make());const result=original(action);syncLoading(store.getState());queuePresentationScan();return result};
 store.subscribe(s=>{document.documentElement.dataset.aoCinemaRoute=s?.route||'';document.documentElement.dataset.reducedMotion=String(!!s?.settings?.reducedMotion);syncLoading(s);queuePresentationScan()});syncLoading(store.getState());queuePresentationScan();return true
}
function finishBoot(reason='ready'){
 if(bootFinished)return;bootFinished=true;const el=bootEl();if(!el)return;const s=state(),status=q('[data-ao-cinema-boot-status]',el),title=s?.resolution?.proper?.data?.name||s?.resolution?.day?.main?.title||'';if(status){status.textContent=title?L(`${title} · Ready`,`${title} · Prêt`):L('Ready','Prêt');status.classList.add('ready')}
 const delay=reduced()?0:260;setTimeout(()=>{el.classList.add('aoCinemaBootDone');el.dataset.reason=reason;setTimeout(()=>{el.remove();syncLoading(state())},reduced()?0:720)},delay)
}
function homeCriticalReady(){
 const s=state(),home=q('.homeScreen');if(!(s&&home&&!s.resolving&&s.resolution))return false;
 const coming=home.querySelector('#aoComingUpCardV4323'),formation=home.querySelector('.aoDailyCateHome');
 if(!coming||!formation)return false;
 if(coming.getAttribute('aria-busy')==='true'||formation.getAttribute('aria-busy')==='true')return false;
 if(coming.classList.contains('aoHomeStablePlaceholder')||formation.classList.contains('aoHomeStablePlaceholder'))return false;
 const saintApi=globalThis.AO_SAINT_ART;if(saintApi&&!saintApi.lastManifest)return false;
 const saintCard=home.querySelector('.aoSaintArtCard');if(saintCard&&!saintCard.dataset.result)return false;
 return !document.fonts||document.fonts.status==='loaded';
}
function homeLayoutSignature(){
 const home=q('.homeScreen');if(!home)return'';
 return ['.celebrationBlock','.aroundMass','.gospelCard','#aoComingUpCardV4323','.aoDailyCateHome'].map(sel=>{const el=home.querySelector(sel);if(!el)return`${sel}:missing`;const r=el.getBoundingClientRect();return`${sel}:${Math.round(r.top)}:${Math.round(r.height)}`}).join('|');
}
function bootWatch(){
 const started=performance.now();let stable=0,lastSig='';
 const tick=()=>{installStore();const ready=homeCriticalReady(),sig=ready?homeLayoutSignature():'';if(ready&&sig&&sig===lastSig)stable++;else stable=0;lastSig=sig;if(stable>=12){finishBoot('home-stable');return}if(performance.now()-started>7000){finishBoot('guard-timeout');return}requestAnimationFrame(tick)};requestAnimationFrame(tick)
}
const ART_SELECTORS=['.aoProperArt img','.aoRuleModuleHero img','.aoV401RosaryHero img','.aoSaintArtCard img','.aoSaintReaderMedia img','[data-ao-proper-art] img','.aoV4311StationsArt img'];
function artCandidate(img){return img instanceof HTMLImageElement&&ART_SELECTORS.some(sel=>img.matches(sel))}
function prepArt(img){if(!artCandidate(img)||img.dataset.aoCinemaImage==='1')return;img.dataset.aoCinemaImage='1';const host=img.parentElement;if(host)host.classList.add('aoCinemaArt');const ready=()=>{img.classList.remove('aoCinemaImagePending','aoCinemaImageError');img.classList.add('aoCinemaImageReady');host?.classList.remove('aoCinemaArt')};const fail=()=>{img.classList.remove('aoCinemaImagePending');img.classList.add('aoCinemaImageError');host?.classList.remove('aoCinemaArt')};if(img.complete&&img.naturalWidth>0){if(reduced()){ready();return}img.classList.add('aoCinemaImagePending');requestAnimationFrame(()=>requestAnimationFrame(ready));return}img.classList.add('aoCinemaImagePending');img.addEventListener('load',ready,{once:true});img.addEventListener('error',fail,{once:true})}
function scanArt(root=document){if(root instanceof HTMLImageElement)prepArt(root);root.querySelectorAll?.(ART_SELECTORS.join(',')).forEach(prepArt)}
function surfaceCandidate(el){if(!(el instanceof HTMLElement)||el.dataset.aoCinemaSurface==='1')return false;return el.matches('.homeSheetBackdrop,.rc2SheetBackdrop,.flowGuideOverlay,#aoPrayerBookRoot,.aoSaintReaderBackdrop,.aoAuditBackdrop')||!!el.querySelector?.('.homeSheet,.rc2Sheet')}
function prepSurface(el){if(!surfaceCandidate(el))return;el.dataset.aoCinemaSurface='1';if(!reduced()){el.classList.add('aoCinemaSurfaceIn');setTimeout(()=>el.classList.remove('aoCinemaSurfaceIn'),520)}}
const SURFACE_SELECTOR='.homeSheetBackdrop,.rc2SheetBackdrop,.flowGuideOverlay,#aoPrayerBookRoot,.aoSaintReaderBackdrop,.aoAuditBackdrop';
let presentationScanQueued=false,presentationScanTimer=0;
function scanPresentation(root=document){scanArt(root);if(root instanceof HTMLElement)prepSurface(root);root.querySelectorAll?.(SURFACE_SELECTOR).forEach(prepSurface)}
function queuePresentationScan(){
 if(!presentationScanQueued){presentationScanQueued=true;requestAnimationFrame(()=>{presentationScanQueued=false;scanPresentation()})}
 clearTimeout(presentationScanTimer);presentationScanTimer=setTimeout(scanPresentation,180)
}
function installPresentationHooks(){
 scanPresentation();
 document.addEventListener('click',()=>queuePresentationScan(),true);
 document.addEventListener('change',()=>queuePresentationScan(),true);
 document.addEventListener('submit',()=>queuePresentationScan(),true)
}
function init(){
 document.documentElement.dataset.aoCinematic=VERSION;installPresentationHooks();bootWatch();installStore();
 const api=Object.freeze({version:VERSION,showTransition,finishBoot,scanArt,scanPresentation,queuePresentationScan,isReducedMotion:reduced,observerFree:true});globalThis.AO_CINEMATIC_V4312=api;globalThis.AO_CINEMATIC_V4311=api
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});else init();
})();
</script>

<script id="ao-v4312-harmonized-certification-meta">
(()=>{'use strict';const V='43.12',T='Ad Orientem 2.0 · v43.12 · Harmonized Mass Certification';
 const observerCount=()=>[...document.scripts].reduce((n,s)=>n+(s.textContent.match(/new\s+MutationObserver\s*\(/g)||[]).length,0);
 const inspect=()=>{const checks={zeroObservers:observerCount()===0,cueEngine:globalThis.AO_V439_GESTURE_CERT?.cueEngine==='25.5',printedCrossDedupe:globalThis.AO_V439_GESTURE_CERT?.printedCrossIconDedupe===true,cinematicObserverFree:globalThis.AO_CINEMATIC_V4312?.observerFree===true,stationsArt:!!globalThis.AO_STATIONS_ART_V4311,rosaryHero:globalThis.AO_V4311_RULE_HERO_CERT?.rosaryHeroSource==='labora-madonna-child',sacredArtGate:!!globalThis.AO_SACRED_ART_AESTHETIC_V4310};return{version:V,pass:Object.values(checks).every(Boolean),checks}};
 window.AO_V4312_META=Object.freeze({version:V,title:T,lane:'harmonized-mass-certification',massStudyBase:'v43.9',ruleHeroBase:'v43.11-rule-rosary-madonna',stationsArt:'v43.11',sacredArtGate:'v43.10',cinematic:'v43.12-observer-free',cueEngine:'25.5',observerFree:true,inspect});if(!globalThis.AO_RELEASE_AUTHORITY_V4359)document.title=T;if(!globalThis.AO_RELEASE_AUTHORITY_V4359)document.documentElement.dataset.aoRelease=V;
})();
</script>
<script id="ao-v4313-mass-guidance-registry-js">
(()=>{
'use strict';
const DATA={"schema":"ao.mass-guidance.registry","version":"43.13","base":"43.12","purpose":"Canonical lay-facing Mass guidance data layer for rubrics, gestures, posture profiles, guide sheets and audit.","principles":{"actor_authority_separate":true,"no_universal_lay_posture_claim":true,"private_priest_text_no_cue_spam":true,"exact_anchor_gestures":true,"full_cross_distinct_from_gospel_crosses":true,"source_types_distinct":["LAW","CEREMONY","CUSTOM","DEVOTION","HISTORY","THEOLOGY","SYMBOLISM"]},"authority":{"RUBRIC_1962":"RUBRIC_1962","GOVERNING_1958":"GOVERNING_1958","CHOIR_NORM":"CHOIR_NORM","CEREMONIAL_ANALOGY":"CEREMONIAL_ANALOGY","ESTABLISHED_LAY_CUSTOM":"ESTABLISHED_LAY_CUSTOM","LOCAL_CUSTOM":"LOCAL_CUSTOM","OPTIONAL_DEVOTION":"OPTIONAL_DEVOTION","OLDER_CUSTOM_NON_NORMATIVE_1962":"OLDER_CUSTOM_NON_NORMATIVE_1962","HISTORICAL":"HISTORICAL","SUPPRESSED":"SUPPRESSED"},"authority_labels":{"RUBRIC_1962":{"en":"1962 rubric","fr":"Rubrique de 1962"},"GOVERNING_1958":{"en":"Governing 1958 legislation","fr":"Législation normative de 1958"},"CHOIR_NORM":{"en":"Choir norm","fr":"Norme du chœur"},"CEREMONIAL_ANALOGY":{"en":"Traditional ceremonial analogy","fr":"Analogie cérémonielle traditionnelle"},"ESTABLISHED_LAY_CUSTOM":{"en":"Established traditional practice","fr":"Usage traditionnel établi"},"LOCAL_CUSTOM":{"en":"Local custom","fr":"Usage local"},"OPTIONAL_DEVOTION":{"en":"Optional devotion","fr":"Dévotion facultative"},"OLDER_CUSTOM_NON_NORMATIVE_1962":{"en":"Older custom — non-normative in the 1962 books","fr":"Usage ancien — non normatif dans les livres de 1962"},"HISTORICAL":{"en":"Historical note","fr":"Note historique"},"SUPPRESSED":{"en":"Suppressed in this context","fr":"Supprimé dans ce contexte"}},"source_registry":{"MR1962_RITUS":{"title":"Missale Romanum (1962) — Ritus servandus in celebratione Missae","type":"primary_rubric"},"MR1962_RG":{"title":"Missale Romanum (1962) — Rubricae generales Missalis Romani","type":"primary_rubric"},"DMS1958":{"title":"Sacra Congregatio Rituum — De musica sacra et sacra liturgia (1958)","type":"primary_legislation"},"OCONNELL":{"title":"J. B. O’Connell — The Celebration of Mass, revised for the 1960/62 books","type":"ceremonial_manual"},"FORTESCUE_OCONNELL1962":{"title":"Fortescue–O’Connell — The Ceremonies of the Roman Rite Described, 12th ed. (1962)","type":"ceremonial_manual"},"FORTESCUE_MASS":{"title":"Adrian Fortescue — The Mass: A Study of the Roman Liturgy","type":"historical"},"GUERANGER":{"title":"Dom Prosper Guéranger — Explanation of the Holy Mass","type":"traditional_spiritual_commentary"},"ALPHONSUS_GRIMM":{"title":"St Alphonsus / Grimm — The Holy Mass","type":"traditional_ascetical"},"GIHR":{"title":"Nikolaus Gihr — The Holy Sacrifice of the Mass","type":"traditional_theological"},"COCHEM":{"title":"Martin von Cochem — Explanation of the Holy Sacrifice of the Mass","type":"traditional_devotional"},"MULLER":{"title":"Michael Müller — The Holy Mass","type":"traditional_devotional"},"GAUME":{"title":"J.-J. Gaume — The Sign of the Cross","type":"traditional_devotional"},"WAPELHORST":{"title":"Wapelhorst — Compendium Sacrae Liturgiae","type":"traditional_ceremonial"},"HOLYWEEK1955_1962":{"title":"Restored Holy Week received by the 1962 Missal","type":"primary_rubric"}},"action_types":["SIGN_OF_CROSS","GOSPEL_CROSSES_3","BREAST_STRIKE_1","BREAST_STRIKE_3","HEAD_BOW","PROFOUND_BOW","GENUFLECT","KNEEL","RISE","STAND","SIT","ADORATION","RITUAL_ACTION"],"guide_library":{"SIGN_OF_CROSS":{"action_en":"Make the full Sign of the Cross with the right hand: forehead, breast, left shoulder, right shoulder.","action_fr":"Faire le grand signe de croix avec la main droite : front, poitrine, épaule gauche, épaule droite.","why_en":"This traditional lay gesture accompanies specific invocations or conclusions; it is not a cue to imitate every Sign of the Cross made by the priest.","why_fr":"Ce geste traditionnel accompagne certaines invocations ou conclusions ; il ne demande pas d’imiter chaque signe de croix du prêtre."},"GOSPEL_CROSSES_3":{"action_en":"With the right thumb, trace a small cross on the forehead, then the lips, then the breast.","action_fr":"Avec le pouce droit, tracer une petite croix sur le front, puis les lèvres, puis la poitrine.","why_en":"The three Gospel crosses are a distinct traditional gesture associated with receiving the Gospel in mind, speech and heart.","why_fr":"Les trois petites croix de l’Évangile sont un geste traditionnel distinct, associé à l’accueil de l’Évangile dans l’intelligence, la parole et le cœur."},"BREAST_STRIKE_1":{"action_en":"Strike the breast once at the indicated words.","action_fr":"Frapper la poitrine une fois aux paroles indiquées.","why_en":"A traditional penitential gesture of humility and acknowledged unworthiness.","why_fr":"Geste pénitentiel traditionnel d’humilité et d’indignité reconnue."},"BREAST_STRIKE_3":{"action_en":"Strike the breast three times with the repeated text.","action_fr":"Frapper la poitrine trois fois avec le texte répété.","why_en":"The repeated breast-striking accompanies the threefold penitential invocation or profession of unworthiness.","why_fr":"Les trois coups accompagnent la triple invocation pénitentielle ou profession d’indignité."},"HEAD_BOW":{"action_en":"Briefly incline the head at the indicated words.","action_fr":"Incliner brièvement la tête aux paroles indiquées.","why_en":"A restrained traditional act of reverence toward the sacred name or phrase.","why_fr":"Acte traditionnel et mesuré de révérence envers le nom ou la formule sacrée."},"PROFOUND_BOW":{"action_en":"Incline the upper body noticeably from the waist.","action_fr":"Incliner nettement le haut du corps à partir de la taille.","why_en":"A deeper bodily reverence, distinct from a simple head bow.","why_fr":"Révérence corporelle plus profonde, distincte d’une simple inclination de tête."},"GENUFLECT":{"action_en":"Place the right knee briefly on the ground, then rise unless the next cue says otherwise.","action_fr":"Poser brièvement le genou droit à terre, puis se relever sauf indication contraire.","why_en":"A concentrated bodily act of reverence or adoration.","why_fr":"Acte corporel concentré de révérence ou d’adoration."},"KNEEL":{"action_en":"Kneel and remain kneeling until the posture changes.","action_fr":"Se mettre à genoux et y rester jusqu’au changement de posture.","why_en":"Kneeling expresses adoration, humility, penitence or supplication according to context.","why_fr":"La posture à genoux exprime l’adoration, l’humilité, la pénitence ou la supplication selon le contexte."},"RISE":{"action_en":"Rise to a standing position.","action_fr":"Se relever et se tenir debout.","why_en":"This cue marks the end of the preceding kneeling or genuflection.","why_fr":"Cette indication marque la fin de la posture à genoux ou de la génuflexion précédente."},"STAND":{"action_en":"Stand attentively.","action_fr":"Se tenir debout avec attention.","why_en":"Standing is the traditional posture of attention, honour and readiness.","why_fr":"La station debout est la posture traditionnelle d’attention, d’honneur et de disponibilité."},"SIT":{"action_en":"Sit attentively.","action_fr":"S’asseoir avec attention.","why_en":"Sitting ordinarily accompanies listening or extended sung/textual sections.","why_fr":"La position assise accompagne ordinairement l’écoute ou les sections chantées ou textuelles prolongées."},"ADORATION":{"action_en":"Remain recollected in adoration.","action_fr":"Rester recueilli dans l’adoration.","why_en":"No additional invented bodily cue is required beyond the posture appropriate to the moment.","why_fr":"Aucun geste corporel inventé supplémentaire n’est requis au-delà de la posture propre au moment."},"RITUAL_ACTION":{"action_en":"Follow the indicated special-day ritual action.","action_fr":"Suivre l’action rituelle propre au jour indiquée.","why_en":"Special-day ceremonies use their own explicit sequence rather than the ordinary-Mass posture profile.","why_fr":"Les cérémonies propres à certains jours suivent leur séquence explicite plutôt que le profil ordinaire de la Messe."}},"posture_groups":{"entrance":{"default":"STAND","authority":"ESTABLISHED_LAY_CUSTOM"},"asperges":{"default":"STAND","authority":"ESTABLISHED_LAY_CUSTOM"},"foot-prayers":{"low":"KNEEL","sung":"KNEEL","authority":"ESTABLISHED_LAY_CUSTOM"},"introit-kyrie":{"low":"KNEEL","sung":"FOLLOW_LOCAL_CUSTOM","authority":"LOCAL_CUSTOM"},"gloria":{"low":"FOLLOW_LOCAL_CUSTOM","sung":"STAND","sung_long_setting":"FOLLOW_LOCAL_CUSTOM","authority":"LOCAL_CUSTOM"},"collect":{"low":"FOLLOW_LOCAL_CUSTOM","sung":"STAND","authority":"CHOIR_NORM"},"readings":{"low":"FOLLOW_LOCAL_CUSTOM","sung":"SIT","authority":"CEREMONIAL_ANALOGY"},"gospel":{"low":"STAND","sung":"STAND","authority":"ESTABLISHED_LAY_CUSTOM"},"homily":{"default":"SIT","authority":"ESTABLISHED_LAY_CUSTOM"},"credo":{"low":"FOLLOW_LOCAL_CUSTOM","sung":"STAND","authority":"LOCAL_CUSTOM"},"offertory":{"low":"FOLLOW_LOCAL_CUSTOM","sung":"SIT","authority":"CEREMONIAL_ANALOGY"},"preface":{"low":"FOLLOW_LOCAL_CUSTOM","sung":"STAND","authority":"LOCAL_CUSTOM"},"sanctus":{"default":"FOLLOW_LOCAL_CUSTOM","authority":"LOCAL_CUSTOM"},"canon":{"default":"KNEEL","authority":"ESTABLISHED_LAY_CUSTOM"},"pater":{"default":"FOLLOW_LOCAL_CUSTOM","authority":"LOCAL_CUSTOM"},"communion-prep":{"default":"FOLLOW_LOCAL_CUSTOM","common_traditional":"KNEEL","authority":"LOCAL_CUSTOM"},"communion-reception":{"default":"KNEEL","authority":"ESTABLISHED_LAY_CUSTOM"},"after-communion":{"default":"FOLLOW_LOCAL_CUSTOM","authority":"LOCAL_CUSTOM"},"postcommunion":{"low":"FOLLOW_LOCAL_CUSTOM","sung":"STAND","authority":"LOCAL_CUSTOM"},"dismissal":{"default":"STAND","authority":"ESTABLISHED_LAY_CUSTOM"},"blessing":{"default":"KNEEL","authority":"ESTABLISHED_LAY_CUSTOM"},"last-gospel":{"default":"STAND","authority":"ESTABLISHED_LAY_CUSTOM"},"recessional":{"default":"STAND","authority":"ESTABLISHED_LAY_CUSTOM"}},"step_to_posture_group":{"sign-cross":"foot-prayers","judica":"foot-prayers","adjutorium":"foot-prayers","priest-confiteor":"foot-prayers","ministers-confiteor":"foot-prayers","indulgentiam-absolution":"foot-prayers","ascend":"foot-prayers","oramus-te":"foot-prayers","introit":"introit-kyrie","kyrie":"introit-kyrie","gloria":"gloria","collect":"collect","epistle":"readings","gradual":"readings","alleluia":"readings","tract":"readings","sequence":"readings","gospel-prep":"readings","gospel-prep-requiem":"readings","homily":"homily","gospel-announcement":"gospel","gospel":"gospel","credo":"credo","offertory":"offertory","offer-host":"offertory","water-wine":"offertory","offer-chalice":"offertory","in-spiritu":"offertory","veni-sanctificator":"offertory","incense-off":"offertory","lavabo":"offertory","suscipe-trinitas":"offertory","orate-fratres":"offertory","secret":"offertory","preface":"preface","sanctus":"sanctus","benedictus":"sanctus","te-igitur":"canon","memento-living":"canon","communicantes":"canon","hanc":"canon","quam-oblationem":"canon","consecration-host":"canon","consecration-chalice":"canon","unde-et-memores":"canon","supra-quae":"canon","supplices":"canon","memento-dead":"canon","nobis-quoque":"canon","canon-doxology":"canon","pater":"pater","libera-nos":"pater","fraction-pax":"pater","commingling":"pater","agnus":"communion-prep","peace-prayer":"communion-prep","communion-prep-fili":"communion-prep","communion-prep-perceptio":"communion-prep","priest-communion":"communion-prep","second-confiteor":"communion-prep","ecce":"communion-prep","domine-non-sum-dignus":"communion-prep","communion-faithful":"communion-reception","ablutions":"after-communion","communion-proper":"after-communion","postcommunion":"postcommunion","dismissal":"dismissal","placeat":"dismissal","blessing":"blessing","last-gospel-announcement":"last-gospel","last-gospel":"last-gospel"},"fixed_gestures":[{"id":"sign-cross:1:sign_of_cross","step":"sign-cross","actor":"FAITHFUL","underlying_actor":null,"action"