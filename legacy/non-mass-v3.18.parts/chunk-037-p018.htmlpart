 shoulder.","action_fr":"Faire le grand signe de croix avec la main droite : front, poitrine, épaule gauche, épaule droite.","why_en":"This traditional lay gesture accompanies specific invocations or conclusions; it is not a cue to imitate every Sign of the Cross made by the priest.","why_fr":"Ce geste traditionnel accompagne certaines invocations ou conclusions ; il ne demande pas d’imiter chaque signe de croix du prêtre.","status_en":"Established traditional practice","status_fr":"Usage traditionnel établi","sources":["OCONNELL","GUERANGER"]},"raw":{"kind":"cross","label":"Sign of the cross","authority":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["GUERANGER","COCHEM","MULLER"]}},{"id":"gospel-announcement:1:gospel_crosses_3","step":"gospel-announcement","actor":"FAITHFUL","underlying_actor":null,"action":"GOSPEL_CROSSES_3","anchor_lat":"Sequéntia ✠ sancti Evangélii","anchor_en":"Continuation ✠ of the Holy Gospel","anchor_fr":"Sequéntia ✠ sancti Evangélii","anchor_placement":"before","authority":"ESTABLISHED_LAY_CUSTOM","lay_status":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["OCONNELL"],"conditions":{},"suppressions":[],"mass_forms":["LOW","SUNG","SOLEMN"],"season":"ANY","requiem":"CONTEXTUAL","special_day":"ANY","posture_before":null,"posture_after":null,"icon_semantic":"GOSPEL_CROSSES_3","printed_cross_icon_dedupe":false,"count":null,"prominence":"CORE","compatibility_only":false,"guide":{"action_en":"With the right thumb, trace a small cross on the forehead, then the lips, then the breast.","action_fr":"Avec le pouce droit, tracer une petite croix sur le front, puis les lèvres, puis la poitrine.","why_en":"The three Gospel crosses are a distinct traditional gesture associated with receiving the Gospel in mind, speech and heart.","why_fr":"Les trois petites croix de l’Évangile sont un geste traditionnel distinct, associé à l’accueil de l’Évangile dans l’intelligence, la parole et le cœur.","status_en":"Established traditional practice","status_fr":"Usage traditionnel établi","sources":["OCONNELL"]},"raw":{"kind":"cross","label":"Forehead · lips · breast","authority":"PERIOD_1962_GUIDE","sourceRefs":["OCONNELL_1962","GUERANGER","COCHEM","MULLER"],"gestureForm":"SIGN_CROSS_GOSPEL"}},{"id":"credo:1:head_bow","step":"credo","actor":"FAITHFUL","underlying_actor":null,"action":"HEAD_BOW","anchor_lat":"Credo in unum Deum","anchor_en":"I believe in one God","anchor_fr":"JE CROIS en un seul Dieu","anchor_placement":"before","authority":"ESTABLISHED_LAY_CUSTOM","lay_status":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["OCONNELL"],"conditions":{},"suppressions":[],"mass_forms":["LOW","SUNG","SOLEMN"],"season":"ANY","requiem":"CONTEXTUAL","special_day":"ANY","posture_before":null,"posture_after":null,"icon_semantic":"HEAD_BOW","printed_cross_icon_dedupe":false,"count":null,"prominence":"DETAIL","compatibility_only":false,"guide":{"action_en":"Briefly incline the head at the indicated words.","action_fr":"Incliner brièvement la tête aux paroles indiquées.","why_en":"A restrained traditional act of reverence toward the sacred name or phrase.","why_fr":"Acte traditionnel et mesuré de révérence envers le nom ou la formule sacrée.","status_en":"Established traditional practice","status_fr":"Usage traditionnel établi","sources":["OCONNELL"]},"raw":{"kind":"bow","label":"Bow head","authority":"traditional_faithful_custom","sourceRefs":["OCONNELL_1962"]}},{"id":"credo:2:genuflect","step":"credo","actor":"FAITHFUL","underlying_actor":null,"action":"GENUFLECT","anchor_lat":"Et incarnátus est","anchor_en":"And was incarnate","anchor_fr":"Et il a pris chair de la Vierge Marie","anchor_placement":"before","authority":"ESTABLISHED_LAY_CUSTOM","lay_status":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["OCONNELL"],"conditions":{},"suppressions":[],"mass_forms":["LOW","SUNG","SOLEMN"],"season":"ANY","requiem":"CONTEXTUAL","special_day":"ANY","posture_before":null,"posture_after":null,"icon_semantic":"GENUFLECT","printed_cross_icon_dedupe":false,"count":null,"prominence":"CORE","compatibility_only":false,"guide":{"action_en":"Place the right knee briefly on the ground, then rise unless the next cue says otherwise.","action_fr":"Poser brièvement le genou droit à terre, puis se relever sauf indication contraire.","why_en":"A concentrated bodily act of reverence or adoration.","why_fr":"Acte corporel concentré de révérence ou d’adoration.","status_en":"Established traditional practice","status_fr":"Usage traditionnel établi","sources":["OCONNELL"]},"raw":{"kind":"genuflect","label":"Traditional/local genuflection","authority":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["OCONNELL_1962","GUERANGER"],"specialRule":"CHRISTMAS_ANNUNCIATION_SUNG_KNEEL"},"conditional_variants":[{"when":{"form":"SUNG","celebration_group":["CHRISTMAS","ANNUNCIATION"]},"action":"KNEEL","authority":"RUBRIC_1962","sourceRefs":["MR1962_RG","OCONNELL"]}]},{"id":"credo:3:rise","step":"credo","actor":"FAITHFUL","underlying_actor":null,"action":"RISE","anchor_lat":"et homo factus est.","anchor_en":"and was made man.","anchor_fr":"et s’est fait homme","anchor_placement":"after","authority":"ESTABLISHED_LAY_CUSTOM","lay_status":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["OCONNELL"],"conditions":{},"suppressions":[],"mass_forms":["LOW","SUNG","SOLEMN"],"season":"ANY","requiem":"CONTEXTUAL","special_day":"ANY","posture_before":null,"posture_after":null,"icon_semantic":"RISE","printed_cross_icon_dedupe":false,"count":null,"prominence":"CORE","compatibility_only":false,"guide":{"action_en":"Rise to a standing position.","action_fr":"Se relever et se tenir debout.","why_en":"This cue marks the end of the preceding kneeling or genuflection.","why_fr":"Cette indication marque la fin de la posture à genoux ou de la génuflexion précédente.","status_en":"Established traditional practice","status_fr":"Usage traditionnel établi","sources":["OCONNELL"]},"raw":{"kind":"rise","label":"Rise","authority":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["OCONNELL_1962","GUERANGER"],"specialRule":"CHRISTMAS_ANNUNCIATION_SUNG_KNEEL"}},{"id":"credo:4:head_bow","step":"credo","actor":"FAITHFUL","underlying_actor":null,"action":"HEAD_BOW","anchor_lat":"Qui cum Patre et Fílio simul adorátur","anchor_en":"Who together with the Father and the Son is adored","anchor_fr":"il reçoit même adoration et même gloire","anchor_placement":"before","authority":"ESTABLISHED_LAY_CUSTOM","lay_status":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["OCONNELL"],"conditions":{},"suppressions":[],"mass_forms":["LOW","SUNG","SOLEMN"],"season":"ANY","requiem":"CONTEXTUAL","special_day":"ANY","posture_before":null,"posture_after":null,"icon_semantic":"HEAD_BOW","printed_cross_icon_dedupe":false,"count":null,"prominence":"DETAIL","compatibility_only":false,"guide":{"action_en":"Briefly incline the head at the indicated words.","action_fr":"Incliner brièvement la tête aux paroles indiquées.","why_en":"A restrained traditional act of reverence toward the sacred name or phrase.","why_fr":"Acte traditionnel et mesuré de révérence envers le nom ou la formule sacrée.","status_en":"Established traditional practice","status_fr":"Usage traditionnel établi","sources":["OCONNELL"]},"raw":{"kind":"bow","label":"Bow head","authority":"traditional_faithful_custom","sourceRefs":["OCONNELL_1962"]}},{"id":"credo:5:sign_of_cross","step":"credo","actor":"FAITHFUL","underlying_actor":null,"action":"SIGN_OF_CROSS","anchor_lat":"Et vitam ✠ ventúri sæculi","anchor_en":"the life ✠ of the world to come","anchor_fr":"la vie ✠ du monde à venir","anchor_placement":"before","authority":"ESTABLISHED_LAY_CUSTOM","lay_status":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["OCONNELL","GUERANGER"],"conditions":{},"suppressions":[],"mass_forms":["LOW","SUNG","SOLEMN"],"season":"ANY","requiem":"CONTEXTUAL","special_day":"ANY","posture_before":null,"posture_after":null,"icon_semantic":"SIGN_OF_CROSS","printed_cross_icon_dedupe":true,"count":null,"prominence":"CORE","compatibility_only":false,"guide":{"action_en":"Make the full Sign of the Cross with the