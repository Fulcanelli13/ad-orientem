_semantic":"BREAST_STRIKE_1","printed_cross_icon_dedupe":false,"count":1,"prominence":"CORE","compatibility_only":false,"guide":{"action_en":"Strike the breast once at the indicated words.","action_fr":"Frapper la poitrine une fois aux paroles indiquées.","why_en":"A traditional penitential gesture of humility and acknowledged unworthiness.","why_fr":"Geste pénitentiel traditionnel d’humilité et d’indignité reconnue.","status_en":"Established traditional practice","status_fr":"Usage traditionnel établi","sources":["MR1962_RITUS","OCONNELL"]},"raw":{"kind":"action","label":"Strike breast","authority":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["GUERANGER"]}},{"id":"agnus:1:breast_strike_3","step":"agnus","actor":"FAITHFUL","underlying_actor":"celebrant","action":"BREAST_STRIKE_3","anchor_lat":"Agnus Dei","anchor_en":"Lamb of God","anchor_fr":"Agneau de Dieu","anchor_placement":"before","authority":"ESTABLISHED_LAY_CUSTOM","lay_status":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["OCONNELL"],"conditions":{},"suppressions":[{"when":{"requiem":true},"reason":"Requiem Agnus does not use the ordinary breast-strike cue."}],"mass_forms":["LOW","SUNG","SOLEMN"],"season":"ANY","requiem":"CONTEXTUAL","special_day":"ANY","posture_before":null,"posture_after":null,"icon_semantic":"BREAST_STRIKE_3","printed_cross_icon_dedupe":false,"count":3,"prominence":"CORE","compatibility_only":false,"guide":{"action_en":"Strike the breast three times with the repeated text.","action_fr":"Frapper la poitrine trois fois avec le texte répété.","why_en":"The repeated breast-striking accompanies the threefold penitential invocation or profession of unworthiness.","why_fr":"Les trois coups accompagnent la triple invocation pénitentielle ou profession d’indignité.","status_en":"Established traditional practice","status_fr":"Usage traditionnel établi","sources":["OCONNELL"]},"raw":{"kind":"action","label":"Strike breast ×3","authority":"ESTABLISHED_LAY_CUSTOM","sourceRefs":["GUERANGER","COCHEM","MULLER"]}},{"i