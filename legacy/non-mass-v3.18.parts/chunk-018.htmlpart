function closeCate(){const r=$('#ao-cate-root');if(r)r.hidden=true;document.body.classList.remove('aoCateOpen')}
function top(){const detail=!!state.detail;return `<header class="aoCateTop"><button data-cate-${detail?'back':'close'} aria-label="${esc(t(detail?'Back':'Close',detail?'Retour':'Fermer'))}">${detail?'←':'×'}</button><div class="aoCateTopTitle"><small>${esc(t('Ad Orientem · formation','Ad Orientem · formation'))}</small><b>${esc(t('Traditional Catechism','Catéchisme traditionnel'))}</b></div><button type="button" class="aoModuleHome" data-app-home aria-label="${esc(t('Return to Home','Retour à l’accueil'))}">⌂</button><div class="aoCateLang"><button data-cate-lang="en" class="${state.lang==='en'?'active':''}">EN</button><button data-cate-lang="fr" class="${state.lang==='fr'?'active':''}">FR</button></div></header>`}
const NAV=[['home','Overview','Accueil'],['browse','Browse','Parcourir'],['study','Study','Étudier'],['search','Search','Rechercher'],['mass','Mass & Sacraments','Messe & Sacrements'],['sources','Sources','Sources']];
function nav(){return `<nav class="aoCateNav">${NAV.map(x=>`<button data-cate-view="${x[0]}" class="${state.view===x[0]?'active':''}">${esc(t(x[1],x[2]))}</button>`).join('')}</nav>`}
function statusLabel(lang=state.lang){if(state.loading[lang])return t('Loading complete Catechism…','Chargement du Catéchisme complet…');const n=corpus(lang).length;if(state.mode[lang]==='cached'&&n===433)return t('433 questions available on this device','433 questions disponibles sur cet appareil');if(lang==='en'&&n===FALLBACK_EN.length)return t(`${n} questions available`,`${n} questions disponibles`);if(state.errors[lang])return t('Complete text unavailable','Texte complet indisponible');return `${n}/433`}
function hero(){const lp=learnedPct(),mode=state.mode[state.lang],loading=state.loading[state.lang];return `<section class="aoCateHero"><div class="aoCateKicker">${esc(t('Learn the Faith','Apprendre la Foi'))}</div><h1>${esc(t('Catechism of St Pius X','Catéchisme de Saint Pie X'))}</h1><p>${esc(t('The concise 1912 catechism as a searchable, progressive study tool. Historical disciplinary statements are preserved but clearly distinguished from current law.','Le catéchisme concis de 1912 comme outil d’étude progressif et consultable. Les énoncés disciplinaires historiques sont conservés mais clairement distingués du droit actuel.'))}</p><div class="aoCateStatusRow"><span class="aoCateStatus ${loading?'loading':mode==='cached'?'ok':''}"><i class="aoCateDot"></i>${esc(statusLabel())}</span><button class="aoCateStatus" data-cate-sync>${esc(t('Check complete text','Vérifier le texte complet'))}</button></div><div class="aoCateProgress"><i style="width:${lp.p}%"></i></div><div class="aoCateProgressText">${lp.c}/433 ${esc(t('marked learned','marquées apprises'))}</div></section>`}
function qButton(x){const cm=chapterMeta(x.chapter);return `<button class="aoCateQA" data-cate-q="${x.n}"><span class="aoCateNum">${x.n}</span><span><b>${esc(x.q)}</b><small>${esc(cm?(state.lang==='fr'?cm.fr:cm.en):t('Catechism question','Question du catéchisme'))}</small></span><span class="aoCateQFlags">${questionFlags(x)}<svg class="aoUiIcon" aria-hidden="true" focusable="false"><use href="#ao-ui-next"></use></svg></span></button>`}
function renderOverview(){const c=corpus(),l=last(),q=getQ(l)||c[0],day=c.length?c[(Math.floor(Date.now()/86400000)%c.length)]:null;return `${hero()}${nav()}${state.errors[state.lang]?`<div class="aoCateNotice"><b>${esc(t('Complete Catechism unavailable','Catéchisme complet indisponible'))}</b><p>${esc(t('The complete text could not be loaded. The questions already available on this device can still be used.','Le texte complet n’a pas pu être chargé. Les questions déjà disponibles sur cet appareil restent utilisables.'))}</p><div class="aoCateActions"><button data-cate-sync>${esc(t('Try again','Réessayer'))}</button></div></div>`:''}<div class="aoCateDashboard">${q?`<button class="aoCateContinue" data-cate-q="${q.n}"><small>${esc(t('Continue','Continuer'))}</small><b>Q${q.n} · ${esc(q.q)}</b><span>${esc(t('Resume where you left off.','Reprendre là où vous vous êtes arrêté.'))}</span></button>`:`<div class="aoCateContinue"><b>${esc(t('Connect once to load French','Connectez-vous une fois pour charger le français'))}</b></div>`}${day?`<button class="aoCateUtility" data-cate-q="${day.n}"><small>${esc(t('Question of the day','Question du jour'))}</small><b>Q${day.n}</b><span>${esc(day.q)}</span></button>`:`<button class="aoCateUtility" data-cate-sync><small>${esc(t('Corpus','Corpus'))}</small><b>${esc(t('Get complete Catechism','Obtenir le Catéchisme complet'))}</b><span>${esc(t('Then available offline on this device.','Puis disponibles hors ligne sur cet appareil.'))}</span></button>`}</div><div class="aoCateToolbar"><button data-cate-view="study" class="primary">${esc(t('Start study mode','Commencer le mode étude'))}</button><button data-cate-offline>${esc(t('Make EN + FR available offline','Rendre EN + FR disponibles hors ligne'))}</button><button data-open-mass-learn>${esc(t('Understand the Mass','Comprendre la Messe'))}</button></div><div class="aoCateSectionTitle"><h2>${esc(t('Browse the catechism','Parcourir le catéchisme'))}</h2><p>${esc(t('Five major parts · 433 questions','Cinq grandes parties · 433 questions'))}</p></div><div class="aoCateGrid">${PARTS.map(p=>{const pr=learnedPct(p.from,p.to);return `<button class="aoCatePartCard" data-cate-view="browse" data-cate-part="${p.id}"><em>Q ${p.from}–${p.to}</em><b>${esc(state.lang==='fr'?p.fr:p.en)}</b><span>${esc(state.lang==='fr'?p.desc_fr:p.desc)}</span><div class="aoCatePartProgress"><i style="width:${pr.p}%"></i></div></button>`}).join('')}</div><section class="aoManagePanel"><strong>${esc(t('Study records','Suivi d’étude'))}</strong><small>${esc(t('Learned marks and bookmarks are separate and can be cleared independently.','Les éléments appris et les favoris sont distincts et peuvent être effacés séparément.'))}</small><div class="aoManageActions"><button class="danger" data-cate-reset="learned">${esc(t('Clear learned marks','Effacer les marques apprises'))}</button><button class="danger" data-cate-reset="bookmarks">${esc(t('Clear bookmarks','Effacer les favoris'))}</button></div></section>`}
function renderBrowse(){const c=corpus();if(!c.length)return `${hero()}${nav()}<div class="aoCateEmpty">${esc(t('French text is not yet available on this device. Connect once and tap Check complete text.','Le texte français n’est pas encore disponible sur cet appareil. Connectez-vous une fois et touchez Vérifier le texte complet.'))}</div>`;const filtered=state.sectionFilter==='bookmarks'?c.filter(x=>bookmarks().has(x.n)):state.sectionFilter==='learned'?c.filter(x=>learned().has(x.n)):c;const by=new Map;for(const m of MANIFEST){const items=filtered.filter(x=>x.chapter===m.id);if(items.length)by.set(m.id,items)}return `${hero()}${nav()}<div class="aoCateToolbar"><button data-cate-filter="all" class="${state.sectionFilter==='all'?'active':''}">${esc(t('All','Tout'))}</button><button data-cate-filter="bookmarks" class="${state.sectionFilter==='bookmarks'?'active':''}">${esc(t('Bookmarked','Favoris'))}</button><button data-cate-filter="learned" class="${state.sectionFilter==='learned'?'active':''}">${esc(t('Learned','Apprises'))}</button></div>${MANIFEST.map(m=>{const items=by.get(m.id)||[];if(!items.length)return'';const open=state.openChapter===m.id;const range=`${items[0].n}–${items[items.length-1].n}`;return `<section class="aoCateChapter"><button data-cate-chapter="${m.id}"><b>${esc(state.lang==='fr'?m.fr:m.en)}</b><span>Q ${range} · ${items.length} ${open?'−':'+'}</span></button><div class="aoCateChapterBody" ${open?'':'hidden'}><div class="aoCateQAList">${items.map(qButton).join('')}</div></div></section>`}).join('')||`<div class="aoCateEmpty">${esc(t('No questions in this filter.','Aucune question dans ce filtre.'))}</div>`}`}
function chooseStudy(){const c=corpus();if(!c.length)return null;const l=learned(),pool=c.filter(x=>!l.has(x.n));const src=pool.length?pool:c;return src[Math.floor(Math.random()*src.length)]}
function renderStudy(){let x=state.studyN&&getQ(state.studyN);if(!x){x=chooseStudy();state.studyN=x?.n||null;state.revealed=false}if(!x)return `${hero()}${nav()}<div class="aoCateEmpty">${esc(t('The complete Catechism is required to begin study mode.','Le Catéchisme complet est nécessaire pour commencer le mode étude.'))}</div>`;return `${hero()}${nav()}<div class="aoCateStudy"><article class="aoCateStudyCard"><div class="number">Q ${x.n} / 433</div><h2>${esc(x.q)}</h2>${state.revealed?`<div class="aoCateStudyAnswer">${esc(x.a)}</div>`:`<button class="aoCateActions aoCateReveal" data-cate-reveal>${esc(t('Reveal answer','Afficher la réponse'))}</button>`}</article><div class="aoCateActions">${state.revealed?`<button data-cate-learn="${x.n}" class="primary">${learned().has(x.n)?esc(t('Learned ✓','Apprise ✓')):esc(t('Mark learned','Marquer apprise'))}</button>`:''}<button data-cate-next-study>${esc(t('Next question','Question suivante'))}<svg class="aoUiIcon" aria-hidden="true" focusable="false"><use href="#ao-ui-next"></use></svg></button><button data-cate-q="${x.n}">${esc(t('Open full card','Ouvrir la fiche'))}</button></div></div>`}
function searchHits(q){const s=q.trim().toLocaleLowerCase();if(!s)return[];const c=corpus();return c.filter(x=>String(x.n)===s||x.q.toLocaleLowerCase().includes(s)||x.a.toLocaleLowerCase().includes(s)).slice(0,120)}
function renderSearch(){const hits=searchHits(state.query);return `${hero()}${nav()}<div class="aoCateSearchBox"><div class="aoCateSearch"><input id="aoCateSearchInput" value="${esc(state.query)}" placeholder="${esc(t('Search question, answer or number…','Rechercher une question, une réponse ou un numéro…'))}" autocomplete="off" inputmode="search"><button data-cate-clear aria-label="${esc(t('Clear','Effacer'))}"><svg class="aoUiIcon" aria-hidden="true" focusable="false"><use href="#ao-ui-close"></use></svg></button></div><div class="aoCateResultCount">${state.query?`${hits.length} ${esc(t('matches','résultats'))}`:esc(t('Search across the complete current-language corpus.','Recherchez dans tout le corpus de la langue actuelle.'))}</div></div>${state.query?`<div class="aoCateQAList">${hits.length?hits.map(qButton).join(''):`<div class="aoCateEmpty">${esc(t('No match.','Aucun résultat.'))}</div>`}</div>`:''}`}
function renderMass(){const c=corpus(),euch=c.filter(x=>MASS_RANGE.has(x.n)),groups=MANIFEST.filter(m=>m.part==='grace'&&m.id!=='eucharist').map(m=>({m,items:c.filter(x=>x.chapter===m.id)})).filter(g=>g.items.length);return `${hero()}${nav()}<div class="aoCateNotice"><b>${esc(t('Doctrine ↔ liturgy','Doctrine ↔ liturgie'))}</b><p>${esc(t('Use the catechism for the doctrinal foundation; use Understand the Mass for the rite, ceremonial, history and the reason for particular actions.','Utilisez le catéchisme pour le fondement doctrinal ; utilisez Comprendre la Messe pour le rite, le cérémonial, l’histoire et la raison des actions particulières.'))}</p><div class="aoCateActions"><button data-open-mass-learn class="primary">${esc(t('Open Understand the Mass','Ouvrir Comprendre la Messe'))}</button></div></div><div class="aoCateSectionTitle"><h2>${esc(t('Eucharist & Holy Mass','Eucharistie & Sainte Messe'))}</h2><p>Q 316–354</p></div><div class="aoCateQAList">${euch.map(qButton).join('')}</div><div class="aoCateSectionTitle"><h2>${esc(t('Other sacraments','Autres sacrements'))}</h2><p>${groups.reduce((n,g)=>n+g.items.length,0)} ${esc(t('questions','questions'))}</p></div>${groups.map(({m,items})=>{const open=state.openChapter===m.id;return `<section class="aoCateChapter"><button data-cate-chapter="${m.id}"><b>${esc(state.lang==='fr'?m.fr:m.en)}</b><span>Q ${items[0].n}–${items[items.length-1].n} · ${open?'−':'+'}</span></button><div class="aoCateChapterBody" ${open?'':'hidden'}><div class="aoCateQAList">${items.map(qButton).join('')}</div></div></section>`}).join('')}`}
function sourceCard(s){return `<article class="aoCateSource"><span class="kind">${esc(state.lang==='fr'?s.kind_fr:s.kind)}</span><b>${esc(state.lang==='fr'?s.label_fr:s.label)}</b><p>${esc(state.lang==='fr'?s.note_fr:s.note)}</p><a href="${esc(s.url)}" target="_blank" rel="noopener noreferrer">${esc(t('Open source ↗','Ouvrir la source ↗'))}</a></article>`}
function renderSources(){return `${hero()}${nav()}<div class="aoCateNotice"><b>${esc(t('Texts and offline availability','Textes et disponibilité hors ligne'))}</b><p>${esc(t(`The complete Catechism contains 433 questions. A smaller English selection is available immediately; when the complete English or French text has been downloaded successfully, it can also be used offline on this device.`,`Le Catéchisme complet contient 433 questions. Une sélection anglaise plus réduite est disponible immédiatement ; lorsque le texte complet anglais ou français a été téléchargé avec succès, il peut aussi être utilisé hors ligne sur cet appareil.`))}</p></div>${SOURCE_CARDS.map(sourceCard).join('')}`}
function renderDetail(n){const x=getQ(n);if(!x)return `<div class="aoCateEmpty">${esc(t('This question is not available in the current local corpus yet. Refresh the source.','Cette question n’est pas encore disponible dans le corpus local actuel. Actualisez la source.'))}</div>`;markLast(x.n);const cm=chapterMeta(x.chapter),pm=partMeta(x.part),note=historicalNote(x),l=learned(),b=bookmarks(),prev=getQ(x.n-1),next=getQ(x.n+1),mass=MASS_RANGE.has(x.n);return `<article class="aoCateArticle"><div class="aoCateArticleHead"><div class="aoCateKicker">${esc(t('Question','Question'))} ${x.n} / 433</div><div class="aoCateMetaLine"><span>${esc(state.lang==='fr'?pm.fr:pm.en)}</span>${cm?`<span>· ${esc(state.lang==='fr'?cm.fr:cm.en)}</span>`:''}</div><h1>${esc(x.q)}</h1></div><div class="aoCateAnswer"><p>${esc(x.a)}</p></div>${x.sourceTruncated?`<div class="aoCateFlag"><b>${esc(t('Text note','Note sur le texte'))}</b><span>${esc(t('The available French transcription truncates this question at a historical page break. The answer is preserved; consult the linked historical edition for the complete printed question.','La transcription française disponible tronque cette question à un saut de page historique. La réponse est conservée ; consultez l’édition historique liée pour la question imprimée complète.'))}</span></div>`:''}${note?`<div class="aoCateFlag"><b>${esc(t('Historical context / discipline','Contexte / discipline historique'))}</b><span>${esc(note)}</span></div>`:''}<div class="aoCateActions"><button data-cate-learn="${x.n}" class="${l.has(x.n)?'primary':''}">${l.has(x.n)?'✓ '+esc(t('Learned','Apprise')):esc(t('Mark learned','Marquer apprise'))}</button><button data-cate-bookmark="${x.n}" class="${b.has(x.n)?'primary':''}">${b.has(x.n)?'★ '+esc(t('Bookmarked','Favori')):'☆ '+esc(t('Bookmark','Favori'))}</button>${mass?`<button data-open-mass-learn>${esc(t('Study in Understand the Mass','Étudier dans Comprendre la Messe'))}</button>`:''}</div><div class="aoCatePager">${prev?`<button data-cate-q="${prev.n}"><svg class="aoUiIcon" aria-hidden="true" focusable="false"><use href="#ao-ui-previous"></use></svg> Q${prev.n}<br><small>${esc(prev.q)}</small></button>`:'<span></span>'}${next?`<button data-cate-q="${next.n}">Q${next.n} <svg class="aoUiIcon" aria-hidden="true" focusable="false"><use href="#ao-ui-next"></use></svg><br><small>${esc(next.q)}</small></button>`:''}</div><div class="aoCateNotice"><b>${esc(t('Text provenance','Provenance du texte'))}</b><p>${esc(state.lang==='fr'?t('','Texte français chargé depuis la transcription structurée du Petit Catéchisme de 1912 ; voir Sources pour la référence historique Bailly 1913.'):'English study translation aligned to the canonical 1912 Italian text; it is not labelled as the historical Hagan edition. See Sources for provenance.')}</p></div></article>`}
function readerViewTitle(){
 if(state.detail)return `${t('Question','Question')} ${state.detail}`;
 if(state.view==='browse')return t('Browse the Catechism','Parcourir le Catéchisme');
 if(state.view==='study')return t('Study','Étudier');
 if(state.view==='search')return t('Search','Rechercher');
 if(state.view==='mass')return t('Mass & Sacraments','Messe & Sacrements');
 if(state.view==='sources')return t('Sources','Sources');
 return t('Catechism of St Pius X','Catéchisme de Saint Pie X')
}
function readerSubnav(){
 const language=`<div class="aoCateLang" role="group" aria-label="${esc(t('Language','Langue'))}"><button data-cate-lang="en" class="${state.lang==='en'?'active':''}">EN</button><button data-cate-lang="fr" class="${state.lang==='fr'?'active':''}">FR</button></div>`;
 return `<div class="aoStudySubnav">${state.detail?'':nav()}${language}</div>`
}
function render(){
 const r=shell();let body;
 if(state.detail)body=renderDetail(state.detail);
 else body=state.view==='home'?renderOverview():state.view==='browse'?renderBrowse():state.view==='study'?renderStudy():state.view==='search'?renderSearch():state.view==='mass'?renderMass():renderSources();
 const P=globalThis.AO_PRESENTATION_SHELLS_V435920;
 if(P?.reader){
  const detail=!!state.detail;
  if(!detail)body=body.replace(nav(),'');
  const home=`<button type="button" class="aoCateReaderHome" data-app-home aria-label="${esc(t('Return to Home','Retour à l’accueil'))}"><svg class="aoUiIcon" aria-hidden="true" focusable="false"><use href="#ao-ui-home"></use></svg></button>`;
  r.innerHTML=P.reader({
   title:readerViewTitle(),
   context:t('Traditional Catechism','Catéchisme traditionnel'),
   showLead:false,
   backAttrs:detail?'data-cate-back':'data-cate-close',
   backIcon:detail?'ao-ui-back':'ao-ui-close',
   backLabel:t(detail?'Back':'Close',detail?'Retour':'Fermer'),
   rightHtml:home,
   subnav:readerSubnav(),
   body:`<div class="aoCateWrap">${body}</div>`
  })
 }else r.innerHTML=`${top()}<div class="aoCateWrap">${body}</div>`;
 if(!state.detail&&state.view!=='search')r.scrollTop=0;
 if(state.view==='search'&&!state.detail)setTimeout(()=>$('#aoCateSearchInput',r)?.focus(),0);
 enhanceUnderstand()
}
function setView(v,part=''){state.view=v;state.detail=null;state.revealed=false;if(v==='browse'&&part){state.sectionFilter='all';const first=MANIFEST.find(x=>x.part===part);state.openChapter=first?.id||''}render()}
function setLang(lang){state.lang=lang;state.detail=null;state.studyN=null;state.revealed=false;if(!state.corpora[lang])readCache(lang);render();ensureCurrent()}
function enhanceUnderstand(){const root=$('#ao-learn-root');if(!root||root.hidden)return;const wrap=$('.aoLearnWrap',root);if(!wrap)return;const hero=$('.aoLearnHero',wrap);if(!hero)return;const fr=$('[data-learn-lang=\"fr\"]',root)?.classList.contains('active');const lt=(en,frText)=>fr?(frText||en):en;if(!$('.aoFormationBridge',wrap)){const d=document.createElement('div');d.className='aoFormationBridge';d.innerHTML=`<div><small>${esc(lt('Formation companion','Compagnon de formation'))}</small><b>${esc(lt('Traditional Catechism','Catéchisme traditionnel'))}</b><p>${esc(lt('Move from the rite to the doctrine behind the sacraments, Eucharist and Christian life.','Passez du rite à la doctrine sur les sacrements, l’Eucharistie et la vie chrétienne.'))}</p></div><button data-open-catechism aria-label="${esc(lt('Open Catechism','Ouvrir le Catéchisme'))}">→</button>`;hero.after(d)}if($('.aoLessonList',wrap)&&!$('.aoFormationProgress',wrap)){let done=[];try{done=JSON.parse(localStorage.getItem('ao_understand_mass_progress_v1')||'[]')}catch{}const ids=['mass','read','space','foot','entrance','word','offertory','canon','consecration','communion','end','forms','year','exceptional'];const first=ids.find(id=>!done.includes(id))||ids[0];const box=document.createElement('div');box.className='aoFormationProgress';box.innerHTML=`<div class="aoFormationProgressHead"><b>${esc(lt('Course progress','Progression du parcours'))}</b><span>${done.length}/14</span></div><div class="aoCateProgress"><i style="width:${Math.round(done.length/14*100)}%"></i></div><button data-learn-lesson="${first}">${esc(done.length===14?lt('Review the course','Revoir le parcours'):lt('Continue course','Continuer le parcours'))} →</button>`;$('.aoFormationBridge',wrap).after(box)}}
document.addEventListener('click',async e=>{const el=e.target.closest('button,a');if(!el)return;if(el.closest('#ao-cate-root')){if(el.matches('[data-cate-close]')){closeCate();return}if(el.matches('[data-cate-back]')){state.detail=null;render();return}if(el.dataset.cateReset){const k=el.dataset.cateReset,msg=k==='learned'?t('Clear all learned marks?','Effacer toutes les marques apprises ?'):t('Clear all bookmarks?','Effacer tous les favoris ?');if(confirm(msg)){putSet(k,new Set());render()}return}if(el.dataset.cateLang){setLang(el.dataset.cateLang);return}if(el.dataset.cateQ){state.detail=Number(el.dataset.cateQ);state.revealed=false;render();return}if(el.dataset.cateView){setView(el.dataset.cateView,el.dataset.catePart||'');return}if(el.dataset.cateChapter){state.openChapter=state.openChapter===el.dataset.cateChapter?'':el.dataset.cateChapter;render();return}if(el.dataset.cateFilter){state.sectionFilter=el.dataset.cateFilter;render();return}if(el.matches('[data-cate-sync]')){loadFull(state.lang,true);return}if(el.matches('[data-cate-offline]')){el.disabled=true;el.textContent=t('Saving both languages…','Enregistrement des deux langues…');await saveBoth();render();return}if(el.matches('[data-cate-reveal]')){state.revealed=true;render();return}if(el.matches('[data-cate-next-study]')){const x=chooseStudy();state.studyN=x?.n||null;state.revealed=false;render();return}if(el.dataset.cateLearn){const s=learned(),n=Number(el.dataset.cateLearn);s.has(n)?s.delete(n):s.add(n);putSet('learned',s);render();return}if(el.dataset.cateBookmark){const s=bookmarks(),n=Number(el.dataset.cateBookmark);s.has(n)?s.delete(n):s.add(n);putSet('bookmarks',s);render();return}if(el.matches('[data-cate-clear]')){state.query='';render();return}if(el.matches('[data-open-mass-learn]')){closeCate();window.AO_UNDERSTAND_MASS?.open?.();return}}if(el.matches('[data-open-catechism]')){window.AO_UNDERSTAND_MASS?.close?.();openCate();return}})
document.addEventListener('input',e=>{if(e.target?.id==='aoCateSearchInput'){state.query=e.target.value;const box=$('.aoCateWrap',shell());const hits=searchHits(state.query);const list=box?.querySelector('.aoCateQAList');const count=box?.querySelector('.aoCateResultCount');if(count)count.textContent=state.query?(hits.length+' '+t('matches','résultats')):t('Search across the complete current-language corpus.','Recherchez dans tout le corpus de la langue actuelle.');if(list)list.innerHTML=hits.length?hits.map(qButton).join(''):`<div class="aoCateEmpty">${esc(t('No match.','Aucun résultat.'))}</div>`}})
document.addEventListener('keydown',e=>{const r=$('#ao-cate-root');if(e.key==='Escape'&&r&&!r.hidden){state.detail?(state.detail=null,render()):closeCate()}})
readCache('en');readCache('fr');
window.AO_TRADITIONAL_CATECHISM={open:openCate,close:closeCate,back:()=>{if(state.detail){state.detail=null;render();return true}closeCate();return true},resetLearned:()=>{putSet('learned',new Set());const r=$('#ao-cate-root');if(r&&!r.hidden)render();return true},resetBookmarks:()=>{putSet('bookmarks',new Set());const r=$('#ao-cate-root');if(r&&!r.hidden)render();return true},openQuestion:(n)=>{const x=getQ(n);if(!x)return false;state.detail=Number(n);state.revealed=false;render();return true},restoreState:(x={})=>{state.lang=x.lang||langFromApp();state.view=x.view||'home';state.detail=x.detail??null;state.query=x.query||'';state.revealed=!!x.revealed;document.body.classList.add('aoCateOpen');shell().hidden=false;render();return true},getState:()=>({...state}),load:(lang='en')=>loadFull(lang,true),count:()=>corpus().length,questions:(lang=state.lang)=>corpus(lang).map(x=>({...x})),question:(n,lang=state.lang)=>corpus(lang).find(x=>x.n===Number(n))||null,isLearned:(n)=>learned().has(Number(n)),setLearned:(n,value)=>{const x=learned(),id=Number(n);value?x.add(id):x.delete(id);putSet('learned',x);return true},enhanceUnderstand,version:CACHE_VERSION};
})();
</script>

<script>window.AO_CONTENT_INTEGRITY_V7={version:"7",policy:"same-language-first; no silent Latin-as-vernacular; no English-under-French-commentary",properFields:["Introit","Collects","Epistle/Lesson","Gradual/Tract/Alleluia","Sequence","Gospel","Offertory","Secrets","Preface","Communion","Postcommunions","Preparatory lessons"]};</script>
<style id="ao-content-audit-v8-css">
body.aoAuditOpen{overflow:hidden}.aoAuditBackdrop{position:fixed;inset:0;z-index:10050;background:rgba(3,6,10,.82);backdrop-filter:blur(10px);display:flex;justify-content:center;align-items:flex-end}.aoAuditPanel{width:min(100%,760px);height:min(92dvh,900px);overflow:auto;background:var(--surface-1,#111820);color:var(--text,#f4efe4);border:1px solid var(--border,#29333d);border-radius:24px 24px 0 0;padding:18px 18px calc(28px + env(safe-area-inset-bottom));box-shadow:0 -20px 80px rgba(0,0,0,.45)}.aoAuditPanel header{position:sticky;top:-18px;z-index:2;margin:-18px -18px 14px;padding:16px 18px 12px;background:color-mix(in srgb,var(--surface-1,#111820) 96%,transparent);border-bottom:1px solid var(--border,#29333d);display:flex;justify-content:space-between;gap:12px}.aoAuditPanel header span,.aoAuditKicker{font-size:.67rem;text-transform:uppercase;letter-spacing:.12em;color:var(--muted,#9aa4ad)}.aoAuditPanel h2{margin:.15rem 0 0;font-family:var(--font-display,serif)}.aoAuditClose{width:42px;height:42px;border:1px solid var(--border,#29333d);border-radius:50%;background:transparent;color:inherit;font-size:1.4rem}.aoAuditControls{display:grid;grid-template-columns:1fr auto;gap:9px;margin:14px 0}.aoAuditControls input,.aoAuditControls button{min-height:46px;border:1px solid var(--border,#29333d);border-radius:12px;background:var(--surface-2,#17212b);color:inherit;padding:0 12px}.aoAuditControls button{background:var(--liturgical,#8e1d2c);font-weight:700}.aoAuditProgress{height:5px;background:rgba(255,255,255,.08);border-radius:10px;overflow:hidden;margin:10px 0}.aoAuditProgress i{display:block;width:0;height:100%;background:var(--liturgical,#8e1d2c);transition:width .15s}.aoAuditSummary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin:14px 0}.aoAuditStat{border:1px solid var(--border,#29333d);border-radius:15px;padding:12px;background:var(--surface-2,#17212b)}.aoAuditStat b{display:block;font-size:1.35rem;font-family:var(--font-display,serif)}.aoAuditStat span{font-size:.72rem;color:var(--muted,#9aa4ad)}.aoAuditSection{margin:16px 0}.aoAuditSection h3{font-family:var(--font-display,serif);margin:0 0 8px}.aoAuditTable{width:100%;border-collapse:collapse;font-size:.78rem}.aoAuditTable th,.aoAuditTable td{padding:8px 6px;border-bottom:1px solid var(--border,#29333d);text-align:left;vertical-align:top}.aoAuditTable th{color:var(--muted,#9aa4ad);font-size:.66rem;text-transform:uppercase;letter-spacing:.07em}.aoAuditMissing{max-height:260px;overflow:auto;border:1px solid var(--border,#29333d);border-radius:12px}.aoAuditMissing article{padding:10px 11px;border-bottom:1px solid var(--border,#29333d)}.aoAuditMissing article:last-child{border:0}.aoAuditMissing b{display:block}.aoAuditMissing small{color:var(--muted,#9aa4ad)}.aoAuditNote{padding:11px;border-left:3px solid var(--liturgical,#8e1d2c);background:var(--surface-2,#17212b);font-size:.8rem;line-height:1.45}.aoAuditActions{display:flex;gap:8px;flex-wrap:wrap}.aoAuditActions button{min-height:42px;padding:0 12px;border:1px solid var(--border,#29333d);border-radius:11px;background:transparent;color:inherit}@media(max-width:520px){.aoAuditSummary{grid-template-columns:1fr 1fr}.aoAuditControls{grid-template-columns:1fr}.aoAuditTable{font-size:.72rem}}
</style>

<style id="ao-content-audit-v14-css">
.aoAuditMatrix{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin:12px 0}.aoAuditMatrix .aoAuditStat{min-height:76px}.aoAuditBadge{display:inline-flex;align-items:center;gap:5px;border:1px solid var(--border,#29333d);border-radius:999px;padding:3px 8px;font-size:.65rem;margin:2px 3px 2px 0}.aoAuditBadge.ok{border-color:#587b63}.aoAuditBadge.warn{border-color:#8b6d3f}.aoAuditBadge.bad{border-color:#8b4e56}.aoAuditFieldGrid{overflow:auto;border:1px solid var(--border,#29333d);border-radius:12px}.aoAuditFieldGrid table{min-width:690px}.aoAuditScope{display:grid;gap:7px}.aoAuditScope article{padding:10px 11px;border:1px solid var(--border,#29333d);border-radius:11px;background:var(--surface-2,#17212b)}.aoAuditScope b{display:block;margin-bottom:3px}.aoAuditTabs{display:flex;gap:6px;overflow:auto;margin:10px 0}.aoAuditTabs button{white-space:nowrap;min-height:38px;padding:0 10px;border:1px solid var(--border,#29333d);border-radius:10px;background:transparent;color:inherit}.aoAuditTabs button.active{background:var(--liturgical,#8e1d2c);border-color:transparent}.aoAuditMissing article[data-severity="red"]{border-left:3px solid #9a4d59}.aoAuditMissing article[data-severity="amber"]{border-left:3px solid #9a7847}.aoAuditMono{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.69rem;word-break:break-word}@media(max-width:620px){.aoAuditMatrix{grid-template-columns:1fr 1fr}}
</style>
<script id="ao-content-audit-v14-js">
(()=>{'use strict';
const STATIC={sourceFiles:{latin:1066,en:945,fr:952,both:930},temporal:{latin:526,both:475},sanctoral:{latin:524,both:448},commune:{liveLatin:2,liveEn:2,liveFr:1,normalized1962:28,addressableLa:28,addressableEn:28,addressableFr:28},fixed:{what:118,understand:118,history:12,massAdjacentPrayerUnits:26}};
const FIELD_LABELS={introit:'Introit',collects:'Collect(s)',epistle:'Epistle / Lesson',gradual:'Gradual / Tract / Alleluia',sequence:'Sequence',gospel:'Gospel',offertory:'Offertory',secrets:'Secret(s)',preface:'Preface',communion:'Communion',postcommunions:'Postcommunion(s)',preparatoryLessons:'Preparatory lessons',preparatoryGraduals:'Preparatory graduals',preparatoryCollects:'Preparatory collects'};
const CATEGORY_ORDER=['Temporal','Sanctoral','Requiem','Common','Other'];
let lastReport=null,running=false,activePanel='summary';
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
const iso=d=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
const pct=(a,b)=>b?Math.round(a/b*1000)/10:0;
function eachText(p){const arr=[];const add=(slot,v)=>{if(!v)return;if(typeof v==='string'&&v.trim()){arr.push({slot,text:{lat:v,en:v,fr:v}});return}if(typeof v==='object'&&!Array.isArray(v)&&(String(v.lat||'').trim()||String(v.en||'').trim()||String(v.fr||'').trim()))arr.push({slot,text:v})};add('introit',p.introit);(p.collects||[]).forEach(v=>add('collects',v));add('epistle',p.epistle);add('gradual',p.gradual);add('sequence',p.sequence);add('gospel',p.gospel);add('offertory',p.offertory);(p.secrets||[]).forEach(v=>add('secrets',v));add('preface',p.preface);add('communion',p.communion);(p.postcommunions||[]).forEach(v=>add('postcommunions',v));for(const row of (p.preparatoryLessons||[])){add('preparatoryLessons',row.lesson);add('preparatoryGraduals',row.gradual);add('preparatoryCollects',row.collect)}return arr}
function kindFor(slot){return slot==='gospel'?'gospel':'scripture'}
function baseCategory(p){const path=String(p?.sourcePath||'');if(p?.isRequiem||p?.riteProfile==='requiem_mass_1962'||/^Sancti\/11-02m/.test(path))return'Requiem';if(path.startsWith('Tempora/'))return'Temporal';if(path.startsWith('Sancti/'))return'Sanctoral';if(path.startsWith('Commune/'))return'Common';return'Other'}
function isExceptional(p){return !!p?.riteProfile && p.riteProfile!=='ordinary_mass' && p.riteProfile!=='requiem_mass_1962'}
function blankCategory(name){return{name,days:0,formularies:new Set(),en:{expected:0,available:0,completeDates:0},fr:{expected:0,available:0,completeDates:0},missing:0,commentary:{references:0,enFull:0,frIntegrated:0,frLinkOnly:0,frMissing:0}}}
function blankField(name){return{name,en:{expected:0,available:0,missing:0},fr:{expected:0,available:0,missing:0},dates:new Set()}}
function coverageForField(p,lang,field){const c=p?.languageCoverage?.[lang];if(!c)return null;const missing=new Set(c.missing||[]);const aliases=[field,FIELD_LABELS[field],field==='collects'?'Collects':null,field==='secrets'?'Secrets':null,field==='postcommunions'?'Postcommunions':null].filter(Boolean);const miss=aliases.some(x=>missing.has(x));return{expected:true,available:!miss}}
function noteFieldStats(report,p,date){const units=eachText(p).filter(x=>String(x.text?.lat||'').trim());for(const u of units){const fs=report.fields[u.slot]||(report.fields[u.slot]=blankField(u.slot));fs.dates.add(date);for(const lang of ['en','fr']){fs[lang].expected++;if(String(u.text?.[lang]||'').trim())fs[lang].available++;else fs[lang].missing++}}}
function commentaryBucket(report,category){return report.categories[category]?.commentary||report.categories.Other.commentary}
function commentaryStatus(doc){const docs=doc?.parts?.length?doc.parts:[doc];if(!docs.length||!docs[0])return{parsed:false,en:false,fr:'missing',scope:null};const parsed=docs.every(x=>!!x?.reference);if(!parsed)return{parsed:false,en:false,fr:'missing',scope:null};const en=docs.every(x=>x.reference?.kind==='gospel'?!!x.englishCatena?.length:(!!x.englishCommentary?.entries?.length||!!x.englishNotes?.length));const frInt=docs.every(x=>!!x.frenchCommentary?.entries?.length||!!x.frenchCatena?.length);const frLink=!frInt&&docs.every(x=>x.reference?.kind==='gospel'&&!!x.frenchCatenaUrl);return{parsed:true,en,fr:frInt?'integrated':frLink?'link-only':'missing',scope:docs.map(x=>x.frenchCommentary?.scope).filter(Boolean).join('+')||null}}
async function auditYear(year,{verifyCommentary=true,onProgress=()=>{}}={}){
 const rt=window.AO_RUNTIME_V8;if(!rt?.resolver)throw new Error('Ad Orientem runtime is not ready.');
 const report={version:'14',year,generated:new Date().toISOString(),scope:'calendar-resolved General Roman Calendar plus source-tree supplementary gate',days:{attempted:0,resolved:0,failed:0,properReady:0,exceptional:0,inherited:0},proper:{en:{expected:0,available:0,completeDates:0},fr:{expected:0,available:0,completeDates:0},missing:[],uniqueFormularies:[]},categories:{},fields:{},exceptional:{profiles:{},items:[]},commentary:{references:0,attempted:0,parseOrLoadFailures:0,en:{full:0,missing:0},fr:{integrated:0,psalmLevel:0,verseNotes:0,linkOnly:0,missing:0},items:[],failures:[],bySlot:{}},sources:{structuralInheritances:0,legacyCommonRecoveries:0,structuralExamples:[],legacyCommonExamples:[]},static:STATIC,supplementary:{commune:{normalized1962Files:28,recoveryChain:'normalized same-language -> current missa -> pinned legacy missa Commune -> horas; normalized Latin reference structure inherited without Latin prose',legacyMassFiles:{la:48,en:40,fr:47},knownSpecialCase:'C7a French has no legacy Mass file; current same-language horas supplies its Mass sections and normalized Latin contributes only missing reference structure; runtime audit remains controlling',status:'Common references now recovered from genuine same-language historical Mass sources where available; runtime field audit remains controlling'},votive:{status:'enumerated separately by v15 supplementary gate',normalizedFiles:21,seasonalMarianCommonForms:5},requiem:{status:'daily Requiem plus all three All Souls Masses explicitly enumerated by v15'}},errors:[]};
 for(const n of CATEGORY_ORDER)report.categories[n]=blankCategory(n);
 const forms=new Map(),refs=new Map();const start=new Date(`${year}-01-01T12:00:00`),end=new Date(`${year+1}-01-01T12:00:00`),total=Math.round((end-start)/86400000);let idx=0;
 for(let d=new Date(start);d<end;d.setDate(d.getDate()+1)){
   idx++;const date=iso(d);report.days.attempted++;onProgress(idx/total*.62,`Calendar ${idx}/${total} · ${date}`);
   try{
     const res=await rt.resolver.resolveDay(date);if(res?.status!=='ready'){report.days.failed++;report.errors.push({date,stage:'calendar',error:res?.error||'day resolution failed'});continue}report.days.resolved++;
     if(res.proper?.status!=='ready'||!res.proper.data){report.days.failed++;report.errors.push({date,stage:'proper',error:res.proper?.error||'Proper unavailable'});continue}
     const diag=res.diagnostic||{};const structural=diag.structuralInheritances||[],legacy=diag.legacyCommonRecoveries||[];report.sources.structuralInheritances+=structural.length;report.sources.legacyCommonRecoveries+=legacy.length;for(const x of structural){if(report.sources.structuralExamples.length<80)report.sources.structuralExamples.push({date,...x})}for(const x of legacy){if(report.sources.legacyCommonExamples.length<80)report.sources.legacyCommonExamples.push({date,...x})}
     report.days.properReady++;const p=res.proper.data,category=baseCategory(p),cat=report.categories[category]||report.categories.Other;cat.days++;if(p.inheritedProper)report.days.inherited++;
     const key=p.sourcePath||p.properId||`${date}:${p.title?.la||''}`;cat.formularies.add(key);if(!forms.has(key))forms.set(key,{key,category,properId:p.properId||null,sourcePath:p.sourcePath||null,title:p.title?.en||p.title?.fr||p.title?.la||'',riteProfile:p.riteProfile||'ordinary_mass',dates:[]});forms.get(key).dates.push(date);
     if(isExceptional(p)){report.days.exceptional++;const pr=p.riteProfile||'exceptional';report.exceptional.profiles[pr]=(report.exceptional.profiles[pr]||0)+1;report.exceptional.items.push({date,profile:pr,path:p.sourcePath||'',title:p.title?.en||p.title?.la||''})}
     for(const lang of ['en','fr']){const c=p.languageCoverage?.[lang];if(c){report.proper[lang].expected+=c.expected||0;report.proper[lang].available+=c.available||0;cat[lang].expected+=c.expected||0;cat[lang].available+=c.available||0;if(c.complete){report.proper[lang].completeDates++;cat[lang].completeDates++}else{cat.missing++;report.proper.missing.push({date,category,lang,properId:p.properId||'',sourcePath:p.sourcePath||'',fields:c.missing||[]})}}}
     noteFieldStats(report,p,date);
     for(const x of eachText(p)){const normText=v=>String(v||'').replace(/\s+/g,' ').trim();const id=[x.slot,normText(x.text?.lat),normText(x.text?.en),normText(x.text?.fr)].join('|');if(!refs.has(id))refs.set(id,{text:x.text,slot:x.slot,dates:[date],categories:new Set([category]),paths:new Set([p.sourcePath||''])});else{const z=refs.get(id);z.dates.push(date);z.categories.add(category);z.paths.add(p.sourcePath||'')}}
   }catch(e){report.days.failed++;report.errors.push({date,stage:'exception',error:e instanceof Error?e.message:String(e)})}
 }
 report.proper.uniqueFormularies=[...forms.values()];
 if(verifyCommentary){const list=[...refs.values()];let ci=0;for(const item of list){ci++;report.commentary.attempted++;onProgress(.62+(ci/Math.max(1,list.length))*.37,`Commentary ${ci}/${list.length}`);let doc=null;try{doc=await rt.scriptureService.load(kindFor(item.slot),item.text)}catch(e){report.commentary.parseOrLoadFailures++;report.commentary.failures.push({slot:item.slot,dates:item.dates.slice(0,12),paths:[...item.paths].slice(0,8),error:e instanceof Error?e.message:String(e)});continue}const st=commentaryStatus(doc);if(!st.parsed){report.commentary.parseOrLoadFailures++;report.commentary.failures.push({slot:item.slot,dates:item.dates.slice(0,12),paths:[...item.paths].slice(0,8),error:'No parsed Scripture reference'});continue}report.commentary.references++;if(!report.commentary.bySlot[item.slot])report.commentary.bySlot[item.slot]={references:0,enFull:0,frIntegrated:0,frLinkOnly:0,frMissing:0};const slot=report.commentary.bySlot[item.slot];slot.references++;if(st.en){report.commentary.en.full++;slot.enFull++}else report.commentary.en.missing++;if(st.fr==='integrated'){report.commentary.fr.integrated++;slot.frIntegrated++;const docs=doc.parts?.length?doc.parts:[doc];if(docs.some(x=>x.frenchCommentary?.scope==='psalm-full'))report.commentary.fr.psalmLevel++;if(docs.some(x=>x.frenchCommentary?.scope==='verse-notes'))report.commentary.fr.verseNotes++}else if(st.fr==='link-only'){report.commentary.fr.linkOnly++;slot.frLinkOnly++}else{report.commentary.fr.missing++;slot.frMissing++}
     for(const category of item.categories){const b=commentaryBucket(report,category);b.references++;if(st.en)b.enFull++;if(st.fr==='integrated')b.frIntegrated++;else if(st.fr==='link-only')b.frLinkOnly++;else b.frMissing++}
     report.commentary.items.push({reference:doc.reference?.display||doc.parts?.[0]?.reference?.display||'',referenceFr:doc.reference?.displayFr||doc.parts?.[0]?.reference?.displayFr||'',kind:doc.reference?.kind||doc.parts?.[0]?.reference?.kind||'',slot:item.slot,en:st.en?'full':'missing',fr:st.fr,frScope:st.scope,dates:item.dates.slice(0,12),categories:[...item.categories],paths:[...item.paths].slice(0,8)})
   }}
 for(const c of Object.values(report.categories))c.formularies=[...c.formularies];for(const f of Object.values(report.fields))f.dates=[...f.dates];onProgress(1,'Audit complete.');return report
}
function mergeReports(reports){if(reports.length===1)return reports[0];const base={version:'14',matrix:true,years:reports.map(r=>r.year),generated:new Date().toISOString(),scope:'multi-year calendar-resolved certification matrix',days:{attempted:0,resolved:0,failed:0,properReady:0,exceptional:0,inherited:0},proper:{en:{expected:0,available:0,completeDates:0},fr:{expected:0,available:0,completeDates:0},missing:[],uniqueFormularies:[]},categories:{},fields:{},exceptional:{profiles:{},items:[]},commentary:{references:0,attempted:0,parseOrLoadFailures:0,en:{full:0,missing:0},fr:{integrated:0,psalmLevel:0,verseNotes:0,linkOnly:0,missing:0},items:[],failures:[],bySlot:{}},sources:{structuralInheritances:0,legacyCommonRecoveries:0,structuralExamples:[],legacyCommonExamples:[]},static:STATIC,supplementary:reports[0].supplementary,errors:[]};for(const n of CATEGORY_ORDER)base.categories[n]=blankCategory(n);const forms=new Map(),commentaryKeys=new Set();
 for(const r of reports){base.sources.structuralInheritances+=r.sources?.structuralInheritances||0;base.sources.legacyCommonRecoveries+=r.sources?.legacyCommonRecoveries||0;for(const x of (r.sources?.structuralExamples||[])){if(base.sources.structuralExamples.length<120)base.sources.structuralExamples.push({...x,year:r.year})}for(const x of (r.sources?.legacyCommonExamples||[])){if(base.sources.legacyCommonExamples.length<120)base.sources.legacyCommonExamples.push({...x,year:r.year})}for(const k of Object.keys(base.days))base.days[k]+=r.days[k]||0;for(const lang of ['en','fr'])for(const k of ['expected','available','completeDates'])base.proper[lang][k]+=r.proper[lang][k]||0;base.proper.missing.push(...r.proper.missing.map(x=>({...x,year:r.year})));r.proper.uniqueFormularies.forEach(x=>{const k=x.key||x.sourcePath||x.properId;if(!forms.has(k))forms.set(k,{...x,dates:[]});forms.get(k).dates.push(...x.dates)});base.errors.push(...r.errors.map(x=>({...x,year:r.year})));base.exceptional.items.push(...r.exceptional.items.map(x=>({...x,year:r.year})));for(const [k,v] of Object.entries(r.exceptional.profiles))base.exceptional.profiles[k]=(base.exceptional.profiles[k]||0)+v;
  for(const name of CATEGORY_ORDER){const a=base.categories[name],b=r.categories[name];a.days+=b.days;a.missing+=b.missing;b.formularies.forEach(x=>a.formularies.add(x));for(const lang of ['en','fr'])for(const k of ['expected','available','completeDates'])a[lang][k]+=b[lang][k]||0;for(const k of Object.keys(a.commentary))a.commentary[k]+=b.commentary[k]||0}
  for(const [field,b] of Object.entries(r.fields)){const a=base.fields[field]||(base.fields[field]=blankField(field));for(const lang of ['en','fr'])for(const k of ['expected','available','missing'])a[lang][k]+=b[lang][k]||0;b.dates.forEach(x=>a.dates.add(`${r.year}:${x}`))}
  base.commentary.attempted+=r.commentary.attempted;base.commentary.parseOrLoadFailures+=r.commentary.parseOrLoadFailures;base.commentary.failures.push(...r.commentary.failures.map(x=>({...x,year:r.year})));for(const lang of ['en'])for(const k of ['full','missing'])base.commentary[lang][k]+=r.commentary[lang][k]||0;for(const k of ['integrated','psalmLevel','verseNotes','linkOnly','missing'])base.commentary.fr[k]+=r.commentary.fr[k]||0;for(const [slot,b] of Object.entries(r.commentary.bySlot)){const a=base.commentary.bySlot[slot]||(base.commentary.bySlot[slot]={references:0,enFull:0,frIntegrated:0,frLinkOnly:0,frMissing:0});for(const k of Object.keys(a))a[k]+=b[k]||0}for(const x of r.commentary.items){const k=[x.slot,x.reference,x.en,x.fr,x.frScope].join('|');if(!commentaryKeys.has(k)){commentaryKeys.add(k);base.commentary.items.push({...x,years:[r.year]})}else{const hit=base.commentary.items.find(y=>[y.slot,y.reference,y.en,y.fr,y.frScope].join('|')===k);if(hit&&!hit.years.includes(r.year))hit.years.push(r.year)}} }
 base.proper.uniqueFormularies=[...forms.values()];base.commentary.references=base.commentary.items.length;for(const c of Object.values(base.categories))c.formularies=[...c.formularies];for(const f of Object.values(base.fields))f.dates=[...f.dates];return base}
function progress(r,msg){const o=document.getElementById('ao-content-audit-v14');if(!o)return;const bar=o.querySelector('[data-auditbar]'),st=o.querySelector('[data-auditstatus]');if(bar)bar.style.width=`${Math.round(Math.max(0,Math.min(1,r))*100)}%`;if(st)st.textContent=msg||''}
function badge(text,cls=''){return`<span class="aoAuditBadge ${cls}">${esc(text)}</span>`}
function categoryRows(r){return CATEGORY_ORDER.map(n=>{const c=r.categories[n],en=pct(c.en.available,c.en.expected),fr=pct(c.fr.available,c.fr.expected),fc=pct(c.commentary.frIntegrated,c.commentary.references);return`<tr><td><b>${esc(n)}</b></td><td>${c.days}</td><td>${c.formularies.length}</td><td>${en}%</td><td>${fr}%</td><td>${c.commentary.references?fc+'%':'—'}</td></tr>`}).join('')}
function fieldRows(r){return Object.entries(r.fields).map(([k,f])=>`<tr><td><b>${esc(FIELD_LABELS[k]||k)}</b></td><td>${f.en.available}/${f.en.expected}</td><td>${f.en.missing}</td><td>${f.fr.available}/${f.fr.expected}</td><td>${f.fr.missing}</td></tr>`).join('')}
function slotRows(r){return Object.entries(r.commentary.bySlot).sort((a,b)=>a[0].localeCompare(b[0])).map(([k,x])=>`<tr><td><b>${esc(FIELD_LABELS[k]||k)}</b></td><td>${x.references}</td><td>${pct(x.enFull,x.references)}%</td><td>${pct(x.frIntegrated,x.references)}%</td><td>${x.frLinkOnly}</td><td>${x.frMissing}</td></tr>`).join('')}
function renderSummary(r){const enp=pct(r.proper.en.available,r.proper.en.expected),frp=pct(r.proper.fr.available,r.proper.fr.expected),enC=pct(r.commentary.en.full,r.commentary.references),frC=pct(r.commentary.fr.integrated,r.commentary.references),src=r.sources||{structuralInheritances:0,legacyCommonRecoveries:0,structuralExamples:[],legacyCommonExamples:[]};return`<div class="aoAuditMatrix"><div class="aoAuditStat"><b>${enp}%</b><span>EN Proper fields</span></div><div class="aoAuditStat"><b>${frp}%</b><span>FR Proper fields</span></div><div class="aoAuditStat"><b>${enC}%</b><span>EN commentary</span></div><div class="aoAuditStat"><b>${frC}%</b><span>FR commentary</span></div><div class="aoAuditStat"><b>${r.proper.uniqueFormularies.length}</b><span>unique resolved formularies</span></div><div class="aoAuditStat"><b>${r.commentary.parseOrLoadFailures}</b><span>Scripture parse/load failures</span></div><div class="aoAuditStat"><b>${src.structuralInheritances}</b><span>vernacular structural inheritances</span></div><div class="aoAuditStat"><b>${src.legacyCommonRecoveries}</b><span>legacy Mass Common recoveries</span></div></div><section class="aoAuditSection"><h3>Certification scope</h3><div>${badge(`${r.days.properReady}/${r.days.attempted} calendar days`,r.days.failed?'warn':'ok')}${badge(`${r.days.exceptional} exceptional-day resolutions`)}${badge(`${r.days.inherited} inherited feria resolutions`)}${badge(r.matrix?`${r.years.length} test years`:`year ${r.year}`)}</div></section><section class="aoAuditSection"><h3>Source recovery provenance</h3><p class="aoAuditNote">Normalized Latin contributes reference structure only. Every inherited reference is resolved again in the requested language; literal Latin prose is never accepted as EN/FR completion.</p><div class="aoAuditMissing">${src.structuralExamples.slice(0,20).map(x=>`<article><b>${esc(x.date||'')} · ${esc((x.language||'').toUpperCase())} structural inheritance</b><small class="aoAuditMono">${esc(x.path||'')}</small><div>${esc((x.sections||[]).join(', '))}</div></article>`).join('')||'<article>No structural inheritance was needed in this run.</article>'}${src.legacyCommonExamples.slice(0,20).map(x=>`<article><b>${esc(x.date||'')} · ${esc((x.language||'').toUpperCase())} historical Mass Common</b><small class="aoAuditMono">${esc(x.path||'')}</small><div class="aoAuditMono">${esc(x.source||'')}</div></article>`).join('')}</div></section><section class="aoAuditSection"><h3>Calendar categories</h3><div class="aoAuditFieldGrid"><table class="aoAuditTable"><tr><th>Category</th><th>Days</th><th>Formularies</th><th>EN Proper</th><th>FR Proper</th><th>FR commentary</th></tr>${categoryRows(r)}</table></div></section><section class="aoAuditSection"><h3>Scope boundary</h3><div class="aoAuditScope"><article><b>General Calendar</b><span>The date resolver certifies the formularies actually selected by the 1962 General Roman Calendar, including collisions, commemorations, inherited ferias and exceptional days.</span></article><article><b>Commons</b><span>The normalized 1962 layer contains ${r.supplementary?.commune?.normalized1962Files||28} Common paths. v14 recovers them through genuine same-language sources in this order: current Mass tree, pinned historical Mass Commune, then same-language horas Mass sections. Structural inheritance from normalized Latin carries references only, never Latin prose. Runtime field coverage remains the controlling test.</span></article><article><b>Votive Masses</b><span>v15 enumerates the pinned normalized Votive family separately from the date audit. Each formulary is resolved in LA/EN/FR with the same fail-closed rules; missing vernacular literal sections remain visible gaps.</span></article><article><b>Requiem</b><span>v15 explicitly audits the three All Souls Masses plus the daily Requiem. The daily Requiem may recover from the pinned historical C9 Mass-of-the-Dead corpus in the same language.</span></article></div></section>`}
function renderFields(r){return`<section class="aoAuditSection"><h3>Proper fields</h3><p class="aoAuditNote">Counts are field occurrences on resolved dates; Latin presence defines whether a vernacular field is expected.</p><div class="aoAuditFieldGrid"><table class="aoAuditTable"><tr><th>Field</th><th>EN available</th><th>EN missing</th><th>FR available</th><th>FR missing</th></tr>${fieldRows(r)}</table></div></section><section class="aoAuditSection"><h3>Exact Proper gaps</h3><div class="aoAuditMissing">${r.proper.missing.slice(0,250).map(x=>`<article data-severity="red"><b>${esc(x.date)} · ${esc(x.category)} · ${esc(x.lang.toUpperCase())}</b><small class="aoAuditMono">${esc(x.sourcePath||x.properId)}</small><div>${esc((x.fields||[]).join(', '))}</div></article>`).join('')||'<article>No bilingual Proper-field gaps detected in this run.</article>'}</div></section>`}
function renderCommentary(r){return`<section class="aoAuditSection"><h3>Commentary by Proper slot</h3><div class="aoAuditFieldGrid"><table class="aoAuditTable"><tr><th>Slot</th><th>Refs</th><th>EN integrated</th><th>FR integrated</th><th>FR link</th><th>FR missing</th></tr>${slotRows(r)}</table></div></section><section class="aoAuditSection"><h3>Commentary gaps</h3><div class="aoAuditMissing">${r.commentary.items.filter(x=>x.en!=='full'||x.fr!=='integrated').slice(0,250).map(x=>`<article data-severity="${x.fr==='missing'||x.en==='missing'?'red':'amber'}"><b>${esc(x.reference||x.referenceFr||'Reference')}</b><small>${esc(FIELD_LABELS[x.slot]||x.slot)} · EN ${esc(x.en)} · FR ${esc(x.fr)}${x.frScope?' · '+esc(x.frScope):''}</small><div class="aoAuditMono">${esc((x.paths||[]).join(' · '))}</div></article>`).join('')||'<article>No integrated commentary gaps detected.</article>'}</div></section><section class="aoAuditSection"><h3>Unparsed / failed Scripture loads</h3><div class="aoAuditMissing">${r.commentary.failures.slice(0,200).map(x=>`<article data-severity="red"><b>${esc(FIELD_LABELS[x.slot]||x.slot)}</b><small>${esc((x.dates||[]).join(', '))}</small><div>${esc(x.error)}</div><div class="aoAuditMono">${esc((x.paths||[]).join(' · '))}</div></article>`).join('')||'<article>No Scripture parse/load failures recorded.</article>'}</div></section>`}
function renderExceptional(r){return`<section class="aoAuditSection"><h3>Exceptional rites encountered</h3><div>${Object.entries(r.exceptional.profiles).map(([k,v])=>badge(`${k}: ${v}`)).join('')||'None'}</div><div class="aoAuditMissing" style="margin-top:10px">${r.exceptional.items.slice(0,160).map(x=>`<article><b>${esc(x.date)} · ${esc(x.profile)}</b><small class="aoAuditMono">${esc(x.path)}</small><div>${esc(x.title)}</div></article>`).join('')||'<article>No exceptional rite profiles resolved.</article>'}</div></section>`}
function renderReport(r){lastReport=r;const o=document.getElementById('ao-content-audit-v14');if(!o)return;const box=o.querySelector('[data-auditresults]');const tabs=`<div class="aoAuditTabs">${[['summary','Summary'],['fields','Proper fields'],['commentary','Commentary'],['exceptional','Exceptional']].map(([id,l])=>`<button data-audittab="${id}" class="${activePanel===id?'active':''}">${l}</button>`).join('')}</div>`;const content=activePanel==='fields'?renderFields(r):activePanel==='commentary'?renderCommentary(r):activePanel==='exceptional'?renderExceptional(r):renderSummary(r);box.innerHTML=tabs+content;o.querySelectorAll('[data-audittab]').forEach(b=>b.onclick=()=>{activePanel=b.dataset.audittab;renderReport(lastReport)})}
function downloadJSON(){if(!lastReport)return;const blob=new Blob([JSON.stringify(lastReport,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);const tail=lastReport.supplementaryOnly?'source-inventory':lastReport.matrix?lastReport.years.join('-'):lastReport.year;a.download=`ad-orientem-v18-${lastReport.supplementaryOnly?'supplementary':lastReport.matrix?'matrix':'calendar'}-${tail}.json`;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
function downloadCSV(){if(!lastReport)return;if(lastReport.supplementaryOnly){const csv=supplementaryCSV(lastReport),blob=new Blob([csv],{type:'text/csv'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='ad-orientem-v18-supplementary-gaps.csv';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);return}const rows=[['kind','date','category','language','slot_or_reference','path','detail']];for(const x of lastReport.proper.missing)rows.push(['proper',x.date,x.category,x.lang,(x.fields||[]).join(';'),x.sourcePath||x.properId||'','missing']);for(const x of lastReport.commentary.items.filter(y=>y.en!=='full'||y.fr!=='integrated'))rows.push(['commentary',(x.dates||[]).join(';'),(x.categories||[]).join(';'),'EN='+x.en+' FR='+x.fr,x.reference||x.referenceFr||'',(x.paths||[]).join(';'),x.frScope||'']);for(const x of lastReport.commentary.failures)rows.push(['scripture-failure',(x.dates||[]).join(';'),'','',x.slot,(x.paths||[]).join(';'),x.error]);for(const x of (lastReport.sources?.structuralExamples||[]))rows.push(['structural-inheritance',x.date||'','',''+(x.language||''),(x.sections||[]).join(';'),x.path||'','normalized Latin references only; no Latin prose']);for(const x of (lastReport.sources?.legacyCommonExamples||[]))rows.push(['legacy-mass-recovery',x.date||'','',''+(x.language||''),'',x.path||'',x.source||'']);const csv=rows.map(r=>r.map(v=>`"${String(v??'').replace(/"/g,'""')}"`).join(',')).join('\n'),blob=new Blob([csv],{type:'text/csv'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='ad-orientem-v18-gap-list.csv';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
async function runSingle(year,verify){return auditYear(year,{verifyCommentary:verify,onProgress:progress})}
async function runMatrix(center,verify){const years=[center-2,center-1,center,center+1,center+2];const out=[];for(let i=0;i<years.length;i++){const y=years[i];progress(i/years.length,`Certification matrix · ${y} (${i+1}/${years.length})`);out.push(await auditYear(y,{verifyCommentary:verify,onProgress:(r,m)=>progress((i+r)/years.length,`${y} · ${m}`)}))}return mergeReports(out)}
const SUPPLEMENTARY_V15=[
 {id:'bvm-advent',path:'Commune/C10a',family:'Marian votive',label:'B.V.M. Saturday · Advent'},
 {id:'bvm-nativity',path:'Commune/C10b',family:'Marian votive',label:'B.V.M. Saturday · Nativity to Purification'},
 {id:'bvm-prelent',path:'Commune/C10c',family:'Marian votive',label:'B.V.M. Saturday · after Purification to Holy Week'},
 {id:'bvm-easter',path:'Commune/C10Pasc',family:'Marian votive',label:'B.V.M. Saturday · Eastertide'},
 {id:'bvm-trinity',path:'Commune/C10t',family:'Marian votive',label:'B.V.M. Saturday · after Trinity to Advent'},
 {id:'immaculate-heart',path:'Votive/08-22r',family:'Votive',label:'Immaculate Heart of the B.V.M.'},
 {id:'ad-vocationes',path:'Votive/AdVocationes',family:'Votive',label:'For vocations'},
 {id:'angels',path:'Votive/Angels',family:'Votive',label:'Of the Holy Angels'},
 {id:'apostles',path:'Votive/Apostles',family:'Votive',label:'Of all the Holy Apostles'},
 {id:'apostles-p',path:'Votive/ApostlesP',family:'Votive',label:'Of all the Holy Apostles · Eastertide'},
 {id:'blessed-sacrament',path:'Votive/BlessedSacrament',family:'Votive',label:'Of the Most Holy Sacrament'},
 {id:'cross',path:'Votive/Cross',family:'Votive',label:'Of the Holy Cross'},
 {id:'requiem-daily',path:'Votive/Defunctorum',family:'Requiem',label:'Daily Mass of the Dead'},
 {id:'faith-propagation',path:'Votive/FideiPropagatione',family:'Votive',label:'For the propagation of the Faith'},
 {id:'holy-spirit',path:'Votive/HolySpirit',family:'Votive',label:'Of the Holy Ghost'},
 {id:'holy-spirit-grace',path:'Votive/HolySpirit2',family:'Votive',label:'For the grace of the Holy Ghost'},
 {id:'eternal-priest',path:'Votive/JesusEternalPriest',family:'Votive',label:'Jesus Christ, Supreme and Eternal Priest'},
 {id:'joseph',path:'Votive/Joseph',family:'Votive',label:'Of St Joseph'},
 {id:'passion',path:'Votive/Passion',family:'Votive',label:'Of the Passion of Our Lord'},
 {id:'trinity',path:'Votive/Pent01-0r',family:'Votive',label:'Of the Most Holy Trinity'},
 {id:'sacred-heart',path:'Votive/Pent02-5',family:'Votive',label:'Of the Sacred Heart of Jesus'},
 {id:'peter-paul',path:'Votive/PeterPaul',family:'Votive',label:'Of Ss Peter and Paul'},
 {id:'peter-paul-p',path:'Votive/PeterPaulP',family:'Votive',label:'Of Ss Peter and Paul · Eastertide'},
 {id:'unity',path:'Votive/ProUnitateEcclesiae',family:'Votive',label:'For the unity of the Church'},
 {id:'pestilence',path:'Votive/TemporeMortalitatis',family:'Votive',label:'In time of pestilence / mortality'},
 {id:'dedication',path:'Votive/Terribilis',family:'Votive',label:'Dedication of a Church'},
 {id:'all-souls-1',path:'Sancti/11-02m1',family:'Requiem',label:'All Souls · First Mass'},
 {id:'all-souls-2',path:'Sancti/11-02m2',family:'Requiem',label:'All Souls · Second Mass'},
 {id:'all-souls-3',path:'Sancti/11-02m3',family:'Requiem',label:'All Souls · Third Mass'},
 {id:'matrimonium',path:'Votive/Matrimonium',family:'Votive',label:'Missa votiva pro sponsis / Nuptial Mass'}
];
function diagV15(){return{requestedFiles:[],cacheHits:[],referencesResolved:[],languageGaps:[],structuralInheritances:[],legacyCommonRecoveries:[],votiveRecoveries:[],warnings:[],errors:[]}}
function supplementTexts(p){const out=[];const add=(slot,v)=>{if(!v)return;if(Array.isArray(v)){v.forEach((x,i)=>add(`${slot}[${i+1}]`,x));return}if(typeof v==='object'){const lat=String(v.lat||'').trim();if(lat)out.push({slot,text:v})}};add('Introit',p.introit);add('Collect',p.collects);add('Epistle/Lesson',p.epistle);add('Gradual/Tract/Alleluia',p.gradual);add('Sequence',p.sequence);add('Gospel',p.gospel);add('Offertory',p.offertory);add('Secret',p.secrets);add('Communion',p.communion);add('Postcommunion',p.postcommunions);return out}
async function auditSupplementary(verifyCommentary=true){
 const rt=window.AO_RUNTIME_V8,pr=rt?.resolver?.properResolver;if(!pr)throw new Error('Proper resolver is not ready.');
 const report={version:'17',supplementaryOnly:true,generated:new Date().toISOString(),scope:'explicit non-calendar formularies',items:[],summary:{total:SUPPLEMENTARY_V15.length,resolved:0,unsupported:0,enComplete:0,frComplete:0,enExpected:0,enAvailable:0,frExpected:0,frAvailable:0},commentary:{attempted:0,enFull:0,frIntegrated:0,failures:[]},sourcePolicy:'same-language-only; normalized Latin may contribute references/Rule structure but never vernacular prose'};
 let i=0;
 for(const spec of SUPPLEMENTARY_V15){i++;progress(i/SUPPLEMENTARY_V15.length*.82,`Supplementary ${i}/${SUPPLEMENTARY_V15.length} · ${spec.label}`);if(!spec.path){report.summary.unsupported++;report.items.push({...spec,status:'unsupported',en:{expected:0,available:0,missing:['source formulary absent']},fr:{expected:0,available:0,missing:['source formulary absent']},diagnostic:{warnings:[spec.reason]}});continue}
  const d=diagV15();try{const meta={name:spec.label,nameFr:spec.label,rank:'supplementary',color:spec.family==='Requiem'?'black':'white',properId:`supplementary:${spec.id}`,path:spec.path,profile:spec.family==='Requiem'?'requiem_mass_1962':'ordinary_mass_1962',gloria:false,credo:false,inherited:false};const p=await pr.resolveProper(meta,d);report.summary.resolved++;const en=p.languageCoverage?.en||{expected:0,available:0,missing:[]},fr=p.languageCoverage?.fr||{expected:0,available:0,missing:[]};report.summary.enExpected+=en.expected||0;report.summary.enAvailable+=en.available||0;report.summary.frExpected+=fr.expected||0;report.summary.frAvailable+=fr.available||0;if(en.complete)report.summary.enComplete++;if(fr.complete)report.summary.frComplete++;const row={...spec,status:'resolved',sourcePath:p.sourcePath,en,fr,structuralInheritances:d.structuralInheritances||[],historicalCommonRecoveries:d.legacyCommonRecoveries||[],votiveRecoveries:d.votiveRecoveries||[],languageGaps:d.languageGaps||[],warnings:d.warnings||[],commentary:{references:0,enFull:0,frIntegrated:0,failures:[]}};
   if(verifyCommentary){for(const x of supplementTexts(p)){let doc;try{doc=await rt.scriptureService.load(x.slot==='Gospel'?'gospel':'scripture',x.text)}catch(e){row.commentary.failures.push({slot:x.slot,error:e instanceof Error?e.message:String(e)});continue}if(!doc?.reference&&!doc?.parts?.length)continue;const docs=doc.parts?.length?doc.parts:[doc];for(const part of docs){if(!part?.reference)continue;row.commentary.references++;report.commentary.attempted++;const enOk=part.reference.kind==='gospel'?!!part.englishCatena?.length:!!part.englishCommentary?.entries?.length||!!part.englishNotes?.length;const frOk=!!part.frenchCommentary?.entries?.length||!!part.frenchCatena?.length;if(enOk){row.commentary.enFull++;report.commentary.enFull++}if(frOk){row.commentary.frIntegrated++;report.commentary.frIntegrated++}}}report.commentary.failures.push(...row.commentary.failures.map(x=>({...x,id:spec.id,path:spec.path}))) }
   report.items.push(row)}catch(e){report.items.push({...spec,status:'error',error:e instanceof Error?e.message:String(e),en:{expected:0,available:0,missing:['resolution failed']},fr:{expected:0,available:0,missing:['resolution failed']},diagnostic:d});}
 }
 progress(.96,'Supplementary audit complete.');lastReport=report;return report
}
function suppPct(a,b){return b?Math.round(a/b*1000)/10:0}
function renderSupplementary(r){const o=document.getElementById('ao-content-audit-v14');if(!o)return;const box=o.querySelector('[data-auditresults]');const s=r.summary;const rows=r.items.map(x=>`<tr><td><b>${esc(x.label)}</b><small>${esc(x.family)}</small></td><td class="aoAuditMono">${esc(x.path||'—')}</td><td>${x.status==='unsupported'?badge('unsupported','bad'):badge(`${x.en.available}/${x.en.expected}`,x.en.complete?'ok':x.en.available?'warn':'bad')}<small>${esc((x.en.missing||[]).join(', '))}</small></td><td>${x.status==='unsupported'?badge('unsupported','bad'):badge(`${x.fr.available}/${x.fr.expected}`,x.fr.complete?'ok':x.fr.available?'warn':'bad')}<small>${esc((x.fr.missing||[]).join(', '))}</small></td><td>${x.commentary?`${x.commentary.frIntegrated}/${x.commentary.references}`:'—'}</td></tr>`).join('');box.innerHTML=`<div class="aoAuditSummary"><div class="aoAuditStat"><b>${suppPct(s.enAvailable,s.enExpected)}%</b><span>supplementary EN fields</span></div><div class="aoAuditStat"><b>${suppPct(s.frAvailable,s.frExpected)}%</b><span>supplementary FR fields</span></div><div class="aoAuditStat"><b>${s.enComplete}/${s.resolved}</b><span>EN complete formularies</span></div><div class="aoAuditStat"><b>${s.frComplete}/${s.resolved}</b><span>FR complete formularies</span></div></div><section class="aoAuditSection"><h3>Supplementary formularies</h3><p class="aoAuditNote">These rows are not certified by a date traversal. Missing vernacular sections stay red; Latin content is never relabelled as EN or FR. Daily Requiem may recover from the pinned same-language historical C9 Mass corpus.</p><div class="aoAuditFieldGrid"><table class="aoAuditTable"><tr><th>Formulary</th><th>Source</th><th>EN</th><th>FR</th><th>FR commentary</th></tr>${rows}</table></div></section>`}
function supplementaryCSV(r){const rows=[['family','label','path','status','en_available','en_expected','en_missing','fr_available','fr_expected','fr_missing','commentary_fr','commentary_refs','detail']];for(const x of r.items)rows.push([x.family,x.label,x.path||'',x.status,x.en?.available||0,x.en?.expected||0,(x.en?.missing||[]).join(';'),x.fr?.available||0,x.fr?.expected||0,(x.fr?.missing||[]).join(';'),x.commentary?.frIntegrated||0,x.commentary?.references||0,x.reason||x.error||'']);return rows.map(row=>row.map(v=>`"${String(v??'').replace(/"/g,'""')}"`).join(',')).join('\n')}
function open(){document.getElementById('ao-content-audit-v14')?.remove();document.getElementById('ao-content-audit-v8')?.remove();const lang=window.AO_RUNTIME_V8?.store?.getState?.().language||'en',fr=lang==='fr';const el=document.createElement('div');el.id='ao-content-audit-v14';el.className='aoAuditBackdrop';el.innerHTML=`<section class="aoAuditPanel" role="dialog" aria-modal="true"><header><div><span>Ad Orientem · v18</span><h2>${fr?'Certification du contenu':'Full-calendar certification'}</h2></div><button class="aoAuditClose" data-auditclose>×</button></header><p class="aoAuditNote">${fr?'Sépare la certification du calendrier général des formulaires supplémentaires qui ne sont pas sélectionnés par une date ordinaire.':'Separates General Calendar certification from supplementary formularies that cannot be certified by a date-only traversal.'}</p><div class="aoAuditControls"><input data-audityear type="number" min="1960" max="2100" value="${new Date().getFullYear()}"><button data-auditrun>${fr?'Auditer l’année':'Audit year'}</button></div><div class="aoAuditActions"><button data-auditmatrix>${fr?'Matrice 5 ans':'Run 5-year matrix'}</button><button data-auditsupp>${fr?'Formulaires supplémentaires':'Audit supplementary'}</button><label style="display:flex;align-items:center;gap:6px"><input type="checkbox" data-auditcommentary checked> ${fr?'Commentaires':'Commentary'}</label></div><div class="aoAuditProgress"><i data-auditbar></i></div><p data-auditstatus>${fr?'Prêt.':'Ready.'}</p><div data-auditresults>${renderSummary({days:{properReady:0,attempted:0,failed:0,exceptional:0,inherited:0},proper:{en:{expected:0,available:0},fr:{expected:0,available:0},uniqueFormularies:[]},commentary:{en:{full:0},fr:{integrated:0},references:0,parseOrLoadFailures:0},categories:Object.fromEntries(CATEGORY_ORDER.map(n=>[n,{days:0,formularies:[],en:{expected:0,available:0},fr:{expected:0,available:0},commentary:{references:0,frIntegrated:0}}])),matrix:false,year:new Date().getFullYear()})}</div><div class="aoAuditActions"><button data-auditdownload>JSON</button><button data-auditcsv>CSV gaps</button></div></section>`;document.body.appendChild(el);document.body.classList.add('aoAuditOpen');const close=()=>{if(!running){el.remove();document.body.classList.remove('aoAuditOpen')}};el.querySelector('[data-auditclose]').onclick=close;const execute=async matrix=>{if(running)return;running=true;el.querySelector('[data-auditrun]').disabled=true;el.querySelector('[data-auditmatrix]').disabled=true;el.querySelector('[data-auditsupp]').disabled=true;try{const y=Number(el.querySelector('[data-audityear]').value)||new Date().getFullYear(),verify=el.querySelector('[data-auditcommentary]').checked;const r=matrix?await runMatrix(y,verify):await runSingle(y,verify);activePanel='summary';renderReport(r);progress(1,'Audit complete.')}catch(e){el.querySelector('[data-auditstatus]').textContent=e instanceof Error?e.message:String(e)}finally{running=false;el.querySelector('[data-auditrun]').disabled=false;el.querySelector('[data-auditmatrix]').disabled=false;el.querySelector('[data-auditsupp]').disabled=false}};el.querySelector('[data-auditrun]').onclick=()=>execute(false);el.querySelector('[data-auditmatrix]').onclick=()=>execute(true);el.querySelector('[data-auditsupp]').onclick=async()=>{if(running)return;running=true;const b=el.querySelector('[data-auditsupp]');b.disabled=true;try{const r=await auditSupplementary(el.querySelector('[data-auditcommentary]').checked);renderSupplementary(r);progress(1,'Supplementary audit complete.')}catch(e){el.querySelector('[data-auditstatus]').textContent=e instanceof Error?e.message:String(e)}finally{running=false;b.disabled=false}};el.querySelector('[data-auditdownload]').onclick=downloadJSON;el.querySelector('[data-auditcsv]').onclick=downloadCSV}

window.AO_CONTENT_AUDIT_V18={open,auditYear,runMatrix,auditSupplementary,getLastReport:()=>lastReport,static:STATIC,supplementaryInventory:SUPPLEMENTARY_V15};window.AO_CONTENT_AUDIT_V17=window.AO_CONTENT_AUDIT_V18;window.AO_CONTENT_AUDIT_V16=window.AO_CONTENT_AUDIT_V18;window.AO_CONTENT_AUDIT_V15=window.AO_CONTENT_AUDIT_V18;window.AO_CONTENT_AUDIT_V14=window.AO_CONTENT_AUDIT_V18;window.AO_CONTENT_AUDIT_V8=window.AO_CONTENT_AUDIT_V18;
})();
</script>
<style id="ao-v9-guides-css">
.aoUseGuideCard{margin:0 18px 14px;padding:15px;border:1px solid var(--border,#29333d);border-radius:16px;background:var(--surface-2,#17212b);display:flex;align-items:center;justify-content:space-between;gap:14px;text-align:left;color:inherit}.aoUseGuideCard b{display:block;font-family:var(--font-display,serif);font-size:1rem}.aoUseGuideCard small{display:block;margin-top:4px;color:var(--muted,#9aa4ad);line-height:1.35}.aoUseGuideCard span:last-child{font-size:1.3rem}.aoGuideBackdrop{position:fixed;inset:0;z-index:12050;background:rgba(3,6,10,.86);backdrop-filter:blur(10px);display:flex;align-items:flex-end;justify-content:center}.aoGuideSheet{width:min(100%,760px);max-height:94dvh;overflow:auto;background:var(--surface-1,#111820);color:var(--text,#f4efe4);border:1px solid var(--border,#29333d);border-radius:24px 24px 0 0;padding:18px 18px calc(30px + env(safe-area-inset-bottom))}.aoGuideTop{position:sticky;top:-18px;z-index:2;margin:-18px -18px 14px;padding:15px 18px;background:color-mix(in srgb,var(--surface-1,#111820) 96%,transparent);border-bottom:1px solid var(--border,#29333d);display:flex;align-items:center;justify-content:space-between;gap:12px}.aoGuideTop button{width:42px;height:42px;border:1px solid var(--border,#29333d);border-radius:50%;background:transparent;color:inherit;font-size:1.4rem}.aoGuideHero{padding:8px 0 14px}.aoGuideHero small{color:var(--muted,#9aa4ad);text-transform:uppercase;letter-spacing:.1em}.aoGuideHero h1{font-family:var(--font-display,serif);margin:.35rem 0 .55rem}.aoGuideHero p{line-height:1.55;color:var(--muted,#b5bdc5)}.aoGuideSection{padding:14px 0;border-top:1px solid var(--border,#29333d)}.aoGuideSection h2{font-family:var(--font-display,serif);font-size:1.08rem;margin:0 0 7px}.aoGuideSection p{margin:0;line-height:1.58}.aoCueGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:10px}.aoCue{border:1px solid var(--border,#29333d);border-radius:12px;padding:10px}.aoCue b{display:block;font-size:.73rem;letter-spacing:.08em}.aoCue span{display:block;margin-top:4px;font-size:.82rem;color:var(--muted,#aeb6be);line-height:1.4}.compositePart{border-top:1px solid var(--border,#29333d);padding-top:14px;margin-top:14px}.compositePart:first-of-type{border-top:0}@media(max-width:520px){.aoCueGrid{grid-template-columns:1fr}}
.father.note p{line-height:1.58}
</style>
<script id="ao-v12-context-commentary-guides">
(()=>{'use strict';
window.AO_COMMENTARY_POLICY_V12={
 version:'12',
 routes:{
  en:{gospel:'Catena Aurea · Newman/Oxford',psalm:'St Robert Bellarmine · 1866; Haydock fallback',other:'Haydock Catholic Bible Commentary'},
  fr:{gospel:'Chaîne d’Or · Péronne 1868–1869 — integrated from Wikisource by chapter/verse markers',psalm:'Saint Augustin · Raulx 1864 — integrated at Psalm/discourse level; Bellarmin–Daras remains planned for verse-exact enrichment',other:'Glaire–Vigouroux 1905 — integrated verse-linked notes; Fillion remains planned enrichment where a safely mapped commentary transcription is available'}
 },
 rules:['same-language commentary only','no runtime machine translation','Péronne Wikisource chapter text is segmented only by explicit verse markers','Augustine/Raulx Psalm commentary is explicitly Psalm-level, not falsely verse-mapped','Glaire–Vigouroux notes are attached only to explicit verse-linked footnotes; chapter summaries enrich Context but do not count as verse commentary','external link does not count as integrated commentary','composite references are resolved passage-by-passage']
};
const GUIDE={
 en:{
  title:'How to use Ad Orientem at Mass',intro:'The app should help you follow the liturgy without turning the Mass into continuous screen-reading. Learn before or after Mass; during Mass, use the live guide as an orientation layer.',
  sections:[
   ['1 · Before Mass','Use Prepare for immediate preparation. Use Learn, Scripture Context and Commentary before Mass when you want to understand the day in depth. They are intentionally richer than the live screen.'],
   ['2 · Choose what you are following','“Follow what you hear” tracks the audible liturgy: the schola and everything the sacred ministers say or sing aloud. “Complete liturgical action” also follows silent and private priestly prayers and actions. The two modes answer different questions; neither changes the rite itself.'],
   ['3 · Read the cues','cues'],
   ['4 · Look up when the action matters','The screen is not meant to hold your eyes continuously. At elevations, the Gospel procession, incensations, Communion and other visually significant moments, LOOK cues deliberately direct attention back to the altar or ministers.'],
   ['5 · Expect simultaneous actions','At Sung and Solemn Mass the priest, ministers and schola often act at the same time. The choir may still be singing a Proper while the celebrant has moved ahead at the altar. Ad Orientem keeps those tracks distinct instead of forcing them into an artificial single sequence.'],
   ['6 · Low, Sung and Solemn Mass are not identical','Low Mass has no sung choir track. Missa cantata adds the sung Ordinary and Proper without the full deacon/subdeacon structure. Solemn Mass assigns proper actions to deacon, subdeacon and other ministers. The live guide changes its emphasis accordingly.'],
   ['7 · Rubric is not the same as local custom','Where congregational posture, responses or inherited practices vary legitimately, the app should label them as custom or participation guidance rather than presenting them as universal rubrics. The same applies to practices such as the second Confiteor before Communion.'],
   ['8 · Context and commentary are for understanding, not competing with worship','Open Reading when you need the appointed text, Context to see the surrounding chapter, and Commentary for historical Catholic exegesis. During Mass, use these only when genuinely helpful; the deeper reading is designed chiefly for before or after the liturgy.'],
   ['9 · After Mass','Use Thanksgiving after the final liturgical action rather than treating the Last Gospel or dismissal as the end of the app’s spiritual lifecycle. Prepare → Mass → Thanksgiving is the intended flow.']
  ],
  cues:{HEAR:'What is audibly being said or sung.',LOOK:'A moment when the visible liturgical action deserves your attention.',PRIEST:'What the celebrant is doing or praying, including actions not audible to the congregation.',YOU:'A response, posture or participation cue directed to the faithful; custom is labelled when it is not universal.'}
 },
 fr:{
  title:'Comment utiliser Ad Orientem à la Messe',intro:'L’application doit aider à suivre la liturgie sans transformer la Messe en lecture continue de l’écran. Apprenez avant ou après la Messe ; pendant la Messe, utilisez le guide en direct comme couche d’orientation.',
  sections:[
   ['1 · Avant la Messe','Utilisez Préparer pour la préparation immédiate. Utilisez Apprendre, le Contexte scripturaire et le Commentaire avant la Messe lorsque vous voulez comprendre le jour en profondeur. Ces modules sont volontairement plus riches que l’écran en direct.'],
   ['2 · Choisissez ce que vous suivez','« Suivre ce que vous entendez » suit la liturgie audible : la schola et tout ce que les ministres sacrés disent ou chantent à voix haute. « Action liturgique complète » suit aussi les prières et actions silencieuses ou privées du prêtre. Les deux modes répondent à des questions différentes ; aucun ne change le rite lui-même.'],
   ['3 · Lire les repères','cues'],
   ['4 · Levez les yeux quand l’action compte','L’écran n’est pas conçu pour retenir continuellement votre regard. Aux élévations, à la procession de l’Évangile, aux encensements, à la Communion et dans les autres moments visuellement importants, les repères LOOK ramènent délibérément l’attention vers l’autel ou les ministres.'],
   ['5 · Attendez-vous à des actions simultanées','À la Messe chantée et à la Messe solennelle, le prêtre, les ministres et la schola agissent souvent en même temps. Le chœur peut encore chanter un texte du Propre alors que le célébrant a déjà avancé à l’autel. Ad Orientem maintient ces lignes distinctes au lieu de les forcer dans une séquence artificiellement unique.'],
   ['6 · Messe basse, chantée et solennelle ne sont pas identiques','La Messe basse ne comporte pas de ligne chorale chantée. La Missa cantata ajoute l’Ordinaire et le Propre chantés sans toute la structure diacre/sous-diacre. La Messe solennelle attribue des actions propres au diacre, au sous-diacre et aux autres ministres. Le guide en direct adapte donc son accent.'],
   ['7 · Rubrique et coutume locale ne sont pas la même chose','Lorsque posture des fidèles, réponses ou pratiques héritées varient légitimement, l’application doit les identifier comme coutume ou conseil de participation au lieu de les présenter comme rubriques universelles. Il en va de même pour des usages comme le second Confiteor avant la Communion.'],
   ['8 · Contexte et commentaire servent à comprendre, non à concurrencer le culte','Ouvrez Lecture pour le texte prescrit, Contexte pour voir le chapitre environnant, et Commentaire pour l’exégèse catholique historique. Pendant la Messe, n’utilisez ces couches que lorsqu’elles aident réellement ; la lecture approfondie est conçue surtout pour avant ou après la liturgie.'],
   ['9 · Après la Messe','Utilisez l’Action de grâces après la dernière action liturgique au lieu de traiter le Dernier Évangile ou le renvoi comme la fin du cycle spirituel de l’application. Préparer → Messe → Action de grâces est le parcours voulu.']
  ],
  cues:{HEAR:'Ce qui est réellement dit ou chanté à voix audible.',LOOK:'Moment où l’action liturgique visible mérite votre attention.',PRIEST:'Ce que fait ou prie le célébrant, y compris ce qui n’est pas audible pour l’assemblée.',YOU:'Réponse, posture ou repère de participation adressé aux fidèles ; la coutume est signalée lorsqu’elle n’est pas universelle.'}
 }
};
function lang(){return document.querySelector('.aoLearnLang button.active')?.dataset.learnLang||document.querySelector('.homeScreen')?.dataset.homeLanguage||document.querySelector('.liveScreen')?.dataset.language||'en'}
function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]))}
function openGuide(){document.getElementById('ao-use-guide-v9')?.remove();const L=GUIDE[lang()==='fr'?'fr':'en'];const root=document.createElement('div');root.id='ao-use-guide-v9';root.className='aoGuideBackdrop';root.innerHTML=`<section class="aoGuideSheet" role="dialog" aria-modal="true"><header class="aoGuideTop"><div><small>Ad Orientem · guide</small><b>${esc(L.title)}</b></div><button data-guide-close aria-label="Close">×</button></header><div class="aoGuideHero"><small>${lang()==='fr'?'Pendant la Messe':'During Mass'}</small><h1>${esc(L.title)}</h1><p>${esc(L.intro)}</p></div>${L.sections.map(([h,p])=>`<section class="aoGuideSection"><h2>${esc(h)}</h2>${p==='cues'?`<div class="aoCueGrid">${Object.entries(L.cues).map(([k,v])=>`<div class="aoCue"><b>${esc(k)}</b><span>${esc(v)}</span></div>`).join('')}</div>`:`<p>${esc(p)}</p>`}</section>`).join('')}</section>`;document.body.appendChild(root);root.querySelector('[data-guide-close]').onclick=()=>root.remove();root.addEventListener('click',e=>{if(e.target===root)root.remove()})}
document.addEventListener('click',e=>{if(e.target?.closest?.('[data-open-ao-use-guide]')){e.preventDefault();openGuide()}},true);
window.AO_USE_GUIDE_V9={open:openGuide,data:GUIDE};
})();
</script>
<script>window.AO_COMPLETION_V12={version:'12',compositeScripture:true,fixedMeaningCoverage:'118/118',fixedSourceCoverage:'118/118',liveUseGuide:true,frenchGospelCommentaryIntegrated:true,frenchPsalmCommentaryIntegrated:'psalm-level',frenchOtherCommentaryIntegrated:'verse-notes where present',notes:'Péronne French Gospel commentary is network-backed and verse-ranged through Wikisource. Augustine/Raulx French Psalm commentary is integrated at Psalm/discourse level and explicitly not represented as verse-exact. French non-Gospel commentary remains fail-closed until Fillion or another verified historical corpus is ingested.'};</script>

<script id="ao-v14-certification-meta">
window.AO_COMPLETION_V18={version:'18',calendarCertification:true,categoryMatrix:true,fieldMatrix:true,commentarySlotMatrix:true,unparsedScriptureGate:true,fiveYearCertificationMatrix:true,commonStructuralInheritance:true,legacyCommonMassRecovery:true,failClosedCrossLanguage:true,scopeBoundary:{generalCalendar:'auditable',commons:'same-language recovered + audit-visible',votive:'explicit supplementary audit',requiem:'daily Requiem + three All Souls Masses explicitly audited'},note:'A date traversal is not treated as proof of completeness for non-calendar votive/other supplementary formularies. Latin normalized structure may be inherited, but Latin prose is never counted or rendered as EN/FR. v16 adds the sourced Missa pro Sponsis corpus; v17 adds pinned same-language recovery for Blessed Sacrament, Holy Spirit, and both All-Apostles formularies; v18 fully recovers both Ss Peter-and-Paul votive forms from exact same-language historical sources and adds exact-source partial recovery for Holy Cross while leaving its genuinely votive-specific unsourced prayers fail-closed.'};window.AO_COMPLETION_V17=window.AO_COMPLETION_V18;window.AO_COMPLETION_V16=window.AO_COMPLETION_V18;window.AO_COMPLETION_V15=window.AO_COMPLETION_V18;
</script>


<script id="ao-v14-common-recovery-meta">
window.AO_COMMON_RECOVERY_V15={version:'15',policy:'same-language-only; structural Latin inheritance without Latin prose',sourceRevision:'126a07f91ede04664108abb6fb20ace3f4de14b9',normalizedCommons:28,legacyMassCommonFiles:{la:48,en:40,fr:47},recoveryOrder:['current missa','pinned obsolete/missa Commune','horas same-language'],specialCase:'French C7a has no legacy Mass file; current same-language horas supplies its Mass sections and normalized Latin contributes only missing reference structure.',normalizedSourceAddressability:{la:'28/28',en:'28/28',fr:'28/28'}};
</script>

<script id="ao-v15-supplementary-meta">
window.AO_SUPPLEMENTARY_V21={version:'21',normalizedVotiveFiles:21,seasonalMarianVotives:5,allSoulsMasses:3,dailyRequiem:true,nuptialMass:true,explicitUnsupported:[],dailyRequiemRecovery:'pinned obsolete/missa same-language Commune/C9',nuptialSource:'sourced supplementary Missa pro Sponsis corpus; LA/EN traditional Nuptial Mass and public-domain FR missal',votiveRecovery:'v17 Blessed Sacrament/Holy Spirit/All Apostles; v18 Ss Peter and Paul complete plus exact-source Holy Cross partial recovery; v19 English HolySpirit2 and French St Joseph complete; v20 source-level English residual closure for Holy Cross, Propagation, Passion and Unity; v21 source-level French closure for Vocations, Angels, Holy Cross, Propagation, Eternal Priest, Passion, Trinity, Unity and Pestilence/Mortality',policy:'same-language only; Latin structure may guide resolution but Latin prose never counts as vernacular'};window.AO_SUPPLEMENTARY_V20=window.AO_SUPPLEMENTARY_V21;window.AO_SUPPLEMENTARY_V19=window.AO_SUPPLEMENTARY_V21;window.AO_SUPPLEMENTARY_V18=window.AO_SUPPLEMENTARY_V21;window.AO_SUPPLEMENTARY_V17=window.AO_SUPPLEMENTARY_V21;window.AO_SUPPLEMENTARY_V16=window.AO_SUPPLEMENTARY_V21;window.AO_SUPPLEMENTARY_V15=window.AO_SUPPLEMENTARY_V21;
</script>

<style id="ao-celebration-architecture-v1">
/* Ad Orientem Celebration Architecture Prototype v1 */
.aoCelebrationControl{margin:0 0 14px;padding:13px 14px;border:1px solid var(--liturgical-border);border-radius:15px;background:linear-gradient(145deg,var(--liturgical-soft),rgba(255,255,255,.025));display:flex;align-items:center;gap:12px}.aoCelebrationControl .copy{min-width:0;flex:1}.aoCelebrationControl small{display:block;color:var(--liturgical);font:600 .65rem/1.2 var(--font-display);letter-spacing:.1em;text-transform:uppercase}.aoCelebrationControl b{display:block;margin-top:5px;font-family:var(--font-display);font-size:1rem;line-height:1.25}.aoCelebrationControl p{margin:5px 0 0;color:var(--muted);font-size:.78rem;line-height:1.35}.aoCelebrationControl button{flex:none;border:1px solid var(--liturgical-border);background:var(--surface-1);color:var(--text);border-radius:999px;padding:9px 12px;font:600 .72rem/1 system-ui,sans-serif}.aoAltCalendar{margin-top:9px;padding-top:9px;border-top:1px solid var(--border);color:var(--muted-2)!important}.aoMassFlowBackdrop{position:fixed;inset:0;z-index:14000;background:rgba(3,5,8,.82);backdrop-filter:blur(14px);display:flex;justify-content:center;align-items:flex-end}.aoMassFlow{width:min(100%,720px);max-height:min(92dvh,900px);overflow:auto;overscroll-behavior:contain;background:var(--bg);border:1px solid var(--border);border-bottom:0;border-radius:22px 22px 0 0;box-shadow:0 -24px 70px rgba(0,0,0,.42);padding-bottom:max(18px,var(--safe-bottom))}.aoMassFlowTop{position:sticky;top:0;z-index:4;display:grid;grid-template-columns:44px 1fr 44px;align-items:center;gap:8px;padding:calc(12px + var(--safe-top)) 12px 11px;background:color-mix(in srgb,var(--bg) 94%,transparent);backdrop-filter:blur(16px);border-bottom:1px solid var(--border)}.aoMassFlowTop button{height:40px;border:1px solid var(--border);background:var(--surface-1);color:var(--text);border-radius:999px}.aoMassFlowTop .title{text-align:center;min-width:0}.aoMassFlowTop small{display:block;color:var(--liturgical);font:600 .62rem/1.2 var(--font-display);letter-spacing:.11em;text-transform:uppercase}.aoMassFlowTop b{display:block;margin-top:3px;font-family:var(--font-display);font-size:1rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.aoMassFlowBody{padding:18px 15px 26px}.aoFlowLead{margin:0 0 14px;color:var(--muted);font-size:.9rem;line-height:1.5}.aoFlowOptions{display:grid;gap:9px}.aoFlowOption,.aoVotiveItem,.aoCircumstance{width:100%;border:1px solid var(--border);border-radius:14px;background:var(--surface-1);color:var(--text);padding:13px 14px;text-align:left;display:grid;grid-template-columns:1fr auto;gap:8px;align-items:center}.aoFlowOption:hover,.aoVotiveItem:hover,.aoCircumstance:hover{border-color:var(--liturgical-border);background:var(--liturgical-soft)}.aoFlowOption b,.aoVotiveItem b,.aoCircumstance b{font-family:var(--font-display);font-size:.95rem}.aoFlowOption span,.aoVotiveItem span,.aoCircumstance span{display:block;margin-top:3px;color:var(--muted);font-size:.77rem;line-height:1.35}.aoFlowOption i,.aoVotiveItem i,.aoCircumstance i{font-style:normal;color:var(--liturgical);font-size:1.1rem}.aoFlowOption.disabled{opacity:.48;pointer-events:none}.aoFlowSection{margin:22px 0 9px;color:var(--liturgical);font:600 .67rem/1.2 var(--font-display);letter-spacing:.11em;text-transform:uppercase}.aoFlowSearch{width:100%;height:44px;border:1px solid var(--border);border-radius:12px;background:var(--surface-1);color:var(--text);padding:0 13px;font:inherit;outline:none}.aoFlowSearch:focus{border-color:var(--liturgical-border);box-shadow:0 0 0 3px var(--liturgical-soft)}.aoVotiveGroups{margin-top:10px}.aoVotiveGroup{margin:17px 0}.aoVotiveGroup h3{margin:0 0 7px;color:var(--muted-2);font:600 .66rem/1.2 var(--font-display);letter-spacing:.1em;text-transform:uppercase}.aoVotiveGroup .aoVotiveItem{margin-bottom:7px}.aoPreflightHero{padding:17px;border:1px solid var(--liturgical-border);border-radius:17px;background:var(--liturgical-soft);text-align:center}.aoPreflightHero small{color:var(--liturgical);font:600 .65rem/1.2 var(--font-display);letter-spacing:.1em;text-transform:uppercase}.aoPreflightHero h2{margin:7px 0 4px;font-family:var(--font-display);font-weight:600;font-size:1.35rem}.aoPreflightHero p{margin:0;color:var(--muted);font-size:.8rem}.aoCalendarContext{margin:10px 0 0;padding:10px 12px;border:1px solid var(--border);border-radius:12px;color:var(--muted);font-size:.8rem;line-height:1.4}.aoRubricStatus{margin:13px 0;padding:12px 13px;border-radius:13px;border:1px solid var(--border);display:flex;gap:10px;align-items:flex-start}.aoRubricStatus strong{display:block;font-size:.84rem}.aoRubricStatus p{margin:3px 0 0;color:var(--muted);font-size:.77rem;line-height:1.4}.aoRubricStatus.ok{border-color:color-mix(in srgb,#6fa67c 55%,var(--border));background:color-mix(in srgb,#6fa67c 11%,transparent)}.aoRubricStatus.warn{border-color:color-mix(in srgb,#c49a57 55%,var(--border));background:color-mix(in srgb,#c49a57 11%,transparent)}.aoRubricStatus.bad{border-color:color-mix(in srgb,#b66368 55%,var(--border));background:color-mix(in srgb,#b66368 11%,transparent)}.aoWhyRubric{border:1px solid var(--border);border-radius:12px;background:var(--surface-1);padding:0 12px}.aoWhyRubric summary{cursor:pointer;padding:10px 0;color:var(--muted-2);font-size:.78rem}.aoWhyRubric div{padding:0 0 11px;color:var(--muted);font-size:.77rem;line-height:1.45}.aoWhyRubric code{display:block;margin-top:7px;color:var(--muted-2);font-size:.7rem;white-space:normal}.aoChoiceGrid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.aoChoiceGrid button{border:1px solid var(--border);border-radius:13px;background:var(--surface-1);color:var(--text);padding:12px 9px;min-height:76px}.aoChoiceGrid button.active{border-color:var(--liturgical-border);background:var(--liturgical-soft)}.aoChoiceGrid b{display:block;font-family:var(--font-display);font-size:.9rem}.aoChoiceGrid small{display:block;margin-top:5px;color:var(--muted);line-height:1.3}.aoReadiness{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.aoReadyCell{border:1px solid var(--border);border-radius:12px;background:var(--surface-1);padding:10px;text-align:center}.aoReadyCell b{display:block;font-size:.8rem}.aoReadyCell span{display:block;margin-top:4px;color:var(--muted);font-size:.7rem}.aoReadyCell.good{border-color:color-mix(in srgb,#6fa67c 48%,var(--border))}.aoReadyCell.partial{border-color:color-mix(in srgb,#c49a57 48%,var(--border))}.aoReadyCell.bad{border-color:color-mix(in srgb,#b66368 48%,var(--border))}.aoFlowActions{display:grid;gap:8px;margin-top:18px}.aoFlowActions button{min-height:46px;border-radius:13px;border:1px solid var(--border);background:var(--surface-1);color:var(--text);font-weight:650}.aoFlowActions button.primary{border-color:var(--liturgical-border);background:var(--liturgical);color:#0b0d11}.aoFlowActions button:disabled{opacity:.45}.aoPrototypeNote{margin-top:12px;color:var(--muted);font-size:.72rem;line-height:1.45}.aoDetailsGrid{display:grid;gap:8px}.aoDetailsGrid article{border:1px solid var(--border);border-radius:12px;background:var(--surface-1);padding:11px 12px}.aoDetailsGrid article b{display:block;color:var(--liturgical);font:600 .67rem/1.2 var(--font-display);letter-spacing:.08em;text-transform:uppercase}.aoDetailsGrid article p{margin:6px 0 0;color:var(--text);font-size:.86rem;line-height:1.45}.aoFlowLoading{padding:14px;border:1px dashed var(--border);border-radius:12px;color:var(--muted);font-size:.8rem;text-align:center}.aoTinyBadge{display:inline-flex;align-items:center;border:1px solid var(--border);border-radius:999px;padding:4px 7px;font-size:.66rem;color:var(--muted-2);margin:2px 3px 2px 0}.aoArchitectureState{margin-top:16px;padding:12px;border:1px dashed var(--border);border-radius:12px;color:var(--muted);font-size:.72rem;line-height:1.45}.aoArchitectureState b{color:var(--muted-2)}
@media(max-width:430px){.aoMassFlow{max-height:96dvh}.aoMassFlowBody{padding-left:12px;padding-right:12px}.aoChoiceGrid{grid-template-columns:1fr 1fr}.aoReadiness{grid-template-columns:1fr 1fr 1fr}.aoCelebrationControl{padding:11px 12px}}

</style>

<style id="ao-rubrical-resolver-v2-style">
.aoBasisGrid{grid-template-columns:1fr!important}.aoBasisGrid button{text-align:left;align-items:flex-start}.aoConditionGrid{display:grid;gap:8px;padding:12px 0}.aoConditionToggle{display:flex;justify-content:space-between;gap:14px;align-items:center;width:100%;text-align:left;padding:12px 14px;border-radius:14px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.035);color:inherit}.aoConditionToggle span{display:grid;gap:4px}.aoConditionToggle small{opacity:.7;line-height:1.35}.aoConditionToggle i{font-style:normal;font-size:1.05rem}.aoConditionToggle.active{border-color:var(--liturgical-accent,#b89a62);background:rgba(255,255,255,.075)}.aoRubricEffects{display:grid;gap:10px;margin:12px 0}.aoEffectChips{display:flex;flex-wrap:wrap;gap:7px}.aoEffectChips span{font-size:.76rem;padding:6px 9px;border-radius:999px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.045)}.aoEffectList{padding:12px 14px;border:1px solid rgba(255,255,255,.09);border-radius:14px;background:rgba(255,255,255,.025)}.aoEffectList ul{margin:8px 0 0;padding-left:20px}.aoEffectList li+li{margin-top:5px}
</style>
<script id="ao-celebration-architecture-v1-js">
(function(){
'use strict';
const VERSION='ARCH-RUBRICAL-2.1';
const GROUPS={
 lord:{en:'Our Lord & the Holy Trinity',fr:'Notre-Seigneur et la Sainte Trinité'},
 spirit:{en:'Holy Ghost',fr:'Saint-Esprit'},
 mary:{en:'Our Lady',fr:'Notre-Dame'},
 saints:{en:'Angels & Saints',fr:'Anges et saints'},
 needs:{en:'The Church & particular needs',fr:'Église et besoins particuliers'}
};
const CATALOGUE={
 trinity:{type:'votive',group:'lord',title:{en:'Most Holy Trinity',fr:'Très Sainte Trinité'},path:'Votive/Pent01-0r',colour:'White'},
 blessed_sacrament:{type:'votive',group:'lord',title:{en:'Blessed Sacrament',fr:'Très Saint-Sacrement'},path:'Votive/BlessedSacrament',colour:'White'},
 sacred_heart:{type:'votive',group:'lord',title:{en:'Sacred Heart of Jesus',fr:'Sacré-Cœur de Jésus'},path:'Votive/Pent02-5',colour:'White'},
 holy_cross:{type:'votive',group:'lord',title:{en:'Holy Cross',fr:'Sainte Croix'},path:'Votive/Cross',colour:'Red'},
 passion:{type:'votive',group:'lord',title:{en:'Passion of Our Lord',fr:'Passion de Notre-Seigneur'},path:'Votive/Passion',colour:'Red'},
 eternal_priest:{type:'votive',group:'lord',title:{en:'Jesus Christ, Supreme and Eternal Priest',fr:'Jésus-Christ, Souverain et Éternel Prêtre'},path:'Votive/JesusEternalPriest',colour:'White'},
 holy_ghost:{type:'votive',group:'spirit',title:{en:'Mass of the Holy Ghost',fr:'Messe du Saint-Esprit'},path:'Votive/HolySpirit',colour:'Red'},
 grace_holy_ghost:{type:'votive',group:'spirit',title:{en:'For the grace of the Holy Ghost',fr:'Pour obtenir la grâce du Saint-Esprit'},path:'Votive/HolySpirit2',colour:'Red'},
 saturday_bvm:{type:'votive',group:'mary',title:{en:'Saturday Mass of Our Lady',fr:'Messe de la Sainte Vierge le samedi'},pathResolver:'bvm',colour:'White'},
 immaculate_heart:{type:'votive',group:'mary',title:{en:'Immaculate Heart of Mary',fr:'Cœur Immaculé de Marie'},path:'Votive/08-22r',colour:'White'},
 angels:{type:'votive',group:'saints',title:{en:'Holy Angels',fr:'Saints Anges'},path:'Votive/Angels',colour:'White'},
 joseph:{type:'votive',group:'saints',title:{en:'St Joseph',fr:'Saint Joseph'},path:'Votive/Joseph',colour:'White'},
 apostles:{type:'votive',group:'saints',title:{en:'All the Holy Apostles',fr:'Tous les saints Apôtres'},pathResolver:'apostles',colour:'Red'},
 peter_paul:{type:'votive',group:'saints',title:{en:'Ss Peter and Paul',fr:'Saints Pierre et Paul'},pathResolver:'peterPaul',colour:'Red'},
 vocations:{type:'votive',group:'needs',title:{en:'For Vocations',fr:'Pour les vocations'},path:'Votive/AdVocationes',colour:'White'},
 faith:{type:'votive',group:'needs',title:{en:'Propagation of the Faith',fr:'Propagation de la Foi'},path:'Votive/FideiPropagatione',colour:'White'},
 unity:{type:'votive',group:'needs',title:{en:'Unity of the Church',fr:"Unité de l'Église"},path:'Votive/ProUnitateEcclesiae',colour:'White'},
 pestilence:{type:'votive',group:'needs',title:{en:'Time of Pestilence / Mortality',fr:'Temps de peste / mortalité'},path:'Votive/TemporeMortalitatis',colour:'Violet'},
 dedication:{type:'votive',group:'needs',title:{en:'Dedication of a Church',fr:"Dédicace d'une église"},path:'Votive/Terribilis',colour:'White'},
 nuptial:{type:'nuptial',title:{en:'Nuptial Mass · Missa pro Sponso et Sponsa',fr:'Messe nuptiale · Missa pro Sponso et Sponsa'},path:'Votive/Matrimonium',colour:'White'},
 requiem:{type:'requiem',title:{en:'Mass for the Dead',fr:'Messe des défunts'},path:'Votive/Defunctorum',colour:'Black'}
};
const REQUIEM_CIRCUMSTANCES={
 funeral:{en:'Funeral Mass',fr:'Messe de funérailles'},
 death:{en:'Day of death',fr:'Jour du décès'},
 burial:{en:'Final burial / interment',fr:'Inhumation définitive'},
 news:{en:'After news of death',fr:'Après réception de la nouvelle du décès'},
 days:{en:'3rd, 7th or 30th day',fr:'3e, 7e ou 30e jour'},
 anniversary:{en:'Anniversary',fr:'Anniversaire'},
 cemetery:{en:'Cemetery church / chapel',fr:'Église / chapelle de cimetière'},
 all_souls_octave:{en:'Within eight days from All Souls',fr:'Dans les huit jours à partir de la Commémoration des fidèles défunts'},
 ordinary:{en:'Ordinary Mass for the Dead',fr:'Messe ordinaire pour les défunts'}
};
const ARCH={
 version:VERSION,
 liturgicalDay:null,
 actualCelebration:{id:'mass_of_day',type:'calendar'},
 celebrationForm:'sung',
 followMode:'vox',
 readiness:null,
 resolvedProper:null,
 rubric:null,
 date:null,
 stage:null,
 history:[],
 search:'',
 requiemCircumstance:null,
 votiveBasis:'ordinary',
 rubricContext:{
  couplePresent:true,
  bridePreviouslyBlessed:false,
  groomPreviouslyBlessed:false,
  groomOnlyCustomAllowsBlessing:false,
  mixedMarriage:false,
  closedTimePermission:false,
  exposition:false,
  conventualConflict:false,
  onlyMassWithCandleBlessing:false,
  onlyMassWithAshes:false,
  rogationMassRequired:false,
  holyDayOfObligation:false,
  localFuneralImpediment:false
 },
 lastResolveToken:0
};
window.AO_CELEBRATION_CATALOGUE=CATALOGUE;
window.AO_CELEBRATION_ARCH_V1=ARCH;
function rt(){return window.AO_RUNTIME_V8||null}
function core(){return rt()?.store?.getState?.()||null}
function lang(){return core()?.language==='fr'?'fr':'en'}
function L(en,fr){return lang()==='fr'?fr:en}
function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]))}
function isoDate(){return core()?.selectedDate||new Date().toISOString().slice(0,10)}
function calendarTitle(s=core()){const d=s?.resolution?.day,p=s?.resolution?.proper?.status==='ready'?s.resolution.proper.data:null;return (lang()==='fr'?(p?.nameFr||p?.name||d?.main?.title):(p?.name||d?.main?.title))||L('Mass of the Day','Messe du jour')}
function calendarRank(s=core()){const d=s?.resolution?.day,p=s?.resolution?.proper?.status==='ready'?s.resolution.proper.data:null;return p?.rank||d?.main?.rank||''}
function calendarColour(s=core()){const d=s?.resolution?.day;return s?.resolution?.colourPlan?.label||d?.main?.color||''}
function calendarPath(s=core()){const p=s?.resolution?.proper?.status==='ready'?s.resolution.proper.data:null;return p?.sourcePath||p?.path||s?.resolution?.day?.main?.path||''}
function liturgicalDayObject(s=core()){return {date:s?.selectedDate||'',title:calendarTitle(s),rank:calendarRank(s),colour:calendarColour(s),proper:calendarPath(s),raw:s?.resolution?.day||null}}
function isPaschal(s=core()){const id=String(s?.resolution?.day?.tempora?.[0]?.id||'');return /^tempora:Pasc/i.test(id)||/^Pasc/i.test(id)}
function pathFor(def,s=core()){
 if(!def)return null;if(def.path)return def.path;
 if(def.pathResolver==='apostles')return isPaschal(s)?'Votive/ApostlesP':'Votive/Apostles';
 if(def.pathResolver==='peterPaul')return isPaschal(s)?'Votive/PeterPaulP':'Votive/PeterPaul';
 if(def.pathResolver==='bvm'){
  const id=String(s?.resolution?.day?.tempora?.[0]?.id||'');const d=new Date(`${s?.selectedDate||isoDate()}T12:00:00`);const m=d.getMonth()+1,day=d.getDate();
  if(/^tempora:Adv/i.test(id))return 'Commune/C10a';
  if(isPaschal(s))return 'Commune/C10Pasc';
  if((m===12&&day>=25)||m===1||(m===2&&day<=2))return 'Commune/C10b';
  if(/^tempora:(Quad|Sept|Sexa|Quinq)/i.test(id)||(m>=2&&m<=4))return 'Commune/C10c';
  return 'Commune/C10t';
 }
 return null;
}
function actualDef(){if(ARCH.actualCelebration.id==='mass_of_day')return null;return CATALOGUE[ARCH.actualCelebration.id]||null}
function actualTitle(){const def=actualDef();return def?def.title[lang()]||def.title.en:calendarTitle()}
function actualType(){const def=actualDef();return def?.type||'calendar'}
function actualPath(){const def=actualDef();return def?pathFor(def):calendarPath()}
function normalizeRank(v){const s=String(v||'').toUpperCase();const m=s.match(/\b([IVX]+|[1-4])\b/);if(!m)return null;const x=m[1];if(/^\d$/.test(x))return Number(x);return {I:1,II:2,III:3,IV:4}[x]||null}
function selectedDateObject(){const raw=isoDate();const d=new Date(`${raw}T12:00:00`);return Number.isNaN(d.getTime())?new Date():d}
function dayFacts(){
 const s=core(),d=selectedDateObject(),day=ARCH.liturgicalDay||liturgicalDayObject(s),path=String(day.proper||calendarPath(s)||''),title=String(day.title||calendarTitle(s)||''),rank=normalizeRank(day.rank),profile=typeof riteProfileFor==='function'?riteProfileFor(path,s?.resolution?.proper?.status==='ready'?s.resolution.proper.data:null):'';
 return {date:d,iso:isoDate(),day,path,title,rank,profile,isSunday:d.getDay()===0,isSaturday:d.getDay()===6,isFriday:d.getDay()===5,isThursday:d.getDay()===4,month:d.getMonth()+1,dom:d.getDate()};
}
function textHas(f,re){return re.test(`${f.title} ${f.path} ${f.profile}`)}
function isAllSouls(f=dayFacts()){return (f.month===11&&f.dom===2)||/^Sancti\/11-02/i.test(f.path)||textHas(f,/All Souls|Fidelium defunctorum|fidèles défunts/i)}
function isTriduum(f=dayFacts()){return ['holy_thursday_1962','good_friday_1962','easter_vigil_1962'].includes(f.profile)||['Tempora/Quad6-4','Tempora/Quad6-5','Tempora/Quad6-6'].includes(f.path)}
function isAshWednesday(f=dayFacts()){return f.profile==='ash_wednesday_1962'||f.path==='Tempora/Quadp3-3'||textHas(f,/Ash Wednesday|Mercredi des Cendres/i)}
function isCandlemas(f=dayFacts()){return f.profile==='candlemas_1962'||f.path==='Sancti/02-02'||textHas(f,/Purification|Candlemas|Chandeleur/i)}
function isChristmasSeason(f=dayFacts()){return (f.month===12&&f.dom>=25)||(f.month===1&&f.dom<=13)}
function isTempusClausum(f=dayFacts()){
 if(isTriduum(f))return true;
 if(/^Tempora\/Adv/i.test(f.path)||(f.month===12&&f.dom===25))return true;
 if(/^Tempora\/Quad/i.test(f.path)||isAshWednesday(f)||textHas(f,/Lent|Passiontide|Carême|Passion/i))return true;
 if(f.isSunday&&textHas(f,/Easter Sunday|Dominica Resurrectionis|Pâques/i))return true;
 return false;
}
function isFirstFriday(f=dayFacts()){return f.isFriday&&f.dom<=7}
function isFirstSaturday(f=dayFacts()){return f.isSaturday&&f.dom<=7}
function isFirstThursday(f=dayFacts()){return f.isThursday&&f.dom<=7}
function isOctaveDay(f=dayFacts()){return textHas(f,/octave/i)||/^Tempora\/(Pasc0|Pasc7|Nat)/i.test(f.path)}
function isFeriaIV(f=dayFacts()){return f.rank===4&&/^Tempora\//i.test(f.path)&&!textHas(f,/Saturday Office|Officium B\.?.?M\.?.?|Sainte Vierge le samedi/i)}
function isHolyWeekMonWed(f=dayFacts()){
 return f.rank===1&&(/^Tempora\/Quad6-[123]$/i.test(f.path)||textHas(f,/Monday|Tuesday|Wednesday of Holy Week|Lundi|Mardi|Mercredi de la Semaine Sainte/i));
}
function precedenceSlot(f=dayFacts()){
 if((f.month===12&&f.dom===25)||textHas(f,/Christmas Day|Nativity of the Lord|Noël/i)||textHas(f,/Easter Sunday|Pentecost|Whit Sunday|Pâques|Pentecôte/i))return 1;
 if(isTriduum(f))return 2;
 if((f.month===1&&f.dom===6)||textHas(f,/Epiphany|Ascension|Blessed Trinity|Most Holy Trinity|Corpus Christi|Sacred Heart|Christ the King|Épiphanie|Ascension|Trinité|Saint-Sacrement|Sacré-Cœur|Christ Roi/i))return 3;
 if((f.month===12&&f.dom===8)||(f.month===8&&f.dom===15)||textHas(f,/Immaculate Conception|Assumption|Immaculée Conception|Assomption/i))return 4;
 if((f.month===12&&f.dom===24)||(f.month===1&&f.dom===1)||textHas(f,/Vigil of Christmas|Octave-day of Christmas|Vigile de Noël|Octave de Noël/i))return 5;
 if(f.isSunday&&(/^Tempora\/(Adv|Quad)/i.test(f.path)||textHas(f,/Low Sunday|Dominica in Albis|Quasimodo|Dimanche in albis/i)))return 6;
 if(isAshWednesday(f)||isHolyWeekMonWed(f))return 7;
 if(isAllSouls(f))return 8;
 return null;
}
function isTopEightPrecedenceDay(f=dayFacts()){return precedenceSlot(f)!=null}
function isTopThreeOrAllSouls(f=dayFacts()){const n=precedenceSlot(f);return n===1||n===2||n===3||n===8}
function isChristmasOctave(f=dayFacts()){return (f.month===12&&f.dom>=25)||(f.month===1&&f.dom===1)||textHas(f,/octave of Christmas|octave de Noël/i)}
function dedicationConsecrationForbidden(f=dayFacts()){
 if((f.month===12&&[24,25].includes(f.dom))||(f.month===1&&f.dom===6)||isAllSouls(f))return true;
 if(textHas(f,/Ascension|Corpus Christi|Pentecost|Épiphanie|Ascension|Saint-Sacrement|Pentecôte/i))return true;
 if(/^Tempora\/Quad6-[0-7]$/i.test(f.path)||textHas(f,/Palm Sunday|Easter Sunday|Dimanche des Rameaux|Pâques/i))return true;
 return false;
}
function identityConflict(def,f=dayFacts()){
 const t=`${f.title} ${f.path}`.toLowerCase(),id=ARCH.actualCelebration.id;
 const tests={
  trinity:/trinity|trinit[eé]/,blessed_sacrament:/corpus christi|blessed sacrament|saint-sacrement/,sacred_heart:/sacred heart|sacr[eé]-cœur/,holy_cross:/holy cross|exaltation of the holy cross|sainte croix|exaltation de la croix/,passion:/passion of our lord|passion de notre-seigneur/,eternal_priest:/eternal priest|pr[eê]tre [eé]ternel/,holy_ghost:/pentecost|holy ghost|saint-esprit|pentec[oô]te/,immaculate_heart:/immaculate heart|cœur immacul[eé]/,angels:/holy angels|guardian angels|saints anges|anges gardiens/,joseph:/saint joseph|st joseph/,apostles:/apostles|ap[oô]tres/,peter_paul:/peter and paul|pierre et paul/
 };
 return !!(tests[id]&&tests[id].test(t));
}
function funeralUniversalBlock(f=dayFacts()){
 if((f.month===12&&f.dom===25)||textHas(f,/Christmas Day|Nativity of the Lord|Noël/i))return 'precedence-1';
 if(textHas(f,/Easter Sunday|Pentecost|Whit Sunday|Pâques|Pentecôte/i))return 'precedence-1';
 if(isTriduum(f))return 'precedence-2';
 if((f.month===1&&f.dom===6)||textHas(f,/Epiphany|Ascension|Blessed Trinity|Most Holy Trinity|Corpus Christi|Sacred Heart|Christ the King|Épiphanie|Ascension|Trinité|Saint-Sacrement|Sacré-Cœur|Christ Roi/i))return 'precedence-3';
 if((f.month===12&&f.dom===8)||(f.month===8&&f.dom===15)||textHas(f,/Immaculate Conception|Assumption|Immaculée Conception|Assomption/i))return 'precedence-4';
 if((f.month===12&&f.dom===24)||(f.month===1&&f.dom===1)||textHas(f,/Vigil of Christmas|Octave-day of Christmas|Vigile de Noël|Octave de Noël/i))return 'precedence-5';
 if(f.isSunday&&(/^Tempora\/(Adv|Quad)/i.test(f.path)||textHas(f,/Low Sunday|Dominica in Albis|Quasimodo|Dimanche in albis/i)))return 'precedence-6';
 return null;
}
function rubricalSources(...items){return items.filter(Boolean)}
function resultBase(status,code,summary,reason,extra={}){return {status,code,summary,reason,additions:[],conditions:[],sources:[],...extra}}
function votiveBasisOptions(def=actualDef(),f=dayFacts()){
 if(!def||def.type!=='votive')return [];
 const out=[];
 if(ARCH.actualCelebration.id!=='dedication')out.push({id:'ordinary',class:4,label:L('Ordinary votive · IV class','Votive ordinaire · IVe classe'),note:L('Requires a just cause such as necessity, benefit or devotion.','Exige une juste cause telle que nécessité, utilité ou dévotion.'),source:'RG 387–389'});
 if(ARCH.actualCelebration.id==='sacred_heart'&&isFirstFriday(f))out.push({id:'first_friday',class:3,label:L('First Friday devotion · III class','Dévotion du premier vendredi · IIIe classe'),note:L('Only where special Sacred Heart exercises are held that day.','Seulement là où des exercices spéciaux en l’honneur du Sacré-Cœur ont lieu ce jour-là.'),source:'RG 385b–386'});
 if(ARCH.actualCelebration.id==='immaculate_heart'&&isFirstSaturday(f))out.push({id:'first_saturday',class:3,label:L('First Saturday devotion · III class','Dévotion du premier samedi · IIIe classe'),note:L('Only where special Immaculate Heart exercises are held that day.','Seulement là où des exercices spéciaux en l’honneur du Cœur Immaculé ont lieu ce jour-là.'),source:'RG 385c–386'});
 if(ARCH.actualCelebration.id==='eternal_priest'&&(isFirstThursday(f)||isFirstSaturday(f)))out.push({id:'clergy_devotion',class:3,label:L('Clergy-sanctification devotion · III class','Dévotion pour la sanctification du clergé · IIIe classe'),note:L('First Thursday or first Saturday, where the prescribed special exercises are held.','Premier jeudi ou premier samedi, là où les exercices spéciaux prescrits ont lieu.'),source:'RG 385a–386'});
 if(ARCH.actualCelebration.id==='blessed_sacrament'){
  out.push({id:'eucharistic_congress_private',class:3,label:L('Eucharistic Congress · individual priest · III class','Congrès eucharistique · prêtre individuel · IIIe classe'),note:L('For an individual priest participating in a Eucharistic Congress.','Pour un prêtre individuel participant à un Congrès eucharistique.'),source:'RG 337, 385'});
  out.push({id:'eucharistic_congress_public',class:2,label:L('Eucharistic Congress · public celebration · II class','Congrès eucharistique · célébration publique · IIe classe'),note:L('For other public celebrations of the Congress.','Pour les autres célébrations publiques du Congrès.'),source:'RG 336'});
  out.push({id:'eucharistic_congress_principal',class:1,label:L('Eucharistic Congress · principal sung Mass · I class','Congrès eucharistique · Messe principale chantée · Ie classe'),note:L('Principal Congress Mass, in cantu.','Messe principale du Congrès, chantée.'),source:'RG 335'});
 }
 if(ARCH.actualCelebration.id==='faith')out.push({id:'mission_celebration',class:2,label:L('Mission celebration / congress · II class','Célébration / congrès missionnaire · IIe classe'),note:L('One such Mass in each church for a special Mission celebration or Missionary Congress.','Une telle Messe dans chaque église pour une célébration missionnaire spéciale ou un congrès missionnaire.'),source:'RG 369'});
 out.push({id:'grave_public',class:2,label:L('Grave public reason · II class','Motif grave et public · IIe classe'),note:L('Requires order or consent of the local Ordinary; the need must affect the whole or a notable part of the community.','Exige l’ordre ou le consentement de l’Ordinaire du lieu; le besoin doit concerner toute la communauté ou une partie notable de celle-ci.'),source:'RG 366–368'});
 out.push({id:'special_occasion',class:2,label:L('Defined special occasion · II class','Occasion spéciale définie · IIe classe'),note:L('For the particular occasions listed by the rubrics and with the respective Ordinary’s order or permission.','Pour les occasions particulières prévues par les rubriques et avec l’ordre ou la permission de l’Ordinaire compétent.'),source:'RG 370–372'});
 out.push({id:'sanctuary',class:2,label:L('Sanctuary / pilgrimage privilege · II class','Sanctuaire / privilège de pèlerinage · IIe classe'),note:L('Only where the sanctuary/place-of-devotion conditions of the rubrics are actually met.','Seulement lorsque les conditions rubricales du sanctuaire ou lieu de dévotion sont réellement remplies.'),source:'RG 373–377'});
 out.push({id:'extraordinary',class:ARCH.celebrationForm==='sung'?1:2,label:ARCH.celebrationForm==='sung'?L('Extraordinary celebration · sung · I class','Célébration extraordinaire · chantée · Ie classe'):L('Extraordinary celebration · low · II class','Célébration extraordinaire · basse · IIe classe'),note:L('Only for an extraordinary celebration of the type defined in RG 338–340.','Seulement pour une célébration extraordinaire du type défini aux RG 338–340.'),source:'RG 338–340'});
 if(ARCH.actualCelebration.id==='dedication')out.unshift({id:'dedication_consecration',class:1,label:L('Actual consecration of a church · I class','Consécration effective d’une église · Ie classe'),note:L('This basis is for the Mass of Dedication in the act of consecrating a church, not a generic private votive.','Cette base concerne la Messe de la Dédicace lors de la consécration d’une église, non une votive privée générique.'),source:'RG 329a, 331–334'});
 return out;
}
function currentVotiveBasis(def=actualDef(),f=dayFacts()){
 const opts=votiveBasisOptions(def,f);let b=opts.find(x=>x.id===ARCH.votiveBasis);
 if(!b){b=opts[0]||null;if(b)ARCH.votiveBasis=b.id}
 if(b?.id==='extraordinary')b={...b,class:ARCH.celebrationForm==='sung'?1:2,label:ARCH.celebrationForm==='sung'?L('Extraordinary celebration · sung · I class','Célébration extraordinaire · chantée · Ie classe'):L('Extraordinary celebration · low · II class','Célébration extraordinaire · basse · IIe classe')};
 return b;
}
function genericVotiveBlock(f=dayFacts()){
 const c=ARCH.rubricContext;
 if(c.conventualConflict)return resultBase('prohibited','votive-conventual-conflict',L('Votive Mass prohibited in this circumstance','Messe votive interdite dans cette circonstance'),L('In a church having only one Mass, a votive Mass is forbidden when the conventual obligation cannot be fulfilled by another priest.'),{sources:rubricalSources('RG 326a')});
 if(c.onlyMassWithCandleBlessing&&isCandlemas(f))return resultBase('prohibited','votive-candlemas-only-mass',L('Votive Mass prohibited at this Mass','Messe votive interdite à cette Messe'),L('On 2 February, in a church having only one Mass, a votive Mass cannot replace the Mass associated with the blessing of candles.'),{sources:rubricalSources('RG 326b')});
 if(c.rogationMassRequired)return resultBase('prohibited','votive-rogation-required',L('Rogation Mass takes precedence','La Messe des Rogations a préséance'),L('Where the Rogation Mass must be said with the Greater or Lesser Litanies, another votive Mass is not permitted in a church having only one Mass.'),{sources:rubricalSources('RG 326c')});
 return null;
}
function applyVotiveClass(def,basis,f=dayFacts()){
 const cls=basis?.class||4,id=ARCH.actualCelebration.id,slot=precedenceSlot(f),same=identityConflict(def,f);
 if(basis?.id==='dedication_consecration'){
  if(dedicationConsecrationForbidden(f))return resultBase('prohibited','dedication-consecration-day-forbidden',L('Church consecration is not permitted today','La consécration d’une église n’est pas permise aujourd’hui'),L('The 1960 rubrics forbid the consecration of a church on the specified major days. Because this basis is the Mass within the actual rite of consecration, the celebration itself must be moved.'),{votiveClass:1,basis:basis.id,transferable:true,sources:rubricalSources('RG 331–334')});
  return resultBase('permitted','dedication-consecration-required',L('Mass of Dedication required within the consecration rite','Messe de la Dédicace requise dans le rite de consécration'),L('When a church or oratory is actually consecrated on a day on which the rite is permitted, the Mass of Dedication forms part of the complete rite and must be celebrated even where another votive Mass I class would be impeded.'),{votiveClass:1,basis:basis.id,gloria:true,credo:true,tone:ARCH.celebrationForm==='sung'?'solemn':null,sources:rubricalSources('RG 331–334')});
 }
 if(same&&(f.rank===1||f.rank===2))return resultBase('impeded','votive-identity-conflict',L('The Mass of the occurring Office is used','La Messe de l’Office occurrent est utilisée'),L('A votive Mass of a mystery of the Lord, Our Lady, or a Saint is forbidden when a I- or II-class liturgical day occurs on which the Office is of that same mystery or person.'),{votiveClass:cls,basis:basis?.id,resultingCelebration:'mass_of_day',properSourceOverride:calendarPath(),sources:rubricalSources('RG 317')});
 let permitted=false;
 if(cls===1)permitted=slot==null;
 else if(cls===2)permitted=f.rank!=null&&f.rank>=2;
 else if(cls===3)permitted=f.rank!=null&&f.rank>=3;
 else permitted=f.rank===4;
 if(f.rank==null)return resultBase('permittedWithChanges','rank-unresolved',L('Calendar class must be verified','La classe du jour doit être vérifiée'),L('The 1960 rule is known, but the calendar day did not expose a usable I–IV class value.'),{votiveClass:cls,basis:basis?.id,sources:rubricalSources(basis?.source)});
 if(!permitted){
  if((cls===1||cls===2)&&f.rank===1&&!isTopThreeOrAllSouls(f))return resultBase('permittedWithChanges',`votive-${cls}-collect-retained`,L('Votive Mass impeded · its prayer is retained','Messe votive empêchée · sa collecte est conservée'),L('The votive Mass itself cannot replace today’s I-class Mass, but the prayer of the impeded I- or II-class votive Mass is added under one conclusion with the prayer of the Mass of the day.'),{votiveClass:cls,basis:basis?.id,resultingCelebration:'mass_of_day',properSourceOverride:calendarPath(),additions:[L('Prayer of the impeded votive Mass under one conclusion','Collecte de la Messe votive empêchée sous une seule conclusion')],sources:rubricalSources('RG 318',cls===1?'RG 330c':'RG 343c')});
  return resultBase('impeded',`votive-${cls}-impeded`,L(`Votive Mass ${['','I','II','III','IV'][cls]} class impeded today`,`Messe votive de ${['','Ie','IIe','IIIe','IVe'][cls]} classe empêchée aujourd’hui`),cls===1?L('A votive Mass I class is not permitted on liturgical days numbered 1–8 in the table of precedence.','Une Messe votive de Ie classe n’est pas permise les jours liturgiques numérotés 1 à 8 dans la table de préséance.'):L(`A votive Mass ${['','I','II','III','IV'][cls]} class may be celebrated only on liturgical days of the class allowed by the 1960 rubrics. Today is ${f.day.rank||'unresolved'}.`,`Une Messe votive de ${['','Ie','IIe','IIIe','IVe'][cls]} classe ne peut être célébrée que les jours admis par les rubriques de 1960. Aujourd’hui est ${f.day.rank||'non résolu'}.`),{votiveClass:cls,basis:basis?.id,transferable:false,sources:rubricalSources(basis?.source,cls===1?'RG 328–330':cls===2?'RG 341–343':cls===3?'RG 384–386':'RG 387–389')});
 }
 if(id==='saturday_bvm'&&!f.isSaturday)return resultBase('impeded','saturday-bvm-not-saturday',L('Saturday Mass of Our Lady requires Saturday','La Messe de Notre-Dame du samedi requiert un samedi'),L('This conceptual formulary is exposed as the traditional Saturday votive Mass of Our Lady; choose it on a Saturday.'),{votiveClass:cls,basis:basis?.id,sources:rubricalSources('RG 78–79, 389a')});
 const gloria=cls===1?true:cls===2?String(def?.colour||'').toLowerCase()!=='violet':cls===3?true:(id==='angels'||(id==='saturday_bvm'&&f.isSaturday));
 const credo=cls===1?true:cls===2?(f.isSunday||isOctaveDay(f)):false;
 const tone=ARCH.celebrationForm==='sung'?(cls===4?'ferial':'solemn'):null;
 const conditions=[];const additions=[];