<style id="ao-v411-rosary-scrim-containment-css">
/* The v40.2 scrim must never share a stacking plane with prayer content. */
#aoPrayerBookRoot .pbShell.aoV401RosaryArtPrayer{
  position:relative!important;isolation:isolate!important;overflow:clip!important;
  filter:none!important;opacity:1!important
}
#aoPrayerBookRoot .pbShell.aoV401RosaryArtPrayer::after{
  content:none!important;display:none!important;background:none!important;
  opacity:0!important;filter:none!important;backdrop-filter:none!important;
  -webkit-backdrop-filter:none!important;pointer-events:none!important
}

/* Only the artwork layer is attenuated. It sits behind every live control/text node. */
#aoPrayerBookRoot .pbShell.aoV401RosaryArtPrayer::before{
  content:""!important;display:block!important;position:absolute!important;z-index:0!important;
  inset:64px 0 70px!important;border-radius:var(--radius-l)!important;
  background-image:var(--ao-v401-rosary-art)!important;
  background-size:cover!important;background-position:center 22%!important;background-repeat:no-repeat!important;
  opacity:.20!important;filter:saturate(.76) brightness(.72) contrast(.94)!important;
  backdrop-filter:none!important;-webkit-backdrop-filter:none!important;pointer-events:none!important
}
#aoPrayerBookRoot .pbShell.aoV401RosaryArtPrayer.aoV401ArtSubtle::before{
  opacity:.10!important;filter:saturate(.62) brightness(.66) contrast(.92)!important
}
#aoPrayerBookRoot .pbShell.aoV401RosaryArtPrayer>*{
  position:relative!important;z-index:1!important;opacity:1!important
}

/* Prayer surfaces stay native and sharp. Transparency is in the image, not in the text. */
#aoPrayerBookRoot .pbShell.aoV401RosaryArtPrayer .lab-prayer-sheet{
  background:color-mix(in srgb,var(--surface-1) 94%,transparent)!important;
  border-color:var(--border)!important;box-shadow:0 12px 28px rgba(0,0,0,.16)!important;
  filter:none!important;opacity:1!important;
  backdrop-filter:none!important;-webkit-backdrop-filter:none!important
}
#aoPrayerBookRoot .pbShell.aoV401RosaryArtPrayer.aoV401ArtSubtle .lab-prayer-sheet{
  background:color-mix(in srgb,var(--surface-1) 97%,transparent)!important
}
#aoPrayerBookRoot .pbShell.aoV401RosaryArtPrayer .lab-scripture-cue{
  background:color-mix(in srgb,var(--surface-2) 96%,transparent)!important;
  border-color:var(--liturgical-border)!important;
  filter:none!important;opacity:1!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important
}

/* Reinstate v40.2's crisp announcement-art sizing after the older v40.1 tail. */
#aoPrayerBookRoot .aoV401RosaryHero img{
  display:block!important;width:auto!important;max-width:100%!important;height:auto!important;
  max-height:min(54vh,520px)!important;margin-inline:auto!important;object-fit:contain!important;
  image-rendering:auto!important;filter:none!important;opacity:1!important;background:var(--bg)!important
}
#aoPrayerBookRoot .aoV401RosaryHero.aoV401ArtSubtle img{
  opacity:.88!important;filter:saturate(.88) brightness(.90)!important
}

@media(max-width:560px){
  #aoPrayerBookRoot .pbShell.aoV401RosaryArtPrayer::before{
    inset:58px 0 68px!important;border-radius:var(--radius-m)!important
  }
  #aoPrayerBookRoot .aoV401RosaryHero img{max-height:46vh!important}
}
</style>

<style id="ao-v411-group-vr-gesture-harmonization-css">
/* v41.1 — devotional recitation-role authority.
   Individual: no invented dialogue markers for common prayers.
   Group: visible ℣./℟. throughout the shared response format, matching Angelus.
   Intrinsic source ℣./℟. remain intrinsic in both modes. */
#aoPrayerBookRoot .aoCustomarySplit{display:block!important;color:var(--text)!important}
#aoPrayerBookRoot .aoCustomaryLeader,
#aoPrayerBookRoot .aoCustomaryResponse{color:var(--text)!important;line-height:1.55!important}

/* Group common prayers use the same visible two-column role grammar as Angelus. */
#aoPrayerBookRoot.aoRecitationGroup .aoCustomaryLeader,
#aoPrayerBookRoot.aoRecitationGroup .aoCustomaryResponse,
html.aoRecitationGroup #aoPrayerBookRoot .aoCustomaryLeader,
html.aoRecitationGroup #aoPrayerBookRoot .aoCustomaryResponse{
  display:grid!important;
  grid-template-columns:1.55rem minmax(0,1fr)!important;
  gap:.38rem!important;
  align-items:start!important;
}
#aoPrayerBookRoot.aoRecitationGroup .aoCustomaryLeader,
html.aoRecitationGroup #aoPrayerBookRoot .aoCustomaryLeader{
  padding:.10rem .10rem .30rem!important;
  border-left:0!important;background:transparent!important;box-shadow:none!important
}
#aoPrayerBookRoot.aoRecitationGroup .aoCustomaryResponse,
html.aoRecitationGroup #aoPrayerBookRoot .aoCustomaryResponse{
  margin:.12rem 0 .28rem!important;
  padding:.30rem .46rem!important;
  border-left:2px solid var(--liturgical-border)!important;
  border-radius:0 6px 6px 0!important;
  background:color-mix(in srgb,var(--liturgical) 9%,transparent)!important;
  box-shadow:none!important
}
#aoPrayerBookRoot.aoRecitationGroup .aoCustomaryLeader>.aoPrayerRole,
html.aoRecitationGroup #aoPrayerBookRoot .aoCustomaryLeader>.aoPrayerRole{
  display:inline!important;color:var(--muted)!important;font-weight:600!important
}
#aoPrayerBookRoot.aoRecitationGroup .aoCustomaryResponse>.aoPrayerRole,
html.aoRecitationGroup #aoPrayerBookRoot .aoCustomaryResponse>.aoPrayerRole{
  display:inline!important;color:var(--liturgical)!important;font-weight:700!important
}

/* Intrinsic dialogue uses the same quiet-versicle / accented-response system. */
#aoPrayerBookRoot.aoRecitationGroup .aoPrayerDialogueLine.aoVersicle .aoPrayerRole,
html.aoRecitationGroup #aoPrayerBookRoot .aoPrayerDialogueLine.aoVersicle .aoPrayerRole,
#aoPrayerBookRoot.aoRecitationGroup .aoLitanyCall .aoPrayerRole,
html.aoRecitationGroup #aoPrayerBookRoot .aoLitanyCall .aoPrayerRole{color:var(--muted)!important;font-weight:600!important}
#aoPrayerBookRoot.aoRecitationGroup .aoPrayerDialogueLine.aoResponse,
html.aoRecitationGroup #aoPrayerBookRoot .aoPrayerDialogueLine.aoResponse{
  padding:.24rem .38rem!important;border-left:2px solid var(--liturgical-border)!important;
  border-radius:0 5px 5px 0!important;background:color-mix(in srgb,var(--liturgical) 9%,transparent)!important
}
#aoPrayerBookRoot.aoRecitationGroup .aoPrayerDialogueLine.aoResponse .aoPrayerRole,
html.aoRecitationGroup #aoPrayerBookRoot .aoPrayerDialogueLine.aoResponse .aoPrayerRole{color:var(--liturgical)!important;font-weight:700!important}
#aoPrayerBookRoot.aoRecitationGroup .aoLitanyResponse,
html.aoRecitationGroup #aoPrayerBookRoot .aoLitanyResponse{
  padding:.12rem .28rem .12rem .34rem!important;
  border-left:2px solid color-mix(in srgb,var(--liturgical) 40%,transparent)!important;
  border-radius:0 4px 4px 0!important;background:color-mix(in srgb,var(--liturgical) 5%,transparent)!important
}
#aoPrayerBookRoot.aoRecitationGroup .aoLitanyResponse .aoPrayerRole,
html.aoRecitationGroup #aoPrayerBookRoot .aoLitanyResponse .aoPrayerRole{color:var(--liturgical)!important;font-weight:700!important}

/* Individual common prayers remain ordinary continuous prayer text. */
#aoPrayerBookRoot.aoRecitationIndividual .aoCustomarySplit>.aoCustomaryLeader,
#aoPrayerBookRoot.aoRecitationIndividual .aoCustomarySplit>.aoCustomaryResponse,
html.aoRecitationIndividual #aoPrayerBookRoot .aoCustomarySplit>.aoCustomaryLeader,
html.aoRecitationIndividual #aoPrayerBookRoot .aoCustomarySplit>.aoCustomaryResponse{
  display:block!important;padding:0!important;border:0!important;background:transparent!important
}
#aoPrayerBookRoot.aoRecitationIndividual .aoCustomarySplit .aoPrayerRole,
html.aoRecitationIndividual #aoPrayerBookRoot .aoCustomarySplit .aoPrayerRole{display:none!important}

/* Gesture cues remain icon-first, discreet, and below prayer-text scale. */
#aoPrayerBookRoot .aoDevGestureCue{max-width:100%;font-size:.72rem!important;line-height:1.25!important}
</style>

<script id="ao-v411-group-vr-gesture-harmonization-js">
(function(){
  'use strict';
  /* Replace the common-prayer renderer only. The source-text / intrinsic dialogue
     renderer remains authoritative. Group mode gains visible ℣./℟. markers to
     match Angelus and the rest of the Prayer Book. */
  const previous=window.aoRPrayerHtml || (typeof aoRPrayerHtml==='function'?aoRPrayerHtml:null);
  if(typeof aoRPrayerHtml==='function'){
    aoRPrayerHtml=function(text,id=''){
      const shown=aoRResponsiveText(text,id),kind=aoRRoleKind(id);
      const out=[]; let blank=false;
      for(const raw of shown.split(/\n/)){
        const line=String(raw||'').trim();
        if(!line){blank=true;continue}
        if(blank&&out.length)out.push('<span class="aoPrayerSpacer" aria-hidden="true"></span>');
        blank=false;
        if(kind==='litany'){out.push(aoRLitanyLine(line));continue}
        if(aoRMode()==='group'&&!/^[℣℟]\./.test(line)){
          const parts=aoRCommonParts(line,id);
          if(parts.response){
            out.push(`<span class="aoCustomarySplit" data-common-prayer="${esc(parts.kind)}"><span class="aoCustomaryLeader"><span class="aoPrayerRole" aria-hidden="true">℣.</span><span>${aoREsc(parts.leader)}</span></span><span class="aoCustomaryResponse"><span class="aoPrayerRole" aria-hidden="true">℟.</span><span>${aoREsc(parts.response)}</span></span></span>`);
            continue;
          }
        }
        if(/^[℣℟]\./.test(line)){out.push(aoRRoleLine(line));continue}
        out.push(`<span class="aoPrayerProse">${aoREsc(line)}</span>`);
      }
      return out.join('');
    };
  }
  function sync(){
    const root=document.getElementById('aoPrayerBookRoot'); if(!root)return;
    const group=typeof aoRMode==='function'?aoRMode()==='group':document.documentElement.classList.contains('aoRecitationGroup');
    root.classList.toggle('aoRecitationGroup',group); root.classList.toggle('aoRecitationIndividual',!group);
  }
  sync();
  window.AO_V411_ROLE_GESTURE_HARMONIZATION={version:'41.1',groupVisibleVR:true,commonPrayerMarkers:'visible-in-group',individualCommonMarkers:false,gestureAuthority:'AO_DEVOTIONAL_GESTURES_V393',sync};
})();
</script>

<script id="ao-v42-canonical-merge-meta">
(()=>{'use strict';
const EXPECTED={saintArtVersion:'SAINT-ART-MANIFEST-v3.3',saintDates:252,saintComponents:311,rosaryPreviewApi:true,groupRoles:true};
function inspect(){
 const sa=globalThis.AO_SAINT_ART;
 const sr=globalThis.AO_ROSARY_V401;
 const manifest=sa?.lastManifest||null;
 const checks={
  saintArtVersion:sa?.version===EXPECTED.saintArtVersion,
  saintDates:sa?.expected?.saintBearingDates===EXPECTED.saintDates,
  saintComponents:sa?.expected?.components===EXPECTED.saintComponents,
  rosaryPreviewApi:typeof sr?.preview==='function',
  groupRoles:!!globalThis.AO_V411_ROLE_GESTURE_HARMONIZATION,
  prayerSourceCompletion:!!globalThis.AO_V414_PRAYER_SOURCE_META,
  scriptureLanguageCompletion:!!globalThis.AO_V413_SCRIPTURE_LANGUAGE_META||!!document.getElementById('ao-v413-scripture-language-build-marker')
 };
 const pass=Object.values(checks).every(Boolean);
 try{document.documentElement.dataset.aoBuildIntegrity=pass?'pass':'fail'}catch{}
 return {pass,checks,manifestSummary:manifest?.summary||null};
}
globalThis.AO_V42_META={
 version:'42',
 release:'Ad Orientem 2.0 v42 · Canonical Branch Reconciliation',
 base:'v41.4 Prayer Source Completion',
 integrated:{
  saintArt:'v41.3 Saint-Art Approval Gate / manifest v3.3 / cache v13 / approval-pass10-gated-v1',
  rosaryGroupGestures:'v41.1 Group Roles & Gestures, reconciled with v41.2+ Rule preview API',
  scripture:'v41.3 Scripture Language Completion inherited through v41.4',
  prayerSources:'v41.4 Prayer Source Completion inherited'
 },
 frozenSaintScope:{saintBearingDates:252,occurrenceComponents:311},
 navigation:{sourceCandidate:'v40.8 Navigation UI Ownership',status:'rebased-in-v42.1',reason:'module-owned controls and cleaned return-context coordinator rebased onto v42 without replacing later content'},
 inspect
};
const setTitle=()=>{try{if(!globalThis.AO_RELEASE_AUTHORITY_V4359)document.title='Ad Orientem 2.0 · v42 Canonical Branch Reconciliation'}catch{}};
const run=()=>{setTitle();inspect()};
run();
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',run,{once:true});
})();
</script>

<style id="ao-v408-module-owned-controls-css">
.aoModuleHome{flex:none;min-width:40px!important;width:40px!important;height:40px!important;min-height:40px!important;padding:0!important;border:1px solid var(--border)!important;border-radius:11px!important;background:var(--surface-1)!important;color:var(--text)!important;font:700 .72rem/1 var(--font-display)!important;letter-spacing:.04em}.ao354Top.aoHasModuleHome{grid-template-columns:44px minmax(0,1fr) 40px 44px!important}#aoPrayerBookRoot .pbTop.aoHasModuleHome{grid-template-columns:44px minmax(0,1fr) 40px auto!important}
.aoLessonPager{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:18px 0 8px}.aoLessonPager button,.aoManagePanel button{min-height:44px;border:1px solid var(--border);border-radius:12px;background:var(--surface-1);color:var(--text);padding:9px 11px;font-weight:650}.aoLessonPager button:last-child{text-align:right}.aoLessonPager button:disabled{opacity:.35}
.aoManagePanel{margin:16px 0;padding:12px;border:1px solid var(--border);border-radius:14px;background:rgba(255,255,255,.018);display:grid;gap:8px}.aoManagePanel strong{font-family:var(--font-display);font-size:.86rem}.aoManagePanel small{color:var(--muted);line-height:1.4}.aoManageActions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.aoManagePanel .danger{border-color:rgba(184,91,88,.42);color:#e3b0ad}
[data-v352-act][aria-pressed="true"]{border-color:var(--liturgical)!important;background:var(--liturgical-soft)!important;box-shadow:inset 0 0 0 1px var(--liturgical-border)}
[data-v352-act][aria-pressed="true"] strong:after{content:' ✓';color:var(--liturgical)}
@media(max-width:360px){.aoManageActions{grid-template-columns:1fr}.aoLessonPager{grid-template-columns:1fr}}
</style>

<script id="ao-v421-navigation-ownership-meta">
(()=>{'use strict';
function inspect(){
 const nav=globalThis.AO_NAV_V362;
 const q=nav?.qa?.()||{};
 const checks={
  coordinator:nav?.version==='40.8-navigation-coordinator',
  noCoordinatorUiInjection:q.uiInjection===false,
  saintArtVersion:globalThis.AO_SAINT_ART?.version==='SAINT-ART-MANIFEST-v3.3',
  saintComponents:globalThis.AO_SAINT_ART?.expected?.components===311,
  rosaryPreviewApi:typeof globalThis.AO_ROSARY_V401?.preview==='function',
  groupRoles:!!globalThis.AO_V411_ROLE_GESTURE_HARMONIZATION,
  prayerSourceCompletion:!!globalThis.AO_V414_PRAYER_SOURCE_META
 };
 const pass=Object.values(checks).every(Boolean);
 try{document.documentElement.dataset.aoNavOwnership=pass?'pass':'fail'}catch{}
 return {pass,checks,nav:q};
}
globalThis.AO_V421_NAVIGATION_META={version:'42.1',release:'Ad Orientem 2.0 v42.1 · Navigation Ownership Rebase',base:'v42 Canonical Branch Reconciliation',source:'v40.8 Navigation UI Ownership',policy:'coordinator owns return context; modules own visible controls',inspect};
const run=()=>{try{if(!globalThis.AO_RELEASE_AUTHORITY_V4359)document.title='Ad Orientem 2.0 · v42.1 Navigation Ownership Rebase'}catch{};inspect()};
run();if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',run,{once:true});
})();
</script>

<script id="ao-v424-harmonized-proper-art-source-meta">
(()=>{'use strict';
const EXPECTED={green:47,hold:2,noArt:1,artworks:49};
window.AO_V424_META=Object.freeze({
 version:'42.4-harmonized-proper-art-source-completion',
 baseline:'v42.3 Votive Proper Source Completion',
 merged:['v42.2B authoritative Phase-1 Proper-art manifest','v42.2A Home art acceptance behavior'],
 rejected:['v42.3 Stations Art Restoration branch'],
 policy:'Preserve v42.3 source completion; fail closed on unsupported Proper art and unsupported vernacular liturgical text.',
 inspect(){
  const art=globalThis.AO_PHASE1_ART; const ai=art?.inspect?.()||{};
  const src=globalThis.AO_V423_VOTIVE_SOURCE_META?.inspect?.()||{};
  const counts={green:ai.green||0,hold:ai.hold||0,noArt:ai.noArt||0,artworks:Object.keys(art?.data?.artworks||{}).length};
  const checks={
   phase1Art:!!art,phase1Version:art?.version==='phase1-proper-art-v1.2',
   counts:Object.keys(EXPECTED).every(k=>counts[k]===EXPECTED[k]),
   sourceCompletion:src.pass===true,
   noGenericFallback:ai.genericFallback===false,
   rejectedStationsArtAbsent:!globalThis.AO_STATIONS_ART_V423 && !document.getElementById('ao-v423-stations-art-js')
  };
  const pass=Object.values(checks).every(Boolean);
  try{document.documentElement.dataset.aoV424Integrity=pass?'pass':'fail'}catch{}
  return {pass,checks,counts,source:src};
 }
});
const run=()=>window.AO_V424_META.inspect();run();if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',run,{once:true});
})();
</script>
<script id="ao-v424-final-title-authority">
(()=>{'use strict';const TITLE='Ad Orientem 2.0 · v42.4 Harmonized Proper Art + Source Completion';const set=()=>{try{if(!globalThis.AO_RELEASE_AUTHORITY_V4359)document.title=TITLE;if(!globalThis.AO_RELEASE_AUTHORITY_V4359)document.documentElement.dataset.aoRelease='42.4';if(!globalThis.AO_RELEASE_AUTHORITY_V4359)document.documentElement.dataset.aoCanonicalHead='v42.4'}catch{}};set();if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',set,{once:true});window.AO_V424_TITLE=TITLE;})();
</script>

