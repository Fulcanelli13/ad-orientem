","data:image/webp;base64,"]};
const ROOT_ID='aoPrayerBookRoot';
const FULL_BASE='assets/rosary/';
let queued=false,artStamp=0;
const pb=()=>window.AOTraditionalPrayerBook;
const root=()=>document.getElementById(ROOT_ID);
const state=()=>pb()?.getState?.()||null;
const steps=()=>pb()?.getRosarySteps?.()||[];
const isFr=()=>{const s=state();return s?.language==='fr'||(document.documentElement.lang||'').toLowerCase().startsWith('fr')||/Préférences|Mystère|Rosaire/.test(root()?.textContent||'')};
const vibrate=()=>false; /* emergency-stable: Rosary haptics disabled */
const artMode=()=>window.AO_ROSARY_ART_V38?.getMode?.()||'on';
const setArtMode=(m)=>{const v=['on','subtle','off'].includes(m)?m:'on';window.AO_ROSARY_ART_V38?.setMode?.(v);schedule();return v};
function currentInfo(){const s=state(),xs=steps();if(!s?.rosarySet||!xs.length)return null;const i=Math.max(0,Math.min(xs.length-1,Number(s.rosaryStep)||0)),step=xs[i];return{s,xs,i,step,set:s.rosarySet,mi:Number.isInteger(step?.mi)?step.mi:null}}
function fullPath(set,mi){return `${FULL_BASE}${set}/${String(mi+1).padStart(2,'0')}.webp`}
function tryFull(set,mi,token,apply){if(navigator.connection?.saveData)return;try{const src=fullPath(set,mi),im=new Image();im.onload=()=>{if(token===artStamp&&Math.max(im.naturalWidth||0,im.naturalHeight||0)>=1200)apply(src)};im.src=src}catch{}}
function cleanArt(shell){if(!shell)return;shell.classList.remove('aoV401RosaryArtPrayer','aoV401ArtSubtle');shell.style.removeProperty('--ao-v401-rosary-art');shell.querySelectorAll('.aoV401RosaryHero').forEach(x=>x.remove())}
function applyArt(){
 const r=root(),info=currentInfo();if(!r)return;
 const shell=r.querySelector('.pbShell[data-rc2-module="rosary"]')||r.querySelector('.pbShell.rc2Module')||r.querySelector('.pbShell');if(!shell)return;
 artStamp++;const token=artStamp;cleanArt(shell);
 if(!info||info.mi===null||artMode()==='off')return;
 const data=PREVIEW[info.set]?.[info.mi];if(!data)return;
 if(info.step?.kind==='mystery'){
   const card=shell.querySelector('.lab-contemplation');if(!card)return;
   const fig=document.createElement('figure');fig.className='aoV401RosaryHero'+(artMode()==='subtle'?' aoV401ArtSubtle':'');
   const title=card.querySelector('h2')?.textContent?.trim()||'';
   fig.innerHTML=`<img alt="" src="${data}" decoding="async"><figcaption><span>${title.replace(/&/g,'&amp;').replace(/</g,'&lt;')}</span><span>${isFr()?'Méditation par l’art sacré':'Sacred art meditation'}</span></figcaption>`;
   card.insertAdjacentElement('beforebegin',fig);
   const img=fig.querySelector('img');tryFull(info.set,info.mi,token,src=>{if(img?.isConnected)img.src=src});
 }else{
   shell.classList.add('aoV401RosaryArtPrayer');if(artMode()==='subtle')shell.classList.add('aoV401ArtSubtle');
   shell.style.setProperty('--ao-v401-rosary-art',`url("${String(data).replace(/"/g,'%22')}")`);
   tryFull(info.set,info.mi,token,src=>{if(shell.isConnected)shell.style.setProperty('--ao-v401-rosary-art',`url("${String(src).replace(/"/g,'%22')}")`)});
 }
}
function beadMarkup(){
 const info=currentInfo();if(!info||info.mi===null)return;
 const stage=root()?.querySelector('.lab-bead-stage');if(!stage||stage.dataset.v401Ready==='1')return;
 const targets=info.xs.map((x,i)=>({x,i})).filter(o=>o.x?.kind==='prayer'&&o.x?.key==='ave'&&o.x?.mi===info.mi&&Number(o.x?.bead)>=1&&Number(o.x?.bead)<=10);
 if(targets.length!==10)return;
 const label=isFr()?'Ave Maria':'Hail Mary';
 stage.classList.add('aoV401InteractiveBeads');stage.dataset.v401Ready='1';stage.setAttribute('role','navigation');
 stage.setAttribute('aria-label',isFr()?'Perles de la dizaine':'Decade beads');
 stage.innerHTML=targets.map((o,n)=>{const cls=['lab-bead','aoV401Bead'];if(o.i<info.i)cls.push('past');if(o.i===info.i)cls.push('current');return `<button type="button" class="${cls.join(' ')}" data-v401-rosary-jump="${o.i}" data-v401-bead="${n+1}" aria-label="${label} ${n+1} / 10" ${o.i===info.i?'aria-current="step"':''}></button>`}).join('');
}
function pulseCurrent(){const b=root()?.querySelector('.aoV401Bead[aria-current="step"]');if(!b)return;b.classList.remove('aoV401Pulse');void b.offsetWidth;b.classList.add('aoV401Pulse')}
function jump(n){const ok=pb()?.setRosaryStep?.(Number(n));if(ok){vibrate([6,16,6]);setTimeout(()=>{schedule();pulseCurrent()},0)}return !!ok}
function enhancePrefs(){
 const sheet=document.getElementById('rc2-module-sheet'),body=sheet?.querySelector('.rc2SheetBody');if(!body||!sheet.querySelector('[data-rc2-mode]'))return;
 const fr=isFr();
 if(!body.querySelector('.aoV401ArtPref')){
   const m=artMode(),sec=document.createElement('section');sec.className='rc2PrefSection aoV401ArtPref';
   sec.innerHTML=`<h3>${fr?'Art sacré':'Sacred art'}</h3><p>${fr?'Choisissez ici, avant la prière, comment l’image du mystère accompagne la dizaine.':'Choose here, before prayer, how the mystery artwork accompanies the decade.'}</p><div class="rc2Segments three">${[['on',fr?'Activé':'On'],['subtle',fr?'Discret':'Subtle'],['off',fr?'Désactivé':'Off']].map(([v,l])=>`<button type="button" class="${m===v?'active':''}" data-v401-art="${v}">${l}</button>`).join('')}</div>`;
   const first=body.querySelector('.rc2PrefSection');first?.insertAdjacentElement('afterend',sec)||body.prepend(sec);
 }
}
function enhance(){queued=false;const r=root();if(!r)return;r.querySelectorAll('.aoRosaryArtMode').forEach(x=>x.remove());beadMarkup();applyArt();if(document.getElementById('rc2-module-sheet'))enhancePrefs()}
function schedule(){if(queued)return;queued=true;requestAnimationFrame(enhance)}
document.addEventListener('click',e=>{
 const bead=e.target.closest?.('[data-v401-rosary-jump]');if(bead){e.preventDefault();e.stopImmediatePropagation();jump(bead.dataset.v401RosaryJump);return}
 const art=e.target.closest?.('[data-v401-art]');if(art){e.preventDefault();e.stopPropagation();setArtMode(art.dataset.v401Art);vibrate(5);document.getElementById('rc2-module-sheet')?.remove();setTimeout(()=>{window.AO_RC2_MODULE_UX?.openPreferences?.('rosary');setTimeout(enhancePrefs,0)},0);return}
 if(e.target.closest?.('[data-rc2-prefs="rosary"]'))setTimeout(enhancePrefs,0);
 if(e.isTrusted&&e.target.closest?.('[data-lab-rosary-next],[data-lab-rosary-prev]'))vibrate(6);
},true);
document.addEventListener('pointerdown',e=>{if(e.target.closest?.('[data-v401-rosary-jump]'))vibrate(4)},true);

window.addEventListener('pageshow',schedule);setTimeout(schedule,100);
window.AO_ROSARY_V401={version:'40.1',observerFree:true,lifecycleOwner:'PrayerBook render → AO_ROSARY_ART_V38.sync → AO_ROSARY_V401.enhance',jumpToStep:jump,getArtMode:artMode,setArtMode,enhance,preview:(set='joyful',index=0)=>PREVIEW[set]?.[index]||null,status:()=>({state:state(),interactiveBeads:root()?.querySelectorAll('[data-v401-rosary-jump]').length||0,artMode:artMode(),groupMode:state()?.recitationMode||'individual',nativeVisualBaseline:!!window.AO_V391_META})};
})();
</script>

