<script id="ao-v432-full-proper-scripture-art-audit-js">
(()=>{'use strict';
if(globalThis.AO_FULL_PROPER_ART_V432)return;
const art=globalThis.AO_PHASE1_ART;
const prior=globalThis.AO_SEPTUAGESIMA_ART_V431;
if(!art||!prior||typeof art.properPath!=='function')return;
const ROWS=Object.freeze({"Tempora/Adv2-0":{"properPath":"Tempora/Adv2-0","label":"Second Sunday of Advent","status":"GREEN","relationship":"EPISTLE_ART","decisionSource":"v43.2 full-Proper scripture audit","primaryArtId":"AO142","note":"Romans 15:12 quotes Isaiah's Root of Jesse. Hans Holbein the Elder's Tree of Jesse explicitly illustrates Isaiah 11:1–10 and is therefore an exact Epistle-derived Proper image."},"Tempora/Epi5-0":{"properPath":"Tempora/Epi5-0","label":"Fifth Sunday after Epiphany","status":"GREEN","relationship":"GOSPEL_ART","decisionSource":"v43.2 full-Proper scripture audit","primaryArtId":"AO143","note":"Abraham Bloemaert's 1624 Parable of the Wheat and the Tares is an exact Matthew 13:24–30 subject; the earlier NO_ART decision is superseded."},"Tempora/PentEpi5-0":{"properPath":"Tempora/PentEpi5-0","label":"Resumed Fifth Sunday after Epiphany","status":"GREEN","relationship":"GOSPEL_ART","decisionSource":"v43.2 inherited base correction","primaryArtId":"AO143","note":"Inherits the corrected Epiphany V primary, AO143."},"Tempora/Epi6-0":{"properPath":"Tempora/Epi6-0","label":"Sixth Sunday after Epiphany","status":"GREEN","relationship":"INTROIT_ART","decisionSource":"v43.2 full-Proper scripture audit","primaryArtId":"AO130","note":"The inherited Introit, Psalm 96:7–8, calls all God's angels to adore Him. AO130, Dürer's Adoration of the Trinity / Landauer Altar, is an already-cleared image of the heavenly assembly adoring the Trinity."},"Tempora/PentEpi6-0":{"properPath":"Tempora/PentEpi6-0","label":"Resumed Sixth Sunday after Epiphany","status":"GREEN","relationship":"INTROIT_ART","decisionSource":"v43.2 inherited base correction","primaryArtId":"AO130","note":"Inherits the corrected Epiphany VI Proper image, AO130."},"Tempora/Pasc4-0":{"properPath":"Tempora/Pasc4-0","label":"Fourth Sunday after Easter","status":"GREEN","relationship":"ALLELUIA_ART","decisionSource":"v43.2 full-Proper scripture audit","primaryArtId":"AO099","note":"The Alleluia quotes Romans 6:9, Christ risen from the dead dies no more. AO099, Rubens's Resurrection of Christ, is an already-cleared exact scriptural image."},"Tempora/Pent16-0":{"properPath":"Tempora/Pent16-0","label":"Sixteenth Sunday after Pentecost","status":"GREEN","relationship":"GOSPEL_ART","decisionSource":"v43.2 full-Proper scripture audit","primaryArtId":"AO144","note":"The Monreale Cathedral mosaic depicts Christ healing the man with dropsy in the Pharisee's house, exactly Luke 14:1–6. Use restrained no-zoom delivery because the public-domain crop is 700×984."},"Tempora/Quad3-0":{"properPath":"Tempora/Quad3-0","label":"Third Sunday of Lent","status":"GREEN","relationship":"GOSPEL_ART","decisionSource":"v43.2 full-Proper scripture audit","primaryArtId":"AO145","note":"The Monreale mosaic shows Jesus exorcising the mute possessed man. Iconclass treats Matthew 9:32–34 and Luke 11:14–16 as the same mute-exorcism subject; this directly matches the opening miracle and Beelzebub controversy of the Proper Gospel. Use no-zoom delivery."},"Tempora/Quad5-0":{"properPath":"Tempora/Quad5-0","label":"Passion Sunday","status":"GREEN","relationship":"COMMUNION_ART","decisionSource":"v43.2 full-Proper scripture audit","primaryArtId":"AO146","note":"The Communion is 1 Corinthians 11:24–25 ('This is My Body... this chalice... in My Blood'). Leonardo's Last Supper is the canonical masterpiece of the institution narrative, giving Passion Sunday an exact Communion-derived image."}});
const ARTWORKS=Object.freeze({"AO142":{"artId":"AO142","title":"Tree of Jesse","artist":"Hans Holbein the Elder","institution":"Städel Museum, Frankfurt am Main (permanent loan from Historisches Museum Frankfurt)","date":"1501","medium":"Mixed technique on spruce wood","accession":"HM 6","file":"Tree of Jesse (SM hm6).png","sourcePage":"https://commons.wikimedia.org/wiki/File:Tree_of_Jesse_(SM_hm6).png","license":"Public Domain","rights":"PDM","attribution":null,"width":2168,"height":2407,"roles":["EPISTLE_ART"],"qualityGate":"PASS"},"AO143":{"artId":"AO143","title":"Parable of the Wheat and the Tares","artist":"Abraham Bloemaert","institution":"The Walters Art Museum, Baltimore","date":"1624","medium":"Oil on canvas","accession":"37.2505","file":"Abraham Bloemaert - Parable of the Wheat and the Tares - Google Art Project.jpg","sourcePage":"https://commons.wikimedia.org/wiki/File:Abraham_Bloemaert_-_Parable_of_the_Wheat_and_the_Tares_-_Google_Art_Project.jpg","license":"Public Domain","rights":"PD-Art / PDM","attribution":null,"width":7452,"height":5672,"roles":["GOSPEL_ART"],"qualityGate":"PASS"},"AO144":{"artId":"AO144","title":"Christ Healing the Man with Dropsy in the Pharisee's House","artist":"Byzantine / Norman-Sicilian mosaic workshop","institution":"Cathedral of Monreale, Sicily","date":"12th century","medium":"Mosaic","file":"Christ in the pharisee's house (Monreale).jpg","sourcePage":"https://commons.wikimedia.org/wiki/File:Christ_in_the_pharisee%27s_house_(Monreale).jpg","license":"Public Domain","rights":"PD-self","attribution":null,"width":700,"height":984,"roles":["GOSPEL_ART"],"qualityGate":"PASS","deliveryPolicy":"DISPLAY_READY_NO_ZOOM"},"AO145":{"artId":"AO145","title":"Jesus Exorcising the Mute Possessed Man","artist":"Byzantine / Norman-Sicilian mosaic workshop","institution":"Cathedral of Monreale, Sicily","date":"12th century","medium":"Mosaic","file":"Monreale - Healing of the Demon-Possessed Man.jpg","sourcePage":"https://commons.wikimedia.org/wiki/File:Monreale_-_Healing_of_the_Demon-Possessed_Man.jpg","license":"Public Domain","rights":"PDM / PD-old","attribution":null,"width":376,"height":550,"roles":["GOSPEL_ART"],"qualityGate":"PASS","deliveryPolicy":"DISPLAY_READY_NO_ZOOM"},"AO146":{"artId":"AO146","title":"The Last Supper","artist":"Leonardo da Vinci","institution":"Museo del Cenacolo Vinciano / Santa Maria delle Grazie, Milan","date":"1495–1498","medium":"Dry wall-painting","file":"Leonardo da Vinci - The Last Supper high res.jpg","sourcePage":"https://commons.wikimedia.org/wiki/File:DaVinci_LastSupper_high_res_2_nowatmrk.jpg","license":"Public Domain","rights":"PD-Art / PDM","attribution":null,"width":5381,"height":2926,"roles":["COMMUNION_ART"],"qualityGate":"PASS"}});
const priorHomeMarkup=art.homeMarkup.bind(art),priorEffectiveRow=art.effectiveRow?.bind(art),priorEffectiveRows=art.effectiveRows?.bind(art),priorEffectiveArtwork=art.effectiveArtwork?.bind(art),priorEffectiveArtworks=art.effectiveArtworks?.bind(art);
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
const thumb=(file,width)=>file?`https://commons.wikimedia.org/wiki/Special:Redirect/file/${encodeURIComponent(file)}?width=${width}`:'';
function effectiveArtwork(id){return ARTWORKS[id]||priorEffectiveArtwork?.(id)||null}
function effectiveRow(path){path=String(path||'');return ROWS[path]||priorEffectiveRow?.(path)||null}
function renderRow(path,r,lang='en'){
 if(!r||r.status!=='GREEN'||!r.primaryArtId)return '';
 const a=effectiveArtwork(r.primaryArtId);if(!a||!a.file||!a.sourcePage)return '';
 const license=a.license||a.rights||'',attribution=a.attribution||'';
 const attr=attribution&&/^CC BY/i.test(license)&&!attribution.toLowerCase().includes('cc by')?`${attribution} · ${license}`:(attribution||license);
 const alt=`${a.artist||''} — ${a.title||r.label||''}`;
 const ratio=(Number(a.width)||1)/(Number(a.height)||1),orientation=ratio<0.82?'isPortrait':ratio>1.22?'isLandscape':'isBalanced';
 const nativeW=Number(a.width)||768,loW=Math.min(nativeW,768);
 const maxW=a.deliveryPolicy==='DISPLAY_READY_NO_ZOOM'?Math.min(nativeW,1280):Math.min(nativeW,1280);
 const hiW=a.deliveryPolicy==='DISPLAY_READY_NO_ZOOM'?Math.min(nativeW,1800):Math.min(nativeW,1800);
 const src=thumb(a.file,maxW),slo=thumb(a.file,loW),shi=thumb(a.file,hiW);
 return `<figure class="aoProperArt ${orientation}" data-ao-proper-art="${esc(r.primaryArtId)}" data-proper-path="${esc(path)}"><div class="aoProperArtMedia"><img src="${esc(src)}" srcset="${esc(slo)} ${loW}w, ${esc(src)} ${maxW}w, ${esc(shi)} ${hiW}w" sizes="(max-width:560px) 100vw, 720px" alt="${esc(alt)}" loading="eager" fetchpriority="high" decoding="async" referrerpolicy="no-referrer" onerror="this.closest('figure')?.remove()"></div><figcaption><span><strong>${esc(a.artist||'')}</strong>${a.title?` · ${esc(a.title)}`:''}${attr?`<br><small>${esc(attr)}</small>`:''}</span><a href="${esc(a.sourcePage)}" target="_blank" rel="noopener noreferrer">${lang==='fr'?'Source':'Source'} ↗</a></figcaption></figure>`;
}
function homeMarkup(state,lang='en'){const path=art.properPath(state);if(ROWS[path])return renderRow(path,ROWS[path],lang);return priorHomeMarkup(state,lang)}
function effectiveRows(){return Object.assign({},priorEffectiveRows?.()||{},ROWS)}
function effectiveArtworks(){return Object.assign({},priorEffectiveArtworks?.()||{},ARTWORKS)}
function inspect(){
 const er=effectiveRows(),ea=effectiveArtworks(),vals=Object.values(er).filter(Boolean);
 const counts={rows:vals.length,green:vals.filter(r=>r.status==='GREEN').length,hold:vals.filter(r=>r.status==='HOLD').length,noArt:vals.filter(r=>r.status==='NO_ART').length,inheritPending:vals.filter(r=>r.status==='INHERIT_PENDING').length,artworks:Object.keys(ea).length,overrideRows:Object.keys(ROWS).length,newArtworks:Object.keys(ARTWORKS).length};
 const remainingNoArt=vals.filter(r=>r.status==='NO_ART').map(r=>r.properPath).sort();
 const expectedNoArt=['Tempora/Pasc5-0','Tempora/Pent05-0','Tempora/Pent17-0'];
 const checks={
  expectedCounts:counts.rows===93&&counts.green===90&&counts.hold===0&&counts.noArt===3&&counts.inheritPending===0&&counts.artworks===79&&counts.overrideRows===9&&counts.newArtworks===5,
  advent2:effectiveRow('Tempora/Adv2-0')?.primaryArtId==='AO142',
  epi5:effectiveRow('Tempora/Epi5-0')?.primaryArtId==='AO143'&&effectiveRow('Tempora/PentEpi5-0')?.primaryArtId==='AO143',
  epi6:effectiveRow('Tempora/Epi6-0')?.primaryArtId==='AO130'&&effectiveRow('Tempora/PentEpi6-0')?.primaryArtId==='AO130',
  easter4:effectiveRow('Tempora/Pasc4-0')?.primaryArtId==='AO099',
  pent16:effectiveRow('Tempora/Pent16-0')?.primaryArtId==='AO144',
  lent3:effectiveRow('Tempora/Quad3-0')?.primaryArtId==='AO145',
  passionSunday:effectiveRow('Tempora/Quad5-0')?.primaryArtId==='AO146',
  septuagesimaRetained:effectiveRow('Tempora/Quadp1-0')?.primaryArtId==='AO141',
  remainingNoArt:JSON.stringify(remainingNoArt)===JSON.stringify(expectedNoArt)
 };
 return {version:'full-proper-scripture-art-audit-v43.2',pass:Object.values(checks).every(Boolean),counts,remainingNoArt,checks};
}
art.homeMarkup=homeMarkup;art.effectiveRow=effectiveRow;art.effectiveRows=effectiveRows;art.effectiveArtwork=effectiveArtwork;art.effectiveArtworks=effectiveArtworks;art.closureBatch='FULL-PROPER-SCRIPTURE-ART-AUDIT-v43.2';
globalThis.AO_FULL_PROPER_ART_V432=Object.freeze({version:'full-proper-scripture-art-audit-v43.2',rows:ROWS,artworks:ARTWORKS,inspect});
try{globalThis.AO_RUNTIME_V8?.controller?.home?.paint?.()}catch{}
})();
</script>


<script id="ao-v434-proper-art-complete-js">
