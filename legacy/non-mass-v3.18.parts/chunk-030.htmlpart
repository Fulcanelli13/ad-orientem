#aoPrayerBookRoot .lab-prayer-sheet>.lab-practice-note:not(label){
  background:none!important;
  border:0!important;
  border-left:1px solid var(--liturgical-border)!important;
  border-radius:0!important;
  padding:0 0 0 13px!important;
  margin:8px 0 10px!important;