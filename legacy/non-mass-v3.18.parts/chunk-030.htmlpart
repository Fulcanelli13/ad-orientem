  border:0!important;
  border-radius:0!important;
  background:none!important;
  color:var(--liturgical)!important;
  text-decoration:none!important;
}

/* Lead copy should orient, not compete with the prayer title. */
#aoPrayerBookRoot .lab-practice-lead.ao-v392-prayer-lead{
  margin:-1px 0 11px!important;
  color:var(--muted-2)!important;
  font-size:.76rem!important;
  line-height:1.35!important;
}

/* Repeated structural notices in Rosary / Stations become micro-rubrics. */
