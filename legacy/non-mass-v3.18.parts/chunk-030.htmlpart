<style id="ao-v362-traditional-hub-stability-css">
#ao-v26-exercises .aoV362TradHome{padding-top:18px}.aoV362TradLead{margin:0 0 16px;color:var(--muted);line-height:1.5}.aoV362TradLearn{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.aoV362TradLearn button{min-height:70px;padding:12px;border:1px solid var(--border);border-radius:12px;background:var(--surface-1);color:var(--text);text-align:left}.aoV362TradLearn strong,.aoV362TradLearn span{display:block}.aoV362TradLearn span{margin-top:4px;color:var(--muted);font-size:.78rem;line-height:1.35}@media(max-width:360px){.aoV362TradLearn{grid-template-columns:1fr}}
</style>
<script id="ao-v362-traditional-hub-stability-js">
(()=>{'use strict';
const base=window.AO_TRAD_V26, modern=window.AO_TRAD_V352;if(!base||!modern)return;
const VERSION='36.2-traditional-hub-stability';let mode='closed',domain='pray';
const root=()=>document.getElementById('ao-v26-exercises');
function showRoot(){const r=root();if(!r)return null;r.hidden=false;r.setAttribute('aria-hidden','false');document.body.classList.add('aoV26Open');return r}
function close(){const r=root();if(r){r.hidden=true;r.setAttribute('aria-hidden','true')}document.body.classList.remove('aoV26Open');mode='closed';return true}
function renderHub(){close();mode='hub';const target=domain==='assist'?'mass':domain==='learn'?'learn':'pray';return !!window.AO_V37_SHELL?.openDomain?.(target)}
function open(id=null){if(id&&modern.ready?.includes?.(id)){mode='module';showRoot();const ok=modern.open(id);queueMicrotask(()=>{const b=root()?.querySelector('[data-v352-home]');if(b){b.removeAttribute('data-v352-home');b.setAttribute('data-v362-trad-back','')}});return ok}return renderHub()}
function back(){if(window.AO_NAV_V362?.peekReturn?.()){close();queueMicrotask(()=>window.AO_NAV_V362?.returnToCaller?.());return true}if(mode==='module')return renderHub();if(mode==='hub')return close();return false}
window.AO_TRAD_V26={...base,version:VERSION,open,close,back,getState:()=>({...base.getState?.(),v362Mode:mode,v362Domain:domain})};
// Capture before the older v35.2 bubble handlers so Back never re-enters the legacy hub.
document.addEventListener('click',e=>{const b=e.target.closest?.('button');if(!b)return;if(b.matches('[data-v362-trad-back]')){e.preventDefault();e.stopImmediatePropagation();if(window.AO_NAV_V362?.peekReturn?.()){close();queueMicrotask(()=>window.AO_NAV_V362?.returnToCaller?.());return}close();setTimeout(renderHub,0);return}if(b.matches('[data-v352-close]')&&mode==='module'&&!window.AO_NAV_V362?.qa?.().externalReturn){e.preventDefault();e.stopImmediatePropagation();close();return}},true);
window.AO_TRAD_HUB_V362={version:VERSION,open:renderHub,close,back,getState:()=>({mode,domain})};
})();
</script>
<script id="ao-v362-traditional-hub-stability-meta">window.AO_V362_TRAD_HUB={version:'36.2',legacyHubRemoved:true,sourceRenderersChanged:false};</script>
<style id="ao-v40-harmonization-css">
/* v40 — final cross-branch harmonization. Functional content remains owned by its source branch. */
#aoV38Traditions .v381Group>small,#aoV38Traditions .v381Cue{color:var(--liturgical)!important;font-family:var(--font-display)!important}
#aoV38Traditions .v381Reader,#aoV38Traditions .v381Prompt,#aoV38Traditions .v381Answer strong{font-family:var(--font-liturgical)!important;color:var(--text)}
#aoV38Traditions .v381PrayerList button,#aoV38Traditions .v381TrainerNav button,#aoV38Traditions .v381Compare>article,#aoV38Traditions .v381SeasonGrid button{background:var(--surface-1)!important;border-color:var(--border)!important;color:var(--text)!important;box-shadow:none!important}
#aoV38Traditions .v381Lang button.active,#aoV38Traditions .v381Answer{background:var(--liturgical-soft)!important;border-color:var(--liturgical-border)!important}
#aoV38Traditions .v381Lang button{color:var(--muted);border-color:var(--border)}
#aoV38Traditions .v381PrayerList small,#aoV38Traditions .v381Compare ol,#aoV38Traditions .v381Compare ul,#aoV38Traditions .v381SeasonGrid span{color:var(--muted)!important}
/* Quiet communal recitation remains semantic rather than badge-heavy. */
#aoPrayerBookRoot .aoGroupResponseKicker{display:none!important}
#aoPrayerBookRoot.aoRecitationGroup .aoPrayerDialogueLine.aoResponse,#aoPrayerBookRoot .aoCustomaryResponse{background:color-mix(in srgb,var(--liturgical) 5%,transparent)!important;border-left:2px solid color-mix(in srgb,var(--liturgical) 58%,transparent)!important}
/* Global containment guard. */
html,body,#app{max-width:100%;overflow-x:hidden}
#aoPrayerBookRoot,#aoV38Traditions,#ao-v26-exercises,.aoLearnShell,.aoCateShell{max-width:100vw;overflow-x:hidden}
@media(max-width:680px){
 #aoPrayerBookRoot .lab-library-grid,#aoPrayerBookRoot .pbModuleGrid,#aoV38Traditions .v381Compare,#aoV38Traditions .v381SeasonGrid{grid-template-columns:1fr!important}
}
</style>

<script id="ao-v40-meta">window.AO_V40_META={version:'v40',baseline:'v39.1-PRAYER-VISUAL-HARMONIZATION',merged:['v38.1 Universal Tradition Phase 2','v37.2.2 Quiet Group Recitation','v39.1 Prayer Visual Harmonization','v36.2 canonical navigation'],sanitation:['literal escaped-newline body artefacts removed','single-owner Traditional Exercises Home launchers','mobile containment'],massEngineChanged:false,calendarEngineChanged:false};(()=>{const set=()=>{try{if(!globalThis.AO_RELEASE_AUTHORITY_V4359)document.title='Ad Orientem 2.0 · v40 Harmonized Master'}catch(e){}};set();if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',set,{once:true});})()</script>


<!-- v41 harmonized sibling-delta integration -->
<style id="ao-v392-group-recitation-harmonization-css">
/* v39.2 — quiet Group recitation inside v39.1's native dark prayer surfaces.
   This deliberately overrides the older v37.2 "response card" treatment. */

#aoPrayerBookRoot .lab-prayer-flip{
  white-space:normal!important;
  color:var(--text)!important;
}

/* Genuine source dialogue. */
#aoPrayerBookRoot .aoPrayerDialogueLine{
  display:grid!important;
  grid-template-columns:1.55rem minmax(0,1fr)!important;
  gap:.38rem!important;
  align-items:start!important;
  margin:.28rem 0!important;
  color:var(--text)!important;
}
#aoPrayerBookRoot .aoPrayerRole{
  color:var(--liturgical)!important;
  background:transparent!important;
  border:0!important;
  font-family:var(--font-liturgical)!important;
  font-weight:600!important;
  font-size:1em!important;
  line-height:1.5!important;
  letter-spacing:0!important;
}
#aoPrayerBookRoot .aoPrayerDialogueBody,
#aoPrayerBookRoot .aoPrayerWords{
  color:var(--text)!important;
  background:transparent!important;
}

/* Group mode: one quiet cue, not a separate card. */
html.aoRecitationGroup #aoPrayerBookRoot .aoPrayerDialogueLine.aoResponse{
  padding:.2rem .34rem!important;
  border:0!important;
  border-left:2px solid color-mix(in srgb,var(--liturgical) 58%,transparent)!important;
  border-radius:0 4px 4px 0!important;
  background:color-mix(in srgb,var(--liturgical) 5%,transparent)!important;
  color:var(--text)!important;
}
#aoPrayerBookRoot .aoGroupResponseKicker{display:none!important}

/* Ordinary prose and intentional paragraph gaps in mixed prayers. */
#aoPrayerBookRoot .aoPrayerProse{
  display:block!important;
  margin:.1rem 0!important;
  color:var(--text)!important;
}
#aoPrayerBookRoot .aoPrayerSpacer{
  display:block!important;
  height:.62rem!important;
}

/* Customary communal division for Pater / Ave / Gloria.
   No fake ℣./℟. characters are introduced. */
#aoPrayerBookRoot .aoCustomarySplit{
  display:block!important;
  margin:.32rem 0!important;
  color:var(--text)!important;
}
#aoPrayerBookRoot .aoCustomaryLeader,
#aoPrayerBookRoot .aoCustomaryResponse{
  display:block!important;
  color:var(--text)!important;
  line-height:1.55!important;
}
#aoPrayerBookRoot .aoCustomaryLeader{
  padding:.06rem .1rem .2rem!important;
}
#aoPrayerBookRoot .aoCustomaryResponse{
  padding:.24rem .38rem!important;
  border-left:2px solid color-mix(in srgb,var(--liturgical) 54%,transparent)!important;
  border-radius:0 4px 4px 0!important;
  background:color-mix(in srgb,var(--liturgical) 5%,transparent)!important;
}
#aoPrayerBookRoot .aoSrOnly{
  position:absolute!important;
  width:1px!important;height:1px!important;
  padding:0!important;margin:-1px!important;
  overflow:hidden!important;clip:rect(0,0,0,0)!important;
  white-space:nowrap!important;border:0!important;
}

/* Litanies: lighter still, because the response repeats continuously. */
#aoPrayerBookRoot .aoLitanyLine{
  display:grid!important;
  gap:.12rem!important;
  margin:.22rem 0!important;
  color:var(--text)!important;
}
#aoPrayerBookRoot .aoLitanyCall,
#aoPrayerBookRoot .aoLitanyResponse{
  display:grid!important;
  grid-template-columns:1.55rem minmax(0,1fr)!important;
  gap:.38rem!important;
  align-items:start!important;
  color:var(--text)!important;
}
html.aoRecitationGroup #aoPrayerBookRoot .aoLitanyResponse{
  padding:.1rem .24rem .1rem .32rem!important;
  border-left:2px solid color-mix(in srgb,var(--liturgical) 42%,transparent)!important;
  border-radius:0 3px 3px 0!important;
  background:color-mix(in srgb,var(--liturgical) 3%,transparent)!important;
}
#aoPrayerBookRoot .aoLitanyLine.aoGroupLitany .aoLitanyResponse{
  /* neutralize old v37.2 stronger band if stale markup is encountered */
  border-top:0!important;border-right:0!important;border-bottom:0!important;
}

/* Roman Before / After Mass response rows use the same shared recitation state. */
.prayerFlip .aoRomanDialogueLine,
.romanCorpus .aoRomanDialogueLine{
  display:grid!important;
  grid-template-columns:1.55rem minmax(0,1fr)!important;
  gap:.38rem!important;
  align-items:start!important;
  margin:.26rem 0!important;
}
.aoRomanSpacer{display:block!important;height:.58rem!important}
html.aoRecitationGroup .prayerFlip .aoRomanDialogueLine.aoResponse,
html.aoRecitationGroup .romanCorpus .aoRomanDialogueLine.aoResponse{
  padding:.2rem .34rem!important;
  border-left:2px solid color-mix(in srgb,var(--liturgical) 54%,transparent)!important;
  border-radius:0 4px 4px 0!important;
  background:color-mix(in srgb,var(--liturgical) 5%,transparent)!important;
  color:var(--text)!important;
}

/* Keep the recitation control visually subordinate to the prayer itself. */
#aoPrayerBookRoot .lab-recitation-mode{
  background:rgba(255,255,255,.022)!important;
  border-color:var(--border)!important;
}
#aoPrayerBookRoot .lab-recitation-mode button.active,
.rc2Segments button[data-rc2-flow-recitation].active{
  background:var(--liturgical-soft)!important;
  border-color:var(--liturgical-border)!important;
  color:var(--text)!important;
}
</style>
<script id="ao-v392-group-recitation-bootstrap">
(()=>{'use strict';
 function sync(){
  let group=false;
  try{group=localStorage.getItem('ao-prayer-recitation-mode')==='group'}catch{}
  document.documentElement.classList.toggle('aoRecitationGroup',group);
  return group;
 }
 sync();
 document.addEventListener('click',e=>{
  const b=e.target.closest?.('[data-ao-recitation],[data-rc2-flow-recitation]');
  if(!b)return;
  const mode=b.dataset.aoRecitation||b.dataset.rc2FlowRecitation;
  if(mode!=='group'&&mode!=='individual')return;
  try{localStorage.setItem('ao-prayer-recitation-mode',mode)}catch{}
  queueMicrotask(sync);
 },true);
 window.AO_GROUP_RECITATION_V392={version:'39.2',sync};
})();
</script>
<style id="ao-v392-prayer-focus-css">
/* v39.2 — Prayer Focus / Editorial De-emphasis
   Principle: what is required to pray stays visible; provenance, history,
   source criticism and optional custom move into a quiet disclosure layer. */

/* Classification badges are metadata, not prayer content. */
#aoPrayerBookRoot .ao-v392-editorial-meta{
  display:block!important;
  width:max-content!important;
  max-width:100%!important;
  margin:0!important;
  padding:0!important;
  border:0!important;
  border-radius:0!important;
  background:none!important;
  color:var(--muted-2)!important;
  font:500 .66rem/1.35 var(--font-display)!important;
  letter-spacing:.045em!important;
  text-transform:uppercase!important;
}

/* Ministerial-role warnings remain visible, but as a rubric cue rather than a badge. */
#aoPrayerBookRoot .ao-v392-role-cue{
  display:block!important;
  margin:0 0 7px!important;
  padding:0!important;
  border:0!important;
  border-radius:0!important;
  background:none!important;
  color:var(--rubric)!important;
  font:600 .68rem/1.35 var(--font-display)!important;
  letter-spacing:.055em!important;
  text-transform:uppercase!important;
}

/* Explanatory notices no longer look like primary devotional cards. */
#aoPrayerBookRoot .ao-v392-inline-cue,
#aoPrayerBookRoot .pbContextNotice.ao-v392-inline-cue,
#aoPrayerBookRoot .lab-practice-note.ao-v392-inline-cue{
  display:block!important;
  margin:7px 0 11px!important;
  padding:0 0 0 15px!important;
  border:0!important;
  border-left:1px solid var(--liturgical-border)!important;
  border-radius:0!important;
  background:none!important;
  color:var(--muted)!important;
  font:400 .76rem/1.42 var(--font-liturgical)!important;
  box-shadow:none!important;
}
#aoPrayerBookRoot .ao-v392-inline-cue strong{color:var(--muted-2)!important;font-weight:600!important}

/* Short section labels such as Act of Contrition should read like headings, not callouts. */
#aoPrayerBookRoot .lab-practice-note:has(> strong:only-child){
  margin:12px 0 6px!important;
  padding:0!important;
  border:0!important;
  background:none!important;
  color:var(--muted-2)!important;
  font-size:.72rem!important;
  letter-spacing:.04em!important;
  text-transform:uppercase!important;
}

/* Setup / option controls stay available but recede visually. */
#aoPrayerBookRoot .pbPracticeToggle,
#aoPrayerBookRoot label.lab-practice-note{
  background:rgba(255,255,255,.012)!important;
  border:1px solid color-mix(in srgb,var(--border) 72%,transparent)!important;
  color:var(--muted)!important;
  box-shadow:none!important;
}
#aoPrayerBookRoot .pbPracticeToggle strong,
#aoPrayerBookRoot label.lab-practice-note strong{color:var(--text)!important;font-weight:600!important}

/* The new disclosure is deliberately quieter than every prayer surface. */
#aoPrayerBookRoot .ao-v392-disclosure{
  margin:15px 0 0!important;
  padding:0!important;
  border:0!important;
  border-top:1px solid color-mix(in srgb,var(--border) 70%,transparent)!important;
  background:none!important;
}
#aoPrayerBookRoot .ao-v392-disclosure>summary{
  list-style:none!important;
  cursor:pointer!important;
  padding:9px 1px 3px!important;
  color:var(--muted-2)!important;
  font:500 .68rem/1.4 var(--font-display)!important;
  letter-spacing:.045em!important;
  text-transform:uppercase!important;
}
#aoPrayerBookRoot .ao-v392-disclosure>summary::-webkit-details-marker{display:none!important}
#aoPrayerBookRoot .ao-v392-disclosure>summary::before{content:'ⓘ ';color:var(--liturgical)!important}
#aoPrayerBookRoot .ao-v392-disclosure[open]>summary{color:var(--text)!important}
#aoPrayerBookRoot .ao-v392-disclosure-body{
  display:grid!important;
  gap:8px!important;
  padding:7px 0 2px!important;
  color:var(--muted)!important;
  font-size:.78rem!important;
  line-height:1.45!important;
}
#aoPrayerBookRoot .ao-v392-disclosure-body .lab-source-row,
#aoPrayerBookRoot .ao-v392-disclosure-body .lab-source-note,
#aoPrayerBookRoot .ao-v392-disclosure-body .pbSource,
#aoPrayerBookRoot .ao-v392-disclosure-body .pbSourceRow{
  margin:0!important;
  padding:0!important;
  border:0!important;
  background:none!important;
  color:var(--muted)!important;
  font-size:inherit!important;
}
#aoPrayerBookRoot .ao-v392-disclosure-body .lab-source-row a,
#aoPrayerBookRoot .ao-v392-disclosure-body .pbSourceRow a{
