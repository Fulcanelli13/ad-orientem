 const license=a.license||a.rights||'',attribution=a.attribution||'';
 const attr=attribution&&/^CC BY/i.test(license)&&!attribution.toLowerCase().includes('cc by')?`${attribution} · ${license}`:(attribution||license);
 const alt=`${a.artist||''} — ${a.title||r.label||''}`;
 const ratio=(Number(a.width)||1)/(Number(a.height)||1),orientation=ratio<0.82?'isPortrait':ratio>1.22?'isLandscape':'isBalanced';
 const src=thumb(a.file,1280),s800=thumb(a.file,768),s1800=thumb(a.file,1800);
 return `<figure class="aoProperArt ${orientation}" data-ao-proper-art="${esc(r.primaryArtId)}" data-proper-path="${esc(path)}"><div class="aoProperArtMedia"><img src="${esc(src)}" srcset="${esc(s800)} 768w, ${esc(src)} 1280w, ${esc(s1800)} 1800w" sizes="(max-width:560px) 100vw, 720px" alt="${esc(alt)}" loading="eager" fetchpriority="high" decoding="async" referrerpolicy="no-referrer" onerror="this.closest('figure')?.remove()"></div><figcaption><span><strong>${esc(a.artist||'')}</strong>${a.title?` · ${esc(a.title)}`:''}${attr?`<br><small>${esc(attr)}</small>`:''}</span><a href="${esc(a.sourcePage)}" target="_blank" rel="noopener noreferrer">${lang==='fr'?'Source':'Source'} ↗</a></figcaption></figure>`;
}
function homeMarkup(state,lang='en'){
 const path=art.properPath(state),r=resolveRow(path);
 if(!r)return baseHomeMarkup(state,lang);
 return renderRow(path,r,lang);
}
function effectiveRows(){
 const merged={...art.data.rows};
 for(const path of Object.keys(ROWS))merged[path]=resolveRow(path);
 return merged;
}
function effectiveArtwork(id){return art.data?.artworks?.[id]||ARTWORKS[id]||null}
function inspect(){
 const resolved=Object.values(ROWS).map(r=>resolveRow(r.properPath));
 const overlay={
  total:resolved.length,
  green:resolved.filter(r=>r.status==='GREEN').length,
  noArt:resolved.filter(r=>r.status==='NO_ART').length,
  hold:resolved.filter(r=>r.status==='HOLD').length,
  inheritPending:resolved.filter(r=>r.status==='INHERIT_PENDING').length,
  inheritRules:Object.values(ROWS).filter(r=>r.status==='INHERIT_BASE').length,
  directReuse:Object.values(ROWS).filter(r=>r.status==='GREEN').length,
  promotedArtworkRecords:Object.keys(ARTWORKS).length
 };
 const base=art.inspect?.()||{};
 const effective={
  green:(base.green||0)+overlay.green,
  hold:(base.hold||0)+overlay.hold,
  noArt:(base.noArt||0)+overlay.noArt,
  inheritPending:overlay.inheritPending,
  rows:Object.keys(art.data?.rows||{}).length+overlay.total,
  artworks:Object.keys(art.data?.artworks||{}).length+Object.keys(ARTWORKS).filter(id=>!art.data?.artworks?.[id]).length
 };
 return {version:'phase1-fast-closure-b1-v1.1',overlay,effective,base,pass:overlay.total===14&&overlay.green===5&&overlay.noArt===6&&overlay.inheritPending===3&&overlay.inheritRules===4&&overlay.promotedArtworkRecords===1&&effective.green===52&&effective.hold===2&&effective.noArt===7&&effective.rows===64&&effective.artworks===50};
}
art.homeMarkup=homeMarkup;
art.effectiveRow=path=>resolveRow(String(path||''));
art.effectiveRows=effectiveRows;
art.effectiveArtwork=effectiveArtwork;
art.closureBatch='PM12-B1';
globalThis.AO_PHASE1_FAST_CLOSURE_B1=Object.freeze({version:'phase1-fast-closure-b1-v1.1',rows:ROWS,artworks:ARTWORKS,resolveRow,effectiveArtwork,inspect});
try{globalThis.AO_RUNTIME_V8?.controller?.home?.paint?.()}catch{}
})();
</script>
<script id="ao-v427-scripture-persistent-cache">
(()=>{'use strict';
if(globalThis.AO_SCRIPTURE_CACHE_V427)return;
const VERSION='resolved-scripture-doc-v1';
const PREFIX='ao2:scripture-v427:';
const INDEX_KEY=PREFIX+'index';
const MAX_ENTRIES=16;
const MAX_ITEM_CHARS=500000;
const MAX_TOTAL_CHARS=2000000;
const MAX_AGE_MS=180*24*60*60*1000;
const stats={installed:false,hits:0,misses:0,writes:0,fallbacks:0,skips:0,errors:0,lastError:null};
let memoryIndex=[],memoryDocs=new Map(),retryTimer=0;
function lsGet(k){try{return localStorage.getItem(k)}catch{return null}}
function lsSet(k,v){try{localStorage.setItem(k,v);return true}catch{return false}}
function lsDel(k){try{localStorage.removeItem(k)}catch{}}
function hash(s){let h=2166136261>>>0;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return (h>>>0).toString(36)}
function canonical(v){if(v===null||v===undefined)return v;if(Array.isArray(v))return v.map(canonical);if(typeof v==='object'){const o={};Object.keys(v).sort().forEach(k=>{if(typeof v[k]!=='function')o[k]=canonical(v[k])});return o}return v}
function signature(kind,text,options){return JSON.stringify({kind:String(kind||''),text:canonical(text),options:{contextOnly:!!options?.contextOnly}})}
function keyFor(sig){return PREFIX+'doc:'+hash(sig)}
function readIndex(){const raw=lsGet(INDEX_KEY);if(raw){try{const x=JSON.parse(raw);if(Array.isArray(x))return x}catch{}}return memoryIndex.slice()}
function writeIndex(x){memoryIndex=x.slice();lsSet(INDEX_KEY,JSON.stringify(x))}
function prune(index){const now=Date.now();let rows=index.filter(x=>x&&x.key&&now-(+x.savedAt||0)<=MAX_AGE_MS).sort((a,b)=>(+b.savedAt||0)-(+a.savedAt||0));let total=0,keep=[];for(const x of rows){const sz=+x.size||0;if(keep.length>=MAX_ENTRIES||total+sz>MAX_TOTAL_CHARS){lsDel(x.key);memoryDocs.delete(x.key);continue}keep.push(x);total+=sz}writeIndex(keep);return keep}
function read(sig){const key=keyFor(sig);let raw=lsGet(key);if(raw===null&&memoryDocs.has(key))raw=memoryDocs.get(key);if(!raw){stats.misses++;return null}try{const rec=JSON.parse(raw);if(rec?.version!==VERSION||rec?.sig!==sig||!rec?.doc){stats.misses++;return null}if(Date.now()-(+rec.savedAt||0)>MAX_AGE_MS){lsDel(key);memoryDocs.delete(key);stats.misses++;return null}stats.hits++;return rec}catch(e){stats.errors++;stats.lastError=String(e?.message||e);return null}}
function validDoc(doc){return !!(doc&&typeof doc==='object'&&(doc.reference||Array.isArray(doc.parts)))}
function write(sig,doc){if(!validDoc(doc)){stats.skips++;return false}let raw;try{raw=JSON.stringify({version:VERSION,sig,savedAt:Date.now(),doc})}catch{stats.skips++;return false}if(raw.length>MAX_ITEM_CHARS){stats.skips++;return false}const key=keyFor(sig);memoryDocs.set(key,raw);let ok=lsSet(key,raw);if(!ok){let idx=readIndex().sort((a,b)=>(+a.savedAt||0)-(+b.savedAt||0));const cut=Math.max(1,Math.ceil(idx.length/2));for(const x of idx.slice(0,cut)){lsDel(x.key);memoryDocs.delete(x.key)}idx=idx.slice(cut);writeIndex(idx);ok=lsSet(key,raw)}if(!ok){stats.skips++;return false}let idx=readIndex().filter(x=>x.key!==key);idx.unshift({key,savedAt:Date.now(),size:raw.length});prune(idx);stats.writes++;return true}
function cachedDoc(rec,reason){const doc=rec?.doc;if(doc&&typeof doc==='object'){try{Object.defineProperty(doc,'__aoPersistentCache',{value:{version:VERSION,savedAt:rec.savedAt,reason},enumerable:false,configurable:true})}catch{}}return doc}
function install(){const svc=globalThis.AO_RUNTIME_V8?.scriptureService;if(!svc||typeof svc.load!=='function')return false;if(svc.__aoPersistentCacheV427){stats.installed=true;return true}const original=svc.load.bind(svc);svc.load=async function(kind,text,options={}){const sig=signature(kind,text,options),cached=read(sig);if(cached&&typeof navigator!=='undefined'&&navigator.onLine===false){stats.fallbacks++;return cachedDoc(cached,'offline')}try{const doc=await original(kind,text,options);write(sig,doc);return doc}catch(e){if(cached){stats.fallbacks++;return cachedDoc(cached,'network-error')}stats.errors++;stats.lastError=String(e?.message||e);throw e}};Object.defineProperty(svc,'__aoPersistentCacheV427',{value:{version:VERSION,original},configurable:false});stats.installed=true;return true}
function schedule(){return install()}
function clear(){for(const x of readIndex())lsDel(x.key);lsDel(INDEX_KEY);memoryIndex=[];memoryDocs.clear()}
const API={version:VERSION,install,clear,inspect(){const idx=prune(readIndex()),bytes=idx.reduce((n,x)=>n+(+x.size||0),0);return{version:VERSION,installed:stats.installed,entries:idx.length,bytes,maxEntries:MAX_ENTRIES,maxChars:MAX_TOTAL_CHARS,maxAgeDays:180,hits:stats.hits,misses:stats.misses,writes:stats.writes,fallbacks:stats.fallbacks,skips:stats.skips,errors:stats.errors,lastError:stats.lastError}}};
globalThis.AO_SCRIPTURE_CACHE_V427=Object.freeze(API);
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',schedule,{once:true});else schedule();window.addEventListener('pageshow',schedule);window.addEventListener('online',schedule);
})();
</script>
<script id="ao-v427-network-content-resilience-meta">
(()=>{'use strict';
window.AO_V427_META=Object.freeze({version:'42.7-network-content-resilience',baseline:'v42.6 Catechism Offline Prefetch + PM12 B1 art overlay',inspect(){const prior=globalThis.AO_V426_META?.inspect?.()||{};const batch=globalThis.AO_PHASE1_FAST_CLOSURE_B1?.inspect?.()||{};const cache=globalThis.AO_SCRIPTURE_CACHE_V427?.inspect?.()||{};const source=globalThis.AO_V425_META?.inspect?.()||{};const checks={prior:prior.pass===true,batch:batch.pass===true,sourceHead:source.pass===true,cacheApi:cache.version==='resolved-scripture-doc-v1',effectiveArt:batch?.effective?.green===52&&batch?.effective?.hold===2&&batch?.effective?.noArt===7&&batch?.effective?.inheritPending===3&&batch?.effective?.rows===64&&batch?.effective?.artworks===50,sourcePending:(globalThis.AO_V425_META?.remainingSourcePending||[]).length===2};const pass=Object.values(checks).every(Boolean);try{document.documentElement.dataset.aoV427Integrity=pass?'pass':'fail'}catch{}return{pass,checks,batch,cache,source}}});
const run=()=>{try{globalThis.AO_SCRIPTURE_CACHE_V427?.install?.();window.AO_V427_META.inspect()}catch{}};run();if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',run,{once:true});
})();
</script>
