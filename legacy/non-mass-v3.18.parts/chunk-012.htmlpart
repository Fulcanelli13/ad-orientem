function aoInsertSolemnPax(steps){
    if(steps.some(s=>s.id==='solemn-pax')) return steps;
    const idx=steps.findIndex(s=>s.id==='peace-prayer');
    if(idx<0) return steps;
    const pax={
        id:'solemn-pax',phase:'Communion',section:'Pax',
        title:{lat:'Pax tecum',en:'The Pax',fr:'Le baiser de paix'},
        subtitle:{en:'The celebrant gives the Pax to the deacon; it passes through the sacred ministers and clergy.',fr:'Le célébrant donne la paix au diacre ; elle se transmet ensuite aux ministres sacrés et au clergé.'},
        actor:'sacred_ministers',priestPosition:'Centre of the altar',audibility:'audible',privateAction:false,
        text:{lat:'℣. Pax tecum.\n℟. Et cum spíritu tuo.',en:'℣. Peace be with thee.\n℟. And with thy spirit.',fr:'℣. La paix soit avec vous.\n℟. Et avec votre esprit.'},
        ceremonialCues:[
