function aoSolemnCue(actor,en,fr,authority='SOT12_OC64_SOLEMN'){
    const labels={DEACON:{en:'Deacon',fr:'Diacre'},SUBDEACON:{en:'Subdeacon',fr:'Sous-diacre'},THURIFER:{en:'Thurifer',fr:'Thuriféraire'},TORCHBEARERS:{en:'Torchbearers',fr:'Céroféraires'},SACRED_MINISTERS:{en:'Sacred ministers',fr:'Ministres sacrés'}};
