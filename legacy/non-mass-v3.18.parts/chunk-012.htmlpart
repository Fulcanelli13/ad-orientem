            aoSolemnCue('SUBDEACON','The subdeacon carries the Pax through the clergy in hierarchical order.','Le sous-diacre porte la paix au clergé selon l’ordre hiérarchique.')
        ],
        sourceMomentRefs:['E55'],canonicalEventRefs:['MC-0066'],canonicalIdentityPolicy:'MC_RUNTIME_IDENTITY_V1',prototypeTraversalCanonical:false
    };
    return [...steps.slice(0,idx+1),pax,...steps.slice(idx+1)];
}
function aoRepairSolemnStep(step){
    let next={...step};
    const cues=[...(next.ceremonialCues||[])];
    const dropCue=(pred)=>{for(let i=cues.length-1;i>=0;i--)if(pred(cues[i]))cues.splice(i,1);};
    if(step.id==='entrance-procession') next={...next,actor:'sacred_ministers',audibility:'silent',privateAction:false,voiceAuthority:'SOT12_E01_SOLEMN_PROCESSION'};
    if(step.id==='ministers-confiteor') next={...next,actor:'sacred_ministers',voiceAuthority:'SOT12_E05_SACRED_MINISTERS'};
