function aoBindLowObjectiveSequence(sequence,state) {
    if (sequence?.form !== 'low') return sequence;
    const specialProfile=String(state?.resolution?.day?.selectedMassOption?.path||'');
    const steps=(sequence.steps||[]).map((step,index)=>{
        const refs=AO_LOW_MC_BINDINGS_V4357[step.id]||null;
        const sourceRefs=AO_LOW_MC_SOURCE_V4357[step.id]||step.sourceMomentRefs||[];
        let next={...step};
        if (refs) {
            next={...next,
                canonicalEventRefs:[...refs], sourceMomentRefs:[...sourceRefs],
                canonicalIdentityPolicy:'MC_RUNTIME_IDENTITY_V1', prototypeTraversalCanonical:false,
                objectiveMassForm:'LOW', objectiveMcStatus:step.id==='second-confiteor'?'HISTORICAL_OVERLAY':'BOUND_B005',
                objectiveMcPrimary:refs[0], objectiveMcTimeline:[...refs], objectiveProjectionIndex:index
            };
        } else {
            next={...next, objectiveMassForm:'LOW', objectiveMcStatus:'UNMAPPED_SPECIAL_OR_NONCORE_OVERLAY', prototypeTraversalCanonical:false};
        }
        // B005 objective corrections. Participation cues remain a later projection layer.
        if(step.id==='entrance-procession') next={...next,audibility:'silent',privateAction:false,voiceAuthority:'SOT12_E01_PUBLIC_VISIBLE'};
        if(step.id==='gospel-prep') next={...next,actor:'celebrant',audibility:'quiet',privateAction:true,voiceAuthority:'SOT12_E16_LOW_MUNDA_COR_MEUM'};
        if(step.id==='ministers-confiteor') next={...next,actor:'server',voiceAuthority:'SOT12_E05_SERVER_CONFITEOR'};
        if(step.id==='priest-communion') next={...next,actor:'celebrant',voiceAuthority:'RG60_511_LOW_MASS_CLEAR_DNSD_PLUS_SECRET_COMMUNION_FORMULAS'};
        if(step.id==='communion-warning-bell') next={...next,actor:'server',audibility:'audible',privateAction:false,voiceAuthority:'MR62_E60_PRESCRIBED_MINISTER_WARNING'};
        if(step.id==='domine-non-sum-dignus') next={...next,actor:'celebrant',audibility:'audible',privateAction:false,voiceAuthority:'MR62_RG60_E63_PRIEST_ALOUD_COMMUNICANTS_MAY_JOIN'};
        if(step.id==='second-confiteor') next={...next,objectiveCanonical1962:false,objectiveMcStatus:'HISTORICAL_OVERLAY',historicalOnly:true};
        return next;
