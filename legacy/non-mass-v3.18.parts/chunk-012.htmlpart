        cues.push(aoSolemnCue('SUBDEACON','The subdeacon chants the Epistle at the appointed place, then returns for the celebrant’s blessing.','Le sous-diacre chante l’Épître au lieu prévu, puis revient recevoir la bénédiction du célébrant.'));
    }
    if(step.id==='gospel-prep') next={...next,actor:'deacon',audibility:'quiet',privateAction:true,priestPosition:'Altar / Gospel procession forming',voiceAuthority:'SOT12_OC64_E16_DEACON_MUNDA_COR_MEUM',executionState:{deacon:['CARRIES_EVANGELIARIUM_TO_ALTAR','ASSISTS_AT_INCENSE','KNEELS_FOR_MUNDA_COR_MEUM','RECEIVES_CELEBRANT_BLESSING','FORMS_GOSPEL_PROCESSION'],celebrant:['IMPOSES_INCENSE','BLESSES_DEACON'],subdeacon:['JOINS_GOSPEL_PROCESSION']}};
    if(step.id==='gospel-announcement') next={...next,actor:'deacon',audibility:'audible',privateAction:false,priestPosition:'Gospel place',voiceAuthority:'SOT12_OC64_E18_DEACON_PUBLIC_PROCLAMATION'};
    if(step.id==='gospel') next={...next,actor:'deacon',audibility:'audible',privateAction:false,priestPosition:'Gospel place',voiceAuthority:'SOT12_OC64_E18_DEACON_PUBLIC_PROCLAMATION'};
    if(step.id==='incense-off') next={...next,actor:'sacred_ministers',audibility:'silent',privateAction:false,voiceAuthority:'SOT12_OC64_E27_NONVERBAL_SOLEMN_INCENSATION'};
    if(step.id==='consecration-host'){
        dropCue(c=>c.actor==='SERVER' || /server.*chasuble/i.test(String(c?.text?.en||'')));
        cues.push(aoSolemnCue('DEACON','The deacon kneels close to the celebrant and raises the chasuble only while the Sacred Host is elevated.','Le diacre s’agenouille près du célébrant et soulève la chasuble seulement pendant l’élévation de la sainte Hostie.'));
        cues.push(aoSolemnCue('SUBDEACON','The subdeacon kneels and looks upon the elevated Host as prescribed.','Le sous-diacre s’agenouille et regarde l’Hostie élevée selon le cérémonial prescrit.'));
        cues.push(aoSolemnCue('TORCHBEARERS','Torchbearers kneel with lighted torches during the Elevation.','Les céroféraires s’agenouillent avec les cierges allumés pendant l’Élévation.'));
    }
    if(step.id==='consecration-chalice'){
        dropCue(c=>c.actor==='SERVER' || /server.*chasuble/i.test(String(c?.text?.en||'')));
        cues.push(aoSolemnCue('DEACON','The deacon kneels close to the celebrant and raises the chasuble only while the Chalice is elevated.','Le diacre s’agenouille près du célébrant et soulève la chasuble seulement pendant l’élévation du calice.'));
        cues.push(aoSolemnCue('SUBDEACON','The subdeacon kneels and looks upon the elevated Chalice as prescribed.','Le sous-diacre s’agenouille et regarde le calice élevé selon le cérémonial prescrit.'));
        cues.push(aoSolemnCue('TORCHBEARERS','Torchbearers remain kneeling with lighted torches through the Elevation.','Les céroféraires restent agenouillés avec les cierges allumés pendant l’Élévation.'));
    }
    if(step.id==='libera-nos'){
        cues.push(aoSolemnCue('DEACON','The deacon receives the paten from the subdeacon and presents it to the celebrant.','Le diacre reçoit la patène du sous-diacre et la présente au célébrant.'));
        cues.push(aoSolemnCue('SUBDEACON','The subdeacon hands the paten to the deacon for the celebrant.','Le sous-diacre remet la patène au diacre pour le célébrant.'));
    }
    if(step.id==='priest-communion'){
        dropCue(c=>c.actor==='SERVER' || /server prepares/i.test(String(c?.text?.en||'')));
        cues.push(aoSolemnCue('DEACON','The deacon prepares to assist at the Communion of the sacred ministers and faithful.','Le diacre se prépare à assister à la Communion des ministres sacrés et des fidèles.'));
    }
    if(step.id==='communion-faithful'){
        dropCue(c=>c.actor==='SERVER' || /server accompanies/i.test(String(c?.text?.en||'')));
        next={...next,actor:'sacred_ministers',voiceAuthority:'SOT12_OC64_E64_SOLEMN_COMMUNION'};
        cues.push(aoSolemnCue('DEACON','The deacon assists the celebrant and holds the Communion paten during distribution.','Le diacre assiste le célébrant et tient le plateau de Communion pendant la distribution.'));
        cues.push(aoSolemnCue('SUBDEACON','If communicating, the subdeacon receives before the clergy and faithful according to the Solemn order.','S’il communie, le sous-diacre reçoit avant le clergé et les fidèles selon l’ordre de la Messe solennelle.'));
    }
    if(step.id==='ablutions'){
        dropCue(c=>['SERVER','SERVERS'].includes(c.actor));
        next={...next,actor:'sacred_ministers',voiceAuthority:'SOT12_OC64_E65_SOLEMN_ABLUTIONS'};
        cues.push(aoSolemnCue('SUBDEACON','The subdeacon ministers wine and water for the ablutions, then reassembles and veils the chalice.','Le sous-diacre sert le vin et l’eau pour les ablutions, puis remet le calice en ordre et le voile.'));
        cues.push(aoSolemnCue('DEACON','The deacon transfers the Missal back to the Epistle side.','Le diacre reporte le Missel au côté de l’Épître.'));
    }
    if(step.id==='communion-proper') next={...next,actor:'mixed',audibility:'mixed',privateAction:false,voiceAuthority:'SOT12_E66_PARALLEL_CHOIR_CELEBRANT'};
    if(step.id==='last-gospel-announcement'||step.id==='last-gospel'){
        next={...next,actor:'celebrant',audibility:'quiet',privateAction:true,voiceAuthority:'SOT12_OC64_E70_SOLEMN_SECRET_WITH_SUBDEACON_RESPONSES'};
        if(step.id==='last-gospel') cues.push(aoSolemnCue('SUBDEACON','The subdeacon gives the prescribed responses and joins the Gospel signs/genuflection when not holding the altar card.','Le sous-diacre donne les réponses prescrites et accomplit les signes de l’Évangile et la génuflexion lorsqu’il ne tient pas le carton d’autel.'));
    }
    if(cues.length) next.ceremonialCues=cues;
    return next;
}
