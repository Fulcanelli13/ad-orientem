};

renderStations=function(){
 const i=S.station,l=lang(),titles=D.stationTitles[l]||D.stationTitles.en;
 if(i===0)return `<div class="pbShell"><div class="pbFlow">${top(t('Stations of the Cross','Chemin de Croix'))}<section class="pbHero"><div class="eyebrow">VIA CRUCIS · XIV</div><h2>${t('St Alphonsus Liguori','Saint Alphonse de Liguori')}</h2><p>${t('The traditional fourteen-station form is the typical form recommended in the Church’s Directory on Popular Piety. Ad Orientem uses the familiar St Alphonsus devotional form.','La forme traditionnelle en quatorze stations est la forme typique recommandée par le Directoire de l’Église sur la piété populaire. Ad Orientem utilise la forme dévotionnelle familière de saint Alphonse.')}</p></section><div class="pbModuleGrid"><button class="pbModule ${S.stationMode==='guided'?'featured':''}" data-pb-station-mode="guided"><strong>${t('Guided','Guidé')}</strong><span>${t('St Alphonsus meditation + prayer','Méditation + prière de saint Alphonse')}</span></button><button class="pbModule ${S.stationMode==='simple'?'featured':''}" data-pb-station-mode="simple"><strong>${t('Simple','Simple')}</strong><span>Pater · Ave · Gloria</span></button></div><label class="pbPracticeToggle"><input type="checkbox" data-pb-stabat ${S.stationStabat?'checked':''}><span><strong>Stabat Mater</strong><br><span class="pbTiny">${t('Optional traditional stanza between stations. Latin remains primary; tap the stanza for an editorial literal vernacular translation.','Strophe traditionnelle facultative entre les stations. Le latin demeure principal ; touchez la strophe pour une traduction littérale éditoriale.')}</span></span></label><button class="pbPrimary" data-pb-station-next>${t('Begin the XIV Stations','Commencer les XIV Stations')} →</button>${aoFormation('Traditional practice and source-critical note','Pratique traditionnelle et note sur les sources',`<p>${t('The present fourteen-station order became stable in the seventeenth century and was strongly promoted by St Leonard of Port Maurice. The Directory calls it the typical form and notes that the devotion is especially fitting in Lent.','L’ordre actuel des quatorze stations s’est stabilisé au XVIIe siècle et fut fortement propagé par saint Léonard de Port-Maurice. Le Directoire l’appelle la forme typique et souligne qu’il convient particulièrement au Carême.')}</p><p>${t('Not every traditional station is a direct Gospel episode: the three falls and Veronica belong principally to received devotional tradition. Ad Orientem therefore does not label them as explicit Gospel narratives. Current pastoral guidance also recommends ending with Christian hope in the Resurrection; this does not create a fifteenth station in the traditional XIV form.','Toutes les stations traditionnelles ne correspondent pas à un épisode évangélique explicite : les trois chutes et Véronique appartiennent principalement à la tradition dévotionnelle reçue. Ad Orientem ne les présente donc pas comme récits évangéliques explicites. Les indications pastorales actuelles recommandent aussi de conclure dans l’espérance de la Résurrection ; cela ne crée pas une quinzième station dans la forme traditionnelle XIV.')}</p><div class="pbSourceRow"><a href="${AO_LINKS.stations}" target="_blank" rel="noopener">Directory §§131–135 ↗</a></div>`)}</div></div>`;
 const n=i-1,a=D.alphonsus[l]||D.alphonsus.en,vr=D.stationVR,ala=D.alphonsus.la;
 const guided=S.stationMode==='guided'?`<h3>${t('Consider','Considérez')}</h3><p>${esc(a[n].consider)}</p><h3>${t('Prayer of St Alphonsus','Prière de saint Alphonse')}</h3>${flipText(ala[n].prayer,a[n].prayer,'station-alphonsus-'+n,false)}`:'';
 const stabat=S.stationStabat&&n<13?`<div class="pbStationPractice"><div class="pbKicker">Stabat Mater · ${t('between stations','entre les stations')}</div>${flipText(D.stabat[n],(l==='fr'?AO_STABAT_FR:AO_STABAT_EN)[n],'stabat-'+n,false)}<div class="pbTiny">${t('Vernacular rendering: editorial literal translation; Latin is the controlling traditional hymn text.','Traduction vernaculaire : traduction littérale éditoriale ; le latin demeure le texte traditionnel de référence.')}</div></div>`:'';
 return `<div class="pbShell"><div class="pbFlow">${top(t('Stations of the Cross','Chemin de Croix'))}<div class="pbProgress"><span style="width:${(i/14*100).toFixed(1)}%"></span></div><section class="pbFlowCard"><div class="pbKicker">${['I','II','III','IV','V','VI','VII','VIII','IX','X','XI','XII','XIII','XIV'][n]} · XIV</div><h2>${esc(titles[n])}</h2><div class="pbMiniPrayer">${flipText(vr.la.join('\n'),vr[l].join('\n'),'station-vr-'+n,false)}</div>${guided}<div class="pbContextNotice">${t('Traditional station prayers: Pater noster · Ave Maria · Gloria Patri.','Prières traditionnelles de la station : Pater noster · Ave Maria · Gloria Patri.')}</div>${prayerBundle(['pater','ave','gloria'])}${stabat}</section><nav class="pbFlowNav"><button data-pb-station-prev>← ${t('Previous','Précédent')}</button><button data-pb-station-next>${i===14?t('Finish in hope of the Resurrection','Terminer dans l’espérance de la Résurrection'):t('Next station','Station suivante')} →</button></nav></div></div>`;
};

renderBenediction=function(){
 const seq=['benediction_o_salutaris','silence','benediction_tantum_ergo','benediction_versicles','blessing','benediction_divine_praises','benediction_adoremus_ps116'],i=S.benedictionStep,id=seq[i],p=D.prayers[id];let body='';
 if(id==='silence')body=`<div class="pbKicker">${t('Adoration','Adoration')}</div><h2>${t('Remain before the Blessed Sacrament','Demeurez devant le Saint-Sacrement')}</h2><p>${t('A real period of prayer and sacred silence belongs before Benediction. Current discipline explicitly forbids exposition whose sole purpose is simply to impart the blessing.','Un véritable temps de prière et de silence sacré doit précéder la bénédiction. La discipline actuelle interdit explicitement l’exposition dont le seul but serait simplement de donner la bénédiction.')}</p>`;
 else if(id==='blessing')body=`<div class="pbBenedictionMarker"><strong>${t('Benediction occurs here','La bénédiction a lieu ici')}</strong><p>${t('After Tantum Ergo, Panem de cælo and the collect, the priest or deacon blesses the faithful with the Blessed Sacrament. This is an action of the ordained minister, not a prayer for the lay user to simulate.','Après le Tantum Ergo, Panem de cælo et l’oraison, le prêtre ou le diacre bénit les fidèles avec le Saint-Sacrement. C’est un acte du ministre ordonné, non une prière à simuler par l’utilisateur laïc.')}</p></div>`;