<style id="ao-v4317-rich-icon-css">
/* Rich Lab-ora geometry; Ad Orientem owns the colour. Dark donor ground/cutouts are preserved structurally. */
.aoV4317RichIcon{
  width:36px;height:36px;display:block;flex:0 0 auto;overflow:visible;
  color:var(--liturgical,var(--gold,currentColor));
  --ao-rich-icon-ground-hi:color-mix(in srgb,var(--surface-2,var(--surface-1)) 86%,white 14%);
  --ao-rich-icon-ground:var(--surface-1);
  --ao-rich-icon-ground-lo:color-mix(in srgb,var(--bg) 92%,black 8%);
}
.aoV37CardMain.aoV4317Iconized{position:relative;padding-left:65px!important}
.aoV37CardMain.aoV4317Iconized>.aoV4317RichIcon{position:absolute;left:12px;top:13px;width:40px;height:40px}
.aoV37Card.featured .aoV4317RichIcon{color:var(--liturgical)}
#aoPrayerBookRoot button.aoV4317Iconized{position:relative;padding-left:52px!important}
#aoPrayerBookRoot button.aoV4317Iconized>.aoV4317RichIcon{position:absolute;left:12px;top:11px;width:29px;height:29px}
@media(max-width:430px){
 .aoV37CardMain.aoV4317Iconized{padding-left:59px!important}
 .aoV37CardMain.aoV4317Iconized>.aoV4317RichIcon{left:10px;top:13px;width:36px;height:36px}
}
</style>
<script id="ao-v4317-rich-icon-js">
(()=>{'use strict';
 const R=globalThis.AO_ICON_REGISTRY_V4333;
 const SYMBOLS=[...document.querySelectorAll('symbol[id^="ao-rich-"]')].map(x=>x.id);
 const noop=()=>({nativeOwnership:true});
 globalThis.AO_RICH_ICON_ADOPTION_V4317=Object.freeze({version:'43.17-compat-native-owned',source:'Lab-ora rich family',colourPolicy:'native renderer ownership',symbols:SYMBOLS,routeMap:R?.routeMap||Object.freeze({}),prayerBookMap:R?.pbMap||Object.freeze({}),decorate:noop,qa(){const missing=SYMBOLS.filter(id=>!document.getElementById(id));return{version:'43.17-compat-native-owned',missingSymbols:missing,mutationObserversAdded:0,nativeOwnership:true,pass:missing.length===0}}});
})();
</script>
<script id="ao-v4317-rich-icon-meta">
window.AO_V4317_RICH_ICON_META=Object.freeze({
 version:'43.17',
 base:'v43.14 Harmonized Master',
 donor:'Lab-ora RC10 rich 128x128 refined family',
 correction:'preserve donor dark ground/negative layer; map sacred foreground/highlights to Ad Orientem liturgical currentColor',
 eucharisticDomainCard:'Adoration & Benediction',
 separateBenedictionTopLevelCard:false,
 deepLinkBenedictionPreserved:true,
 massDomainIconChanged:false,
 prayerTextChanged:false,
 massEngineChanged:false,
 calendarEngineChanged:false,
 mutationObserverAdded:false
});
</script>
