        audibility:sung?'choir':'quiet', privateAction:!sung,
        posture:{value:'CUSTOM',policy:'local',source:'local'}, choir,
        explanation:sung
            ? 'The schola begins the Introit while the celebrant approaches the altar. The procession and chant therefore precede and overlap the transition into the Prayers at the Foot.'
            : 'The celebrant and server enter and approach the foot of the altar before the preparatory prayers begin.',
        ceremonialCues:[ceremonialCue('SERVERS',
            sung ? 'The servers accompany the entrance procession and take their places for the Prayers at the Foot.' : 'The server accompanies the celebrant to the foot of the altar.',
            sung ? 'Les servants accompagnent la procession d’entrée et prennent place pour les prières au bas de l’autel.' : 'Le servant accompagne le célébrant au bas de l’autel.',
            'CEREMONIAL_CONTEXT')]
    };
}
function insertEntranceProcession(steps, options, proper, properAvailable) {
    if (!genericEntranceAllowed(options) || steps.some(step => step.id === 'entrance-procession')) return steps;
    return [makeEntranceProcessionStep(options, proper, properAvailable), ...steps];
}
function ensureChoirDuplicate(next, id) {
    if (!next.text || (next.choir || []).some(ev => ev?.id === `${id}-choir` || ev?.properSlot === next.properSlot)) return next;
    return appendChoir(next, {id:`${id}-choir`, role:'choir', text:next.text, properSlot:next.properSlot, properStatus:next.properStatus, timing:'parallel'});
}
function applyAudibilityAndEarlyCeremonialRepair(steps, options) {
    const sung = options.form === 'sung';
    const incensed = sung && options.incenseSung !== false;
    return steps.map(step => {
        let next = { ...step };
        const cues = [...(next.ceremonialCues || [])];
        const add = (actor,en,fr,authority='CEREMONIAL_CONTEXT') => cues.push(ceremonialCue(actor,en,fr,authority));
        if (!sung && ['sign-cross','judica','adjutorium','priest-confiteor','ministers-confiteor','misereatur-vestri','indulgentiam-absolution','foot-versicles'].includes(step.id)) {
            next.audibility = 'audible';
            next.privateAction = false;
            next.voiceAuthority = 'RG60_511_CLEAR_VOICE';
            next.voiceNote = 'Low Mass: opening prayers through Oremus inclusive are said in a clear voice; Aufer a nobis and Oramus te remain secret.';
        }
        if (sung) {
            switch (step.id) {
                case 'introit':
                    next.privateAction = true;
                    next.audibility = 'mixed';
                    add('PRIEST','The celebrant reads the Introit privately at the Epistle side while the schola’s Introit is the audible track.','Le célébrant lit l’Introït à voix basse au côté de l’Épître tandis que l’Introït de la schola constitue la piste audible.','CEREMONIAL_1962');
                    break;
                case 'kyrie':
                    next.privateAction = true;
                    next.audibility = 'choir';
                    next.priestPosition = 'Centre · private Kyrie while the schola sings';
                    add('PRIEST','The celebrant recites the Kyrie privately with the ministers; the schola’s Kyrie may continue after he has finished.','Le célébrant récite le Kyrie à voix basse avec les ministres ; le Kyrie de la schola peut continuer après qu’il a terminé.','CEREMONIAL_1962');
                    break;
                case 'gloria':
                    next.privateAction = true;
                    next.audibility = 'mixed';
                    next.audibleFragment = AO_GLORIA_INTONATION;
                    next.priestPosition = 'Centre for intonation → may sit while choir continues → returns to altar before conclusion';
                    add('PRIEST','The celebrant sings the intonation, privately recites the remainder, may sit while the choir continues, and returns to the altar for the end of the Gloria.','Le célébrant chante l’intonation, récite le reste à voix basse, peut s’asseoir pendant que le chœur continue, puis revient à l’autel pour la fin du Gloria.','CEREMONIAL_1962');
                    break;
                case 'gradual':
                case 'alleluia':
                case 'sequence':
                    next = ensureChoirDuplicate(next, step.id);
                    next.actor = 'mixed';
                    next.privateAction = true;
                    next.audibility = 'choir';
                    next.priestPosition = 'Epistle side / altar · private reading while the schola sings';
                    add('PRIEST','The celebrant privately reads this Proper chant while the schola performs it independently; a long chant may continue after his reading is complete.','Le célébrant lit ce chant propre à voix basse tandis que la schola l’exécute indépendamment ; un chant long peut continuer après la fin de sa lecture.','CEREMONIAL_1962');
                    break;
                case 'gospel-prep':
                    add('PRIEST','The celebrant says Munda cor meum while the final interlection chant may still be ending.','Le célébrant récite Munda cor meum tandis que le dernier chant entre les lectures peut encore s’achever.','CEREMONIAL_1962');
                    if (incensed) add('THURIFER','Incense is imposed and blessed for the Gospel; the thurifer assists as the Gospel is prepared.','L’encens est imposé et béni pour l’Évangile ; le thuriféraire assiste à sa préparation.','CEREMONIAL_1962');