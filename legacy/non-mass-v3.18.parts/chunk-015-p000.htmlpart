    'extended-readings-mass-1962': { id: 'extended-readings-mass-1962', label: { en: 'Mass with additional lessons', fr: 'Messe avec lectures supplémentaires', lat: 'Missa cum lectionibus additis' }, invariants: ['All resolved preparatory lessons are inserted before the Epistle.'] },
