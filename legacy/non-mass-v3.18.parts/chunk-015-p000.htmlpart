exports.exceptionalFixedText = { holyThursdayDismissal: benedicamus, ordinaryDismissal: ordinary_1.fixedOrdinary.iteMissaEst, secondConfiteor: (0, ordinary_1.concatText3)([ordinary_1.fixedOrdinary.serverConfiteor, ordinary_1.fixedOrdinary.misereaturVestri, ordinary_1.fixedOrdinary.indulgentiam]) };

},34:function(module,exports,require){module.exports={"build":"A5 donor extraction from frozen v1.50 core","source":"fixtures/donor-ao-v17-new-engine-core.js","groups":{"candlemas":[{"id":"candlemas-blessing","phase":"Candlemas","section":"Special Rite · Candlemas","title":{"en":"Blessing of Candles","fr":"Blessing of Candles"},"subtitle":{"en":"Five blessing orations · 1962 rite","fr":"Five blessing orations · 1962 rite"},"actor":"mixed","priestPosition":"Sanctuary","audibility":"audible","privateAction":false,"text":{"lat":"℣. Dóminus vobíscum.\n℟. Et cum spíritu tuo.\n\nOrémus.\nDómine sancte, Pater omnípotens, ætérne Deus, qui ómnia ex níhilo creásti, et iussu tuo per ópera apum hunc liquórem ad perfectiónem cérei veníre fecísti: et qui hodiérna die petitiónem iusti Simeónis implésti: te humíliter deprecámur; ut has candélas ad usus hóminum et sanitátem córporum et animárum, sive in terra sive in aquis, per invocatiónem tui sanctíssimi nóminis et per intercessiónem beátæ Maríæ semper Vírginis, cuius hódie festa devóte celebrántur, et per preces ómnium Sanctórum tuórum, bene✠dícere et sancti✠ficáre dignéris: et huius plebis tuæ, quæ illas honorífice in mánibus desíderat portáre teque cantándo laudáre, exáudias voces de cælo sancto tuo et de sede maiestátis tuæ: et propítius sis ómnibus clamántibus ad te, quos redemísti pretióso Sánguine Fílii tui: Qui tecum vivit et regnat in sǽcula sæculórum.\n℟. Amen.\n\nOrémus.\nOmnípotens sempitérne Deus, qui hodiérna die Unigénitum tuum ulnis sancti Simeónis in templo sancto tuo suscipiéndum præsentásti: tuam súpplices deprecámur cleméntiam; ut has candélas, quas nos fámuli tui, in tui nóminis magnificéntiam suscipiéntes, gestáre cúpimus luce accénsas, bene✠dícere et sancti✠ficáre atque lúmine supérnæ benedictiónis accéndere dignéris: quaténus eas tibi Dómino Deo nostro offeréndo digni, et sancto igne dulcíssimæ caritátis tuæ succénsi, in templo sancto glóriæ tuæ repræsentári mereámur. Per eúndem Dóminum nostrum.\n℟. Amen.\n\nOrémus.\nDómine Iesu Christe, lux vera, quæ illúminas omnem hóminem veniéntem in hunc mundum: effúnde bene✠dictiónem tuam super hos céreos, et sanctí✠fica eos lúmine grátiæ tuæ, et concéde propítius; ut, sicut hæc luminária igne visíbili accénsa noctúrnas depéllunt ténebras; ita corda nostra invisíbili igne, id est, Sancti Spíritus splendóre illustráta, ómnium vitiórum cæcitáte cáreant: ut, purgáto mentis óculo, ea cérnere possímus, quæ tibi sunt plácita et nostræ salúti utília; quaténus post huius sǽculi caliginósa discrímina ad lucem indeficiéntem perveníre mereámur. Per te, Christe Iesu, Salvátor mundi, qui in Trinitáte perfécta vivis et regnas Deus, per ómnia sǽcula sæculórum.\n℟. Amen.\n\nOrémus.\nOmnípotens sempitérne Deus, qui per Móysen fámulum tuum puríssimum ólei liquórem ad luminária ante conspéctum tuum iúgiter concinnánda præparári iussísti: bene✠dictiónis tuæ grátiam super hos céreos benígnus infúnde; quaténus sic adminístrent lumen extérius, ut, te donánte, lumen Spíritus tui nostris non desit méntibus intérius. Per Dóminum nostrum.\n℟. Amen.\n\nOrémus.\nDómine Iesu Christe, qui hodiérna die in nostræ carnis substántia inter hómines appárens, a paréntibus in templo es præsentátus: quem Símeon venerábilis senex, lúmine Spíritus tui irradiátus, agnóvit, suscépit et benedíxit: præsta propítius; ut eiúsdem Spíritus Sancti grátia illumináti atque edócti, te veráciter agnoscámus et fidéliter diligámus: Qui cum Deo Patre.\n℟. Amen.","en":"℣. The Lord be with you.\n℟. And with thy spirit.\n\nLet us pray.\nO holy Lord, Father almighty, everlasting God, who hast created all things out of nothing, and by Thy command hast caused this liquid to become perfect wax by the labour of bees, and who on this day didst fulfil the petition of the righteous Simeon: we humbly entreat Thee that, by the invocation of Thy most holy Name, through the intercession of blessed Mary ever Virgin, whose feast is today devoutly observed, and by the prayers of all Thy Saints, Thou wouldst vouchsafe to bless ✠ and sanctify ✠ these candles for the use of men and for the health of their bodies and souls, whether on land or on water; and graciously hear from Thy holy heaven and from the throne of Thy majesty the voices of this Thy people, who desire to carry them honourably in their hands and to praise Thee in song; and be propitious to all who call upon Thee, whom Thou hast redeemed by the precious Blood of Thy Son: Who liveth and reigneth with Thee world without end.\n℟. Amen.\n\nLet us pray.\nO almighty and everlasting God, who on this day didst present Thine only-begotten Son in Thy holy temple to be received in the arms of holy Simeon: we humbly entreat Thy clemency that Thou wouldst vouchsafe to bless ✠ and sanctify ✠ and to kindle with the light of Thy heavenly benediction these candles, which we Thy servants desire to receive and to bear lighted in honour of Thy Name: that, by offering them to Thee our Lord God, being worthily inflamed with the holy fire of Thy most sweet charity, we may deserve to be presented in the holy temple of Thy glory. Through the same our Lord.\n℟. Amen.\n\nLet us pray.\nO Lord Jesus Christ, the true Light who enlightenest every man that cometh into this world: pour forth Thy blessing ✠ upon these candles, and sanctify ✠ them with the light of Thy grace; and mercifully grant that, as these lights enkindled with visible fire dispel the darkness of night, so our hearts, illumined by invisible fire, that is, by the splendour of the Holy Ghost, may be free from the blindness of every vice; that the eye of our mind being purified, we may discern what is pleasing to Thee and profitable to our salvation; so that after the perilous darkness of this life we may deserve to attain to never-failing light: through Thee, O Christ Jesus, Saviour of the world, who in the perfect Trinity livest and reignest God, world without end.\n℟. Amen.\n\nLet us pray.\nO almighty and everlasting God, who by Thy servant Moses didst command the purest oil to be prepared for lamps to burn continually before Thee: vouchsafe to pour forth the grace of Thy blessing ✠ upon these candles, that they may so afford us light outwardly that, by Thy gift, the light of Thy Spirit may never be wanting inwardly to our minds. Through our Lord.\n℟. Amen.\n\nLet us pray.\nO Lord Jesus Christ, who appearing on this day among men in the substance of our flesh wast presented by Thy parents in the temple; whom the venerable aged Simeon, illumined by the light of Thy Spirit, recognised, received into his arms and blessed: mercifully grant that, enlightened and taught by the grace of the same Holy Ghost, we may truly acknowledge Thee and faithfully love Thee: Who with God the Father.\n℟. Amen.","fr":"℣. Le Seigneur soit avec vous.\n℟. Et avec votre esprit.\n\nPrions.\nSeigneur saint, Père tout-puissant, Dieu éternel, qui a créé toutes choses de rien, et a voulu que le produit du travail des abeilles servît à former ces cierges. En ce jour, où tu as rempli l’attente et les souhaits du juste Siméon, nous te prions humblement, par l’invocation de ton très saint Nom, par l’intercession de la bienheureuse Marie toujours Vierge, dont nous célébrons aujourd’hui la fête avec piété, et par les prières de tous tes saints : daigne bénir et sanctifier ces cierges pour l’usage des hommes, en vue de la santé du corps et de l’âme, sur terre et sur mer. Du ciel, ton sanctuaire et du trône de ta majesté, écoute les prières de ton peuple ici présent, qui désire porter ces cierges en ton honneur et pour te louer par ses chants. Sois propice à ceux que tu as rachetés par le sang précieux de ton Fils, qui avec toi vit et règne en l’unité du Saint-Esprit, Dieu pour tous les siècles des siècles.\n℟. Amen.\n\nPrions.\nDieu tout-puissant et éternel, qui en ce jour a voulu que ton Fils unique te fût présenté dans ton saint Temple et qu’il y fût reçu dans les bras de saint Siméon, nous supplions humblement ta bonté de bénir, de sanctifier et d’allumer du feu de ta bénédiction céleste ces cierges que nous, tes serviteurs, nous recevons et que nous désirons porter pour la gloire de ton nom ; afin qu’en te les offrant, à toi, notre Seigneur Dieu, avec de dignes dispositions et embrasés du feu sacré de ta très douce charité, nous méritions d’être nous aussi présentés dans la sainteté du temple de ta gloire. Par notre même Seigneur Jésus-Christ, ton Fils, qui avec toi vit et règne en l’unité du Saint-Esprit, Dieu pour tous les siècles des siècles.\n℟. Amen.\n\nPrions.\nSeigneur Jésus-Christ, lumière véritable qui éclaire tout homme venant en ce monde : répands ta bénédiction sur ces cierges, et sanctifie-les par la lumière de ta grâce. De même que ces luminaires dissipent les ténèbres de la nuit par l’éclat de leur feu visible, fais par ta bonté qu’un feu invisible, c’est-à-dire la splendeur du Saint-Esprit, éclaire nos cœurs et les arrache à l’aveuglement des vices ; afin que, le regard de l’esprit étant clarifié, nous puissions discerner ce qui t’est agréable et ce qui est utile à notre salut, en sorte qu’après avoir quitté les ténèbres dangereuses de ce monde, nous méritions d’arriver à la lumière indéfectible. Par toi, Christ Jésus, Sauveur du monde, qui en la Trinité parfaite vis et règnes, Dieu pour tous les siècles des siècles.\n℟. Amen.\n\nPrions.\nDieu tout-puissant et éternel, qui as ordonné à ton serviteur Moïse de préparer des lampes garnies d’une huile très pure, et de les faire brûler sans cesse en ta présence ; sur ces cierges veuille donc répandre la grâce de ta bénédiction, en sorte qu’au don de leur lumière extérieure corresponde intérieurement dans nos âmes le don de la lumière de ton Esprit. Par Notre Seigneur Jésus-Christ, ton Fils, qui avec toi vit et règne en l’unité du même Saint-Esprit, Dieu pour tous les siècles des siècles.\n℟. Amen.\n\nPrions.\nSeigneur Jésus-Christ, qui en ce jour apparais revêtu de notre chair au milieu des hommes et es présenté au Temple par tes parents, tu es reconnu, reçu et béni par le vénérable vieillard Siméon, éclairé de la lumière de ton Esprit. Par la grâce de ce même Esprit, fais que nous aussi nous te reconnaissions vraiment et demeurions fidèles à ton amour, toi qui vis et règnes avec Dieu le Père en l’unité du même Saint-Esprit, Dieu pour tous les siècles des siècles.\n℟. Amen."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"Five orations bless the candles; they are then sprinkled with holy water and incensed before their distribution.","ritualActions":[],"exceptional":{"rite":"candlemas","phase":"Special Rite · Candlemas","liturgicalColour":"White"}},{"id":"candlemas-distribution","phase":"Candlemas","section":"Special Rite · Candlemas","title":{"en":"Distribution of Blessed Candles","fr":"Distribution of Blessed Candles"},"subtitle":{"en":"Lumen ad revelationem · Nunc dimittis","fr":"Lumen ad revelationem · Nunc dimittis"},"actor":"mixed","priestPosition":"Sanctuary","audibility":"audible","privateAction":false,"text":{"lat":"Ant. Lumen ad revelatiónem géntium: et glóriam plebis tuæ Israël.\n\nLuc 2:29-32\nNunc dimíttis servum tuum, Dómine, secúndum verbum tuum in pace.\nAnt. Lumen ad revelatiónem géntium: et glóriam plebis tuæ Israël.\nQuia vidérunt óculi mei salutáre tuum.\nAnt. Lumen ad revelatiónem géntium: et glóriam plebis tuæ Israël.\nQuod parásti ante fáciem ómnium populórum.\nAnt. Lumen ad revelatiónem géntium: et glóriam plebis tuæ Israël.\nGlória Patri, et Fílio, et Spirítui Sancto.\nAnt. Lumen ad revelatiónem géntium: et glóriam plebis tuæ Israël.\nSicut erat in princípio, et nunc, et semper, et in sǽcula sæculórum. Amen.\nAnt. Lumen ad revelatiónem géntium: et glóriam plebis tuæ Israël.\n\n℣. Dóminus vobíscum.\n℟. Et cum spíritu tuo.\nOrémus.\nExáudi, quǽsumus, Dómine, plebem tuam: et, quæ extrinsécus ánnua tríbuis devotióne venerári, intérius asséqui grátiæ tuæ luce concéde. Per Christum Dóminum nostrum.\n℟. Amen.","en":"Ant. A light for the revelation of the Gentiles, and the glory of Thy people Israel.\n\nLuke 2:29-32\nNow Thou dost dismiss Thy servant, O Lord, according to Thy word in peace.\nAnt. A light for the revelation of the Gentiles, and the glory of Thy people Israel.\nFor mine eyes have seen Thy salvation.\nAnt. A light for the revelation of the Gentiles, and the glory of Thy people Israel.\nWhich Thou hast prepared before the face of all peoples.\nAnt. A light for the revelation of the Gentiles, and the glory of Thy people Israel.\nGlory be to the Father, and to the Son, and to the Holy Ghost.\nAnt. A light for the revelation of the Gentiles, and the glory of Thy people Israel.\nAs it was in the beginning, is now, and ever shall be, world without end. Amen.\nAnt. A light for the revelation of the Gentiles, and the glory of Thy people Israel.\n\n℣. The Lord be with you.\n℟. And with thy spirit.\nLet us pray.\nHear Thy people, we beseech Thee, O Lord; and grant that what Thou givest us outwardly to venerate by this yearly devotion we may attain inwardly by the light of Thy grace. Through Christ our Lord.\n℟. Amen.","fr":"Lumière pour éclairer les nations, et gloire de votre peuple Israël.\n\nMaintenant, Seigneur, vous laissez votre serviteur s’en aller en paix selon votre parole…\n\nLes cierges sont aspergés d’eau bénite et encensés ; pendant la distribution, le Nunc dimittis est chanté avec Lumen ad revelationem."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"During the distribution, Lumen ad revelationem is repeated with the verses of the Nunc dimittis. The concluding prayer Exaudi, quaesumus, Domine follows before the procession.","ritualActions":[{"kind":"ritual_action","label":"Stand; ↓ kneel when receiving a candle according to the ceremony","source":"special_day_step"}],"exceptional":{"rite":"candlemas","phase":"Special Rite · Candlemas","liturgicalColour":"White"}},{"id":"candlemas-procession","phase":"Candlemas","section":"Special Rite · Candlemas","title":{"en":"Procession with Candles","fr":"Procession with Candles"},"subtitle":{"en":"Procedamus in pace · Adorna · Obtulerunt","fr":"Procedamus in pace · Adorna · Obtulerunt"},"actor":"mixed","priestPosition":"Procession","audibility":"audible","privateAction":false,"text":{"lat":"℣. Procedámus in pace.\n℟. In nómine Christi. Amen.\n\nAnt. Adórna thálamum tuum, Sion, et súscipe Regem Christum: ampléctere Maríam, quæ est cæléstis porta: ipsa enim portat Regem glóriæ novi lúminis: subsístit Virgo, addúcens mánibus Fílium ante lucíferum génitum: quem accípiens Símeon in ulnas suas, prædicávit pópulis Dóminum eum esse vitæ et mortis, et Salvatórem mundi.\n\nResp. Respónsum accépit Símeon a Spíritu Sancto, non visúrum se mortem, nisi vidéret Christum Dómini: et cum indúcerent púerum in templum, accépit eum in ulnas suas, et benedíxit Deum, et dixit: Nunc dimíttis servum tuum, Dómine, in pace.\n℣. Cum indúcerent púerum Iesum paréntes eius, ut fácerent secúndum consuetúdinem legis pro eo, ipse accépit eum in ulnas suas.\n℟. Et benedíxit Deum, et dixit: Nunc dimíttis servum tuum, Dómine, in pace.\n\nResp. Obtulérunt pro eo Dómino par túrturum, aut duos pullos columbárum: sicut scriptum est in lege Dómini.\n℣. Postquam impléti sunt dies purificatiónis Maríæ secúndum legem Móysi, tulérunt Iesum in Ierúsalem, ut sísterent eum Dómino.\n℟. Sicut scriptum est in lege Dómini.\n℣. Glória Patri, et Fílio, et Spirítui Sancto.\n℟. Sicut scriptum est in lege Dómini.","en":"℣. Let us go forth in peace.\n℟. In the name of Christ. Amen.\n\nAnt. Adorn thy bridal chamber, O Sion, and receive Christ the King; embrace Mary, who is the gate of heaven, for she bears the King of glory, the new Light. The Virgin stands, bringing in her hands the Son begotten before the morning star; Simeon, receiving Him into his arms, proclaimed to the peoples that He is the Lord of life and death and the Saviour of the world.\n\nResp. Simeon received an answer from the Holy Ghost that he should not see death before he had seen the Christ of the Lord; and when they brought the Child into the temple, he received Him into his arms, blessed God, and said: Now Thou dost dismiss Thy servant, O Lord, in peace.\n℣. When the parents brought in the Child Jesus to do for Him according to the custom of the law, Simeon received Him into his arms.\n℟. And blessed God, and said: Now Thou dost dismiss Thy servant, O Lord, in peace.\n\nResp. They offered for Him to the Lord a pair of turtledoves or two young pigeons, as it is written in the law of the Lord.\n℣. When the days of Mary's purification according to the law of Moses were fulfilled, they brought Jesus to Jerusalem to present Him to the Lord.\n℟. As it is written in the law of the Lord.\n℣. Glory be to the Father, and to the Son, and to the Holy Ghost.\n℟. As it is written in the law of the Lord.","fr":"℣. Avançons dans la paix.\n℟. Au nom du Christ. Ainsi soit-il.\n\nOrne ta chambre nuptiale, ô Sion…\n\nIls offrirent pour lui au Seigneur une paire de tourterelles ou deux jeunes colombes…"},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"After the distribution, Procedamus in pace begins the procession. Adorna accompanies the procession and Obtulerunt the return. When Mass follows this rite, the prayers at the foot are omitted.","ritualActions":[],"exceptional":{"rite":"candlemas","phase":"Special Rite · Candlemas","liturgicalColour":"White"}}],"ash_wednesday":[{"id":"ashes-antiphon","phase":"Ash Wednesday","section":"Special Rite · Ash Wednesday","title":{"en":"Blessing of the Ashes","fr":"Blessing of the Ashes"},"subtitle":{"en":"Exaudi nos · before Mass","fr":"Exaudi nos · before Mass"},"actor":"mixed","priestPosition":"Sanctuary","audibility":"choir","privateAction":false,"text":{"lat":"Ps 68:17\nExáudi nos, Dómine, quóniam benígna est misericórdia tua: secúndum multitúdinem miseratiónum tuárum réspice nos, Dómine.\nPs 68:2\nSalvum me fac, Deus: quóniam intravérunt aquæ usque ad ánimam meam.\n℣. Glória Patri, et Fílio, et Spirítui Sancto.\n℟. Sicut erat in princípio, et nunc, et semper, et in sǽcula sæculórum. Amen.\nExáudi nos, Dómine, quóniam benígna est misericórdia tua: secúndum multitúdinem miseratiónum tuárum réspice nos, Dómine.","en":"Ps 68:17\nGraciously hear us, O Lord, for Thy mercy is kind; according to the multitude of Thy tender mercies look upon us, O Lord.\nPs 68:2\nSave me, O God, for the waters are come in even unto my soul.\n℣. Glory be to the Father, and to the Son, and to the Holy Ghost.\n℟. As it was in the beginning, is now, and ever shall be, world without end. Amen.\nGraciously hear us, O Lord, for Thy mercy is kind; according to the multitude of Thy tender mercies look upon us, O Lord.","fr":"Ps 68, 17\nExaucez-nous, Seigneur, car votre miséricorde est pleine de bonté ; selon l’abondance de vos compassions, regardez-nous, Seigneur.\nPs 68, 2\nSauvez-moi, ô Dieu, car les eaux ont pénétré jusqu’à mon âme.\n℣. Gloire au Père, au Fils et au Saint-Esprit.\n℟. Comme il était au commencement, maintenant et toujours, et dans les siècles des siècles. Ainsi soit-il.\nExaucez-nous, Seigneur, car votre miséricorde est pleine de bonté ; selon l’abondance de vos compassions, regardez-nous, Seigneur."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"The Ash Wednesday rite begins with Exaudi nos and Psalm 68 before the four prayers that bless the ashes.","ritualActions":[],"exceptional":{"rite":"ash-wednesday","phase":"Special Rite · Ash Wednesday","liturgicalColour":"Violet"}},{"id":"ashes-four-prayers","phase":"Ash Wednesday","section":"Special Rite · Ash Wednesday","title":{"en":"Four Blessing Prayers","fr":"Four Blessing Prayers"},"subtitle":{"en":"Dominus vobiscum · four orations","fr":"Dominus vobiscum · four orations"},"actor":"mixed","priestPosition":"Epistle side","audibility":"audible","privateAction":false,"text":{"lat":"℣. Dóminus vobíscum.\n℟. Et cum spíritu tuo.\nOrémus.\nOmnípotens sempitérne Deus, parce pæniténtibus, propitiáre supplicántibus: et míttere dignéris sanctum Angelum tuum de cælis, qui bene✠dícat et sanctí✠ficet hos cíneres, ut sint remédium salúbre ómnibus nomen sanctum tuum humíliter implorántibus, ac semetípsos pro consciéntia delictórum suórum accusántibus, ante conspéctum divínæ cleméntiæ tuæ facínora sua deplorántibus, vel sereníssimam pietátem tuam supplíciter obnixéque flagitántibus: et præsta per invocatiónem sanctíssimi nóminis tui; ut, quicúmque per eos aspérsi fúerint, pro redemptióne peccatórum suórum, córporis sanitátem et ánimæ tutélam percípiant. Per Christum Dóminum nostrum.\n℟. Amen.\n\nOrémus.\nDeus, qui non mortem, sed pæniténtiam desíderas peccatórum: fragilitátem condiciónis humánæ benigníssime réspice; et hos cíneres, quos causa proferéndæ humilitátis atque promérendæ véniæ, capítibus nostris impóni decérnimus, bene✠dícere pro tua pietáte dignáre: ut, qui nos cínerem esse, et ob pravitátis nostræ deméritum in púlverem reversúros cognóscimus; peccatórum ómnium véniam et præmia pæniténtibus repromíssa misericórditer consequí mereámur. Per Christum Dóminum nostrum.\n℟. Amen.\n\nOrémus.\nDeus, qui humiliatióne flécteris et satisfactióne placáris: aurem tuæ pietátis inclína précibus nostris; et capítibus servórum tuórum, horum cínerum aspersióne contáctis, effúnde propítius grátiam tuæ benedictiónis: ut eos et spíritu compunctiónis répleas et, quæ iuste postuláverint, efficáciter tríbuas; et concéssa perpétuo stabílita et intácta manére decérnas. Per Christum Dóminum nostrum.\n℟. Amen.\n\nOrémus.\nOmnípotens sempitérne Deus, qui Ninivítis in cínere et cilício pæniténtibus indulgéntiæ tuæ remédia præstitísti: concéde propítius; ut sic eos imitémur hábitu, quátenus véniæ prosequámur obténtu. Per Christum Dóminum nostrum.\n℟. Amen.","en":"℣. The Lord be with you.\n℟. And with thy spirit.\nLet us pray.\nAlmighty and everlasting God, spare the penitent, be merciful to those who implore Thee, and deign to send Thy holy Angel from heaven to bless and sanctify these ashes, that they may be a wholesome remedy for all who humbly invoke Thy holy Name, accuse themselves because of their sins, lament their offences before Thy divine clemency, and earnestly implore Thy mercy. Grant that all who are sprinkled with them may receive, for the remission of their sins, health of body and protection of soul. Through Christ our Lord.\n℟. Amen.\n\nLet us pray.\nO God, who desirest not the death but the repentance of sinners, look graciously upon the frailty of our human condition and deign to bless these ashes which we resolve to place upon our heads as a sign of humility and a means of obtaining pardon; that, knowing ourselves to be dust and destined because of sin to return to dust, we may mercifully obtain forgiveness of all our sins and the rewards promised to penitents. Through Christ our Lord.\n℟. Amen.\n\nLet us pray.\nO God, who art moved by humiliation and appeased by satisfaction, incline the ear of Thy goodness to our prayers and mercifully pour forth upon the heads of Thy servants touched by these ashes the grace of Thy blessing; fill them with the spirit of compunction, grant effectually what they rightly ask, and establish for ever the gifts Thou hast granted. Through Christ our Lord.\n℟. Amen.\n\nLet us pray.\nAlmighty and everlasting God, who didst grant the healing of Thy pardon to the Ninevites doing penance in sackcloth and ashes, mercifully grant that we may imitate them in outward observance and follow them in obtaining forgiveness. Through Christ our Lord.\n℟. Amen.","fr":"℣. Le Seigneur soit avec vous.\n℟. Et avec votre esprit.\nPrions.\nDieu tout-puissant et éternel, pardonnez aux pénitents, accueillez favorablement ceux qui vous supplient, et daignez envoyer du ciel votre saint Ange pour bénir et sanctifier ces cendres, afin qu’elles soient un remède salutaire pour tous ceux qui invoquent humblement votre saint Nom, s’accusent eux-mêmes de leurs fautes, déplorent leurs péchés devant votre divine clémence et implorent instamment votre miséricorde. Accordez que tous ceux qui en seront marqués reçoivent, pour la rémission de leurs péchés, la santé du corps et la protection de l’âme. Par le Christ notre Seigneur.\n℟. Ainsi soit-il.\n\nPrions.\nÔ Dieu, qui ne voulez pas la mort mais la pénitence des pécheurs, regardez avec bonté la fragilité de notre condition humaine et daignez bénir ces cendres que nous avons décidé d’imposer sur nos têtes en signe d’humilité et pour obtenir le pardon ; afin que, reconnaissant que nous sommes poussière et que nous retournerons en poussière à cause du péché, nous méritions d’obtenir de votre miséricorde le pardon de tous nos péchés et les récompenses promises aux pénitents. Par le Christ notre Seigneur.\n℟. Ainsi soit-il.\n\nPrions.\nÔ Dieu, qui vous laissez fléchir par l’humilité et apaiser par la satisfaction, inclinez l’oreille de votre bonté vers nos prières ; répandez avec bienveillance la grâce de votre bénédiction sur les têtes de vos serviteurs touchées par ces cendres ; remplissez-les de l’esprit de componction, accordez efficacement ce qu’ils demandent avec justice et affermissez pour toujours les dons que vous leur aurez accordés. Par le Christ notre Seigneur.\n℟. Ainsi soit-il.\n\nPrions.\nDieu tout-puissant et éternel, qui avez accordé aux Ninivites pénitents dans la cendre et le cilice le remède de votre pardon, accordez-nous dans votre bonté de les imiter extérieurement afin d’obtenir comme eux le pardon. Par le Christ notre Seigneur.\n℟. Ainsi soit-il."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"The 1962 Missal gives four prayers for the blessing of the ashes.","ritualActions":[],"exceptional":{"rite":"ash-wednesday","phase":"Special Rite · Ash Wednesday","liturgicalColour":"Violet"}},{"id":"ashes-sprinkle-incense","phase":"Ash Wednesday","section":"Special Rite · Ash Wednesday","title":{"en":"Sprinkling and Incensing the Ashes","fr":"Sprinkling and Incensing the Ashes"},"subtitle":{"en":"Asperges me · without the psalm","fr":"Asperges me · without the psalm"},"actor":"mixed","priestPosition":"Epistle side","audibility":"silent","privateAction":false,"text":{"lat":"Aspérges me, Dómine, hyssópo, et mundábor: lavábis me, et super nivem dealbábor.","en":"Thou shalt sprinkle me, O Lord, with hyssop, and I shall be cleansed; Thou shalt wash me, and I shall become whiter than snow.","fr":"Vous m’aspergerez, Seigneur, avec l’hysope et je serai purifié ; vous me laverez et je deviendrai plus blanc que la neige."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"After the four prayers, the celebrant sprinkles the ashes three times with holy water while saying the Asperges me antiphon quietly without its psalm, then incenses the ashes three times without saying anything.","ritualActions":[],"exceptional":{"rite":"ash-wednesday","phase":"Special Rite · Ash Wednesday","liturgicalColour":"Violet"}},{"id":"ashes-imposition","phase":"Ash Wednesday","section":"Special Rite · Ash Wednesday","title":{"en":"Imposition of Ashes","fr":"Imposition of Ashes"},"subtitle":{"en":"Memento, homo · penitential chants","fr":"Memento, homo · penitential chants"},"actor":"mixed","priestPosition":"Altar / communion rail","audibility":"choir","privateAction":false,"text":{"lat":"Memento, homo, quia pulvis es, et in púlverem revertéris.\n\nIoel 2:13\nImmutémur hábitu, in cínere et cilício: ieiunémus et plorémus ante Dóminum: quia multum miséricors est dimíttere peccáta nostra Deus noster.\n\nIoel 2:17\nInter vestíbulum et altáre plorábunt sacerdótes minístri Dómini, et dicent: Parce, Dómine, parce pópulo tuo: et ne claudas ora canéntium te, Dómine.\n\nResp. Esth 13 et Ioel 2\nEmendémus in mélius, quæ ignoránter peccávimus: ne, súbito præoccupáti die mortis, quærámus spátium pæniténtiæ, et inveníre non póssimus. Atténde, Dómine, et miserére: quia peccávimus tibi.\n℣. Adiúva nos, Deus salutáris noster: et propter honórem nóminis tui, Dómine, líbera nos.\nAtténde, Dómine, et miserére: quia peccávimus tibi.\n℣. Glória Patri, et Fílio, et Spirítui Sancto.\nAtténde, Dómine, et miserére: quia peccávimus tibi.","en":"Remember, man, that thou art dust, and unto dust thou shalt return.\n\nJoel 2:13\nLet us change our dress for ashes and sackcloth; let us fast and weep before the Lord, for our God is abundantly merciful to forgive our sins.\n\nJoel 2:17\nBetween the porch and the altar the priests, the ministers of the Lord, shall weep and say: Spare, O Lord, spare Thy people, and close not the mouths of those who sing to Thee, O Lord.\n\nResp. Esth 13 and Joel 2\nLet us amend for the better the sins we have committed in ignorance, lest, suddenly overtaken by the day of death, we seek time for penance and be unable to find it. Look upon us, O Lord, and have mercy, for we have sinned against Thee.\n℣. Help us, O God our Saviour; and for the glory of Thy Name, O Lord, deliver us.\nLook upon us, O Lord, and have mercy, for we have sinned against Thee.\n℣. Glory be to the Father, and to the Son, and to the Holy Ghost.\nLook upon us, O Lord, and have mercy, for we have sinned against Thee.","fr":"Souviens-toi, homme, que tu es poussière et que tu retourneras en poussière.\n\nJoël 2, 13\nChangeons de vêtement, couvrons-nous de cendre et du cilice ; jeûnons et pleurons devant le Seigneur, car notre Dieu est infiniment miséricordieux pour pardonner nos péchés.\n\nJoël 2, 17\nEntre le vestibule et l’autel, les prêtres, ministres du Seigneur, pleureront et diront : Épargnez, Seigneur, épargnez votre peuple, et ne fermez pas la bouche de ceux qui chantent vos louanges, Seigneur.\n\nResp. Est 13 et Joël 2\nCorrigeons par une vie meilleure les fautes commises par ignorance, de peur que, surpris soudain par le jour de la mort, nous cherchions le temps de faire pénitence sans pouvoir le trouver. Regardez-nous, Seigneur, et ayez pitié de nous, car nous avons péché contre vous.\n℣. Secourez-nous, ô Dieu notre Sauveur ; pour l’honneur de votre nom, Seigneur, délivrez-nous.\nRegardez-nous, Seigneur, et ayez pitié de nous, car nous avons péché contre vous.\n℣. Gloire au Père, au Fils et au Saint-Esprit.\nRegardez-nous, Seigneur, et ayez pitié de nous, car nous avons péché contre vous."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"During the distribution, Immutemur, Inter vestibulum and the responsory Emendemus are sung or recited. Ministers and faithful receive the ashes kneeling.","ritualActions":[{"kind":"ritual_action","label":"↓ Kneel to receive the ashes","source":"special_day_step"}],"exceptional":{"rite":"ash-wednesday","phase":"Special Rite · Ash Wednesday","liturgicalColour":"Violet"}},{"id":"ashes-after-distribution","phase":"Ash Wednesday","section":"Special Rite · Ash Wednesday","title":{"en":"After the Imposition","fr":"After the Imposition"},"subtitle":{"en":"Washing of hands · return to the altar","fr":"Washing of hands · return to the altar"},"actor":"mixed","priestPosition":"Epistle side","audibility":"audible","privateAction":false,"text":{"lat":"The celebrant washes his hands at the Epistle side and then returns to the altar.","en":"The celebrant washes his hands at the Epistle side and then returns to the altar.","fr":"Le célébrant se lave les mains au côté de l’Épître, puis remonte à l’autel."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"When the distribution is complete, the celebrant washes his hands before returning to the altar for the concluding prayer.","ritualActions":[{"kind":"ritual_action","label":"↑ Rise after receiving the ashes","source":"special_day_step"}],"exceptional":{"rite":"ash-wednesday","phase":"Special Rite · Ash Wednesday","liturgicalColour":"Violet"}},{"id":"ashes-conclusion","phase":"Ash Wednesday","section":"Special Rite · Ash Wednesday","title":{"en":"Prayer after the Ashes","fr":"Prayer after the Ashes"},"subtitle":{"en":"Concede nobis, Domine","fr":"Concede nobis, Domine"},"actor":"mixed","priestPosition":"Sanctuary","audibility":"audible","privateAction":false,"text":{"lat":"℣. Dóminus vobíscum.\n℟. Et cum spíritu tuo.\nOrémus.\nConcéde nobis, Dómine, præsídia milítiæ christiánæ sanctis inchoáre ieiúniis: ut, contra spiritáles nequítias pugnatúri, continéntiæ muniámur auxíliis. Per Christum Dóminum nostrum.\n℟. Amen.","en":"℣. The Lord be with you.\n℟. And with thy spirit.\nLet us pray.\nGrant us, O Lord, to begin with holy fasting this campaign of Christian service, that, as we fight against spiritual wickedness, we may be strengthened by the aid of self-restraint. Through Christ our Lord.\n℟. Amen.","fr":"℣. Le Seigneur soit avec vous.\n℟. Et avec votre esprit.\nPrions.\nAccordez-nous, Seigneur, de commencer par de saints jeûnes cette campagne du combat chrétien, afin que, devant lutter contre les puissances spirituelles du mal, nous soyons fortifiés par les secours de la maîtrise de nous-mêmes. Par le Christ notre Seigneur.\n℟. Ainsi soit-il."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"This prayer concludes the rite. When Mass follows the solemn blessing and imposition immediately, the prayers at the foot of the altar are omitted and Mass begins at the Introit.","ritualActions":[],"exceptional":{"rite":"ash-wednesday","phase":"Special Rite · Ash Wednesday","liturgicalColour":"Violet"}}],"palm_sunday":[{"id":"palms-blessing","phase":"Palm Sunday","section":"Special Rite · Palm Sunday","title":{"en":"Blessing of Palms","fr":"Blessing of Palms"},"subtitle":{"en":"Hosanna filio David · red vestments","fr":"Hosanna filio David · red vestments"},"actor":"mixed","priestPosition":"Place of blessing","audibility":"choir","privateAction":false,"text":{"lat":"Matth 21:9\nHosánna fílio David: benedíctus qui venit in nómine Dómini. Rex Israel: Hosánna in excélsis.\n\n℣. Dóminus vobíscum.\n℟. Et cum spíritu tuo.\nOrémus.\nBéne✠dic, quǽsumus, Dómine, hos palmárum ramos: et præsta; ut, quod pópulus tuus in tui veneratiónem hodiérno die corporáliter agit, hoc spirituáliter summa devotióne perfíciat, de hoste victóriam reportándo et opus misericórdiæ summópere diligéndo. Per Christum Dóminum nostrum.\n℟. Amen.","en":"Matt 21:9\nHosanna to the Son of David: blessed is He that comes in the name of the Lord. O King of Israel: Hosanna in the highest.\n\n℣. The Lord be with you.\n℟. And with thy spirit.\nLet us pray.\nBless, ✠ we beseech Thee, O Lord, these branches of palm, and grant that what Thy people today perform outwardly in Thy honour they may accomplish spiritually with the greatest devotion, winning victory over the enemy and loving above all works of mercy. Through Christ our Lord.\n℟. Amen.","fr":"Mt 21, 9\nHosanna au Fils de David ! Béni soit celui qui vient au nom du Seigneur ! Ô Roi d’Israël : Hosanna au plus haut des cieux !\n\n℣. Le Seigneur soit avec vous.\n℟. Et avec votre esprit.\nPrions.\nBénissez, ✠ nous vous en prions, Seigneur, ces rameaux de palmier, et accordez que ce que votre peuple accomplit aujourd’hui extérieurement en votre honneur, il l’accomplisse spirituellement avec une très grande dévotion, remportant la victoire sur l’ennemi et aimant par-dessus tout les œuvres de miséricorde. Par le Christ notre Seigneur.\n℟. Ainsi soit-il."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"The rite begins with Hosanna filio David and the prayer Benedic, quaesumus. Red vestments are used for the blessing and procession; violet is used for Mass.","ritualActions":[],"exceptional":{"rite":"palm-sunday","phase":"Special Rite · Palm Sunday","liturgicalColour":"Red"}},{"id":"palms-sprinkle-incense","phase":"Palm Sunday","section":"Special Rite · Palm Sunday","title":{"en":"Sprinkling and Incensing the Palms","fr":"Sprinkling and Incensing the Palms"},"subtitle":{"en":"After the blessing prayer","fr":"After the blessing prayer"},"actor":"mixed","priestPosition":"Place of blessing","audibility":"audible","privateAction":false,"text":{"lat":"The palms are sprinkled with holy water and then incensed.","en":"The palms are sprinkled with holy water and then incensed.","fr":"Les rameaux sont aspergés d’eau bénite puis encensés."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"After the prayer, the celebrant sprinkles the palms with holy water and then incenses them. The 1962 rite does not prescribe saying the Asperges me antiphon here.","ritualActions":[],"exceptional":{"rite":"palm-sunday","phase":"Special Rite · Palm Sunday","liturgicalColour":"Red"}},{"id":"palms-distribution","phase":"Palm Sunday","section":"Special Rite · Palm Sunday","title":{"en":"Distribution of Palms","fr":"Distribution of Palms"},"subtitle":{"en":"Pueri Hebraeorum","fr":"Pueri Hebraeorum"},"actor":"mixed","priestPosition":"Altar / communion rail","audibility":"choir","privateAction":false,"text":{"lat":"Ant. Púeri Hebræórum, portántes ramos olivárum, obviavérunt Dómino, clamántes et dicéntes: Hosánna in excélsis.\n\nPsalmus 23:1-2, 7-10\nDómini est terra et plenitúdo eius, orbis terrárum et univérsi qui hábitant in eo.\nQuia ipse super mária fundávit eum et super flúmina præparávit eum.\nAnt. Púeri Hebræórum, portántes ramos olivárum, obviavérunt Dómino, clamántes et dicéntes: Hosánna in excélsis.\nAttóllite portas, príncipes, vestras: et elevámini, portæ æternáles: et introíbit Rex glóriæ.\nQuis est iste Rex glóriæ? Dóminus fortis et potens: Dóminus potens in prǽlio.\nAnt. Púeri Hebræórum, portántes ramos olivárum, obviavérunt Dómino, clamántes et dicéntes: Hosánna in excélsis.\nAttóllite portas, príncipes, vestras: et elevámini, portæ æternáles: et introíbit Rex glóriæ.\nQuis est iste Rex glóriæ? Dóminus virtútum ipse est Rex glóriæ.\nAnt. Púeri Hebræórum, portántes ramos olivárum, obviavérunt Dómino, clamántes et dicéntes: Hosánna in excélsis.\nGlória Patri, et Fílio, et Spirítui Sancto.\nSicut erat in princípio, et nunc, et semper, et in sǽcula sæculórum. Amen.\nAnt. Púeri Hebræórum, portántes ramos olivárum, obviavérunt Dómino, clamántes et dicéntes: Hosánna in excélsis.\n\nPsalmus 46\nAnt. Púeri Hebræórum vestiménta prosternébant in via, et clamábant dicéntes: Hosánna Fílio David; benedíctus qui venit in nómine Dómini.\nOmnes gentes, pláudite mánibus: iubiláte Deo in voce exsultatiónis.\nQuóniam Dóminus excélsus, terríbilis, Rex magnus super omnem terram.\nAnt. Púeri Hebræórum vestiménta prosternébant in via, et clamábant dicéntes: Hosánna Fílio David; benedíctus qui venit in nómine Dómini.\nSubiécit pópulos nobis: et gentes sub pédibus nostris.\nElégit nobis hereditátem suam: spéciem Iacob quam diléxit.\nAnt. Púeri Hebræórum vestiménta prosternébant in via, et clamábant dicéntes: Hosánna Fílio David; benedíctus qui venit in nómine Dómini.\nAscéndit Deus in iúbilo: et Dóminus in voce tubæ.\nPsállite Deo nostro, psállite: psállite Regi nostro, psállite.\nAnt. Púeri Hebræórum vestiménta prosternébant in via, et clamábant dicéntes: Hosánna Fílio David; benedíctus qui venit in nómine Dómini.\nQuóniam Rex omnis terræ Deus: psállite sapiénter.\nRegnávit Deus super gentes: Deus sedit super sedem sanctam suam.\nAnt. Púeri Hebræórum vestiménta prosternébant in via, et clamábant dicéntes: Hosánna Fílio David; benedíctus qui venit in nómine Dómini.\nPríncipes populórum congregáti sunt cum Deo Abraham: quóniam Dei fortes terræ veheménter eleváti sunt.\nAnt. Púeri Hebræórum vestiménta prosternébant in via, et clamábant dicéntes: Hosánna Fílio David; benedíctus qui venit in nómine Dómini.\nGlória Patri, et Fílio, et Spirítui Sancto.\nSicut erat in princípio, et nunc, et semper, et in sǽcula sæculórum. Amen.\nAnt. Púeri Hebræórum vestiménta prosternébant in via, et clamábant dicéntes: Hosánna Fílio David; benedíctus qui venit in nómine Dómini.","en":"Ant. The children of the Hebrews, bearing olive branches, went forth to meet the Lord, crying out and saying: Hosanna in the highest.\n\nPsalm 23:1-2, 7-10\nThe earth is the Lord's and the fullness thereof; the world and all who dwell therein.\nFor He founded it upon the seas and established it upon the rivers.\nAnt. The children of the Hebrews, bearing olive branches, went forth to meet the Lord, crying out and saying: Hosanna in the highest.\nLift up your gates, O princes; be lifted up, eternal gates, and the King of glory shall enter.\nWho is this King of glory? The Lord strong and mighty, the Lord mighty in battle.\nAnt. The children of the Hebrews, bearing olive branches, went forth to meet the Lord, crying out and saying: Hosanna in the highest.\nLift up your gates, O princes; be lifted up, eternal gates, and the King of glory shall enter.\nWho is this King of glory? The Lord of hosts, He is the King of glory.\nAnt. The children of the Hebrews, bearing olive branches, went forth to meet the Lord, crying out and saying: Hosanna in the highest.\nGlory be to the Father, and to the Son, and to the Holy Ghost.\nAs it was in the beginning, is now, and ever shall be, world without end. Amen.\nAnt. The children of the Hebrews, bearing olive branches, went forth to meet the Lord, crying out and saying: Hosanna in the highest.\n\nPsalm 46\nAnt. The children of the Hebrews spread their garments in the way and cried out, saying: Hosanna to the Son of David; blessed is He who comes in the name of the Lord.\nO clap your hands, all ye nations; shout to God with the voice of joy.\nFor the Lord is high and terrible, a great King over all the earth.\nAnt. The children of the Hebrews spread their garments in the way and cried out, saying: Hosanna to the Son of David; blessed is He who comes in the name of the Lord.\nHe hath subdued peoples under us, and nations under our feet.\nHe hath chosen for us His inheritance, the beauty of Jacob whom He loved.\nAnt. The children of the Hebrews spread their garments in the way and cried out, saying: Hosanna to the Son of David; blessed is He who comes in the name of the Lord.\nGod is ascended with jubilation, and the Lord with the sound of the trumpet.\nSing praises to our God, sing praises; sing praises to our King, sing praises.\nAnt. The children of the Hebrews spread their garments in the way and cried out, saying: Hosanna to the Son of David; blessed is He who comes in the name of the Lord.\nFor God is King of all the earth: sing wisely.\nGod reigns over the nations; God sits upon His holy throne.\nAnt. The children of the Hebrews spread their garments in the way and cried out, saying: Hosanna to the Son of David; blessed is He who comes in the name of the Lord.\nThe princes of the peoples are gathered together with the God of Abraham; for the mighty of the earth are greatly exalted.\nAnt. The children of the Hebrews spread their garments in the way and cried out, saying: Hosanna to the Son of David; blessed is He who comes in the name of the Lord.\nGlory be to the Father, and to the Son, and to the Holy Ghost.\nAs it was in the beginning, is now, and ever shall be, world without end. Amen.\nAnt. The children of the Hebrews spread their garments in the way and cried out, saying: Hosanna to the Son of David; blessed is He who comes in the name of the Lord.","fr":"Les enfants des Hébreux, portant des rameaux d’olivier, allèrent au-devant du Seigneur, criant et disant : Hosanna au plus haut des cieux.\n\nLes enfants des Hébreux étendaient leurs vêtements sur le chemin et criaient : Hosanna au Fils de David ; béni soit celui qui vient au nom du Seigneur."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"The palms are distributed first to the clergy and ministers and then to the faithful while the appointed Pueri Hebraeorum antiphons and psalm verses accompany the distribution.","ritualActions":[{"kind":"ritual_action","label":"↓ Kneel if receiving the palm at the communion rail","source":"special_day_step"}],"exceptional":{"rite":"palm-sunday","phase":"Special Rite · Palm Sunday","liturgicalColour":"Red"}},{"id":"palms-gospel","phase":"Palm Sunday","section":"Special Rite · Palm Sunday","title":{"en":"Gospel before the Procession","fr":"Gospel before the Procession"},"subtitle":{"en":"Matt 21:1-9 · the Lord enters Jerusalem","fr":"Matt 21:1-9 · the Lord enters Jerusalem"},"actor":"mixed","priestPosition":"Place of blessing","audibility":"audible","privateAction":false,"text":{"lat":"Munda cor meum ac lábia mea, omnípotens Deus, qui lábia Isaíæ Prophétæ cálculo mundásti igníto:\nita me tua grata miseratióne dignáre mundáre, ut sanctum Evangélium tuum digne váleam nuntiáre.\nPer Christum Dóminum nostrum. Amen.\n\nIube, Dómine, benedícere. Dóminus sit in corde meo et in lábiis meis:\nut digne et competénter annúntiem Evangélium suum. Amen.\n\n℣. Dóminus vobíscum.\n℟. Et cum spíritu tuo.\n℣. Sequéntia ✠ sancti Evangélii secúndum Matthǽum.\n℟. Glória tibi, Dómine.\n\nMatth 21:1-9\nIn illo témpore: Cum appropinquásset Iesus Ierosólymis, et venísset Béthphage ad montem Olivéti: tunc misit duos discípulos, dicens eis: Ite in castéllum, quod contra vos est, et statim inveniétis ásinam alligátam, et pullum cum ea: sólvite, et addúcite mihi: et si quis vobis áliquid díxerit, dícite, quia Dóminus his opus habet: et conféstim dimíttet eos. Hoc autem totum factum est, ut adimplerétur, quod dictum est per Prophétam, dicéntem: Dícite fíliæ Sion: Ecce Rex tuus venit tibi mansuétus, sedens super ásinam, et pullum fílium subiugális. Eúntes autem discípuli fecérunt, sicut præcépit illis Iesus. Et adduxérunt ásinam et pullum: et imposuérunt super eos vestiménta sua, et eum désuper sedére fecérunt. Plúrima autem turba stravérunt vestiménta sua in via: álii autem cædébant ramos de arbóribus, et sternébant in via: turbæ autem, quæ præcedébant, et quæ sequebántur, clamábant, dicéntes: Hosánna fílio David: benedíctus, qui venit in nómine Dómini: Hosánna in altíssimis.","en":"Cleanse my heart and my lips, O almighty God, Who didst cleanse the lips of the prophet Isaias with a burning coal:\nthrough Thy gracious mercy so purify me that I may worthily proclaim Thy holy Gospel. Through Christ our Lord. Amen.\n\nGrant, O Lord, Thy blessing. May the Lord be in my heart and on my lips,\nthat I may worthily and fittingly proclaim His Gospel. Amen.\n\n℣. The Lord be with you.\n℟. And with thy spirit.\n℣. Continuation ✠ of the holy Gospel according to Matthew.\n℟. Glory be to Thee, O Lord.\n\nMatt 21:1-9\nAt that time, when Jesus drew near to Jerusalem and came to Bethphage, at the Mount of Olives, He sent two disciples, saying to them: Go into the village that is before you, and immediately you shall find an ass tied, and a colt with her: loose them and bring them to Me. And if anyone says anything to you, say that the Lord has need of them, and he will let them go at once. Now all this was done that what was spoken by the prophet might be fulfilled: Tell the daughter of Sion: Behold thy King comes to thee, meek, and sitting upon an ass, and a colt, the foal of her that is used to the yoke. The disciples went and did as Jesus commanded them. They brought the ass and the colt, laid their garments upon them, and made Him sit thereon. And a very great multitude spread their garments in the way; others cut branches from the trees and strewed them in the way. And the crowds that went before and followed cried out: Hosanna to the Son of David: blessed is He that comes in the name of the Lord: Hosanna in the highest.","fr":"Purifiez mon cœur et mes lèvres, Dieu tout-puissant, qui avez purifié les lèvres du prophète Isaïe avec un charbon ardent ; daignez aussi me purifier par votre miséricordieuse bonté, afin que je puisse proclamer dignement votre saint Évangile. Par le Christ notre Seigneur. Ainsi soit-il.\n\nSeigneur, veuillez me bénir. Que le Seigneur soit dans mon cœur et sur mes lèvres, afin que j’annonce dignement et convenablement son Évangile. Ainsi soit-il.\n\n℣. Le Seigneur soit avec vous.\n℟. Et avec votre esprit.\n℣. Suite ✠ du saint Évangile selon saint Matthieu.\n℟. Gloire à vous, Seigneur.\n\nMt 21, 1-9\nEn ce temps-là, comme Jésus approchait de Jérusalem et arrivait à Bethphagé, au mont des Oliviers, il envoya deux disciples en leur disant : Allez au village qui est devant vous ; vous y trouverez aussitôt une ânesse attachée et son petit avec elle. Détachez-les et amenez-les-moi. Si quelqu’un vous dit quelque chose, répondez : Le Seigneur en a besoin ; et aussitôt on les laissera partir. Tout cela arriva afin que s’accomplît la parole du prophète : Dites à la fille de Sion : Voici que ton Roi vient à toi, plein de douceur, monté sur une ânesse et sur un ânon, le petit de celle qui porte le joug. Les disciples allèrent et firent comme Jésus le leur avait ordonné. Ils amenèrent l’ânesse et l’ânon, mirent sur eux leurs vêtements et l’y firent asseoir. Une foule très nombreuse étendit ses vêtements sur le chemin ; d’autres coupaient des branches aux arbres et les répandaient sur le chemin. Et les foules qui précédaient Jésus et celles qui le suivaient criaient : Hosanna au Fils de David ! Béni soit celui qui vient au nom du Seigneur ! Hosanna au plus haut des cieux !"},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[{"kind":"cross","label":"Forehead · lips · breast","anchorLat":"Sequéntia ✠ sancti","anchorEng":"Continuation ✠ of the holy Gospel","before":true}],"explanation":"After the palms have been distributed, the Gospel of the Lord’s entry into Jerusalem is proclaimed before the procession begins.","ritualActions":[{"kind":"ritual_action","label":"↑ Stand · make the three small crosses at the announcement according to custom","source":"special_day_step"},{"kind":"cross","label":"Forehead · lips · breast","source":"cue"}],"exceptional":{"rite":"palm-sunday","phase":"Special Rite · Palm Sunday","liturgicalColour":"Red"}},{"id":"palms-procession","phase":"Palm Sunday","section":"Special Rite · Palm Sunday","title":{"en":"Procession with Palms","fr":"Procession with Palms"},"subtitle":{"en":"Procedamus in pace","fr":"Procedamus in pace"},"actor":"mixed","priestPosition":"Procession","audibility":"audible","privateAction":false,"text":{"lat":"℣. Procedámus in pace.\n℟. In nómine Christi. Amen.\n\nOccúrrunt turbæ cum flóribus et palmis Redemptóri óbviam: et victóri triumphánti digna dant obséquia: Fílium Dei ore gentes prædicant: et in laudem Christi voces tonant per núbila: Hosánna in excélsis.\n\nCum Angelis et púeris fidéles inveniántur, triumphatóri mortis clamántes: Hosánna in excélsis.\n\nTurba multa, quæ convénerat ad diem festum, clamábat Dómino: Benedíctus, qui venit in nómine Dómini: Hosánna in excélsis.\n\nLuc 19:37-38\nCœpérunt omnes turbæ descendéntium gaudéntes laudáre Deum voce magna, super ómnibus quas víderant virtútibus, dicéntes: Benedíctus qui venit Rex in nómine Dómini; pax in terra, et glória in excélsis.\n\nHYMNUS AD CHRISTUM REGEM\nChorus:\nGlória, laus et honor tibi sit, Rex Christe, Redémptor: cui pueríle decus prompsit Hosánna pium.\nOmnes:\nGlória, laus et honor tibi sit, Rex Christe, Redémptor: cui pueríle decus prompsit Hosánna pium.\n\nChorus:\nIsraël es tu Rex, Davidis et ínclita proles: nómine qui in Dómini, Rex benedícte, venis.\nOmnes:\nGlória, laus et honor tibi sit, Rex Christe, Redémptor: cui pueríle decus prompsit Hosánna pium.\n\nChorus:\nCœtus in excélsis te laudat cælicus omnis, et mortális homo, et cuncta creáta simul.\nOmnes:\nGlória, laus et honor tibi sit, Rex Christe, Redémptor: cui pueríle decus prompsit Hosánna pium.\n\nChorus:\nPlebs Hebrǽa tibi cum palmis óbvia venit: cum prece, voto, hymnis, ádsumus ecce tibi.\nOmnes:\nGlória, laus et honor tibi sit, Rex Christe, Redémptor: cui pueríle decus prompsit Hosánna pium.\n\nChorus:\nHi tibi passúro solvébant múnia laudis: nos tibi regnánti pángimus ecce melos.\nOmnes:\nGlória, laus et honor tibi sit, Rex Christe, Redémptor: cui pueríle decus prompsit Hosánna pium.\n\nChorus:\nHi placuére tibi, pláceat devótio nostra: Rex bone, Rex clemens, cui bona cuncta placent.\nOmnes:\nGlória, laus et honor tibi sit, Rex Christe, Redémptor: cui pueríle decus prompsit Hosánna pium.\n\nFulgéntibus palmis prostérnimur adveniénti Dómino: huic omnes occurrámus cum hymnis et cánticis, glorificántes et dicéntes: Benedíctus Dóminus.\n\nAve, Rex noster, Fili David, Redémptor mundi, quem prophétæ prædixérunt Salvatórem dómui Israël esse ventúrum. Te enim ad salutárem víctimam Pater misit in mundum, quem exspectábant omnes sancti ab orígine mundi, et nunc: Hosánna Fílio David. Benedíctus qui venit in nómine Dómini. Hosánna in excélsis.","en":"℣. Let us go forth in peace.\n℟. In the name of Christ. Amen.\n\nThe crowds go forth with flowers and palms to meet the Redeemer and offer fitting homage to the triumphant Victor. The nations proclaim the Son of God, and voices rise through the heavens in praise of Christ: Hosanna in the highest.\n\nMay the faithful be found with the Angels and the children, crying to the Conqueror of death: Hosanna in the highest.\n\nA great multitude gathered for the feast cried to the Lord: Blessed is He who comes in the name of the Lord: Hosanna in the highest.\n\nLuke 19:37-38\nThe whole multitude of those going down began joyfully to praise God with a loud voice for all the mighty works they had seen, saying: Blessed is the King who comes in the name of the Lord; peace on earth and glory in the highest.\n\nHYMN TO CHRIST THE KING\nChoir:\nGlory, praise and honour be to Thee, Christ our King and Redeemer, to Whom the children offered their devout Hosanna.\nAll:\nGlory, praise and honour be to Thee, Christ our King and Redeemer, to Whom the children offered their devout Hosanna.\n\nChoir:\nThou art the King of Israel, the noble offspring of David, the blessed King who comest in the name of the Lord.\nAll:\nGlory, praise and honour be to Thee, Christ our King and Redeemer, to Whom the children offered their devout Hosanna.\n\nChoir:\nThe whole heavenly host praises Thee on high; mortal man and all creation praise Thee together.\nAll:\nGlory, praise and honour be to Thee, Christ our King and Redeemer, to Whom the children offered their devout Hosanna.\n\nChoir:\nThe Hebrew people came to meet Thee with palms; behold, we stand before Thee with prayer, vows and hymns.\nAll:\nGlory, praise and honour be to Thee, Christ our King and Redeemer, to Whom the children offered their devout Hosanna.\n\nChoir:\nThey offered Thee their tribute of praise before Thy Passion; we now sing our hymn to Thee reigning in glory.\nAll:\nGlory, praise and honour be to Thee, Christ our King and Redeemer, to Whom the children offered their devout Hosanna.\n\nChoir:\nTheir devotion pleased Thee; may ours also please Thee, good and merciful King, to Whom all that is good is pleasing.\nAll:\nGlory, praise and honour be to Thee, Christ our King and Redeemer, to Whom the children offered their devout Hosanna.\n\nWith shining palms we bow before the Lord as He approaches; let us all go out to meet Him with hymns and canticles, glorifying Him and saying: Blessed is the Lord.\n\nHail, our King, Son of David, Redeemer of the world, Whom the prophets foretold would come as Saviour of the house of Israel. The Father sent Thee into the world as the saving Victim, Whom all the saints awaited from the beginning of the world; and now we cry: Hosanna to the Son of David. Blessed is He who comes in the name of the Lord. Hosanna in the highest.","fr":"℣. Avançons en paix.\n℟. Au nom du Christ. Ainsi soit-il.\n\nLes foules viennent avec des fleurs et des palmes à la rencontre du Rédempteur et rendent un digne hommage au vainqueur triomphant ; les nations proclament le Fils de Dieu et leurs voix retentissent dans les airs à la louange du Christ : Hosanna au plus haut des cieux.\n\nQue les fidèles se joignent aux Anges et aux enfants pour acclamer le vainqueur de la mort : Hosanna au plus haut des cieux.\n\nUne foule nombreuse, réunie pour la fête, criait vers le Seigneur : Béni soit celui qui vient au nom du Seigneur ! Hosanna au plus haut des cieux !"},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"Procedamus in pace / In nomine Christi begins the procession; the appointed antiphons and Gloria, laus accompany it.","ritualActions":[],"exceptional":{"rite":"palm-sunday","phase":"Special Rite · Palm Sunday","liturgicalColour":"Red"}},{"id":"palms-return","phase":"Palm Sunday","section":"Special Rite · Palm Sunday","title":{"en":"Return to the Church","fr":"Return to the Church"},"subtitle":{"en":"Ingrediente Domino · concluding prayer","fr":"Ingrediente Domino · concluding prayer"},"actor":"mixed","priestPosition":"Entrance then altar","audibility":"audible","privateAction":false,"text":{"lat":"Ingrediénte Dómino in sanctam civitátem, Hebræórum púeri resurrectiónem vitæ pronuntiántes, cum ramis palmárum: Hosánna, clamábant, in excélsis.\n℣. Cum audísset pópulus, quod Iesus veníret Ierosólymam, exiérunt óbviam ei.\n℟. Cum ramis palmárum: Hosánna, clamábant, in excélsis.\n\n℣. Dóminus vobíscum.\n℟. Et cum spíritu tuo.\nOrémus.\nDómine Iesu Christe, Rex ac Redémptor noster, in cuius honórem, hos ramos gestántes, solémnes laudes decantávimus: concéde propítius; ut, quocúmque hi rami deportáti fúerint, ibi tuæ benedictiónis grátia descéndat, et, quavis dǽmonum iniquitáte vel illusióne profligáta, déxtera tua prótegat, quos redémit: Qui vivis et regnas in sǽcula sæculórum.\n℟. Amen.","en":"As the Lord entered the holy city, the Hebrew children, proclaiming the resurrection of life, cried with palm branches: Hosanna in the highest.\n℣. When the people heard that Jesus was coming to Jerusalem, they went forth to meet Him.\n℟. With palm branches they cried: Hosanna in the highest.\n\n℣. The Lord be with you.\n℟. And with thy spirit.\nLet us pray.\nO Lord Jesus Christ, our King and Redeemer, in whose honour we have borne these branches and sung solemn praises, mercifully grant that wherever these branches are carried the grace of Thy blessing may descend; and, every evil or deception of the demons being driven away, may Thy right hand protect those whom Thou hast redeemed. Who livest and reignest for ever and ever.\n℟. Amen.","fr":"Lorsque le Seigneur entra dans la cité sainte, les enfants des Hébreux, proclamant la résurrection de la Vie, criaient avec des rameaux de palme : Hosanna au plus haut des cieux.\n℣. Lorsque le peuple apprit que Jésus venait à Jérusalem, il sortit à sa rencontre.\n℟. Avec des rameaux de palme, ils criaient : Hosanna au plus haut des cieux.\n\n℣. Le Seigneur soit avec vous.\n℟. Et avec votre esprit.\nPrions.\nSeigneur Jésus-Christ, notre Roi et notre Rédempteur, en l’honneur de qui nous avons porté ces rameaux et chanté des louanges solennelles, accordez dans votre bonté que, partout où ces rameaux seront portés, la grâce de votre bénédiction descende ; et, toute malice ou illusion des démons étant repoussée, que votre droite protège ceux que vous avez rachetés, vous qui vivez et régnez dans les siècles des siècles.\n℟. Ainsi soit-il."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"Ingrediente Domino accompanies the return. The prayer Domine Iesu Christe concludes the procession; the celebrant then changes to violet for Mass, which begins at the Introit without the prayers at the foot.","ritualActions":[],"exceptional":{"rite":"palm-sunday","phase":"Special Rite · Palm Sunday","liturgicalColour":"Red"}}],"holy_thursday":[{"id":"holy-thursday-reposition","phase":"After Mass","section":"After Mass · Holy Thursday","title":{"en":"Procession to the Altar of Repose","fr":"Procession to the Altar of Repose"},"subtitle":{"en":"Pange lingua · Tantum ergo","fr":"Pange lingua · Tantum ergo"},"actor":"mixed","priestPosition":"Procession / altar of repose","audibility":"audible","privateAction":false,"text":{"lat":"Pange, língua, gloriósi\nCórporis mystérium,\nSanguinísque pretiósi,\nQuem in mundi prétium\nFructus ventris generósi\nRex effúdit géntium.\n\nNobis datus, nobis natus\nEx intácta Vírgine,\nEt in mundo conversátus,\nSparso verbi sémine,\nSui moras incolátus\nMiro clausit órdine.\n\nIn suprémæ nocte cœnæ\nRecúmbens cum frátribus,\nObserváta lege plene\nCibis in legálibus,\nCibum turbæ duodénæ\nSe dat suis mánibus.\n\nVerbum caro, panem verum\nVerbo carnem éfficit;\nFitque sanguis Christi merum:\nEt si sensus déficit,\nAd firmándum cor sincérum\nSola fides súfficit.\n\nTantum ergo Sacraméntum\nVenerémur cérnui:\nEt antíquum documéntum\nNovo cedat rítui:\nPræstet fides supplémentum\nSénsuum deféctui.\n\nGenitóri Genitóque\nLaus et iubilátio,\nSalus, honor, virtus quoque\nSit et benedíctio:\nProcedénti ab utróque\nCompar sit laudátio.\nAmen.","en":"Sing, O tongue, the mystery\nof the glorious Body,\nand of the precious Blood\nwhich the King of the nations,\nfruit of the noble Virgin's womb,\npoured out as the price of the world.\n\nGiven to us and born for us\nof the spotless Virgin,\nHe lived among us in the world,\nscattering the seed of His word;\nand He brought the course of His earthly dwelling\nto a wondrous close.\n\nOn the night of the Last Supper,\nreclining with His brethren,\nhaving fully observed the Law\nin its appointed food,\nHe gave Himself with His own hands\nas food to the Twelve.\n\nThe Word made flesh, by His word,\nmakes true bread become His Flesh;\nwine becomes the Blood of Christ:\nand though the senses cannot perceive it,\nfaith alone is sufficient\nto strengthen the sincere heart.\n\nTherefore let us, bowing low,\nvenerate so great a Sacrament;\nlet the ancient observance\ngive way to the new rite;\nlet faith supply\nwhat the senses cannot grasp.\n\nTo the Father and the Son\nbe praise and jubilation,\nsalvation, honour, power\nand blessing;\nto the One proceeding from Them both\nbe equal praise.\nAmen.","fr":"Chante, ô ma langue, le mystère du Corps glorieux…\n\nAu reposoir : Adorons donc, prosternés, un si grand Sacrement…"},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"After Benedicamus Domino, the Blessed Sacrament is carried solemnly to the altar of repose while Pange lingua is sung. Tantum ergo accompanies the final part of the hymn at the place of repose. The final blessing and Last Gospel are omitted.","ritualActions":[{"kind":"ritual_action","label":"Follow the procession; kneel for adoration as directed","source":"special_day_step"}],"exceptional":{"rite":"holy-thursday","phase":"After Mass · Holy Thursday"}},{"id":"holy-thursday-stripping","phase":"After Mass","section":"After Mass · Holy Thursday","title":{"en":"Stripping of the Altars","fr":"Stripping of the Altars"},"subtitle":{"en":"After the reposition","fr":"After the reposition"},"actor":"mixed","priestPosition":"Main altar","audibility":"audible","privateAction":false,"text":{"lat":"The altar candles are extinguished and the altars are stripped after the Blessed Sacrament has been reposed.","en":"The altar candles are extinguished and the altars are stripped after the Blessed Sacrament has been reposed.","fr":"Les cierges sont éteints et les autels sont dépouillés après la reposition du Saint-Sacrement."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"The stripping of the altars follows the solemn reposition and closes the Holy Thursday ceremonies.","ritualActions":[],"exceptional":{"rite":"holy-thursday","phase":"After Mass · Holy Thursday"}}],"good_friday":[{"id":"gf-prostration","phase":"Readings","section":"Good Friday · Readings & Passion","title":{"en":"Prostration and Opening Prayer","fr":"Prostration and Opening Prayer"},"subtitle":{"en":"The altar is completely bare · black vestments","fr":"The altar is completely bare · black vestments"},"actor":"mixed","priestPosition":"Bare altar","audibility":"silent","privateAction":false,"text":{"lat":"Deus, qui peccáti véteris hereditáriam mortem, in qua posteritátis genus omne succésserat, Christi tui, Dómini nostri, passióne solvísti: da, ut, confórmes eídem facti; sicut imáginem terréni natúræ necessitáte portávimus, ita imáginem cæléstis grátiæ sanctificatióne portémus. Per eúndem Christum Dóminum nostrum.\n℟. Amen.","en":"O God, Who by the Passion of Thy Christ our Lord hast loosed the hereditary death of the old sin, to which all later generations had succeeded: grant that, being made conformable to Him, as by necessity of nature we have borne the image of the earthly man, so by sanctification we may bear the image of heavenly grace. Through the same Christ our Lord.\n℟. Amen.","fr":"Ô Dieu, qui par la Passion de votre Christ, notre Seigneur, avez brisé la mort héréditaire du péché ancien à laquelle toute la postérité d’Adam avait succédé : accordez-nous d’être rendus conformes à lui ; et comme nous avons porté par nécessité de nature l’image de l’homme terrestre, faites que, sanctifiés par votre grâce, nous portions l’image de l’homme céleste. Par le même Christ notre Seigneur.\n℟. Ainsi soit-il."},"posture":{"value":"KNEEL","policy":"fixed","source":"fixed"},"gestures":[],"explanation":"Good Friday is not a Mass. The Solemn Liturgical Action begins before the stripped altar with the celebrant prostrate and the ministers and faithful kneeling.","exceptional":{"rite":"good-friday","phase":"Good Friday · Readings & Passion","liturgicalColour":"Black"}},{"id":"gf-lesson-1","phase":"Readings","section":"Good Friday · Readings & Passion","title":{"en":"First Lesson","fr":"First Lesson"},"subtitle":{"en":"Hosea 6:1-6","fr":"Hosea 6:1-6"},"actor":"mixed","priestPosition":"Sanctuary","audibility":"audible","privateAction":false,"text":{"lat":"Lectio I · Osee 6, 1-6","en":"First Lesson · Hosea 6:1-6","fr":"Première leçon · Osée 6, 1-6"},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"The first lesson is read without the normal Mass introduction.","ritualActions":[],"exceptional":{"rite":"good-friday","phase":"Good Friday · Readings & Passion","liturgicalColour":"Black"}},{"id":"gf-responsory-1","phase":"Readings","section":"Good Friday · Readings & Passion","title":{"en":"First Responsory","fr":"First Responsory"},"subtitle":{"en":"Domine, audivi","fr":"Domine, audivi"},"actor":"mixed","priestPosition":"Sanctuary","audibility":"audible","privateAction":false,"text":{"lat":"Dómine, audívi audítum tuum, et tímui: considerávi ópera tua, et expávi.\n℣. In médio duórum animálium innotescéris: dum appropinquáverint anni, cognoscéris: dum advénerit tempus, ostendéris.","en":"O Lord, I have heard Thy report and was afraid; I considered Thy works and was amazed.\n℣. In the midst of the two living creatures Thou shalt be known; as the years draw near Thou shalt be recognized; when the time comes Thou shalt be manifested.","fr":"Seigneur, j’ai entendu votre parole et j’ai craint ; j’ai considéré vos œuvres et j’ai été saisi d’effroi.\n℣. Vous serez reconnu au milieu des deux animaux ; lorsque les années approcheront, vous serez connu ; lorsque le temps sera venu, vous vous manifesterez."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"The responsory follows the first lesson.","ritualActions":[],"exceptional":{"rite":"good-friday","phase":"Good Friday · Readings & Passion","liturgicalColour":"Black"}},{"id":"gf-between-lessons","phase":"Readings","section":"Good Friday · Readings & Passion","title":{"en":"Prayer between the Lessons","fr":"Prayer between the Lessons"},"subtitle":{"en":"Oremus · Flectamus genua · Levate","fr":"Oremus · Flectamus genua · Levate"},"actor":"mixed","priestPosition":"Altar","audibility":"audible","privateAction":false,"text":{"lat":"Oremus.\nFlectámus génua.\nLeváte.\nDeus, a quo et Iudas reátus sui pœnam, et confessiónis suæ latro prǽmium sumpsit: concéde nobis tuæ propitiatiónis efféctum; ut, sicut in passióne sua Iesus Christus Dóminus noster divérsa utrísque íntulit stipéndia meritórum; ita nobis, abláto vetustátis erróre, resurrectiónis suæ grátiam largiátur. Qui tecum vivit et regnat in sǽcula sæculórum.\n℟. Amen.","en":"Let us pray.\nLet us kneel.\nArise.\nO God, from Whom Judas received the punishment of his guilt and the thief the reward of his confession: grant us the effect of Thy mercy; that, as in His Passion our Lord Jesus Christ rendered to each according to his deeds, so, taking away the error of our old life, He may bestow on us the grace of His Resurrection. Who livest and reignest for ever and ever.\n℟. Amen.","fr":"Prions.\nFléchissons les genoux.\nLevez-vous.\nÔ Dieu, de qui Judas reçut le châtiment de son crime et le larron la récompense de sa confession : accordez-nous l’effet de votre miséricorde ; afin que, comme dans sa Passion Notre-Seigneur Jésus-Christ rendit à chacun selon ses œuvres, ainsi, l’erreur de notre vie ancienne étant ôtée, il nous accorde la grâce de sa Résurrection. Lui qui vit et règne dans les siècles des siècles.\n℟. Ainsi soit-il."},"posture":{"value":"STAND","policy":"fixed","source":"fixed"},"gestures":[{"kind":"kneel","label":"Kneel","anchorLat":"Flectámus génua","anchorEng":"Let us kneel","before":true},{"kind":"rise","label":"Rise","anchorLat":"Leváte","anchorEng":"Arise","before":true}],"explanation":"All kneel for a short silent prayer, then rise for the collect Deus, a quo et Iudas.","exceptional":{"rite":"good-friday","phase":"Good Friday · Readings & Passion","liturgicalColour":"Black"}},{"id":"gf-lesson-2","phase":"Readings","section":"Good Friday · Readings & Passion","title":{"en":"Second Lesson","fr":"Second Lesson"},"subtitle":{"en":"Exodus 12:1-11","fr":"Exodus 12:1-11"},"actor":"mixed","priestPosition":"Sanctuary","audibility":"audible","privateAction":false,"text":{"lat":"Lectio II · Exodus 12, 1-11","en":"Second Lesson · Exodus 12:1-11","fr":"Deuxième leçon · Exode 12, 1-11"},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"The Passover lamb of Exodus prepares for the Passion according to Saint John.","ritualActions":[],"exceptional":{"rite":"good-friday","phase":"Good Friday · Readings & Passion","liturgicalColour":"Black"}},{"id":"gf-responsory-2","phase":"Readings","section":"Good Friday · Readings & Passion","title":{"en":"Second Responsory","fr":"Second Responsory"},"subtitle":{"en":"Eripe me, Domine","fr":"Eripe me, Domine"},"actor":"mixed","priestPosition":"Sanctuary","audibility":"audible","privateAction":false,"text":{"lat":"Eripe me, Dómine, ab hómine malo: a viro iníquo líbera me.","en":"Deliver me, O Lord, from the evil man; rescue me from the unjust man.","fr":"Délivrez-moi, Seigneur, de l’homme mauvais ; arrachez-moi à l’homme injuste."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"The second responsory leads directly into the Passion.","ritualActions":[],"exceptional":{"rite":"good-friday","phase":"Good Friday · Readings & Passion","liturgicalColour":"Black"}},{"id":"gf-passion","phase":"Readings","section":"Good Friday · Readings & Passion","title":{"en":"Passion according to Saint John","fr":"Passion according to Saint John"},"subtitle":{"en":"John 18:1-40; 19:1-42","fr":"John 18:1-40; 19:1-42"},"actor":"mixed","priestPosition":"Sanctuary","audibility":"audible","privateAction":false,"text":{"lat":"Pássio Dómini nostri Iesu Christi secúndum Ioánnem.\nIoann 18, 1-40; 19, 1-42","en":"The Passion of Our Lord Jesus Christ according to Saint John.\nJohn 18:1-40; 19:1-42","fr":"Passion de Notre-Seigneur Jésus-Christ selon saint Jean.\nJean 18, 1-40 ; 19, 1-42"},"posture":{"value":"STAND","policy":"fixed","source":"fixed"},"gestures":[{"kind":"kneel","label":"Kneel briefly","anchorLat":"tradidit spíritum","anchorEng":"gave up the ghost","after":true},{"kind":"rise","label":"Rise","anchorLat":"tradidit spíritum","anchorEng":"gave up the ghost","after":true}],"explanation":"The Passion is proclaimed without the normal Gospel candles, incensation, small crosses, Laus tibi or kissing of the book. All kneel briefly when the death of the Lord is announced.","exceptional":{"rite":"good-friday","phase":"Good Friday · Readings & Passion","liturgicalColour":"Black"},"properSlot":"gospel","properStatus":"unavailable"},{"id":"gf-solemn-prayer-1","phase":"Solemn Prayers","section":"Good Friday · Solemn Prayers","title":{"en":"1. For the Holy Church","fr":"1. For the Holy Church"},"subtitle":{"en":"Oremus · Flectamus genua · Levate","fr":"Oremus · Flectamus genua · Levate"},"actor":"mixed","priestPosition":"Altar","audibility":"silent","privateAction":false,"text":{"lat":"Orémus, dilectíssimi nobis, pro Ecclésia sancta Dei: ut eam Deus et Dóminus noster pacificáre, adunáre et custodíre dignétur toto orbe terrárum.\n\nOrémus.\nFlectámus génua.\nLeváte.\nOmnípotens sempitérne Deus, qui glóriam tuam ómnibus in Christo géntibus revelásti: custódi ópera misericórdiæ tuæ; ut Ecclésia tua, toto orbe diffúsa, stábili fide in confessióne tui nóminis persevéret. Per Christum Dóminum nostrum. Amen.","en":"Let us pray, dearly beloved, for the holy Church of God: that our God and Lord may deign to give her peace, unity and protection throughout the world.\n\nLet us pray.\nLet us kneel.\nArise.\nAlmighty and everlasting God, Who in Christ hast revealed Thy glory to all nations: guard the works of Thy mercy, that Thy Church spread throughout the world may persevere with steadfast faith in the confession of Thy Name. Through Christ our Lord. Amen.","fr":"Prions, mes bien-aimés, pour la sainte Église de Dieu : que notre Dieu et Seigneur daigne lui donner la paix, l’unité et sa protection dans le monde entier.\n\nPrions.\nFléchissons les genoux.\nLevez-vous.\nDieu tout-puissant et éternel, qui avez révélé dans le Christ votre gloire à toutes les nations : gardez l’œuvre de votre miséricorde, afin que votre Église répandue dans le monde entier persévère d’une foi ferme dans la confession de votre nom. Par le Christ notre Seigneur. Ainsi soit-il."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[{"kind":"kneel","label":"Kneel","anchorLat":"Flectámus génua","anchorEng":"Let us kneel","before":true},{"kind":"rise","label":"Rise","anchorLat":"Leváte","anchorEng":"Arise","before":true}],"explanation":"One of the Great Intercessions of Good Friday. The intention is announced, all kneel briefly in silent prayer, then rise for the collect.","ritualActions":[{"kind":"ritual_action","label":"↓ Kneel at Flectamus genua · ↑ rise at Levate","source":"special_day_step"},{"kind":"kneel","label":"Kneel","source":"cue"},{"kind":"rise","label":"Rise","source":"cue"}],"exceptional":{"rite":"good-friday","phase":"Good Friday · Solemn Prayers","liturgicalColour":"Black"}},{"id":"gf-solemn-prayer-2","phase":"Solemn Prayers","section":"Good Friday · Solemn Prayers","title":{"en":"2. For the Pope","fr":"2. For the Pope"},"subtitle":{"en":"Oremus · Flectamus genua · Levate","fr":"Oremus · Flectamus genua · Levate"},"actor":"mixed","priestPosition":"Altar","audibility":"silent","privateAction":false,"text":{"lat":"Orémus et pro beatíssimo Papa nostro N.: ut Deus et Dóminus noster, qui elégit eum in órdine episcopátus, salvum atque incólumem custódiat Ecclésiæ suæ sanctæ, ad regéndum pópulum sanctum Dei.\n\nOrémus.\nFlectámus génua.\nLeváte.\nOmnípotens sempitérne Deus, cuius iudício univérsa fundántur: réspice propítius ad preces nostras, et eléctum nobis Antístitem tua pietáte consérva; ut christiána plebs, quæ te gubernátur auctóre, sub tanto Pontífice credulitátis suæ méritis augeátur. Per Christum Dóminum nostrum. Amen.","en":"Let us pray also for our most holy Father Pope N., that our God and Lord, Who chose him to the episcopate, may preserve him in health and safety for His holy Church, to govern the holy people of God.\n\nLet us pray.\nLet us kneel.\nArise.\nAlmighty and everlasting God, by Whose judgment all things are established: mercifully regard our prayers and preserve in Thy goodness the Bishop chosen for us, that the Christian people governed by Thy authority may grow in the merits of faith under so great a Pontiff. Through Christ our Lord. Amen.","fr":"Prions aussi pour notre très saint Père le Pape N. : que notre Dieu et Seigneur, qui l’a choisi dans l’ordre épiscopal, le garde sain et sauf pour sa sainte Église, afin qu’il gouverne le saint peuple de Dieu.\n\nPrions.\nFléchissons les genoux.\nLevez-vous.\nDieu tout-puissant et éternel, par le jugement duquel toutes choses sont établies : accueillez favorablement nos prières et conservez dans votre bonté le Pontife que vous nous avez choisi, afin que le peuple chrétien gouverné par votre autorité croisse sous un tel Pontife dans les mérites de sa foi. Par le Christ notre Seigneur. Ainsi soit-il."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[{"kind":"kneel","label":"Kneel","anchorLat":"Flectámus génua","anchorEng":"Let us kneel","before":true},{"kind":"rise","label":"Rise","anchorLat":"Leváte","anchorEng":"Arise","before":true}],"explanation":"One of the Great Intercessions of Good Friday. The intention is announced, all kneel briefly in silent prayer, then rise for the collect.","ritualActions":[{"kind":"ritual_action","label":"↓ Kneel at Flectamus genua · ↑ rise at Levate","source":"special_day_step"},{"kind":"kneel","label":"Kneel","source":"cue"},{"kind":"rise","label":"Rise","source":"cue"}],"exceptional":{"rite":"good-friday","phase":"Good Friday · Solemn Prayers","liturgicalColour":"Black"}},{"id":"gf-solemn-prayer-3","phase":"Solemn Prayers","section":"Good Friday · Solemn Prayers","title":{"en":"3. For the Clergy and Faithful","fr":"3. For the Clergy and Faithful"},"subtitle":{"en":"Oremus · Flectamus genua · Levate","fr":"Oremus · Flectamus genua · Levate"},"actor":"mixed","priestPosition":"Altar","audibility":"silent","privateAction":false,"text":{"lat":"Orémus et pro ómnibus Epíscopis, Presbýteris, Diáconibus, Subdiáconibus, Acólythis, Exorcístis, Lectóribus, Ostiáriis, Confessóribus, Virgínibus, Víduis: et pro omni pópulo sancto Dei.\n\nOrémus.\nFlectámus génua.\nLeváte.\nOmnípotens sempitérne Deus, cuius Spíritu totum corpus Ecclésiæ sanctificátur et régitur: exáudi nos pro univérsis ordínibus supplicántes; ut grátiæ tuæ múnere ab ómnibus tibi grádibus fidéliter serviátur. Per Christum Dóminum nostrum. Amen.","en":"Let us pray for all Bishops, Priests, Deacons, Subdeacons, Acolytes, Exorcists, Readers, Porters, Confessors, Virgins, Widows, and for all the holy people of God.\n\nLet us pray.\nLet us kneel.\nArise.\nAlmighty and everlasting God, by Whose Spirit the whole body of the Church is sanctified and governed: hear us as we pray for all her orders, that by the gift of Thy grace every rank may faithfully serve Thee. Through Christ our Lord. Amen.","fr":"Prions pour tous les évêques, prêtres, diacres, sous-diacres, acolytes, exorcistes, lecteurs, portiers, confesseurs, vierges, veuves, et pour tout le saint peuple de Dieu.\n\nPrions.\nFléchissons les genoux.\nLevez-vous.\nDieu tout-puissant et éternel, par l’Esprit duquel tout le corps de l’Église est sanctifié et gouverné : exaucez nos supplications pour tous ses ordres, afin que, par le don de votre grâce, tous les degrés vous servent fidèlement. Par le Christ notre Seigneur. Ainsi soit-il."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[{"kind":"kneel","label":"Kneel","anchorLat":"Flectámus génua","anchorEng":"Let us kneel","before":true},{"kind":"rise","label":"Rise","anchorLat":"Leváte","anchorEng":"Arise","before":true}],"explanation":"One of the Great Intercessions of Good Friday. The intention is announced, all kneel briefly in silent prayer, then rise for the collect.","ritualActions":[{"kind":"ritual_action","label":"↓ Kneel at Flectamus genua · ↑ rise at Levate","source":"special_day_step"},{"kind":"kneel","label":"Kneel","source":"cue"},{"kind":"rise","label":"Rise","source":"cue"}],"exceptional":{"rite":"good-friday","phase":"Good Friday · Solemn Prayers","liturgicalColour":"Black"}},{"id":"gf-solemn-prayer-4","phase":"Solemn Prayers","section":"Good Friday · Solemn Prayers","title":{"en":"4. For Civil Authorities","fr":"4. For Civil Authorities"},"subtitle":{"en":"Oremus · Flectamus genua · Levate","fr":"Oremus · Flectamus genua · Levate"},"actor":"mixed","priestPosition":"Altar","audibility":"silent","privateAction":false,"text":{"lat":"Orémus et pro ómnibus res públicas moderántibus, eorúmque ministériis et potestátibus: ut Deus et Dóminus noster mentes et corda eórum secúndum voluntátem suam dírigat ad nostram perpétuam pacem.\n\nOrémus.\nFlectámus génua.\nLeváte.\nOmnípotens sempitérne Deus, in cuius manu sunt ómnium potestátes et ómnium iura populórum: réspice benígnus ad eos, qui nos in potestáte regunt; ut ubíque terrárum, déxtera tua protegénte, et religiónis intégritas et pátriæ secúritas indesinénter consístat. Per Christum Dóminum nostrum. Amen.","en":"Let us pray for all who govern states and for their ministries and authorities: that our God and Lord may direct their minds and hearts according to His will for our lasting peace.\n\nLet us pray.\nLet us kneel.\nArise.\nAlmighty and everlasting God, in Whose hand are all powers and the rights of all peoples: look graciously upon those who rule us, that under the protection of Thy right hand religious integrity and the security of our country may everywhere endure. Through Christ our Lord. Amen.","fr":"Prions pour tous ceux qui gouvernent les États, pour leurs ministères et leurs pouvoirs : que notre Dieu et Seigneur dirige leurs esprits et leurs cœurs selon sa volonté, pour notre paix durable.\n\nPrions.\nFléchissons les genoux.\nLevez-vous.\nDieu tout-puissant et éternel, entre les mains duquel sont tous les pouvoirs et les droits de tous les peuples : regardez avec bonté ceux qui nous gouvernent, afin que, votre droite nous protégeant, l’intégrité de la religion et la sécurité de la patrie demeurent fermes en tout lieu. Par le Christ notre Seigneur. Ainsi soit-il."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[{"kind":"kneel","label":"Kneel","anchorLat":"Flectámus génua","anchorEng":"Let us kneel","before":true},{"kind":"rise","label":"Rise","anchorLat":"Leváte","anchorEng":"Arise","before":true}],"explanation":"One of the Great Intercessions of Good Friday. The intention is announced, all kneel briefly in silent prayer, then rise for the collect.","ritualActions":[{"kind":"ritual_action","label":"↓ Kneel at Flectamus genua · ↑ rise at Levate","source":"special_day_step"},{"kind":"kneel","label":"Kneel","source":"cue"},{"kind":"rise","label":"Rise","source":"cue"}],"exceptional":{"rite":"good-friday","phase":"Good Friday · Solemn Prayers","liturgicalColour":"Black"}},{"id":"gf-solemn-prayer-5","phase":"Solemn Prayers","section":"Good Friday · Solemn Prayers","title":{"en":"5. For Catechumens","fr":"5. For Catechumens"},"subtitle":{"en":"Oremus · Flectamus genua · Levate","fr":"Oremus · Flectamus genua · Levate"},"actor":"mixed","priestPosition":"Altar","audibility":"silent","privateAction":false,"text":{"lat":"Orémus et pro catechúmenis nostris: ut Deus et Dóminus noster adapériat aures præcordiórum ipsórum, ianuámque misericórdiæ; ut per lavácrum regeneratiónis accépta remissióne ómnium peccatórum, et ipsi inveniántur in Christo Iesu Dómino nostro.\n\nOrémus.\nFlectámus génua.\nLeváte.\nOmnípotens sempitérne Deus, qui Ecclésiam tuam nova semper prole fecúndas: auge fidem et intelléctum catechúmenis nostris; ut renáti fonte baptísmatis, adoptiónis tuæ fíliis aggregéntur. Per Christum Dóminum nostrum. Amen.","en":"Let us pray for our catechumens: that our God and Lord may open the ears of their hearts and the gate of mercy, so that receiving the remission of all sins in the laver of regeneration they too may be found in Christ Jesus our Lord.\n\nLet us pray.\nLet us kneel.\nArise.\nAlmighty and everlasting God, Who ever makest Thy Church fruitful with new offspring: increase the faith and understanding of our catechumens, that being reborn at the font of Baptism they may be joined to the children of Thy adoption. Through Christ our Lord. Amen.","fr":"Prions pour nos catéchumènes : que notre Dieu et Seigneur ouvre les oreilles de leur cœur et la porte de sa miséricorde ; afin qu’ayant reçu par le bain de la régénération la rémission de tous leurs péchés, ils soient eux aussi trouvés dans le Christ Jésus notre Seigneur.\n\nPrions.\nFléchissons les genoux.\nLevez-vous.\nDieu tout-puissant et éternel, qui fécondez toujours votre Église d’une nouvelle descendance : augmentez la foi et l’intelligence de nos catéchumènes, afin que, renés à la fontaine du Baptême, ils soient agrégés aux fils de votre adoption. Par le Christ notre Seigneur. Ainsi soit-il."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[{"kind":"kneel","label":"Kneel","anchorLat":"Flectámus génua","anchorEng":"Let us kneel","before":true},{"kind":"rise","label":"Rise","anchorLat":"Leváte","anchorEng":"Arise","before":true}],"explanation":"One of the Great Intercessions of Good Friday. The intention is announced, all kneel briefly in silent prayer, then rise for the collect.","ritualActions":[{"kind":"ritual_action","label":"↓ Kneel at Flectamus genua · ↑ rise at Levate","source":"special_day_step"},{"kind":"kneel","label":"Kneel","source":"cue"},{"kind":"rise","label":"Rise","source":"cue"}],"exceptional":{"rite":"good-friday","phase":"Good Friday · Solemn Prayers","liturgicalColour":"Black"}},{"id":"gf-solemn-prayer-6","phase":"Solemn Prayers","section":"Good Friday · Solemn Prayers","title":{"en":"6. For the Needs of the Faithful","fr":"6. For the Needs of the Faithful"},"subtitle":{"en":"Oremus · Flectamus genua · Levate","fr":"Oremus · Flectamus genua · Levate"},"actor":"mixed","priestPosition":"Altar","audibility":"silent","privateAction":false,"text":{"lat":"Orémus, dilectíssimi nobis, Deum Patrem omnipoténtem, ut cunctis mundum purget erróribus: morbos áuferat: famem depéllat: apériat cárceres: víncula dissólvat: peregrinántibus réditum: infirmántibus sanitátem: navigántibus portum salútis indúlgeat.\n\nOrémus.\nFlectámus génua.\nLeváte.\nOmnípotens sempitérne Deus, mæstórum consolátio, laborántium fortitúdo: pervéniant ad te preces de quacúmque tribulatióne clamántium; ut omnes sibi in necessitátibus suis misericórdiam tuam gáudeant affuísse. Per Christum Dóminum nostrum. Amen.","en":"Let us pray, dearly beloved, to God the Father almighty, that He may cleanse the world of error, take away disease, drive away famine, open prisons, break chains, grant travellers a safe return, health to the sick and a haven of safety to those at sea.\n\nLet us pray.\nLet us kneel.\nArise.\nAlmighty and everlasting God, comfort of the sorrowful and strength of those who labour: let the prayers of all who cry to Thee in any tribulation reach Thee, that all may rejoice that Thy mercy has helped them in their needs. Through Christ our Lord. Amen.","fr":"Prions Dieu le Père tout-puissant de purifier le monde de toute erreur, d’écarter les maladies, de chasser la famine, d’ouvrir les prisons, de briser les chaînes, d’accorder aux voyageurs le retour, aux malades la santé et aux navigateurs un port de salut.\n\nPrions.\nFléchissons les genoux.\nLevez-vous.\nDieu tout-puissant et éternel, consolation des affligés et force de ceux qui peinent : que parviennent jusqu’à vous les prières de ceux qui crient vers vous dans toute tribulation, afin que tous se réjouissent d’avoir éprouvé votre miséricorde dans leurs nécessités. Par le Christ notre Seigneur. Ainsi soit-il."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[{"kind":"kneel","label":"Kneel","anchorLat":"Flectámus génua","anchorEng":"Let us kneel","before":true},{"kind":"rise","label":"Rise","anchorLat":"Leváte","anchorEng":"Arise","before":true}],"explanation":"One of the Great Intercessions of Good Friday. The intention is announced, all kneel briefly in silent prayer, then rise for the collect.","ritualActions":[{"kind":"ritual_action","label":"↓ Kneel at Flectamus genua · ↑ rise at Levate","source":"special_day_step"},{"kind":"kneel","label":"Kneel","source":"cue"},{"kind":"rise","label":"Rise","source":"cue"}],"exceptional":{"rite":"good-friday","phase":"Good Friday · Solemn Prayers","liturgicalColour":"Black"}},{"id":"gf-solemn-prayer-7","phase":"Solemn Prayers","section":"Good Friday · Solemn Prayers","title":{"en":"7. For the Unity of the Church","fr":"7. For the Unity of the Church"},"subtitle":{"en":"Oremus · Flectamus genua · Levate","fr":"Oremus · Flectamus genua · Levate"},"actor":"mixed","priestPosition":"Altar","audibility":"silent","privateAction":false,"text":{"lat":"Orémus et pro ómnibus frátribus nostris, qui in Christum credunt: ut Deus et Dóminus noster eos a cunctis erróribus erípere, et ad sanctam matrem Ecclésiam cathólicam atque apostólicam revocáre dignétur.\n\nOrémus.\nFlectámus génua.\nLeváte.\nOmnípotens sempitérne Deus, qui salvas omnes et néminem vis períre: réspice ad ánimas diabólica fraude decéptas; ut, omni hærética pravitáte depósita, errántium corda resipíscant et ad veritátis tuæ rédeant unitátem. Per Christum Dóminum nostrum. Amen.","en":"Let us pray also for all our brethren who believe in Christ: that our God and Lord may deliver them from every error and deign to recall them to the holy mother Catholic and Apostolic Church.\n\nLet us pray.\nLet us kneel.\nArise.\nAlmighty and everlasting God, Who savest all and willest that none should perish: look upon souls deceived by error, that putting aside what separates them from the truth, their hearts may return to the unity of Thy truth. Through Christ our Lord. Amen.","fr":"Prions aussi pour tous nos frères qui croient au Christ : que notre Dieu et Seigneur daigne les délivrer de toute erreur et les rappeler à la sainte Mère Église catholique et apostolique.\n\nPrions.\nFléchissons les genoux.\nLevez-vous.\nDieu tout-puissant et éternel, qui sauvez tous les hommes et ne voulez qu’aucun périsse : regardez les âmes trompées par l’erreur ; que leurs cœurs reviennent à eux-mêmes et retournent à l’unité de votre vérité. Par le Christ notre Seigneur. Ainsi soit-il."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[{"kind":"kneel","label":"Kneel","anchorLat":"Flectámus génua","anchorEng":"Let us kneel","before":true},{"kind":"rise","label":"Rise","anchorLat":"Leváte","anchorEng":"Arise","before":true}],"explanation":"One of the Great Intercessions of Good Friday. The intention is announced, all kneel briefly in silent prayer, then rise for the collect.","ritualActions":[{"kind":"ritual_action","label":"↓ Kneel at Flectamus genua · ↑ rise at Levate","source":"special_day_step"},{"kind":"kneel","label":"Kneel","source":"cue"},{"kind":"rise","label":"Rise","source":"cue"}],"exceptional":{"rite":"good-friday","phase":"Good Friday · Solemn Prayers","liturgicalColour":"Black"}},{"id":"gf-solemn-prayer-8","phase":"Solemn Prayers","section":"Good Friday · Solemn Prayers","title":{"en":"8. For the Jewish People","fr":"8. For the Jewish People"},"subtitle":{"en":"Oremus · Flectamus genua · Levate","fr":"Oremus · Flectamus genua · Levate"},"actor":"mixed","priestPosition":"Altar","audibility":"silent","privateAction":false,"text":{"lat":"Orémus et pro Iudǽis: ut Deus et Dóminus noster illúminet corda eórum, ut agnóscant Iesum Christum salvatórem ómnium hóminum.\n\nOrémus.\nFlectámus génua.\nLeváte.\nOmnípotens sempitérne Deus, qui vis ut omnes hómines salvi fiant et ad agnitiónem veritátis véniant, concéde propítius, ut plenitúdine géntium in Ecclésiam tuam intránte omnis Israel salvus fiat. Per Christum Dóminum nostrum. Amen.","en":"Let us pray also for the Jewish people: that our God and Lord may enlighten their hearts, so that they may acknowledge Jesus Christ, the Saviour of all men.\n\nLet us pray.\nLet us kneel.\nArise.\nAlmighty and everlasting God, Who willest that all men be saved and come to the knowledge of the truth: graciously grant that, as the fullness of the nations enters Thy Church, all Israel may be saved. Through Christ our Lord. Amen.","fr":"Prions aussi pour les Juifs : que notre Dieu et Seigneur illumine leurs cœurs, afin qu’ils reconnaissent Jésus-Christ, Sauveur de tous les hommes.\n\nPrions.\nFléchissons les genoux.\nLevez-vous.\nDieu tout-puissant et éternel, qui voulez que tous les hommes soient sauvés et parviennent à la connaissance de la vérité : accordez dans votre bonté que, la plénitude des nations entrant dans votre Église, tout Israël soit sauvé. Par le Christ notre Seigneur. Ainsi soit-il."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[{"kind":"kneel","label":"Kneel","anchorLat":"Flectámus génua","anchorEng":"Let us kneel","before":true},{"kind":"rise","label":"Rise","anchorLat":"Leváte","anchorEng":"Arise","before":true}],"explanation":"One of the Great Intercessions of Good Friday. The intention is announced, all kneel briefly in silent prayer, then rise for the collect.","ritualActions":[{"kind":"ritual_action","label":"↓ Kneel at Flectamus genua · ↑ rise at Levate","source":"special_day_step"},{"kind":"kneel","label":"Kneel","source":"cue"},{"kind":"rise","label":"Rise","source":"cue"}],"exceptional":{"rite":"good-friday","phase":"Good Friday · Solemn Prayers","liturgicalColour":"Black"}},{"id":"gf-solemn-prayer-9","phase":"Solemn Prayers","section":"Good Friday · Solemn Prayers","title":{"en":"9. For Pagans","fr":"9. For Pagans"},"subtitle":{"en":"Oremus · Flectamus genua · Levate","fr":"Oremus · Flectamus genua · Levate"},"actor":"mixed","priestPosition":"Altar","audibility":"silent","privateAction":false,"text":{"lat":"Orémus et pro pagánis: ut Deus omnípotens áuferat iniquitátem a córdibus eórum; ut, relíctis idólis suis, convertántur ad Deum vivum et verum, et únicum Fílium eius Iesum Christum Deum et Dóminum nostrum.\n\nOrémus.\nFlectámus génua.\nLeváte.\nOmnípotens sempitérne Deus, qui non mortem peccatórum, sed vitam semper inquíris: súscipe propítius oratiónem nostram, et líbera eos ab idolórum cultúra; et ággrega Ecclésiæ tuæ sanctæ ad laudem et glóriam nóminis tui. Per Christum Dóminum nostrum. Amen.","en":"Let us pray also for the pagans: that almighty God may remove iniquity from their hearts, so that abandoning idols they may turn to the living and true God and to His only Son Jesus Christ, our God and Lord.\n\nLet us pray.\nLet us kneel.\nArise.\nAlmighty and everlasting God, Who seekest not the death of sinners but their life: graciously receive our prayer, deliver them from the worship of idols, and join them to Thy holy Church for the praise and glory of Thy Name. Through Christ our Lord. Amen.","fr":"Prions aussi pour les païens : que Dieu tout-puissant ôte l’iniquité de leurs cœurs ; afin qu’abandonnant leurs idoles ils se convertissent au Dieu vivant et vrai et à son Fils unique Jésus-Christ, notre Dieu et Seigneur.\n\nPrions.\nFléchissons les genoux.\nLevez-vous.\nDieu tout-puissant et éternel, qui cherchez toujours non la mort mais la vie des pécheurs : accueillez favorablement notre prière, délivrez-les du culte des idoles et agréez-les à votre sainte Église pour la louange et la gloire de votre nom. Par le Christ notre Seigneur. Ainsi soit-il."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[{"kind":"kneel","label":"Kneel","anchorLat":"Flectámus génua","anchorEng":"Let us kneel","before":true},{"kind":"rise","label":"Rise","anchorLat":"Leváte","anchorEng":"Arise","before":true}],"explanation":"One of the Great Intercessions of Good Friday. The intention is announced, all kneel briefly in silent prayer, then rise for the collect.","ritualActions":[{"kind":"ritual_action","label":"↓ Kneel at Flectamus genua · ↑ rise at Levate","source":"special_day_step"},{"kind":"kneel","label":"Kneel","source":"cue"},{"kind":"rise","label":"Rise","source":"cue"}],"exceptional":{"rite":"good-friday","phase":"Good Friday · Solemn Prayers","liturgicalColour":"Black"}},{"id":"gf-cross-unveiling","phase":"Adoration of the Cross","section":"Good Friday · Adoration of the Cross","title":{"en":"Unveiling of the Cross","fr":"Unveiling of the Cross"},"subtitle":{"en":"Ecce lignum Crucis · three times","fr":"Ecce lignum Crucis · three times"},"actor":"mixed","priestPosition":"Sanctuary","audibility":"audible","privateAction":false,"text":{"lat":"℣. Ecce lignum Crucis, in quo salus mundi pepéndit.\n℟. Veníte, adorémus.\n\n℣. Ecce lignum Crucis, in quo salus mundi pepéndit.\n℟. Veníte, adorémus.\n\n℣. Ecce lignum Crucis, in quo salus mundi pepéndit.\n℟. Veníte, adorémus.","en":"℣. Behold the wood of the Cross, on which hung the salvation of the world.\n℟. Come, let us adore.\n\n℣. Behold the wood of the Cross, on which hung the salvation of the world.\n℟. Come, let us adore.\n\n℣. Behold the wood of the Cross, on which hung the salvation of the world.\n℟. Come, let us adore.","fr":"℣. Voici le bois de la Croix, auquel fut suspendu le salut du monde.\n℟. Venez, adorons.\n\n℣. Voici le bois de la Croix, auquel fut suspendu le salut du monde.\n℟. Venez, adorons.\n\n℣. Voici le bois de la Croix, auquel fut suspendu le salut du monde.\n℟. Venez, adorons."},"posture":{"value":"KNEEL","policy":"fixed","source":"fixed"},"gestures":[],"explanation":"The veiled Cross is uncovered in three stages. Ecce lignum Crucis is sung each time and the response Venite, adoremus is made kneeling.","exceptional":{"rite":"good-friday","phase":"Good Friday · Adoration of the Cross","liturgicalColour":"Black"}},{"id":"gf-cross-veneration","phase":"Adoration of the Cross","section":"Good Friday · Adoration of the Cross","title":{"en":"Veneration of the Cross","fr":"Veneration of the Cross"},"subtitle":{"en":"Improperia · Crux fidelis","fr":"Improperia · Crux fidelis"},"actor":"mixed","priestPosition":"Cross / communion rail","audibility":"audible","privateAction":false,"text":{"lat":"IMPROPERIA\n\n℣. Pópule meus, quid feci tibi? aut in quo contristávi te? Respónde mihi.\n℣. Quia edúxi te de terra Ægýpti, parásti Crucem Salvatóri tuo.\n\n℟. Hágios o Theós!\n℟. Sanctus Deus!\n℟. Hágios Ischyrós!\n℟. Sanctus fortis!\n℟. Hágios Athánatos, eléison imas.\n℟. Sanctus immortális, miserére nobis.\n\n℣. Quia edúxi te per desértum quadragínta annis, et manna cibávi te, et introdúxi te in terram satis bonam: parásti Crucem Salvatóri tuo.\n\n℟. Hágios o Theós!\n℟. Sanctus Deus!\n℟. Hágios Ischyrós!\n℟. Sanctus fortis!\n℟. Hágios Athánatos, eléison imas.\n℟. Sanctus immortális, miserére nobis.\n\n℣. Quid ultra débui fácere tibi, et non feci? Ego quidem plantávi te víneam meam speciosíssimam: et tu facta es mihi nimis amára: acéto namque sitim meam potásti: et láncea perforásti latus Salvatóri tuo.\n\n℟. Hágios o Theós!\n℟. Sanctus Deus!\n℟. Hágios Ischyrós!\n℟. Sanctus fortis!\n℟. Hágios Athánatos, eléison imas.\n℟. Sanctus immortális, miserére nobis.\n\n℣. Ego propter te flagellávi Ægýptum cum primogénitis suis: et tu me flagellátum tradidísti.\n℟. Pópule meus, quid feci tibi? aut in quo contristávi te? Respónde mihi.\n℣. Ego edúxi te de Ægýpto, demérso Pharaóne in Mare Rubrum: et tu me tradidísti princípibus sacerdótum.\n℟. Pópule meus, quid feci tibi? aut in quo contristávi te? Respónde mihi.\n℣. Ego ante te apérui mare: et tu aperuísti láncea latus meum.\n℟. Pópule meus, quid feci tibi? aut in quo contristávi te? Respónde mihi.\n℣. Ego ante te præívi in colúmna nubis: et tu me duxísti ad prætórium Piláti.\n℟. Pópule meus, quid feci tibi? aut in quo contristávi te? Respónde mihi.\n℣. Ego te pavi manna per desértum: et tu me cecidísti álapis et flagéllis.\n℟. Pópule meus, quid feci tibi? aut in quo contristávi te? Respónde mihi.\n℣. Ego te potávi aqua salútis de petra: et tu me potásti felle et acéto.\n℟. Pópule meus, quid feci tibi? aut in quo contristávi te? Respónde mihi.\n℣. Ego propter te Chananæórum reges percússi: et tu percussísti arúndine caput meum.\n℟. Pópule meus, quid feci tibi? aut in quo contristávi te? Respónde mihi.\n℣. Ego dedi tibi sceptrum regále: et tu dedísti cápiti meo spíneam corónam.\n℟. Pópule meus, quid feci tibi? aut in quo contristávi te? Respónde mihi.\n℣. Ego te exaltávi magna virtúte: et tu me suspendísti in patíbulo Crucis.\n℟. Pópule meus, quid feci tibi? aut in quo contristávi te? Respónde mihi.\n\nANTIPHONA\nAnt. Crucem tuam adorámus, Dómine: et sanctam resurrectiónem tuam laudámus et glorificámus: ecce enim propter lignum venit gáudium in univérso mundo.\nPs 66:2\nDeus misereátur nostri, et benedícat nobis: illúminet vultum suum super nos, et misereátur nostri.\nAnt. Crucem tuam adorámus, Dómine: et sanctam resurrectiónem tuam laudámus et glorificámus: ecce enim propter lignum venit gáudium in univérso mundo.\n\nHYMNUS CRUX FIDELIS\nAnt. Crux fidélis, inter omnes arbor una nóbilis! Nulla silva talem profert, fronde, flore, gérmine. Dulce lignum, dulces clavos, dulce pondus sústinet.\n\n℣. Pange, lingua, gloriósi láuream certáminis, et super Crucis trophǽo dic triúmphum nóbilem: quáliter Redémptor orbis immolátus vícerit.\nAnt. Crux fidélis, inter omnes arbor una nóbilis! Nulla silva talem profert, fronde, flore, gérmine.\n\n℣. De paréntis protoplásti fraude Factor cóndolens, quando pomi noxiális in necem morsu ruit: ipse lignum tunc notávit, damna ligni ut sólveret.\nAnt. Dulce lignum, dulces clavos, dulce pondus sústinet.\n\n℣. Hoc opus nostræ salútis ordo depopóscerat: multifórmis proditóris ars ut artem fálleret: et medélam ferret inde, hostis unde lǽserat.\nAnt. Crux fidélis.\n\n℣. Quando venit ergo sacri plenitúdo témporis, missus est ab arce Patris natus, orbis Cónditor: atque ventre virgináli carne amíctus pródiit.\nAnt. Dulce lignum.\n\n℣. Vagit infans inter arcta cónditus præsépia: membra pannis involúta Virgo Mater álligat: et Dei manus pedésque stricta cingit fáscia.\nAnt. Crux fidélis.\n\n℣. Lustra sex qui iam perégit, tempus implens córporis, sponte líbera Redémptor passióni déditus, Agnus in Crucis levátur immolándus stípite.\nAnt. Dulce lignum.\n\n℣. Felle potus ecce languet: spina, clavi, láncea mite corpus perforárunt, unda manat et cruor: terra, pontus, astra, mundus quo lavántur flúmine!\nAnt. Crux fidélis.\n\n℣. Flecte ramos, arbor alta, tensa laxa víscera, et rigor lentéscat ille, quem dedit natívitas: et supérni membra Regis tende miti stípite.\nAnt. Dulce lignum.\n\n℣. Sola digna tu fuísti ferre mundi víctimam: atque portum præparáre arca mundo náufrago: quam sacer cruor perúnxit, fusus Agni córpore.\nAnt. Crux fidélis.\n\n℣. Sempitérna sit beátæ Trinitáti glória: æqua Patri Filióque; par decus Paráclito: Uníus Triníque nomen laudet univérsitas. Amen.\nAnt. Dulce lignum, dulces clavos, dulce pondus sústinet.","en":"THE REPROACHES\n\n℣. O My people, what have I done to thee? Or how have I grieved thee? Answer Me.\n℣. Because I led thee out of the land of Egypt, thou hast prepared a Cross for thy Saviour.\n\n℟. O holy God!\n℟. Holy God!\n℟. O holy and mighty One!\n℟. Holy and mighty One!\n℟. O holy immortal One, have mercy on us.\n℟. Holy immortal One, have mercy on us.\n\n℣. Because I led thee through the desert for forty years, fed thee with manna and brought thee into a good land, thou hast prepared a Cross for thy Saviour.\n\n℟. O holy God!\n℟. Holy God!\n℟. O holy and mighty One!\n℟. Holy and mighty One!\n℟. O holy immortal One, have mercy on us.\n℟. Holy immortal One, have mercy on us.\n\n℣. What more should I have done for thee that I did not do? I planted thee as My most beautiful vineyard, and thou hast become exceedingly bitter to Me: in My thirst thou gavest Me vinegar to drink, and with a lance thou pierced the side of thy Saviour.\n\n℟. O holy God!\n℟. Holy God!\n℟. O holy and mighty One!\n℟. Holy and mighty One!\n℟. O holy immortal One, have mercy on us.\n℟. Holy immortal One, have mercy on us.\n\n℣. For thy sake I struck Egypt with its firstborn; and thou hast handed Me over to be scourged.\n℟. O My people, what have I done to thee? Or how have I grieved thee? Answer Me.\n℣. I led thee out of Egypt and drowned Pharaoh in the Red Sea; and thou hast delivered Me to the chief priests.\n℟. O My people, what have I done to thee? Or how have I grieved thee? Answer Me.\n℣. I opened the sea before thee; and thou hast opened My side with a lance.\n℟. O My people, what have I done to thee? Or how have I grieved thee? Answer Me.\n℣. I went before thee in a pillar of cloud; and thou hast led Me to Pilate's judgment hall.\n℟. O My people, what have I done to thee? Or how have I grieved thee? Answer Me.\n℣. I fed thee with manna in the desert; and thou hast struck Me with blows and scourges.\n℟. O My people, what have I done to thee? Or how have I grieved thee? Answer Me.\n℣. I gave thee saving water from the rock; and thou hast given Me gall and vinegar to drink.\n℟. O My people, what have I done to thee? Or how have I grieved thee? Answer Me.\n℣. For thy sake I struck the kings of Canaan; and thou hast struck My head with a reed.\n℟. O My people, what have I done to thee? Or how have I grieved thee? Answer Me.\n℣. I gave thee a royal sceptre; and thou hast given My head a crown of thorns.\n℟. O My people, what have I done to thee? Or how have I grieved thee? Answer Me.\n℣. I exalted thee with great power; and thou hast hanged Me upon the gibbet of the Cross.\n℟. O My people, what have I done to thee? Or how have I grieved thee? Answer Me.\n\nANTIPHON\nAnt. We adore Thy Cross, O Lord, and we praise and glorify Thy holy Resurrection: for behold, through the wood of the Cross joy has come into the whole world.\nPs 66:2\nMay God have mercy on us and bless us; may He cause His face to shine upon us and have mercy on us.\nAnt. We adore Thy Cross, O Lord, and we praise and glorify Thy holy Resurrection: for behold, through the wood of the Cross joy has come into the whole world.\n\nHYMN: CRUX FIDELIS\nAnt. Faithful Cross, the one noble tree above all others! No forest bears thy equal in leaf, flower or fruit. Sweet wood, sweet nails, bearing so sweet a burden.\n\n℣. Sing, O tongue, the laurels of the glorious contest; proclaim above the trophy of the Cross the noble triumph by which the Redeemer of the world conquered through His sacrifice.\nAnt. Faithful Cross, the one noble tree above all others! No forest bears thy equal in leaf, flower or fruit.\n\n℣. The Creator, grieving over the fall of our first parent when he ate the deadly fruit, then chose a tree to undo the harm wrought by a tree.\nAnt. Sweet wood, sweet nails, bearing so sweet a burden.\n\n℣. The order of our salvation required this work: that art might defeat the many forms of the deceiver's art, and healing might come from the very place where the enemy had wounded.\nAnt. Faithful Cross.\n\n℣. When at last the fullness of sacred time had come, the Son, the Creator of the world, was sent from the Father's throne and came forth clothed in flesh from the Virgin's womb.\nAnt. Sweet wood.\n\n℣. The Infant cries, laid in the narrow manger; the Virgin Mother wraps His limbs in swaddling clothes, binding the hands and feet of God in their bands.\nAnt. Faithful Cross.\n\n℣. When thirty years were accomplished and the appointed span of His earthly life fulfilled, the Redeemer freely gave Himself to His Passion; the Lamb was raised upon the tree of the Cross to be sacrificed.\nAnt. Sweet wood.\n\n℣. Behold Him faint beneath the gall: thorn, nails and lance have pierced His gentle Body; water and Blood flow forth, a stream in which earth, sea, stars and world are washed.\nAnt. Faithful Cross.\n\n℣. Bend thy branches, lofty tree; relax thy rigid fibres; let the hardness given thee by nature grow gentle, and bear softly the limbs of the heavenly King.\nAnt. Sweet wood.\n\n℣. Thou alone wast found worthy to bear the Victim of the world and, like the ark, prepare a harbour for a shipwrecked race; thou wast anointed by the sacred Blood poured from the Lamb's Body.\nAnt. Faithful Cross.\n\n℣. Everlasting glory be to the blessed Trinity: equal honour to Father and Son, equal praise to the Paraclete; let the whole creation praise the Name of the One and Three. Amen.\nAnt. Sweet wood, sweet nails, bearing so sweet a burden.","fr":"Ô mon peuple, que t’ai-je fait ? en quoi t’ai-je attristé ? Réponds-moi.\n\nDieu saint.\nSaint et fort.\nSaint et immortel, ayez pitié de nous.\n\nCroix fidèle, arbre unique et noble entre tous : nulle forêt n’en produit de semblable par ses feuilles, ses fleurs et son fruit."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[{"kind":"genuflect","label":"Genuflect before veneration","anchorLat":"Pópule meus","anchorEng":"O My people","before":true}],"explanation":"The celebrant, ministers, clergy and faithful venerate the Cross. The Improperia and Crux fidelis accompany the veneration.","ritualActions":[{"kind":"ritual_action","label":"Approach when directed · genuflect before venerating the Cross","source":"special_day_step"},{"kind":"genuflect","label":"Genuflect before veneration","source":"cue"}],"exceptional":{"rite":"good-friday","phase":"Good Friday · Adoration of the Cross","liturgicalColour":"Black"}},{"id":"gf-sacrament-return","phase":"Holy Communion","section":"Good Friday · Holy Communion","title":{"en":"Return of the Blessed Sacrament","fr":"Return of the Blessed Sacrament"},"subtitle":{"en":"Vestments change to violet","fr":"Vestments change to violet"},"actor":"mixed","priestPosition":"Procession from the repository","audibility":"audible","privateAction":false,"text":{"lat":"Adorámus te, Christe, et benedícimus tibi: quia per Crucem tuam redemísti mundum.","en":"We adore Thee, O Christ, and we bless Thee, because by Thy Cross Thou hast redeemed the world.","fr":"Nous vous adorons, ô Christ, et nous vous bénissons, parce que par votre Croix vous avez racheté le monde."},"posture":{"value":"KNEEL","policy":"fixed","source":"fixed"},"gestures":[],"explanation":"For the Communion part of the Action the vestments are violet. The Blessed Sacrament consecrated on Holy Thursday is brought from the altar of repose.","exceptional":{"rite":"good-friday","phase":"Good Friday · Holy Communion","liturgicalColour":"Violet"}},{"id":"gf-pater","phase":"Holy Communion","section":"Good Friday · Holy Communion","title":{"en":"Pater noster","fr":"Pater noster"},"subtitle":{"en":"All present recite it in Latin","fr":"All present recite it in Latin"},"actor":"mixed","priestPosition":"Altar","audibility":"audible","privateAction":false,"text":{"lat":"Orémus.\nPræcéptis salutáribus móniti, et divína institutióne formáti, audémus dícere:\n\nPater noster, qui es in cælis, sanctificétur nomen tuum. Advéniat regnum tuum. Fiat volúntas tua, sicut in cælo et in terra. Panem nostrum quotidiánum da nobis hódie: et dimítte nobis débita nostra, sicut et nos dimíttimus debitóribus nostris. Et ne nos indúcas in tentatiónem; sed líbera nos a malo. Amen.","en":"Let us pray.\nTaught by saving precepts and formed by divine instruction, we make bold to say:\n\nOur Father, Who art in heaven, hallowed be Thy Name. Thy kingdom come. Thy will be done on earth as it is in heaven. Give us this day our daily bread; and forgive us our trespasses, as we forgive those who trespass against us. And lead us not into temptation; but deliver us from evil. Amen.","fr":"Prions.\nInstruits par les préceptes du Sauveur et formés par son divin enseignement, nous osons dire :\n\nNotre Père, qui êtes aux cieux, que votre nom soit sanctifié ; que votre règne arrive ; que votre volonté soit faite sur la terre comme au ciel. Donnez-nous aujourd’hui notre pain de chaque jour ; pardonnez-nous nos offenses comme nous pardonnons à ceux qui nous ont offensés ; et ne nous laissez pas succomber à la tentation ; mais délivrez-nous du mal. Ainsi soit-il."},"posture":{"value":"STAND","policy":"fixed","source":"fixed"},"gestures":[],"explanation":"In the 1962 Good Friday rite all present, clergy and faithful, recite the Pater noster together in Latin.","exceptional":{"rite":"good-friday","phase":"Good Friday · Holy Communion","liturgicalColour":"Violet"}},{"id":"gf-libera","phase":"Holy Communion","section":"Good Friday · Holy Communion","title":{"en":"Libera nos","fr":"Libera nos"},"subtitle":{"en":"Celebrant alone · Amen by all","fr":"Celebrant alone · Amen by all"},"actor":"mixed","priestPosition":"Altar","audibility":"audible","privateAction":false,"text":{"lat":"Líbera nos, quǽsumus, Dómine, ab ómnibus malis, prætéritis, præséntibus et futúris: et intercedénte beáta et gloriósa semper Vírgine Dei Genetríce María, cum beátis Apóstolis tuis Petro et Paulo, atque Andréa, et ómnibus Sanctis, da propítius pacem in diébus nostris: ut, ope misericórdiæ tuæ adiúti, et a peccáto simus semper líberi et ab omni perturbatióne secúri. Per eúndem Christum Dóminum nostrum Iesum Christum Fílium tuum, qui tecum vivit et regnat in unitáte Spíritus Sancti Deus, per ómnia sǽcula sæculórum.\n℟. Amen.","en":"Deliver us, we beseech Thee, O Lord, from all evils, past, present and to come; and by the intercession of the blessed and glorious ever Virgin Mary, Mother of God, with Thy blessed Apostles Peter and Paul and Andrew, and all the Saints, mercifully grant peace in our days; that, helped by Thy mercy, we may always be free from sin and safe from all disturbance. Through the same Jesus Christ, Thy Son our Lord, Who liveth and reigneth with Thee in the unity of the Holy Ghost, God, world without end.\n℟. Amen.","fr":"Délivrez-nous, Seigneur, nous vous en supplions, de tous les maux passés, présents et à venir ; et par l’intercession de la bienheureuse et glorieuse Marie toujours Vierge, Mère de Dieu, de vos bienheureux Apôtres Pierre, Paul et André, et de tous les Saints, accordez-nous la paix en nos jours ; afin que, soutenus par votre miséricorde, nous soyons toujours libres du péché et à l’abri de tout trouble. Par le même Jésus-Christ, votre Fils, notre Seigneur, qui vit et règne avec vous dans l’unité du Saint-Esprit, Dieu, dans tous les siècles des siècles.\n℟. Ainsi soit-il."},"posture":{"value":"STAND","policy":"fixed","source":"fixed"},"gestures":[],"explanation":"The celebrant continues alone with Libera nos; all answer Amen at its conclusion.","exceptional":{"rite":"good-friday","phase":"Good Friday · Holy Communion","liturgicalColour":"Violet"}},{"id":"gf-priest-communion","phase":"Holy Communion","section":"Good Friday · Holy Communion","title":{"en":"Communion of the Celebrant","fr":"Communion of the Celebrant"},"subtitle":{"en":"Perceptio · Domine non sum dignus ×3","fr":"Perceptio · Domine non sum dignus ×3"},"actor":"mixed","priestPosition":"Altar","audibility":"quiet","privateAction":false,"text":{"lat":"Percéptio Córporis tui, Dómine Iesu Christe, quod ego indígnus súmere præsúmo, non mihi provéniat in iudícium et condemnatiónem: sed pro tua pietáte prosit mihi ad tutaméntum mentis et córporis, et ad medélam percipiéndam: Qui vivis et regnas cum Deo Patre in unitáte Spíritus Sancti Deus, per ómnia saecula sæculórum. Amen.\n\nDómine, non sum dignus, ut intres sub tectum meum: sed tantum dic verbo, et sanábitur ánima mea. ×3\nCorpus Dómini nostri Iesu Christi custódiat ánimam meam in vitam ætérnam. Amen.","en":"Let not the partaking of Thy Body, O Lord Jesus Christ, which I, though unworthy, presume to receive, turn to my judgment and condemnation; but through Thy mercy may it be unto me a safeguard and a healing remedy both of soul and body. Who livest and reignest with God the Father, in the unity of the Holy Ghost, God, world without end. Amen.\n\nLord, I am not worthy that Thou shouldst enter under my roof; but only say the word and my soul shall be healed. ×3\nMay the Body of our Lord Jesus Christ preserve my soul unto everlasting life. Amen.","fr":"Que la réception de votre Corps, que j’ose prendre tout indigne que je suis, Seigneur Jésus-Christ, n’entraîne pour moi ni jugement ni condamnation ; mais que, par votre bonté, elle serve de soutien et de remède à mon âme et à mon corps. Vous qui, étant Dieu, vivez et régnez avec Dieu le Père dans l’unité du Saint-Esprit, dans tous les siècles des siècles. Ainsi soit-il.\n\nSeigneur, je ne suis pas digne que vous entriez sous mon toit ; mais dites seulement une parole et mon âme sera guérie. ×3\nQue le Corps de Notre-Seigneur Jésus-Christ garde mon âme pour la vie éternelle. Ainsi soit-il."},"posture":{"value":"KNEEL","policy":"fixed","source":"fixed"},"gestures":[],"explanation":"There is no Mass Canon or consecration on Good Friday. The celebrant receives the Blessed Sacrament reserved from Holy Thursday.","exceptional":{"rite":"good-friday","phase":"Good Friday · Holy Communion","liturgicalColour":"Violet"}},{"id":"gf-faithful-communion","phase":"Holy Communion","section":"Good Friday · Holy Communion","title":{"en":"Communion of the Faithful","fr":"Communion of the Faithful"},"subtitle":{"en":"Misereatur · Indulgentiam · Ecce Agnus Dei","fr":"Misereatur · Indulgentiam · Ecce Agnus Dei"},"actor":"mixed","priestPosition":"Altar / communion rail","audibility":"audible","privateAction":false,"text":{"lat":"Misereátur vestri omnípotens Deus, et, dimíssis peccátis vestris, perdúcat vos ad vitam ætérnam.\n℟. Amen.\nIndulgéntiam, absolutiónem et remissiónem peccatórum vestrórum tríbuat vobis omnípotens et miséricors Dóminus.\n℟. Amen.\nEcce Agnus Dei, ecce qui tollit peccáta mundi.\nDómine, non sum dignus, ut intres sub tectum meum: sed tantum dic verbo, et sanábitur ánima mea. ×3","en":"May almighty God have mercy on you, forgive you your sins, and bring you to everlasting life.\n℟. Amen.\nMay the almighty and merciful Lord grant you pardon, absolution and remission of your sins.\n℟. Amen.\nBehold the Lamb of God; behold Him Who taketh away the sins of the world.\nLord, I am not worthy that Thou shouldst enter under my roof; but only say the word and my soul shall be healed. ×3","fr":"Que le Dieu tout-puissant vous fasse miséricorde, qu’il vous pardonne vos péchés et vous conduise à la vie éternelle.\n℟. Ainsi soit-il.\nQue le Seigneur tout-puissant et miséricordieux vous accorde le pardon, l’absolution et la rémission de vos péchés.\n℟. Ainsi soit-il.\nVoici l’Agneau de Dieu, voici celui qui enlève les péchés du monde.\nSeigneur, je ne suis pas digne que vous entriez sous mon toit ; mais dites seulement une parole et mon âme sera guérie. ×3"},"posture":{"value":"KNEEL","policy":"fixed","source":"fixed"},"gestures":[],"explanation":"Good Friday has its own Communion preparation. The sign made by the celebrant during Indulgentiam is not shown as an instruction to the faithful; congregational participation in Domine non sum dignus is treated as a traditional participation custom.","exceptional":{"rite":"good-friday","phase":"Good Friday · Holy Communion","liturgicalColour":"Violet"}},{"id":"gf-final-prayers","phase":"Conclusion","section":"Good Friday · Conclusion","title":{"en":"Three Concluding Prayers","fr":"Three Concluding Prayers"},"subtitle":{"en":"Thanksgiving after Holy Communion","fr":"Thanksgiving after Holy Communion"},"actor":"mixed","priestPosition":"Altar","audibility":"audible","privateAction":false,"text":{"lat":"Orémus.\nSuper pópulum tuum, quǽsumus, Dómine, qui passiónem et mortem Fílii tui devóta mente recóluit, benedíctio copiósa descéndat, indulgéntia véniat, consolátio tribuátur, fides sancta succréscat, redémptio sempitérna firmétur. Per eúndem Christum Dóminum nostrum. Amen.\n\nOrémus.\nOmnípotens et miséricors Deus, qui Christi tui beáta passióne et morte nos reparásti: consérva in nobis óperam misericórdiæ tuæ; ut huius mystérii participatióne, perpétua devotióne vivámus. Per eúndem Christum Dóminum nostrum. Amen.\n\nOrémus.\nReminíscere miseratiónum tuárum, Dómine, et fámulos tuos ætérna protectióne sanctífica, pro quibus Christus, Fílius tuus, per suum cruórem instítuit paschále mystérium. Per eúndem Christum Dóminum nostrum. Amen.","en":"Let us pray.\nUpon Thy people who have devoutly recalled the Passion and Death of Thy Son, we beseech Thee, O Lord, may abundant blessing descend; may pardon come, consolation be given, holy faith increase and everlasting redemption be made firm. Through the same Christ our Lord. Amen.\n\nLet us pray.\nAlmighty and merciful God, Who hast restored us by the blessed Passion and Death of Thy Christ: preserve in us the work of Thy mercy, that by participation in this mystery we may live in perpetual devotion. Through the same Christ our Lord. Amen.\n\nLet us pray.\nRemember Thy mercies, O Lord, and sanctify with eternal protection Thy servants, for whom Christ Thy Son established by His Blood the Paschal mystery. Through the same Christ our Lord. Amen.","fr":"Prions.\nSur votre peuple qui a pieusement rappelé la Passion et la Mort de votre Fils, nous vous en supplions, Seigneur, que descende une bénédiction abondante ; que viennent le pardon et la consolation, que la sainte foi croisse et que la rédemption éternelle soit affermie. Par le même Christ notre Seigneur. Ainsi soit-il.\n\nPrions.\nDieu tout-puissant et miséricordieux, qui nous avez restaurés par la bienheureuse Passion et la Mort de votre Christ : conservez en nous l’œuvre de votre miséricorde, afin que par la participation à ce mystère nous vivions dans une dévotion constante. Par le même Christ notre Seigneur. Ainsi soit-il.\n\nPrions.\nSouvenez-vous de vos miséricordes, Seigneur, et sanctifiez par une protection éternelle vos serviteurs, pour lesquels le Christ votre Fils a institué par son Sang le mystère pascal. Par le même Christ notre Seigneur. Ainsi soit-il."},"posture":{"value":"STAND","policy":"fixed","source":"fixed"},"gestures":[],"explanation":"Three prayers conclude the Solemn Liturgical Action after Communion.","exceptional":{"rite":"good-friday","phase":"Good Friday · Conclusion","liturgicalColour":"Violet"}},{"id":"gf-end","phase":"Conclusion","section":"Good Friday · Conclusion","title":{"en":"End of the Solemn Liturgical Action","fr":"End of the Solemn Liturgical Action"},"subtitle":{"en":"No Ite missa est · no blessing · no Last Gospel","fr":"No Ite missa est · no blessing · no Last Gospel"},"actor":"mixed","priestPosition":"Sanctuary","audibility":"audible","privateAction":false,"text":{"lat":"Finita Actione liturgica, Sanctissimum Sacramentum reponitur, et altare denuo denudatur.","en":"When the Liturgical Action is finished, the Blessed Sacrament is reposed and the altar is stripped again.","fr":"À la fin de l’Action liturgique, le Saint-Sacrement est replacé au tabernacle ou réservé selon les rubriques, et l’autel est de nouveau dépouillé."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"Good Friday ends without the ordinary dismissal, final blessing or Last Gospel of Mass.","ritualActions":[],"exceptional":{"rite":"good-friday","phase":"Good Friday · Conclusion","liturgicalColour":"Violet"}}],"easter_vigil":[{"id":"vigil-fire","phase":"Paschal Vigil","section":"Special Rite · Easter Vigil","title":{"en":"New Fire","fr":"New Fire"},"subtitle":{"en":"Blessing of the new fire","fr":"Blessing of the new fire"},"actor":"mixed","priestPosition":"Outside / entrance","audibility":"audible","privateAction":false,"text":{"lat":"℣. Dóminus vobíscum.\n℟. Et cum spíritu tuo.\nOrémus.\nDeus, qui per Fílium tuum, angulárem scílicet lápidem, claritátis tuæ ignem fidélibus contulísti: prodúctum e sílice, nostris profutúrum úsibus, novum hunc ignem sanctí ✠ fica: et concéde nobis, ita per hæc festa paschália cœléstibus desidériis inflammári; ut ad perpétuæ claritátis, puris méntibus, valeámus festa pertíngere. Per eúndem Christum Dóminum nostrum.\n℟. Amen.","en":"℣. The Lord be with you.\n℟. And with thy spirit.\nLet us pray.\nO God, Who through Thy Son, the cornerstone, hast bestowed upon the faithful the fire of Thy brightness: sanctify ✠ this new fire, struck from the flint for our use; and grant that during these Paschal festivities we may be so inflamed with heavenly desires that, with purified minds, we may attain the feast of everlasting light. Through the same Christ our Lord.\n℟. Amen.","fr":"La Vigile pascale commence par la bénédiction du feu nouveau. Les cloches et l’orgue restent silencieux ; la crécelle les remplace jusqu’au Gloria de la Messe."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"The Vigil begins with the new fire. Bells and organ remain silent until the Gloria of the Mass.","ritualActions":[],"exceptional":{"rite":"easter-vigil","phase":"Special Rite · Easter Vigil","liturgicalColour":"Violet"}},{"id":"vigil-candle","phase":"Paschal Vigil","section":"Special Rite · Easter Vigil","title":{"en":"Paschal Candle","fr":"Paschal Candle"},"subtitle":{"en":"Preparation, lighting and blessing","fr":"Preparation, lighting and blessing"},"actor":"mixed","priestPosition":"New fire","audibility":"audible","privateAction":false,"text":{"lat":"Christus heri et hódie,\nPrincípium et Finis,\nAlpha et Omega;\nIpsíus sunt témpora\net sǽcula;\nIpsi glória et impérium\nper univérsa æternitátis sǽcula. Amen.\n\nPer sua sancta vúlnera\ngloriósa\ncustódiat\net consérvet nos\nChristus Dóminus. Amen.\n\nLumen Christi glorióse resurgéntis\ndíssipet ténebras cordis et mentis.\n\n℣. Dóminus vobíscum.\n℟. Et cum spíritu tuo.\nOrémus.\nVéniat, quǽsumus, omnípotens Deus, super hoc incénsum céreum larga tuæ bene ✠ dictiónis infúsio: et hunc noctúrnum splendórem invisíbilis regenerátor, inténde; ut non solum sacrifícium, quod hac nocte litátum est, arcána lúminis tui admixtióne refúlgeat; sed in quocúmque loco ex huius sanctificatiónis mystério aliquid fúerit deportátum, expúlsa diabólicæ fraudis nequítia, virtus tuæ maiestátis assístat. Per Christum Dóminum nostrum.\n℟. Amen.","en":"Christ yesterday and today,\nthe Beginning and the End,\nAlpha and Omega;\nHis are the times\nand the ages;\nto Him be glory and dominion\nthrough all the ages of eternity. Amen.\n\nThrough His holy\nand glorious wounds,\nmay Christ the Lord\nguard\nand preserve us. Amen.\n\nMay the light of Christ, gloriously risen,\ndispel the darkness of heart and mind.\n\n℣. The Lord be with you.\n℟. And with thy spirit.\nLet us pray.\nMay the abundant outpouring of Thy ✠ blessing, we beseech Thee, almighty God, descend upon this burning candle; and do Thou, invisible Regenerator, enlighten this night, so that not only the sacrifice offered this night may shine with the hidden mingling of Thy light, but wherever anything from this sacred mystery is carried, the malice of diabolical deceit may be driven out and the power of Thy majesty may be present. Through Christ our Lord.\n℟. Amen.","fr":"Le cierge pascal est préparé, marqué, garni des grains d’encens, allumé au feu nouveau et béni avant la procession dans l’église."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"The celebrant marks the Paschal candle with the cross, Alpha and Omega and the year, inserts the five grains of incense, lights the candle from the new fire and blesses it before the procession into the church.","ritualActions":[],"exceptional":{"rite":"easter-vigil","phase":"Special Rite · Easter Vigil","liturgicalColour":"Violet"}},{"id":"vigil-lumen","phase":"Paschal Vigil","section":"Special Rite · Easter Vigil","title":{"en":"Lumen Christi","fr":"Lumen Christi"},"subtitle":{"en":"Procession into the church · three times","fr":"Procession into the church · three times"},"actor":"mixed","priestPosition":"Procession","audibility":"audible","privateAction":false,"text":{"lat":"℣. Lumen Christi.\n℟. Deo grátias.\n\n℣. Lumen Christi.\n℟. Deo grátias.\n\n℣. Lumen Christi.\n℟. Deo grátias.","en":"℣. The Light of Christ.\n℟. Thanks be to God.\n\n℣. The Light of Christ.\n℟. Thanks be to God.\n\n℣. The Light of Christ.\n℟. Thanks be to God.","fr":"℣. Lumière du Christ.\n℟. Nous rendons grâces à Dieu.\n\n℣. Lumière du Christ.\n℟. Nous rendons grâces à Dieu.\n\n℣. Lumière du Christ.\n℟. Nous rendons grâces à Dieu."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"Lumen Christi is sung three times as the Paschal candle is carried into the darkened church.","ritualActions":[],"exceptional":{"rite":"easter-vigil","phase":"Special Rite · Easter Vigil","liturgicalColour":"Violet"}},{"id":"vigil-exsultet","phase":"Paschal Vigil","section":"Special Rite · Easter Vigil","title":{"en":"Exsultet","fr":"Exsultet"},"subtitle":{"en":"Praeconium Paschale · full text","fr":"Praeconium Paschale · full text"},"actor":"mixed","priestPosition":"Paschal candle","audibility":"audible","privateAction":false,"text":{"lat":"Exsúltet iam Angélica turba cælórum: exsúltent divína mystéria: et pro tanti Regis victória tuba ínsonet salutáris. Gáudeat et tellus tantis irradiáta fulgóribus: et ætérni Regis splendóre illustráta, totíus orbis se séntiat amisísse calíginem. Lætétur et mater Ecclésia, tanti lúminis adornáta fulgóribus: et magnis populórum vócibus hæc aula resúltet. Quaprópter astántes vos, fratres caríssimi, ad tam miram huius sancti lúminis claritátem, una mecum, quæso, Dei omnipoténtis misericórdiam invocáte. Ut, qui me non meis méritis intra Levitárum númerum dignatus est aggregáre: lúminis sui claritátem infúndens, Cérei huius laudem implére perfíciat. Per Dóminum nostrum Iesum Christum, Fílium suum: qui cum eo vivit et regnat in unitáte Spíritus Sancti Deus: per ómnia sǽcula sæculórum.\n℟. Amen.\n\n℣. Dóminus vobíscum.\n℟. Et cum spíritu tuo.\n℣. Sursum corda.\n℟. Habémus ad Dóminum.\n℣. Grátias agámus Dómino Deo nostro.\n℟. Dignum et iustum est.\n\nVere dignum et iustum est, invísibilem Deum Patrem omnipoténtem Filiúmque eius unigénitum, Dóminum nostrum Iesum Christum, toto cordis ac mentis afféctu et vocis ministério personáre. Qui pro nobis ætérno Patri Adæ débitum solvit: et véteris piáculi cautiónem pio cruóre detérsit. Hæc sunt enim festa paschália, in quibus verus ille Agnus occíditur, cuius sánguine postes fidélium consecrántur.\n\nHæc nox est, in qua primum patres nostros, fílios Israël edúctos de Ægýpto, Mare Rubrum sicco vestígio transire fecísti. Hæc ígitur nox est, quæ peccatórum ténebras colúmnæ illuminatióne purgávit. Hæc nox est, quæ hódie per univérsum mundum in Christo credéntes, a vítiis sǽculi et calígine peccatórum segregátos, reddit grátiæ, sóciat sanctitáti. Hæc nox est, in qua, destrúctis vínculis mortis, Christus ab ínferis victor ascéndit. Nihil enim nobis nasci prófuit, nisi rédimi profuísset.\n\nO mira circa nos tuæ pietátis dignátio! O inæstimábilis diléctio caritátis: ut servum redímeres, Fílium tradidísti! O certe necessárium Adæ peccátum, quod Christi morte delétum est! O felix culpa, quæ talem ac tantum méruit habére Redemptórem! O vere beáta nox, quæ sola méruit scire tempus et horam, in qua Christus ab ínferis resurréxit! Hæc nox est, de qua scriptum est: Et nox sicut dies illuminábitur: et nox illuminátio mea in delíciis meis.\n\nHuius ígitur sanctificátio noctis fugat scélera, culpas lavat: et reddit innocéntiam lapsis et mæstis lætítiam. Fugat ódia, concórdiam parat et curvat impéria.\n\nIn huius ígitur noctis grátia, súscipe, sancte Pater, incénsi huius sacrifícium vespertínum: quod tibi in hac Cérei oblatióne solémni, per ministrórum manus de opéribus apum, sacrosáncta reddit Ecclésia. Sed iam colúmnæ huius præcónia nóvimus, quam in honórem Dei rútilans ignis accéndit. Qui licet sit divísus in partes, mutuáti tamen lúminis detriménta non novit. Alitur enim liquántibus ceris, quas in substántiam pretiósæ huius lámpadis apis mater edúxit.\n\nO vere beáta nox, quæ exspoliávit Ægýptios, ditávit Hebrǽos! Nox, in qua terrénis cæléstia, humánis divína iungúntur.\n\nOrámus ergo te, Dómine: ut Céreus iste in honórem tui nóminis consecrátus, ad noctis huius calíginem destruéndam, indefíciens persevéret. Et in odórem suavitátis accéptus, supérnis lumináribus misceátur. Flammas eius lúcifer matutínus invéniat. Ille, inquam, lúcifer, qui nescit occásum. Ille, qui regréssus ab ínferis, humáno géneri serénus illúxit.\n\nPrecámur ergo te, Dómine: ut nos fámulos tuos, omnémque clerum, et devotíssimum pópulum: una cum beatíssimo Papa nostro N., et Antístite nostro N., quiéte témporum concéssa, in his paschálibus gáudiis, assídua protectióne régere, gubernáre et conserváre dignéris. Réspice étiam ad eos, qui nos in potestáte regunt, et, ineffábili pietátis et misericórdiæ tuæ múnere, dírige cogitatiónes eórum ad iustítiam et pacem, ut de terréna operositáte ad cæléstem pátriam pervéniant cum omni pópulo tuo.\n\nPer eúndem Dóminum nostrum Iesum Christum, Fílium tuum: qui tecum vivit et regnat in unitáte Spíritus Sancti Deus: per ómnia sǽcula sæculórum.\n℟. Amen.","en":"Let the angelic host of heaven now rejoice; let the divine mysteries exult; and let the trumpet of salvation proclaim the victory of so great a King. Let the earth also rejoice, radiant with such splendour, and, enlightened by the brightness of the eternal King, know that the darkness of the whole world has been dispelled. Let Mother Church rejoice, adorned with the brightness of so great a light, and let this sacred place resound with the mighty voices of the people.\n\nTherefore, dearly beloved brethren, standing in the wondrous brightness of this holy light, I ask you to invoke with me the mercy of almighty God: that He who, without merit of mine, has deigned to number me among His ministers may pour into me the splendour of His light and enable me to complete the praise of this candle. Through our Lord Jesus Christ, His Son, Who with Him lives and reigns in the unity of the Holy Ghost, God, for ever and ever.\n℟. Amen.\n\n℣. The Lord be with you.\n℟. And with thy spirit.\n℣. Lift up your hearts.\n℟. We have lifted them up to the Lord.\n℣. Let us give thanks to the Lord our God.\n℟. It is meet and just.\n\nIt is truly meet and just to proclaim, with the whole affection of heart and mind and with the service of our voice, the invisible God, the almighty Father, and His only-begotten Son, our Lord Jesus Christ. He paid on our behalf to the eternal Father the debt of Adam, and by the merciful shedding of His Blood cancelled the bond of the ancient sin. For these are the Paschal feasts in which that true Lamb is slain, by Whose Blood the doorposts of the faithful are consecrated.\n\nThis is the night in which Thou didst first lead our fathers, the children of Israel, out of Egypt and make them pass dry-shod through the Red Sea. This is the night which dispelled the darkness of sin by the light of the pillar. This is the night which today, throughout the whole world, restores to grace and joins to holiness those who believe in Christ, separated from the vices of the world and the darkness of sin. This is the night in which Christ, breaking the bonds of death, rose victorious from the grave. For our birth would have profited us nothing had we not been redeemed.\n\nO wonderful condescension of Thy mercy toward us! O immeasurable love of charity: to redeem a servant, Thou gavest up Thy Son! O truly necessary sin of Adam, destroyed by the death of Christ! O happy fault, which merited to have such and so great a Redeemer! O truly blessed night, which alone deserved to know the time and hour when Christ rose from the grave! This is the night of which it is written: And the night shall be as bright as the day; and the night is my light in my delight.\n\nThe sanctification of this night therefore drives away wickedness, washes away guilt, restores innocence to the fallen and gladness to the sorrowful. It banishes hatred, prepares concord and bows down earthly pride.\n\nIn the grace of this night, then, receive, O holy Father, the evening sacrifice of this incense, which Holy Church offers to Thee in the solemn offering of this candle, the work of bees, through the hands of her ministers. We know now the praise of this pillar which the shining fire kindles in honour of God. Though its light is divided among many flames, it suffers no loss by being shared, for it is fed by the melting wax which the mother bee produced for the substance of this precious lamp.\n\nO truly blessed night, which despoiled the Egyptians and enriched the Hebrews! A night in which heavenly things are joined to earthly, and divine things to human.\n\nWe beseech Thee, therefore, O Lord, that this candle, consecrated to the honour of Thy Name, may continue unfailing to dispel the darkness of this night. Accepted as a sweet fragrance, may it mingle with the lights of heaven. May the morning star find its flame still burning: that Star, we mean, which knows no setting, Christ, Who returning from the grave shone serenely upon mankind.\n\nWe beseech Thee, therefore, O Lord, that Thou wouldst deign, in the joy of this Paschal feast, to rule, govern and preserve with Thy continual protection us Thy servants, all the clergy and Thy devout people, together with our most holy Pope N. and our Bishop N., granting us peaceful times. Look also upon those who exercise authority over us, and by the ineffable gift of Thy goodness and mercy direct their thoughts toward justice and peace, that from their earthly labour they may come with all Thy people to the heavenly homeland.\n\nThrough the same Jesus Christ, Thy Son, our Lord, Who with Thee lives and reigns in the unity of the Holy Ghost, God, for ever and ever.\n℟. Amen.","fr":"Que désormais la troupe des anges tressaille de joie dans le ciel ; que les divins mystères exultent, et que pour la victoire d’un si grand Roi retentisse la trompette du salut."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"The Paschal proclamation is sung at the Paschal candle after the Lumen Christi procession.","ritualActions":[],"exceptional":{"rite":"easter-vigil","phase":"Special Rite · Easter Vigil","liturgicalColour":"White"}},{"id":"vigil-prophecies","phase":"Paschal Vigil","section":"Special Rite · Easter Vigil","title":{"en":"Four Prophecies","fr":"Four Prophecies"},"subtitle":{"en":"Genesis · Exodus · Isaiah · Deuteronomy","fr":"Genesis · Exodus · Isaiah · Deuteronomy"},"actor":"mixed","priestPosition":"Sanctuary","audibility":"audible","privateAction":false,"text":{"lat":"Quattuor lectiones seu Prophetiae leguntur, cum canticis et orationibus propriis: Genesis 1:1–2:2; Exodus 14:24–15:1; Isaias 4:1–6; Deuteronomium 31:22–30.","en":"Four Lessons or Prophecies are read, each with its appointed canticle and prayer: Genesis 1:1–2:2; Exodus 14:24–15:1; Isaiah 4:1–6; Deuteronomy 31:22–30.","fr":"Quatre leçons ou Prophéties sont lues, avec leurs cantiques et oraisons propres."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"The 1962 Vigil has four Old Testament lessons, with their canticles and orations.","ritualActions":[],"exceptional":{"rite":"easter-vigil","phase":"Special Rite · Easter Vigil","liturgicalColour":"Violet"}},{"id":"vigil-font","phase":"Paschal Vigil","section":"Special Rite · Easter Vigil","title":{"en":"Litany and Baptismal Font","fr":"Litany and Baptismal Font"},"subtitle":{"en":"Ceremonial overview · Litany · font · aspersion","fr":"Ceremonial overview · Litany · font · aspersion"},"actor":"mixed","priestPosition":"Procession / font / sanctuary","audibility":"audible","privateAction":false,"text":{"lat":"Litaniae Sanctorum incipiuntur. Prima pars Litaniarum ad fontem baptismalem ducit; ibi fons benedicitur. Aqua lustralis deinde sumitur ad aspersionem fidelium; altera pars Litaniarum continuatur dum altare ad Missam praeparatur. Haec pagina ordinem huius actionis indicat; textus integri benedictionis fontis non hic reproducuntur.","en":"The Litany of the Saints begins. Its first part leads to the baptismal font, where the font is blessed. Lustral water is then taken for the aspersion of the faithful; the second part of the Litany continues while the altar is prepared for Mass. This screen gives the sequence of the ceremony; the full celebrant-only blessing of the font is not reproduced here.","fr":"La Litanie des Saints commence. Sa première partie conduit à la bénédiction des fonts baptismaux. Après la bénédiction des fonts, on prélève l’eau lustrale pour l’aspersion des fidèles ; la Litanie reprend ensuite pendant la préparation de l’autel pour la Messe."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"The first part of the Litany leads to the baptismal font; after the blessing and aspersion, the Litany resumes while the altar is prepared. Mass then begins without the prayers at the foot or an Introit.","ritualActions":[{"kind":"ritual_action","label":"Kneel with the congregation during the Litany","source":"special_day_step"}],"exceptional":{"rite":"easter-vigil","phase":"Special Rite · Easter Vigil","liturgicalColour":"Violet"}},{"id":"vigil-lauds","phase":"Paschal Vigil","section":"Mass of the Faithful · Communion","title":{"en":"Lauds · pro laudibus","fr":"Lauds · pro laudibus"},"subtitle":{"en":"Psalm 150 · Benedictus","fr":"Psalm 150 · Benedictus"},"actor":"mixed","priestPosition":"Altar","audibility":"audible","privateAction":false,"text":{"lat":"Ant. Allelúia, allelúia, allelúia.\n\nPsalmus 150\nLaudáte Dóminum in sanctis eius: laudáte eum in firmaménto virtútis eius.\nLaudáte eum in virtútibus eius: laudáte eum secúndum multitúdinem magnitúdinis eius.\nLaudáte eum in sono tubæ: laudáte eum in psaltério et cíthara.\nLaudáte eum in týmpano et choro: laudáte eum in chordis et órgano.\nLaudáte eum in cýmbalis benesonántibus: laudáte eum in cýmbalis iubilatiónis: omnis spíritus laudet Dóminum.\n℣. Glória Patri, et Fílio, et Spirítui Sancto.\n℟. Sicut erat in princípio, et nunc, et semper, et in sǽcula sæculórum. Amen.\nAnt. Allelúia, allelúia, allelúia.\n\nMarc 16:2\nAnt. Et valde mane una sabbatórum, véniunt ad monuméntum, orto iam sole, allelúia.\n\nBENEDICTUS\nLuc 1:68-79\nBenedíctus ✠ Dóminus Deus Israël: quia visitávit et fecit redemptiónem plebis suæ.\nEt eréxit cornu salútis nobis: in domo David púeri sui.\nSicut locútus est per os sanctórum, qui a sǽculo sunt, prophetárum eius:\nSalútem ex inimícis nostris: et de manu ómnium, qui odérunt nos.\nAd faciéndam misericórdiam cum pátribus nostris: et memorári testaménti sui sancti.\nIusiurándum, quod iurávit ad Ábraham patrem nostrum: datúrum se nobis.\nUt sine timóre, de manu inimicórum nostrórum liberáti, serviámus illi.\nIn sanctitáte et iustítia coram ipso: ómnibus diébus nostris.\nEt tu, puer, Prophéta Altíssimi vocáberis: præíbis enim ante fáciem Dómini paráre vias eius.\nAd dandam sciéntiam salútis plebi eius: in remissiónem peccatórum eórum.\nPer víscera misericórdiæ Dei nostri: in quibus visitávit nos, óriens ex alto.\nIllumináre his, qui in ténebris et in umbra mortis sedent: ad dirigéndos pedes nostros in viam pacis.\n℣. Glória Patri, et Fílio, et Spirítui Sancto.\n℟. Sicut erat in princípio, et nunc, et semper, et in sǽcula sæculórum. Amen.\nAnt. Et valde mane una sabbatórum, véniunt ad monuméntum, orto iam sole, allelúia.","en":"Ant. Alleluia, alleluia, alleluia.\n\nPsalm 150\nPraise the Lord in His holy places: praise Him in the firmament of His power.\nPraise Him for His mighty deeds: praise Him according to the multitude of His greatness.\nPraise Him with the sound of the trumpet: praise Him with psaltery and harp.\nPraise Him with timbrel and choir: praise Him with strings and organ.\nPraise Him with well-sounding cymbals: praise Him with cymbals of jubilation: let every spirit praise the Lord.\n℣. Glory be to the Father, and to the Son, and to the Holy Ghost.\n℟. As it was in the beginning, is now, and ever shall be, world without end. Amen.\nAnt. Alleluia, alleluia, alleluia.\n\nMark 16:2\nAnt. And very early on the first day of the week, they come to the tomb, the sun having now risen, alleluia.\n\nBENEDICTUS\nLuke 1:68-79\nBlessed ✠ be the Lord God of Israel: because He hath visited and wrought the redemption of His people.\nAnd hath raised up a horn of salvation to us: in the house of David His servant.\nAs He spoke by the mouth of His holy prophets, who are from the beginning:\nSalvation from our enemies and from the hand of all that hate us.\nTo perform mercy to our fathers: and to remember His holy covenant.\nThe oath which He swore to Abraham our father, that He would grant to us:\nThat being delivered from the hand of our enemies, we may serve Him without fear,\nIn holiness and justice before Him, all our days.\nAnd thou, child, shalt be called the prophet of the Most High: for thou shalt go before the face of the Lord to prepare His ways.\nTo give knowledge of salvation to His people: unto the remission of their sins.\nThrough the bowels of the mercy of our God: in which the Orient from on high hath visited us.\nTo enlighten them that sit in darkness and in the shadow of death: to direct our feet into the way of peace.\n℣. Glory be to the Father, and to the Son, and to the Holy Ghost.\n℟. As it was in the beginning, is now, and ever shall be, world without end. Amen.\nAnt. And very early on the first day of the week, they come to the tomb, the sun having now risen, alleluia.","fr":"Après la Communion, il n’y a pas d’antienne de Communion. À sa place, les Laudes sont chantées ; au Benedictus, on encense l’autel, les ministres, les servants et les fidèles."},"posture":{"value":"CUSTOM","policy":"local","source":"local"},"gestures":[],"explanation":"The Easter Vigil has no Communion antiphon. Lauds is sung in its place; at the Benedictus the altar, ministers, servers and faithful are incensed.","ritualActions":[],"exceptional":{"rite":"easter-vigil","phase":"Mass of the Faithful · Communion"}}]}};
