        agnus.gestures = [];
        agnus.customNote = 'Requiem variant: no breast-striking at the Agnus Dei; the text asks rest for the departed.';
        agnus.explanation = 'At a Requiem Mass the Agnus Dei asks rest for the departed; the breast-striking of the ordinary form is not made, and the third invocation asks eternal rest.';
        agnus.variantNoteId = 'requiem-agnus-1962';
    }
    const dismissal = out.find(step => step.id === 'dismissal');
    if (dismissal) {
