    'good-friday-1962': { id: 'good-friday-1962', label: { en: 'Good Friday Liturgy', fr: 'Liturgie du Vendredi Saint', lat: 'Feria VI in Parasceve' }, invariants: ['This is a Solemn Liturgical Action, not a Mass.', 'Readings/Passion, solemn prayers, Cross adoration and Communion are distinct phases.'] },
