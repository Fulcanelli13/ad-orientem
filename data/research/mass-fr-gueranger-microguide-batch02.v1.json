      "priestActionStatus": "HISTORICAL_EXPLANATION_NOT_IN_TEXT_RUBRIC_CERTIFICATION"
    },
    {
      "id": "FRG49",
      "cueId": "AO.SM.C0197",
      "latinTrigger": "non aestimator meriti",
      "guidanceFrDraft": "La prière demande l'admission parmi les saints non en raison de nos mérites, mais par la miséricorde de Dieu. Le catalogue des martyrs situe notre espérance dans la communion des saints.",
      "sourceLocator": {
        "section": "NOBIS QUOQUE PECCATORIBUS",
