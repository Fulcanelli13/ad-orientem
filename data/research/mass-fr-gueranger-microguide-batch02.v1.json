    },
    {
      "id": "FRG48",
      "cueId": "AO.SM.C0196",
      "latinTrigger": "Nobis quoque peccatoribus",
      "guidanceFrDraft": "Le prêtre élève brièvement la voix et frappe sa poitrine: l'intercession se tourne des défunts vers les pécheurs encore vivants. Guéranger invite les fidèles à participer au geste, comme coutume historique à vérifier selon le profil.",
      "sourceLocator": {
        "section": "NOBIS QUOQUE PECCATORIBUS",
        "webLines": [
