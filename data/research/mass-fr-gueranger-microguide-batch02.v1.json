    },
    {
      "id": "FRG47",
      "cueId": "AO.SM.C0194",
      "latinTrigger": "locum refrigerii, lucis et pacis",
      "guidanceFrDraft": "L'Église demande pour les défunts le repos, la lumière et la paix. Il ne s'agit pas d'une simple méditation privée, mais d'une intercession intégrée au Canon.",
      "sourceLocator": {
