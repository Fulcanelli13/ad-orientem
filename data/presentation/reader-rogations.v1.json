        },
        {
          "id": "ROG-LIT-010-005",
          "kind": "TEXT",
          "latin": "Christe, exáudi nos.",
          "sourceRecordId": "LIT-010"
        },
        {
          "id": "ROG-LIT-010-006",
          "kind": "TEXT",
          "latin": "Pater de cælis, Deus, miserére nobis.",
          "sourceRecordId": "LIT-010"
        },
        {
          "id": "ROG-LIT-010-007",
          "kind": "TEXT",
          "latin": "Fili, Redémptor mundi, Deus, miserére nobis.",
          "sourceRecordId": "LIT-010"
        },
        {
          "id": "ROG-LIT-010-008",
          "kind": "TEXT",
          "latin": "Spíritus Sancte, Deus, miserére nobis.",
          "sourceRecordId": "LIT-010"
        },
        {
          "id": "ROG-LIT-010-009",
          "kind": "TEXT",
          "latin": "Sancta Trínitas, unus Deus, miserére nobis.",
          "sourceRecordId": "LIT-010"
        }
      ],
