  "publication_gate": {
    "published": false,
    "rule": "Do not expose learn.faith until every lesson has resolved Catechism references, paragraph-level sources, bilingual publication-ready text and cross-module deduplication.",
    "current_reference_route": "learn.catechism",
    "current_daily_route": "learn.catechism.daily"
  },
  "relationship_to_existing": {
    "learn.catechism.daily": "Daily review and spaced encounter with the existing question bank; not the guided doctrine course.",
    "learn.catechism": "Full searchable Traditional Catechism reference and exact Q&A owner.",
    "learn.faith": "Guided synthesis only; it references rather than replaces or duplicates the Catechism corpus.",
    "apologetics": "Defence against objections; not positive doctrinal instruction.",
    "church-crisis": "Contested development, rupture/continuity and authority questions; not baseline doctrine."
  },
  "source_policy": {
    "primary_doctrine": "Use the existing Traditional Catechism corpus as the immediate doctrinal reference layer, then resolve substantive prose to original Scripture, councils, catechisms and authoritative Magisterium where available.",
    "paragraph_rule": "Every substantive published paragraph must carry explicit source support.",
    "no_unsourced_synthesis": true,
    "no_duplicate_question_bank": true
  },
