        "PX1912-FR-STRUCTURED"
      ],
      "claims": [
        {
          "id": "LTF-002-C01",
          "text": {
            "en": "God is the infinitely perfect Creator and Lord of all things: eternal, spiritual, omniscient, omnipotent, good and just.",
            "fr": "Dieu est le Créateur et Seigneur infiniment parfait de toutes choses : éternel, spirituel, omniscient, tout-puissant, bon et juste."
          },
          "catechismRefs": [
            "PX1912-Q002",
            "PX1912-Q003",
            "PX1912-Q004",
            "PX1912-Q005",
            "PX1912-Q006",
            "PX1912-Q007",
            "PX1912-Q008",
            "PX1912-Q009",
            "PX1912-Q010",
            "PX1912-Q011",
            "PX1912-Q012"
          ]
        },
        {
          "id": "LTF-002-C02",
          "text": {
            "en": "Divine Providence means that God preserves and governs creation with wisdom and directs creatures toward their proper end.",
            "fr": "La Providence divine signifie que Dieu conserve et gouverne la création avec sagesse et dirige les créatures vers leur fin propre."
          },
          "catechismRefs": [
            "PX1912-Q002",
            "PX1912-Q003",
