      ],
      "claims": [
        {
          "id": "LTF-009-C01",
          "text": {
            "en": "God created all things from nothing and remains the sovereign Lord of the created order.",
            "fr": "Dieu a créé toutes choses à partir de rien et demeure le souverain Seigneur de l’ordre créé."
          },
