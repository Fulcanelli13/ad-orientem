    {
      "id": "LTF-003",
      "title": {
        "en": "Divine Revelation",
        "fr": "La Révélation divine"
      },
      "catechismCoverage": "DIRECT",
      "catechismRefs": [
        "PX1912-Q028",
        "PX1912-Q233",
        "PX1912-Q234",
        "PX1912-Q235",
        "PX1912-Q236"
      ],
      "sourceRefs": [
        "PX1912-EN-STRUCTURED",
        "PX1912-FR-STRUCTURED"
      ],
      "claims": [
        {
          "id": "LTF-003-C01",
          "text": {
            "en": "Revelation consists in truths made known by God and proposed to us for belief because God can neither deceive nor be deceived.",
            "fr": "La Révélation consiste dans les vérités que Dieu a fait connaître et qu’Il nous propose à croire, parce que Dieu ne peut ni se tromper ni nous tromper."
          },
          "catechismRefs": [
            "PX1912-Q028",
            "PX1912-Q233",
            "PX1912-Q234",
            "PX1912-Q235",
            "PX1912-Q236"
          ]
        },
        {
          "id": "LTF-003-C02",
          "text": {
            "en": "The revealed deposit is transmitted through Sacred Scripture and Tradition and authentically interpreted by the Church.",
            "fr": "Le dépôt révélé est transmis par l’Écriture Sainte et la Tradition et interprété authentiquement par l’Église."
          },
          "catechismRefs": [
            "PX1912-Q028",
            "PX1912-Q233",
            "PX1912-Q234",
            "PX1912-Q235",
            "PX1912-Q236"
          ]
        }
      ],
      "publicationStatus": "DRAFT"
    },
    {
      "id": "LTF-004",
      "title": {
        "en": "The virtue of faith",
        "fr": "La vertu de foi"
      },
      "catechismCoverage": "DIRECT",
      "catechismRefs": [
        "PX1912-Q232",
        "PX1912-Q237",
        "PX1912-Q244",
        "PX1912-Q245",
        "PX1912-Q246",
        "PX1912-Q247",
        "PX1912-Q248",
        "PX1912-Q249"
      ],
      "sourceRefs": [
        "PX1912-EN-STRUCTURED",
        "PX1912-FR-STRUCTURED"
      ],
      "claims": [
        {
          "id": "LTF-004-C01",
          "text": {
            "en": "Faith is the supernatural virtue by which we firmly believe what God has revealed and the Church proposes for belief.",
            "fr": "La foi est la vertu surnaturelle par laquelle nous croyons fermement ce que Dieu a révélé et que l’Église propose à croire."
          },
          "catechismRefs": [
            "PX1912-Q232",
            "PX1912-Q237",
            "PX1912-Q244",
            "PX1912-Q245",
            "PX1912-Q246",
            "PX1912-Q247",
            "PX1912-Q248",
            "PX1912-Q249"
          ]
        },
        {
          "id": "LTF-004-C02",
          "text": {
            "en": "Faith must be professed and lived: it is not merely intellectual assent but a virtue that shapes worship, obedience and Christian action.",
            "fr": "La foi doit être professée et vécue : elle n’est pas un simple assentiment intellectuel, mais une vertu qui façonne le culte, l’obéissance et l’action chrétienne."
          },
          "catechismRefs": [
            "PX1912-Q232",
            "PX1912-Q237",
            "PX1912-Q244",
            "PX1912-Q245",
            "PX1912-Q246",
            "PX1912-Q247",
            "PX1912-Q248",
            "PX1912-Q249"
          ]
        }
      ],
      "publicationStatus": "DRAFT"
    },
    {
      "id": "LTF-005",
      "title": {
        "en": "Sacred Scripture and Tradition",
        "fr": "Écriture Sainte et Tradition"
      },
      "catechismCoverage": "DIRECT",
      "catechismRefs": [
        "PX1912-Q233",
        "PX1912-Q234",
        "PX1912-Q235",
        "PX1912-Q236"
      ],
      "sourceRefs": [
        "PX1912-EN-STRUCTURED",
        "PX1912-FR-STRUCTURED"
      ],
      "claims": [
        {
          "id": "LTF-005-C01",
          "text": {
            "en": "Sacred Scripture is the written Word of God; Tradition is the unwritten transmission of revealed truth received from the Apostles.",
            "fr": "L’Écriture Sainte est la Parole de Dieu mise par écrit ; la Tradition est la transmission non écrite de la vérité révélée reçue des Apôtres."
          },
          "catechismRefs": [
            "PX1912-Q233",
            "PX1912-Q234",
            "PX1912-Q235",
            "PX1912-Q236"
          ]
        },
        {
          "id": "LTF-005-C02",
          "text": {
            "en": "Scripture and Tradition are not rival authorities: both belong to the one deposit of revelation entrusted to the Church.",
            "fr": "L’Écriture et la Tradition ne sont pas des autorités rivales : toutes deux appartiennent à l’unique dépôt de la Révélation confié à l’Église."
          },
          "catechismRefs": [
            "PX1912-Q233",
            "PX1912-Q234",
            "PX1912-Q235",
            "PX1912-Q236"
          ]
        }
      ],
      "publicationStatus": "DRAFT"
    },
