      "claims": [
        {
          "id": "LTF-007-C01",
          "text": {
            "en": "God is one, infinitely perfect and without limitation; He is pure spirit, eternal, omniscient and omnipotent.",
            "fr": "Dieu est un, infiniment parfait et sans limite ; Il est pur esprit, éternel, omniscient et tout-puissant."
          },
          "catechismRefs": [
