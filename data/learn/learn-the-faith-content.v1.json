      "claims": [
        {
          "id": "LTF-015-C01",
          "text": {
            "en": "Christ truly rose from the dead and remained with His disciples before ascending into heaven.",
            "fr": "Le Christ est véritablement ressuscité des morts et demeura avec ses disciples avant de monter au Ciel."
          },
          "catechismRefs": [
