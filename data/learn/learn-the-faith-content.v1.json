      ],
      "claims": [
        {
          "id": "LTF-010-C01",
          "text": {
            "en": "Angels are created pure spirits; the good angels serve God, while the demons are angels who rebelled against Him.",
            "fr": "Les anges sont de purs esprits créés ; les bons anges servent Dieu, tandis que les démons sont des anges qui se sont révoltés contre Lui."
          },
          "catechismRefs": [
