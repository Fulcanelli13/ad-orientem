        "PX1912-FR-STRUCTURED"
      ],
      "claims": [
        {
          "id": "LTF-014-C01",
          "text": {
            "en": "The Son of God became man to redeem us from sin and restore the way to eternal life.",
            "fr": "Le Fils de Dieu s’est fait homme pour nous racheter du péché et nous rouvrir le chemin de la vie éternelle."
          },
          "catechismRefs": [
            "PX1912-Q025",
            "PX1912-Q026",
            "PX1912-Q089",
            "PX1912-Q090",
            "PX1912-Q091"
          ]
        },
        {
          "id": "LTF-014-C02",
          "text": {
            "en": "Christ satisfied for our sins through His Passion and sacrificial death and teaches us to live according to God.",
            "fr": "Le Christ a satisfait pour nos péchés par sa Passion et sa mort sacrificielle et nous enseigne à vivre selon Dieu."
          },
          "catechismRefs": [
            "PX1912-Q025",
            "PX1912-Q026",
            "PX1912-Q089",
            "PX1912-Q090",
            "PX1912-Q091"
          ]
        }
