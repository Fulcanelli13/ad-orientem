  "lessons": [
    {
      "id": "LTF-001",
      "title": {
        "en": "Why man exists",
        "fr": "Pourquoi l’homme existe"
      },
      "catechismCoverage": "DIRECT",
      "catechismRefs": [
        "PX1912-Q013",
        "PX1912-Q014",
        "PX1912-Q015",
        "PX1912-Q016",
        "PX1912-Q017",
        "PX1912-Q018"
      ],
      "sourceRefs": [
        "PX1912-EN-STRUCTURED",
        "PX1912-FR-STRUCTURED"
      ],
      "claims": [
        {
          "id": "LTF-001-C01",
          "text": {
            "en": "God created man for a supernatural end: to know, love and serve Him in this life and to enjoy Him eternally in heaven.",
            "fr": "Dieu a créé l’homme pour une fin surnaturelle : le connaître, l’aimer et le servir en cette vie, puis jouir éternellement de Lui au Ciel."
          },
          "catechismRefs": [
            "PX1912-Q013",
            "PX1912-Q014",
            "PX1912-Q015",
            "PX1912-Q016",
            "PX1912-Q017",
            "PX1912-Q018"
          ]
        },
        {
          "id": "LTF-001-C02",
          "text": {
            "en": "Our final destiny gives moral life its direction: heaven is the eternal possession of God, while dying in mortal sin means definitive separation from Him.",
            "fr": "Notre destinée ultime donne son orientation à la vie morale : le Ciel est la possession éternelle de Dieu, tandis que mourir en état de péché mortel signifie la séparation définitive d’avec Lui."
          },
          "catechismRefs": [
            "PX1912-Q013",
            "PX1912-Q014",
            "PX1912-Q015",
            "PX1912-Q016",
            "PX1912-Q017",
            "PX1912-Q018"
          ]
        }
      ],
      "publicationStatus": "DRAFT"
    },
    {
      "id": "LTF-002",
      "title": {
        "en": "Knowing God by reason",
        "fr": "Connaître Dieu par la raison"
      },
      "catechismCoverage": "DIRECT",
      "catechismRefs": [
        "PX1912-Q002",
