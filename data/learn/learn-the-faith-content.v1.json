      "claims": [
        {
          "id": "LTF-012-C01",
          "text": {
            "en": "Jesus Christ is the eternal Son of God made man: true God and true man in one divine Person.",
            "fr": "Jésus-Christ est le Fils éternel de Dieu fait homme : vrai Dieu et vrai homme en une seule Personne divine."
