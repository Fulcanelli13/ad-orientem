      "turns": [
        {
          "id": "SPX.P1.SOURCELOCK.SPX-016.T1",
          "stage": "opening",
          "visitor": {
            "en": "How should I examine my conscience?",
            "fr": "Comment dois-je examiner ma conscience ?"
          },
          "reply": {
            "en": "Before confession, ask God for help. Examine your conduct against God's commandments, the Church's precepts, the duties of your state in life, and the occasions in which you have sinned.",
            "fr": "Avant la confession, demandez le secours de Dieu. Examinez votre conduite selon les commandements de Dieu, les préceptes de l'Église, les devoirs de votre état et les occasions dans lesquelles vous avez péché."
          },
          "loci": [
            "Q524",
            "Q526",
            "Q527",
            "Q528",
            "Q529"
          ],
          "claimClassification": "B_FAITHFUL_ADAPTATION_UNAPPROVED",
          "quote": false,
          "periodVoiceApproved": false,
          "translationApproved": false,
          "sourceMeaningReview": "CLAIMS_CHECKED_AGAINST_SPECIFIED_SOURCE_LINES",
          "subjectToHistoricalDisciplineCheck": true
        },
        {
          "id": "SPX.P1.SOURCELOCK.SPX-016.T2",
          "stage": "selected_followup",
          "visitor": {
            "en": "Is a bad thought already a sin as soon as it occurs?",
            "fr": "Une mauvaise pensée est-elle déjà un péché dès qu'elle se présente ?"
          },
          "reply": {
            "en": "No. The mere appearance of a bad thought does not suffice: there must be pleasure taken in it and consent of the will.",
            "fr": "Non. La seule apparition d'une mauvaise pensée ne suffit pas : il faut y prendre plaisir et y consentir par la volonté."
          },
          "loci": [
            "Q541",
            "Q542",
            "Q543"
          ],
          "claimClassification": "B_FAITHFUL_ADAPTATION_UNAPPROVED",
          "quote": false,
          "periodVoiceApproved": false,
          "translationApproved": false,
          "sourceMeaningReview": "CLAIMS_CHECKED_AGAINST_SPECIFIED_SOURCE_LINES",
          "subjectToHistoricalDisciplineCheck": true
        },
        {
          "id": "SPX.P1.SOURCELOCK.SPX-016.T3",
          "stage": "dependent_continuation",
          "visitor": {
            "en": "How long must I continue this examination?",
            "fr": "Combien de temps dois-je poursuivre cet examen ?"
          },
          "reply": {
            "en": "The time varies with the interval since your last confession and with what is needed. The manuscript gives no fixed number of minutes.",
            "fr": "La durée varie selon le temps écoulé depuis votre dernière confession et selon les besoins. Le manuscrit ne fixe aucun nombre de minutes."
          },
          "loci": [
