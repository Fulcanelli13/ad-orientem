      "turns": [
        {
          "id": "SPX.P1.SOURCELOCK.SPX-035.T1",
          "stage": "opening",
          "visitor": {
            "en": "Why should a priest read Scripture and spiritual books?",
            "fr": "Pourquoi un prêtre doit-il lire l'Écriture et les livres spirituels ?"
          },
          "reply": {
            "en": "Sacred reading should accompany his daily meditation, especially the inspired Scriptures. He must learn what he is to teach, so that sound doctrine may guide his ministry.",
            "fr": "La lecture sacrée doit accompagner sa méditation quotidienne, surtout celle des Écritures inspirées. Il doit apprendre ce qu'il aura à enseigner, afin qu'une doctrine saine guide son ministère."
          },
          "loci": [
            "§22"
          ],
          "claimClassification": "B_FAITHFUL_ADAPTATION_UNAPPROVED",
          "quote": false,
          "periodVoiceApproved": false,
          "translationApproved": false,
          "sourceMeaningReview": "CLAIMS_CHECKED_AGAINST_SPECIFIED_SOURCE_LINES",
          "subjectToHistoricalDisciplineCheck": true
        },
        {
          "id": "SPX.P1.SOURCELOCK.SPX-035.T2",
          "stage": "selected_followup",
          "visitor": {
            "en": "How can a spiritual book help him?",
            "fr": "Comment un livre spirituel peut-il lui venir en aide ?"
          },
          "reply": {
            "en": "A sound book can serve as a faithful friend: it recalls duties, reproves neglected resolutions and warns against dangers to the soul.",
            "fr": "Un bon livre peut être un ami fidèle : il rappelle les devoirs, reproche les résolutions négligées et met en garde contre les dangers de l'âme."
          },
          "loci": [
            "§23"
          ],
          "claimClassification": "B_FAITHFUL_ADAPTATION_UNAPPROVED",
          "quote": false,
          "periodVoiceApproved": false,
          "translationApproved": false,
          "sourceMeaningReview": "CLAIMS_CHECKED_AGAINST_SPECIFIED_SOURCE_LINES",
          "subjectToHistoricalDisciplineCheck": true
        },
        {
          "id": "SPX.P1.SOURCELOCK.SPX-035.T3",
          "stage": "dependent_continuation",
          "visitor": {
            "en": "Can reading replace the work of examining and correcting one's conduct?",
            "fr": "La lecture peut-elle remplacer l'examen et la correction de sa conduite ?"
          },
          "reply": {
            "en": "No. The exhortation joins reading and meditation to examining whether what was considered has actually been practised.",
            "fr": "Non. L'exhortation unit la lecture et la méditation à l'examen de ce qui a réellement été mis en pratique."
          },
          "loci": [
            "§24"
