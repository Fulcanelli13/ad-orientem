      "turns": [
        {
          "id": "SPX.P1.SOURCELOCK.SPX-015.T1",
          "stage": "opening",
          "visitor": {
            "en": "Why confess sins to a priest?",
            "fr": "Pourquoi confesser ses péchés à un prêtre ?"
          },
          "reply": {
            "en": "Christ instituted the sacrament of Penance for sins committed after Baptism. The priest is its minister and pronounces the words of absolution.",
            "fr": "Le Christ a institué le sacrement de pénitence pour les péchés commis après le baptême. Le prêtre en est le ministre et prononce les paroles de l'absolution."
          },
          "loci": [
            "Q509",
            "Q510",
            "Q517",
            "Q518"
          ],
          "claimClassification": "B_FAITHFUL_ADAPTATION_UNAPPROVED",
          "quote": false,
          "periodVoiceApproved": false,
          "translationApproved": false,
          "sourceMeaningReview": "CLAIMS_CHECKED_AGAINST_SPECIFIED_SOURCE_LINES",
          "subjectToHistoricalDisciplineCheck": true
        },
        {
          "id": "SPX.P1.SOURCELOCK.SPX-015.T2",
          "stage": "selected_followup",
          "visitor": {
            "en": "Does confession make personal sorrow unnecessary?",
            "fr": "La confession rend-elle inutile le regret personnel ?"
          },
          "reply": {
            "en": "No. The penitent's acts include contrition, confession and satisfaction. Sorrow for having offended God cannot simply be omitted.",
            "fr": "Non. Les actes du pénitent comprennent la contrition, la confession et la satisfaction. La douleur d'avoir offensé Dieu ne saurait être omise."
          },
          "loci": [
            "Q516",
            "Q523",
            "Q550"
          ],
          "claimClassification": "B_FAITHFUL_ADAPTATION_UNAPPROVED",
          "quote": false,
          "periodVoiceApproved": false,
          "translationApproved": false,
          "sourceMeaningReview": "CLAIMS_CHECKED_AGAINST_SPECIFIED_SOURCE_LINES",
          "subjectToHistoricalDisciplineCheck": true
        },
        {
          "id": "SPX.P1.SOURCELOCK.SPX-015.T3",
          "stage": "dependent_continuation",
          "visitor": {
            "en": "What distinguishes absolution from words of human comfort?",
            "fr": "Qu'est-ce qui distingue l'absolution de simples paroles de réconfort ?"
          },
          "reply": {
            "en": "Absolution belongs to the sacrament instituted by Christ. The priest pronounces its sacramental form; it is not merely a friend's reassurance.",
            "fr": "L'absolution appartient au sacrement institué par le Christ. Le prêtre en prononce la formule sacramentelle ; ce n'est pas seulement une parole rassurante d'un ami."
          },
          "loci": [
            "Q509",
            "Q511",
            "Q517",
            "Q518"
          ],
          "claimClassification": "B_FAITHFUL_ADAPTATION_UNAPPROVED",
