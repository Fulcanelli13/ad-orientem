          "stage": "opening",
          "visitor": {
            "en": "Can prayers assist our departed loved ones?",
            "fr": "La prière peut-elle aider nos chers défunts ?"
          },
          "reply": {
            "en": "The faithful on earth, the saints in Heaven and the souls in Purgatory belong to the one Church of Christ. We pray to God for the souls in Purgatory.",
            "fr": "Les fidèles sur la terre, les saints au Ciel et les âmes du purgatoire appartiennent à l'unique Église du Christ. Nous prions Dieu pour les âmes du purgatoire."
          },
          "loci": [
