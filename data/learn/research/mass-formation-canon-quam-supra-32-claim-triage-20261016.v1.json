      "reported_gihr_link": "https://sanctaliturgia.blogspot.com/2005/05/supra-quae.html",
      "p0_claims": [
        "VER-050",
        "VER-059"
      ],
      "adjudication": "GIHR_AND_LEBRUN_ORIGINAL_EDITION_OCR_BOTH_SUPPORT_MELCHISEDECH_GRAMMAR_IMAGE_CHECK_PENDING",
      "educational_policy": "Present both as distinct historical interpretations, explicitly label secondary mediation of Gihr, never state either as universally settled grammar.",
      "footnote_as_read": "p660 footnote 2",
