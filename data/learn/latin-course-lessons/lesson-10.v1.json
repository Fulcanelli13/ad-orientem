  "learningBlocks": [
    {
      "id": "l10-b1",
      "type": "concept",
      "title": "Pronouns enter the same case system",
      "learnerCopy": {
        "en": "Pronouns are not a separate grammar universe. The same case functions apply: nos can be nominative or accusative; nobis can be dative or ablative; context and governing words decide.",
        "fr": "Les pronoms n'appartiennent pas à un autre univers grammatical. Les mêmes fonctions de cas s'appliquent : nos peut être nominatif ou accusatif ; nobis, datif ou ablatif ; le contexte et les mots régissants décident."
      }
    },
    {
      "id": "l10-b2",
      "type": "paradigm",
      "title": "ego, tu, nos, vos",
      "learnerCopy": {
        "en": "Learn these as case families, not as translation pairs. ego/me/mihi and tu/te/tibi show how the same person changes form as grammatical role changes.",
        "fr": "Apprenez-les comme familles de cas, non comme simples paires de traduction. ego/me/mihi et tu/te/tibi montrent comment une même personne change de forme selon son rôle grammatical."
      }
    },
    {
      "id": "l10-b3",
      "type": "authentic-example",
      "title": "Dominus vobiscum",
      "sourceId": "mr1962-dominus-vobiscum-l10",
      "learnerCopy": {
        "en": "vobiscum contains vobis, the ablative plural form of vos, plus cum. Latin convention places cum after these pronouns: mecum, tecum, nobiscum, vobiscum, secum.",
        "fr": "vobiscum contient vobis, forme ablative plurielle de vos, plus cum. Avec ces pronoms, le latin place traditionnellement cum après : mecum, tecum, nobiscum, vobiscum, secum."
      }
    },
    {
      "id": "l10-b4",
      "type": "pronoun",
      "title": "is, ea, id supplies third-person case forms",
      "learnerCopy": {
        "en": "is/ea/id is a high-frequency third-person demonstrative/pronominal family. Learn eius for genitive, ei for dative, eum/eam/id for accusative, and eo/ea for ablative before trying to memorize every plural form.",
        "fr": "is/ea/id est une famille pronominale très fréquente. Fixez d'abord eius au génitif, ei au datif, eum/eam/id à l'accusatif et eo/ea à l'ablatif avant de mémoriser tous les pluriels."
      }
    },
    {
      "id": "l10-b5",
      "type": "pronoun",
      "title": "se is reflexive",
      "learnerCopy": {
        "en": "se refers back to the subject and therefore has no nominative form. Its family is sui, sibi, se, se; with cum it becomes secum.",
        "fr": "se renvoie au sujet et n'a donc pas de nominatif. Sa famille est sui, sibi, se, se ; avec cum, on obtient secum."
      }
    },
    {
      "id": "l10-b6",
      "type": "stage-checkpoint",
      "title": "Stage 2: read the Ordinary as structure",
      "learnerCopy": {
        "en": "The Stage 2 gate combines third-declension stems, active/passive voice, all six case functions, preposition government and pronoun forms. The target is a complete Ordinary-style sentence with several grammatical anchors, not isolated parsing drills.",
        "fr": "Le contrôle de l'étape 2 combine les radicaux de troisième déclinaison, actif/passif, les six cas, le régime des prépositions et les pronoms. La cible est une phrase complète de type Ordinaire avec plusieurs points d'appui grammaticaux, non des analyses isolées."
      }
    }
  ],
