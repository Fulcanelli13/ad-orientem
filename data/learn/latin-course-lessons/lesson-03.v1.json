  "learningBlocks": [
    {
      "id": "l3-b1",
      "type": "concept",
      "title": "A second family of endings",
      "learnerCopy": {
        "en": "Lesson 3 adds second-declension masculine and neuter forms to the same six-case map. The map does not reset: first-declension forms remain visible beside the new system.",
        "fr": "La leçon 3 ajoute les formes masculines et neutres de la deuxième déclinaison à la même carte des six cas. La carte ne repart pas à zéro : la première déclinaison reste visible."
      }
    },
    {
      "id": "l3-b2",
      "type": "case-panel",
      "title": "Nominative and vocative stay active",
      "learnerCopy": {
        "en": "You still use only nominative and vocative as active case functions. Notice Dominus, Deus, filius, puer and servus as masculine nominative forms, and regnum, caelum, principium, verbum and templum as neuters.",
        "fr": "Le nominatif et le vocatif restent les seuls cas activement employés. Repérez Dominus, Deus, filius, puer et servus comme formes masculines, puis regnum, caelum, principium, verbum et templum comme neutres."
      }
    },
    {
      "id": "l3-b3",
      "type": "verb",
      "title": "The verb esse",
      "learnerCopy": {
        "en": "sum means 'I am / to be' as a lemma family. Its present forms are sum, es, est, sumus, estis, sunt. Do not confuse the lemma with only one surface form.",
        "fr": "sum représente le verbe « être ». Ses formes du présent sont sum, es, est, sumus, estis, sunt. Le lemme ne se réduit donc pas à une seule forme."
      }
    },
    {
      "id": "l3-b4",
      "type": "verb",
      "title": "possum is built on sum",
      "learnerCopy": {
        "en": "possum means 'I can / be able'. Learn the family possum, potes, potest, possumus, potestis, possunt as a high-frequency irregular pattern related to sum.",
        "fr": "possum signifie « pouvoir ». Apprenez la famille possum, potes, potest, possumus, potestis, possunt comme un modèle irrégulier fréquent apparenté à sum."
      }
    },
    {
      "id": "l3-b5",
      "type": "authentic-example",
      "title": "Hoc est",
      "sourceId": "mr1962-consecration-hoc-est",
      "learnerCopy": {
        "en": "In Hoc est enim Corpus meum, est is simply a form of sum. You can identify the verb before you are able to parse every noun and adjective around it.",
        "fr": "Dans Hoc est enim Corpus meum, est est simplement une forme de sum. Vous pouvez reconnaître le verbe avant de savoir analyser tout le reste."
      }
    },
    {
      "id": "l3-b6",
      "type": "liturgical-reading",
      "title": "Puer natus est nobis",
      "sourceId": "mr1962-christmas-introit-puer",
      "learnerCopy": {
        "en": "Read only what Stage 1 has earned: puer and Filius are nouns you can recognize; est belongs to sum; et is already known. natus, nobis and datus remain supplied.",
        "fr": "Ne lisez activement que ce qui a déjà été acquis : puer et Filius sont reconnaissables, est appartient à sum et et est déjà connu. natus, nobis et datus restent fournis."
      }
    },
    {
      "id": "l3-b7",
      "type": "retrieval",
      "title": "One cumulative map",
      "learnerCopy": {
        "en": "By now the learner should see first- and second-declension shapes together, not as disconnected chapters. The point is rapid recognition inside Church Latin.",
        "fr": "À ce stade, les formes des première et deuxième déclinaisons doivent apparaître sur une seule carte cumulative, non comme des chapitres isolés. Le but est la reconnaissance rapide dans le latin de l'Église."
      }
    }
  ],
