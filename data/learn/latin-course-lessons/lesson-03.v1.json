  "casePanel": {
    "visible": true,
    "firstVisibleLesson": 2,
    "policy": "All six cases stay visible from here onward. Only nominative and vocative are active functions in Stage 1; the remaining cases are previewed until their later unlocks.",
    "cases": [
      {
        "case": "nominative",
        "status": "active",
        "question": "who/what is named as the subject or identity?",
        "firstDeclension": {
          "singular": "-a",
          "plural": "-ae"
        },
        "secondDeclension": {
          "masculineSingular": "-us / -er",
          "masculinePlural": "-i",
          "neuterSingular": "-um",
          "neuterPlural": "-a"
        }
      },
      {
        "case": "vocative",
        "status": "active",
        "question": "who/what is directly addressed?",
        "firstDeclension": {
          "singular": "-a",
          "plural": "-ae"
        },
        "secondDeclension": {
          "masculineSingular": "usually -e; -er often unchanged",
          "masculinePlural": "-i",
          "neuterSingular": "-um",
          "neuterPlural": "-a"
        }
      },
