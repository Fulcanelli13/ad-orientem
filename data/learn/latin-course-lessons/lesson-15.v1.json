  "learningBlocks": [
    {
      "id": "l15-b1",
      "type": "concept",
      "title": "Perfect means completed event",
      "learnerCopy": {
        "en": "The perfect presents an event as completed or viewed as a whole. This makes it central to Creed and Gospel narrative: He rose, ascended, came down; they found, approached, fell.",
        "fr": "Le parfait présente un événement comme accompli ou envisagé dans son ensemble. Il est donc central dans le Credo et le récit évangélique : il ressuscita, monta, descendit ; ils trouvèrent, s'approchèrent, tombèrent."
      },
      "referenceIds": [
        "grammar-scanlon-1944",
        "grammar-nunn-1922",
        "grammar-petitmangin-1930",
        "curriculum-latin-course-40-v1"
      ],
      "localization": {
        "fr": {
          "title": "Le parfait exprime un événement achevé"
        }
      }
    },
    {
      "id": "l15-b2",
      "type": "morphology",
      "title": "Recognize the perfect endings",
      "learnerCopy": {
        "en": "A common perfect active family is -i, -isti, -it, -imus, -istis, -erunt. But the stem often changes, so recognition must combine ending and lemma: resurrexit belongs to resurgo; ceciderunt belongs to cado.",
        "fr": "Une famille fréquente de terminaisons du parfait actif est -i, -isti, -it, -imus, -istis, -erunt. Mais le radical change souvent : resurrexit appartient à resurgo ; ceciderunt à cado."
      },
      "referenceIds": [
        "grammar-scanlon-1944",
        "grammar-nunn-1922",
        "grammar-petitmangin-1930",
        "curriculum-latin-course-40-v1"
      ],
      "localization": {
        "fr": {
          "title": "Reconnaître les terminaisons du parfait"
        }
      }
    },
    {
      "id": "l15-b3",
      "type": "authentic-example",
      "title": "resurrexit / ascendit / sedet",
      "sourceId": "mr1962-credo-resurrexit-l15",
      "learnerCopy": {
        "en": "The Creed puts two completed actions beside a present state: resurrexit, ascendit, then sedet. Tense contrast helps the reader see the sequence rather than merely decode endings.",
        "fr": "Le Credo place deux actions accomplies à côté d'un état présent : resurrexit, ascendit, puis sedet. Le contraste des temps aide à voir la séquence, au-delà des seules terminaisons."
      },
      "referenceIds": [
        "mr1962-credo-resurrexit-l15",
        "grammar-scanlon-1944",
        "grammar-nunn-1922",
        "grammar-petitmangin-1930",
        "curriculum-latin-course-40-v1"
      ],
      "localization": {
        "fr": {
          "title": "resurrexit / ascendit / sedet"
        }
      }
    },
    {
      "id": "l15-b4",
      "type": "authentic-example",
      "title": "Surrexit, non est hic",
      "sourceId": "vulg-mk16-6-l15",
      "learnerCopy": {
        "en": "surgo and resurgo are distinct lemmas. Surrexit means 'he rose'; resurrexit means 'he rose again'. Do not collapse them because their perfect forms look related.",
        "fr": "surgo et resurgo sont deux lemmes distincts. Surrexit signifie « il se leva » ; resurrexit « il ressuscita / se releva de nouveau ». Il ne faut pas les confondre."
      },
      "referenceIds": [
        "vulg-mk16-6-l15",
        "grammar-scanlon-1944",
        "grammar-nunn-1922",
        "grammar-petitmangin-1930",
        "curriculum-latin-course-40-v1"
      ],
      "localization": {
        "fr": {
          "title": "Surrexit, non est hic"
        }
      }
    },
    {
      "id": "l15-b5",
      "type": "pronoun",
      "title": "Pronouns inside completed actions",
      "sourceId": "vulg-mt28-9-l15",
      "learnerCopy": {
        "en": "ejus is genitive singular of is/ea/id; eum is accusative masculine singular. The perfect verbs tell what happened; the pronouns tell whose feet and whom they adored.",
        "fr": "ejus est le génitif singulier de is/ea/id ; eum l'accusatif masculin singulier. Les verbes au parfait disent ce qui s'est passé ; les pronoms indiquent à qui appartiennent les pieds et qui fut adoré."
      },
      "referenceIds": [
        "vulg-mt28-9-l15",
        "grammar-scanlon-1944",
        "grammar-nunn-1922",
        "grammar-petitmangin-1930",
        "curriculum-latin-course-40-v1"
      ],
      "localization": {
        "fr": {
          "title": "Les pronoms dans les actions achevées"
        }
      }
    },
    {
      "id": "l15-b6",
      "type": "stage-checkpoint",
      "title": "Stage 3: from tense drills to narrative",
      "learnerCopy": {
        "en": "The Stage 3 gate asks you to read short Psalm/Gospel narrative clauses by combining tense, case, pronoun and connector recognition. The milestone is not full translation without support; it is reliable structural reading of authentic narrative.",
        "fr": "Le contrôle de l'étape 3 demande de lire de courtes propositions narratives de psaume ou d'Évangile en combinant temps, cas, pronoms et connecteurs. L'objectif n'est pas encore une traduction totalement autonome, mais une lecture structurelle fiable du récit authentique."
      },
      "referenceIds": [
        "grammar-scanlon-1944",
        "grammar-nunn-1922",
        "grammar-petitmangin-1930",
        "curriculum-latin-course-40-v1"
      ],
      "localization": {
        "fr": {
          "title": "Étape 3 : des exercices de temps au récit"
        }
      }
    }
  ],
