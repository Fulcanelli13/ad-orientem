  "learningBlocks": [
    {
      "id": "l14-b1",
      "type": "concept",
      "title": "The nominal system is now complete enough for ordinary reading",
      "learnerCopy": {
        "en": "Lessons 2–9 built case functions; Lesson 14 completes the main declension inventory with fourth and fifth declensions. The goal is recognition inside real text, not isolated table recitation.",
        "fr": "Les leçons 2 à 9 ont construit les fonctions des cas ; la leçon 14 complète l'inventaire principal avec les quatrième et cinquième déclinaisons. Le but est la reconnaissance dans le texte réel, non la récitation de tableaux isolés."
      },
      "referenceIds": [
        "grammar-scanlon-1944",
        "grammar-nunn-1922",
        "grammar-petitmangin-1930",
        "curriculum-latin-course-40-v1"
      ]
    },
    {
      "id": "l14-b2",
      "type": "morphology",
      "title": "Fourth declension: spiritus, manus, fructus",
      "learnerCopy": {
        "en": "Fourth-declension masculine nouns often show -us in both nominative and genitive singular, -ui in the dative, -um in the accusative and -u in the ablative. Context and the permanent case map matter.",
        "fr": "Les noms masculins de quatrième déclinaison présentent souvent -us au nominatif et au génitif singuliers, -ui au datif, -um à l'accusatif et -u à l'ablatif. Le contexte et la carte permanente des cas restent essentiels."
      },
      "referenceIds": [
        "grammar-scanlon-1944",
        "grammar-nunn-1922",
        "grammar-petitmangin-1930",
        "curriculum-latin-course-40-v1"
      ]
    },
    {
      "id": "l14-b3",
      "type": "authentic-example",
      "title": "spiritu / Spiritui / spiritum",
      "learnerCopy": {
        "en": "Et cum spiritu tuo gives ablative spiritu; Gloria Patri … Spiritui Sancto gives dative Spiritui; Psalm 50 gives accusative spiritum. One lemma now appears across three active cases.",
        "fr": "Et cum spiritu tuo donne l'ablatif spiritu ; Gloria Patri … Spiritui Sancto donne le datif Spiritui ; le psaume 50 donne l'accusatif spiritum. Un seul lemme apparaît ainsi dans trois cas actifs."
      },
      "referenceIds": [
        "grammar-scanlon-1944",
        "grammar-nunn-1922",
        "grammar-petitmangin-1930",
        "curriculum-latin-course-40-v1"
      ]
    },
    {
      "id": "l14-b4",
      "type": "morphology",
      "title": "Fifth declension: dies, res, fides, facies",
      "learnerCopy": {
        "en": "Fifth-declension nouns often show nominative -es and genitive/dative -ei. dies and res are especially frequent; fides and facies belong to the same broad family.",
        "fr": "Les noms de cinquième déclinaison présentent souvent un nominatif en -es et un génitif/datf en -ei. dies et res sont particulièrement fréquents ; fides et facies appartiennent à la même grande famille."
      },
      "referenceIds": [
        "grammar-scanlon-1944",
        "grammar-nunn-1922",
        "grammar-petitmangin-1930",
        "curriculum-latin-course-40-v1"
      ]
    },
    {
      "id": "l14-b5",
      "type": "authentic-example",
      "title": "Haec dies",
      "sourceId": "vulg-ps117-haec-dies-l14",
      "learnerCopy": {
        "en": "dies is fifth declension. You do not need to master the later demonstrative and subjunctive in the Psalm clause to recognize the noun and its role.",
        "fr": "dies appartient à la cinquième déclinaison. Il n'est pas nécessaire de maîtriser encore le démonstratif et le subjonctif de la phrase pour reconnaître le nom et son rôle."
      },
      "referenceIds": [
        "vulg-ps117-haec-dies-l14",
        "grammar-scanlon-1944",
        "grammar-nunn-1922",
        "grammar-petitmangin-1930",
        "curriculum-latin-course-40-v1"
      ]
    },
    {
      "id": "l14-b6",
      "type": "retrieval",
      "title": "Stop thinking in five disconnected declension chapters",
      "learnerCopy": {
        "en": "From now on, every noun belongs on one combined case map. The reading question is: what case/function is this form, and what lemma family does it belong to?",
        "fr": "Désormais, tous les noms appartiennent à une seule carte des cas. La question de lecture est : quel est le cas et la fonction de cette forme, et à quelle famille de lemme appartient-elle ?"
      },
      "referenceIds": [
        "grammar-scanlon-1944",
        "grammar-nunn-1922",
        "grammar-petitmangin-1930",
        "curriculum-latin-course-40-v1"
      ]
    }
  ],
