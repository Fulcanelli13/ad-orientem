  "learningBlocks": [
    {
      "id": "l9-b1",
      "type": "concept",
      "title": "The last two case functions unlock",
      "learnerCopy": {
        "en": "Accusative and ablative now become active. From this point the full six-case system is operational. Prepositions make these cases especially readable because many govern a predictable case.",
        "fr": "L'accusatif et l'ablatif deviennent maintenant actifs. À partir d'ici, les six cas sont opérationnels. Les prépositions rendent ces cas particulièrement lisibles parce qu'elles régissent souvent un cas prévisible."
      }
    },
    {
      "id": "l9-b2",
      "type": "case-panel",
      "title": "Accusative: object and direction",
      "learnerCopy": {
        "en": "The accusative commonly marks the direct object and motion toward a goal. In Introibo ad altare Dei, ad requires an accusative goal.",
        "fr": "L'accusatif marque souvent le complément d'objet direct et le mouvement vers un but. Dans Introibo ad altare Dei, ad exige un accusatif."
      }
    },
    {
      "id": "l9-b3",
      "type": "case-panel",
      "title": "Ablative through prepositions",
      "learnerCopy": {
        "en": "At this stage, read the ablative first through frequent prepositions: cum, pro, de, ex, ab, sine and coram, plus static in.",
        "fr": "À ce stade, lisez l'ablatif d'abord à travers les prépositions fréquentes : cum, pro, de, ex, ab, sine, coram, ainsi que in statique."
      }
    },
    {
      "id": "l9-b4",
      "type": "authentic-example",
      "title": "In nomine",
      "sourceId": "mr1962-in-nomine-l9",
      "learnerCopy": {
        "en": "in nomine uses the ablative for location/state. Patris, Filii and Spiritus then add genitive relationships. One familiar formula now combines several case functions.",
        "fr": "in nomine emploie l'ablatif pour la situation. Patris, Filii et Spiritus ajoutent ensuite des relations au génitif. Une formule familière combine ainsi plusieurs cas."
      }
    },
    {
      "id": "l9-b5",
      "type": "authentic-example",
      "title": "Per Dominum nostrum",
      "sourceId": "mr1962-per-dominum-l9",
      "learnerCopy": {
        "en": "per governs the accusative: Dominum nostrum Jesum Christum. The forms change together; this is morphology, not new vocabulary.",
        "fr": "per régit l'accusatif : Dominum nostrum Jesum Christum. Les formes changent ensemble ; c'est de la morphologie, non du nouveau vocabulaire."
      }
    },
    {
      "id": "l9-b6",
      "type": "liturgical-reading",
      "title": "The full case system is live",
      "learnerCopy": {
        "en": "After Lesson 9, no case label is merely a preview. Identify the preposition, predict its case, then verify the ending and function.",
        "fr": "Après la leçon 9, aucun cas n'est plus seulement aperçu. Repérez la préposition, prévoyez son cas, puis vérifiez la terminaison et la fonction."
      }
    }
  ],
