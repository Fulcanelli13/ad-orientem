  "gerundFramework": {
    "gerund": "Verbal noun; commonly appears in oblique cases, especially ad + accusative for purpose.",
    "gerundive": "Verbal adjective agreeing with a noun; with sum it can express necessity/obligation.",
    "readingRule": "First decide noun-like versus adjective-like behavior: does the form stand alone, or agree with a noun?",
    "referenceIds": [
      "curriculum-latin-course-40-v1",
      "grammar-nunn-1922",
      "grammar-scanlon-1944",
      "grammar-petitmangin-1930"
    ]
  },
  "learningBlocks": [
    {
      "id": "l27-b1",
      "type": "concept",
      "title": "A verb can behave like a noun or adjective",
      "learnerCopy": {
        "en": "The gerund is a verbal noun; the gerundive is a verbal adjective. Their similar shapes make syntax—not translation—the safest way to distinguish them.",
        "fr": "Le gérondif est un nom verbal ; l'adjectif verbal est un adjectif verbal. Leurs formes proches rendent la syntaxe plus sûre que la traduction pour les distinguer."
      },
      "referenceIds": [
        "grammar-nunn-1922",
        "grammar-scanlon-1944",
        "grammar-petitmangin-1930",
        "curriculum-latin-course-40-v1"
      ],
      "localization": {
        "fr": {
          "title": "Un verbe peut se comporter comme un nom ou un adjectif"
        }
      }
    },
    {
      "id": "l27-b2",
      "type": "authentic-example",
      "title": "ad annuntiandum",
      "sourceId": "vulg-ps91-gerund-l27",
      "learnerCopy": {
        "en": "ad annuntiandum means 'for proclaiming / to proclaim'. The gerund follows ad in the accusative and functions as a purpose expression.",
        "fr": "ad annuntiandum signifie « pour annoncer ». Le gérondif suit ad à l'accusatif et exprime le but."
      },
      "referenceIds": [
        "vulg-ps91-gerund-l27",
        "grammar-nunn-1922",
        "grammar-scanlon-1944",
        "grammar-petitmangin-1930",
        "curriculum-latin-course-40-v1"
      ],
      "localization": {
        "fr": {
          "title": "ad annuntiandum"
        }
      }
    },
    {
      "id": "l27-b3",
      "type": "authentic-example",
      "title": "tradendus est",
      "sourceId": "vulg-mt17-gerundive-l27",
      "learnerCopy": {
        "en": "tradendus agrees with Filius. With est it means 'is to be handed over / must be handed over'. Agreement shows that this is gerundive, not gerund.",
        "fr": "tradendus s'accorde avec Filius. Avec est, il signifie « doit être livré ». L'accord montre qu'il s'agit d'un adjectif verbal, non d'un gérondif."
      },
      "referenceIds": [
        "vulg-mt17-gerundive-l27",
        "grammar-nunn-1922",
        "grammar-scanlon-1944",
        "grammar-petitmangin-1930",
        "curriculum-latin-course-40-v1"
      ],
      "localization": {
        "fr": {
          "title": "tradendus est"
        }
      }
    },
    {
      "id": "l27-b4",
      "type": "canon",
      "title": "donis ac datis / munera",
      "learnerCopy": {
        "en": "The Canon's gift/offering vocabulary matters semantically even when it is not itself gerundive: donum and munus recur in sacrificial language and prepare later Canon reading.",
        "fr": "Le vocabulaire du don et de l'offrande dans le Canon reste essentiel, même lorsqu'il n'est pas lui-même gérondival : donum et munus reviennent dans le langage sacrificiel."
      },
      "referenceIds": [
        "grammar-nunn-1922",
        "grammar-scanlon-1944",
        "grammar-petitmangin-1930",
        "curriculum-latin-course-40-v1"
      ],
      "localization": {
        "fr": {
          "title": "donis ac datis / munera"
        }
      }
    },
    {
      "id": "l27-b5",
      "type": "retrieval",
      "title": "Ask whether the form agrees",
      "learnerCopy": {
        "en": "If a verbal -nd- form agrees with a noun, treat it as gerundive. If it stands as a verbal noun in a case such as ad + accusative, treat it as gerund.",
        "fr": "Si une forme verbale en -nd- s'accorde avec un nom, lisez-la comme adjectif verbal. Si elle fonctionne comme nom verbal dans un cas tel que ad + accusatif, lisez-la comme gérondif."
      },
      "referenceIds": [
        "grammar-nunn-1922",
        "grammar-scanlon-1944",
        "grammar-petitmangin-1930",
        "curriculum-latin-course-40-v1"
      ],
      "localization": {
        "fr": {
          "title": "Demander si la forme s’accorde"
        }
      }
    },
    {
      "id": "l27-b6",
      "type": "application",
      "title": "Gerund and gerundive converge in translation, not syntax",
      "learnerCopy": {
        "en": "English and French may translate both with an infinitive or purpose phrase. Keep the Latin distinction structural: gerund = verbal noun; gerundive = agreeing verbal adjective.",
        "fr": "L'anglais et le français peuvent traduire les deux par un infinitif ou une tournure de but. Gardez la distinction latine structurelle : gérondif = nom verbal ; adjectif verbal = adjectif verbal accordé."
      },
      "referenceIds": [
        "grammar-nunn-1922",
        "grammar-scanlon-1944",
        "grammar-petitmangin-1930",
        "curriculum-latin-course-40-v1"
      ],
      "localization": {
        "fr": {
          "title": "Gérondif et adjectif verbal convergent dans la traduction, pas dans la syntaxe"
        }
      }
    }
  ],
