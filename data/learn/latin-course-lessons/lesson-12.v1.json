  "learningBlocks": [
    {
      "id": "l12-b1",
      "type": "concept",
      "title": "Commands are direct verbal actions",
      "learnerCopy": {
        "en": "The imperative addresses someone directly and tells that person to act. Latin therefore often places imperative and vocative together: Orate, fratres — 'Pray, brethren.'",
        "fr": "L'impératif s'adresse directement à quelqu'un pour lui ordonner d'agir. Le latin associe donc souvent impératif et vocatif : Orate, fratres — « Priez, mes frères. »"
      }
    },
    {
      "id": "l12-b2",
      "type": "case-panel",
      "title": "Vocative is now used deliberately",
      "learnerCopy": {
        "en": "The vocative has been active since Lesson 2; now it becomes a recurrent reading cue. fratres is not the subject of Orate but the people directly addressed.",
        "fr": "Le vocatif est actif depuis la leçon 2 ; il devient maintenant un signal de lecture récurrent. fratres n'est pas le sujet exprimé de Orate, mais les personnes directement interpellées."
      }
    },
    {
      "id": "l12-b3",
      "type": "authentic-example",
      "title": "Orate, fratres",
      "sourceId": "mr1962-orate-fratres-l12",
      "learnerCopy": {
        "en": "Orate is second-person plural: the command is addressed to several people. fratres is vocative plural. Person and direct address work together.",
        "fr": "Orate est à la deuxième personne du pluriel : l'ordre s'adresse à plusieurs personnes. fratres est un vocatif pluriel. Personne verbale et adresse directe fonctionnent ensemble."
      }
    },
    {
      "id": "l12-b4",
      "type": "authentic-example",
      "title": "accipe … vade",
      "sourceId": "vulg-mt2-20-l12",
      "learnerCopy": {
        "en": "In Surge, et accipe puerum … et vade, three singular commands drive the action. ejus also recycles the pronoun family is/ea/id in the genitive.",
        "fr": "Dans Surge, et accipe puerum … et vade, trois impératifs singuliers font avancer l'action. ejus réactive aussi la famille pronominale is/ea/id au génitif."
      }
    },
    {
      "id": "l12-b5",
      "type": "pronoun",
      "title": "Commands still govern cases",
      "sourceId": "gospel-amen-dico-vobis-l12",
      "learnerCopy": {
        "en": "Amen dico vobis shows that verbs and pronouns continue to interact through case. vobis is dative: 'I say to you.' The pronoun spiral therefore grows inside real clauses, not in isolation.",
        "fr": "Amen dico vobis montre que verbes et pronoms continuent d'interagir par les cas. vobis est au datif : « je vous dis ». La spirale des pronoms progresse donc à l'intérieur de vraies phrases."
      }
    },
    {
      "id": "l12-b6",
      "type": "retrieval",
      "title": "Recognize the command before translating every word",
      "learnerCopy": {
        "en": "When a liturgical or Gospel clause opens with Orate, Accipe, Fac, Vade, Ecce or a similar directive, identify the action and addressee first. Fine syntax can follow.",
        "fr": "Lorsqu'une formule liturgique ou évangélique s'ouvre par Orate, Accipe, Fac, Vade, Ecce ou une directive analogue, identifiez d'abord l'action et la personne interpellée. L'analyse détaillée vient ensuite."
      }
    }
  ],
