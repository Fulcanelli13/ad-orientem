  "learningBlocks": [
    {
      "id": "l6-b1",
      "type": "concept",
      "title": "The nominative may hide the stem",
      "learnerCopy": {
        "en": "Third-declension nouns must be learned with the genitive: pater, patris; corpus, corporis; pax, pacis; homo, hominis. The genitive reveals the stem used by most other forms.",
        "fr": "Les noms de la troisième déclinaison s'apprennent avec leur génitif : pater, patris ; corpus, corporis ; pax, pacis ; homo, hominis. Le génitif révèle le radical employé dans la plupart des autres formes."
      }
    },
    {
      "id": "l6-b2",
      "type": "case-panel",
      "title": "One permanent case map",
      "learnerCopy": {
        "en": "The six cases do not restart with a new declension. Nominative and vocative remain active; genitive, dative, accusative and ablative stay visible until their functional unlocks.",
        "fr": "Les six cas ne recommencent pas avec chaque déclinaison. Nominatif et vocatif restent actifs ; génitif, datif, accusatif et ablatif restent visibles jusqu'à leur activation."
      }
    },
    {
      "id": "l6-b3",
      "type": "morphology",
      "title": "Find the stem from the genitive",
      "learnerCopy": {
        "en": "pacis gives pac-, corporis gives corpor-, hominis gives homin-, noctis gives noct-. Do not guess the stem from the nominative.",
        "fr": "pacis donne pac-, corporis donne corpor-, hominis donne homin-, noctis donne noct-. Ne devinez pas le radical à partir du nominatif."
      }
    },
    {
      "id": "l6-b4",
      "type": "morphology",
      "title": "Watch the neuters",
      "learnerCopy": {
        "en": "corpus, nomen, cor, lumen, tempus and os are neuter. Keep the neuter principle in view: nominative and accusative match, and neuter plural commonly ends in -a. Accusative becomes active in Lesson 9.",
        "fr": "corpus, nomen, cor, lumen, tempus et os sont neutres. Gardez en vue la règle du neutre : nominatif et accusatif coïncident, et le pluriel neutre finit souvent en -a. L'accusatif sera activé à la leçon 9."
      }
    },
    {
      "id": "l6-b5",
      "type": "authentic-example",
      "title": "Pater noster",
      "sourceId": "mr1962-pater-noster-opening-l6",
      "learnerCopy": {
        "en": "Pater and nomen are both third-declension nouns despite very different nominatives. Their genitives patris and nominis make the stems visible.",
        "fr": "Pater et nomen appartiennent tous deux à la troisième déclinaison malgré des nominatif très différents. Leurs génitifs patris et nominis rendent leurs radicaux visibles."
      }
    },
    {
      "id": "l6-b6",
      "type": "liturgical-reading",
      "title": "Pax and caro in context",
      "learnerCopy": {
        "en": "Read Pax Domini and Et Verbum caro factum est as cumulative Latin. The aim is to add the new noun system without losing the earlier vocabulary and verb recognition.",
        "fr": "Lisez Pax Domini et Et Verbum caro factum est comme un latin cumulatif. Il faut ajouter le nouveau système nominal sans perdre les acquis antérieurs."
      }
    }
  ],
