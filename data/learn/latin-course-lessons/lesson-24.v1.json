  "purposeResultFramework": {
    "purposeQuestion": "What is the action intended to achieve?",
    "resultQuestion": "What outcome follows from the degree/state stated in the main clause?",
    "prayerOutcome": "Prayer clauses such as ut digni efficiamur express a desired result/outcome and can overlap semantically with purpose.",
