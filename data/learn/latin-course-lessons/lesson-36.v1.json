  "poeticRegisterFramework": {
    "features": [
      "parallelism and repeated syntax",
      "ellipsis of verbs or connectives recoverable from context",
      "hyperbaton: words belonging together may be separated",
      "rhetorical questions and apostrophe",
      "concrete biblical imagery carrying devotional meaning"
    ],
    "readingRule": "Reconstruct grammatical relationships before restoring normal prose order; do not assume poetic order changes case government.",
    "referenceIds": [
      "curriculum-latin-course-40-v1",
