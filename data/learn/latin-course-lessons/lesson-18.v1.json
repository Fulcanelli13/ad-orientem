  "demonstrativeFramework": {
    "contrasts": [
      {
        "family": "hic/haec/hoc",
        "value": "this; points to something near or immediately present"
      },
      {
        "family": "ille",
        "value": "that / he; often points away or resumes a known referent"
      },
      {
        "family": "iste",
        "value": "that one near you / that one; context controls tone"
      },
      {
        "family": "ipse",
        "value": "self / very; intensive identity"
      },
      {
        "family": "idem",
        "value": "same; identity across references"
      },
