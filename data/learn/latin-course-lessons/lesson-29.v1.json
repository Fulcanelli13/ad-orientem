  "sources": [
    {
      "id": "canon-nobis-quoque-l29",
      "sourceType": "primary-liturgical",
      "work": "Missale Romanum (1962)",
      "section": "Canon Missae — Nobis quoque peccatoribus",
      "sourceLatin": "Nobis quoque peccatoribus, famulis tuis, de multitudine miserationum tuarum sperantibus, partem aliquam et societatem donare digneris, cum tuis sanctis Apostolis et Martyribus.",
      "provenanceNote": "Nobis and famulis show dative/reference syntax; de multitudine supplies a prepositional ablative.",
      "corpusReferenceIds": [
        "corpus-missale-romanum-1962"
      ]
    },
    {
      "id": "canon-supplices-l29",
      "sourceType": "primary-liturgical",
      "work": "Missale Romanum (1962)",
      "section": "Canon Missae — Supplices te rogamus",
      "sourceLatin": "Supplices te rogamus, omnipotens Deus: iube haec perferri per manus sancti Angeli tui in sublime altare tuum, in conspectu divinae maiestatis tuae: ut, quotquot ex hac altaris participatione sacrosanctum Filii tui Corpus et Sanguinem sumpserimus, omni benedictione caelesti et gratia repleamur.",
      "provenanceNote": "in conspectu gives ablative after in; omni benedictione caelesti et gratia illustrates ablative of means/content with repleamur.",
      "corpusReferenceIds": [
        "corpus-missale-romanum-1962"
      ]
    },
