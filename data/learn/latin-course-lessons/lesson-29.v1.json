  "advancedCaseFramework": {
    "dative": [
      "recipient/reference: nobis, famulis",
      "person affected or addressed indirectly"
    ],
    "ablative": [
      "prepositional: de multitudine, in conspectu, in unitate",
      "means/content: omni benedictione caelesti et gratia repleamur"
    ],
    "rule": "Name the function only after identifying morphology, governing word, and clause meaning.",
