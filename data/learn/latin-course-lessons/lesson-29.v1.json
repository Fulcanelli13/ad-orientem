    ]
  },
  "learningBlocks": [
    {
      "id": "l29-b1",
      "type": "concept",
      "title": "Case labels are not enough",
      "learnerCopy": {
        "en": "By now you know the six cases. Advanced reading asks what a particular dative or ablative is doing in this clause: recipient, reference, prepositional complement, means, content or circumstance.",
        "fr": "Vous connaissez désormais les six cas. La lecture avancée demande ce qu'un datif ou un ablatif précis fait dans la proposition : destinataire, référence, complément prépositionnel, moyen, contenu ou circonstance."
      },
      "referenceIds": [
        "grammar-nunn-1922",
        "grammar-scanlon-1944",
        "grammar-petitmangin-1930",
        "curriculum-latin-course-40-v1"
      ],
      "localization": {
        "fr": {
          "title": "Les étiquettes de cas ne suffisent pas"
        }
      }
    },
    {
      "id": "l29-b2",
      "type": "canon",
      "title": "Nobis quoque peccatoribus",
      "sourceId": "canon-nobis-quoque-l29",
      "learnerCopy": {
        "en": "Nobis and famulis refer to the people for whom the granting is requested. de multitudine is ablative because de governs the ablative. Keep morphology and function separate.",
        "fr": "Nobis et famulis désignent ceux en faveur de qui le don est demandé. de multitudine est à l'ablatif parce que de régit l'ablatif. Gardez distincts morphologie et fonction."
      },
      "referenceIds": [
        "canon-nobis-quoque-l29",
        "grammar-nunn-1922",
        "grammar-scanlon-1944",
        "grammar-petitmangin-1930",
        "curriculum-latin-course-40-v1"
      ],
      "localization": {
        "fr": {
          "title": "Nobis quoque peccatoribus"
        }
      }
    },
    {
      "id": "l29-b3",
      "type": "canon",
      "title": "in conspectu divinae maiestatis tuae",
      "sourceId": "canon-supplices-l29",
      "learnerCopy": {
        "en": "conspectu is ablative after static in; maiestatis is genitive depending on conspectu. A short phrase can therefore contain two different case relationships nested together.",
        "fr": "conspectu est à l'ablatif après in statique ; maiestatis est un génitif dépendant de conspectu. Un groupe court peut donc contenir deux relations de cas imbriquées."
      },
      "referenceIds": [
        "canon-supplices-l29",
        "grammar-nunn-1922",
        "grammar-scanlon-1944",
        "grammar-petitmangin-1930",
        "curriculum-latin-course-40-v1"
      ],
      "localization": {
        "fr": {
          "title": "in conspectu divinae maiestatis tuae"
        }
      }
    },
    {
      "id": "l29-b4",
      "type": "canon",
      "title": "omni benedictione caelesti et gratia repleamur",
      "sourceId": "canon-supplices-l29",
      "learnerCopy": {
        "en": "The ablatives describe that with which the recipients are filled. Translate the sense naturally, but keep the Latin case function visible.",
        "fr": "Les ablatifs indiquent ce dont les bénéficiaires sont comblés. Traduisez naturellement, tout en gardant visible la fonction latine."
      },
      "referenceIds": [
        "canon-supplices-l29",
        "grammar-nunn-1922",
        "grammar-scanlon-1944",
        "grammar-petitmangin-1930",
        "curriculum-latin-course-40-v1"
      ],
      "localization": {
        "fr": {
          "title": "omni benedictione caelesti et gratia repleamur"
        }
      }
    },
    {
      "id": "l29-b5",
      "type": "retrieval",
      "title": "Governing word before label",
      "learnerCopy": {
        "en": "For every difficult dative/ablative, ask: is there a preposition or governing verb? What relationship does the clause express? Only then choose the conventional case-function label.",
        "fr": "Pour chaque datif ou ablatif difficile, demandez : y a-t-il une préposition ou un verbe régissant ? Quelle relation exprime la proposition ? Choisissez ensuite l'étiquette traditionnelle de fonction."
      },
      "referenceIds": [
        "grammar-nunn-1922",
        "grammar-scanlon-1944",
        "grammar-petitmangin-1930",
        "curriculum-latin-course-40-v1"
      ],
      "localization": {
        "fr": {
          "title": "Le mot régissant avant l’étiquette"
        }
      }
    },
    {
      "id": "l29-b6",
      "type": "application",
      "title": "Case function emerges from the whole phrase",
      "learnerCopy": {
        "en": "Do not translate nobis, gratia or unitate in isolation. Read the governing verb or preposition, then the entire phrase, and only afterward choose the conventional dative/ablative function label.",
        "fr": "Ne traduisez pas nobis, gratia ou unitate isolément. Lisez d'abord le verbe ou la préposition régissante, puis le groupe entier, et choisissez seulement ensuite l'étiquette fonctionnelle du datif ou de l'ablatif."
      },
      "referenceIds": [
        "grammar-nunn-1922",
        "grammar-scanlon-1944",
        "grammar-petitmangin-1930",
        "curriculum-latin-course-40-v1"
      ],
      "localization": {
        "fr": {
          "title": "La fonction casuelle ressort du groupe entier"
        }
      }
    }
  ],
  "authenticPassages": [
    {
      "id": "l29-p1",
      "sourceId": "canon-nobis-quoque-l29",
      "sourceLatin": "Nobis quoque peccatoribus, famulis tuis, de multitudine miserationum tuarum sperantibus, partem aliquam et societatem donare digneris, cum tuis sanctis Apostolis et Martyribus.",
      "instructionalDisplay": "Nobis quoque peccatoribus, famulis tuis, de multitudine miserationum tuarum sperantibus, partem aliquam et societatem donare digneris, cum tuis sanctis Apostolis et Martyribus.",
      "translation": {
        "en": "To us also, Thy sinful servants, who hope in the multitude of Thy mercies, vouchsafe to grant some part and fellowship with Thy holy Apostles and Martyrs.",
        "fr": "À nous aussi, pécheurs, vos serviteurs, qui espérons en l'abondance de vos miséricordes, daignez accorder part et société avec vos saints Apôtres et Martyrs."
      },
