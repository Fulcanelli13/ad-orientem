        },
        {
          "claim_id": "CL05-S02-Q001",
          "stage_id": "CL05-S02",
          "stage_title": "Preparing an Infant",
          "layer": "PROFILE_1962",
          "text": "Under the 1917 discipline governing the 1962 context, infants were to be baptised as soon as possible.",
