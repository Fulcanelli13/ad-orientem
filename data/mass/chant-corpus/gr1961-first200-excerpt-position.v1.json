      "sourceBlobSha": "582aeed4735ae91a7ecc849392db52eef34c577a",
      "latinExcerpt": "v. Jubiláte Deo, omnis terra, allelúja: psalmum dícite nómini ejus, allelúja: date glóriam laudi ejus, allelúja, allelúja, allelúja.",
      "excerptPosition": "EMBEDDED"
    },
    {
      "gregobaseId": 42,
      "officePart": "in",
      "incipit": "Cantate Domino",
      "properSourcePath": "Tempora/Pasc4-0",
      "sourceSection": "Introitus",
      "sourceBlobSha": "673e27a85c3b7fe2db84ef7dcf34928ec687a993",
      "latinExcerpt": "v. Cantáte Dómino cánticum novum, allelúja: quia mirabília fecit Dóminus, allelúja: ante conspéctum géntium revelávit justítiam suam, allelúja, allelú",
      "excerptPosition": "VERSE_MARKED_INITIAL"
    },
    {
      "gregobaseId": 13,
      "officePart": "in",
      "incipit": "Omnis terra",
      "properSourcePath": "Tempora/Pasc5-0",
      "sourceSection": "Introitus",
      "sourceBlobSha": "fed2ed67936384674d024caa2d3c8e31193ede83",
      "latinExcerpt": "Jubiláte Deo, omnis terra, psalmum dícite nómini ejus: date glóriam laudi ejus.",
      "excerptPosition": "EMBEDDED"
    },
    {
      "gregobaseId": 99,
      "officePart": "al",
      "incipit": "Emitte Spiritum",
      "properSourcePath": "Tempora/Pasc7-0",
      "sourceSection": "Graduale",
      "sourceBlobSha": "64876cd8fa68f29bc86926b60bcc50e4fffa76fe",
      "latinExcerpt": "Emítte Spíritum tuum, et creabúntur, et renovábis fáciem terræ. Allelúja. (Hic genuflectitur)",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 181,
      "officePart": "al",
      "incipit": "Veni Sancte Spiritus",
      "properSourcePath": "Tempora/Pasc7-0",
      "sourceSection": "Graduale",
      "sourceBlobSha": "64876cd8fa68f29bc86926b60bcc50e4fffa76fe",
      "latinExcerpt": "V. Veni, Sancte Spíritus, reple tuórum corda fidélium: et tui amóris in eis ignem accénde.",
      "excerptPosition": "VERSE_MARKED_INITIAL"
    },
    {
      "gregobaseId": 93,
      "officePart": "of",
      "incipit": "Tulerunt Jesum",
      "properSourcePath": "Tempora/Epi1-0",
      "sourceSection": "Offertorium",
      "sourceBlobSha": "1ebc53e4c7ca02c8d8d075f5a3281ef7a6f63532",
      "latinExcerpt": "Tulérunt Jesum paréntes ejus in Jerúsalem, ut sísterent eum Dómino.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 13,
      "officePart": "in",
      "incipit": "Omnis terra",
      "properSourcePath": "Tempora/Epi2-0",
      "sourceSection": "Introitus",
      "sourceBlobSha": "ef91014e4a791e5c777a8c07494d5355f95807f1",
      "latinExcerpt": "v. Omnis terra adóret te, Deus, et psallat tibi: psalmum dicat nómini tuo, Altíssime.",
      "excerptPosition": "VERSE_MARKED_INITIAL"
    },
    {
      "gregobaseId": 47,
      "officePart": "of",
      "incipit": "Dextera Domini",
      "properSourcePath": "Tempora/Epi3-0",
      "sourceSection": "Offertorium",
      "sourceBlobSha": "a1c27338ee6b8678f1bdb3bc956857723c3e7e29",
      "latinExcerpt": "Déxtera Dómini fecit virtutem, déxtera Dómini exaltávit me: non móriar, sed vivam, et narrábo ópera Dómini.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 47,
      "officePart": "of",
      "incipit": "Dextera Domini",
      "properSourcePath": "Tempora/Epi5-0",
      "sourceSection": "Offertorium",
      "sourceBlobSha": "f3dbe1c59c25403307c9a55e945c6fb46a5aaeb2",
      "latinExcerpt": "Déxtera Dómini fecit virtutem, déxtera Dómini exaltávit me: non móriar, sed vivam, et narrábo ópera Dómini.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 47,
      "officePart": "of",
      "incipit": "Dextera Domini",
      "properSourcePath": "Tempora/Epi6-0",
      "sourceSection": "Offertorium",
      "sourceBlobSha": "ba220165832a54de3bddfcb5dec0d6d9079cdf6a",
      "latinExcerpt": "Déxtera Dómini fecit virtutem, déxtera Dómini exaltávit me: non móriar, sed vivam, et narrábo ópera Dómini.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 78,
      "officePart": "in",
      "incipit": "Judica me",
      "properSourcePath": "Tempora/Quad5-0",
      "sourceSection": "Introitus",
      "sourceBlobSha": "f2395993e50862261732847c2bcb4a999bbdef1d",
      "latinExcerpt": "v. Júdica me, Deus, et discérne causam meam de gente non sancta: ab hómine iníquo et dolóso éripe me: quia tu es Deus meus et fortitúdo mea.",
      "excerptPosition": "VERSE_MARKED_INITIAL"
    },
    {
      "gregobaseId": 49,
      "officePart": "gr",
      "incipit": "Tenuisti manum",
      "properSourcePath": "Tempora/Quad6-0",
      "sourceSection": "Graduale",
      "sourceBlobSha": "9d0de35b80e978aa01d8b194ae7068a7ee14714b",
      "latinExcerpt": "Tenuísti manum déxteram meam: et in voluntáte tua deduxísti me: et cum glória assumpsísti me.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 124,
      "officePart": "in",
      "incipit": "Vultum tuum",
      "properSourcePath": "Tempora/Pasc6-0",
      "sourceSection": "Introitus",
      "sourceBlobSha": "ed8d4af1759f2641dc64d342c922f3d4f4564b7c",
      "latinExcerpt": "v. Exáudi, Dómine, vocem meam, qua clamávi ad te, allelúja: tibi dixit cor meum, quæsívi vultum tuum, vultum tuum, Dómine, requíram: ne avértas fáciem",
      "excerptPosition": "EMBEDDED"
    },
    {
      "gregobaseId": 107,
      "officePart": "al",
      "incipit": "Non vos relinquam",
      "properSourcePath": "Tempora/Pasc6-0",
      "sourceSection": "Graduale",
      "sourceBlobSha": "ed8d4af1759f2641dc64d342c922f3d4f4564b7c",
      "latinExcerpt": "V. Non vos relínquam órphanos: vado, et vénio ad vos, et gaudébit cor vestrum. Allelúja.",
      "excerptPosition": "VERSE_MARKED_INITIAL"
    },
    {
      "gregobaseId": 211,
      "officePart": "of",
      "incipit": "Ascendit Deus",
      "properSourcePath": "Tempora/Pasc6-0",
      "sourceSection": "Offertorium",
      "sourceBlobSha": "ed8d4af1759f2641dc64d342c922f3d4f4564b7c",
      "latinExcerpt": "Ascéndit Deus in jubilatióne, et Dóminus in voce tubæ, allelúja.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 134,
      "officePart": "al",
      "incipit": "Salvum me fac",
      "properSourcePath": "Tempora/Pent02-0",
      "sourceSection": "Graduale",
      "sourceBlobSha": "934264dad5ea530084fc8dfe15eed79edf07c607",
      "latinExcerpt": "Dómine, Deus meus, in te sperávi: salvum me fac ex ómnibus persequéntibus me et líbera me. Allelúja.",
      "excerptPosition": "EMBEDDED"
    },
    {
      "gregobaseId": 189,
      "officePart": "al",
      "incipit": "Propitius esto (All.)",
      "properSourcePath": "Tempora/Pent04-0",
      "sourceSection": "Graduale",
      "sourceBlobSha": "bb3f6bc65d635934faf7cf20092d1bfb38a2db86",
      "latinExcerpt": "Propítius esto, Dómine, peccátis nostris: ne quando dicant gentes: Ubi est Deus eórum?",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 38,
      "officePart": "gr",
      "incipit": "Domine Deus virtutum",
      "properSourcePath": "Tempora/Pent05-0",
      "sourceSection": "Graduale",
      "sourceBlobSha": "2cc7d77d47defc63e10812988aa49bb5be0b953b",
      "latinExcerpt": "V. Dómine, Deus virtútum, exáudi preces servórum tuórum.",
      "excerptPosition": "VERSE_MARKED_INITIAL"
    },
    {
      "gregobaseId": 143,
      "officePart": "of",
      "incipit": "Benedicam Dominum",
      "properSourcePath": "Tempora/Pent05-0",
      "sourceSection": "Offertorium",
      "sourceBlobSha": "2cc7d77d47defc63e10812988aa49bb5be0b953b",
      "latinExcerpt": "Benedícam Dóminum, qui tríbuit mihi intelléctum: providébam Deum in conspéctu meo semper: quóniam a dextris est mihi, ne commóvear.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 77,
      "officePart": "al",
      "incipit": "Omnes gentes plaudite (All)",
      "properSourcePath": "Tempora/Pent07-0",
      "sourceSection": "Graduale",
      "sourceBlobSha": "cd63373d6ad1fac0015b09f084c9634f585066c6",
      "latinExcerpt": "Omnes gentes, pláudite mánibus: jubiláte Deo in voce exsultatiónis. Allelúja.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 63,
      "officePart": "tr",
      "incipit": "Cor meum",
      "properSourcePath": "Tempora/Pent11-0",
      "sourceSection": "Graduale",
      "sourceBlobSha": "da5b4cd6cfad7938787fac5b2bd15e3748586288",
      "latinExcerpt": "In Deo sperávit cor meum, et adjútus sum: et reflóruit caro mea, et ex voluntáte mea confitébor illi.",
      "excerptPosition": "EMBEDDED"
    },
    {
      "gregobaseId": 172,
      "officePart": "in",
      "incipit": "Da pacem",
      "properSourcePath": "Tempora/Pent18-0",
      "sourceSection": "Introitus",
      "sourceBlobSha": "12148b5f40ddfa4bb516ed6674e43911c2b58b4a",
      "latinExcerpt": "v. Da pacem, Dómine, sustinéntibus te, ut prophétæ tui fidéles inveniántur: exáudi preces servi tui et plebis tuæ Israël",
      "excerptPosition": "VERSE_MARKED_INITIAL"
    },
    {
      "gregobaseId": 44,
      "officePart": "gr",
      "incipit": "Dirigatur oratio mea",
      "properSourcePath": "Tempora/Pent19-0",
      "sourceSection": "Graduale",
      "sourceBlobSha": "1677574533e0c814c2afd9b001b7a5b6f44b22b3",
      "latinExcerpt": "Dirigátur orátio mea, sicut incénsum in conspéctu tuo, Dómine.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 63,
      "officePart": "tr",
      "incipit": "Cor meum",
      "properSourcePath": "Tempora/Pent20-0",
      "sourceSection": "Graduale",
      "sourceBlobSha": "65fb02c3c410c9ae4d969df7d862a7b078e9af89",
      "latinExcerpt": "Parátum cor meum, Deus, parátum cor meum: cantábo, et psallam tibi, glória mea. Allelúja.",
      "excerptPosition": "EMBEDDED"
    },
    {
      "gregobaseId": 67,
      "officePart": "of",
      "incipit": "Recordare mei",
      "properSourcePath": "Tempora/Pent22-0",
      "sourceSection": "Offertorium",
      "sourceBlobSha": "3d817ff7d32eb61a606a96bddfa94193427941ae",
      "latinExcerpt": "Recordáre mei, Dómine, omni potentátui dóminans: et da sermónem rectum in os meum, ut pláceant verba mea in conspéctu príncipis.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 205,
      "officePart": "gr",
      "incipit": "Omnes de Saba",
      "properSourcePath": "Sancti/01-06",
      "sourceSection": "Graduale",
      "sourceBlobSha": "14ecd813980527a8e8180d51153b16e1c115d1d7",
      "latinExcerpt": "Omnes de Saba vénient, aurum et thus deferéntes, et laudem Dómino annuntiántes.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 50,
      "officePart": "gr",
      "incipit": "Suscepimus Deus (Grad.)",
      "properSourcePath": "Sancti/02-02",
      "sourceSection": "Graduale",
      "sourceBlobSha": "16c4f9b4cf99f6719a7701ad71c9f4789600854d",
      "latinExcerpt": "Suscépimus, Deus, misericórdiam tuam in médio templi tui: secúndum nomen tuum, Deus, ita et laus tua in fines terræ.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 5,
      "officePart": "in",
      "incipit": "Vidi civitatem",
      "properSourcePath": "Sancti/02-11",
      "sourceSection": "Introitus",
      "sourceBlobSha": "531e88caf016824e493ff4027e767e5b6934e3fa",
      "latinExcerpt": "v. Vidi civitátem sanctam, Jerúsalem novam, descendéntem de cœlo a Deo, parátam sicut sponsam ornátam viro suo.",
      "excerptPosition": "VERSE_MARKED_INITIAL"
    },
    {
      "gregobaseId": 27,
      "officePart": "gr",
      "incipit": "Flores apparuerunt",
      "properSourcePath": "Sancti/02-11",
      "sourceSection": "Graduale",
      "sourceBlobSha": "531e88caf016824e493ff4027e767e5b6934e3fa",
      "latinExcerpt": "Flores apparuérunt in terra nostra, tempus putatiónis advénit, vox túrturis audíta est in terra nostra.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 80,
      "officePart": "co",
      "incipit": "Visitasti terram",
      "properSourcePath": "Sancti/02-11",
      "sourceSection": "Communio",
      "sourceBlobSha": "531e88caf016824e493ff4027e767e5b6934e3fa",
      "latinExcerpt": "Visitásti terram et inebriásti eam, multiplicásti locupletáre eam.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 153,
      "officePart": "gr",
      "incipit": "Beatus vir qui timet (Grad.)",
      "properSourcePath": "Sancti/03-19",
      "sourceSection": "Graduale",
      "sourceBlobSha": "1d74084bac51845b47663157d120295b31e16c2b",
      "latinExcerpt": "Beátus vir, qui timet Dóminum: in mandátis ejus cupit nimis.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 139,
      "officePart": "co",
      "incipit": "Joseph fili David",
      "properSourcePath": "Sancti/03-19",
      "sourceSection": "Communio",
      "sourceBlobSha": "1d74084bac51845b47663157d120295b31e16c2b",
      "latinExcerpt": "Joseph, fili David, noli timére accípere Maríam cónjugem tuam: quod enim in ea natum est, de Spíritu Sancto est. (Allelúja.)",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 18,
      "officePart": "tr",
      "incipit": "Gaude Maria",
      "properSourcePath": "Sancti/05-31",
      "sourceSection": "Tractus",
      "sourceBlobSha": "8d1e76e3afb2dc24a884457184722be838d2175a",
      "latinExcerpt": "Gaude, María Virgo, cunctas hǽreses sola interemísti.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 133,
      "officePart": "co",
      "incipit": "Tu puer",
      "properSourcePath": "Sancti/06-24",
      "sourceSection": "Communio",
      "sourceBlobSha": "223a6fe3fdc14dbc7ba2b5d11e59b0ec545680c7",
      "latinExcerpt": "Tu, puer, Propheta Altíssimi vocaberis: præíbis enim ante fáciem Dómini paráre vias ejus.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 63,
      "officePart": "tr",
      "incipit": "Cor meum",
      "properSourcePath": "Sancti/08-06",
      "sourceSection": "Graduale",
      "sourceBlobSha": "2ba654683519aad5ebe62fbb5f36c13ccf89799a",
      "latinExcerpt": "V. Eructávit cor meum verbum bonum: dico ego ópera mea Regi.",
      "excerptPosition": "EMBEDDED"
    },
    {
      "gregobaseId": 125,
      "officePart": "of",
      "incipit": "Gloria et divitiae",
      "properSourcePath": "Sancti/08-06",
      "sourceSection": "Offertorium",
      "sourceBlobSha": "2ba654683519aad5ebe62fbb5f36c13ccf89799a",
      "latinExcerpt": "Glória et divítiæ in domo ejus: et justítia ejus manet in sǽculum sǽculi, allelúja.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 23,
      "officePart": "in",
      "incipit": "Signum magnum",
      "properSourcePath": "Sancti/08-15",
      "sourceSection": "Introitus",
      "sourceBlobSha": "4fa6f0074f1a6581fb857b9cd6b4db9148dcf1b2",
      "latinExcerpt": "v. Signum magnum appáruit in cœlo: múlier amicta sole, et luna sub pédibus ejus, et in cápite ejus coróna stellárum duódecim.",
      "excerptPosition": "VERSE_MARKED_INITIAL"
    },
    {
      "gregobaseId": 42,
      "officePart": "in",
      "incipit": "Cantate Domino",
      "properSourcePath": "Sancti/08-15",
      "sourceSection": "Introitus",
      "sourceBlobSha": "4fa6f0074f1a6581fb857b9cd6b4db9148dcf1b2",
      "latinExcerpt": "Cantáte Dómino cánticum novum: quóniam mirabília fecit.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 63,
      "officePart": "tr",
      "incipit": "Cor meum",
      "properSourcePath": "Sancti/08-22",
      "sourceSection": "Graduale",
      "sourceBlobSha": "4f1f9a168bdfa6a5e710ebab8db064ce9b0421f9",
      "latinExcerpt": "Exsultábit cor meum in salutári tuo: cantábo Dómino, qui bona tríbuit mihi: et psallam nómini Dómini altíssimi.",
      "excerptPosition": "EMBEDDED"
    },
    {
      "gregobaseId": 2,
      "officePart": "in",
      "incipit": "Deus misereatur",
      "properSourcePath": "Sancti/09-14",
      "sourceSection": "Introitus",
      "sourceBlobSha": "d3a4f0046cbcdf284617e23b6cd43cb606e57792",
      "latinExcerpt": "Deus misereátur nostri, et benedícat nobis: illúminet vultum suum super nos, et misereátur nostri.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 195,
      "officePart": "of",
      "incipit": "Protege Domine",
      "properSourcePath": "Sancti/09-14",
      "sourceSection": "Offertorium",
      "sourceBlobSha": "d3a4f0046cbcdf284617e23b6cd43cb606e57792",
      "latinExcerpt": "Prótege, Dómine, plebem tuam per signum sanctæ Crucis ab ómnibus insídiis inimicórum ómnium: ut tibi gratam exhibeámus servitútem, et acceptábile fiat",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 128,
      "officePart": "in",
      "incipit": "Dignus est Agnus",
      "properSourcePath": "Sancti/10-DU",
      "sourceSection": "Introitus",
      "sourceBlobSha": "a1ca57155d564dd18f00b2e9b36d73f0a55c0c89",
      "latinExcerpt": "v. Dignus est Agnus, qui occísus est, accípere virtútem, et divinitátem, et sapiéntiam, et fortitúdinem, et honórem. Ipsi glória et impérium in sǽcula",
      "excerptPosition": "VERSE_MARKED_INITIAL"
    },
    {
      "gregobaseId": 210,
      "officePart": "of",
      "incipit": "Ave Maria (Offertorium)",
      "properSourcePath": "Sancti/12-08",
      "sourceSection": "Offertorium",
      "sourceBlobSha": "a3e4862cd0eab54cafcb7e543f4fabd22cf97b78",
      "latinExcerpt": "Ave, María, grátia plena; Dóminus tecum: benedícta tu in muliéribus, allelúja.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 134,
      "officePart": "al",
      "incipit": "Salvum me fac",
      "properSourcePath": "Sancti/12-26",
      "sourceSection": "Graduale",
      "sourceBlobSha": "c8dceecb4a4fcb95c3bd6852788d11e250bf4810",
      "latinExcerpt": "Adjuva me, Dómine, Deus meus: salvum me fac propter misericórdiam tuam.",
      "excerptPosition": "EMBEDDED"
    },
    {
      "gregobaseId": 136,
      "officePart": "co",
      "incipit": "Vox in Rama (Com.)",
      "properSourcePath": "Sancti/12-28",
      "sourceSection": "Communio",
      "sourceBlobSha": "9e41240b7c8a143f87d76cccf0ea1db47f81d9b5",
      "latinExcerpt": "Vox in Rama audíta est, plorátus, et ululátus: Rachel plorans fílios suos, et nóluit consolári, quia non sunt.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 2,
      "officePart": "in",
      "incipit": "Deus misereatur",
      "properSourcePath": "Sancti/05-03",
      "sourceSection": "Introitus",
      "sourceBlobSha": "753648391c5b2fe8eb4868643de6178cd12381c7",
      "latinExcerpt": "Deus misereátur nostri, et benedícat nobis: illúminet vultum suum super nos, et misereátur nostri.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 47,
      "officePart": "of",
      "incipit": "Dextera Domini",
      "properSourcePath": "Sancti/05-03",
      "sourceSection": "Offertorium",
      "sourceBlobSha": "753648391c5b2fe8eb4868643de6178cd12381c7",
      "latinExcerpt": "Déxtera Dómini fecit virtútem, déxtera Dómini exaltávit me: non móriar, sed vivam et narrábo ópera Dómini, allelúja.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 34,
      "officePart": "gr",
      "incipit": "Justus ut palma",
      "properSourcePath": "Sancti/05-06",
      "sourceSection": "Graduale",
      "sourceBlobSha": "8b1e559fa03c0f75e0166fd0dd8dd2d3a733737e",
      "latinExcerpt": "Justus ut palma florébit: sicut cedrus Líbani multiplicábitur. Allelúja",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 102,
      "officePart": "of",
      "incipit": "Mihi autem adhaerere",
      "properSourcePath": "Sancti/05-13",
      "sourceSection": "Offertorium",
      "sourceBlobSha": "ad4cc8726cb92b05050f3d50ae0ce003ed2ea637",
      "latinExcerpt": "Mihi autem adhærére Deo bonum est, pónere in Dómino Deo spem meam: ut annúntiem omnes prædicatiónes tuas in portis fíliæ Sion, allelúja.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 194,
      "officePart": "al",
      "incipit": "De excelso",
      "properSourcePath": "Sancti/05-26",
      "sourceSection": "Graduale",
      "sourceBlobSha": "501d5bbfdf97133eccf62fc08befb03372fae555",
      "latinExcerpt": "De excélso misit ignem in óssibus meis, et erudívit me. Allelúja.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 42,
      "officePart": "in",
      "incipit": "Cantate Domino",
      "properSourcePath": "Sancti/08-10",
      "sourceSection": "Introitus",
      "sourceBlobSha": "fa0f38551e35689aeab7c5a17ef4c5a3906c103d",
      "latinExcerpt": "Cantáte Dómino cánticum novum: cantáte Dómino, omnis terra.",
      "excerptPosition": "EXCERPT_INITIAL"
    },
    {
      "gregobaseId": 63,
      "officePart": "tr",
      "incipit": "Cor meum",
      "properSourcePath": "Sancti/08-10",
      "sourceSection": "Graduale",
      "sourceBlobSha": "fa0f38551e35689aeab7c5a17ef4c5a3906c103d",
      "latinExcerpt": "Probásti, Dómine, cor meum, et visitásti nocte.",
      "excerptPosition": "EMBEDDED"
    },
    {
      "gregobaseId": 153,
      "officePart": "gr",
      "incipit": "Beatus vir qui timet (Grad.)",
      "properSourcePath": "Sancti/09-21",
      "sourceSection": "Graduale",
      "sourceBlobSha": "e469538a7559c3c4f5676d547961d52eacaeca94",
      "latinExcerpt": "Beátus vir, qui timet Dóminum: in mandátis ejus cupit nimis.",
      "excerptPosition": "EXCERPT_INITIAL"
    }
  ]
}
