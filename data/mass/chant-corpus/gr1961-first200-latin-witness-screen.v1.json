  "candidateOccurrences": [
    {
      "gregobaseId": 132,
      "officePart": "in",
      "incipit": "Ad te levavi",
      "properSourcePath": "Tempora/Adv1-0",
      "sourceSection": "Introitus",
      "sourceBlobSha": "75b533254548cf9f93636ea3d44dca059c6896d1",
      "latinExcerpt": "v. Ad te levávi ánimam meam: Deus meus, in te confído, non erubéscam: neque irrídeant me inimíci mei: étenim univérsi, qui te exspéctant, non confundé",
      "evidenceLevel": "LATIN_SECTION_OCCURRENCE_NOT_SELECTED_1962_PROPER"
    },
    {
      "gregobaseId": 113,
      "officePart": "of",
      "incipit": "Benedixisti Domine",
      "properSourcePath": "Tempora/Adv3-0",
      "sourceSection": "Offertorium",
      "sourceBlobSha": "de744967d1d6e9ae6a3ccdff81360c8b5565e873",
      "latinExcerpt": "Benedixísti, Dómine, terram tuam: avertísti captivitátem Jacob: remisísti iniquitatem plebis tuæ.",
      "evidenceLevel": "LATIN_SECTION_OCCURRENCE_NOT_SELECTED_1962_PROPER"
    },
    {
      "gregobaseId": 1,
      "officePart": "al",
      "incipit": "Laudem Domini",
      "properSourcePath": "Tempora/Adv4-0",
      "sourceSection": "Graduale",
      "sourceBlobSha": "2b9698e67af701d12e12609e64f1d68dc52b6700",
      "latinExcerpt": "V. Laudem Dómini loquétur os meum: et benedícat omnis caro nomen sanctum ejus. Allelúja, allelúja,",
      "evidenceLevel": "LATIN_SECTION_OCCURRENCE_NOT_SELECTED_1962_PROPER"
    },
    {
      "gregobaseId": 210,
      "officePart": "of",
      "incipit": "Ave Maria (Offertorium)",
      "properSourcePath": "Tempora/Adv4-0",
      "sourceSection": "Offertorium",
      "sourceBlobSha": "2b9698e67af701d12e12609e64f1d68dc52b6700",
      "latinExcerpt": "Ave, María, gratia plena; Dóminus tecum: benedícta tu in muliéribus, et benedíctus fructus ventris tui.",
      "evidenceLevel": "LATIN_SECTION_OCCURRENCE_NOT_SELECTED_1962_PROPER"
    },
    {
      "gregobaseId": 25,
      "officePart": "in",
      "incipit": "Quasi modo",
      "properSourcePath": "Tempora/Pasc1-0",
      "sourceSection": "Introitus",
      "sourceBlobSha": "92c5d80537dcb09b97ed567f57b47383fc3aa090",
      "latinExcerpt": "v. Quasi modo géniti infántes, allelúja: rationábiles, sine dolo lac concupíscite, allelúja, allelúja, allelúja.",
      "evidenceLevel": "LATIN_SECTION_OCCURRENCE_NOT_SELECTED_1962_PROPER"
    },
    {
      "gregobaseId": 135,
      "officePart": "in",
      "incipit": "Misericordia Domini",
      "properSourcePath": "Tempora/Pasc2-0",
      "sourceSection": "Introitus",
      "sourceBlobSha": "56c6c4c1fb80ab7d69c5a87579533a17cf891ffb",
      "latinExcerpt": "v. Misericórdia Dómini plena est terra, allelúja: verbo Dómini cœli firmáti sunt, allelúja, allelúja.",
      "evidenceLevel": "LATIN_SECTION_OCCURRENCE_NOT_SELECTED_1962_PROPER"
    },
    {
      "gregobaseId": 56,
