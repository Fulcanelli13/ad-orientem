      "sourceSection": "Graduale",
      "sourceBlobSha": "56c6c4c1fb80ab7d69c5a87579533a17cf891ffb",
      "latinExcerpt": "Ego sum pastor bonus: et cognósco oves meas, et cognóscunt me meæ. Allelúja.",
      "evidenceLevel": "LATIN_SECTION_OCCURRENCE_NOT_SELECTED_1962_PROPER"
    },
    {
      "gregobaseId": 95,
      "officePart": "co",
      "incipit": "Ego sum pastor (cum Alleluia)",
