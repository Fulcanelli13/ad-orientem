    {
      "id": "REPLACE_FORMULARY",
      "ref": "Cum sanctissima §5",
      "requirement": "Use priority 1962 pro aliquibus locis, approved traditional Supplement, then 1962 Common. Do not transplant modern Roman Missal texts."
    },
    {
      "id": "OMITTED_HISTORICAL_FEAST",
      "ref": "Cum sanctissima §4; RG 111(d)",
      "requirement": "When an eligible additional saint's festival Mass omits the prescribed 1962 feast or vigil, commemorate that omitted celebration with appropriate collect, secret and postcommunion, respecting precedence and class limits."
    },
    {
      "id": "OPTIONAL_ADDITIONAL_COMMEMORATION",
      "ref": "Cum sanctissima §6; RG 111(d)",
      "requirement": "A separate ad libitum commemoration needs the named saint or mystery ON THAT DATE in 1962 pro aliquibus locis or an approved traditional Supplement; a modern calendar entry alone is insufficient."
    },
    {
      "id": "SUNG_MASS_RESTRICTIONS",
      "ref": "RG 111(a)-(d)",
      "requirement": "Preserve Mass form, class, privileged commemoration and numerical limits. Do not import all Low Mass commemorations into sung nonconventual Mass."
    },
    {
      "id": "ORATION_TEXT_INTEGRITY",
      "ref": "1962 Missal; RGMR prayers",
      "requirement": "Source-approved exact Latin collect, secret and postcommunion with rubrical conclusions/ordering. Placeholder 'N.' in an approved Common may be substituted as that source permits; otherwise no invented name interpolation."
    },
    {
      "id": "DOCTORS",
      "ref": "1962 Common of Doctors / Confessors; Cum sanctissima §5",
      "requirement": "A later Doctor title does not create new traditional feast, proper or oration. Doctor classification aids Common lookup, but complete edition-appropriate choice must be verified."
    },
    {
      "id": "CUM_SANCTISSIMA_SUNG_COMM_RECONCILIATION",
      "ref": "Cum sanctissima §4 (RG 111(d)); General Rubrics RG 111(a) sung nonconventual Mass",
      "requirement": "The newer decree orders commemoration of omitted traditional feast or vigil; the 1960 sung Mass restriction must be reconciled for actual form and rite. Do not guess whether St Kevin recited all three Leonardi orations at the 2026 High Mass."
    }
