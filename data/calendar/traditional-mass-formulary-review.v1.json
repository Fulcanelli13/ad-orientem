    {
      "id": "PRINCIPAL_MASS",
      "ref": "1962 RGMR, 2020 Cum sanctissima §1-2",
      "requirement": "An eligible saint's festive Mass is distinct from a commemoration; no automatic replacement of principal 1962 observance."
