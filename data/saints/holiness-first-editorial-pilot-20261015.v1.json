    {
      "saint_id": "saint:peter-chanel",
      "legacy_source_name": "Saint Peter Chanel",
      "display_name": {
        "en": "Saint Peter Chanel",
        "fr": "Saint Pierre Chanel"
      },
      "recognition_status": "CANONIZED_SAINT",
      "why_honoured": {
        "en": "A gentle and courageous Marist missionary, he persevered on Futuna and died for the Gospel, becoming Oceania's first martyr.",
        "fr": "Missionnaire mariste doux et courageux, il a persévéré à Futuna et est mort pour l'Évangile, devenant le premier martyr d'Océanie.",
        "source_ids": [
          "PETER"
        ]
      },
      "biography_facts": [
        {
          "kind": "holy_witness",
          "en": "He served amid hardship, isolation and opposition with remarkable patience.",
          "fr": "Il a servi au milieu des épreuves, de l'isolement et de l'opposition avec une patience remarquable.",
          "source_ids": [
            "PETER"
          ]
        },
        {
          "kind": "concrete_action",
          "en": "He was killed in 1841 while carrying out his missionary vocation on Futuna.",
          "fr": "Il a été tué en 1841 dans l'exercice de sa vocation missionnaire à Futuna.",
          "source_ids": [
            "PETER"
          ]
        },
        {
          "kind": "spiritual_legacy",
          "en": "His witness inspired the growing Church in Oceania and its missionary spirit.",
          "fr": "Son témoignage a inspiré l'Église naissante d'Océanie et son esprit missionnaire.",
          "source_ids": [
            "PETER"
          ]
        }
      ],
