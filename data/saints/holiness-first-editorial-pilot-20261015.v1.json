    {
      "saint_id": "saint:claude-la-colombiere",
      "legacy_source_name": "Saint Claude La Colombière",
      "display_name": {
        "en": "Saint Claude La Colombière",
        "fr": "Saint Claude La Colombière"
      },
      "recognition_status": "CANONIZED_SAINT",
      "why_honoured": {
        "en": "His Jesuit fidelity and pastoral charity, tested through imprisonment and illness, exemplified trust in Christ's merciful love.",
        "fr": "Sa fidélité de jésuite et sa charité pastorale, éprouvées par la prison et la maladie, ont manifesté la confiance dans l'amour miséricordieux du Christ.",
        "source_ids": [
          "CLAUDE"
        ]
      },
      "biography_facts": [
        {
          "kind": "holy_witness",
          "en": "He persevered in priestly service despite serious illness, false accusation and imprisonment.",
          "fr": "Il a persévéré dans son ministère malgré une grave maladie, une accusation injuste et la prison.",
          "source_ids": [
            "CLAUDE"
          ]
        },
        {
          "kind": "concrete_action",
          "en": "He accompanied Margaret Mary Alacoque and supported her mission concerning the Sacred Heart.",
          "fr": "Il a accompagné Marguerite-Marie Alacoque et soutenu sa mission relative au Sacré-Cœur.",
          "source_ids": [
            "CLAUDE"
          ]
        },
        {
          "kind": "spiritual_legacy",
          "en": "He led souls toward God along a path of trust, Gospel love and mercy.",
          "fr": "Il a conduit les âmes vers Dieu par la confiance, l'amour évangélique et la miséricorde.",
          "source_ids": [
            "CLAUDE"
          ]
        }
      ],
      "source_ids": [
        "CLAUDE"
      ],
