  "people": [
    {
      "saint_id": "saint:therese-of-lisieux",
      "legacy_source_name": "Saint Thérèse of Lisieux",
      "display_name": {
        "en": "Saint Thérèse of Lisieux",
        "fr": "Sainte Thérèse de Lisieux"
      },
      "recognition_status": "CANONIZED_SAINT",
      "why_honoured": {
        "en": "She showed that everyone can grow in holiness through ordinary acts done with extraordinary love and confidence in God.",
        "fr": "Elle a montré que chacun peut grandir en sainteté par des actes ordinaires accomplis avec un amour et une confiance extraordinaires en Dieu.",
        "source_ids": [
          "THER"
        ]
      },
      "biography_facts": [
        {
          "kind": "holy_witness",
          "en": "She lived a hidden Carmelite life, practising charity and self-giving in everyday duties.",
          "fr": "Elle a vécu une vie cachée au Carmel, pratiquant la charité et le don de soi dans les devoirs quotidiens.",
          "source_ids": [
            "THER"
          ]
        },
        {
          "kind": "concrete_action",
          "en": "She taught the Little Way of spiritual childhood, putting love and trust at the heart of Christian life.",
          "fr": "Elle a enseigné la petite voie de l'enfance spirituelle, plaçant l'amour et la confiance au cœur de la vie chrétienne.",
          "source_ids": [
            "THER"
          ]
        },
        {
          "kind": "spiritual_legacy",
          "en": "Her teaching inspired Christians worldwide; the Church proclaimed her a Doctor in 1997.",
          "fr": "Son enseignement a inspiré des chrétiens du monde entier ; l'Église l'a proclamée docteur en 1997.",
          "source_ids": [
            "THER"
          ]
        }
      ],
      "source_ids": [
        "THER"
      ],
      "further_reading_source_ids": [
        "THER"
      ],
