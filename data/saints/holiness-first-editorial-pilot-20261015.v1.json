      "extraordinary_accounts": [
        {
          "event_id": "event:bernadette:1858-lourdes",
          "kind": "MARIAN_APPARITION_ACCOUNT",
          "attribution": "PERSONAL_REPORTED_EXPERIENCE",
          "subject": "BLESSED_VIRGIN_MARY",
          "status": "ACKNOWLEDGED_IN_HOLY_SEE_DOCUMENT_NOT_PROOF_OF_EVERY_DETAIL",
          "en": "Bernadette reported appearances of the Blessed Virgin Mary at Lourdes beginning in 1858. This is an apparition testimony—not a claim that Bernadette herself performed the cures reported at the shrine.",
          "fr": "Bernadette a rapporté des apparitions de la Sainte Vierge à Lourdes à partir de 1858. Il s'agit d'un témoignage d'apparitions, non de l'affirmation qu'elle aurait personnellement accompli les guérisons rapportées au sanctuaire.",
          "source_ids": [
            "BERN_2007"
          ]
        }
      ],
