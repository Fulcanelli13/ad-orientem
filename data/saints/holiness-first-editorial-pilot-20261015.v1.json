    {
      "saint_id": "saint:bernadette-soubirous",
      "legacy_source_name": "Saint Bernadette Soubirous",
      "display_name": {
        "en": "Saint Bernadette Soubirous",
        "fr": "Sainte Bernadette Soubirous"
      },
      "recognition_status": "CANONIZED_SAINT",
      "why_honoured": {
        "en": "Her humble, persevering faith through poverty and rejection made her a witness to the call to prayer and conversion at Lourdes.",
        "fr": "Sa foi humble et persévérante, au milieu de la pauvreté et du rejet, a fait d'elle un témoin de l'appel à la prière et à la conversion à Lourdes.",
        "source_ids": [
          "BERN"
        ]
      },
      "biography_facts": [
        {
          "kind": "holy_witness",
          "en": "She remained steadfast despite poverty, sickness, scepticism and misunderstanding.",
          "fr": "Elle est restée ferme malgré la pauvreté, la maladie, le scepticisme et l'incompréhension.",
          "source_ids": [
            "BERN"
          ]
        },
        {
          "kind": "concrete_action",
          "en": "She reported the 1858 apparitions and faithfully relayed a message of prayer, penance and conversion.",
          "fr": "Elle a témoigné des apparitions de 1858 et transmis fidèlement un message de prière, de pénitence et de conversion.",
          "source_ids": [
            "BERN"
          ]
        },
        {
          "kind": "spiritual_legacy",
          "en": "Her example of simplicity and faith continues to console pilgrims, especially those who suffer.",
          "fr": "Son exemple de simplicité et de foi continue de réconforter les pèlerins, particulièrement ceux qui souffrent.",
          "source_ids": [
            "BERN"
          ]
        }
      ],
      "source_ids": [
        "BERN"
      ],
      "further_reading_source_ids": [
        "BERN",
        "BERN_2007"
      ],
