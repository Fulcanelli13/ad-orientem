    {
      "saint_id": "saint:margaret-mary-alacoque",
      "legacy_source_name": "Saint Margaret Mary Alacoque",
      "display_name": {
        "en": "Saint Margaret Mary Alacoque",
        "fr": "Sainte Marguerite-Marie Alacoque"
      },
      "recognition_status": "CANONIZED_SAINT",
      "why_honoured": {
        "en": "Her life of prayer, love and reparation helped renew devotion to the Sacred Heart of Jesus.",
        "fr": "Sa vie de prière, d'amour et de réparation a contribué au renouveau de la dévotion au Sacré-Cœur de Jésus.",
        "source_ids": [
          "MARG1",
          "MARG2"
        ]
      },
      "biography_facts": [
        {
          "kind": "holy_witness",
          "en": "She lived her Visitation vocation in a spirituality centred on Christ's love.",
          "fr": "Elle a vécu sa vocation à la Visitation dans une spiritualité centrée sur l'amour du Christ.",
          "source_ids": [
            "MARG1"
          ]
        },
        {
          "kind": "concrete_action",
          "en": "She reported revelations at Paray-le-Monial concerning the love of the Heart of Jesus.",
          "fr": "Elle a rapporté des révélations à Paray-le-Monial concernant l'amour du Cœur de Jésus.",
          "source_ids": [
            "MARG2"
          ]
        },
        {
          "kind": "spiritual_legacy",
          "en": "With Claude La Colombière's support, her witness helped deepen and spread Sacred Heart devotion.",
          "fr": "Avec l'appui de Claude La Colombière, son témoignage a contribué à approfondir et diffuser la dévotion au Sacré-Cœur.",
          "source_ids": [
            "MARG1"
          ]
        }
      ],
      "source_ids": [
        "MARG1",
        "MARG2"
      ],
      "further_reading_source_ids": [
        "MARG1",
