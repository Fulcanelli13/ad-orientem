 blockFirstCueSort=new Map(DATA.blocks.map(b=>[b.Block_ID,Math.min(...(b.units||[]).map(u=>Number(u.sort)).filter(Number.isFinite))]));
function postureActivationSort(p){
 if(p.Anchor_Type==='MASS_START')return -Infinity;
 if(p.Anchor_Type==='BLOCK_START')return blockFirstCueSort.get(p.Anchor_Ref)??Infinity;
 // Harmonized from v1.44: synthetic Gloria/Credo sedilia rows are not reliable public-time anchors.
 if(['AO.SM.POST.005','AO.SM.POST.010'].includes(p.Posture_Event_ID))return Infinity;
 const cue=POSTURE_ANCHOR_CUES[p.Anchor_Ref];if(cue)return cueSortMap.get(cue)??Infinity;
 return Number(p.Sort_Key);
}
function findPosture(block,priest,sort){
 const now=Number(sort);let best=null,bestAt=-Infinity,bestTie=-Infinity;
 for(const p of DATA.postures){if(!cond(p.Condition))continue;const at=postureActivationSort(p),tie=Number(p.Sort_Key);if(!Number.isFinite(at)&&at!==-Infinity)continue;if(at>now)continue;if(at>bestAt||(at===bestAt&&tie>bestTie)){best=p;bestAt=at;bestTie=tie}}
 if(block?.Block_ID==='AO.SM.B027'&&now===96){
   if(flags.LOW_MASS_PROFILE)return best;
   if(christmasOrAnnunciationIncarnatus())return {...(best||{}),Posture_Event_ID:'AO.RUNTIME.POST.INCARNATUS',New_Posture:'KNEEL',Runtime_Override:true,Notes:'Et incarnatus est … et homo factus est.'};
 }
 return best;
}
const GESTURE_SPECIAL_CUE={'AO.SM.G012':'AO.SM.C0090','AO.SM.G013':'AO.SM.C0096','AO.SM.G017':'AO.SM.C0097','AO.SM.G018':'AO.SM.C0124','AO.SM.G022':'AO.SM.C0174','AO.SM.G023':'AO.SM.C0181','AO.SM.G027':'AO.SM.C0246','AO.SM.G030':'AO.SM.C0273','AO.SM.G031':'AO.SM.C0274'};
const gestureCueBindings=new Map();let gestureBindingsBuilt=false;
function bindGestureCue(cue,g){if(!cue||!g)return;if(!gestureCueBindings.has(cue))gestureCueBindings.set(cue,[]);gestureCueBindings.get(cue).push(g)}
function buildGestureBindings(){
 if(gestureBindingsBuilt)return;gestureBindingsBuilt=true;const groups=new Map();
 DATA.gestures.forEach(g=>{const key=`${g.Parent_Block_ID}::${norm(g.Latin_Anchor)}`;if(!groups.has(key))groups.set(key,[]);groups.get(key).push(g)});
 groups.forEach(gs=>{const b=DATA.blocks.find(x=>x.Block_ID===gs[0].Parent_Block_ID);if(!b)return;const units=b.units||[];const anchor=norm(gs[0].Latin_Anchor);
   const specials=gs.filter(g=>GESTURE_SPECIAL_CUE[g.Gesture_ID]);specials.forEach(g=>bindGestureCue(GESTURE_SPECIAL_CUE[g.Gesture_ID],g));if(specials.length===gs.length)return;
   const normalGs=gs.filter(g=>!GESTURE_SPECIAL_CUE[g.Gesture_ID]);const exact=units.filter(u=>anchor&&norm(u.latin).includes(anchor));
   if(exact.length){if(normalGs.length>1){normalGs.forEach((g,i)=>bindGestureCue(exact[Math.min(i,exact.length-1)]?.cue_id,g))}else{const g=normalGs[0];const repeat=Number(g?.Count)>1&&exact.length>1?exact:[exact[0]];repeat.forEach(u=>bindGestureCue(u?.cue_id,g))}return;}
   const words=anchor.split(' ').filter(Boolean);let best=-1,bestScore=0;units.forEach((u,i)=>{const t=norm(u.latin);for(let n=Math.min(6,words.length);n>=1;n--){if(t.includes(words.slice(0,n).join(' '))){if(n>bestScore){best=i;bestScore=n}break}}});
   if(best>=0){const joined=norm(units.slice(best,best+5).map(u=>u.latin||'').join(' '));if(!anchor||joined.includes(anchor))normalGs.forEach(g=>bindGestureCue(units[best]?.cue_id,g));}
 });
}
function gestureAllowed(g,el){const note=String(g?.Condition_Exception||'').toLowerCase();
 if(g?.Gesture_ID==='AO.SM.G013')return !!flags.CREDO_APPOINTED&&!!flags.LOW_MASS_OCONNELL_PROFILE;
 if(g?.Gesture_ID==='AO.SM.G017')return false;
 if(g?.Gesture_ID==='AO.SM.G024')return !!flags.LAY_CUSTOM_NOBIS_BREAST_STRIKE;
 if(g?.Gesture_ID==='AO.SM.G026')return !!flags.FAITHFUL_COMMUNION;
 if(g?.Gesture_ID==='AO.SM.G027')return false;
 if(['AO.SM.G022','AO.SM.G023'].includes(g?.Gesture_ID))return false;
 if(note.includes('public/audible'))return !['PRIEST_PRIVATE','SILENT'].includes(el.dataset.clock||'');
 if(g?.Gesture_ID==='AO.SM.G018')return !!flags.INCENSE_ENABLED;
 if(note.includes('not at requiem'))return !flags.REQUIEM;
 return true;
}
function findGesture(el){buildGestureBindings();const gs=gestureCueBindings.get(el.dataset.cue)||[];return gs.find(g=>gestureAllowed(g,el))||null}
function gestureUnitForCue(cue){for(const b of DATA.blocks){const u=(b.units||[]).find(x=>x.cue_id===cue);if(u)return {block:b,unit:u}}return null}
function scholaGesturesForCue(cue){
 buildGestureBindings();const hit=gestureUnitForCue(cue);if(!hit||hit.unit.clock!=='SCHOLA_PUBLIC')return [];
 const fake={dataset:{cue,clock:hit.unit.clock}};return (gestureCueBindings.get(cue)||[]).filter(g=>gestureAllowed(g,fake));
}
function gestureOccurrenceLabel(g,cue){
 if(!g)return '—';const total=Number(g.Count)||0;if(total<=1)return g.Faithful_Action||'—';
 buildGestureBindings();const cues=[];for(const [c,gs] of gestureCueBindings){if(gs.some(x=>x.Gesture_ID===g.Gesture_ID))cues.push(c)}cues.sort((a,b)=>(cueSortMap.get(a)||0)-(cueSortMap.get(b)||0));
 const idx=Math.max(0,cues.indexOf(cue));const base=String(g.Faithful_Action||'').replace(/\s*[×x]\s*\d+\s*$/,'').trim();return `${base} · ${idx+1}/${Math.max(total,cues.length)}`;
}
function centreGestureForEl(el){const g=findGesture(el);if(!g)return null;if(mode!=='read'&&(el?.dataset?.clock||'')==='SCHOLA_PUBLIC')return null;return {gesture:g,cue:el.dataset.cue||''}}
function effectiveGestureForEl(el){const centre=centreGestureForEl(el);if(centre)return centre;if(mode!=='read'&&SCHOLA_STREAM.presenting&&SCHOLA_STREAM.currentGesture)return {gesture:SCHOLA_STREAM.currentGesture,cue:SCHOLA_STREAM.currentGestureCue,source:'SCHOLA'};return null}
const GESTURE_MOTION_STATE={activeKey:'',previewKey:'',postureKey:''};
const GESTURE_POSTURE_STATE={incarnatusKneeling:false};
function applyGestureOwnedPosture(g){
 // v2.3: posture state is resolved by findPosture(); gesture motion must never overwrite the posture rail.
 return;
}



function gestureMotionProfile(g){
 const id=String(g?.Gesture_ID||''),a=String(g?.Faithful_Action||'').toLowerCase();
 if(['AO.SM.G006','AO.SM.G014'].includes(id))return {kind:'doxology',label:'SIGN OF CROSS',context:'doxology'};
 if(['AO.SM.G011','AO.SM.G029'].includes(id))return {kind:'gospel',label:'GOSPEL CROSSES',context:'gospel'};
 if(['AO.SM.G003','AO.SM.G025'].includes(id))return {kind:'breast-triple',label:'BREAST STRIKE ×3',context:'penitential'};
 if(['AO.SM.G024','AO.SM.G026'].includes(id))return {kind:'breast-single',label:'BREAST STRIKE',context:'penitential'};
 if(id==='AO.SM.G018')return {kind:'incense',label:'BOW TO INCENSE',context:'incense'};
 if(['AO.SM.G022','AO.SM.G023'].includes(id))return {kind:'elevation',label:'BOW · LOOK UP',context:'elevation'};
 if(id==='AO.SM.G013'){const seated=String($('#postureText')?.textContent||'').toUpperCase()==='SIT'&&!christmasOrAnnunciationIncarnatus();return seated?{kind:'head',label:'HEAD BOW',context:'incarnatus'}:{kind:'genuflect',label:'KNEEL',context:'incarnatus'}}
 if(id==='AO.SM.G030')return {kind:'genuflect',label:'GENUFLECT',context:'incarnatus'};
 if(['AO.SM.G017','AO.SM.G031'].includes(id))return {kind:'rise',label:'RISE',context:'incarnatus'};
 if(['AO.SM.G008','AO.SM.G009','AO.SM.G015','AO.SM.G027'].includes(id))return {kind:'head',label:'HEAD BOW',context:'holy-name'};
 if(a.includes('profound bow'))return {kind:'profound',label:'PROFOUND BOW',context:'reverence'};
 if(a.includes('bow head')||a.includes('bow the head'))return {kind:'head',label:'HEAD BOW',context:'reverence'};
 if(a.includes('sign of the cross')||a.includes('begin the full sign'))return {kind:'cross',label:'SIGN OF CROSS',context:'cross'};
 if(a.includes('bow'))return {kind:'bow',label:'BOW',context:'reverence'};
 return {kind:'generic',label:(String(g?.Faithful_Action||'GESTURE').replace(/\s*[×x]\s*\d+\s*$/,'').toUpperCase().slice(0,24)||'GESTURE'),context:'generic'};
}
function gestureMotionKind(g){return gestureMotionProfile(g).kind}
function gestureShortLabel(g){return gestureMotionProfile(g).label}
function nextScholaGestureHit(){
 if(mode==='read'||!SCHOLA_STREAM.presenting||!SCHOLA_STREAM.segments.length)return null;
 for(let i=SCHOLA_STREAM.index+1;i<=Math.min(SCHOLA_STREAM.segments.length-1,SCHOLA_STREAM.index+1);i++){
   const seg=SCHOLA_STREAM.segments[i];for(const c of (seg?.cues||[])){const gs=scholaGesturesForCue(c);if(gs.length)return {gesture:gs[0],cue:c,source:'SCHOLA_NEXT',segmentIndex:i};}
 }
 return null;
}
function nextGestureHit(el){
 const scholaNext=nextScholaGestureHit();if(scholaNext)return scholaNext;
 const els=flow(),i=els.indexOf(el);if(i<0)return null;
 for(let j=i+1;j<=Math.min(els.length-1,i+1);j++){
   const hit=centreGestureForEl(els[j]);
   if(hit?.gesture)return {...hit,el:els[j]};
 }
 return null;
}
function resetGestureMotionClasses(card){
 if(!card)return;card.classList.remove('gesture-motion-now','gesture-motion-preview','gesture-kind-head','gesture-kind-bow','gesture-kind-profound','gesture-kind-cross','gesture-kind-doxology','gesture-kind-gospel','gesture-kind-breast-single','gesture-kind-breast-triple','gesture-kind-incense','gesture-kind-elevation','gesture-kind-genuflect','gesture-kind-rise','gesture-kind-generic','gesture-context-doxology','gesture-context-holy-name','gesture-context-elevation');
}
function applyGestureMotion(card,g,cue,isPreview=false){
 if(!card||!g)return;
 const profile=gestureMotionProfile(g),kind=profile.kind,key=`${cue||''}:${g.Gesture_ID||g.Faithful_Action||''}:${isPreview?'preview':'now'}`;
 resetGestureMotionClasses(card);card.classList.add(isPreview?'gesture-motion-preview':'gesture-motion-now',`gesture-kind-${kind}`);
 if(profile.context==='doxology')card.classList.add('gesture-context-doxology');
 if(profile.context==='holy-name')card.classList.add('gesture-context-holy-name');
 if(profile.context==='elevation')card.classList.add('gesture-context-elevation');
 if(!window.matchMedia?.('(prefers-reduced-motion: reduce)').matches){
   const stateKey=isPreview?'previewKey':'activeKey';
   if(GESTURE_MOTION_STATE[stateKey]!==key){
     GESTURE_MOTION_STATE[stateKey]=key;void card.offsetWidth;card.classList.add('gesture-motion-fire');
     const ttl=isPreview?1100:(['doxology','incense','elevation'].includes(kind)?2050:1750);
     setTimeout(()=>card.classList.remove('gesture-motion-fire'),ttl);
   }
 }
}
function faithfulGesturePresentation(g,cue){
 if(!g)return {text:'—',key:''};
 if(g.Gesture_ID==='AO.SM.G013'){
   const p=String($('#postureText')?.textContent||'').toUpperCase();
   if(p==='SIT'&&!christmasOrAnnunciationIncarnatus())return {text:'BOW HEAD · ET INCARNATUS',key:'SEM:GESTURE.HEAD_BOW'};
   return {text:'KNEEL · THROUGH ET HOMO FACTUS EST',key:'SEM:POSTURE.KNEEL'};
 }
 if(g.Gesture_ID==='AO.SM.G018')return {text:'WHEN INCENSE REACHES YOU · BOW BEFORE / AFTER',key:'SEM:GESTURE.BOW'};
 if(g.Gesture_ID==='AO.SM.G030')return {text:'GENUFLECT · ET VERBUM CARO FACTUM EST',key:'SEM:GESTURE.GENUFLECT'};
 return {text:gestureOccurrenceLabel(g,cue),key:gestureAssetKey(g)};
}
function renderGestureRail(el){
 const hit=effectiveGestureForEl(el),g=hit?.gesture||null,cue=hit?.cue||'';
 const card=$('#gestureCard'),tag=card?.querySelector('.tag');
 if(g){
   card.classList.remove('off');card.classList.add('hot');card.dataset.gestureMotionManaged='1';
   const label=gestureShortLabel(g);if(tag)tag.textContent=`${label} NOW`;
   const gp=faithfulGesturePresentation(g,cue);$('#gestureText').textContent=gp.text;setIconHtml($('#gestureIcon'),gp.key,'');applyGestureMotion(card,g,cue,false);return g;
 }
 const next=nextGestureHit(el);
 if(next?.gesture){
   card.classList.remove('off','hot');card.dataset.gestureMotionManaged='1';
   const label=gestureShortLabel(next.gesture);if(tag)tag.textContent='NEXT';
   $('#gestureText').textContent=label;const gk=gestureAssetKey(next.gesture);setIconHtml($('#gestureIcon'),gk,'');applyGestureMotion(card,next.gesture,next.cue,true);return null;
 }
 card.classList.add('off');card.classList.remove('hot');delete card.dataset.gestureMotionManaged;resetGestureMotionClasses(card);if(tag)tag.textContent='GESTURE';$('#gestureText').textContent='—';setIconHtml($('#gestureIcon'),'','');return null;
}

function significantPriestAction(priest){
 const raw=String(priest?.Action||'').trim(); if(!raw)return '';
 const a=raw.toLowerCase();
 const has=(...xs)=>xs.some(x=>a.includes(x));
 if(has('elevates the sacred host','elevates the host'))return 'ELEVATES HOST';
 if(has('elevates the chalice'))return 'ELEVATES CHALICE';
 if(has('minor elevation','raises the host and chalice slightly'))return 'MINOR ELEVATION';
 if(has('shows the sacred host'))return 'SHOWS SACRED HOST';
 if(has('administers communion'))return 'GIVES COMMUNION';
 if(has('receives')&&has('host'))return 'RECEIVES HOST';
 if(has('receives')&&has('chalice'))return 'RECEIVES CHALICE';
 if(has('incenses the cross and altar','incenses cross and altar','incenses the oblations'))return 'INCENSES ALTAR';
 if(has('blesses incense','places incense in the thurible'))return 'BLESSES INCENSE';
 if(has('is incensed','celebrant is incensed'))return 'RECEIVES INCENSE';
 if(has('washes the prescribed fingers','ablution / purification'))return 'WASHES / PURIFIES';
 if(has('breaks the sacred host'))return 'BREAKS HOST';
 if(has('places particle in chalice'))return 'PLACES PARTICLE';
 if(has('reads the gradual privately'))return 'READS GRADUAL';
 if(has('reads the alleluia / tract / sequence privately'))return 'READS ALLELUIA';
 if(has('reads the communion antiphon quietly'))return 'READS COMMUNION';
 if(has('goes to the gospel-side missal','goes to the gospel side for the last gospel'))return 'GOES TO GOSPEL SIDE';
 if(has('turns toward the people','turns toward people','faces people for dismissal'))return 'TURNS TO PEOPLE';
 if(has('turns back to the altar','turn back to the altar','completes the turn back'))return 'TURNS TO ALTAR';
 if(has('turns to missal','turns back to the missal'))return 'TURNS TO MISSAL';
 if(has('ascends while praying'))return 'ASCENDS ALTAR';
 if(has('returns from sedilia'))return 'RETURNS TO ALTAR';
 if(has('go to the sedilia','may go to the sedilia'))return 'GOES TO SEDILIA';
 if(has('genuflect'))return 'GENUFLECTS';
 if(has('profound bow','bows profoundly','bows over altar'))return 'PROFOUND BOW';
 if(has('kisses the altar'))return 'KISSES ALTAR';
 if(has('kisses the gospel'))return 'KISSES GOSPEL';
 if(has('signs book','signs altar/book'))return 'SIGNS BOOK';
 if(has('sign of the cross over the people'))return 'BLESSES PEOPLE';
 if(has('sign of the cross')&&has('paten'))return 'SIGNS WITH PATEN';
 if(has('three signs of the cross over'))return 'THREE CROSSES';
 if(has('sign of the cross over the host'))return 'SIGNS HOST';
 if(has('sign of the cross over the chalice'))return 'SIGNS CHALICE';
 if(has('sign of the cross upon himself','signs himself'))return 'SIGNS HIMSELF';
 if(has('strikes his breast','strikes breast'))return 'STRIKES BREAST';
 if(has('holds the paten with the host elevated'))return 'OFFERS HOST';
 if(has('holds the uncovered chalice elevated'))return 'OFFERS CHALICE';
 if(has('reads/chants the epistle','reads/chants the lesson'))return 'READS EPISTLE';
 if(has('proclaims the gospel'))return 'PROCLAIMS GOSPEL';
 if(has('intones credo'))return 'INTONES CREDO';
 if(has('extends and elevates hands for the intonation'))return 'INTONES GLORIA';
 if(has('orate, fratres'))return 'TURNS TO PEOPLE';
 if(has('uncover')&&has('chalice'))return 'UNCOVERS CHALICE';
 return '';
}
const LOW_MASS_ACTION_SURFACE=new Set(['OFFERS HOST','OFFERS CHALICE','WASHES / PURIFIES','ELEVATES HOST','ELEVATES CHALICE','MINOR ELEVATION','BREAKS HOST','PLACES PARTICLE','RECEIVES HOST','RECEIVES CHALICE','SHOWS SACRED HOST','GIVES COMMUNION','BLESSES PEOPLE']);
const significantPriestAction_v28=significantPriestAction;
significantPriestAction=function(priest){const a=significantPriestAction_v28(priest);if(!flags.LOW_MASS_PROFILE)return a;return LOW_MASS_ACTION_SURFACE.has(a)?a:''};
function updateActionRibbon(priest){
 const box=$('#sectionAction'),value=$('#actionDisplay');if(!box||!value)return;
 if(priest?.Runtime_Route_Step){
  const n=priest.Runtime_Route_Step,total=priest.Runtime_Route_Total||priestRouteSteps(priest).length,label=/INCENSATION/.test(priest.Priest_Route_ID||'')?'INCENSATION':'MOVEMENT';
  value.textContent=`${label} · ${n}/${total}`;box.classList.remove('empty');box.classList.add('hot');box.dataset.routeStep='1';const ai=$('#priestActionIcon');if(ai){const rk=/INCENSATION/.test(priest.Priest_Route_ID||'')?'SEM:ACTOR.PRIEST.INCENSING_ALTAR':'SEM:POSITION.PROCESSION_TO_ALTAR';ai.innerHTML=assetImg(rk,'section-icon')}return;
 }
 delete box.dataset.routeStep;const txt=significantPriestAction(priest);value.textContent=txt||'—';box.classList.toggle('empty',!txt);box.classList.toggle('hot',!!txt);const ai=$('#priestActionIcon');if(ai){const k=actionAssetKey(txt);ai.innerHTML=k?assetImg(k,'section-icon'):'';}
}
function syncState(el){
 const block=runtimeBlockById.get(el.dataset.block); if(!block)return; const macro=macroMap[block.Macro_ID]||{}; const sort=Number(el.dataset.sort)||Number(block.Display_Order); const cue=el.dataset.cue;const pre=!!block.RuntimeOverlay;
 const priest=pre?runtimePriestForPreMass(el):runtimePriestForElement(el,sort); const posture=pre?runtimePostureForPreMass(el):findPosture(block,priest,sort); const resp=pre?runtimeResponseForPreMass(el):responseByCue.get(cue); const userResp=pre?!!resp:responseIsForUser(resp);
 const liveCardLabel=mode==='live'?activeCard()?.getAttribute('aria-label'):'';$('#guideCopy').textContent=liveCardLabel||macro.Moment||block.Title;setIconHtml($('#sectionMomentIcon'),macroIconKey(macro),'');
 $('#guideNext').textContent='';
 const p=posture?.New_Posture||'STAND';const pk=postureAssetKey(p);setIconHtml($('#postureIcon'),pk,({STAND:'│',SIT:'┐'}[p]||'│'));$('#postureText').textContent=p;
 $('#responseCard').classList.toggle('off',!userResp);const responseText=userResp?String(resp.Response_Text||'Respond').replace(/^℟\.\s*/,'').slice(0,52):'—';$('#responseText').textContent=responseText;setIconHtml($('#responseIcon'),userResp?responseAssetKey(responseText):'SEM:GESTURE.HANDS_JOINED','℟');
 setIconHtml($('#voiceIcon'),voiceAssetKey(priest),'');updateBellRail(cue);
 if(priest){$('#stationText').textContent=prettyStation(priest.Priest_Station);$('#voiceText').textContent=normalizedPriestVoice(priest);$('#facingText').textContent=(priest.Facing||'—').replaceAll('_',' ').toLowerCase();$('#actionText').textContent=(priest.Action||'—').slice(0,74);updatePriestPositionIcon(priest);updateActionRibbon(priest)}else{updatePriestPositionIcon(null);updateActionRibbon(null)};if(AO.SolemnMassRuntime?.decorateState)AO.SolemnMassRuntime.decorateState(el,priest,block)
 updateSchola(block,el,macro);
 const gesture=pre?null:renderGestureRail(el);if(pre){$('#gestureCard').classList.add('off');$('#gestureCard').classList.remove('hot');$('#gestureText').textContent='—';setIconHtml($('#gestureIcon'),'hands_joined','✦')}
 const enabledBlocks=RUNTIME_BLOCKS.filter(runtimeBlockEnabled);const pos=enabledBlocks.findIndex(b=>b.Block_ID===block.Block_ID);$('#progress').style.width=`${Math.max(0,Math.min(100,(pos/Math.max(1,enabledBlocks.length-1))*100))}%`;
 debug(block,el,priest,posture,gesture,resp);
 try{window.__AO_FUNCTIONAL_MOTION?.(el,block,priest,resp,userResp)}catch(err){console.warn('Functional motion hook:',err)}
}
function properExcerpt(slot,n=125){const f=fixtureMap[slot];return f?(f.Latin_Text||'').replace(/\n/g,' ').slice(0,n)+(f.Latin_Text&&f.Latin_Text.length>n?'…':''):''}
function liveConcurrentPriestTrack(block,el){
 if(mode!=='live')return false;const cue=el?.dataset?.cue||'',sort=Number(el?.dataset?.sort)||Number(block?.Display_Order)||0,p=findPriest(cue,sort);
 return !!p&&priestVoiceIsPrivate(p.Voice)&&!/LISTENS|NO COMPETING/i.test(String(p.Voice||''));
}
function scholaDuplicateOnMainText(block,el){if(mode==='live'&&el?.dataset?.owner==='SCHOLA_PUBLIC')return false;if((el?.dataset?.clock||'')==='SCHOLA_PUBLIC')return true;const properSlots=new Set(['INTROIT','GRADUAL','ALLELUIA_TRACT_SEQUENCE','OFFERTORY','COMMUNION']);if(properSlots.has(block?.Proper_Slot)){const live=norm(el?.dataset?.latin||el?.textContent||''),fixture=norm(fixtureMap[block?.Proper_Slot]?.Latin_Text||'');if(live.length>8&&fixture&&fixture.includes(live))return true}return false}
function scholaLiveState(block,el){const id=block?.Block_ID||'',m=block?.Macro_ID||'',clock=el?.dataset?.clock||'';const silent=()=>({kind:'silent',program:'',label:''});if(flags.LOW_MASS_PROFILE)return silent();const singing=(program,label)=>({kind:'singing',program,label}),status=(program,label)=>({kind:'status',program,label});if(block?.RuntimeOverlay){const hit=scholaCanonicalEventAt(block,el);if(!hit)return silent();const label=hit.adapter?.label||'SCHOLA';return singing(`OVERLAY:${hit.adapter?.event||label}`,label)}if(m==='AO.SM.M01')return singing('INTROIT','INTROIT');if(m==='AO.SM.M02')return mode==='live'?singing('KYRIE','KYRIE'):{kind:'duplicate',program:'KYRIE',label:'KYRIE'};if(m==='AO.SM.M03'){if(clock==='PUBLIC_TEXT')return silent();if(clock==='SCHOLA_PUBLIC')return mode==='live'?singing('GLORIA','GLORIA'):{kind:'duplicate',program:'GLORIA',label:'GLORIA'};if(clock==='PRIEST_PRIVATE')return singing('GLORIA','GLORIA');return silent()}if(['AO.SM.M04','AO.SM.M05'].includes(m))return silent();if(m==='AO.SM.M06')return mode==='live'?singing('GRADUAL_ALLELUIA','GRADUAL · ALLELUIA'):{kind:'duplicate',program:'GRADUAL_ALLELUIA',label:'GRADUAL · ALLELUIA'};if(m==='AO.SM.M07')return id==='AO.SM.B023'?singing('GRADUAL_ALLELUIA','ALLELUIA · GOSPEL PREPARATION'):silent();if(m==='AO.SM.M08')return silent();if(m==='AO.SM.M09'){if(clock==='PUBLIC_TEXT')return silent();if(clock==='SCHOLA_PUBLIC')return mode==='live'?singing('CREDO','CREDO'):{kind:'duplicate',program:'CREDO',label:'CREDO'};if(clock==='PRIEST_PRIVATE')return singing('CREDO','CREDO');return silent()}if(m==='AO.SM.M10'){if(['AO.SM.B028','AO.SM.B029'].includes(id))return silent();if(Number(block.Display_Order)>=30)return singing('OFFERTORY','OFFERTORY');return silent()}if(m==='AO.SM.M11'){if(['AO.SM.B039','AO.SM.B040'].includes(id))return status('OFFERTORY','MUSIC CONTINUES');return silent()}if(m==='AO.SM.M12')return silent();if(m==='AO.SM.M13')return mode==='live'?singing('SANCTUS_BENEDICTUS','SANCTUS · BENEDICTUS'):{kind:'duplicate',program:'SANCTUS_BENEDICTUS',label:'SANCTUS · BENEDICTUS'};if(m==='AO.SM.M14')return singing('SANCTUS_BENEDICTUS','SANCTUS · BENEDICTUS');if(['AO.SM.M15','AO.SM.M16'].includes(m))return silent();if(m==='AO.SM.M17')return flags.SANCTUS_GREGORIAN?silent():singing('SANCTUS_BENEDICTUS','BENEDICTUS');if(['AO.SM.M18','AO.SM.M19'].includes(m))return silent();if(m==='AO.SM.M20')return id==='AO.SM.B067'?singing('AGNUS_DEI','AGNUS DEI'):silent();if(m==='AO.SM.M21')return mode==='live'?singing('AGNUS_DEI','AGNUS DEI'):{kind:'duplicate',program:'AGNUS_DEI',label:'AGNUS DEI'};if(!flags.FAITHFUL_COMMUNION&&['AO.SM.M22','AO.SM.M23'].includes(m))return singing('COMMUNION','COMMUNION');if(['AO.SM.M22','AO.SM.M23','AO.SM.M24'].includes(m))return silent();if(['AO.SM.M25','AO.SM.M26'].includes(m))return singing('COMMUNION','COMMUNION');return silent()}
function scholaCanonicalUnitSegments(blockId,{clocks=null,skipFirst=0}={}){const b=DATA.blocks.find(x=>x.Block_ID===blockId);if(!b)return [];const units=(b.units||[]).filter(u=>u.type==='text'&&(!clocks||clocks.includes(u.clock||''))).slice(skipFirst);return units.map((u,i)=>({id:`${blockId}.U${i+skipFirst}`,latin:String(u.latin||'').trim(),english:String(u.english||'').trim(),cues:u.cue_id?[u.cue_id]:[]})).filter(x=>x.latin)}
function scholaFixtureSegments(slot,prefix=slot){const f=fixtureMap[slot];if(!f)return [];const latin=String(f.Latin_Text||'').replace(/\r/g,'').split(/\n+/).map(x=>x.trim()).filter(Boolean),english=String(f.English_Text||'').replace(/\r/g,'').split(/\n+/).map(x=>x.trim()).filter(Boolean);if(latin.length===english.length)return latin.map((text,i)=>({id:`${prefix}.${i+1}`,latin:text,english:english[i]||'',cues:[]}));return latin.length?[{id:`${prefix}.1`,latin:latin.join(' '),english:english.join(' '),cues:[]}]:[]}
function scholaAdapterSegments(a){if(!a?.source)return [];if(a.source.pairs)return a.source.pairs.map((p,i)=>({id:`${a.event||a.label}.${i+1}`,latin:String(p.latin||'').trim(),english:String(p.english||'').trim(),cues:[]})).filter(x=>x.latin);if(a.source.proper)return scholaFixtureSegments(a.source.proper,a.label||a.source.proper);if(a.source.block){const b=DATA.blocks.find(x=>x.Block_ID===a.source.block);if(!b)return [];let active=!a.source.startCue;const out=[];for(const u of (b.units||[])){if(a.source.startCue&&u.cue_id===a.source.startCue)active=true;if(active&&u.type==='text'&&u.latin)out.push({id:`${b.Block_ID}.${u.cue_id||out.length+1}`,latin:String(u.latin||'').trim(),english:String(u.english||'').trim(),cues:u.cue_id?[u.cue_id]:[]});if(a.source.endCue&&u.cue_id===a.source.endCue)break}return out}return []}
function scholaProgramSegments(program){switch(program){case 'INTROIT':return scholaFixtureSegments('INTROIT','INTROIT');case 'KYRIE':return scholaCanonicalUnitSegments('AO.SM.B015',{clocks:['SCHOLA_PUBLIC']});case 'GLORIA':return scholaCanonicalUnitSegments('AO.SM.B016',{clocks:['SCHOLA_PUBLIC']});case 'GRADUAL_ALLELUIA':{const out=[...scholaFixtureSegments('GRADUAL','GRADUAL'),...scholaFixtureSegments('ALLELUIA_TRACT_SEQUENCE','ALLELUIA')];if(fixtureMap.SEQUENCE)out.push(...scholaFixtureSegments('SEQUENCE','SEQUENCE'));return out}case 'CREDO':return scholaCanonicalUnitSegments('AO.SM.B027',{clocks:['SCHOLA_PUBLIC']});case 'OFFERTORY':return scholaFixtureSegments('OFFERTORY','OFFERTORY');case 'SANCTUS_BENEDICTUS':return scholaCanonicalUnitSegments('AO.SM.B046',{clocks:['SCHOLA_PUBLIC']});case 'AGNUS_DEI':return scholaCanonicalUnitSegments('AO.SM.B068',{clocks:['SCHOLA_PUBLIC']});case 'COMMUNION':return scholaFixtureSegments('COMMUNION','COMMUNION');default:if(program.startsWith('OVERLAY:')){const key=program.slice(8),a=SCHOLA_RUNTIME_ADAPTER.find(x=>String(x.event||x.label)===key);return scholaAdapterSegments(a)}return []}}
function prepareScholaProgram(program){if(!program)return [];if(SCHOLA_STREAM.cache.has(program))return SCHOLA_STREAM.cache.get(program);const segments=scholaProgramSegments(program);SCHOLA_STREAM.cache.set(program,segments);return segments}
function programsForPart(part){const ids=new Set(part?.macros||[]),out=[],add=x=>{if(x&&!out.includes(x))out.push(x)};if(ids.has('AO.SM.M01'))add('INTROIT');if(ids.has('AO.SM.M02'))add('KYRIE');if(ids.has('AO.SM.M03'))add('GLORIA');if(ids.has('AO.SM.M06')||ids.has('AO.SM.M07'))add('GRADUAL_ALLELUIA');if(ids.has('AO.SM.M09'))add('CREDO');if(ids.has('AO.SM.M10')||ids.has('AO.SM.M11'))add('OFFERTORY');if(ids.has('AO.SM.M13')||ids.has('AO.SM.M14')||ids.has('AO.SM.M17'))add('SANCTUS_BENEDICTUS');if(ids.has('AO.SM.M20')||ids.has('AO.SM.M21'))add('AGNUS_DEI');if(ids.has('AO.SM.M25')||ids.has('AO.SM.M26'))add('COMMUNION');for(const a of SCHOLA_RUNTIME_ADAPTER){if(a?.windows?.some(w=>ids.has(w.macro))&&String(a.event||'').startsWith('AO.PRE.'))add(`OVERLAY:${a.event}`)}return out}
function prepareScholaForPart(part){if(!part||SCHOLA_STREAM.preparedParts.has(part.id))return;programsForPart(part).forEach(prepareScholaProgram);SCHOLA_STREAM.preparedParts.add(part.id)}
function stopScholaTicker(reset=false){if(SCHOLA_STREAM.animation){SCHOLA_STREAM.animation.onfinish=null;SCHOLA_STREAM.animation.cancel();SCHOLA_STREAM.animation=null}if(SCHOLA_STREAM.progressRaf){cancelAnimationFrame(SCHOLA_STREAM.progressRaf);SCHOLA_STREAM.progressRaf=0}if(reset){SCHOLA_STREAM.program='';SCHOLA_STREAM.label='';SCHOLA_STREAM.segments=[];SCHOLA_STREAM.index=0;SCHOLA_STREAM.completed=false}}
function updateScholaContext(){const segs=SCHOLA_STREAM.segments,i=SCHOLA_STREAM.index,prev=$('#scholaContextPrev'),cur=$('#scholaContextCurrent'),next=$('#scholaContextNext'),count=$('#scholaPhraseCount');if(prev)prev.textContent=i>0?(segs[i-1]?.latin||''):'';if(cur)cur.textContent=segs[i]?.latin||'';if(next)next.textContent=i<segs.length-1?(segs[i+1]?.latin||''):'';if(count)count.textContent=segs.length?`${i+1}/${segs.length}`:'';const p=$('#scholaPrevPhrase'),n=$('#scholaNextPhrase');if(p)p.disabled=i<=0;if(n)n.disabled=i>=segs.length-1}
function playScholaCinematic(kind='phrase'){const dock=$('#scholaDock');if(!dock||window.matchMedia?.('(prefers-reduced-motion: reduce)').matches)return;const cls=kind==='chant'?'chant-cinematic':'phrase-cinematic';dock.classList.remove(cls);void dock.offsetWidth;dock.classList.add(cls);setTimeout(()=>dock.classList.remove(cls),kind==='chant'?760:460)}
function setScholaSegment(index,{animateIn=true}={}){const line=$('#scholaStreamLine'),counter=$('#scholaPageCounter'),progress=$('#scholaStreamProgress');if(!line||!SCHOLA_STREAM.segments.length)return;const previous=SCHOLA_STREAM.index;SCHOLA_STREAM.index=Math.max(0,Math.min(index,SCHOLA_STREAM.segments.length-1));SCHOLA_STREAM.completed=false;const segment=SCHOLA_STREAM.segments[SCHOLA_STREAM.index];line.textContent=segment?.latin||segment?.english||'';line.dataset.segmentId=segment?.id||'';line.dataset.language='latin';const tr=$('#scholaStreamTranslation');if(tr){tr.textContent=segment?.english||'';tr.dataset.segmentId=segment?.id||''}SCHOLA_STREAM.currentGesture=null;SCHOLA_STREAM.currentGestureCue='';for(const c of (segment?.cues||[])){const gs=scholaGesturesForCue(c);if(gs.length){SCHOLA_STREAM.currentGesture=gs[0];SCHOLA_STREAM.currentGestureCue=c;break}}if(activeEl)renderGestureRail(activeEl);line.classList.remove('enter','exit');if(animateIn){void line.offsetWidth;line.classList.add('enter')}if(counter)counter.textContent=`${SCHOLA_STREAM.index+1} / ${SCHOLA_STREAM.segments.length}`;if(progress)progress.style.width='0%';updateScholaContext();$('#scholaDock')?.classList.remove('stream-held');if(previous!==SCHOLA_STREAM.index||animateIn)playScholaCinematic('phrase');requestAnimationFrame(()=>startScholaTicker(0));requestAnimationFrame(updateScholaSafeArea)}
function startScholaTicker(progressFraction=0){const line=$('#scholaStreamLine'),viewport=$('#scholaStreamViewport'),progress=$('#scholaStreamProgress');if(!line||!viewport||!SCHOLA_STREAM.segments.length||SCHOLA_STREAM.paused||SCHOLA_STREAM.transitionFrozen||SCHOLA_STREAM.completed)return;stopScholaTicker(false);const vw=viewport.clientWidth,lw=line.scrollWidth,travel=Math.max(vw+lw+80,260),baseSpeed=window.innerWidth<760?34:40,baseDuration=Math.max(7000,Math.min(70000,(travel/baseSpeed)*1000));SCHOLA_STREAM.baseDuration=baseDuration;const from=vw+24,to=-(lw+24),start=from+(to-from)*Math.max(0,Math.min(1,progressFraction));SCHOLA_STREAM.animation=line.animate([{transform:`translate3d(${start}px,-50%,0)`},{transform:`translate3d(${to}px,-50%,0)`}],{duration:baseDuration*(1-progressFraction),easing:'linear',fill:'forwards'});SCHOLA_STREAM.animation.playbackRate=SCHOLA_STREAM.speed;SCHOLA_STREAM.animation.onfinish=()=>{SCHOLA_STREAM.animation=null;if(SCHOLA_STREAM.paused||SCHOLA_STREAM.transitionFrozen)return;if(SCHOLA_STREAM.index<SCHOLA_STREAM.segments.length-1)setScholaSegment(SCHOLA_STREAM.index+1,{animateIn:false});else{SCHOLA_STREAM.completed=true;if(progress)progress.style.width='100%';$('#scholaDock')?.classList.add('stream-held');const p=$('#scholaStreamPause');if(p)p.textContent='HOLD'}};const tick=()=>{if(!SCHOLA_STREAM.animation||SCHOLA_STREAM.paused||SCHOLA_STREAM.transitionFrozen)return;const timing=SCHOLA_STREAM.animation.effect?.getComputedTiming?.(),pct=Math.max(0,Math.min(100,Number(timing?.progress||0)*100));if(progress)progress.style.width=`${pct}%`;if(pct<100)SCHOLA_STREAM.progressRaf=requestAnimationFrame(tick)};SCHOLA_STREAM.progressRaf=requestAnimationFrame(tick)}
function ensureScholaProgram(program,label){if(!program)return;const segments=prepareScholaProgram(program);if(!segments.length)return;SCHOLA_STREAM.label=label||program;const dock=$('#scholaDock');if(dock)dock.classList.remove('status-only');if(SCHOLA_STREAM.program===program&&SCHOLA_STREAM.segments.length){updateScholaConsoleUI();return}stopScholaTicker(false);SCHOLA_STREAM.program=program;SCHOLA_STREAM.segments=segments;SCHOLA_STREAM.index=0;SCHOLA_STREAM.completed=false;SCHOLA_STREAM.paused=false;if(dock){dock.classList.remove('stream-held');dock.classList.toggle('translation-open',SCHOLA_STREAM.translationOpen);dock.dataset.view=SCHOLA_STREAM.view}setScholaSegment(0,{animateIn:true});updateScholaConsoleUI();playScholaCinematic('chant')}
function pauseScholaTicker(paused){SCHOLA_STREAM.paused=!!paused;const dock=$('#scholaDock');if(dock)dock.classList.toggle('stream-paused',SCHOLA_STREAM.paused);const p=$('#scholaStreamPause');if(p&&!SCHOLA_STREAM.completed)p.textContent=SCHOLA_STREAM.paused?'PAUSED':'LIVE';if(SCHOLA_STREAM.animation){if(SCHOLA_STREAM.paused)SCHOLA_STREAM.animation.pause();else if(!SCHOLA_STREAM.transitionFrozen)SCHOLA_STREAM.animation.play()}else if(!SCHOLA_STREAM.paused&&!SCHOLA_STREAM.transitionFrozen&&SCHOLA_STREAM.segments.length&&!SCHOLA_STREAM.completed)requestAnimationFrame(()=>startScholaTicker(0));updateScholaSpeedUI()}
function setScholaTransitionFreeze(on){SCHOLA_STREAM.transitionFrozen=!!on;if(SCHOLA_STREAM.animation){if(on)SCHOLA_STREAM.animation.pause();else if(!SCHOLA_STREAM.paused)SCHOLA_STREAM.animation.play()}else if(!on&&!SCHOLA_STREAM.paused&&SCHOLA_STREAM.segments.length&&!SCHOLA_STREAM.completed&&SCHOLA_STREAM.presenting){requestAnimationFrame(()=>startScholaTicker(0))}}
function updateScholaConsoleUI(){const dock=$('#scholaDock'),v=$('#scholaSpeedValue'),range=$('#scholaSpeedRange'),pause=$('#scholaPauseBtn'),lang=$('#scholaTranslationToggle'),view=$('#scholaViewMode');if(v){v.textContent=`${SCHOLA_STREAM.speed.toFixed(2)}×`;v.setAttribute('aria-expanded',dock?.classList.contains('speed-open')?'true':'false')}if(range)range.value=String(SCHOLA_STREAM.speed);$$('#scholaSpeedPanel [data-schola-speed]').forEach(b=>b.classList.toggle('active',Math.abs(Number(b.dataset.scholaSpeed)-SCHOLA_STREAM.speed)<0.001));if(pause){pause.textContent=SCHOLA_STREAM.paused?'RESUME':'PAUSE';pause.classList.toggle('active',SCHOLA_STREAM.paused)}if(lang){lang.setAttribute('aria-pressed',SCHOLA_STREAM.translationOpen?'true':'false');lang.textContent=SCHOLA_STREAM.translationOpen?'EN✓':'EN'}if(dock){dock.dataset.view=SCHOLA_STREAM.view;dock.classList.toggle('translation-open',SCHOLA_STREAM.translationOpen)}if(view)view.textContent=SCHOLA_STREAM.view==='compact'?'CMP':SCHOLA_STREAM.view==='expanded'?'EXP':'STD';updateScholaContext();requestAnimationFrame(updateScholaSafeArea)}
function updateScholaSpeedUI(){updateScholaConsoleUI()}
function setScholaSpeed(value){const next=Math.round(Math.max(SCHOLA_SPEED_MIN,Math.min(SCHOLA_SPEED_MAX,Number(value)||SCHOLA_STREAM.speed))*100)/100;if(next===SCHOLA_STREAM.speed)return;SCHOLA_STREAM.speed=next;safeStorageSet('ao-schola-speed',String(next));if(SCHOLA_STREAM.animation)SCHOLA_STREAM.animation.playbackRate=next;updateScholaConsoleUI()}
function changeScholaSpeed(direction){const s=SCHOLA_STREAM.speed,step=direction<0?(s<=1?0.10:0.25):(s<1?0.10:0.25);setScholaSpeed(s+(direction<0?-step:step))}
function toggleScholaSpeedPanel(){const dock=$('#scholaDock');if(!dock)return;dock.classList.toggle('speed-open');updateScholaConsoleUI()}
function toggleScholaTranslation(){const dock=$('#scholaDock');if(!dock||!SCHOLA_STREAM.segments.length||dock.classList.contains('status-only'))return;SCHOLA_STREAM.translationOpen=!SCHOLA_STREAM.translationOpen;safeStorageSet('ao-schola-translation',SCHOLA_STREAM.translationOpen?'1':'0');updateScholaConsoleUI()}
function cycleScholaView(){const views=['compact','standard','expanded'],i=views.indexOf(SCHOLA_STREAM.view);SCHOLA_STREAM.view=views[(i+1)%views.length];safeStorageSet('ao-schola-view',SCHOLA_STREAM.view);updateScholaConsoleUI()}
function stepScholaPhrase(delta){if(!SCHOLA_STREAM.segments.length)return;const target=Math.max(0,Math.min(SCHOLA_STREAM.segments.length-1,SCHOLA_STREAM.index+delta));if(target===SCHOLA_STREAM.index)return;setScholaSegment(target,{animateIn:true})}
function scholaStageReady(program){return !!program&&SCHOLA_STREAM.program===program&&SCHOLA_STREAM.completed}
function updateScholaSafeArea(){const dock=$('#scholaDock');if(!dock){document.documentElement.style.setProperty('--schola-safe','0px');return}const visible=dock.classList.contains('show')&&mode!=='read'&&!document.body.classList.contains('part-transition'),h=visible?Math.ceil(dock.getBoundingClientRect().height+18):0;document.documentElement.style.setProperty('--schola-safe',`${h}px`)}
function updateSchola(block,el,macro){const state=scholaLiveState(block,el),silent=state.kind==='silent',singing=state.kind==='singing',statusOnly=state.kind==='status';const dock=$('#scholaDock');if(!dock)return;const show=(singing||statusOnly)&&mode!=='read';SCHOLA_STREAM.presenting=show;if(!show){SCHOLA_STREAM.currentGesture=null;SCHOLA_STREAM.currentGestureCue=''}dock.classList.toggle('show',show);dock.classList.toggle('status-only',statusOnly);dock.setAttribute('aria-hidden',show?'false':'true');const title=$('#scholaTitleText'),kind=$('#scholaStreamKind');if(singing){ensureScholaProgram(state.program,state.label);SCHOLA_STREAM.label=state.label;if(title)title.textContent=`SCHOLA · ${state.label}`;if(kind)kind.textContent=SCHOLA_STREAM.completed?'CHANT COMPLETE · HOLDING FINAL SEGMENT':'LATIN';if(!SCHOLA_STREAM.completed)pauseScholaTicker(false)}else if(statusOnly){SCHOLA_STREAM.label=state.label;if(title)title.textContent=`SCHOLA · ${state.label}`;if(kind)kind.textContent='STATUS ONLY · TEXT NOT ASSUMED';if(SCHOLA_STREAM.animation)SCHOLA_STREAM.animation.pause()}else{if(title)title.textContent='SCHOLA';if(kind)kind.textContent=silent?'SILENT':'';if(SCHOLA_STREAM.animation)SCHOLA_STREAM.animation.pause()}requestAnimationFrame(updateScholaSafeArea)}
const scholaResizeObserver=window.ResizeObserver?new ResizeObserver(()=>updateScholaSafeArea()):null;if(scholaResizeObserver)scholaResizeObserver.observe($('#scholaDock'));window.addEventListener('resize',updateScholaSafeArea,{passive:true});
function buildDrawer(){
 $('#drawerIntro').textContent=`${DATA.meta.version} · Ultimate Mass v2.2 · V4.6 semantic assets · reconciled language/Schola runtime · single-owner event surfaces · gesture choreography · Canon + Gospel cinematic arcs · Offertory/Communion/Pater/Canon-hierarchy/Conclusion salience. Canonical Mass graph fingerprint: ${AO.BUILD.canonicalMassSha256.slice(0,12)}…`;
 const stats=[['Blocks',DATA.blocks.length],['Cue events',DATA.priestEvents.length],['Posture',DATA.postures.length],['Gestures',DATA.gestures.length],['Responses',DATA.responses.length],['Low Mass','1962']];$('#stats').innerHTML=stats.map(([k,v])=>`<div class="stat"><b>${v}</b><span>${k}</span></div>`).join('');
 const showFlags=['GLORIA_APPOINTED','CREDO_APPOINTED','INCENSE_ENABLED','SEDILIA_USED','FAITHFUL_COMMUNION','SECOND_CONFITEOR_LOCAL_CUSTOM_ENABLED','SANCTUS_GREGORIAN'];$('#branchGrid').innerHTML=showFlags.map(k=>`<span class="chip ${flags[k]?'on':'off'}">${escapeHtml(k.replaceAll('_',' '))}</span>`).join('');
 const riteSummary=$('#riteContextSummary');if(riteSummary)riteSummary.innerHTML=`<strong>${escapeHtml(RITE_CONTEXT.date)}</strong> · ${RITE_CONTEXT.isSunday?'Sunday':'weekday'} · ${escapeHtml(RITE_CONTEXT.massType)} ${RITE_CONTEXT.principalMass?'· principal Mass':''}<br>Easter ${escapeHtml(RITE_CONTEXT.calendar.easter)} · Pentecost ${escapeHtml(RITE_CONTEXT.calendar.pentecost)} · ${PRE_MASS_VARIANT==='NONE'?'no implemented pre-Mass overlay':escapeHtml(PRE_MASS_VARIANT.replaceAll('_',' '))}`;
 const riteFlags=$('#riteContextFlags');if(riteFlags){const vals=[['Paschaltide',RITE_CONTEXT.paschaltide],['Passion Sunday',RITE_CONTEXT.passionSunday],['Palm Sunday',RITE_CONTEXT.palmSunday],['Candlemas',RITE_CONTEXT.candlemas],['Ash Wednesday',RITE_CONTEXT.ashWednesday],['Nuptial',RITE_CONTEXT.nuptial],['Requiem',RITE_CONTEXT.requiem]];riteFlags.innerHTML=vals.map(([k,v])=>`<span class="rite-flag ${v?'on':''}">${escapeHtml(k)} ${v?'✓':'—'}</span>`).join('')+`<span class="rite-flag mass">${escapeHtml(PRE_MASS_VARIANT.replaceAll('_',' '))}</span>`;}
 const sel=$('#jumpSelect');const jumpMacros=[...ACTIVE_OVERLAYS.map(x=>x.macro).filter(Boolean),...DATA.macros];sel.innerHTML='<option value="">Jump to a Mass moment…</option>'+jumpMacros.map(m=>`<option value="${m.Macro_ID}">${m.Sequence===0?'PRE':String(m.Sequence).padStart(2,'0')} · ${escapeHtml(m.Moment)}</option>`).join('');
}
function debug(block,el,priest,posture,gesture,resp){if($('#debugPanel')){const rows=[['Block',block.Block_ID],['Cue',el.dataset.cue||'synthetic'],['Clock',el.dataset.clock||'—'],['Priest',priest?.Priest_Event_ID||'—'],['Posture',posture?.Posture_Event_ID||'—'],['Gesture',gesture?.Gesture_ID||'—'],['Response',resp?.Response_Event_ID||'—']];$('#debugPanel').innerHTML=rows.map(([a,b])=>`<div class="debug-row"><b>${a}</b><span>${escapeHtml(b)}</span></div>`).join('')}qaContextUpdate()}
function modeCueAnchor(){const cue=activeEl?.dataset?.cue||'',macro=activeEl?.dataset?.macro||cardSpecAt(PARTS[partIndex],cardIndex)?.macros?.[0]||'',sort=Number(activeEl?.dataset?.sort);return {cue,macro,sort:Number.isFinite(sort)?sort:null}}
function scrollCardToCueAnchor(anchor){
 const card=activeCard();if(!card||!anchor)return;const visible=x=>x&&getComputedStyle(x).display!=='none';
 let target=anchor.cue?card.querySelector(`.flow-unit[data-cue="${anchor.cue}"]`):null;if(!visible(target))target=null;
 if(!target){const candidates=Array.from(card.querySelectorAll('.flow-unit')).filter(x=>visible(x)&&(!anchor.macro||x.dataset.macro===anchor.macro));if(candidates.length){if(Number.isFinite(anchor.sort))target=candidates.reduce((best,x)=>Math.abs(Number(x.dataset.sort)-anchor.sort)<Math.abs(Number(best.dataset.sort)-anchor.sort)?x:best,candidates[0]);else target=candidates[0]}}
 if(!target){scrollCardToMacro(anchor.macro);return}
 const cr=card.getBoundingClientRect(),tr=target.getBoundingClientRect(),targetY=cr.top+cr.height*FLUID_FOCUS_RATIO;card.scrollTop=Math.max(0,card.scrollTop+(tr.top+Math.min(tr.height*.5,18)-targetY));activeEl=null;requestAnimationFrame(()=>updateActive(true));
}
