$$('.mode-btn').forEach(b=>b.addEventListener('click',()=>setMode(b.dataset.modeBtn)));
$('#scholaSlower')?.addEventListener('click',()=>changeScholaSpeed(-1));
$('#scholaFaster')?.addEventListener('click',()=>changeScholaSpeed(1));
$('#scholaSpeedValue')?.addEventListener('click',toggleScholaSpeedPanel);
$('#scholaSpeedRange')?.addEventListener('input',e=>setScholaSpeed(e.target.value));
$$('#scholaSpeedPanel [data-schola-speed]').forEach(b=>b.addEventListener('click',()=>setScholaSpeed(b.dataset.scholaSpeed)));
$('#scholaTranslationToggle')?.addEventListener('click',toggleScholaTranslation);
$('#scholaViewMode')?.addEventListener('click',cycleScholaView);
$('#scholaPrevPhrase')?.addEventListener('click',()=>stepScholaPhrase(-1));
$('#scholaNextPhrase')?.addEventListener('click',()=>stepScholaPhrase(1));
$('#scholaPauseBtn')?.addEventListener('click',()=>pauseScholaTicker(!SCHOLA_STREAM.paused));
$('#statusBtn').addEventListener('click',()=>$('#drawer').classList.toggle('open'));
$('#jumpSelect').addEventListener('change',e=>{const m=e.target.value;if(!m)return;goToMacro(m);$('#drawer').classList.remove('open')});
$('#cardPrev').addEventListener('click',()=>navigateCard(-1));$('#cardNext').addEventListener('click',()=>navigateCard(1));
$('#qaLaunch')?.addEventListener('click',()=>qaSetEnabled(!QA.enabled));
$('#qaExit')?.addEventListener('click',()=>qaSetEnabled(false));
$$('.qa-verdict').forEach(b=>b.addEventListener('click',()=>qaMark(b.dataset.verdict)));
$('#qaExportJson')?.addEventListener('click',qaExportJson);$('#qaExportCsv')?.addEventListener('click',qaExportCsv);$('#qaExportTrace')?.addEventListener('click',qaExportTrace);
$('#qaClear')?.addEventListener('click',()=>{if(confirm('Clear all audit marks for this Mass?')){QA.marks=[];qaSave();$('#qaLast').textContent='Audit marks cleared.'}});
$('#qaRunAuto')?.addEventListener('click',runAutoAudit);$('#qaRunFromDock')?.addEventListener('click',runAutoAudit);
window.addEventListener('resize',()=>{if(!raf)raf=requestAnimationFrame(()=>updateActive(true))});
document.addEventListener('keydown',e=>{if(['INPUT','SELECT','TEXTAREA'].includes(document.activeElement?.tagName))return;if(e.key==='1')setMode('read');if(e.key==='2')setMode('simple');if(e.key==='3')setMode('live');if(e.key.toLowerCase()==='t'&&activeEl)toggleTranslation(activeEl);if(e.key==='ArrowRight'){e.preventDefault();navigateCard(1);return}if(e.key==='ArrowLeft'){e.preventDefault();navigateCard(-1);return}if(['ArrowDown','j','J'].includes(e.key)){e.preventDefault();const els=flow();els[Math.min(els.length-1,activeIndex+1)]?.scrollIntoView({behavior:'smooth',block:'center',inline:'nearest'})}if(['ArrowUp','k','K'].includes(e.key)){e.preventDefault();const els=flow();els[Math.max(0,activeIndex-1)]?.scrollIntoView({behavior:'smooth',block:'center',inline:'nearest'})}});


/* ===== AO Ultimate v2.1 selected salience reconciliation ===== */
function clearCommunionPhase(){
  document.body.classList.remove('communion-focus','communion-recollection','communion-priest','communion-preparation','communion-procession','communion-after');
}
function applyCommunionPhase(el){
  clearCommunionPhase();
  const macro=el?.dataset?.macro||'';
  if(!['AO.SM.M22','AO.SM.M23','AO.SM.M24','AO.SM.M25','AO.SM.M26'].includes(macro))return;
  document.body.classList.add('communion-focus');
  if(macro==='AO.SM.M22')document.body.classList.add('communion-recollection');
  else if(macro==='AO.SM.M23')document.body.classList.add('communion-priest');
  else if(macro==='AO.SM.M24')document.body.classList.add('communion-preparation');
  else if(macro==='AO.SM.M25')document.body.classList.add('communion-procession');
  else if(macro==='AO.SM.M26')document.body.classList.add('communion-after');
}
const syncState_v132=syncState;
syncState=function(el){syncState_v132(el);applyCommunionPhase(el)};



/* v1.34 — Pater Noster / Fraction / Pax / Commingling presentation grammar. */
const AO_RITE_TRANSITION={lastKey:''};
const RITE_TRANSITION_CUES=new Map([
  ['AO.SM.C0208',{phase:'pater'}],
  ['AO.SM.C0209',{phase:'pater'}],
  ['AO.SM.C0210',{phase:'pater'}],
  ['AO.SM.C0211',{phase:'embolism'}],
  ['AO.SM.C0212',{phase:'embolism'}],
  ['AO.SM.C0213',{phase:'embolism'}],
  ['AO.SM.C0214',{phase:'embolism'}],
  ['AO.SM.C0215',{phase:'embolism'}],
  ['AO.SM.C0216',{phase:'fraction',actionKey:'fraction'}],
  ['AO.SM.C0217',{phase:'public-reset'}],
  ['AO.SM.C0218',{phase:'public-reset'}],
  ['AO.SM.C0219',{phase:'pax',actionKey:'cross'}],
  ['AO.SM.C0220',{phase:'public-reset'}],
  ['AO.SM.C0221',{phase:'commingling',actionKey:'commingling'}]
]);
function clearRiteTransition(){
  document.body.classList.remove('rite-transition','rite-pater','rite-embolism','rite-fraction','rite-public-reset','rite-pax','rite-commingling');
  const action=$('#sectionAction');if(action)action.classList.remove('rite-fraction-action','rite-pax-action','rite-commingling-action','rite-replay');
  $$('.flow-unit.rite-pax-text').forEach(x=>x.classList.remove('rite-pax-text'));
}
function applyRiteTransition(el){
  const cue=el?.dataset?.cue||'';
  const p=RITE_TRANSITION_CUES.get(cue)||null;
  const prior=AO_RITE_TRANSITION.lastKey;
  clearRiteTransition();
  if(!p){AO_RITE_TRANSITION.lastKey='';return}
  const key=`${cue}|${mode}`;const replay=key!==prior;AO_RITE_TRANSITION.lastKey=key;
  document.body.classList.add('rite-transition',`rite-${p.phase}`);
  const action=$('#sectionAction'),icon=$('#priestActionIcon');
  if(p.phase==='fraction'&&action){
    action.classList.add('rite-fraction-action');
    if(icon&&aoHasIcon('fraction'))icon.innerHTML=assetImg('fraction','section-icon');
  }
  if(p.phase==='pax'){
    const target=document.querySelector(`.mass-card.is-active .flow-unit[data-cue="${cue}"]`)||document.querySelector(`.flow-unit[data-cue="${cue}"]`)||el;
    if(target)target.classList.add('rite-pax-text');
    if(action){action.classList.add('rite-pax-action');if(icon&&aoHasIcon('cross'))icon.innerHTML=assetImg('cross','section-icon')}
  }
  if(p.phase==='commingling'&&action){
    action.classList.add('rite-commingling-action');
    if(icon&&aoHasIcon('commingling'))icon.innerHTML=assetImg('commingling','section-icon');
  }
  if(replay&&action&&(p.phase==='fraction'||p.phase==='pax'||p.phase==='commingling')){
    void action.offsetWidth;action.classList.add('rite-replay');
  }
}
const syncState_v133=syncState;
syncState=function(el){syncState_v133(el);applyRiteTransition(el)};



/* v1.35 — Offertory / incensation salience controller. Presentation only. */
const AO_OFFERTORY={lastKey:''};
const OFFERTORY_CUES=new Map([
  ['AO.SM.C0106',{phase:'public'}],
  ['AO.SM.C0107',{phase:'public'}],
  ['AO.SM.C0108',{phase:'public'}],
  ['AO.SM.C0109',{phase:'public'}],
  ['AO.SM.C0110',{phase:'offering',actionKey:'priest_elevate_host_rich'}],
  ['AO.SM.C0111',{phase:'private'}],
  ['AO.SM.C0112',{phase:'private'}],
  ['AO.SM.C0113',{phase:'private'}],
  ['AO.SM.C0114',{phase:'offering',actionKey:'priest_elevate_chalice_rich'}],
  ['AO.SM.C0115',{phase:'private'}],
  ['AO.SM.C0116',{phase:'private'}],
  ['AO.SM.C0117',{phase:'private'}],
  ['AO.SM.C0118',{phase:'private'}],
  ['AO.SM.C0119',{phase:'private'}],
  ['AO.SM.C0120',{phase:'incense-entry',actionKey:'priest_incense_altar_rich'}],
  ['AO.SM.C0121',{phase:'incense-route',actionKey:'priest_incense_altar_rich'}],
  ['AO.SM.C0122',{phase:'incense-route',actionKey:'priest_incense_altar_rich'}],
  ['AO.SM.C0123',{phase:'incense-route',actionKey:'priest_incense_altar_rich'}],
  ['AO.SM.C0124',{phase:'people-incense',actionKey:'priest_incense_people_rich'}],
  ['AO.SM.C0125',{phase:'lavabo',actionKey:'lavabo'}],
  ['AO.SM.C0126',{phase:'private'}],
  ['AO.SM.C0127',{phase:'private'}],
  ['AO.SM.C0128',{phase:'private'}],
  ['AO.SM.C0129',{phase:'private'}],
  ['AO.SM.C0130',{phase:'orate',actionKey:'priest_turn_people_rich'}],
  ['AO.SM.C0131',{phase:'public'}],
  ['AO.SM.C0132',{phase:'public'}],
  ['AO.SM.C0133',{phase:'secret'}],
  ['AO.SM.C0134',{phase:'secret'}],
  ['AO.SM.C0135',{phase:'public-return'}],
  ['AO.SM.C0136',{phase:'public-return'}]
]);
function clearOffertoryPresentation(){
  document.body.classList.remove('offertory-focus','offertory-public','offertory-chant','offertory-private','offertory-offering','offertory-incense-entry','offertory-incense-route','offertory-people-incense','offertory-lavabo','offertory-orate','offertory-secret','offertory-public-return');
  const action=$('#sectionAction');
  if(action)action.classList.remove('offertory-action','offertory-offering-action','offertory-incense-entry','offertory-incense-route-action','offertory-lavabo-action','offertory-orate-action','offertory-replay');
  $$('.priest-route-unit.offertory-route-active').forEach(x=>x.classList.remove('offertory-route-active'));
  $$('.flow-unit.offertory-public-return').forEach(x=>x.classList.remove('offertory-public-return','offertory-replay'));
}
function offertoryTarget(cue,fallback){
  return document.querySelector(`.mass-card.is-active .flow-unit[data-cue="${cue}"]`)||document.querySelector(`.flow-unit[data-cue="${cue}"]`)||fallback||null;
}
function applyOffertoryPresentation(el){
  const macro=el?.dataset?.macro||'';
  const cue=el?.dataset?.cue||'';
  const prior=AO_OFFERTORY.lastKey;
  clearOffertoryPresentation();
  if(!['AO.SM.M10','AO.SM.M11'].includes(macro)){AO_OFFERTORY.lastKey='';return}
  let p=OFFERTORY_CUES.get(cue)||{phase:macro==='AO.SM.M11'?'secret':'private'};
  if(el?.dataset?.routeId&&Number(el?.dataset?.routeStep||0)>0)p={phase:'incense-route',actionKey:'priest_incense_altar_rich'};
  const routeStep=el?.dataset?.routeStep||'';
  const key=`${cue}|${routeStep}|${p.phase}|${mode}`;
  const replay=key!==prior;AO_OFFERTORY.lastKey=key;
  document.body.classList.add('offertory-focus',`offertory-${p.phase}`);
  const action=$('#sectionAction'),icon=$('#priestActionIcon');
  if(p.phase==='offering'&&action){
    action.classList.add('offertory-action','offertory-offering-action');
    if(icon&&p.actionKey&&aoHasIcon(p.actionKey))icon.innerHTML=assetImg(p.actionKey,'section-icon');
    if(replay){void action.offsetWidth;action.classList.add('offertory-replay')}
  }
  if(p.phase==='incense-entry'&&action){
    action.classList.add('offertory-action','offertory-incense-entry');
    if(icon&&p.actionKey&&aoHasIcon(p.actionKey))icon.innerHTML=assetImg(p.actionKey,'section-icon');
    if(replay){void action.offsetWidth;action.classList.add('offertory-replay')}
  }
  if(p.phase==='incense-route'){
    if(action){action.classList.add('offertory-action','offertory-incense-route-action');if(icon&&aoHasIcon('priest_incense_altar_rich'))icon.innerHTML=assetImg('priest_incense_altar_rich','section-icon')}
    if(el?.classList?.contains('priest-route-unit'))el.classList.add('offertory-route-active');
  }
  if(p.phase==='people-incense'){
    if(action){action.classList.add('offertory-action');if(icon&&aoHasIcon('priest_incense_people_rich'))icon.innerHTML=assetImg('priest_incense_people_rich','section-icon')}
  }
  if(p.phase==='lavabo'&&action){
    action.classList.add('offertory-action','offertory-lavabo-action');
    if(icon&&aoHasIcon('lavabo'))icon.innerHTML=assetImg('lavabo','section-icon');
    if(replay){void action.offsetWidth;action.classList.add('offertory-replay')}
  }
  if(p.phase==='orate'&&action){
    action.classList.add('offertory-action','offertory-orate-action');
    if(icon&&aoHasIcon('priest_turn_people_rich'))icon.innerHTML=assetImg('priest_turn_people_rich','section-icon');
    const target=offertoryTarget(cue,el);if(target){target.classList.add('offertory-public-return');if(replay){void target.offsetWidth;target.classList.add('offertory-replay')}}
    if(replay){void action.offsetWidth;action.classList.add('offertory-replay')}
  }
  if(p.phase==='public-return'){
    const target=offertoryTarget(cue,el);if(target){target.classList.add('offertory-public-return');if(replay){void target.offsetWidth;target.classList.add('offertory-replay')}}
  }
}

/* The people-incensation gesture is conditional on incense physically reaching the user's section.
   Posture already owns STAND/SIT; keep only the unique bow instruction here. */
const renderGestureRail_v134=renderGestureRail;
renderGestureRail=function(el){
  const g=renderGestureRail_v134(el);
  if(g?.Gesture_ID==='AO.SM.G018'){
    const card=$('#gestureCard'),txt=$('#gestureText');
    if(txt)txt.textContent='WHEN INCENSE REACHES YOU · BOW BEFORE / AFTER';
    if(card){card.setAttribute('aria-label','When incense reaches you: bow before and after');card.title='When incense reaches you: bow before and after'}
    setIconHtml($('#gestureIcon'),'bow','✦');
  }
  return g;
};

const syncState_v134=syncState;
syncState=function(el){syncState_v134(el);applyOffertoryPresentation(el)};



/* v1.37 — Preface / Sanctus / Canon-entry presentation controller. */
const AO_PREFACE_ARC={lastKey:'',sanctusToken:''};
function clearPrefaceArc(){
  document.body.classList.remove('preface-arc','preface-dialogue','preface-proclamation','sanctus-parallel','canon-entry','canon-entry-first');
  const line=$('#scholaStreamLine');if(line)line.classList.remove('sanctus-entry-replay');
  $$('.flow-unit.sanctus-entry-text').forEach(x=>x.classList.remove('sanctus-entry-text'));
  $$('.flow-unit.canon-entry-text').forEach(x=>x.classList.remove('canon-entry-text'));
}
function prefaceCueTarget(cue,fallback){
  return document.querySelector(`.mass-card.is-active .flow-unit[data-cue="${cue}"]`)||document.querySelector(`.flow-unit[data-cue="${cue}"]`)||fallback||null;
}
function applyPrefaceArc(el){
  const macro=el?.dataset?.macro||'',cue=el?.dataset?.cue||'';
  clearPrefaceArc();
  /* v1.41: Preface/Sanctus owns M12–M13 only. M14 belongs exclusively to the
     Canon hierarchy, preventing two atmospheric layers from stacking on Te igitur. */
  if(macro!=='AO.SM.M13')AO_PREFACE_ARC.sanctusToken='';
  if(!['AO.SM.M12','AO.SM.M13'].includes(macro)){AO_PREFACE_ARC.lastKey='';return}
  let phase='';
  if(macro==='AO.SM.M12') phase=(cue==='AO.SM.C0144')?'preface-proclamation':'preface-dialogue';
  else phase='sanctus-parallel';
  const key=`${cue}|${phase}|${mode}`,replay=key!==AO_PREFACE_ARC.lastKey;AO_PREFACE_ARC.lastKey=key;
  document.body.classList.add('preface-arc',phase);
  if(phase==='sanctus-parallel'){
    const target=prefaceCueTarget(cue,el);if(cue==='AO.SM.C0145'&&target)target.classList.add('sanctus-entry-text');
    const line=$('#scholaStreamLine');
    if(cue==='AO.SM.C0145'&&line){
      const token=`${cue}|${mode}`;
      if(AO_PREFACE_ARC.sanctusToken!==token){AO_PREFACE_ARC.sanctusToken=token;void line.offsetWidth;line.classList.add('sanctus-entry-replay')}
    }
  }
}
const syncState_v136=syncState;
syncState=function(el){syncState_v136(el);applyPrefaceArc(el)};




/* v1.38 — Canon before the Consecration hierarchy controller. Presentation only. */
const AO_CANON_PRE={lastKey:''};
const CANON_PRE_CUES=new Map([
  ['AO.SM.C0150',{phase:'entry'}],
  ['AO.SM.C0151',{phase:'entry'}],
  ['AO.SM.C0152',{phase:'crosses',actionKey:'cross',motion:'cross3',text:true}],
  ['AO.SM.C0153',{phase:'prayer'}],
  ['AO.SM.C0154',{phase:'memento',actionKey:'priest_centre_hands_rich'}],
  ['AO.SM.C0155',{phase:'memento-pause',memory:true}],
  ['AO.SM.C0156',{phase:'memento',actionKey:'priest_centre_arms_rich'}],
  ['AO.SM.C0157',{phase:'communicantes'}],
  ['AO.SM.C0158',{phase:'communicantes',actionKey:'head_bow',motion:'headbow',text:true}],
  ['AO.SM.C0159',{phase:'communicantes'}],
  ['AO.SM.C0160',{phase:'communicantes'}],
  ['AO.SM.C0161',{phase:'hanc',actionKey:'priest_centre_arms_rich',motion:'hands-over',text:true}],
  ['AO.SM.C0162',{phase:'hanc'}],
  ['AO.SM.C0163',{phase:'quam'}],
  ['AO.SM.C0164',{phase:'quam',actionKey:'cross',motion:'cross3',text:true}],
  ['AO.SM.C0165',{phase:'quam',actionKey:'cross',motion:'cross1'}],
  ['AO.SM.C0166',{phase:'quam',actionKey:'cross',motion:'cross1'}],
  ['AO.SM.C0167',{phase:'quam',actionKey:'head_bow',motion:'headbow-l1'}]
]);
function clearCanonPre(){
  document.body.classList.remove('canon-pre','canon-entry-continuing','canon-entry-first','canon-memento','canon-memento-pause','canon-communicantes','canon-hanc','canon-quam');
  const action=$('#sectionAction');
  if(action)action.classList.remove('canon-action-landmark','canon-cross3','canon-cross1','canon-headbow','canon-hands-over','canon-replay');
  $$('.flow-unit.canon-pre-action-text').forEach(x=>x.classList.remove('canon-pre-action-text'));
  $$('.flow-unit.canon-pre-memory-text').forEach(x=>x.classList.remove('canon-pre-memory-text'));
}
function canonPreTarget(cue,fallback){
  return document.querySelector(`.mass-card.is-active .flow-unit[data-cue="${cue}"]`)||document.querySelector(`.flow-unit[data-cue="${cue}"]`)||fallback||null;
}
function applyCanonPre(el){
  const macro=el?.dataset?.macro||'',cue=el?.dataset?.cue||'';
  const p=CANON_PRE_CUES.get(cue)||null,prior=AO_CANON_PRE.lastKey;
  clearCanonPre();
  if(macro!=='AO.SM.M14'||!p){AO_CANON_PRE.lastKey='';return}
  const key=`${cue}|${p.phase}|${mode}`,replay=key!==prior;AO_CANON_PRE.lastKey=key;
  document.body.classList.add('canon-pre');
  if(p.phase==='entry')document.body.classList.add('canon-entry-continuing');
  if(cue==='AO.SM.C0150'&&replay)document.body.classList.add('canon-entry-first');
  if(p.phase==='memento'||p.phase==='memento-pause')document.body.classList.add('canon-memento');
  if(p.phase==='memento-pause')document.body.classList.add('canon-memento-pause');
  if(p.phase==='communicantes')document.body.classList.add('canon-communicantes');
  if(p.phase==='hanc')document.body.classList.add('canon-hanc');
  if(p.phase==='quam')document.body.classList.add('canon-quam');

  const target=canonPreTarget(cue,el);
  if(p.text&&target)target.classList.add('canon-pre-action-text');
  if(p.memory){
    const memoryTarget=canonPreTarget('AO.SM.C0154',el);if(memoryTarget)memoryTarget.classList.add('canon-pre-memory-text');
  }

  const action=$('#sectionAction'),icon=$('#priestActionIcon');
  if(p.actionKey&&action){
    action.classList.add('canon-action-landmark');
    if(icon&&aoHasIcon(p.actionKey))icon.innerHTML=assetImg(p.actionKey,'section-icon');
    if(p.motion==='cross3')action.classList.add('canon-cross3');
    else if(p.motion==='cross1')action.classList.add('canon-cross1');
    else if(p.motion==='headbow')action.classList.add('canon-headbow');
    else if(p.motion==='hands-over')action.classList.add('canon-hands-over');
    /* headbow-l1 is intentionally visible but unanimated as the Consecration approaches. */
    if(replay&&['cross3','headbow','hands-over'].includes(p.motion)){
      void action.offsetWidth;action.classList.add('canon-replay');
    }
  }
}
const syncState_v137=syncState;
syncState=function(el){syncState_v137(el);applyCanonPre(el)};



/* v1.39 — Canon after the Consecration → Per ipsum hierarchy controller. Presentation only. */
const AO_CANON_POST={lastKey:''};
const CANON_POST_CUES=new Map([
  ['AO.SM.C0182',{phase:'anamnesis'}],
  ['AO.SM.C0183',{phase:'anamnesis'}],
  ['AO.SM.C0184',{phase:'anamnesis',actionKey:'cross',motion:'cross3',text:true}],
  ['AO.SM.C0185',{phase:'anamnesis',actionKey:'cross',motion:'cross-l1'}],
  ['AO.SM.C0186',{phase:'anamnesis'}],
  ['AO.SM.C0187',{phase:'supplices',actionKey:'priest_profound_bow_rich',motion:'profound',text:true}],
  ['AO.SM.C0188',{phase:'supplices'}],
  ['AO.SM.C0189',{phase:'supplices',actionKey:'cross',motion:'cross-l1'}],
  ['AO.SM.C0190',{phase:'supplices',actionKey:'cross',motion:'cross-l1'}],
  ['AO.SM.C0191',{phase:'supplices'}],
  ['AO.SM.C0192',{phase:'dead'}],
  ['AO.SM.C0193',{phase:'dead-pause',memory:true}],
  ['AO.SM.C0194',{phase:'dead'}],
  ['AO.SM.C0195',{phase:'dead'}],
  ['AO.SM.C0196',{phase:'nobis',actionKey:'breast_strike',motion:'breast',text:true}],
  ['AO.SM.C0197',{phase:'nobis'}],
  ['AO.SM.C0198',{phase:'nobis'}],
  ['AO.SM.C0199',{phase:'perquem'}],
  ['AO.SM.C0200',{phase:'perquem',actionKey:'cross',motion:'cross-l1'}],
  ['AO.SM.C0201',{phase:'peripsum'}],
  ['AO.SM.C0202',{phase:'peripsum',actionKey:'cross',motion:'cross-l1',text:true}],
  ['AO.SM.C0203',{phase:'peripsum',actionKey:'cross',motion:'cross-l1',text:true}],
  ['AO.SM.C0204',{phase:'peripsum',motion:'minor-elevation',text:true}],
  ['AO.SM.C0205',{phase:'peripsum'}],
  ['AO.SM.C0206',{phase:'conclusion',text:true}],
  ['AO.SM.C0207',{phase:'conclusion'}]
]);
function clearCanonPost(){
  document.body.classList.remove('canon-post','canon-anamnesis','canon-supplices','canon-dead','canon-dead-pause','canon-nobis','canon-perquem','canon-peripsum','canon-conclusion-public');
  const action=$('#sectionAction');
  if(action)action.classList.remove('canon-post-action','canon-post-cross3','canon-post-cross-l1','canon-post-profound','canon-post-breast','canon-minor-elevation','canon-post-replay');
  $$('.flow-unit.canon-post-action-text').forEach(x=>x.classList.remove('canon-post-action-text'));
  $$('.flow-unit.canon-post-memory-text').forEach(x=>x.classList.remove('canon-post-memory-text'));
  $$('.flow-unit.canon-post-nobis-text').forEach(x=>x.classList.remove('canon-post-nobis-text'));
  $$('.flow-unit.canon-post-doxology-text').forEach(x=>x.classList.remove('canon-post-doxology-text'));
  $$('.flow-unit.canon-conclusion-text').forEach(x=>x.classList.remove('canon-conclusion-text'));
}
function canonPostTarget(cue,fallback){
  return document.querySelector(`.mass-card.is-active .flow-unit[data-cue="${cue}"]`)||document.querySelector(`.flow-unit[data-cue="${cue}"]`)||fallback||null;
}
function applyCanonPost(el){
  const macro=el?.dataset?.macro||'',cue=el?.dataset?.cue||'';
  const p=CANON_POST_CUES.get(cue)||null,prior=AO_CANON_POST.lastKey;
  clearCanonPost();
  if(!p||!['AO.SM.M17','AO.SM.M18'].includes(macro)){AO_CANON_POST.lastKey='';return}
  const key=`${cue}|${p.phase}|${mode}`,replay=key!==prior;AO_CANON_POST.lastKey=key;

  if(p.phase==='conclusion'){
    document.body.classList.add('canon-conclusion-public');
    const target=canonPostTarget(cue,el);if(p.text&&target)target.classList.add('canon-conclusion-text');
    return;
  }

  document.body.classList.add('canon-post');
  if(p.phase==='anamnesis')document.body.classList.add('canon-anamnesis');
  if(p.phase==='supplices')document.body.classList.add('canon-supplices');
  if(p.phase==='dead'||p.phase==='dead-pause')document.body.classList.add('canon-dead');
  if(p.phase==='dead-pause')document.body.classList.add('canon-dead-pause');
  if(p.phase==='nobis')document.body.classList.add('canon-nobis');
  if(p.phase==='perquem')document.body.classList.add('canon-perquem');
  if(p.phase==='peripsum')document.body.classList.add('canon-peripsum');

  const target=canonPostTarget(cue,el);
  if(p.text&&target){
    target.classList.add('canon-post-action-text');
    if(p.phase==='nobis')target.classList.add('canon-post-nobis-text');
    if(p.phase==='peripsum')target.classList.add('canon-post-doxology-text');
  }
  if(p.memory){
    const memoryTarget=canonPostTarget('AO.SM.C0192',el);if(memoryTarget)memoryTarget.classList.add('canon-post-memory-text');
  }

  const action=$('#sectionAction'),icon=$('#priestActionIcon');
  if(action&&(p.actionKey||p.motion==='minor-elevation')){
    action.classList.add('canon-post-action');
    if(p.actionKey&&icon&&aoHasIcon(p.actionKey))icon.innerHTML=assetImg(p.actionKey,'section-icon');
    if(p.motion==='cross3')action.classList.add('canon-post-cross3');
    else if(p.motion==='cross-l1')action.classList.add('canon-post-cross-l1');
    else if(p.motion==='profound')action.classList.add('canon-post-profound');
    else if(p.motion==='breast')action.classList.add('canon-post-breast');
    else if(p.motion==='minor-elevation')action.classList.add('canon-minor-elevation');
    if(replay&&['cross3','profound','breast','minor-elevation'].includes(p.motion)){
      void action.offsetWidth;action.classList.add('canon-post-replay');
    }
  }
}
const syncState_v138=syncState;
syncState=function(el){syncState_v138(el);applyCanonPost(el)};



/* v1.40 — Concluding rites → Blessing → Last Gospel hierarchy controller.
   Presentation only; canonical Mass payload and event bindings remain untouched. */
const AO_CONCLUSION={lastKey:''};
const CONCLUSION_CUES=new Map([
  ['AO.SM.C0251',{phase:'postcommunion',text:true}],
  ['AO.SM.C0252',{phase:'postcommunion'}],
  ['AO.SM.C0253',{phase:'postcommunion',text:true}],
  ['AO.SM.C0254',{phase:'postcommunion',text:true}],
  ['AO.SM.C0255',{phase:'postcommunion'}],
  ['AO.SM.C0256',{phase:'postcommunion'}],
  ['AO.SM.C0257',{phase:'dismissal',text:true}],
  ['AO.SM.C0258',{phase:'dismissal'}],
  ['AO.SM.C0259',{phase:'dismissal',text:true,dismissal:true}],
  ['AO.SM.C0260',{phase:'dismissal'}],
  ['AO.SM.C0261',{phase:'placeat',text:true}],
  ['AO.SM.C0262',{phase:'placeat'}],
  ['AO.SM.C0263',{phase:'blessing'}],
  ['AO.SM.C0264',{phase:'blessing',text:true,gesture:'blessing'}],
  ['AO.SM.C0265',{phase:'blessing',text:true,actionKey:'priest_blessing_rich',motion:'priest-blessing'}],
  ['AO.SM.C0266',{phase:'blessing'}],
  ['AO.SM.C0267',{phase:'lastgospel'}],
  ['AO.SM.C0268',{phase:'lastgospel'}],
  ['AO.SM.C0269',{phase:'lastgospel',text:true,gesture:'gospel-crosses'}],
  ['AO.SM.C0270',{phase:'lastgospel'}],
  ['AO.SM.C0271',{phase:'lastgospel-reading',text:true}],
  ['AO.SM.C0272',{phase:'lastgospel-reading',text:true}],
  ['AO.SM.C0273',{phase:'incarnation',text:true,gesture:'genuflect'}],
  ['AO.SM.C0274',{phase:'lastgospel-reading',text:true,gesture:'rise'}],
  ['AO.SM.C0275',{phase:'complete',text:true}]
]);
function clearConclusionArc(){
  document.body.classList.remove('conclusion-arc','conclusion-postcommunion','conclusion-dismissal','conclusion-placeat','conclusion-blessing','conclusion-lastgospel','conclusion-lastgospel-reading','conclusion-incarnation','conclusion-complete');
  const action=$('#sectionAction'),gesture=$('#gestureCard');
  if(action)action.classList.remove('conclusion-priest-blessing','conclusion-replay');
  if(gesture)gesture.classList.remove('conclusion-blessing-gesture','conclusion-gospel-crosses','conclusion-genuflect','conclusion-rise','conclusion-replay');
  $$('.flow-unit.conclusion-public-text').forEach(x=>x.classList.remove('conclusion-public-text'));
  $$('.flow-unit.conclusion-dismissal-text').forEach(x=>x.classList.remove('conclusion-dismissal-text'));
  $$('.flow-unit.conclusion-placeat-text').forEach(x=>x.classList.remove('conclusion-placeat-text'));
  $$('.flow-unit.conclusion-blessing-text').forEach(x=>x.classList.remove('conclusion-blessing-text'));
  $$('.flow-unit.conclusion-gospel-text').forEach(x=>x.classList.remove('conclusion-gospel-text'));
  $$('.flow-unit.conclusion-incarnation-text').forEach(x=>x.classList.remove('conclusion-incarnation-text'));
  $$('.flow-unit.conclusion-final-text').forEach(x=>x.classList.remove('conclusion-final-text'));
}
function conclusionTarget(cue,fallback){
  return document.querySelector(`.mass-card.is-active .flow-unit[data-cue="${cue}"]`)||document.querySelector(`.flow-unit[data-cue="${cue}"]`)||fallback||null;
}
function applyConclusionArc(el){
  const macro=el?.dataset?.macro||'',cue=el?.dataset?.cue||'';
  const p=CONCLUSION_CUES.get(cue)||null,prior=AO_CONCLUSION.lastKey;
  clearConclusionArc();
  if(!p||!['AO.SM.M27','AO.SM.M28','AO.SM.M29','AO.SM.M30'].includes(macro)){AO_CONCLUSION.lastKey='';return}
  const key=`${cue}|${p.phase}|${mode}`,replay=key!==prior;AO_CONCLUSION.lastKey=key;
  document.body.classList.add('conclusion-arc');

  if(p.phase==='postcommunion')document.body.classList.add('conclusion-postcommunion');
  if(p.phase==='dismissal')document.body.classList.add('conclusion-dismissal');
  if(p.phase==='placeat')document.body.classList.add('conclusion-placeat');
  if(p.phase==='blessing')document.body.classList.add('conclusion-blessing');
  if(['lastgospel','lastgospel-reading','incarnation','complete'].includes(p.phase))document.body.classList.add('conclusion-lastgospel');
  if(p.phase==='lastgospel-reading')document.body.classList.add('conclusion-lastgospel-reading');
  if(p.phase==='incarnation')document.body.classList.add('conclusion-incarnation');
  if(p.phase==='complete')document.body.classList.add('conclusion-complete');

  const target=conclusionTarget(cue,el);
  if(target&&p.text){
    if(p.phase==='postcommunion'||p.phase==='dismissal')target.classList.add('conclusion-public-text');
    if(p.dismissal)target.classList.add('conclusion-dismissal-text');
    if(p.phase==='placeat')target.classList.add('conclusion-placeat-text');
    if(p.phase==='blessing')target.classList.add('conclusion-blessing-text');
    if(p.phase==='lastgospel'||p.phase==='lastgospel-reading')target.classList.add('conclusion-gospel-text');
    if(p.phase==='incarnation')target.classList.add('conclusion-incarnation-text');
    if(p.phase==='complete')target.classList.add('conclusion-final-text');
  }

  const gesture=$('#gestureCard');
  if(gesture&&p.gesture){
    if(p.gesture==='blessing')gesture.classList.add('conclusion-blessing-gesture');
    if(p.gesture==='gospel-crosses')gesture.classList.add('conclusion-gospel-crosses');
    if(p.gesture==='genuflect')gesture.classList.add('conclusion-genuflect');
    if(p.gesture==='rise')gesture.classList.add('conclusion-rise');
    if(replay&&p.gesture!=='rise'){void gesture.offsetWidth;gesture.classList.add('conclusion-replay')}
  }

  const action=$('#sectionAction'),icon=$('#priestActionIcon');
  if(action&&p.motion==='priest-blessing'){
    action.classList.add('conclusion-priest-blessing');
    if(icon&&p.actionKey&&aoHasIcon(p.actionKey))icon.innerHTML=assetImg(p.actionKey,'section-icon');
    if(replay){void action.offsetWidth;action.classList.add('conclusion-replay')}
  }
}
const syncState_v139=syncState;
syncState=function(el){syncState_v139(el);applyConclusionArc(el)};





/* AO Ultimate v2.1 — salience/state integrity governor.
   Keeps the clean v2.0 ownership model: bells remain events, response anticipation remains allowed,
   and canonical SCHOLA_PUBLIC gestures fall back to the centre only when Schola is not presenting. */
function resetUltimateSalienceReplayTokens(){
  if(typeof AO_RITE_TRANSITION!=='undefined')AO_RITE_TRANSITION.lastKey='';
  if(typeof AO_OFFERTORY!=='undefined')AO_OFFERTORY.lastKey='';
  if(typeof AO_PREFACE_ARC!=='undefined'){AO_PREFACE_ARC.lastKey='';AO_PREFACE_ARC.sanctusToken='';}
  if(typeof AO_CANON_PRE!=='undefined')AO_CANON_PRE.lastKey='';
  if(typeof AO_CANON_POST!=='undefined')AO_CANON_POST.lastKey='';
  if(typeof AO_CONCLUSION!=='undefined')AO_CONCLUSION.lastKey='';
  GESTURE_MOTION_STATE.activeKey='';GESTURE_MOTION_STATE.previewKey='';
}
const effectiveGestureForEl_v21=effectiveGestureForEl;
effectiveGestureForEl=function(el){
  const hit=effectiveGestureForEl_v21(el);if(hit)return hit;
  if(mode!=='read'&&el?.dataset?.clock==='SCHOLA_PUBLIC'&&!SCHOLA_STREAM.presenting){
    const g=findGesture(el);if(g)return {gesture:g,cue:el.dataset.cue||'',source:'CENTRE'};
  }
  return null;
};
const syncState_v21_integrity=syncState;
syncState=function(el){
  syncState_v21_integrity(el);
  if(!el)return;
  const cue=el.dataset?.cue||'';
  const block=runtimeBlockById.get(el.dataset?.block||'');
  if(block?.RuntimeOverlay){
    GESTURE_MOTION_STATE.activeKey='';GESTURE_MOTION_STATE.previewKey='';
    const g=$('#gestureCard');if(g){g.classList.remove('gesture-motion-fire','gesture-motion-now','gesture-motion-preview');}
  }
  const response=$('#responseCard');if(response)response.dataset.ownerCue=response.classList.contains('off')?'':cue;
  const gesture=$('#gestureCard');if(gesture)gesture.dataset.ownerCue=gesture.classList.contains('off')?'':(effectiveGestureForEl(el)?.cue||cue);
  const voice=$('#voiceCard');if(voice)voice.dataset.ownerCue=cue;
  const posture=$('#postureCard');if(posture)posture.dataset.ownerCue=cue;
  const position=$('#priestPositionIcon');if(position)position.dataset.ownerCue=cue;
};
AO.Salience=Object.freeze({
  version:'2.1',
  modules:Object.freeze(['Communion','PaterFractionPax','OffertoryIncensation','PrefaceSanctus','CanonPre','CanonPostPerIpsum','ConclusionLastGospel']),
  prayerTextMotion:false,
  stateIntegrity:true
});

/* ===== end v2.1 salience reconciliation ===== */

qaLoad(); render(); setMode(mode); updateScholaSpeedUI(); setTimeout(runAutoAudit,180);
})();
