 {event:'AO.SM.SCH010',label:'OFFERTORY',windows:[{macro:'AO.SM.M10',startBlock:'AO.SM.B030'},{macro:'AO.SM.M11',endBlock:'AO.SM.B040'}],source:{proper:'OFFERTORY'}},
 {event:'AO.SM.SCH011',label:'SANCTUS / BENEDICTUS',when:()=>!!flags.SANCTUS_GREGORIAN,windows:[{macro:'AO.SM.M13'},{macro:'AO.SM.M14'}],source:{block:'AO.SM.B046'}},
 // Non-Gregorian discipline: Sanctus before Consecration, Benedictus resumes afterwards.
 {event:'AO.SM.SCH012',label:'SANCTUS',phase:'sanctus',when:()=>!flags.SANCTUS_GREGORIAN,windows:[{macro:'AO.SM.M13'}],source:{block:'AO.SM.B046',endCue:'AO.SM.C0147'}},
 {event:'AO.SM.SCH012',label:'BENEDICTUS',phase:'benedictus',when:()=>!flags.SANCTUS_GREGORIAN,windows:[{macro:'AO.SM.M17'}],source:{block:'AO.SM.B046',startCue:'AO.SM.C0148'}},
 {event:'AO.SM.SCH013',label:'AGNUS DEI',windows:[{macro:'AO.SM.M20',startBlock:'AO.SM.B067'},{macro:'AO.SM.M21'}],source:{block:'AO.SM.B068'}},
 {event:'AO.SM.SCH014',label:'COMMUNION',when:()=>!flags.FAITHFUL_COMMUNION,windows:[{macro:'AO.SM.M23'},{macro:'AO.SM.M26',endBlock:'AO.SM.B085'}],source:{proper:'COMMUNION'}},
 {event:'AO.SM.SCH015',label:'COMMUNION',when:()=>!!flags.FAITHFUL_COMMUNION,windows:[{macro:'AO.SM.M25'},{macro:'AO.SM.M26',endBlock:'AO.SM.B085'}],source:{proper:'COMMUNION'}},
 {event:'AO.SM.SCH016',label:'DISMISSAL RESPONSE',windows:[{macro:'AO.SM.M28',startCue:'AO.SM.C0260',endCue:'AO.SM.C0260'}],source:{block:'AO.SM.B090',startCue:'AO.SM.C0260',endCue:'AO.SM.C0260'}}
];
function adapterEnabled(a){return !a.when||!!a.when()}
function runtimePoint(block,el){return {macro:block?.Macro_ID||'',block:block?.Block_ID||'',order:Number(block?.Display_Order)||0,cue:el?.dataset?.cue||'',sort:Number(el?.dataset?.sort)||0}}
function windowMatches(w,block,el){
 const p=runtimePoint(block,el);if(w.macro&&p.macro!==w.macro)return false;if(w.block&&p.block!==w.block)return false;
 if(w.startBlock&&p.order<(blockOrderMap.get(w.startBlock)??-Infinity))return false;if(w.endBlock&&p.order>(blockOrderMap.get(w.endBlock)??Infinity))return false;
 if(w.startCue&&p.sort<(cueSortMap.get(w.startCue)??-Infinity))return false;if(w.endCue&&p.sort>(cueSortMap.get(w.endCue)??Infinity))return false;
 return true;
}
function scholaAdaptersAt(block,el){return SCHOLA_RUNTIME_ADAPTER.filter(a=>adapterEnabled(a)&&a.windows.some(w=>windowMatches(w,block,el)))}
function scholaCanonicalEventAt(block,el){const a=scholaAdaptersAt(block,el)[0]||null;return a?{adapter:a,event:scholaEventById.get(a.event)||null}:null}
function handoffForMacro(id){return handoffByMacro.get(id)||null}
function priestVoiceIsPrivate(v){return /SECRET|QUIET|PRIVATE|LOW|INTERNAL|SEMI-AUDIBLE/i.test(String(v||''))&&!/SUNG\s*\/\s*CLEAR|SUNG\s*\/\s*PUBLIC|AUDIBLE|CLEAR SPOKEN/i.test(String(v||''))}
function priestVoiceIsPublic(v){return /SUNG|PUBLIC|AUDIBLE|CLEAR/i.test(String(v||''))&&!/QUIET|SECRET|PRIVATE|LISTENS|SILENT|NO COMPETING/i.test(String(v||''))}
function macroHasPrivateParallel(id){return SCHOLA_RUNTIME_ADAPTER.some(a=>adapterEnabled(a)&&a.windows.some(w=>w.macro===id))&&DATA.priestEvents.some(p=>p.Macro_ID===id&&priestVoiceIsPrivate(p.Voice))}

