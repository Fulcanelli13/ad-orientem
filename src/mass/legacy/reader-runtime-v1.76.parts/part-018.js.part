 // Celebrant intones the complete opening; choir begins with Et in terra pax.
 {event:'AO.SM.SCH004',label:'GLORIA',windows:[{macro:'AO.SM.M03',startCue:'AO.SM.C0055'}],source:{block:'AO.SM.B016',startCue:'AO.SM.C0055'}},
 {event:'AO.SM.SCH005',label:'GRADUAL',windows:[{macro:'AO.SM.M06',block:'AO.SM.B021'}],source:{proper:'GRADUAL'}},
 {event:'AO.SM.SCH006',label:'ALLELUIA',when:()=>isAlleluiaFixture(),windows:[{macro:'AO.SM.M06',block:'AO.SM.B022'}],source:{proper:'ALLELUIA_TRACT_SEQUENCE'}},
 {event:'AO.SM.SCH007',label:'TRACT',when:()=>!isAlleluiaFixture(),windows:[{macro:'AO.SM.M06',block:'AO.SM.B022'}],source:{proper:'ALLELUIA_TRACT_SEQUENCE'}},
 {event:'AO.SM.SCH008',label:'SEQUENCE',when:()=>hasSequenceFixture(),windows:[{macro:'AO.SM.M06',block:'AO.SM.B022'}],source:{proper:'SEQUENCE'}},
 // Celebrant intones Credo in unum Deum; choir begins Patrem omnipotentem.
