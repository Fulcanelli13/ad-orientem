:"Incenses remaining front part from centre to Epistle side.","pattern":"3 single swings","anchor":""},{"step":12,"before":"ALTAR_EPISTLE_SIDE","after":"ALTAR_EPISTLE_SIDE","facing":"MINISTER","action":"Returns thurible; celebrant is incensed by server/minister in sung Mass.","pattern":"—","anchor":""}],"OFFERTORY_OBLATIONS_INCENSATION":[{"step":1,"before":"ALTAR_CENTER","after":"ALTAR_CENTER","facing":"OBLATIONS","action":"Incenses Host and Chalice together in sign-of-cross pattern.","pattern":"3 swings","anchor":"Incensum istud / a te benedictum / ascendat ad te, Domine"},{"step":2,"before":"ALTAR_CENTER","after":"ALTAR_CENTER","facing":"OBLATIONS","action":"Incenses around Host and Chalice.","pattern":"2 circular swings right-to-left","anchor":"et descendat super nos / misericordia tua"},{"step":3,"before":"ALTAR_CENTER","after":"ALTAR_CENTER","facing":"OBLATIONS","action":"Completes circular incensation.","pattern":"1 circular swing left-to-right","anchor":"misericordia tua"}],"OFFERTORY_ALTAR_INCENSATION":[{"step":1,"before":"ALTAR_CENTER","after":"ALTAR_CENTER","facing":"CROSS","action":"Makes profound reverence to Cross; incenses Cross.","pattern":"3 double swings","anchor":"Dirigátur, Dómine... (continuous during route)"},{"step":2,"before":"ALTAR_CENTER","after":"ALTAR_EPISTLE_SIDE","facing":"ALTAR","action":"Incenses inner/table surface from centre toward Epistle side, advancing.","pattern":"3 single swings","anchor":"Dirigátur, Dómine... (continuous during route)"},{"step":3,"before":"ALTAR_EPISTLE_SIDE","after":"ALTAR_EPISTLE_SIDE","facing":"ALTAR","action":"Incenses lower then upper part of Epistle end.","pattern":"2 single swings","anchor":"Dirigátur, Dómine... (continuous during route)"},{"step":4,"before":"ALTAR_EPISTLE_SIDE","after":"ALTAR_CENTER","facing":"ALTAR","action":"Incenses anterior/table surface from Epistle corner toward centre, advancing.","pattern":"3 single swings","anchor":"Dirigátur, Dómine... (continuous during route)"},{"step":5,"before":"ALTAR_CENTER","after":"ALTAR_CENTER","facing":"CROSS","action":"Reverences Cross.","pattern":"—","anchor":"Dirigátur, Dómine... (continuous during route)"},{"step":6,"before":"ALTAR_CENTER","after":"ALTAR_GOSPEL_SIDE","facing":"ALTAR","action":"Incenses inner/table surface from centre toward Gospel side, advancing.","pattern":"3 single swings","anchor":"Dirigátur, Dómine... (continuous during route)"},{"step":7,"before":"ALTAR_GOSPEL_SIDE","after":"ALTAR_GOSPEL_SIDE","facing":"ALTAR","action":"Incenses lower then upper part of Gospel end.","pattern":"2 single swings","anchor":"Dirigátur, Dómine... (continuous during route)"},{"step":8,"before":"ALTAR_GOSPEL_SIDE","after":"ALTAR_GOSPEL_SIDE","facing":"ALTAR","action":"Standing at Gospel corner, incenses upper/anterior altar surface toward centre.","pattern":"3 single swings","anchor":"Dirigátur, Dómine... (continuous during route)"},{"step":9,"before":"ALTAR_GOSPEL_SIDE","after":"ALTAR_CENTER","facing":"ALTAR","action":"With hand lowered, incenses front part from Gospel side to centre while advancing.","pattern":"3 single swings","anchor":"Dirigátur, Dómine... (continuous during route)"},{"step":10,"before":"ALTAR_CENTER","after":"ALTAR_CENTER","facing":"CROSS","action":"Reverences Cross.","pattern":"—","anchor":"Dirigátur, Dómine... (continuous during route)"},{"step":11,"before":"ALTAR_CENTER","after":"ALTAR_EPISTLE_SIDE","facing":"ALTAR","action":"Incenses remaining front part from centre to Epistle side.","pattern":"3 single swings","anchor":"Dirigátur, Dómine... (continuous during route)"},{"step":12,"before":"ALTAR_EPISTLE_SIDE","after":"ALTAR_EPISTLE_SIDE","facing":"MINISTER","action":"Returns thurible while saying Accendat; celebrant is then incensed by minister.","pattern":"—","anchor":"Accéndat in nobis Dóminus..."}],"MOVE_CENTER_TO_GOSPEL_MISSAL":[{"step":1,"before":"ALTAR_CENTER","after":"ALTAR_GOSPEL_MISSAL","facing":"ALTAR / MISSAL","action":"Moves from centre to Gospel-side Missal for proclamation.","pattern":"—","anchor":""}],"MOVE_EPISTLE_TO_CENTER":[{"step":1,"before":"ALTAR_EPISTLE_MISSAL","after":"ALTAR_CENTER","facing":"ALTAR","action":"Moves from Epistle-side Missal to centre.","pattern":"—","anchor":""}],"MOVE_CENTER_TO_EPISTLE_MISSAL":[{"step":1,"before":"ALTAR_CENTER","after":"ALTAR_EPISTLE_MISSAL","facing":"MISSAL","action":"Moves from centre to Epistle-side Missal.","pattern":"—","anchor":""}]};
function runtimePriestEvent(p){
 if(!p)return p;
 const o=PRIEST_RUNTIME_OVERRIDES.get(p.Source_Cue_ID);
 return o?Object.assign({},p,o,{Runtime_Spatial_Override:'YES'}):p;
}
function priestRouteSteps(priest){
 const id=priest?.Priest_Route_ID||'';
 return id&&PRIEST_ROUTE_RUNTIME[id]?PRIEST_ROUTE_RUNTIME[id]:[];
}

const priestRouteEventByCue=new Map(DATA.priestEvents.filter(p=>p.Source_Cue_ID&&p.Priest_Route_ID).map(p=>[p.Source_Cue_ID,p]));
function routeStepsForCue(cue){
 const p=priestRouteEventByCue.get(cue);if(!p)return [];const steps=priestRouteSteps(p);return steps.length>1?steps:[];
}
function routeStepRuntimePriest(base,routeId,stepIndex){
 const steps=PRIEST_ROUTE_RUNTIME[routeId]||[],i=Math.max(0,Math.min(steps.length-1,Number(stepIndex)||0)),step=steps[i];if(!base||!step)return base;
 return Object.assign({},base,{Priest_Station:step.after||base.Priest_Station,Facing:step.facing||base.Facing,Action:step.action||base.Action,Runtime_Route_Step:i+1,Runtime_Route_Total:steps.length,Runtime_Route_Pattern:step.pattern||'',Runtime_Route_Before:step.before||'',Runtime_Route_After:step.after||'',Runtime_Route_Anchor:step.anchor||''});
}
function runtimePriestForElement(el,sort){
 if(flags.LOW_MASS_PROFILE&&el?.dataset?.block==='AO.SM.B096')return {Priest_Event_ID:'AO.LM.RUNTIME.SERMON',Source_Cue_ID:'AO.SM.B096.SYN',Macro_ID:'AO.SM.M08',Parent_Block_ID:'AO.SM.B096',Trigger_Domain:'GUIDE',Trigger_Text:'Sermon / Homily',Anchor_Relation:'AT_SYNTHETIC_CUE',Anchor_Ref:'AO.SM.B096.SYN',Priest_Station:'PREACHING_PLACE',Priest_Route_ID:null,Facing:'FACING_PEOPLE',Posture:'At the preaching place',Action:'Delivers the sermon / homily',Voice:'CLEAR SPOKEN',Independent_From_Schola:'N/A — LOW MASS',Runtime_Synthetic:true};
 const base=findPriest(el?.dataset?.cue||'',sort);if(!base)return base;const routeId=el?.dataset?.routeId||'';if(!routeId)return base;return routeStepRuntimePriest(base,routeId,Number(el.dataset.routeStep||1)-1);
}
function makeRouteStepUnit(b,u,routeId,step,idx,total){
 const el=document.createElement('div');el.className='flow-unit priest-route-unit';el.tabIndex=-1;el.dataset.block=b.Block_ID;el.dataset.macro=b.Macro_ID;el.dataset.cue=u.cue_id||'';el.dataset.sort=runtimeUnitSort(b,u);el.dataset.clock='PRIEST_ROUTE';el.dataset.routeId=routeId;el.dataset.routeStep=String(idx+1);el.dataset.routeTotal=String(total);
 const station=prettyStation(step.after||step.before||'ROUTE_CONTROLLED'),pattern=step.pattern&&step.pattern!=='—'?step.pattern:'',icon=assetImg(stationAssetKey(step.after||'ROUTE_CONTROLLED'),'section-icon');
 el.innerHTML=`<div class="priest-route-card"><div class="priest-route-kicker"><span>PRIEST ROUTE · ${idx+1} / ${total}</span><span>${escapeHtml(routeId.replaceAll('_',' '))}</span></div><div class="priest-route-icon">${icon}</div><div class="priest-route-place">${escapeHtml(station)} · ${escapeHtml(String(step.facing||'').replaceAll('_',' '))}</div><div class="priest-route-action">${escapeHtml(step.action||'Priest movement')}</div><div class="priest-route-pattern">${pattern?escapeHtml(pattern):'Movement / reverence'}</div><div class="priest-route-note">Progresses with your scroll · ordered route, not a timed animation</div></div>`;
 return el;
}

const gesturesByBlock=new Map(); DATA.gestures.forEach(g=>{if(!gesturesByBlock.has(g.Parent_Block_ID))gesturesByBlock.set(g.Parent_Block_ID,[]);gesturesByBlock.get(g.Parent_Block_ID).push(g)});

// v1.16: bind the 30 ordinary Mass moments to the 30 canonical HANDOFF rows by sequence.
// The canonical rows contain the UX clock contract; this runtime layer only supplies machine-addressable cue windows.
const ORDINARY_HANDOFFS=(DATA.concurrency||[]).filter(x=>x.Type==='HANDOFF'&&/^AO\.SM\.CON\.H0(?:0[1-9]|[12][0-9]|30)$/.test(x.Concurrency_ID)).sort((a,b)=>a.Concurrency_ID.localeCompare(b.Concurrency_ID));
const ORDERED_MACROS=DATA.macros.slice().sort((a,b)=>Number(a.Sequence)-Number(b.Sequence));
const handoffByMacro=new Map(ORDERED_MACROS.map((m,i)=>[m.Macro_ID,ORDINARY_HANDOFFS[i]||null]));
const scholaEventById=new Map((DATA.schola||[]).map(x=>[x.Schola_Event_ID,x]));
const cueSortMap=new Map();DATA.blocks.forEach(b=>(b.units||[]).forEach(u=>{if(u.cue_id)cueSortMap.set(u.cue_id,Number(u.sort))}));
const blockOrderMap=new Map(DATA.blocks.map(b=>[b.Block_ID,Number(b.Display_Order)]));
const isAlleluiaFixture=()=>/^allel[uú]ia\b/i.test(String(fixtureMap.ALLELUIA_TRACT_SEQUENCE?.Latin_Text||'').trim());
const hasSequenceFixture=()=>!!fixtureMap.SEQUENCE?.Latin_Text;

const SCHOLA_RUNTIME_ADAPTER=[
 ...(PRE_MASS_RITE.schola?[PRE_MASS_RITE.schola]:[]),
 {event:'AO.SM.SCH002',label:'INTROIT',windows:[{macro:'AO.SM.M01'}],source:{proper:'INTROIT'}},
