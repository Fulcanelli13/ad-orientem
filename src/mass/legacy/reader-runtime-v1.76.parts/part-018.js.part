function isRubric(u){return /^\s*\[/.test(u.latin||'') || /PRIEST_ACTION|VISIBLE_CEREMONY/.test(u.clock||'') && /^\s*\[/.test(u.english||'')}
function isResponse(u){return /(USER|MINISTER)_RESPONSE/.test(u.clock||'') || /^\s*℟/.test(u.latin||'')}
function cleanTitle(b){return (b.Title||b.Part||'').replace(/\s+·\s+/g,' · ')}
function simpleUnitVisible(b,u){
 if(b?.RuntimeOverlay)return !u?.hideInSimple;
 if(u?.type==='pause'||u?.clock==='GUIDE')return true;
 const clock=String(u?.clock||'');if(clock==='USER_RESPONSE')return true;if(clock==='MINISTER_RESPONSE')return activeUserResponseEvent(u);if(clock==='PRIEST_MIXED')return true;if(clock==='PRIEST_PRIVATE')return false;
 if(clock==='SCHOLA_PUBLIC')return !!flags.LOW_MASS_PROFILE;
 const a=flags.LOW_MASS_PROFILE?null:SCHOLA_RUNTIME_ADAPTER.find(x=>adapterEnabled(x)&&x.windows.some(w=>windowMatches(w,b,{dataset:{cue:u?.cue_id||'',sort:runtimeUnitSort(b,u)}})));
 if(a&&b?.Proper_Slot)return false;
 if(clock==='PRIEST_ACTION')return false;
 if(clock==='PUBLIC_TEXT'){
   const p=u?.cue_id?priestByCue.get(u.cue_id):null;
   if(p)return priestVoiceIsPublic(p.Voice);
   return true;
 }
 return false;
}
function simpleMacroHasVisible(macroId){return runtimeBlocksForMacros([macroId]).some(b=>(b.units||[]).some(u=>simpleUnitVisible(b,u)))}
function simpleStagePresentation(macroId){
 const h=handoffForMacro(macroId),clock=String(h?.Main_Clock||''),target=String(h?.Suggested_Target||'');
 if(/SCHOLA/.test(clock)||/SCHOLA/.test(target))return {icon:'schola',eyebrow:'PUBLIC CHANT',title:'Follow the Schola',body:h?.User_Guidance||'Follow the public chant in the Schola window.'};
 if(/PERSONAL_ACTION|CEREMONIAL|VISIBLE/.test(target+' '+clock))return {icon:macroIconKey(macroMap[macroId]),eyebrow:'VISIBLE CUE',title:macroMap[macroId]?.Moment||'Visible action',body:h?.User_Guidance||'Follow the visible liturgical action and the posture cues.'};
 if(/MODELLED_INTERNAL|INTERNAL/.test(clock))return {icon:'SEM:POSITION.ALTAR_CENTER',eyebrow:'SACRED SILENCE',title:macroMap[macroId]?.Moment||'Sacred silence',body:h?.User_Guidance||'Remain recollected and follow the visible cues.'};
 return {icon:macroIconKey(macroMap[macroId]),eyebrow:'SIMPLE MODE',title:macroMap[macroId]?.Moment||'Mass',body:h?.User_Guidance||'Follow the principal public cue.'};
}


function runtimeUnitSort(b,u){
 const raw=Number(u?.sort); const cue=String(u?.cue_id||'');
 if(!cue.endsWith('.SYN'))return Number.isFinite(raw)?raw:Number(b?.Display_Order)||0;
 const order=Number(b?.Display_Order); let prev=-Infinity,next=Infinity;
 DATA.blocks.forEach(x=>{const xo=Number(x.Display_Order);const vals=(x.units||[]).map(v=>Number(v.sort)).filter(Number.isFinite);if(!vals.length)return;if(xo<order)prev=Math.max(prev,...vals);if(xo>order)next=Math.min(next,...vals)});
 if(Number.isFinite(prev)&&Number.isFinite(next)&&prev<next)return prev+(next-prev)/2;
 return Number.isFinite(raw)?raw:order;
}

function activeUserResponseEvent(u){const r=responseByCue.get(u?.cue_id||'');return !!(r&&responseIsForUser(r))}
function activeLiturgicalResponseEvent(u){const r=responseByCue.get(u?.cue_id||'');return !!(r&&cond(r.Branch_Condition))}
function blockHasActiveUserResponse(b){return (b?.units||[]).some(u=>activeUserResponseEvent(u))}
function blockHasLiturgicalResponse(b){return (b?.units||[]).some(u=>activeLiturgicalResponseEvent(u))}
function responseBearingText(b,u){
 if(!u||u.type!=='text')return false;
 if(/^AO\.SM\.C024[3-5]$/.test(u.cue_id||''))return true;
 if(activeLiturgicalResponseEvent(u))return true;
 if((u.clock||'')!=='PUBLIC_TEXT'||!blockHasLiturgicalResponse(b))return false;
 const units=b?.units||[],i=units.indexOf(u);if(i<0)return false;
 let responseIndex=-1;for(let j=i+1;j<units.length;j++){if(activeLiturgicalResponseEvent(units[j])){responseIndex=j;break}if((units[j].clock||'')!=='PUBLIC_TEXT')break}
 if(responseIndex<0)return false;
 let start=responseIndex-1,total=0;while(start>=0&&(units[start].clock||'')==='PUBLIC_TEXT'){total+=String(units[start].latin||'').trim().length;start--}start++;
 return i>=start&&i<responseIndex&&total<=80;
}
function renderSpeakerMarkedText(el,text){if(!el)return;const value=String(text??'');const m=value.match(/^\s*(℣\.|℟\.|V\.|R\.|M\.|S\.)\s*/);if(!m){el.textContent=value;return;}const raw=m[1],speaker=raw.startsWith('℣')?'V':raw.startsWith('℟')?'R':raw.charAt(0);el.replaceChildren();const mark=document.createElement('span');mark.className='ao-speaker-marker';mark.dataset.speaker=speaker;mark.textContent=raw;el.append(mark,document.createTextNode(value.slice(m[0].length)));}
function renderMissalPair(el,latin,vernacular,cue=''){if(!el)return;el.classList.add('missal-pair');el.dataset.languageMode='missal';el.replaceChildren();const la=document.createElement('div'),ve=document.createElement('div');la.className='missal-col latin';ve.className='missal-col vernacular';renderSpeakerMarkedText(la,lowMassRoleAwareText(cue,latin,latin));renderSpeakerMarkedText(ve,lowMassRoleAwareText(cue,latin,vernacular||latin));el.append(la,ve);el.tabIndex=-1;}
function ensureMissalLanguageHead(sec){if(mode!=='read'||!sec||sec.querySelector(':scope > .missal-language-head'))return;const first=sec.querySelector(':scope > .flow-unit.missal-pair');if(!first)return;const h=document.createElement('div');h.className='missal-language-head';h.setAttribute('aria-hidden','true');h.innerHTML='<span>LATIN</span><span>VERNACULAR</span>';sec.insertBefore(h,first);}
function renderMissalInterstitial(el){if(!el)return;el.classList.add('missal-interstitial');el.replaceChildren();const la=document.createElement('div'),ve=document.createElement('div');la.className='missal-interstitial-latin';ve.className='missal-interstitial-vernacular';la.textContent='SERMO';ve.textContent='Sermon / Homily';el.append(la,ve);el.setAttribute('aria-label','Sermon / Homily');}
const LOW_MASS_EXPLICIT_MINISTER_CUES=new Set(['AO.SM.C0076','AO.SM.C0275']);
function lowMassRoleAwareText(cue,latin,text){let value=String(text??'');const latinValue=String(latin??'');if(LOW_MASS_EXPLICIT_MINISTER_CUES.has(String(cue||''))){value=value.replace(/^\s*(?:℟\.|R\.|M\.)\s*/,'');return `M. ${value}`}if(!/^\s*(?:℣\.|℟\.|V\.|R\.|M\.|S\.)\s*/.test(value)){const m=latinValue.match(/^\s*(S\.|M\.)\s*/);if(m)value=`${m[1]} ${value}`}return value}
function setUnitLanguage(el,language){if(!el||!el.dataset.latin)return;const responseMode=el.dataset.languageMode==='response';if(responseMode){el.dataset.language='latin';renderSpeakerMarkedText(el,lowMassRoleAwareText(el.dataset.cue,el.dataset.latin,el.dataset.latin));return}const wantLatin=language==='latin';el.dataset.language=wantLatin?'latin':'vernacular';const chosen=wantLatin?el.dataset.latin:(el.dataset.vernacular||el.dataset.latin);renderSpeakerMarkedText(el,lowMassRoleAwareText(el.dataset.cue,el.dataset.latin,chosen))}
function blockSwapUnits(sec){return Array.from(sec?.querySelectorAll('.flow-unit[data-language-mode="swap"]')||[]).filter(el=>!(mode==='live'&&el.classList.contains('live-schola-owned')))}
function setBlockLanguage(sec,language){if(!sec)return;const units=blockSwapUnits(sec);if(!units.length)return;const wantLatin=language==='latin';sec.dataset.blockLanguage=wantLatin?'latin':'vernacular';units.forEach(el=>setUnitLanguage(el,wantLatin?'latin':'vernacular'))}
function toggleBlockLanguage(sec){setBlockLanguage(sec,sec?.dataset.blockLanguage==='latin'?'vernacular':'latin')}
function makeSuppressedPrayerLine(u){const line=document.createElement('div');line.className='suppressed-prayer-line';line.dataset.latin=u.latin||'';line.dataset.vernacular=u.english||u.latin||'';line.dataset.language='vernacular';renderSpeakerMarkedText(line,line.dataset.vernacular||line.dataset.latin);return line}
function setPrayerPanelLanguage(panel,language){if(!panel)return;const wantLatin=language==='latin';panel.dataset.language=wantLatin?'latin':'vernacular';panel.dataset.languageMark=wantLatin?'LA':'EN';panel.querySelectorAll('[data-latin]').forEach(line=>{line.dataset.language=wantLatin?'latin':'vernacular';renderSpeakerMarkedText(line,wantLatin?line.dataset.latin:(line.dataset.vernacular||line.dataset.latin))})}
function bindPrayerPanelLanguage(panel){if(!panel)return;panel.tabIndex=0;panel.setAttribute('role','button');panel.setAttribute('aria-label','Switch prayer language');setPrayerPanelLanguage(panel,'vernacular');const toggle=()=>setPrayerPanelLanguage(panel,panel.dataset.language==='latin'?'vernacular':'latin');panel.addEventListener('click',e=>{if(e.target.closest('button'))return;e.stopPropagation();toggle()});panel.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();e.stopPropagation();toggle()}})}
function makeSuppressedPrayerPanel(b,ownedUnits){const panel=document.createElement('div');panel.className='suppressed-prayer-panel';panel.setAttribute('aria-hidden','true');ownedUnits.filter(u=>u.type==='text'&&String(u.latin||'').trim()&&!/^\s*\[/.test(u.latin||'')).forEach(u=>panel.appendChild(makeSuppressedPrayerLine(u)));bindPrayerPanelLanguage(panel);return panel}
function makeUnit(b,u,ui){
 const el=document.createElement('div');el.className='flow-unit';el.tabIndex=0;el.dataset.block=b.Block_ID;el.dataset.macro=b.Macro_ID;el.dataset.cue=u.cue_id||'';el.dataset.sort=runtimeUnitSort(b,u);el.dataset.unit=ui;el.dataset.clock=u.clock||'';
 if(b.RuntimeOverlay){el.dataset.overlayId=b.Overlay_ID||'';el.dataset.runtimeStation=u.station||'ALTAR_CENTER';el.dataset.runtimeFacing=u.facing||'ALTAR';el.dataset.runtimeVoice=u.voice||'SILENT';el.dataset.runtimeAction=u.action||'—';el.dataset.runtimePosture=u.posture||'STAND';if(u.userResponse)el.dataset.runtimeResponse=u.responseText||String(u.latin||'').replace(/^℟\.\s*/,'');if(u.hideInLive)el.classList.add('live-hidden')}
 if(canonicalScholaOwnedUnit(b,u)){el.classList.add('live-schola-owned');el.dataset.owner='SCHOLA_PUBLIC'}else el.dataset.owner=(u.clock||'CENTRE');
 if(u.type==='state'){el.classList.add('state-unit');if(b.RuntimeOverlay)el.classList.add('premass-action');el.textContent=u.state_label||'Private priest state'}
 else if(u.type==='pause'){el.classList.add('pause-unit');if(mode==='read')renderMissalInterstitial(el);else el.textContent='Sermon / Homily · liturgical reader paused'}
 else{el.dataset.latin=u.latin||'';el.dataset.vernacular=u.english||u.latin||'';const responseMode=responseBearingText(b,u);if(isRubric(u))el.classList.add('rubric-line');if(responseMode){el.classList.add('response-latin');if(activeUserResponseEvent(u))el.classList.add('response-line')}if(mode==='read'){renderMissalPair(el,el.dataset.latin,el.dataset.vernacular,u.cue_id||'')}else{el.classList.add('language-toggle');el.dataset.languageMode=responseMode?'response':'swap';setUnitLanguage(el,responseMode?'latin':'vernacular')}}
 if(!simpleUnitVisible(b,u)){el.classList.add('simple-hidden');el.dataset.simpleHidden='1'}
 if(mode!=='read'&&el.dataset.languageMode==='response'){el.tabIndex=0;el.addEventListener('click',()=>toggleTranslation(el));el.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();toggleTranslation(el)}})}else el.tabIndex=-1;
 return el;
} function makeBlock(b){
 const sec=document.createElement('section');sec.className='mass-block';sec.dataset.block=b.Block_ID;sec.dataset.order=b.Display_Order;sec.dataset.macro=b.Macro_ID;if(b.Requiem_Proper_Unresolved)sec.dataset.requiemProper='unresolved';
 const head=document.createElement('div');head.className='block-head with-icon';const bi=blockIconKey(b);head.innerHTML=`<span class="block-icon">${assetImg(bi,'asset-icon')}</span><span class="block-title-wrap"><span class="order">${b.Display_Order}</span><span>${escapeHtml(cleanTitle(b))}</span></span>${b.Proper_Slot?'<span class="proper">PROPER</span>':''}`;sec.appendChild(head);
 const units=b.units||[],ownedUnits=units.filter(u=>canonicalScholaOwnedUnit(b,u));let centreUnits=0;if(!units.some(u=>simpleUnitVisible(b,u)))sec.classList.add('simple-empty');
 units.forEach((u,ui)=>{const owned=canonicalScholaOwnedUnit(b,u);if(!owned)centreUnits++;const el=makeUnit(b,u,ui);sec.appendChild(el);if(mode!=='read'&&u.type==='text'&&u.english&&responseBearingText(b,u)){const tr=document.createElement('div');tr.className='translation response-vernacular';renderSpeakerMarkedText(tr,lowMassRoleAwareText(u.cue_id,u.latin,u.english));sec.appendChild(tr)}const routeEvent=priestRouteEventByCue.get(u.cue_id||''),steps=routeStepsForCue(u.cue_id||'');if(routeEvent&&steps.length>1)steps.forEach((step,idx)=>sec.appendChild(makeRouteStepUnit(b,u,routeEvent.Priest_Route_ID,step,idx,steps.length)))});
 if(mode==='read'){ensureMissalLanguageHead(sec)}else{setBlockLanguage(sec,'vernacular');sec.addEventListener('click',e=>{const unit=e.target.closest('.flow-unit[data-language-mode="swap"]');if(!unit||!sec.contains(unit)||mode==='live'&&unit.classList.contains('live-schola-owned'))return;toggleBlockLanguage(sec)})};
 if(mode==='live'&&ownedUnits.length){head.classList.add('expandable-prayer');head.tabIndex=0;head.setAttribute('role','button');head.setAttribute('aria-expanded','false');const panel=makeSuppressedPrayerPanel(b,ownedUnits);sec.appendChild(panel);const toggle=()=>{const open=!sec.classList.contains('prayer-open');sec.classList.toggle('prayer-open',open);head.setAttribute('aria-expanded',open?'true':'false');panel.setAttribute('aria-hidden',open?'false':'true');requestAnimationFrame(()=>updateActive(true))};head.addEventListener('click',toggle);head.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();toggle()}})}
 if(units.length&&centreUnits===0)sec.classList.add('live-schola-owned-block');return sec;
} function simpleGuideSentinelUnits(b){
 const units=(b?.units||[]);if(!units.length)return [];
 buildGestureBindings();
 const picked=[];let priorPosture='';
 units.forEach((u,i)=>{
   const cue=u?.cue_id||'',sort=runtimeUnitSort(b,u),fake={dataset:{block:b.Block_ID,macro:b.Macro_ID,cue,sort:String(sort),clock:u?.clock||''},textContent:u?.latin||u?.state_label||''};
   const priest=cue?runtimePriestForElement(fake,sort):null;
   const posture=findPosture(b,priest,sort),postureName=posture?.New_Posture||'';
   const postureChange=!!postureName&&postureName!==priorPosture;
   if(postureName)priorPosture=postureName;
   const gesture=!!findGesture(fake),bell=!!bellAtCue(cue),response=!!(cue&&responseByCue.get(cue));
   const visibleAction=String(u?.clock||'')==='PRIEST_ACTION'||!!significantPriestAction(priest);
   if(i===0||postureChange||gesture||bell||response||visibleAction)picked.push(u);
 });
 const last=units[units.length-1];if(last&&!picked.includes(last))picked.push(last);
 return picked;
}

function makeCard(cardSpec,localIndex,total){
 const spec=typeof cardSpec==='string'?singleCardSpec(cardSpec):cardSpec;
 const macros=cardMacros(spec),macroId=macros[0],macro=macroMap[macroId]||{};
 const card=document.createElement('section');card.className='mass-card';card.dataset.macro=macroId;card.dataset.macros=macros.join(',');card.dataset.cardId=spec.id||macroId;card.dataset.card=localIndex;card.setAttribute('aria-label',spec.title||macro.Moment||macroId);
 if(mode==='live'&&macros.length>1)card.classList.add('live-grouped-card');
 if(macros.length===1&&liveScholaOnlyMacro(macroId)){
    card.classList.add('schola-only-stage');card.dataset.scholaProgram=SCHOLA_STAGE_PROGRAM[macroId]||'';
    const b=runtimeBlocksForMacros([macroId])[0];
    if(b){const u=(b.units||[])[0]||{};const stage=document.createElement('div');stage.className='schola-stage-surface flow-unit';stage.dataset.block=b.Block_ID;stage.dataset.macro=b.Macro_ID;stage.dataset.cue=u.cue_id||'';stage.dataset.sort=runtimeUnitSort(b,u);stage.dataset.unit='0';stage.dataset.clock=u.clock||'';stage.dataset.owner='SCHOLA_STAGE';stage.tabIndex=0;
      const stageBlocks=runtimeBlocksForMacros([macroId]),stageLines=[];stageBlocks.forEach(x=>(x.units||[]).filter(u=>u.type==='text'&&String(u.latin||'').trim()&&!/^\s*\[/.test(u.latin||'')).forEach(u=>stageLines.push(u)));
      stage.innerHTML=`<div class="schola-stage-inner"><div class="schola-stage-mark">${assetImg('SEM:SOUND.SCHOLA','section-icon')}</div><div class="schola-stage-kicker">SCHOLA STAGE</div><div class="schola-stage-title"><button class="schola-stage-title-button" type="button" aria-expanded="false">${escapeHtml(liveScholaStageLabel(macroId))}</button></div><div class="schola-stage-hint">Follow the Schola ribbon.</div><div class="schola-stage-prayer-panel" aria-hidden="true"></div></div>`;
      const panel=stage.querySelector('.schola-stage-prayer-panel');stageLines.forEach(u=>{const line=makeSuppressedPrayerLine(u);line.classList.remove('suppressed-prayer-line');line.classList.add('schola-stage-prayer-line');panel.appendChild(line)});bindPrayerPanelLanguage(panel);const titleBtn=stage.querySelector('.schola-stage-title-button');titleBtn.addEventListener('click',e=>{e.stopPropagation();const open=!stage.classList.contains('prayer-open');stage.classList.toggle('prayer-open',open);titleBtn.setAttribute('aria-expanded',open?'true':'false');panel.setAttribute('aria-hidden',open?'false':'true')});card.appendChild(stage)}
    bindCard(card);return card;
  }  if(mode==='simple'&&macros.length===1&&!simpleMacroHasVisible(macroId)){
   card.classList.add('simple-guide-stage');const p=simpleStagePresentation(macroId);
   const shell=document.createElement('div');shell.className='simple-stage-shell';shell.innerHTML=`${assetImg(p.icon,'section-icon')}<em>${escapeHtml(p.eyebrow)}</em><b>${escapeHtml(p.title)}</b><span>${escapeHtml(p.body)}</span>`;card.appendChild(shell);
   const bs=runtimeBlocksForMacros([macroId]);let simpleSentinelIndex=0;
   bs.forEach((b)=>{const units=simpleGuideSentinelUnits(b);units.forEach((u)=>{const sentinel=document.createElement('div');sentinel.className='flow-unit simple-stage-sentinel';sentinel.style.marginTop=simpleSentinelIndex===0?'3vh':'11vh';sentinel.dataset.block=b.Block_ID;sentinel.dataset.macro=b.Macro_ID;sentinel.dataset.cue=u.cue_id||'';sentinel.dataset.sort=runtimeUnitSort(b,u);sentinel.dataset.unit=String((b.units||[]).indexOf(u));sentinel.dataset.clock=u.clock||'';sentinel.setAttribute('aria-hidden','true');card.appendChild(sentinel);simpleSentinelIndex++})});
   const runway=document.createElement('div');runway.className='simple-stage-runway';runway.setAttribute('aria-hidden','true');card.appendChild(runway);bindCard(card);return card;
 }
 const heading=document.createElement('h2');heading.className='card-heading with-icon';const mi=macroIconKey(macro);
 const dualTrack=mode==='live'&&macros.some(id=>macroHasPrivateParallel(id)),simpleChip=mode==='simple'?' <span class="simple-mode-chip">PUBLIC / AUDIBLE</span>':'';
 const firstSeq=Number(macroMap[macros[0]]?.Sequence)||localIndex+1,lastSeq=Number(macroMap[macros[macros.length-1]]?.Sequence)||firstSeq;
 const seqLabel=macroId.startsWith('AO.PRE.')?'PRE':(mode==='live'?(firstSeq===lastSeq?String(firstSeq).padStart(2,'0'):`${String(firstSeq).padStart(2,'0')}–${String(lastSeq).padStart(2,'0')}`):String(firstSeq).padStart(2,'0'));
 const stageTag=mode==='live'&&macros.length>1?`<span class="live-stage-span">${macros.length} moments · one live stage</span>`:'';
 heading.innerHTML=`<span class="heading-icon">${assetImg(mi,'section-icon')}</span><span class="card-heading-main"><span class="card-seq">${seqLabel} · ${localIndex+1} / ${total}${dualTrack?' · PRIEST QUIET TRACK':''}</span>${escapeHtml(spec.title||macro.Moment||macroId)}${stageTag}${simpleChip}</span>`;card.appendChild(heading);
 const blocks=runtimeBlocksForMacros(macros).filter(b=>!Array.isArray(spec.blocks)||spec.blocks.includes(b.Block_ID));
 let previousMacro=null;
 blocks.forEach(b=>{if(mode==='live'&&macros.length>1&&previousMacro&&b.Macro_ID!==previousMacro){const div=document.createElement('div');div.className='live-stage-divider';div.setAttribute('aria-hidden','true');div.innerHTML=`<span>${escapeHtml(macroMap[b.Macro_ID]?.Moment||b.Macro_ID)}</span>`;card.appendChild(div)}card.appendChild(makeBlock(b));previousMacro=b.Macro_ID});
 if(macros.includes('AO.PRE.M00')){const note=document.createElement('div');note.className='premass-transition-note';note.textContent='Sunday aspersion complete · the next cinematic transition begins the Mass proper';card.appendChild(note)}const runway=document.createElement('div');runway.className='card-runway';runway.innerHTML='<span>continue scrolling<b>↓</b></span>';card.appendChild(runway);bindCard(card);return card;
}
function activeCard(){return $('#reader .mass-card.is-active')}
function scrollCardToMacro(macroId){
 const card=activeCard();if(!card||!macroId)return;
 const target=card.querySelector(`.flow-unit[data-macro="${macroId}"],.mass-block[data-macro="${macroId}"]`);if(!target)return;
 const cr=card.getBoundingClientRect(),tr=target.getBoundingClientRect(),offset=Math.min(96,Math.max(34,card.clientHeight*.11));
 card.scrollTop=Math.max(0,card.scrollTop+(tr.top-cr.top)-offset);
 requestAnimationFrame(()=>updateActive(true));
}
function bindCard(card){
 syncFluidRunway(card);requestAnimationFrame(()=>syncFluidRunway(card));
 if(window.ResizeObserver&&!card.__aoFocusResizeObserver){card.__aoFocusResizeObserver=new ResizeObserver(()=>{if(!card.classList.contains('is-active'))return;syncFluidRunway(card);requestAnimationFrame(()=>updateActive(true))});card.__aoFocusResizeObserver.observe(card)}
 card.addEventListener('scroll',()=>{if(card.classList.contains('is-active')&&!raf)raf=requestAnimationFrame(()=>updateActive(false))},{passive:true});
 card.addEventListener('wheel',e=>{if(partTransitioning||!card.classList.contains('is-active'))return;if(card.classList.contains('schola-only-stage')&&mode==='live'){e.preventDefault();wheelAccum+=Math.min(100,Math.abs(e.deltaY));if(wheelAccum>=105){const d=e.deltaY>0?1:-1,ready=d<0||scholaStageReady(card.dataset.scholaProgram);wheelAccum=0;if(ready)navigateCard(d)}return}const edgeTol=Math.max(20,card.clientHeight*.025),remaining=Math.max(0,card.scrollHeight-card.clientHeight-card.scrollTop),atBottom=remaining<=edgeTol,atTop=card.scrollTop<=edgeTol;if((e.deltaY>0&&atBottom)||(e.deltaY<0&&atTop)){wheelAccum+=Math.min(100,Math.abs(e.deltaY));if(wheelAccum>=105){e.preventDefault();const d=e.deltaY>0?1:-1;wheelAccum=0;navigateCard(d)}}else wheelAccum=0},{passive:false});
 card.addEventListener('touchstart',e=>{const t=e.touches[0];touchStart=t?{x:t.clientX,y:t.clientY}:null},{passive:true});
 card.addEventListener('touchend',e=>{if(!touchStart||partTransitioning)return;const t=e.changedTouches[0];if(!t)return;const dx=t.clientX-touchStart.x,dy=t.clientY-touchStart.y;touchStart=null;if(Math.abs(dx)>70&&Math.abs(dx)>Math.abs(dy)*1.25){const d=dx<0?1:-1;if(card.classList.contains('schola-only-stage')&&mode==='live'&&d>0&&!scholaStageReady(card.dataset.scholaProgram))return;navigateCard(d)}},{passive:true});
} function forceCardEdge(card,edge='top'){
 if(!card)return;
 const target=edge==='bottom'?Math.max(0,card.scrollHeight-card.clientHeight):0;
 const old=card.style.scrollBehavior;card.style.scrollBehavior='auto';card.scrollTop=target;
 requestAnimationFrame(()=>{card.scrollTop=edge==='bottom'?Math.max(0,card.scrollHeight-card.clientHeight):0;card.style.scrollBehavior=old;});
}
function clearAllCardFocus(except=null){document.querySelectorAll('#reader .mass-card').forEach(card=>{if(card===except)return;card.querySelectorAll('.active,.near,.focus-context,.focus-current,[aria-current="true"]').forEach(el=>{el.classList.remove('active','near','focus-context','focus-current');el.removeAttribute('aria-current')})})}
function mountPart(nextPart,targetCard=0,edge='top'){
 const reader=$('#reader'),part=PARTS[nextPart];if(!part)return;const specs=cardSpecsForPart(part);reader.textContent='';partTrack=document.createElement('div');partTrack.className='part-track';specs.forEach((spec,i)=>partTrack.appendChild(makeCard(spec,i,specs.length)));reader.appendChild(partTrack);partIndex=nextPart;cardIndex=Math.max(0,Math.min(targetCard,specs.length-1));Array.from(partTrack.children).forEach((c,i)=>c.classList.toggle('is-active',i===cardIndex));clearAllCardFocus(activeCard());partTrack.style.transition='none';partTrack.style.transform=`translate3d(${-cardIndex*100}%,0,0)`;requestAnimationFrame(()=>{partTrack.style.transition='';const c=activeCard();forceCardEdge(c,edge);activeEl=null;activeIndex=0;updateCardChrome();requestAnimationFrame(()=>updateActive(true))});
}
function setCard(next,direction=0){
 const part=PARTS[partIndex],specs=cardSpecsForPart(part);if(!part||partTransitioning)return;next=Math.max(0,Math.min(next,specs.length-1));if(next===cardIndex)return;cardIndex=next;wheelAccum=0;Array.from(partTrack.children).forEach((c,i)=>c.classList.toggle('is-active',i===cardIndex));clearAllCardFocus(activeCard());partTrack.style.transform=`translate3d(${-cardIndex*100}%,0,0)`;const c=activeCard();forceCardEdge(c,direction<0?'bottom':'top');activeEl=null;activeIndex=0;updateCardChrome();setTimeout(()=>updateActive(true),170);
}
function updateCardChrome(){const part=PARTS[partIndex],n=cardSpecsForPart(part).length||1;const c=activeCard(),scholaOnly=!!c?.classList.contains('schola-only-stage');$('#cardCounter').textContent=`${cardIndex+1} / ${n}`;$('#cardCounter').style.visibility=scholaOnly?'hidden':'visible';const first=partIndex===0&&cardIndex===0,last=partIndex===PARTS.length-1&&cardIndex===n-1;$('#cardPrev').style.visibility=first?'hidden':'visible';$('#cardNext').style.visibility=last?'hidden':'visible'}
function showPartCinema(targetPart,targetCard=0,direction=1,initial=false){
 if(partTransitioning)return;const part=PARTS[targetPart];if(!part)return;
 if(mode==='read'){partTransitioning=true;mountPart(targetPart,targetCard,direction<0?'bottom':'top');requestAnimationFrame(()=>{partTransitioning=false;updateActive(true)});return}
 prepareScholaForPart(part);partTransitioning=true;setScholaTransitionFreeze(true);document.body.classList.add('part-transition');const o=$('#partCinema');$('#partCinemaTitle').textContent=part.title;$('#partCinemaSub').textContent=initial?DATA.meta.dayLatin:'';const pm=$('#partCinemaMark');if(pm){pm.innerHTML=assetImg(partIconKey(part),'section-icon')||'✠'}o.classList.add('show','loading');o.setAttribute('aria-hidden','false');setTimeout(()=>mountPart(targetPart,targetCard,direction<0?'bottom':'top'),260);setTimeout(()=>o.classList.remove('loading'),610);setTimeout(()=>{o.classList.remove('show');o.setAttribute('aria-hidden','true');document.body.classList.remove('part-transition');partTransitioning=false;setScholaTransitionFreeze(false);resetUltimateSalienceReplayTokens();updateActive(true)},920);
}
function navigateCard(direction){const part=PARTS[partIndex],specs=cardSpecsForPart(part);if(!part||partTransitioning)return;const next=cardIndex+direction;if(next>=0&&next<specs.length){setCard(next,direction);return}const np=partIndex+direction;if(np<0||np>=PARTS.length)return;showPartCinema(np,direction>0?0:Math.max(0,cardSpecsForPart(PARTS[np]).length-1),direction,false)}
function goToMacro(macroId){const pi=PARTS.findIndex(p=>p.macros.includes(macroId));if(pi<0)return;const ci=cardIndexForMacro(PARTS[pi],macroId);if(pi===partIndex){if(ci===cardIndex){scrollCardToMacro(macroId);return}setCard(ci,ci>=cardIndex?1:-1);setTimeout(()=>scrollCardToMacro(macroId),210);return}showPartCinema(pi,ci,pi>partIndex?1:-1,false);setTimeout(()=>scrollCardToMacro(macroId),360)}

function syncHeaderHeight(){
  const shell=document.querySelector('.top-shell');if(!shell)return;
  const h=Math.ceil(shell.getBoundingClientRect().height);
  document.documentElement.style.setProperty('--header-h',`${h}px`);
}
window.addEventListener('resize',()=>requestAnimationFrame(()=>{syncHeaderHeight();document.querySelectorAll('.mass-card').forEach(syncFluidRunway)}),{passive:true});
function render(){
 document.body.dataset.mode=mode;requestAnimationFrame(syncHeaderHeight);$$('.mode-btn').forEach(b=>b.classList.toggle('active',b.dataset.modeBtn===mode));setIconHtml($('#modeIconRead'),'SEM:ACTION.EPISTLE','');setIconHtml($('#modeIconSimple'),'SEM:CUE.RESPONSE','');setIconHtml($('#modeIconLive'),'SEM:SOUND.SCHOLA','');setIconHtml($('#scholaDockIcon'),'SEM:SOUND.SCHOLA','');$('#dayLatin').textContent=DATA.meta.dayLatin;$('#dayMeta').textContent=`${DATA.meta.dayEnglish} · ${DATA.meta.rank} · ${DATA.meta.colour} · ${DATA.meta.date}`;mountPart(0,0,'top');buildDrawer();setTimeout(()=>showPartCinema(0,0,1,true),90);
}
function escapeHtml(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]))}
function toggleTranslation(el){if(el.classList.contains('state-unit')||el.classList.contains('pause-unit'))return;el.classList.toggle('show-translation')}
const FLUID_FOCUS_RATIO=.38;
const FOCUS_GEOMETRY_TOLERANCE_PX=32;
function flow(){const c=activeCard();return c?Array.from(c.querySelectorAll('.flow-unit')).filter(x=>{const cs=getComputedStyle(x);return cs.display!=='none'&&cs.visibility!=='hidden'}):[]}
function flowAnchorOffset(el){const h=Math.max(1,el.getBoundingClientRect().height);return Math.min(30,Math.max(10,h*.38))}
function flowContentAnchor(card,el){const cr=card.getBoundingClientRect(),r=el.getBoundingClientRect();return card.scrollTop+(r.top-cr.top)+flowAnchorOffset(el)}
function calibrateLiveLeadIn(card){
 if(!['live','simple'].includes(mode)||!card||!card.clientHeight)return;
 const els=Array.from(card.querySelectorAll('.flow-unit')).filter(x=>{const cs=getComputedStyle(x);return cs.display!=='none'&&cs.visibility!=='hidden'});if(!els.length)return;
 const focusLocal=card.clientHeight*FLUID_FOCUS_RATIO,current=parseFloat(getComputedStyle(card).paddingTop)||0;
 const anchor=flowContentAnchor(card,els[0]),minLead=28,maxLead=Math.max(minLead,focusLocal-8);
 const next=Math.max(minLead,Math.min(maxLead,current+(focusLocal-anchor)));
 if(Math.abs(next-current)>1)card.style.setProperty('--ao-leadin-height',`${Math.round(next)}px`);
}
function syncFluidRunway(card){
 if(!card||!card.clientHeight)return;
 const h=Math.max(280,Math.ceil(card.clientHeight*(1-FLUID_FOCUS_RATIO)+72));
 const initialLead=Math.max(28,Math.ceil(card.clientHeight*FLUID_FOCUS_RATIO-44));
 card.style.setProperty('--ao-runway-height',`${h}px`);
 if((mode==='live'||mode==='simple')&&!card.style.getPropertyValue('--ao-leadin-height'))card.style.setProperty('--ao-leadin-height',`${initialLead}px`);
 const runway=card.querySelector(':scope > .card-runway,:scope > .simple-stage-runway');if(runway)runway.style.height=`${h}px`;
 calibrateLiveLeadIn(card);
}
function focusOwnershipGeometry(card,els){
 const focusLocal=card.clientHeight*FLUID_FOCUS_RATIO,focusContent=card.scrollTop+focusLocal;
 const anchors=els.map(el=>flowContentAnchor(card,el));const boundaries=[];
 for(let i=0;i<anchors.length-1;i++)boundaries.push((anchors[i]+anchors[i+1])/2);
 let index=0;while(index<boundaries.length&&focusContent>=boundaries[index])index++;
 const firstTerritoryPx=boundaries.length?Math.max(0,boundaries[0]-focusLocal):Math.max(0,card.scrollHeight-card.clientHeight);
 return {focusLocal,focusContent,anchors,boundaries,index,firstTerritoryPx};
}
function emitFocusedUnit(el,index){
 if(!el)return;window.dispatchEvent(new CustomEvent('ao:focus-unit-changed',{detail:{cue:el.dataset.cue||'',macro:el.dataset.macro||'',block:el.dataset.block||'',sort:Number(el.dataset.sort)||0,index,text:String(el.textContent||'').trim().slice(0,180)}}));
}
function updateActive(force=false){
 raf=0;const els=flow(),card=activeCard();if(!els.length||!card)return;
 syncFluidRunway(card);const g=focusOwnershipGeometry(card,els);const best=Math.max(0,Math.min(els.length-1,g.index)),next=els[best],changed=activeEl!==next;
 activeEl=next;activeIndex=best;
 els.forEach((el,i)=>{const d=Math.abs(i-best),isCurrent=i===best;el.classList.toggle('active',isCurrent);el.classList.toggle('focus-current',isCurrent);el.classList.toggle('near',d===1);el.classList.toggle('focus-context',d===2||d===3);if(isCurrent)el.setAttribute('aria-current','true');else el.removeAttribute('aria-current')});
 if(!force&&!changed)return;
 syncState(activeEl);emitFocusedUnit(activeEl,best);
}
function focusAudit(){
 const card=activeCard(),els=flow();if(!card||!els.length)return {build:'v1.75_R14_INTEGRATION_CANDIDATE',pass:true,reason:'no visual flow units',cardId:card?.dataset?.cardId||null};
 const g=focusOwnershipGeometry(card,els),current=card.querySelector('.flow-unit.focus-current,.flow-unit.active'),idx=current?els.indexOf(current):-1,cr=card.getBoundingClientRect(),r=current?.getBoundingClientRect();
 const focusLineY=cr.top+g.focusLocal,rectDelta=r?Math.max(0,r.top-focusLineY,focusLineY-r.bottom):null;
 const inactive=[...document.querySelectorAll('#reader .mass-card:not(.is-active)')],stale=inactive.reduce((n,c)=>n+c.querySelectorAll('.focus-current,.active,[aria-current="true"]').length,0);
 const expected=els[g.index]||null,ownershipOk=current===expected,visualGeometryApplicable=!(mode==='simple'&&card.classList.contains('simple-guide-stage')),deltaOk=!visualGeometryApplicable||rectDelta==null||rectDelta<=FOCUS_GEOMETRY_TOLERANCE_PX;
 return {build:'v1.75_R14_INTEGRATION_CANDIDATE',cardId:card.dataset.cardId||card.dataset.macro||'',scrollTop:Math.round(card.scrollTop),focusLineY:Math.round(focusLineY),activeIndex:idx,expectedIndex:g.index,firstTerritoryPx:Math.round(g.firstTerritoryPx),activeRect:r?{top:Math.round(r.top),bottom:Math.round(r.bottom),height:Math.round(r.height)}:null,deltaPx:rectDelta==null?null:Math.round(rectDelta),tolerancePx:FOCUS_GEOMETRY_TOLERANCE_PX,staleInactiveFocus:stale,ownershipOk,visualGeometryApplicable,pass:ownershipOk&&deltaOk&&stale===0};
}
async function focusAuditAllCards(){
 const saved={part:partIndex,card:cardIndex};const out=[];const wait=()=>new Promise(r=>requestAnimationFrame(()=>requestAnimationFrame(()=>setTimeout(r,12))));
 for(let pi=0;pi<PARTS.length;pi++){const specs=cardSpecsForPart(PARTS[pi]);for(let ci=0;ci<specs.length;ci++){mountPart(pi,ci,'top');await wait();const c=activeCard();forceCardEdge(c,'top');await wait();updateActive(true);const els=flow(),cur=c?.querySelector('.flow-unit.focus-current'),f=focusAudit();out.push({part:PARTS[pi].id,cardId:c?.dataset.cardId||'',macro:c?.dataset.macro||'',scholaOnly:!!c?.classList.contains('schola-only-stage'),guideStage:!!c?.classList.contains('simple-guide-stage'),flowCount:els.length,firstIsCurrent:!!els.length&&els[0]===cur,firstTerritoryPx:f.firstTerritoryPx??0,deltaPx:f.deltaPx??0,pass:f.pass})}}
 mountPart(Math.max(0,Math.min(saved.part,PARTS.length-1)),saved.card,'top');await wait();updateActive(true);
 const ordinary=out.filter(x=>x.flowCount>0&&!x.scholaOnly&&!x.guideStage),guideStages=out.filter(x=>x.flowCount>0&&x.guideStage);return {mode,total:out.length,ordinary:ordinary.length,guideStages:guideStages.length,guideStageOwnershipFailures:guideStages.filter(x=>!x.firstIsCurrent).length,firstParagraphFailures:ordinary.filter(x=>!x.firstIsCurrent).length,zeroTerritory:ordinary.filter(x=>x.firstTerritoryPx<=0).length,geometryFailures:ordinary.filter(x=>!x.pass).length,minFirstTerritoryPx:ordinary.length?Math.min(...ordinary.map(x=>x.firstTerritoryPx)):0,maxDeltaPx:ordinary.length?Math.max(...ordinary.map(x=>x.deltaPx)):0,cards:out,pass:ordinary.every(x=>x.firstIsCurrent&&x.firstTerritoryPx>0&&x.pass)&&guideStages.every(x=>x.firstIsCurrent)};
}
async function missalAuditAllCards(){
 if(mode!=='read')return {mode,pass:false,reason:'Switch to MISSAL before running the MISSAL audit.'};
 const saved={part:partIndex,card:cardIndex};const wait=()=>new Promise(r=>requestAnimationFrame(()=>requestAnimationFrame(()=>setTimeout(r,12))));let pairs=0,heads=0,interstitials=0,cards=0;const detail=[];
 for(let pi=0;pi<PARTS.length;pi++){mountPart(pi,0,'top');await wait();const cs=[...document.querySelectorAll('#reader .mass-card')];const pp=cs.reduce((n,c)=>n+c.querySelectorAll('.missal-pair').length,0),hh=cs.reduce((n,c)=>n+c.querySelectorAll('.missal-language-head').length,0),ii=cs.reduce((n,c)=>n+c.querySelectorAll('.pause-unit.missal-interstitial').length,0);pairs+=pp;heads+=hh;interstitials+=ii;cards+=cs.length;detail.push({part:PARTS[pi].id,cards:cs.length,pairs:pp,heads:hh,interstitials:ii})}
 const canonicalTextUnits=DATA.blocks.filter(blockEnabled).reduce((n,b)=>n+(b.units||[]).filter(u=>u.type==='text').length,0),pauseUnits=DATA.blocks.filter(blockEnabled).reduce((n,b)=>n+(b.units||[]).filter(u=>u.type==='pause').length,0);
 mountPart(Math.max(0,Math.min(saved.part,PARTS.length-1)),saved.card,'top');await wait();updateActive(true);
 return {mode,cards,pairs,heads,interstitials,canonicalTextUnits,pauseUnits,detail,pass:pairs===canonicalTextUnits&&interstitials===pauseUnits};
}
AO.FluidFocus=Object.freeze({version:'2.4.1',ratio:FLUID_FOCUS_RATIO,event:'ao:focus-unit-changed',audit:focusAudit});
AO.FocusAudit=Object.freeze({run:focusAudit,runAllCards:focusAuditAllCards,tolerancePx:FOCUS_GEOMETRY_TOLERANCE_PX});
AO.MissalAudit=Object.freeze({runAllCards:missalAuditAllCards});
function latestEligible(arr,sort,sortField='Sort_Key'){let best=null;for(const x of arr){const v=Number(x[sortField]);if(!Number.isFinite(v)||v>sort||!cond(x.Condition||x.Branch_Condition))continue;if(!best||v>Number(best[sortField]))best=x;}return best}
function findPriest(cue,sort){if(cue&&priestByCue.has(cue)){const p=priestByCue.get(cue);if(cond(p.Branch_Condition))return runtimePriestEvent(p)}return runtimePriestEvent(latestEligible(DATA.priestEvents,sort))}
// AO.LiveState.Posture — persistent state machine; activate at the cue and hold until the next posture event.
const POSTURE_ANCHOR_CUES={
 PRIEST_AT_FOOT_AFTER_ALTAR_SALUTE:'AO.SM.C0001',
 PRIEST_AT_SEDILIA_GLORIA:'AO.SM.C0276',
 PRIEST_AT_SEDILIA_CREDO:'AO.SM.C0278',
 PEOPLE_INCENSATION_START:'AO.SM.C0124',
 PEOPLE_INCENSATION_END:'AO.SM.C0125'
};
const