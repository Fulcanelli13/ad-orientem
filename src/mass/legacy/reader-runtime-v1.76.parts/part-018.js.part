function aoSemanticBinding(sid){const key=String(sid||'');return AO_SEMANTIC_ICON_BINDINGS[key]||AO_SEMANTIC_ICON_BINDINGS[AO_SEMANTIC_ALIAS_MAP[key]]||null}
function aoResolveIconRef(ref){
  const sid=String(ref||'').startsWith('SEM:')?String(ref).slice(4):(AO_LEGACY_ICON_SEMANTIC[ref]||'');
  const binding=sid?aoSemanticBinding(sid):null;
  const src=binding?.asset_id?AO_MASTER_FILES[binding.asset_id]:null;
  return src?{sid,binding,src}:null;
}
window.aoResolveIconRef=aoResolveIconRef;
AO.Assets=Object.freeze({version:'4.6.0',meta:AO_ICON_BANK_META,resolve:aoResolveIconRef,semanticBinding:aoSemanticBinding});
