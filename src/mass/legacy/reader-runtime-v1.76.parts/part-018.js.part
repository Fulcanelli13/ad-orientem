];
function overlayPart(ov){return {id:ov.part.id,title:ov.part.title,macros:[ov.macro.Macro_ID],overlayId:ov.Overlay_ID,icon:ov.part.icon||'cross'}}
function aoR14PartForMacros(id,title,macros){return {id,title,macros}}
if(RITE_CONTEXT.goodFriday)MASS_PARTS=[];
else if(RITE_CONTEXT.easterVigil)MASS_PARTS=[aoR14PartForMacros('ev-catechumens','EASTER VIGIL MASS · KYRIE & WORD',['AO.SM.M02','AO.SM.M03','AO.SM.M04','AO.SM.M05','AO.SM.M06','AO.SM.M07','AO.SM.M08']),...MASS_PARTS.filter(p=>['offertory','canon','communion','conclusion'].includes(p.id))];
else if(RITE_CONTEXT.nuptial&&RITE_CONTEXT.nuptialEligibility!=='PERMITTED')MASS_PARTS=[];
const BEFORE_R14=ACTIVE_OVERLAYS.filter(x=>x.placement==='BEFORE_MASS').map(overlayPart),AFTER_R14=ACTIVE_OVERLAYS.filter(x=>x.placement==='AFTER_MASS').map(overlayPart),MID_SERMON=ACTIVE_OVERLAYS.filter(x=>x.placement==='MID_AFTER_SERMON').map(overlayPart),MID_PATER=ACTIVE_OVERLAYS.filter(x=>x.placement==='MID_AFTER_PATERNOSTER').map(overlayPart),MID_DISMISSAL=ACTIVE_OVERLAYS.filter(x=>x.placement==='MID_AFTER_DISMISSAL').map(overlayPart),MID_COMMUNION=ACTIVE_OVERLAYS.filter(x=>x.placement==='MID_AFTER_COMMUNION').map(overlayPart);
const PARTS=[...BEFORE_R14];
for(const p of MASS_PARTS){
 if(p.id==='catechumens'&&MID_SERMON.length){PARTS.push({...p,id:'catechumens-before-mandatum',macros:p.macros.filter(x=>x!=='AO.SM.M09')},...MID_SERMON);if(flags.CREDO_APPOINTED)PARTS.push(aoR14PartForMacros('catechumens-credo','CREDO',['AO.SM.M09']));continue}
 if(p.id==='canon'&&MID_PATER.length){PARTS.push({...p,id:'canon-through-pater',macros:p.macros.filter(x=>x!=='AO.SM.M20')},...MID_PATER,aoR14PartForMacros('canon-fraction','FRACTION & PAX DOMINI',['AO.SM.M20']));continue}
 if(p.id==='conclusion'&&MID_COMMUNION.length){PARTS.push(...MID_COMMUNION)}
 if(p.id==='conclusion'&&MID_DISMISSAL.length){PARTS.push({...p,id:'conclusion-through-dismissal',macros:['AO.SM.M27','AO.SM.M28']},...MID_DISMISSAL,aoR14PartForMacros('conclusion-after-nuptial','PLACEAT · BLESSING · LAST GOSPEL',['AO.SM.M29','AO.SM.M30']));continue}
 PARTS.push(p)
}
