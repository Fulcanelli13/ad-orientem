const AO_FORM_PARAMS=new URLSearchParams(location.search);
function aoNormalizeMassProfile(raw,mcRaw){
  raw=String(raw||'').toLowerCase();mcRaw=String(mcRaw||'').toLowerCase();
  if(raw==='low')return 'low';
  if(raw==='mc-simple'||raw==='missa-cantata-simple')return 'mc-simple';
  if(raw==='mc-incense'||raw==='missa-cantata-incense')return 'mc-incense';
  if(raw==='mc'||raw==='missa-cantata'||raw==='missa_cantata')return mcRaw==='incense'?'mc-incense':'mc-simple';
  if(raw==='solemn'||raw==='solemn-mass'||raw==='high-mass')return 'solemn';
  if(raw==='sung')return 'mc-incense'; // legacy generic Sung link remains Missa Cantata-with-incense, not Solemn Mass.
  return null;
}
const AO_FORM_QUERY=aoNormalizeMassProfile(AO_FORM_PARAMS.get('form'),AO_FORM_PARAMS.get('mc_profile'));
const AO_FORM_STORED=(()=>{try{return aoNormalizeMassProfile(localStorage.getItem('ao-mass-profile')||localStorage.getItem('ao-mass-form'))}catch(_){return null}})();
const AO_SELECTED_FORM=AO_FORM_QUERY||AO_FORM_STORED||'low';
function aoNormalizeMassRite(raw){raw=String(raw||'').toLowerCase();if(['requiem','requiem-1962','req','mass-for-dead'].includes(raw))return 'requiem';if(['nuptial','wedding','nuptial-1962'].includes(raw))return 'nuptial';if(['holy-thursday','maundy-thursday','in-cena-domini'].includes(raw))return 'holy-thursday';if(['good-friday','in-passione-et-morte-domini'].includes(raw))return 'good-friday';if(['easter-vigil','holy-saturday','vigilia-paschalis'].includes(raw))return 'easter-vigil';return 'ordinary'}
const AO_RITE_QUERY=AO_FORM_PARAMS.has('rite')?aoNormalizeMassRite(AO_FORM_PARAMS.get('rite')):null;
const AO_RITE_STORED=(()=>{try{return aoNormalizeMassRite(localStorage.getItem('ao-mass-rite'))}catch(_){return 'ordinary'}})();
const AO_SELECTED_RITE=AO_RITE_QUERY||AO_RITE_STORED||'ordinary';
const AO_REQUIEM_ACTIVE=AO_SELECTED_RITE==='requiem';
const AO_REQUIEM_CANDLES=AO_REQUIEM_ACTIVE&&(AO_FORM_PARAMS.get('candles')==='1'||(()=>{try{return localStorage.getItem('ao-requiem-candles')==='1'}catch(_){return false}})());
function aoR14Setting(key,def=''){if(AO_FORM_PARAMS.has(key))return AO_FORM_PARAMS.get(key);try{const x=localStorage.getItem('ao-r14-'+key);return x==null?def:x}catch(_){return def}}
function aoR14Bool(key,def=false){const x=String(aoR14Setting(key,def?'1':'0')).toLowerCase();return ['1','true','yes','on'].includes(x)}
const AO_R14_PRE=String(aoR14Setting('pre','')).toUpperCase().replace(/[\s-]+/g,'_');
const AO_R14_PRE_DONE=aoR14Bool('pre_done',false);
const AO_R14_FOLLOWING_RAW=String(aoR14Setting('following','')).toUpperCase().replace(/[\s-]+/g,'_');
const AO_R14_FOLLOWING=({CORPUS:'CORPUS_PROCESSION',ABSOLUTION:'ABSOLUTION',PROCESSION:'PROCESSION'})[AO_R14_FOLLOWING_RAW]||AO_R14_FOLLOWING_RAW;
const AO_R14_BODY_PRESENT=aoR14Bool('body',false),AO_R14_BURIAL=aoR14Bool('burial',false),AO_R14_PARTICIPATING=aoR14Bool('participating',false);
const AO_R14_NUPTIAL_ELIGIBILITY=String(aoR14Setting('nuptial_eligibility','UNRESOLVED')).toUpperCase();
const AO_R14_PROPER_PATH=String(aoR14Setting('proper_path','')).trim(),AO_R14_PROPER_TITLE=String(aoR14Setting('proper_title','')).trim();
const AO_R14_SPECIAL=AO_SELECTED_RITE;
let DATA=JSON.parse(document.getElementById(AO_SELECTED_FORM==='low'?'mass-data':'mass-data-sung').textContent);
const AO_SOLEMN_MINISTER_EVENTS=[{"id":"SMIN-001","sourceMoment":"E07","cue":"AO.SM.C0040","actor":"THURIFER + DEACON","label":"INCENSE","action":"Thurifer presents incense; deacon assists the celebrant at the imposition and blessing.","authority":"v43.58 B006"},{"id":"SMIN-002","sourceMoment":"E07","cue":"AO.SM.C0041","actor":"DEACON + THURIFER","label":"ALTAR INCENSATION","action":"Deacon and thurifer assist the celebrant during the initial altar incensation.","authority":"v43.58 B006"},{"id":"SMIN-003","sourceMoment":"E12","cue":"AO.SM.C0075","actor":"SUBDEACON","label":"EPISTLE","action":"Subdeacon chants the Epistle at the appointed place.","authority":"SOT12 / OC64 / v43.58 B006"},{"id":"SMIN-004","sourceMoment":"E12","cue":"AO.SM.C0076","actor":"SUBDEACON","label":"EPISTLE COMPLETE","action":"Subdeacon returns after the Epistle for the celebrant’s blessing.","authority":"SOT12 / OC64 / v43.58 B006"},{"id":"SMIN-005","sourceMoment":"E16","cue":"AO.SM.C0079","actor":"DEACON","label":"GOSPEL PREPARATION","action":"Deacon prepares for the Gospel and prays Munda cor meum.","authority":"SOT12 / OC64 / v43.58 B006"},{"id":"SMIN-006","sourceMoment":"E16","cue":"AO.SM.C0080","actor":"DEACON","label":"BLESSING","action":"Deacon receives the celebrant’s blessing before the Gospel procession.","authority":"SOT12 / OC64 / v43.58 B006"},{"id":"SMIN-007","sourceMoment":"E16","cue":"AO.SM.C0081","actor":"DEACON + SUBDEACON","label":"GOSPEL PROCESSION","action":"Sacred ministers form the Gospel procession.","authority":"SOT12 / OC64 / v43.58 B006"},{"id":"SMIN-008","sourceMoment":"E18","cueRange":["AO.SM.C0082","AO.SM.C0088"],"actor":"DEACON","label":"PUBLIC GOSPEL","action":"Deacon proclaims the public Gospel; the celebrant does not duplicate it.","authority":"SOT12 / OC64 / v43.58 B006"},{"id":"SMIN-009","sourceMoment":"E27","cueRange":["AO.SM.C0120","AO.SM.C0124"],"actor":"DEACON + THURIFER","label":"OFFERTORY INCENSATION","action":"Sacred ministers assist the celebrant through the Offertory incensation.","authority":"SOT12 / OC64 / v43.58 B006"},{"id":"SMIN-010","sourceMoment":"E40","cue":"AO.SM.C0174","actor":"DEACON · SUBDEACON · TORCHBEARERS","label":"HOST ELEVATION","action":"Deacon raises the chasuble; subdeacon and torchbearers kneel for the elevation.","authority":"SOT12 / OC64 / v43.58 B006"},{"id":"SMIN-011","sourceMoment":"E44","cue":"AO.SM.C0181","actor":"DEACON · SUBDEACON · TORCHBEARERS","label":"CHALICE ELEVATION","action":"Deacon raises the chasuble; subdeacon and torchbearers remain kneeling for the elevation.","authority":"SOT12 / OC64 / v43.58 B006"},{"id":"SMIN-012","sourceMoment":"E51","cue":"AO.SM.C0212","actor":"SUBDEACON → DEACON","label":"PATEN HANDOFF","action":"Subdeacon hands the paten to the deacon, who presents it to the celebrant.","authority":"SOT12 / OC64 / v43.58 B006"},{"id":"SMIN-013","sourceMoment":"E55","cue":"AO.SM.C0225","actor":"DEACON → SUBDEACON","label":"SOLEMN PAX","action":"After the peace prayer, the celebrant gives the Pax to the deacon; it passes to the subdeacon and clergy.","canonicalMcEvent":"MC-0066","authority":"SOT12 / OC64 / v43.58 B006"},{"id":"SMIN-014","sourceMoment":"E64","cue":"AO.SM.C0246","actor":"DEACON + SUBDEACON","label":"COMMUNION","action":"Deacon assists the celebrant and holds the Communion paten; sacred ministers communicate in Solemn order.","authority":"SOT12 / OC64 / v43.58 B006"},{"id":"SMIN-015","sourceMoment":"E65","cueRange":["AO.SM.C0247","AO.SM.C0248"],"actor":"SUBDEACON + DEACON","label":"ABLUTIONS","action":"Subdeacon ministers wine and water and reassembles the chalice; deacon transfers the Missal.","authority":"SOT12 / OC64 / v43.58 B006"},{"id":"SMIN-016","sourceMoment":"E68","cue":"AO.SM.C0259","actor":"DEACON","label":"DISMISSAL","action":"Deacon sings the dismissal in Solemn Mass.","authority":"SOT12 / OC64 / recovery matrix E68"},{"id":"SMIN-017","sourceMoment":"E70","cue":"AO.SM.C0268","actor":"SUBDEACON","label":"LAST GOSPEL RESPONSE","action":"Subdeacon gives the prescribed response while the celebrant reads the Last Gospel quietly.","authority":"SOT12 / OC64 / v43.58 B006"},{"id":"SMIN-018","sourceMoment":"E70","cue":"AO.SM.C0270","actor":"SUBDEACON","label":"LAST GOSPEL RESPONSE","action":"Subdeacon gives the prescribed response.","authority":"SOT12 / OC64 / v43.58 B006"},{"id":"SMIN-019","sourceMoment":"E70","cue":"AO.SM.C0275","actor":"SUBDEACON","label":"LAST GOSPEL RESPONSE","action":"Subdeacon gives Deo gratias at the conclusion of the Last Gospel.","authority":"SOT12 / OC64 / v43.58 B006"}];
if(AO_SELECTED_FORM!=='low'){
  const solemn=AO_SELECTED_FORM==='solemn',incense=solemn||AO_SELECTED_FORM==='mc-incense';
  DATA.meta={...DATA.meta,profile:solemn?'Solemn Mass · 1962 · B006 sacred-minister topology':(incense?'Missa Cantata · Solemnized with incense · 1962':'Missa Cantata · Simple no-incense · 1962'),version:solemn?'v1.74e R04 Solemn Mass':'v1.74d R03 Missa Cantata'};
  DATA.profileFlags={...DATA.profileFlags,INCENSE_ENABLED:incense,DEFAULT_SUNG_PROFILE:true,AO_DEFAULT_1962_SUNG:true,LOW_MASS_PROFILE:false,LOW_MASS_DIALOGUE_RESPONSES:false,LOW_MASS_OCONNELL_PROFILE:false,SECOND_CONFITEOR_LOCAL_CUSTOM_ENABLED:false,MISSA_CANTATA_PROFILE:!solemn,MC_SIMPLE_NO_INCENSE:AO_SELECTED_FORM==='mc-simple',MC_SOLEMNIZED_WITH_INCENSE:AO_SELECTED_FORM==='mc-incense',SOLEMN_MASS_PROFILE:solemn,SACRED_MINISTERS_ACTIVE:solemn,DEACON_ACTIVE:solemn,SUBDEACON_ACTIVE:solemn,TORCHBEARERS_ACTIVE:solemn,SEDILIA_USED:true};
  if(solemn){
    const replacePriest=(cue,patch)=>{const i=(DATA.priestEvents||[]).findIndex(x=>x.Source_Cue_ID===cue);if(i>=0)DATA.priestEvents[i]={...DATA.priestEvents[i],...patch}};
    replacePriest('AO.SM.C0075',{Priest_Station:'SEDILIA',Facing:'EPISTLE',Posture:'Seated / listening',Action:'Celebrant sits and listens while the subdeacon chants the Epistle.',Voice:'LISTENS',Runtime_Actor_Override:'SUBDEACON'});
    replacePriest('AO.SM.C0076',{Priest_Station:'SEDILIA',Facing:'EPISTLE',Posture:'Seated / listening',Action:'Celebrant receives the completed Epistle and prepares to bless the subdeacon.',Voice:'LISTENS',Runtime_Actor_Override:'SUBDEACON'});
    for(const cue of ['AO.SM.C0079','AO.SM.C0080','AO.SM.C0081'])replacePriest(cue,{Priest_Station:'ALTAR_CENTER',Facing:'GOSPEL_PROCESSION',Action:'Deacon prepares for the Gospel; celebrant imposes incense / gives the blessing as prescribed.',Voice:'LISTENS',Runtime_Actor_Override:'DEACON'});
    for(const cue of ['AO.SM.C0082','AO.SM.C0083','AO.SM.C0084','AO.SM.C0085','AO.SM.C0086','AO.SM.C0087','AO.SM.C0088'])replacePriest(cue,{Priest_Station:'SOLEMN_CELEBRANT_TRACK',Facing:'TOWARD_GOSPEL',Action:'Celebrant attends while the deacon proclaims the public Gospel.',Voice:'LISTENS',Runtime_Actor_Override:'DEACON'});
    replacePriest('AO.SM.C0259',{Action:'Deacon sings the dismissal; celebrant remains at the altar.',Voice:'LISTENS',Runtime_Actor_Override:'DEACON'});
