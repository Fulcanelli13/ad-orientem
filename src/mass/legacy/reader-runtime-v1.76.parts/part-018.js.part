function aoApplyRequiemOverlay(data){
  const d=data,byBlock=new Map((d.blocks||[]).map(b=>[b.Block_ID,b])),byCue=new Map();
  (d.blocks||[]).forEach(b=>(b.units||[]).forEach(u=>byCue.set(u.cue_id,{b,u})));
  const patchPriest=(cue,patch)=>{const i=(d.priestEvents||[]).findIndex(x=>x.Source_Cue_ID===cue);if(i>=0)d.priestEvents[i]={...d.priestEvents[i],...patch}};
  const setUnit=(cue,latin,english)=>{const x=byCue.get(cue);if(x)Object.assign(x.u,{latin,english})};
  const filterUnit=(bid,cues)=>{const b=byBlock.get(bid);if(b)b.units=(b.units||[]).filter(u=>!cues.includes(u.cue_id))};
  d.meta={...d.meta,colour:'Black',profile:`${d.meta?.profile||''} · Requiem overlay`,version:'v1.74g R06 Requiem variance overlay'};
  d.profileFlags={...d.profileFlags,REQUIEM_OVERLAY_ACTIVE:true,GLORIA_APPOINTED:false,CREDO_APPOINTED:false,REQUIEM_CANDLES_DISTRIBUTED:AO_REQUIEM_CANDLES,REQUIEM_LAST_GOSPEL_DEFAULT:true,REQUIEM_GOSPEL_LIGHTS:false,REQUIEM_GOSPEL_INCENSE:false,REQUIEM_GOSPEL_BOOK_KISS:false,REQUIEM_PEACE_PRAYER:false,REQUIEM_FINAL_BLESSING:false};
  d.requiemVarianceGraph=AO_REQUIEM_VARIANCES.map(x=>({...x}));
  d.requiemOverlay={version:'R06',authority:'v43.73 RG-004 / MR62 Ritus XIII',inheritance:'UNLISTED_EVENTS_INHERIT_CERTIFIED_BASE_FORM',candlesDistributed:AO_REQUIEM_CANDLES,suppressedMc:['MC-0013','MC-0017','MC-0023','MC-0025','MC-0065','MC-0081']};
  // Fail closed on Requiem Propers until the dedicated proper resolver supplies them (R09).
  d.fixture=(d.fixture||[]).map(f=>({...f,Requiem_Required:true,Requiem_Source_Title:f.Resolved_Title||null,Requiem_Source_URL:f.Source_URL||null,Resolved_Title:`Requiem Proper — ${f.Proper_Slot||'TEXT'} · unresolved`,Latin_Text:`[REQUIEM PROPER · ${f.Proper_Slot||'TEXT'} · resolver required]`,English_Text:`[Requiem Proper · ${f.Proper_Slot||'text'} · resolver required]`,Source_URL:'',Notes:'R06 fail-closed: dedicated Requiem Proper must be supplied by the Proper resolver; ordinary fixture suppressed.'}));
  (d.blocks||[]).forEach(b=>{if(!b.Proper_Slot)return;b.Requiem_Proper_Unresolved=true;b.Requiem_Source_Title=b.Title||null;b.Requiem_Source_Units=(b.units||[]).map(u=>({...u}));b.Title=`${String(b.Proper_Slot).replaceAll('_',' · ')} · Requiem Proper unresolved`;const first=(b.units||[])[0];if(first)b.units=[{...first,latin:`[REQUIEM PROPER · ${b.Proper_Slot} · resolver required]`,english:`[Requiem Proper · ${b.Proper_Slot} · resolver required]`,clock:'PUBLIC_TEXT',runtime_requiem_placeholder:true}];});
  const chant=byBlock.get('AO.SM.B022');if(chant)chant.Title='Requiem Gradual · Tract · Sequence';
  // R06 executes the recovered variance states against the modern AO.SM surfaces.
  patchPriest('AO.SM.C0042',{Trigger_Text:'[SIGNS THE INTROIT TEXT / MISSAL — NOT HIMSELF]',Action:'Makes the Sign of the Cross over the Introit text / Missal rather than signing himself; the Gloria Patri is omitted.',RequiemVariance:'REQ-INT-010'});
  filterUnit('AO.SM.B026',['AO.SM.C0088']);
  filterUnit('AO.SM.B037',['AO.SM.C0126','AO.SM.C0127']);
  const lavabo=byCue.get('AO.SM.C0125');if(lavabo)lavabo.u.english=String(lavabo.u.english||'').replace(/\n℣\. Glory be to the Father[\s\S]*$/,'').trim();
  // The faithful/reader gesture projection must not resurrect the ordinary Agnus breast strikes in a Requiem.
  d.gestures=(d.gestures||[]).filter(g=>g.Gesture_ID!=='AO.SM.G025');
  setUnit('AO.SM.C0222','Agnus Dei, qui tollis peccáta mundi: dona eis réquiem.','Lamb of God, who takest away the sins of the world: grant them rest.');
  setUnit('AO.SM.C0223','Agnus Dei, qui tollis peccáta mundi: dona eis réquiem.','Lamb of God, who takest away the sins of the world: grant them rest.');
  setUnit('AO.SM.C0224','Agnus Dei, qui tollis peccáta mundi: dona eis réquiem sempitérnam.','Lamb of God, who takest away the sins of the world: grant them eternal rest.');
  setUnit('AO.SM.C0259','℣. Requiéscant in pace.','℣. May they rest in peace.');setUnit('AO.SM.C0260','℟. Amen.','℟. Amen.');
  patchPriest('AO.SM.C0112',{Action:'Does not bless the water in a Mass for the Dead; the prayer itself is retained.',RequiemVariance:'REQ-OFF-010'});
  patchPriest('AO.SM.C0124',{Action:'At the Requiem Offertory incensation, the gifts and altar are incensed and the celebrant is incensed; other clergy and the faithful are not incensed.',RequiemVariance:'REQ-SOL-020'});
  patchPriest('AO.SM.C0125',{Action:'Washes the prescribed fingers while reciting Psalm 25; Gloria Patri is omitted.',RequiemVariance:'REQ-LAV-010'});
  for(const cue of ['AO.SM.C0222','AO.SM.C0223','AO.SM.C0224'])patchPriest(cue,{Action:'Recites the Requiem Agnus Dei without striking the breast.',RequiemVariance:'REQ-AGN-010'});
  patchPriest('AO.SM.C0259',{Action:AO_SELECTED_FORM==='solemn'?'Deacon sings Requiescant in pace; celebrant remains at the altar.':'Says or sings Requiescant in pace according to the selected form.',RequiemVariance:'REQ-END-010'});
  if(AO_SELECTED_FORM==='solemn'){
    // In the Solemn Requiem the deacon retains Munda cor meum, but the blessing formula is omitted.
    filterUnit('AO.SM.B023',['AO.SM.C0080']);
    for(const cue of ['AO.SM.C0082','AO.SM.C0083','AO.SM.C0084','AO.SM.C0085','AO.SM.C0086','AO.SM.C0087'])patchPriest(cue,{RequiemCeremonial:'NO_GOSPEL_LIGHTS_NO_GOSPEL_INCENSE_NO_BOOK_KISS'});
    patchPriest('AO.SM.C0212',{Action:'Celebrant handles the paten without the ordinary Solemn subdeacon paten-holding topology.',RequiemVariance:'REQ-SOL-030'});
    d.ministerEvents=(d.ministerEvents||[]).filter(x=>!['SMIN-006','SMIN-012','SMIN-013'].includes(x.id)).map(x=>
      x.id==='SMIN-007'?{...x,action:'Sacred ministers form the Requiem Gospel procession without the ordinary Gospel lights or incense.'}:
      x.id==='SMIN-008'?{...x,action:'Deacon proclaims the Requiem Gospel without Gospel lights or incense; the book is not kissed and no celebrant incensation follows.'}:
      x.id==='SMIN-009'?{...x,action:'At the Requiem Offertory, incense is used for the gifts, altar and celebrant; other clergy and faithful are not incensed.'}:
      x.id==='SMIN-010'?{...x,action:'At the Host elevation the deacon assists the celebrant; the subdeacon kneels at the Epistle side and incenses the Blessed Sacrament; torchbearers remain kneeling.'}:
      x.id==='SMIN-011'?{...x,action:'At the Chalice elevation the deacon assists the celebrant; the subdeacon kneels at the Epistle side and incenses the Blessed Sacrament; torchbearers remain kneeling.'}:x);
  }
  d.requiemConditionalObjects=AO_REQUIEM_CANDLES?[
    {id:'REQ-CANDLE-010',cue:'AO.SM.C0076',state:'CANDLE_DISTRIBUTED',action:'Receive funeral candle after the Epistle if candles are distributed.'},
    {id:'REQ-CANDLE-020',cues:['AO.SM.C0084','AO.SM.C0174','AO.SM.C0181'],state:'CANDLE_LIT',action:'Light the distributed candle at the Gospel and Elevations.'}
  ]:[];
  return d;
}
if(AO_REQUIEM_ACTIVE)DATA=aoApplyRequiemOverlay(DATA);
function aoR14Text(v){return String(v||'').trim()}
function aoR14JoinTexts(xs){return (xs||[]).map(x=>x||{}).reduce((a,x)=>({lat:[a.lat,x.lat].filter(Boolean).join('\n\n'),en:[a.en,x.en].filter(Boolean).join('\n\n'),fr:[a.fr,x.fr].filter(Boolean).join('\n\n')}),{lat:'',en:'',fr:''})}
function aoR14StripAmen(t){return {lat:aoR14Text(t?.lat).replace(/\s*Amen\.?\s*$/i,'').trim(),en:aoR14Text(t?.en).replace(/\s*Amen\.?\s*$/i,'').trim(),fr:aoR14Text(t?.fr).replace(/\s*(Ainsi soit-il|Amen)\.?\s*$/i,'').trim()}}
function aoR14StripReadingResponse(t){return {lat:aoR14Text(t?.lat).replace(/\n?℟\.\s*(Deo grátias|Laus tibi, Christe)\.?\s*$/i,'').trim(),en:aoR14Text(t?.en).replace(/\n?℟\.\s*(Thanks be to God|Praise be to Thee, O Christ)\.?\s*$/i,'').trim(),fr:aoR14Text(t?.fr)}}
function aoR14StripSecretTail(t){return {lat:aoR14Text(t?.lat).replace(/\s*per ómnia s[æǽ]cula s[æǽ]culórum\.?(?:\s*Amen\.?)?\s*$/i,'').trim(),en:aoR14Text(t?.en).replace(/\s*world without end\.?(?:\s*Amen\.?)?\s*$/i,'').trim(),fr:aoR14Text(t?.fr).replace(/\s*dans tous les siècles des siècles\.?(?:\s*Ainsi soit-il\.?)?\s*$/i,'').trim()}}
function aoR14PatchProper(data,packet){
 const p=packet?.proper;if(!p)return false;
 const map={
  'AO.SM.B014':p.introit,
  'AO.SM.B019':aoR14StripAmen(aoR14JoinTexts(p.collects||[p.collect])),
  'AO.SM.B020':aoR14StripReadingResponse(p.epistle),
  'AO.SM.B021':aoR14JoinTexts([p.gradual,p.sequence]),
  'AO.SM.B022':null,
  'AO.SM.B026':aoR14StripReadingResponse(p.gospel),
  'AO.SM.B030':p.offertory,
  'AO.SM.B040':aoR14StripSecretTail(aoR14JoinTexts(p.secrets||[p.secret])),
  'AO.SM.B045':p.preface,
  'AO.SM.B085':p.communion,
  'AO.SM.B088':aoR14StripAmen(aoR14JoinTexts(p.postcommunions||[p.postcommunion]))
 };
 const title={INTROIT:'Introit',COLLECT_SET:'Collect',EPISTLE_OR_LESSON:'Epistle / Lesson',GRADUAL:'Gradual',ALLELUIA_TRACT_SEQUENCE:'Alleluia / Tract / Sequence',GOSPEL:'Holy Gospel',OFFERTORY:'Offertory',SECRET_SET:'Secret',PREFACE:'Preface',COMMUNION:'Communion',POSTCOMMUNION_SET:'Postcommunion'};
 for(const b of data.blocks||[]){const t=map[b.Block_ID];if(!t)continue;const first=(b.units||[]).find(u=>u.type==='text');if(first){first.latin=aoR14Text(t.lat)||`[${title[b.Proper_Slot]||b.Proper_Slot} · Latin unavailable]`;first.english=aoR14Text(t.en)||`[${title[b.Proper_Slot]||b.Proper_Slot} · English unavailable]`;first.french=aoR14Text(t.fr)||'';first.runtime_proper_source=p.sourcePath;b.Requiem_Proper_Unresolved=false;b.R09_Proper_Source=p.sourcePath;b.Title=`${title[b.Proper_Slot]||b.Title} — ${p.name||packet.path}`}}
 for(const f of data.fixture||[]){const b=(data.blocks||[]).find(x=>x.Block_ID===f.Block_ID),u=(b?.units||[]).find(x=>x.type==='text');if(!u)continue;f.Resolved_Title=b.Title;f.Latin_Text=u.latin;f.English_Text=u.english;f.Source_URL='';f.Notes=`R09 resolved proper · ${p.sourcePath}`;delete f.Requiem_Required}
 data.meta={...data.meta,dayEnglish:p.name||data.meta.dayEnglish,dayLatin:p.name||data.meta.dayLatin,rank:p.rank||data.meta.rank,colour:p.color||data.meta.colour,properSource:p.sourcePath,properResolver:'R09-v43.39',celebrationType:p.celebrationType||packet?.meta?.celebrationType||'manual'};
 if(typeof p.showGloria==='boolean')data.profileFlags.GLORIA_APPOINTED=p.showGloria;if(typeof p.showCredo==='boolean')data.profileFlags.CREDO_APPOINTED=p.showCredo;
 data.profileFlags.R09_COMBINED_PRE_GOSPEL_CHANT=true;const pg=(data.blocks||[]).find(b=>b.Block_ID==='AO.SM.B021');if(pg)pg.Title='Gradual · Alleluia / Tract / Sequence';data.r09Proper=p;return true
