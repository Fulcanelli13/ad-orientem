 };
 if(exact[label])return exact[label];
 const u=String(label||'').toUpperCase();
 if(/SPRINKL|ASPERG/.test(u))return 'SEM:ACTION.SPRINKLING';
 if(/PROSTRAT/.test(u))return 'SEM:ACTION.PROSTRATION';
 if(/HANDS.*OBLATION|HANC IGITUR/.test(u))return 'SEM:PRIEST.HANDS.OVER_OBLATION';
 return '';
}
function setIconHtml(el,key,fallback=''){if(!el)return;const ok=!!(key&&aoHasIcon(key));el.innerHTML=ok?assetImg(key):'';if(key&&!ok)el.dataset.iconMissing=key;else delete el.dataset.iconMissing}
window.__AO_SET_ICON_HTML=setIconHtml;
function updatePriestPositionIcon(priest){
 const el=$('#priestPositionIcon'); if(!el)return;
 const key=priest?stationAssetKey(priest.Priest_Station):'';
 el.innerHTML=key?assetImg(key,'section-icon'):'<span class="priest-mark"></span>';
