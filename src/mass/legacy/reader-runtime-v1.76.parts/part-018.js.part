ACTIVE_OVERLAYS.forEach(ov=>{if(ov.part?.id&&ov.liveCard)LIVE_CARD_LAYOUT[ov.part.id]=[ov.liveCard]});
function singleCardSpec(macroId){return {id:macroId,title:macroMap[macroId]?.Moment||macroId,macros:[macroId]}}
function cardSpecsForPart(part){if(!part)return [];if(mode==='live'&&LIVE_CARD_LAYOUT[part.id]?.length)return LIVE_CARD_LAYOUT[part.id];return part.macros.map(singleCardSpec)}
function cardSpecAt(part,idx){return cardSpecsForPart(part)[idx]||null}
function cardIndexForMacro(part,macroId){const specs=cardSpecsForPart(part),i=specs.findIndex(x=>x.macros.includes(macroId));return i<0?0:i}
function cardIndexForAnchor(part,anchor){const specs=cardSpecsForPart(part);if(anchor?.cue){const hit=specs.findIndex(spec=>{const macros=cardMacros(spec);return runtimeBlocksForMacros(macros).filter(b=>!Array.isArray(spec.blocks)||spec.blocks.includes(b.Block_ID)).some(b=>(b.units||[]).some(u=>u.cue_id===anchor.cue))});if(hit>=0)return hit}return cardIndexForMacro(part,anchor?.macro||'')}
function cardMacros(spec){return Array.isArray(spec?.macros)?spec.macros:[String(spec||'')]}
let partIndex=0,cardIndex=0,partTrack=null,partTransitioning=false,wheelAccum=0,touchStart=null;

function norm(s){return (s||'').toString().normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[✠✝℣℟]/g,'').replace(/[^a-z0-9]+/g,' ').trim()}
// v1.18 — strict runtime condition profile. Unknown tokens must never silently activate a state.
const RUNTIME_CONDITION_DEFAULTS={
 AGNUS_DEI_PUBLIC:true,
 CANON_START:true,
 COMMUNION_PREPARATION:true,
 LAST_GOSPEL_PRESENT:true,
 POSTCOMMUNION_GREETING:true,
 PREFACE_DIALOGUE:true,
 PEOPLE_INCENSED:()=>!!flags.INCENSE_ENABLED,
 PERSONALLY_SINGING_OR_PROFILE_STAND:false,
 POST_CONSECRATION_STAND_PROFILE:()=>!!flags.LOW_MASS_STAND_AFTER_CONSECRATION,
 LOCAL_PROFILE_SIT_AFTER_COMMUNION:()=>!!flags.LOCAL_PROFILE_SIT_AFTER_COMMUNION,
 LOW_MASS_PROFILE:()=>!!flags.LOW_MASS_PROFILE,
 LOW_MASS_STAND_AFTER_CONSECRATION:()=>!!flags.LOW_MASS_STAND_AFTER_CONSECRATION,
 LOCAL_PROFILE_KNEEL_FOR_BLESSING:()=>!!flags.LOCAL_PROFILE_KNEEL_FOR_BLESSING,
 NEVER_LOW_MASS_SUNG_KYRIE:false,
 NEVER_LOW_MASS_GLORIA_SINGING:false,
 NEVER_LOW_MASS_SEDILIA:false,
 NEVER_LOW_MASS_COLLECT_STAND:false,
 NEVER_LOW_MASS_OFFERTORY_GREETING_STAND:false,
 NEVER_LOW_MASS_INCENSE:false
};
function christmasOrAnnunciationIncarnatus(){
 const d=String(RITE_CONTEXT?.date||DATA.meta?.date||'');
 return /-(?:12-25|03-25)$/.test(d);
}
const RUNTIME_UNKNOWN_CONDITIONS=new Set();
function runtimeConditionDefault(t){const v=RUNTIME_CONDITION_DEFAULTS[t];return typeof v==='function'?!!v():!!v}
function truthToken(t){
 t=t.trim(); if(!t)return true;
 if(t.startsWith('NOT_')){const k=t.slice(4); return !truthToken(k)}
 if(Object.prototype.hasOwnProperty.call(flags,t)) return !!flags[t];
 if(Object.prototype.hasOwnProperty.call(RUNTIME_CONDITION_DEFAULTS,t)) return runtimeConditionDefault(t);
 if(t.includes('REQUIEM'))return false;
 if(t.includes('OMIT_'))return false;
 RUNTIME_UNKNOWN_CONDITIONS.add(t);return false;
}
function cond(expr){if(!expr)return true; expr=String(expr).trim(); if(!expr)return true; return expr.split('||').some(group=>group.split('&&').every(x=>truthToken(x.trim())))}
function blockEnabled(b){
 const id=b.Block_ID,immediateSpecial=RITE_CONTEXT.preMassRiteActuallyOccurred&&RITE_CONTEXT.massFollowsImmediately&&['PALM','ASH','CND','CANDLEMAS','ROGATION','ROGATIONS','GREATER_LITANIES','MINOR_LITANIES'].includes(RITE_CONTEXT.preMassRite);
 if(immediateSpecial&&/^AO\.SM\.B0(?:0[1-9]|1[0-3])$/.test(id))return false;
 if(RITE_CONTEXT.preMassRite==='PALM'&&RITE_CONTEXT.preMassRiteActuallyOccurred&&RITE_CONTEXT.palmProcessionOccurred&&['AO.SM.B093','AO.SM.B094','AO.SM.B095'].includes(id))return false;
 if(RITE_CONTEXT.holyThursday&&id==='AO.SM.B003')return false;
 if(RITE_CONTEXT.holyThursday&&['AO.SM.B027','AO.SM.B069','AO.SM.B092','AO.SM.B093','AO.SM.B094','AO.SM.B095'].includes(id))return false;
 if(RITE_CONTEXT.easterVigil&&['AO.SM.B001','AO.SM.B002','AO.SM.B003','AO.SM.B004','AO.SM.B005','AO.SM.B006','AO.SM.B007','AO.SM.B008','AO.SM.B009','AO.SM.B010','AO.SM.B011','AO.SM.B012','AO.SM.B013','AO.SM.B014','AO.SM.B021','AO.SM.B027','AO.SM.B030','AO.SM.B068','AO.SM.B069','AO.SM.B085','AO.SM.B093','AO.SM.B094','AO.SM.B095'].includes(id))return false;
 if(flags.REQUIEM_OVERLAY_ACTIVE&&['AO.SM.B003','AO.SM.B069','AO.SM.B092'].includes(id))return false;
 if(flags.REQUIEM_OVERLAY_ACTIVE&&AO.RequiemAbsolutionR07?.active?.(RITE_CONTEXT)&&['AO.SM.B093','AO.SM.B094','AO.SM.B095'].includes(id))return false;
 if(AO.ProcessionsR12?.corpusSelected?.(RITE_CONTEXT)&&['AO.SM.B092','AO.SM.B093','AO.SM.B094','AO.SM.B095'].includes(id))return false;
 if(['AO.SM.B077','AO.SM.B078','AO.SM.B079'].includes(id)) return !!flags.SECOND_CONFITEOR_LOCAL_CUSTOM_ENABLED;
 if(id==='AO.SM.B013'||id==='AO.SM.B036') return !!flags.INCENSE_ENABLED;
 if(id==='AO.SM.B022'&&flags.R09_COMBINED_PRE_GOSPEL_CHANT)return false;
 if(id==='AO.SM.B016') return !!flags.GLORIA_APPOINTED;
 if(id==='AO.SM.B027') return !!flags.CREDO_APPOINTED;
 if(id==='AO.SM.B096') return !!flags.SERMON_INCLUDED;
 return true;
}
function prettyStation(id){const short={FOOT_CENTER:'AT THE FOOT',ALTAR_STEPS_ASCENDING:'ASCENDING ALTAR',ALTAR_CENTER:'ALTAR CENTRE',ALTAR_EPISTLE_MISSAL:'EPISTLE SIDE',ALTAR_EPISTLE_SIDE:'EPISTLE SIDE',ALTAR_GOSPEL_MISSAL:'GOSPEL SIDE',ALTAR_GOSPEL_SIDE:'GOSPEL SIDE',ALTAR_FRONT_EPISTLE_HALF:'ALTAR · EPISTLE HALF',ALTAR_FRONT_GOSPEL_HALF:'ALTAR · GOSPEL HALF',ALTAR_BACK_ROUTE:'BEHIND ALTAR',SEDILIA:'SEDILIA',COMMUNION_RAIL:'COMMUNION RAIL',PREACHING_PLACE:'PULPIT / AMBO',ROUTE_CONTROLLED:'ALTAR INCENSATION ROUTE',PRIEST_TRACK_ASYNC:'PRIEST TRACK',PROCESSION_ROUTE:'ASPERSION PROCESSION'};return short[id]||(id||'—').replaceAll('_',' · ').toLowerCase().replace(/(^| · )\w/g,m=>m.toUpperCase())}
