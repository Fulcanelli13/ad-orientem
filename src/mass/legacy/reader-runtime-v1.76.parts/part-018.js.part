function parseIsoCalendarDate(value){
 const m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(String(value||''));if(!m)return null;
 const y=Number(m[1]),mo=Number(m[2]),d=Number(m[3]);const dt=new Date(Date.UTC(y,mo-1,d));
 if(dt.getUTCFullYear()!==y||dt.getUTCMonth()!==mo-1||dt.getUTCDate()!==d)return null;return dt;
}
function isoCalendarDate(dt){return `${dt.getUTCFullYear()}-${String(dt.getUTCMonth()+1).padStart(2,'0')}-${String(dt.getUTCDate()).padStart(2,'0')}`}
function addCalendarDays(dt,days){const x=new Date(dt.getTime());x.setUTCDate(x.getUTCDate()+Number(days||0));return x}
function gregorianEaster(year){
 // Gregorian computus; returns Easter Sunday as a UTC date-only value.
 const a=year%19,b=Math.floor(year/100),c=year%100,d=Math.floor(b/4),e=b%4,f=Math.floor((b+8)/25),g=Math.floor((b-f+1)/3),h=(19*a+b-d-g+15)%30,i=Math.floor(c/4),k=c%4,l=(32+2*e+2*i-h-k)%7,m=Math.floor((a+11*h+22*l)/451),month=Math.floor((h+l-7*m+114)/31),day=((h+l-7*m+114)%31)+1;
 return new Date(Date.UTC(year,month-1,day));
}
function deriveRiteContext(dateValue,selection={}){
 const date=parseIsoCalendarDate(dateValue);if(!date)throw new Error(`Invalid liturgical date: ${dateValue}`);
 const easter=gregorianEaster(date.getUTCFullYear()),ash=addCalendarDays(easter,-46),passion=addCalendarDays(easter,-14),palm=addCalendarDays(easter,-7),pentecost=addCalendarDays(easter,49);
 const same=x=>isoCalendarDate(x)===isoCalendarDate(date),massType=String(selection.massType||'ORDINARY').toUpperCase();
 return Object.freeze({
  date:isoCalendarDate(date),isSunday:date.getUTCDay()===0,principalMass:selection.principalMass!==false,massType,
  paschaltide:date>=easter&&date<=pentecost,passionSunday:same(passion),palmSunday:same(palm),candlemas:(date.getUTCMonth()===1&&date.getUTCDate()===2),ashWednesday:same(ash),
  christmas:(date.getUTCMonth()===11&&date.getUTCDate()===25),annunciation:(date.getUTCMonth()===2&&date.getUTCDate()===25),
  nuptial:massType==='NUPTIAL',requiem:massType==='REQUIEM',holyThursday:selection.specialRite==='holy-thursday',goodFriday:selection.specialRite==='good-friday',easterVigil:selection.specialRite==='easter-vigil',rite:selection.specialRite,preMassRite:selection.preMassRite,preMassRiteActuallyOccurred:selection.preMassRiteActuallyOccurred,massFollowsImmediately:selection.massFollowsImmediately,followingAction:selection.followingAction,bodyPresent:selection.bodyPresent,burialProcession:selection.burialProcession,nuptialEligibility:selection.nuptialEligibility,mandatumPastorallyUsed:selection.mandatumPastorallyUsed,repositionActuallyOccurs:selection.repositionActuallyOccurs,palmProcessionOccurred:selection.palmProcessionOccurred,personal:selection.personal,
  calendar:{easter:isoCalendarDate(easter),ashWednesday:isoCalendarDate(ash),passionSunday:isoCalendarDate(passion),palmSunday:isoCalendarDate(palm),pentecost:isoCalendarDate(pentecost),trinitySunday:isoCalendarDate(addCalendarDays(pentecost,7))}
 });
}
const RITE_CONTEXT=deriveRiteContext(DATA.meta.date||'2026-10-04',RITE_SELECTION);
