function aoR14Human(x){return String(x||'').replaceAll('_',' ').replace(/\b\w/g,c=>c.toUpperCase())}
function aoR14EventTitle(e){return e.title||e.moment||aoR14Human(e.trigger_key||e.id)}
function aoR14StateUnit(e,cue,sort){const common={cue_id:cue,sort,clock:'SPECIAL_RITE',posture:String(e.posture_state||'INHERIT').split(' / ')[0],station:'SPECIAL_RITE',facing:'RITE',voice:'VISIBLE / RITE',action:e.action_state||e.instruction||aoR14EventTitle(e),objectState:e.object_state||null,specialEventId:e.id};if(e.latin||e.english)return {...common,type:'text',latin:e.latin||aoR14EventTitle(e),english:e.english||e.action_state||e.instruction||aoR14EventTitle(e)};return {...common,type:'state',state_label:aoR14EventTitle(e)}}
function aoR14OverlayFromEvents(id,title,placement,events,priority=30,icon='cross'){
 const seq=++AO_R14_OVERLAY_SEQ,macroId=`AO.R14.M${String(seq).padStart(3,'0')}`,blockId=`AO.R14.B${String(seq).padStart(3,'0')}`;
 const units=(events||[]).map((e,i)=>aoR14StateUnit(e,`${blockId}.C${String(i+1).padStart(3,'0')}`,-1000+seq*10+i));
 return {Overlay_ID:id,placement,priority,variant:'R14',part:{id:`r14-${id.toLowerCase().replace(/[^a-z0-9]+/g,'-')}`,title,icon},liveCard:{id:`AO.LIVE.R14.${seq}`,title,macros:[macroId]},macro:{Macro_ID:macroId,Sequence:-100+seq,Moment:title,Primary_Clock:'SPECIAL_RITE',Guide_Copy_EN:title,Next_Reliable_Cue:'Next rite boundary.',Concurrency_Rule:'R14 recovered special-rite graph.'},blocks:[{RuntimeOverlay:true,Overlay_ID:id,Block_ID:blockId,Macro_ID:macroId,Display_Order:-1000+seq,Title:title,Part:title,Proper_Slot:'',units}]}
}
function aoR14OverlaysByPhase(prefix,title,placement,events,priority=30){const groups=new Map();for(const e of events||[]){const p=e.phase||'RITE';if(!groups.has(p))groups.set(p,[]);groups.get(p).push(e)}let n=0;return [...groups.entries()].map(([phase,evs])=>aoR14OverlayFromEvents(`${prefix}.${++n}`,`${title} · ${aoR14Human(phase)}`,placement,evs,priority+n))}
function aoR14PreEvents(kind){const api=AO.SpecialPreMassR10;if(!api)return [];const ctx=RITE_CONTEXT;if(kind==='ROG')return AO.ProcessionsR12?.projectRogation?.(ctx)||[];return api.projectRite({...ctx,preMassRite:kind,preMassRiteActuallyOccurred:true},{lane:'faithful'})}
function aoR14BuildPalm(){return aoR14OverlaysByPhase('AO.OV.PALM','PALM SUNDAY','BEFORE_MASS',aoR14PreEvents('PALM'),20)}
function aoR14BuildAsh(){return aoR14OverlaysByPhase('AO.OV.ASH','ASH WEDNESDAY','BEFORE_MASS',aoR14PreEvents('ASH'),20)}
function aoR14BuildCandle(){return aoR14OverlaysByPhase('AO.OV.CND','CANDLEMAS','BEFORE_MASS',aoR14PreEvents('CND'),20)}
function aoR14BuildRog(){return aoR14OverlaysByPhase('AO.OV.ROG','ROGATION / LITANIES','BEFORE_MASS',aoR14PreEvents('ROG'),20)}
function aoR14BuildGoodFriday(){return aoR14OverlaysByPhase('AO.OV.GF','GOOD FRIDAY','BEFORE_MASS',AO.TriduumR11?.projectGoodFriday?.(RITE_CONTEXT)||[],5)}
function aoR14BuildEasterVigil(){return aoR14OverlaysByPhase('AO.OV.EV','EASTER VIGIL','BEFORE_MASS',AO.TriduumR11?.projectEasterVigilPreMass?.(RITE_CONTEXT)||[],5)}
function aoR14BuildEasterVigilLauds(){const xs=AO.TriduumR11?.source?.EASTER_VIGIL_MASS_OVERLAY?.insertions||[];return xs.length?[aoR14OverlayFromEvents('AO.OV.EV.LAUDS','EASTER VIGIL · LAUDS','MID_AFTER_COMMUNION',xs.map(x=>({id:x.id,phase:'LAUDS',posture_state:x.posture,action_state:x.action,moment:x.id})),75)]:[]}
function aoR14BuildHolyThursdayPost(){return aoR14OverlaysByPhase('AO.OV.HT.POST','HOLY THURSDAY','AFTER_MASS',AO.TriduumR11?.projectHolyThursdayPostMass?.(RITE_CONTEXT)||[],80)}
function aoR14BuildAbsolution(){return aoR14OverlaysByPhase('AO.OV.ABS','FUNERAL ABSOLUTION','AFTER_MASS',AO.RequiemAbsolutionR07?.project?.(RITE_CONTEXT)||[],70)}
function aoR14BuildCorpus(){return aoR14OverlaysByPhase('AO.OV.CORPUS','CORPUS CHRISTI PROCESSION','AFTER_MASS',AO.ProcessionsR12?.projectCorpus?.(RITE_CONTEXT)||[],70)}
function aoR14BuildGenericProcession(){return aoR14OverlaysByPhase('AO.OV.PROC','FOLLOWING PROCESSION','AFTER_MASS',AO.ProcessionsR12?.projectGenericProcession?.(RITE_CONTEXT)||[],70)}
function aoR14NuptialPre(){const ev=(AO.NuptialR08?.graph||[]).filter(x=>x.sequence<=6);return [aoR14OverlayFromEvents('AO.OV.NUP.PRE','MARRIAGE RITE','BEFORE_MASS',ev,15)]}
function aoR14NuptialText(section){return AO.NuptialR08?.section?.(AO.R09State?.packet?.proper,section)||null}
function aoR14NuptialMid(){const t1=aoR14NuptialText('Benedictio Nuptialis 1'),t2=aoR14NuptialText('Benedictio Nuptialis 2');const ev=[{id:'NUP.008',phase:'MASS_INSERT',posture_state:'SPOUSES_KNEEL',action_state:'Celebrant turns/goes to Epistle side toward the kneeling spouses.',moment:'Nuptial blessing after Pater'},{id:'NUP.009',phase:'MASS_INSERT',posture_state:'ATTEND',action_state:t1?.en||'[First nuptial prayer unresolved — resolve Votive/Matrimonium]',english:t1?.en,moment:'Propitiare, Domine',latin:t1?.lat},{id:'NUP.010',phase:'MASS_INSERT',posture_state:'ATTEND',action_state:t2?.en||'[Second nuptial prayer unresolved — resolve Votive/Matrimonium]',english:t2?.en,moment:'Deus, qui potestate',latin:t2?.lat}];return [aoR14OverlayFromEvents('AO.OV.NUP.MID','NUPTIAL BLESSING','MID_AFTER_PATERNOSTER',ev,45)]}
function aoR14NuptialEnd(){const tf=aoR14NuptialText('Benedictio Finalis');const ev=[{id:'NUP.012',phase:'MASS_INSERT',posture_state:'ATTEND',action_state:tf?.en||'[Final nuptial blessing unresolved — resolve Votive/Matrimonium]',english:tf?.en,moment:'Final nuptial blessing',latin:tf?.lat},{id:'NUP.013',phase:'MASS_INSERT',posture_state:'ATTEND',action_state:'Priest admonishes and sprinkles the spouses; no congregational Asperges gesture.',moment:'Admonition and sprinkling'}];return [aoR14OverlayFromEvents('AO.OV.NUP.END','FINAL NUPTIAL BLESSING','MID_AFTER_DISMISSAL',ev,65)]}
function aoR14Mandatum(){return aoR14OverlaysByPhase('AO.OV.HT.MAND','MANDATUM','MID_AFTER_SERMON',AO.TriduumR11?.projectMandatum?.(RITE_CONTEXT)||[],40)}
function aoR14BlockedNuptial(){return [aoR14OverlayFromEvents('AO.OV.NUP.BLOCKED','NUPTIAL ELIGIBILITY','BEFORE_MASS',[{id:'NUP.015',phase:'CALENDAR_RULE',posture_state:'INHERIT',action_state:'Nuptial eligibility is unresolved or not permitted. Resolve it before entering the Nuptial Mass.',moment:'Nuptial Mass blocked'}],1)]}
const RITE_OVERLAY_REGISTRY=[
 {Overlay_ID:'AO.OV.SUNDAY_ASPERSION',placement:'BEFORE_MASS',priority:10,status:'IMPLEMENTED',enabledWhen:ctx=>ctx.preMassRite==='ASPERGES'&&ctx.preMassRiteActuallyOccurred,build:buildSundayAspersionOverlay},
 {Overlay_ID:'AO.OV.PALM',placement:'BEFORE_MASS',priority:20,status:'IMPLEMENTED',enabledWhen:ctx=>ctx.preMassRite==='PALM'&&ctx.preMassRiteActuallyOccurred,build:aoR14BuildPalm},
 {Overlay_ID:'AO.OV.ASH',placement:'BEFORE_MASS',priority:20,status:'IMPLEMENTED',enabledWhen:ctx=>ctx.preMassRite==='ASH'&&ctx.preMassRiteActuallyOccurred,build:aoR14BuildAsh},
 {Overlay_ID:'AO.OV.CND',placement:'BEFORE_MASS',priority:20,status:'IMPLEMENTED',enabledWhen:ctx=>['CND','CANDLEMAS'].includes(ctx.preMassRite)&&ctx.preMassRiteActuallyOccurred,build:aoR14BuildCandle},
 {Overlay_ID:'AO.OV.ROG',placement:'BEFORE_MASS',priority:20,status:'IMPLEMENTED',enabledWhen:ctx=>AO.ProcessionsR12?.rogationSelected?.(ctx)&&AO.ProcessionsR12?.rogationActuallyOccurred?.(ctx),build:aoR14BuildRog},
 {Overlay_ID:'AO.OV.NUP.BLOCK',placement:'BEFORE_MASS',priority:1,status:'IMPLEMENTED',enabledWhen:ctx=>ctx.nuptial&&ctx.nuptialEligibility!=='PERMITTED',build:aoR14BlockedNuptial},
 {Overlay_ID:'AO.OV.NUP.PRE',placement:'BEFORE_MASS',priority:15,status:'IMPLEMENTED',enabledWhen:ctx=>ctx.nuptial&&ctx.nuptialEligibility==='PERMITTED',build:aoR14NuptialPre},
 {Overlay_ID:'AO.OV.NUP.MID',placement:'MID_AFTER_PATERNOSTER',priority:45,status:'IMPLEMENTED',enabledWhen:ctx=>ctx.nuptial&&ctx.nuptialEligibility==='PERMITTED',build:aoR14NuptialMid},
 {Overlay_ID:'AO.OV.NUP.END',placement:'MID_AFTER_DISMISSAL',priority:65,status:'IMPLEMENTED',enabledWhen:ctx=>ctx.nuptial&&ctx.nuptialEligibility==='PERMITTED',build:aoR14NuptialEnd},
 {Overlay_ID:'AO.OV.HT.MAND',placement:'MID_AFTER_SERMON',priority:40,status:'IMPLEMENTED',enabledWhen:ctx=>ctx.holyThursday&&ctx.mandatumPastorallyUsed,build:aoR14Mandatum},
 {Overlay_ID:'AO.OV.HT.POST',placement:'AFTER_MASS',priority:80,status:'IMPLEMENTED',enabledWhen:ctx=>ctx.holyThursday&&ctx.repositionActuallyOccurs,build:aoR14BuildHolyThursdayPost},
 {Overlay_ID:'AO.OV.GF',placement:'BEFORE_MASS',priority:5,status:'IMPLEMENTED',enabledWhen:ctx=>ctx.goodFriday,build:aoR14BuildGoodFriday},
 {Overlay_ID:'AO.OV.EV',placement:'BEFORE_MASS',priority:5,status:'IMPLEMENTED',enabledWhen:ctx=>ctx.easterVigil,build:aoR14BuildEasterVigil},
 {Overlay_ID:'AO.OV.EV.LAUDS',placement:'MID_AFTER_COMMUNION',priority:75,status:'IMPLEMENTED',enabledWhen:ctx=>ctx.easterVigil,build:aoR14BuildEasterVigilLauds},
 {Overlay_ID:'AO.OV.ABS',placement:'AFTER_MASS',priority:70,status:'IMPLEMENTED',enabledWhen:ctx=>AO.RequiemAbsolutionR07?.active?.(ctx),build:aoR14BuildAbsolution},
 {Overlay_ID:'AO.OV.CORPUS',placement:'AFTER_MASS',priority:70,status:'IMPLEMENTED',enabledWhen:ctx=>AO.ProcessionsR12?.corpusSelected?.(ctx),build:aoR14BuildCorpus},
 {Overlay_ID:'AO.OV.PROC',placement:'AFTER_MASS',priority:70,status:'IMPLEMENTED',enabledWhen:ctx=>AO.ProcessionsR12?.genericProcessionSelected?.(ctx),build:aoR14BuildGenericProcession}
]
function buildActiveOverlays(ctx){
 return RITE_OVERLAY_REGISTRY.filter(r=>r.status==='IMPLEMENTED'&&r.enabledWhen?.(ctx)&&typeof r.build==='function').flatMap(r=>{const x=r.build(ctx);return Array.isArray(x)?x:[x]}).filter(Boolean).sort((a,b)=>(a.priority||0)-(b.priority||0));
}
const ACTIVE_OVERLAYS=buildActiveOverlays(RITE_CONTEXT);
const PRE_MASS_RITE=ACTIVE_OVERLAYS.find(x=>x.placement==='BEFORE_MASS')||{enabled:false,blocks:[],macro:null,part:null};
PRE_MASS_RITE.enabled=!!PRE_MASS_RITE.macro;
const PRE_MASS_VARIANT=PRE_MASS_RITE.variant||'NONE';
const PRE_MASS_SELECTED=PRE_MASS_TEXTS[PRE_MASS_VARIANT]||{title:'',chantLabel:'',scholaPairs:[]};
ACTIVE_OVERLAYS.forEach(ov=>{if(ov.macro)macroMap[ov.macro.Macro_ID]=ov.macro});
const RUNTIME_BLOCKS=[...ACTIVE_OVERLAYS.flatMap(x=>x.blocks||[]),...DATA.blocks];
const runtimeBlockById=new Map(RUNTIME_BLOCKS.map(b=>[b.Block_ID,b]));
function runtimeBlockEnabled(b){return !!b?.RuntimeOverlay||blockEnabled(b)}
function runtimeBlocksForMacros(macros){return RUNTIME_BLOCKS.filter(b=>runtimeBlockEnabled(b)&&macros.includes(b.Macro_ID)).sort((a,b)=>Number(a.Display_Order)-Number(b.Display_Order))}
function runtimePriestForOverlay(el){return {Priest_Event_ID:`${el?.dataset?.overlayId||'AO.OV'}.PRIEST`,Priest_Station:el?.dataset?.runtimeStation||'ALTAR_CENTER',Facing:el?.dataset?.runtimeFacing||'ALTAR',Voice:el?.dataset?.runtimeVoice||'SILENT',Action:el?.dataset?.runtimeAction||'—',Macro_ID:el?.dataset?.macro||'',Source_Cue_ID:el?.dataset?.cue||''}}
function runtimePostureForOverlay(el){return {Posture_Event_ID:`${el?.dataset?.overlayId||'AO.OV'}.POST`,New_Posture:el?.dataset?.runtimePosture||'STAND'}}
function runtimeResponseForOverlay(el){const t=el?.dataset?.runtimeResponse||'';return t?{Response_Event_ID:`${el?.dataset?.overlayId||'AO.OV'}.RESPONSE`,Response_Text:'℟. '+t,Default_User_Response:'YES',Source_Cue_ID:el?.dataset?.cue||''}:null}
// Compatibility aliases while downstream runtime is progressively generalized.
const runtimePriestForPreMass=runtimePriestForOverlay,runtimePostureForPreMass=runtimePostureForOverlay,runtimeResponseForPreMass=runtimeResponseForOverlay;

// AO.EventSurfaces — audibility presentation normalized without mutating canonical voice data.
const DIALOGUE_FOOT_RESPONSE_IDS=new Set(['AO.SM.R001','AO.SM.R002','AO.SM.R003','AO.SM.R004','AO.SM.R005','AO.SM.R006','AO.SM.R007']);
const LOW_MASS_RESPONSE_EXCLUSIONS=new Set(['AO.SM.R010']);
function responseIsForUser(resp){
 if(!resp||!cond(resp.Branch_Condition))return false;
 if(LOW_MASS_RESPONSE_EXCLUSIONS.has(resp.Response_Event_ID))return false;
 return !!flags.LOW_MASS_DIALOGUE_RESPONSES;
}
function normalizedPriestVoice(priest){
 if(!priest)return '—';const a=String(priest.Action||'').toUpperCase(),v=String(priest.Voice||'').toUpperCase();
 if(/RECEIVES|LISTEN/.test(a)||/LISTEN/.test(v))return 'LISTENING';
 if(/RAISED ENTRY/.test(v)&&/SECRET CONTINUATION/.test(v))return 'MIXED · RAISED→SECRET';
 if(/SILENT|NO COMPETING/.test(v))return 'SILENT';
 if(/SECRET/.test(v))return 'SECRET';
 if(/QUIET|PRIVATE|LOW|INTERNAL/.test(v))return 'QUIET';
 if(/SUNG/.test(v)&&/CLEAR|PUBLIC|AUDIBLE/.test(v))return 'SUNG · CLEAR';
 if(/AUDIBLE/.test(v))return 'AUDIBLE';
 if(/CLEAR SPOKEN/.test(v)&&/LOCAL/.test(v))return 'CLEAR · LOCAL';
 if(/CLEAR/.test(v))return 'CLEAR';
 return String(priest.Voice||'—').replace(' / ',' · ');
}
const BELL_RUNTIME=new Map([
 ['AO.SM.C0145',{id:'AO.SM.BELL001',owner:'MINISTER_OR_SERVER',label:'SANCTUS BELL',detail:'Sanctus · transition toward the Canon',authority:'1962 prescribed signal; stroke count locally variable'}],
 ['AO.SM.C0161',{id:'AO.SM.BELL002',owner:'MINISTER_OR_SERVER',label:'CONSECRATION WARNING',detail:'Hanc igitur · Consecration is imminent',authority:'1962 warning prescribed; one ring at Hanc igitur is strong 1962-era practical implementation'}],
 ['AO.SM.C0174',{id:'AO.SM.BELL003',owner:'MINISTER_OR_SERVER',label:'ELEVATION BELL',detail:'Sacred Host · three rings or continuous ringing until lowered',authority:'Explicit 1962 elevation pattern'}],
 ['AO.SM.C0181',{id:'AO.SM.BELL004',owner:'MINISTER_OR_SERVER',label:'ELEVATION BELL',detail:'Precious Blood · three rings or continuous ringing until lowered',authority:'Explicit 1962 elevation pattern'}],
 ['AO.SM.C0225',{id:'AO.SM.BELL005',owner:'MINISTER_OR_SERVER',label:'COMMUNION WARNING',detail:'Shortly after Agnus Dei · communicants prepare',authority:'1962 conditional warning; one-ring timing is secondary',when:()=>!!flags.FAITHFUL_COMMUNION}]
]);
function bellAtCue(cue){const x=BELL_RUNTIME.get(cue);return x&&(!x.when||x.when())?x:null}
AO.BellRuntime=Object.freeze({
 version:'R02-1962',
 normative:Object.freeze(Array.from(BELL_RUNTIME.entries()).map(([cue,x])=>Object.freeze({cue,id:x.id,owner:x.owner,label:x.label,detail:x.detail,authority:x.authority}))),
 historicalSuppressed:Object.freeze([{id:'AO.SM.BELL006',cues:Object.freeze(['AO.SM.C0229','AO.SM.C0230','AO.SM.C0231']),reason:'Priest own Domine non sum dignus bell is older/local custom, not the normative 1962 Communion warning.'}]),
 atCue:(cue)=>{const x=bellAtCue(cue);return x?Object.freeze({cue,id:x.id,owner:x.owner,label:x.label,detail:x.detail,authority:x.authority}):null}
})

function voiceAssetKey(priest){
 const state=normalizedPriestVoice(priest).toUpperCase();
 if(!priest||state==='—')return '';
 if(/SILENT|LISTENING/.test(state))return 'SEM:SOUND.PRIEST.SILENT';
 if(/SECRET|QUIET|LOW/.test(state))return 'SEM:SOUND.PRIEST.LOW';
 return 'SEM:SOUND.PRIEST.AUDIBLE';
}
let AO_LAST_BELL_SIG='';function updateBellRail(cue){const x=bellAtCue(cue),sig=x?`${cue}|${x.label}|${x.detail}`:'';if(sig===AO_LAST_BELL_SIG)return;AO_LAST_BELL_SIG=sig;if(x)window.dispatchEvent(new CustomEvent('ao:bell',{detail:{cue,bellId:x.id||'',owner:x.owner||'MINISTER_OR_SERVER',label:x.label||'ALTAR BELL',detail:x.detail||'',authority:x.authority||'',semantic:'SOUND.ALTAR_BELLS'}}))}
