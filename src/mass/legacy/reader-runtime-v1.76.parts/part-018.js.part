function assetImg(ref,cls='asset-icon',alt=''){
 const resolved=aoResolveIconRef(ref);if(!resolved)return '';
 const variant=String(resolved.binding?.variant||'');
 const mirror=variant.includes('MIRROR_HORIZONTAL')?' ao-mirror-x':'';
 return `<span class="${cls} ao-mask-icon${mirror}" role="img" aria-label="${escapeHtml(alt||resolved.sid||ref)}" data-icon-semantic="${escapeHtml(resolved.sid)}" data-icon-master="${escapeHtml(resolved.binding.asset_id)}" style="--ao-mask:url('${resolved.src}')"></span>`;
}
function aoHasIcon(ref){return !!aoResolveIconRef(ref)}
function postureAssetKey(p){return ({STAND:'SEM:POSTURE.STAND',SIT:'SEM:POSTURE.SIT',KNEEL:'SEM:POSTURE.KNEEL',GENUFLECT:'SEM:POSTURE.GENUFLECT'}[p]||'')}
function gestureAssetKey(g){
 const a=(g?.Faithful_Action||'').toLowerCase();
 if(a.includes('forehead · lips · breast'))return 'SEM:GESTURE.GOSPEL_CROSSES';
 if(a.includes('sign of the cross')||a.includes('begin the full sign'))return 'SEM:GESTURE.SIGN_OF_CROSS';
 if(a.includes('strike breast'))return 'SEM:GESTURE.BREAST_STRIKE';
 if(a.includes('genuflection'))return 'SEM:POSTURE.GENUFLECT';
 if(a.includes('bow head')||a.includes('bow the head'))return 'SEM:GESTURE.HEAD_BOW';
 if(a.includes('profound bow'))return 'SEM:GESTURE.PROFOUND_BOW';
 if(a.includes('bow before the incense')||a.includes('bow after'))return 'SEM:GESTURE.BOW_TO_THURIFER';
 if(a.includes('remain kneeling')&&a.includes('bow reverently'))return 'SEM:GESTURE.BOW_FROM_KNEELING';
 if(a.includes('bow reverently')||a.includes('bow before'))return 'SEM:POSTURE.BOW';
 if(/^rise\b/.test(a))return 'SEM:POSTURE.STAND';
 return '';
}
