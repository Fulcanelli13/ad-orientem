if(['CND','CANDLEMAS'].includes(RITE_CONTEXT.preMassRite)&&RITE_CONTEXT.preMassRiteActuallyOccurred&&RITE_CONTEXT.personal?.hasBlessedCandle){for(const b of DATA.blocks||[]){if(b.Block_ID==='AO.SM.B026'||b.Block_ID==='AO.SM.B046'||['AO.SM.M14','AO.SM.M15','AO.SM.M16','AO.SM.M17','AO.SM.M18','AO.SM.M19'].includes(b.Macro_ID))for(const u of b.units||[])u.objectState='CANDLE_LIT'}const after=(DATA.blocks||[]).filter(b=>['AO.SM.M20','AO.SM.M21','AO.SM.M22','AO.SM.M23','AO.SM.M24','AO.SM.M25','AO.SM.M26'].includes(b.Macro_ID));for(const b of after)for(const u of b.units||[])u.candleState='UNCONSTRAINED_AFTER_PATER'}
if(RITE_CONTEXT.holyThursday||AO.ProcessionsR12?.corpusSelected?.(RITE_CONTEXT)){aoR14SetCue('AO.SM.C0259','℣. Benedicámus Dómino.','℣. Let us bless the Lord.');aoR14SetCue('AO.SM.C0260','℟. Deo grátias.','℟. Thanks be to God.')}
if(RITE_CONTEXT.holyThursday)aoR14SetCue('AO.SM.C0224','Agnus Dei, qui tollis peccáta mundi: miserére nobis.','Lamb of God, who takest away the sins of the world: have mercy on us.');
if(RITE_CONTEXT.easterVigil){const gb=(DATA.blocks||[]).find(b=>b.Block_ID==='AO.SM.B016');if(gb){gb.EasterVigilSignal='CHURCH_BELLS_AT_GLORIA';gb.TriduumSoundState='RELEASE_SILENCE_AT_GLORIA'}aoR14SetCue('AO.SM.C0259','℣. Ite, missa est, allelúia, allelúia.','℣. Go, the Mass is ended, alleluia, alleluia.');aoR14SetCue('AO.SM.C0260','℟. Deo grátias, allelúia, allelúia.','℟. Thanks be to God, alleluia, alleluia.')}

