function textIconKey(s=''){
 const t=String(s||'').toLowerCase();
 if(/introit|kyrie|gloria|credo|gradual|alleluia|tract|sequence|sanctus|agnus|chant|schola/.test(t))return 'SEM:SOUND.SCHOLA';
 if(/epistle|lesson/.test(t))return 'SEM:ACTION.EPISTLE';
 if(/gospel/.test(t))return 'SEM:ACTION.GOSPEL';
 if(/sermon|homily|preach/.test(t))return '';
 if(/communion/.test(t))return 'SEM:ACTION.COMMUNION';
 if(/ablution|purif/.test(t))return 'SEM:ACTION.ABLUTIONS';
 if(/blessing|dismissal|ite missa/.test(t))return 'SEM:ACTION.BLESSING';
 if(/offertory/.test(t))return 'SEM:ACTION.OFFERTORY';
 if(/canon|consecration|te igitur/.test(t))return 'SEM:POSITION.ALTAR_CENTER';
 if(/elevation/.test(t))return 'SEM:ACTION.HOST_ELEVATION';
 if(/collect|secret|preface|postcommunion/.test(t))return 'SEM:POSITION.ALTAR_CENTER';
 if(/preparatory|prayers at the foot|foot of the altar/.test(t))return 'SEM:POSITION.PRIEST.FOOT_OF_ALTAR';
 if(/pater|oratio/.test(t))return 'SEM:GESTURE.HANDS_JOINED';
 return '';
}
